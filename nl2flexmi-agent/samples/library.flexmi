<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LibrarySystem" nsURI="http://www.example.org/librarysystem" nsPrefix="ls">
  <eClassifiers>
    <eClass name="Library">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.3" />
        <eReference name="books" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.1" />
        <eReference name="authors" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Book">
      <eStructuralFeatures>
        <eAttribute name="title" upperBound="1" lowerBound="1" eType="//EString" />
        <eAttribute name="pageCount" upperBound="1" lowerBound="1" eType="//EInt" />
        <eReference name="mainAuthor" containment="False" upperBound="1" lowerBound="0" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Author">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//EString" />
        <eAttribute name="age" upperBound="1" lowerBound="0" eType="//EInt" />
        <eReference name="writtenBooks" containment="False" upperBound="-1" lowerBound="0" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
  </eClassifiers>
</ePackage>
