<?xml version="1.0" encoding="ASCII"?>
<mt:ModelToolset
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:mt="http://cs.york.ac.uk/ase/modelToolGeneration/1.0"
    xmi:id="__0jv4H0DEfGgHJR-Z0N8QQ"
    rootClassTool="__0jv4X0DEfGgHJR-Z0N8QQ">
  <classTools
      xmi:id="__0jv4X0DEfGgHJR-Z0N8QQ"
      description="Declaration of the package containing all the EClasses">
    <eClass
        href="http://www.eclipse.org/emf/2002/Ecore#//EPackage"/>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Name of the package"
        idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="The namespace URI of the package">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//EPackage/nsURI"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EReferenceTool"
        description="Classes and data types within this EPackage">
      <eReference
          href="http://www.eclipse.org/emf/2002/Ecore#//EPackage/eClassifiers"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="XML namespace prefix to be used for this EPackage">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//EPackage/nsPrefix"/>
    </featureTools>
  </classTools>
  <classTools
      description="Class within an EPackage">
    <eClass
        href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Name of the class."
        idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EReferenceTool"
        description="The optional base classes from which to inherit.">
      <eReference
          href="http://www.eclipse.org/emf/2002/Ecore#//EClass/eSuperTypes"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EReferenceTool"
        description="The attributes and references inside this class">
      <eReference
          href="http://www.eclipse.org/emf/2002/Ecore#//EClass/eStructuralFeatures"/>
    </featureTools>
  </classTools>
  <classTools
      description="A specific piece of information in an EClass which is not an object">
    <eClass
        href="http://www.eclipse.org/emf/2002/Ecore#//EAttribute"/>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Name of the attribute."
        idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EReferenceTool"
        description="Type of the attribute (must be set: use the tools for it)">
      <eReference
          href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/eType"/>
      <overrideEType
          href="http://www.eclipse.org/emf/2002/Ecore#//EDataType"/>
      <possibleValues
          description="BigDecimal">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EBigDecimal"/>
      </possibleValues>
      <possibleValues
          description="String">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </possibleValues>
      <possibleValues
          description="BigInteger">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EBigInteger"/>
      </possibleValues>
      <possibleValues
          description="Boolean">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      </possibleValues>
      <possibleValues
          description="Byte">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EByte"/>
      </possibleValues>
      <possibleValues
          description="Date">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
      </possibleValues>
      <possibleValues
          description="Double">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      </possibleValues>
      <possibleValues
          description="Float">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      </possibleValues>
      <possibleValues
          description="Integer">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </possibleValues>
      <possibleValues
          description="Long">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
      </possibleValues>
      <possibleValues
          description="Short">
        <value
            href="http://www.eclipse.org/emf/2002/Ecore#//EShort"/>
      </possibleValues>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Maximum number of values for the attribute">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/upperBound"/>
      <possibleValues
          value="-1"
          description="many"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Minimum number of values for the attribute (must be less or equal to the upper bound)">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/lowerBound"/>
    </featureTools>
  </classTools>
  <classTools
      description="Reference from an EClass to another EClass">
    <eClass
        href="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Name of the reference."
        idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="True if the source of the reference contains the target of reference (meaning that deleting the source will also delete the target).">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//EReference/containment"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EReferenceTool"
        description="Target EClass of the reference.">
      <eReference
          href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/eType"/>
      <overrideEType
          href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Maximum number of targets for the reference">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/upperBound"/>
      <possibleValues
          value="-1"
          description="many"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Minimum number of targets for the reference (must be less or equal to the upper bound)">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/lowerBound"/>
    </featureTools>
  </classTools>
  <classTools
      description="Type of scalar data value used in an EAttribute">
    <eClass
        href="http://www.eclipse.org/emf/2002/Ecore#//EDataType"/>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Name of the data type"
        idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools
        xsi:type="mt:EAttributeTool"
        description="Fully qualified Java class name of the instances of this data type">
      <eAttribute
          href="http://www.eclipse.org/emf/2002/Ecore#//EClassifier/instanceClassName"/>
    </featureTools>
  </classTools>
  <importedUrls>http://www.eclipse.org/emf/2002/Ecore</importedUrls>
</mt:ModelToolset>
