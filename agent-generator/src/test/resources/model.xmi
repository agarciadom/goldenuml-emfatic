<?xml version="1.0" encoding="ASCII"?>
<mt:ModelToolset xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mt="http://cs.york.ac.uk/ase/modelToolGeneration/1.0" xmi:id="__0jv4H0DEfGgHJR-Z0N8QQ">
  <classTools xmi:id="__0jv4X0DEfGgHJR-Z0N8QQ" description="Declaration of the package containing all the EClasses">
    <eClass href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <featureTools xsi:type="mt:EAttributeTool" description="Name of the package." idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools xsi:type="mt:EAttributeTool" description="The namespace URI of the new package.">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//EPackage/nsURI"/>
    </featureTools>
  </classTools>
  <classTools description="Class within an EPackage" cardinality="MANY">
    <eClass href="http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    <featureTools xsi:type="mt:EAttributeTool" description="Name of the class." idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools xsi:type="mt:EReferenceTool" description="The optional base class from which to inherit." optional="true">
      <eReference href="http://www.eclipse.org/emf/2002/Ecore#//EClass/eSuperTypes"/>
    </featureTools>
  </classTools>
  <classTools description="A specific piece of information which is not an object." cardinality="MANY">
    <eClass href="http://www.eclipse.org/emf/2002/Ecore#//EAttribute"/>
    <featureTools xsi:type="mt:EAttributeTool" description="Name of the attribute." idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools xsi:type="mt:EReferenceTool" description="Type of the attribute.">
      <eReference href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/eType"/>
      <possibleValues description="BigDecimal">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EBigDecimal"/>
      </possibleValues>
      <possibleValues description="String">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      </possibleValues>
      <possibleValues description="BigInteger">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EBigInteger"/>
      </possibleValues>
      <possibleValues description="Boolean">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      </possibleValues>
      <possibleValues description="Byte">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EByte"/>
      </possibleValues>
      <possibleValues description="Date">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
      </possibleValues>
      <possibleValues description="Double">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      </possibleValues>
      <possibleValues description="Float">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
      </possibleValues>
      <possibleValues description="Integer">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      </possibleValues>
      <possibleValues description="Long">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
      </possibleValues>
      <possibleValues description="Short">
        <value href="http://www.eclipse.org/emf/2002/Ecore#//EShort"/>
      </possibleValues>
    </featureTools>
    <featureTools xsi:type="mt:EAttributeTool" description="Maximum number of values for the attribute" allowOutsideValues="true">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/upperBound"/>
      <possibleValues value="-1" description="many"/>
    </featureTools>
    <featureTools xsi:type="mt:EAttributeTool" description="Minimum number of values for the attribute (must be less or equal to the upper bound)">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/lowerBound"/>
    </featureTools>
  </classTools>
  <classTools description="Reference from an EClass to another EClass" cardinality="MANY">
    <eClass href="http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    <featureTools xsi:type="mt:EAttributeTool" description="Name of the reference." idScope="UNIQUE_AMONG_SIBLINGS">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ENamedElement/name"/>
    </featureTools>
    <featureTools xsi:type="mt:EAttributeTool" description="True if the source of the reference contains the target of reference (meaning that deleting the source will also delete the target).">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//EReference/containment"/>
    </featureTools>
    <featureTools xsi:type="mt:EReferenceTool" description="Target EClass of the reference.">
      <eReference href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/eType"/>
    </featureTools>
    <featureTools xsi:type="mt:EAttributeTool" description="Maximum number of targets for the reference" allowOutsideValues="true">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/upperBound"/>
      <possibleValues value="-1" description="many"/>
    </featureTools>
    <featureTools xsi:type="mt:EAttributeTool" description="Minimum number of targets for the reference (must be less or equal to the upper bound)">
      <eAttribute href="http://www.eclipse.org/emf/2002/Ecore#//ETypedElement/lowerBound"/>
    </featureTools>
  </classTools>
</mt:ModelToolset>
