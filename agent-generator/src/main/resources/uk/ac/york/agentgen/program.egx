rule ModelToolset2AgentTools
  transform toolset : ModelToolset
{
    template: "model_tools.egl"
    target: "model_tools.py"
}

rule ModelToolset2Prompt
  transform toolset : ModelToolset
{
    template: "prompts.egl"
    target: "prompts.py"
    parameters: Map {
      "rootClassName" = toolset.rootClassTool.eClass.name
    }
}

rule ModelToolset2Pydantic
  transform toolset : ModelToolset
{
  template: "model_types.egl"
  target: "model_types.py"
  parameters: Map {
    "rootEPackage" = toolset.rootClassTool.eClass.ePackage
  }
}