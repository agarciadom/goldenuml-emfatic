from pydantic import BaseModel, Field
from smolagents import Tool
from typing import Union

# Pydantic models

[% toolset.pydanticModels(); %]

# Tools for Smolagents

# Root update tool

[% var rootTool = toolset.rootClassTool; %]
class Update[%=rootTool.eClass.name.ftuc()%](Tool):
  name = "update_[%=rootTool.eClass.name%]"
  description = """
  Updates [%=rootTool.description.ftlc()%], and returns it.
  """
  inputs = {
[% rootTool.attributeInputs(); %]
  }
  output_type = "object"

[% rootTool.constructor(); %]

  def forward(self, [%=rootTool.featureTools.collect(ft:EAttributeTool|ft.paramDeclaration()).concat(', ')%]) -> [%=rootTool.eClass.name%]:
[% rootTool.setAttributes(); %]
    return [%=rootTool.varName()%]

# Subobject creation tools (for containment references)

[%
for (refTool in toolset.classTools.collect(ct | ct.featureTools.select(ft: EReferenceTool | ft.eReference.isContainment)).flatten()) {
  for (classToAdd in refTool.compatibleClassTools()) {
%]
class Add[%=classToAdd.eClass.name.ftuc()%]To[%=refTool.eContainer.eClass.name%][%=refTool.eReference.name.ftuc()%](Tool):
  name = "add_[%=classToAdd.eClass.name%]_to_[%=refTool.eContainer.eClass.name%]_[%=refTool.eReference.name%]"
  description = """
  Creates and adds a [%=classToAdd.eClass.name%] to the [%=refTool.eReference.name%] in a [%=refTool.eContainer.eClass.name%], and returns the [%=classToAdd.eClass.name%].
  """
  inputs = {
[% if (not refTool.eContainer.isRootTool()) { %]
    "[%=refTool.containerVarName()%]": {
      "type": "object",
      "description": "[%=refTool.eContainer.eClass.name%] that this [%=classToAdd.eClass.name%] belongs to"
    },
[%
}
classToAdd.attributeInputs(); %]
  }
  output_type = "object"

[% if (refTool.eContainer.isRootTool()) {
  classToAdd.constructor();
} %]

  def forward(self, [% if (not refTool.eContainer.isRootTool()) { %][%=refTool.containerVarName()%]: [%=refTool.eContainer.eClass.name%], [% } %][%=classToAdd.featureTools.collect(ft:EAttributeTool|ft.paramDeclaration()).concat(', ')%]) -> [%=classToAdd.eClass.name%]:
    var _instance = [%=classToAdd.eClass.name%](
[% for (at in classToAdd.featureTools.select(ft:EAttributeTool|true)) { %]
      [%=at.fieldName()%]=[%=at.varName()%],
[% } %]
    )
[% if (refTool.fieldType().startsWith('dict[str,')) { %]
    [%=refTool.containerVarName()%].[%=refTool.fieldName()%][[%=classToAdd.siblingScopedNameTool().varName()%]] = _instance
[% } else if (refTool.fieldType().startsWith('list[')) { %]
    [%=refTool.containerVarName()%].[%=refTool.fieldName()%].add(_instance)
[% } else { %]
    [%=refTool.containerVarName()%].[%=refTool.fieldName()%] = _instance
[% } %]
    return _instance


[%
  }
}

operation EAttributeTool fieldName(): String {
  return self.eAttribute.name;
}

@cached
operation EAttributeTool fieldType(): String {
  switch (self.eAttribute.eType.name) {
    case 'EInt': return 'int';
    case 'EBoolean': return 'bool';
  }
  return 'str';
}

@cached
operation EAttributeTool inputType(): String {
  switch (self.eAttribute.eType.name) {
    case 'EInt': return 'integer';
    case 'EBoolean': return 'boolean';
    case 'EFloat':
    case 'EDouble': return 'number';
    case 'EString': return 'string';
  }
  return 'any';
}

operation EAttributeTool varName(): String {
  return self.eAttribute.name;
}

operation EAttributeTool paramDeclaration(): String {
  return self.varName() + ': ' + self.fieldType();
}

operation EReferenceTool fieldName(): String {
  return self.eReference.name;
}

@cached
operation EReferenceTool fieldType(): String {
  var singleType = self.elementType();
  if (self.eReference.isMany) {
    if (self.eReference.isContainment) {
      var compatible = self.compatibleClassTools();
      var allWithSiblingNames = compatible.forAll(ct | ct.hasSiblingScopedName());
      return 'dict[str, ' + singleType + ']';
    }
    return 'set[' + singleType + ']';
  }
  return singleType;
}

operation EReferenceTool elementType(): String {
  var compatible = self.compatibleClassTools().eClass.name.flatten();
  if (not compatible.isEmpty() and not self.possibleValues.isEmpty()) {
    compatible.add('str');
  }
  if (compatible.size() = 1) {
    return compatible.first;
  } else if (compatible.size > 1) {
    return 'Union[' + compatible.concat(', ') + ']';
  } else {
    return 'str';
  }
}

operation EReferenceTool containerVarName() {
  return self.eContainer.eClass.name.ftlc();
}

@cached
operation EReferenceTool compatibleClassTools(): Collection<EClassTool> {
  return self.toolset().classTools.select(
    ct | self.effectiveEType().isSuperTypeOf(ct.eClass)
  );
}

operation EReferenceTool effectiveEType(): EClass {
  return self.overrideEType.isDefined() ? self.overrideEType : self.eReference?.eType;
}

operation EFeatureTool toolset() {
  return self.closure(e|e.eContainer).selectOne(t:ModelToolset|true);
}

@cached
operation EClassTool siblingScopedNameTool(): EAttributeTool {
  return self.featureTools.selectOne(ft:EAttributeTool | ft.idScope = #UNIQUE_AMONG_SIBLINGS);
}

operation EClassTool hasSiblingScopedName() {
  return self.siblingScopedNameTool().isDefined();
}

@cached
operation EClassTool varName() {
  return self.isRootTool() ? 'root' : self.eClass.name.ftlc();
}

@cached
operation EClassTool isRootTool() {
  return self.eContainer.rootClassTool = self;
}

@cached
operation ModelToolset rootEClass() {
  return self.rootClassTool.eClass.name;
}

operation ModelToolset pydanticModels() {%]
[% for (ct in toolset.classTools) { %]
class [%=ct.eClass.name.ftuc()%](BaseModel):
[% for (ft in ct.featureTools) { %]
  [%=ft.fieldName()%]: [%=ft.fieldType()%]
[% } %]

[% }
}

operation EClassTool constructor() {%]
  def __init__(self, root: [%=toolset.rootEClass()%], *args, **kwargs):
    super().__init__(*args, **kwargs)
    self.root = root
[% }

operation EClassTool attributeInputs() {
  for (ft in self.featureTools.select(ft:EAttributeTool|true)) {%]
    "[%=ft.eAttribute.name%]": {
      "type": "[%=ft.inputType()%]",
      "description": "[%=ft.description%]"
    },
[%
  }
}

operation EClassTool setAttributes() {%]
[% for (ft in self.featureTools.select(ft:EAttributeTool|true)) { %]
    [%=self.varName()%].[%=ft.fieldName()%] = [%=ft.varName()%]
[% }
}

%]