@namespace(uri="http://cs.york.ac.uk/ase/modelToolGeneration/1.0", prefix="mt")
package toolgen;

class ModelToolset {
  val EClassTool[*] classTools;
}

class EClassTool {
  ref ecore.EClass eClass;
  attr String description;
  attr TargetCardinality cardinality;
  val EFeatureTool[*] featureTools;
}

abstract class EFeatureTool {
  attr String description;
  attr boolean optional = false;
  attr boolean allowOutsideValues = false;
}

class EAttributeTool extends EFeatureTool {
  ref ecore.EAttribute eAttribute;
  attr IdentifierScope idScope;
  val EAttributeValue[*] possibleValues;
}

class EReferenceTool extends EFeatureTool {
  ref ecore.EReference eReference;
  val EReferenceValue[*] possibleValues;
}

class EAttributeValue {
  attr String value;
  attr String description;
}

class EReferenceValue {
  ref EObject value;
  attr String description;
}

enum TargetCardinality {
  ONE = 0;
  MANY = 1;
}

enum IdentifierScope {
  NOT_AN_IDENTIFIER = 0;
  UNIQUE_AMONG_SIBLINGS = 1;
  GLOBALLY_UNIQUE = 2;
}
