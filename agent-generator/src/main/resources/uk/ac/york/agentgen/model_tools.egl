[%
  import "utils.eol";
  var toolClasses : Map;
%]# Automatically generated model creation tools. Do not modify manually.

from model_types import *
from smolagents import Tool

# Root update tool

[% toolset.rootClassTool.rootToolClass(); %]

# Subobject creation tools (for containment references)

[%
for (refTool in toolset.classTools.collect(ct | ct.featureTools.select(ft: EReferenceTool | ft.eReference.isContainment)).flatten()) {
  for (classToAdd in refTool.compatibleClassTools()) {
    refTool.createAddTool(classToAdd);
  }
}
%]
# Non-containment reference tools

[%
for (refTool in toolset.classTools.collect(ct | ct.featureTools.select(ft: EReferenceTool | not ft.eReference.isContainment)).flatten()) {
  for (classToReference in refTool.compatibleClassTools()) {
    refTool.addReferenceTool(classToReference);
  }
  if (not refTool.possibleValues.isEmpty()) {
    refTool.addStringReferenceTool();
  }
}
%]
def createTools(root: [%= toolset.rootClassTool.eClass.name.ftuc() %]) -> list[Tool]:
  return [
[% for (toolClass in toolClasses.keySet) { %]
    [%=toolClass%]([%= toolClasses.get(toolClass).constructorTakesRoot ? "root": ""%]),
[% } %]
  ]

[%
operation recordToolClass(className: String, constructorTakesRoot: Boolean): String {
  toolClasses.put(className, Tuple {"constructorTakesRoot" = constructorTakesRoot});
  return className;
}

operation EReferenceTool createAddTool(classToAdd: EClassTool) { %]
class [%=recordToolClass("Add" + classToAdd.eClass.name.ftuc() + "To" + self.eContainer.eClass.name + self.eReference.name.ftuc(), self.eContainer.isRootTool())%](Tool):
  name = "add_[%=classToAdd.eClass.name%]_to_[%=self.eContainer.eClass.name%]_[%=self.eReference.name%]"
  description = """
  Creates and adds a [%=classToAdd.eClass.name%] to the [%=self.eReference.name%] in a [%=self.eContainer.eClass.name%], and returns the [%=classToAdd.eClass.name%].
  """
  inputs = {
[% if (not self.eContainer.isRootTool()) { %]
    "[%=self.containerVarName()%]": {
      "type": "object",
      "description": "[%=self.eContainer.eClass.name%] that this [%=classToAdd.eClass.name%] belongs to"
    },
[%
}
classToAdd.attributeInputs(); %]
  }
  output_type = "object"

[% if (self.eContainer.isRootTool()) {
  classToAdd.constructor();
} %]

  def forward(self, [% if (not self.eContainer.isRootTool()) { %][%=self.containerVarName()%]: [%=self.eContainer.eClass.name%], [% } %][%=classToAdd.featureTools.collect(ft:EAttributeTool|ft.paramDeclaration()).concat(', ')%]) -> [%=classToAdd.eClass.name%]:
    _fields = {
[% for (at in classToAdd.featureTools.select(ft:EAttributeTool|true)) { %]
      "[%=at.fieldName()%]": [%=at.varName()%],
[% } %]
    }
[% if (self.fieldType().startsWith('dict[str,')) {
     var keyVar = classToAdd.siblingScopedNameTool().varName();
     var dictVar = self.containerVarName() + '.' + self.fieldName();
%]
    if [%=keyVar%] in [%=dictVar%] and isinstance([%=keyVar%], [%=classToAdd.eClass.name%]):
      [%=dictVar%][[%=keyVar%]] = [%=dictVar%][[%=keyVar%]].model_copy(update=_fields)
    else:
      [%=dictVar%][[%=keyVar%]] = [%=classToAdd.eClass.name%](**_fields)
    return [%=dictVar%][[%=keyVar%]]
[% } else if (self.fieldType().startsWith('set[')) { %]
    _instance = [%=classToAdd.eClass.name%](**_fields)
    [%=self.containerVarName()%].[%=self.fieldName()%].add(_instance)
[% } else {
     var varName = self.containerVarName() + '.' + self.fieldName();
%]
    if [%=varName%] is not None:
      [%=varName%] = [%=varName%].model_copy(update=_fields)
    else:
      [%=varName%] = [%=classToAdd.eClass.name%](**_fields)
    return [%=varName%]
[% } %]


[%
}

operation EReferenceTool addReferenceTool(classToReference: EClassTool) {%]
class [%=recordToolClass("Add" + classToReference.eClass.name.ftuc() + "To" + self.eContainer.eClass.name.ftuc() + self.eReference.name.ftuc(), false)%](Tool):
  name = "add_[%=classToReference.eClass.name.ftuc()%]_to_[%=self.eContainer.eClass.name.ftuc()%]_[%=self.eReference.name.ftuc()%]"
  description = """
  Adds a [%=classToReference.eClass.name%] to the [%=self.eReference.name%] of a [%=self.eContainer.eClass.name%], and returns it.
  """
  inputs = {
    "[%=self.containerVarName()%]": {
      "type": "object",
      "description": "The [%=self.eContainer.eClass.name%] holding the [%=self.eReference.name%]"
    },
    "addition": {
      "type": "object",
      "description": "The [%=classToReference.eClass.name%] to be added"
    }
  }
  output_type = "object"

  def forward(self, [%=self.containerVarName()%]: [%=self.eContainer.eClass.name%], addition: [%=classToReference.eClass.name%]) -> [%=classToReference.eClass.name%]:
  [% if (self.fieldType().startsWith('set[')) { %]
    [%=self.containerVarName()%].[%=self.fieldName()%].add(addition)
  [% } else { %]
    [%=self.containerVarName()%].[%=self.fieldName()%] = addition
  [% } %]
    return addition


[%}


operation EReferenceTool addStringReferenceTool() {%]
class [%=recordToolClass("AddNamedTo" + self.eContainer.eClass.name.ftuc() + self.eReference.name.ftuc(), false)%](Tool):
  name = "add_named_to_[%=self.eContainer.eClass.name.ftuc()%]_[%=self.eReference.name.ftuc()%]"
  description = """
  Adds a named object to the [%=self.eReference.name%] of a [%=self.eContainer.eClass.name%], and returns its name.
  """
  inputs = {
    "[%=self.containerVarName()%]": {
      "type": "object",
      "description": "The [%=self.eContainer.eClass.name%] holding the [%=self.eReference.name%]"
    },
    "addition": {
      "type": "string",
      "description": "The name of the object to be added. Possible options: [%=self.possibleValues.collect(v|v.description).concat(', ')%]."
    }
  }
  output_type = "object"

  def forward(self, [%=self.containerVarName()%]: [%=self.eContainer.eClass.name%], addition: str) -> str:
    options = {
[% for (pv in self.possibleValues) { %]
      "[%=pv.description%]": "[%=pv.value.eResource.getURIFragment(pv.value)%]",
[% } %]
    }
  [% if (self.fieldType().startsWith('set[')) { %]
    [%=self.containerVarName()%].[%=self.fieldName()%].add(options[addition])
  [% } else { %]
    [%=self.containerVarName()%].[%=self.fieldName()%] = options[addition]
  [% } %]
    return addition


[%}

operation EClassTool rootToolClass() { %]
class [%=recordToolClass("Update" + self.eClass.name.ftuc(), true)%](Tool):
  name = "update_[%=self.eClass.name%]"
  description = """
  Updates [%=self.description.ftlc()%], and returns it.
  """
  inputs = {
[% self.attributeInputs(); %]
  }
  output_type = "object"

[% self.constructor(); %]

  def forward(self, [%=self.featureTools.collect(ft:EAttributeTool|ft.paramDeclaration()).concat(', ')%]) -> [%=self.eClass.name%]:
[% self.setAttributes('self.root'); %]
    return self.root
[%
}

operation EClassTool constructor() {%]
  def __init__(self, root: [%=toolset.rootEClass()%], *args, **kwargs):
    super().__init__(*args, **kwargs)
    self.root = root
[% }

operation EClassTool attributeInputs() {
  for (ft in self.featureTools.select(ft:EAttributeTool|true)) {%]
    "[%=ft.eAttribute.name%]": {
      "type": "[%=ft.inputType()%]",
      "description": "[%=ft.description%]"
    },
[%
  }
}

operation EClassTool setAttributes(variableName: String) {
  for (ft in self.featureTools.select(ft:EAttributeTool|true)) { %]
    [%=variableName%].[%=ft.fieldName()%] = [%=ft.varName()%]
[% }
}

%]