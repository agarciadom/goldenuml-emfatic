@namespace(uri="http://www.example.org/AircraftManagement", prefix="am")
package AircraftManagement;

class Aircraft {
	attr String[1] name;
	attr String[1] type;
	attr Integer[1] yearOfManufacture;
	attr Date dateOfNextInspection;
	val Flight[*] flights;
	val Ticket[*] tickets;
	ref Airline airline;
}

class Flight {
	attr String[1] flightNumber;
	attr Date[1] date;
	ref Passenger[*] passengers;
	val Ticket[*] tickets;
	ref Aircraft[1] aircraft;
	ref Airport[1] departureAirport;
	ref Airport[1] destinationAirport;
}

class Passenger {
	attr String[1] name;
	attr String[1] passportNumber;
	ref Flight[*] flights;
	val Ticket[*] tickets;
}

class Ticket {
	attr String[1] ticketNumber;
	attr double[1] price;
	attr boolean upgradeDesired;
	ref Passenger[1] passenger;
	ref Flight[1] flight;
	ref SeatCategory seatCategory;
}

class PassengerAircraft extends Aircraft {
	attr int[1] numberOfSeats;
	val SeatCategory[*] seatCategories;
}

class SeatCategory {
	attr String[1] designation;
	attr boolean hasEntertainment;
	attr Integer[1] numberOfSeats;
}

class Airline {
	attr String[1] name;
	ref Aircraft[*] aircrafts;
	val FlightAttendant[*] flightAttendants;
	val Pilot[*] pilots;
}

class Airport {
	attr String[1] name;
	attr String[1] address;
	attr Integer[1] numberOfRunways;
}

class FlightAttendant {
	attr String[1] name;
	attr Date[1] dateOfEmployment;
	attr boolean isChiefSteward;
}

class Pilot {
	attr String[1] name;
	attr Date[1] dateOfEmployment;
	attr String[1] license;
}