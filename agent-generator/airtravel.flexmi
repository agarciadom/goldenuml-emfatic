<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AircraftManagement" nsURI="http://www.example.org/AircraftManagement" nsPrefix="am">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="type" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="yearOfManufacture" upperBound="1" lowerBound="1" eType="//@eClassifiers.11" />
        <eAttribute name="dateOfNextInspection" upperBound="1" lowerBound="0" eType="//@eClassifiers.12" />
        <eReference name="flights" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.1" />
        <eReference name="tickets" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.3" />
        <eReference name="airline" containment="False" upperBound="1" lowerBound="0" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Flight">
      <eStructuralFeatures>
        <eAttribute name="flightNumber" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="date" upperBound="1" lowerBound="1" eType="//@eClassifiers.12" />
        <eReference name="passengers" containment="False" upperBound="-1" lowerBound="0" eType="//@eClassifiers.2" />
        <eReference name="tickets" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.3" />
        <eReference name="aircraft" containment="False" upperBound="1" lowerBound="1" eType="//@eClassifiers.0" />
        <eReference name="departureAirport" containment="False" upperBound="1" lowerBound="1" eType="//@eClassifiers.7" />
        <eReference name="destinationAirport" containment="False" upperBound="1" lowerBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Passenger">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="passportNumber" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eReference name="flights" containment="False" upperBound="-1" lowerBound="0" eType="//@eClassifiers.1" />
        <eReference name="tickets" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eAttribute name="ticketNumber" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="price" upperBound="1" lowerBound="1" eType="//EDouble" />
        <eAttribute name="upgradeDesired" upperBound="1" lowerBound="0" eType="//EBoolean" />
        <eReference name="passenger" containment="False" upperBound="1" lowerBound="1" eType="//@eClassifiers.2" />
        <eReference name="flight" containment="False" upperBound="1" lowerBound="1" eType="//@eClassifiers.1" />
        <eReference name="seatCategory" containment="False" upperBound="1" lowerBound="0" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PassengerAircraft" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="numberOfSeats" upperBound="1" lowerBound="1" eType="//EInt" />
        <eReference name="seatCategories" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SeatCategory">
      <eStructuralFeatures>
        <eAttribute name="designation" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="hasEntertainment" upperBound="1" lowerBound="0" eType="//EBoolean" />
        <eAttribute name="numberOfSeats" upperBound="1" lowerBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airline">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eReference name="aircrafts" containment="False" upperBound="-1" lowerBound="0" eType="//@eClassifiers.0" />
        <eReference name="flightAttendants" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.8" />
        <eReference name="pilots" containment="True" upperBound="-1" lowerBound="0" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airport">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="address" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="numberOfRunways" upperBound="1" lowerBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FlightAttendant">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="dateOfEmployment" upperBound="1" lowerBound="1" eType="//@eClassifiers.12" />
        <eAttribute name="isChiefSteward" upperBound="1" lowerBound="0" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pilot">
      <eStructuralFeatures>
        <eAttribute name="name" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="dateOfEmployment" upperBound="1" lowerBound="1" eType="//@eClassifiers.12" />
        <eAttribute name="license" upperBound="1" lowerBound="1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
    <eDataType name="Date" instanceClassName="java.util.Date" />
  </eClassifiers>
</ePackage>
