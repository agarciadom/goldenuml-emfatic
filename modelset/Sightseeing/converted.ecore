<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="cityTours"
    nsURI="http://www.example.org/cityTours"
    nsPrefix="cityTours">

  <eClassifiers xsi:type="ecore:EClass" name="City">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfInhabitants" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attractions" upperBound="-1"
        eType="#//Attraction" containment="true" eOpposite="#//Attraction/city"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Attraction">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="city" lowerBound="1"
        eType="#//City" eOpposite="#//City/attractions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="guidedTours" upperBound="-1"
        eType="#//GuidedTour" containment="true" eOpposite="#//GuidedTour/attraction"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Guide" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EReference" name="guidedTours" upperBound="-1"
        eType="#//GuidedTour" eOpposite="#//GuidedTour/guide"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Visitor" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EReference" name="guidedTours" lowerBound="0" upperBound="-1"
        eType="#//GuidedTour" eOpposite="#//GuidedTour/visitors"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="discounts" upperBound="-1"
        eType="#//Discount" containment="true" eOpposite="#//Discount/visitor"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="GuidedTour">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="visitors" lowerBound="1" upperBound="20"
        eType="#//Visitor" eOpposite="#//Visitor/guidedTours"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="guide" lowerBound="1"
        eType="#//Guide" eOpposite="#//Guide/guidedTours"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attraction" lowerBound="1"
        eType="#//Attraction" eOpposite="#//Attraction/guidedTours"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="discounts" upperBound="-1"
        eType="#//Discount" eOpposite="#//Discount/guidedTour"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Discount">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="visitor" lowerBound="1"
        eType="#//Visitor" eOpposite="#//Visitor/discounts"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="guidedTour" lowerBound="1"
        eType="#//GuidedTour" eOpposite="#//GuidedTour/discounts"/>
  </eClassifiers>

</ecore:EPackage>
