@namespace(uri="http://www.example.org/cityTourism", prefix="cityTourism")
package cityTourism;

class CityTourismModel {
	val City[*] cities;
	val Person[*] persons;
	val Visitor[*] visitors;
	val GuidedTour[*] guidedTours;
	val Discount[*] discounts;
}

class City {
	attr String name;
	attr int numberOfInhabitants;
	val Attraction[*]#city attractions;
}

class Attraction {
	attr String name;
	attr String address;
	ref City#attractions city;
	ref GuidedTour[*]#attraction guidedTours;
}

class Person {
	attr String name;
}

class Guide extends Person {
	ref GuidedTour[*]#guide guidedTours;
}

class Visitor extends Person {
	ref Discount[*]#visitor discounts;
}

class GuidedTour {
	attr int number;
	attr int duration;
	ref Guide#guidedTours guide;
	ref Attraction#guidedTours attraction;
	ref Discount[*]#guidedTour discounts;
}

class Discount {
	attr int discount;
	ref Visitor#discounts visitor;
	ref GuidedTour#discounts guidedTour;
}


