@namespace(uri="http://www.example.org/cityTourPackage", prefix="cityTourPackage")
package cityTourPackage;

class City {
	attr String Name;
	attr int NumberOfInhabitants;
	ref Attraction[*]#city attractions;
}

class Attraction {
	attr String Name;
	attr String Address;
	ref City[1]#attractions city;
	ref GuidedTour[*]#attraction guidedTours;
}

class Visitor extends Person {
	ref Discount[*]#visitor discounts;
}

class GuidedTour {
	attr int Number;
	attr int Duration;
	ref Attraction[1]#guidedTours attraction;
	ref Guide[1]#guidedTours guide;
	ref Discount[*]#guidedTour discounts;
}

class Discount {
	attr int DiscountValue;
	ref Visitor[1]#discounts visitor;
	ref GuidedTour[1]#discounts guidedTour;
}

class Person {
	attr String Name;
}

class Guide extends Person {
	ref GuidedTour[*]#guide guidedTours;
}


