@namespace(uri="http://www.example.org/tourmanagement", prefix="tourmanagement")
package tourmanagement;

class TourManagementSystem {
	val City[*] cities;
	val Person[*] people;
	val GuidedTour[*] guidedTours;
}

class City {
	attr String name;
	attr int numberOfInhabitants;
	val Attraction[*] attractions;
}

class Attraction {
	attr String name;
	attr String address;
	ref GuidedTour[*]#attraction guidedTours;
}

abstract class Person {
	attr String name;
}

class Guide extends Person {
	ref GuidedTour[*]#guide guidedTours;
}

class Visitor extends Person {
	val Discount[*]#visitor discounts;
}

class GuidedTour {
	attr int number;
	attr int duration;
	ref Attraction#guidedTours attraction;
	ref Guide#guidedTours guide;
	ref Discount[*]#guidedTour discounts;
}

class Discount {
	attr int discount;
	ref Visitor#discounts visitor;
	ref GuidedTour#discounts guidedTour;
}


