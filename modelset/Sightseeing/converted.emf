@namespace(uri="http://www.example.org/cityTours", prefix="cityTours")
package cityTours;

class City {
	attr String name;
	attr int numberOfInhabitants;
	val Attraction[*]#city attractions;
}

class Attraction {
	attr String name;
	attr String address;
	ref City[1]#attractions city;
	val GuidedTour[*]#attraction guidedTours;
}

class Person {
	attr String name;
}

class Guide extends Person {
	ref GuidedTour[*]#guide guidedTours;
}

class Visitor extends Person {
	ref GuidedTour[*]#visitors guidedTours;
	val Discount[*]#visitor discounts;
}

class GuidedTour {
	attr int number;
	attr int duration;
	ref Visitor[1..20]#guidedTours visitors;
	ref Guide[1]#guidedTours guide;
	ref Attraction[1]#guidedTours attraction;
	ref Discount[*]#guidedTour discounts;
}

class Discount {
	attr int discount;
	ref Visitor[1]#discounts visitor;
	ref GuidedTour[1]#discounts guidedTour;
}


