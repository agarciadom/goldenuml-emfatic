@namespace(uri="http://www.example.org/touristSystem", prefix="touristSystem")
package touristSystem;

class TouristSystem {
	val City[*] cities;
	val Person[*] people;
}

abstract class Person {
	attr String name;
}

class Visitor extends Person {
	ref TourParticipation[*]#visitor tourParticipations;
}

class Guide extends Person {
	ref GuidedTour[*]#guide guidedTours;
}

class City {
	attr String name;
	attr int numberOfInhabitants;
	val Attraction[*] attractions;
}

class Attraction {
	attr String name;
	attr String address;
	val GuidedTour[*] guidedTours;
}

class GuidedTour {
	attr int number;
	attr Duration duration;
	attr int maxVisitors = 20;
	ref Guide#guidedTours guide;
	val TourParticipation[0..20]#guidedTour tourParticipations;
}

class TourParticipation {
	attr double discount;
	ref GuidedTour#tourParticipations guidedTour;
	ref Visitor#tourParticipations visitor;
}

datatype Duration : java.time.Duration;


