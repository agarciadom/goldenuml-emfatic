<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">

  <ecore:EPackage name="CityTourismModel" nsURI="http://www.example.org/CityTourismModel" nsPrefix="CityTourismModel">
    <!-- Root Container Class -->
    <ecore:EClass name="RootContainer">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="cities" eType="#//City" containment="true" lowerBound="0" upperBound="-1"/>
    </ecore:EClass>

    <!-- City Class -->
    <ecore:EClass name="City">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EAttribute name="inhabitants" eType="ecore:EInt"/>
      <ecore:EReference name="attractions" eType="#//Attraction" containment="true" lowerBound="0" upperBound="-1"/>
    </ecore:EClass>

    <!-- Attraction Class -->
    <ecore:EClass name="Attraction">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EAttribute name="address" eType="ecore:EString"/>
      <ecore:EReference name="guidedTours" eType="#//GuidedTour" containment="true" lowerBound="0" upperBound="-1"/>
    </ecore:EClass>

    <!-- Guided Tour Class -->
    <ecore:EClass name="GuidedTour">
      <ecore:EAttribute name="duration" eType="#//DurationType"/>
      <ecore:EReference name="visitors" eType="#//VisitorDiscount" containment="false" lowerBound="0" upperBound="-1"/>
      <ecore:EReference name="guide" eType="#//Guide" lowerBound="1" upperBound="1" containment="true"/>
      <ecore:EAttribute name="maxVisitors" eType="ecore:EInt" defaultValueLiteral="20"/>
    </ecore:EClass>

    <!-- Person Class (Abstract) -->
    <ecore:EClass name="Person" abstract="true">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Visitor Class inheriting from Person -->
    <ecore:EClass name="Visitor" eSuperTypes="#//Person">
      <ecore:EReference name="discounts" eType="#//VisitorDiscount" containment="true" lowerBound="0" upperBound="-1"/>
    </ecore:EClass>

    <!-- Guide Class inheriting from Person -->
    <ecore:EClass name="Guide" eSuperTypes="#//Person"/>

    <!-- Visitor Discount Association Class (for Visitor and GuidedTour) -->
    <ecore:EClass name="VisitorDiscount">
      <ecore:EReference name="visitor" eType="#//Visitor"/>
      <ecore:EReference name="guidedTour" eType="#//GuidedTour"/>
      <ecore:EAttribute name="amount" eType="ecore:EFloat"/>
    </ecore:EClass>

    <!-- Custom Data Type for Duration -->
    <ecore:EDataType name="DurationType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
        <details key="body" value="java.time.Duration"/>
      </eAnnotations>
    </ecore:EDataType>

  </ecore:EPackage>
</xmi:XMI>
