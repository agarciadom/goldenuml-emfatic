<model xsi:type="ecore:EPackage" name="system"
       nsURI="http://www.example.com/system"
       nslrefix="system">
  <eClassifiers>
    <!-- Root container class -->
    <model xsi:type="ecore:EClass" name="Root">
      <eStructuralFeatures>
        <model xsi:type="ecore:EReference"
               name="cities"
               type="system::City"
               upper="-1"
               containment="true"/>
      </eStructuralFeatures>
    </model>

    <!-- Person class representing both visitors and guides -->
    <model xsi:type="ecore:EClass" name="Person">
      <eStructuralFeatures>
        <model xsi:type="ecore:EAttribute"
               name="name"
               type="ecore:EString"/>
      </eStructuralFeatures>
    </model>

    <!-- City class with name, inhabitants and attractions -->
    <model xsi:type="ecore:EClass" name="City">
      <eStructuralFeatures>
        <model xsi:type="ecore:EAttribute"
               name="name"
               type="ecore:EString"/>
        <model xsi:type="ecore:EAttribute"
               name="inhabitants"
               type="ecore:ELong"/>
        <model xsi:type="ecore:EReference"
               name="attractions"
               type="system::Attraction"
               upper="-1"
               containment="true"/>
      </eStructuralFeatures>
    </model>

    <!-- Attraction class with name, address and guided tours -->
    <model xsi:type="ecore:EClass" name="Attraction">
      <eStructuralFeatures>
        <model xsi:type="ecore:EAttribute"
               name="name"
               type="ecore:EString"/>
        <model xsi:type="ecore:EAttribute"
               name="address"
               type="ecore:EString"/>
        <model xsi:type="ecore:EReference"
               name="guidedTours"
               type="system::GuidedTour"
               upper="-1"
               containment="true"/>
      </eStructuralFeatures>
    </model>

    <!-- GuidedTour class with duration, visitor limit, guide and visitors -->
    <model xsi:type="ecore:EClass" name="GuidedTour">
      <eStructuralFeatures>
        <model xsi:type="ecore:EAttribute"
               name="duration"
               type="java.time.Duration"/>
        <model xsi:type="ecore:EAttribute"
               name="visitorLimit"
               type="ecore:EInt"
               defaultValue="20"/>
        <model xsi:type="ecore:EReference"
               name="guide"
               type="system::Person"/>
        <model xsi:type="ecore:EReference"
               name="visitors"
               type="system::VisitorInfo"
               upper="-1"/>
      </eStructuralFeatures>
    </model>

    <!-- VisitorInfo association class linking a Person (visitor) to a GuidedTour,
         optionally storing a discount amount -->
    <model xsi:type="ecore:EClass" name="VisitorInfo">
      <eStructuralFeatures>
        <model xsi:type="ecore:EReference"
               name="visitor"
               type="system::Person"
               containment="false"/>
        <model xsi:type="ecore:EReference"
               name="guidedTour"
               type="system::GuidedTour"
               containment="false"
               opposite="visitors"/>
        <model xsi:type="ecore:EAttribute"
               name="discountAmount"
               type="java.math.BigDecimal"/>
      </eStructuralFeatures>
    </model>
  </eClassifiers>
</model>
