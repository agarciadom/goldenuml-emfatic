@namespace(uri="http://www.tourism.com/efs", prefix="tourism")
package Tourism;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] name;
}

class Visitor extends Person {
}

class Guide extends Person {
}

class City {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] inhabitants;
	val Attraction[*] attractions;
}

class Attraction {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	val GuidedTour[*] guidedTours;
}

class GuidedTour {
	attr ecore.EInt[1] duration;
	attr ecore.EInt[1] number;
	ref Guide[1] guide;
	ref Visitor[0..20] visitors;
	val Discount[*] discounts;
}

class Discount {
	attr ecore.EDouble[1] amount;
	ref Visitor[1] visitor;
}


