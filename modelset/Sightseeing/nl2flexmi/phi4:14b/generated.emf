@namespace(uri="http://www.example.org/citypackage", prefix="cp")
package CityPackage;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] name;
}

class City {
	attr ecore.EString[1] name;
	attr ecore.EInt inhabitants;
	ref Attraction[*] attractions;
}

class Attraction {
	attr ecore.EString[1] name;
	attr ecore.EString address;
	ref GuidedTour[*] guidedTours;
}

class GuidedTour {
	attr ecore.EString[1] name;
	attr ecore.EInt duration;
	ref Visitor[0..20] visitors;
	ref Guide[1] guide;
}

class Visitor extends Person {
}

class Guide extends Person {
}


