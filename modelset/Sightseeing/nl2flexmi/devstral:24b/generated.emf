@namespace(uri="http://www.example.org/tourism", prefix="tourism")
package Tourism;

import "http://www.eclipse.org/emf/2002/Ecore";

class City {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] inhabitants;
	val Attraction[*] attractions;
}

class Attraction {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	ref GuidedTour[*] tours;
	ref City city;
}

class GuidedTour {
	attr ecore.EInt[1] duration;
	attr ecore.EInt[1] number;
	attr ecore.EInt[1] maxVisitors;
	val Guide[1] guide;
	ref Visitor[0..20] visitors;
	ref Discount[*] discounts;
}

class Person {
}

class Visitor extends Person {
}

class Guide extends Person {
}

class Discount {
	ref Visitor[*] applicableVisitors;
}


