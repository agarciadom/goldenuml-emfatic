<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Tourism" nsURI="http://www.example.org/tourism" nsPrefix="tourism">
  <eClassifiers>
    <eClass name="City">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="inhabitants" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="attractions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Attraction">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="tours" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="city" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GuidedTour">
      <eStructuralFeatures>
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="maxVisitors" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="guide" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="visitors" containment="False" lowerBound="0" upperBound="20" eType="//@eClassifiers.4" />
        <eReference name="discounts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Visitor" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Guide" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Discount">
      <eStructuralFeatures>
        <eReference name="applicableVisitors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
