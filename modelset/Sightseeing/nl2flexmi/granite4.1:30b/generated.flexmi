<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CityAttractions" nsURI="http://example.com/cityattractions" nsPrefix="caa">
  <eClassifiers>
    <eClass name="Entity">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="City" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="inhabitants" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="attractions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Attraction" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GuidedTour" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="numberOfVisitors" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="attraction" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="guide" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="visitors" containment="True" lowerBound="0" upperBound="20" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Discount">
      <eStructuralFeatures>
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="tour" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="visitor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
