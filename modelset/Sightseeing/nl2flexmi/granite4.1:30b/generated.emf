@namespace(uri="http://example.com/cityattractions", prefix="caa")
package CityAttractions;

import "http://www.eclipse.org/emf/2002/Ecore";

class Entity {
	attr ecore.EString[1] name;
}

class City extends Entity {
	attr ecore.EInt[1] inhabitants;
	val Attraction[*] attractions;
}

class Attraction extends Entity {
	attr ecore.EString[1] address;
}

class GuidedTour extends Entity {
	attr ecore.EInt[1] duration;
	attr ecore.EInt numberOfVisitors;
	ref Attraction[1] attraction;
	ref Person[1] guide;
	val Person[0..20] visitors;
}

class Person {
	attr ecore.EString[1] name;
}

class Discount {
	attr ecore.EInt[1] amount;
	ref GuidedTour[1] tour;
	ref Person[1] visitor;
}


