@namespace(uri="http://gameareamodel/example", prefix="p")
package GameAreaModel;

class GameElement {
  attr long x;
  attr long y;
}
class Shape extends GameElement {
  val Shape[*] connectedShapes;
}
class Object extends GameElement {
}
class Opponent extends GameElement {
  attr int lives;
}
class GamePiece extends GameElement {
}
class GameArea {
  attr String name;
  val GameElement[*] elements;
  val GamePiece[*] pieces;
  ref Opponent boss;
}