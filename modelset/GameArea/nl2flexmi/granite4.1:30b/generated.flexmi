<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="GameArea" nsURI="http://example.com/gamearea" nsPrefix="ga">
  <eClassifiers>
    <eClass name="GameElement">
      <eStructuralFeatures>
        <eAttribute name="x" lowerBound="1" upperBound="1" eType="//ELong" />
        <eAttribute name="y" lowerBound="1" upperBound="1" eType="//ELong" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shape" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="connectedShapes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Object" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Opponent" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="lives" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GameArea">
      <eStructuralFeatures>
        <eReference name="elements" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="boss" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
