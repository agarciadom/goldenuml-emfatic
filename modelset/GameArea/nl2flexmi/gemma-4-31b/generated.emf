@namespace(uri="http://www.example.org/GameAreaPackage", prefix="gamearea")
package GameAreaPackage;

import "http://www.eclipse.org/emf/2002/Ecore";

class GameArea {
	attr ecore.EString name;
	val GameElement[+] gameElements;
	val GamePiece[1..2] gamePieces;
	ref Opponent[1] boss;
}

class GameElement {
	attr ecore.ELong x;
	attr ecore.ELong y;
}

class Shape extends GameElement {
	ref Shape[*] connectedShapes;
}

class Object extends GameElement {
}

class Opponent extends GameElement {
	attr ecore.EInt lives;
}

class GamePiece {
}


