<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="GameAreaPackage" nsURI="http://www.example.org/GameAreaPackage" nsPrefix="gamearea">
  <eClassifiers>
    <eClass name="GameArea">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="gameElements" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="gamePieces" containment="True" lowerBound="1" upperBound="2" eType="//@eClassifiers.5" />
        <eReference name="boss" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GameElement">
      <eStructuralFeatures>
        <eAttribute name="x" lowerBound="0" upperBound="1" eType="//ELong" />
        <eAttribute name="y" lowerBound="0" upperBound="1" eType="//ELong" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shape" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="connectedShapes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Object" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Opponent" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="lives" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GamePiece">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
