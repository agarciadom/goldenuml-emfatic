@namespace(uri="http://www.example.org/GameModel", prefix="gm")
package GameModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class GameArea {
	attr ecore.EString[1] name;
	val GameElement[+] gameElements;
	val Shape[1..2] gamePieces;
	ref Opponent[1] boss;
}

class GameElement {
	attr ecore.ELong[1] x;
	attr ecore.ELong[1] y;
}

class Shape extends GameElement {
	ref Shape[*] connectedShapes;
}

class GameObject extends GameElement {
}

class Opponent extends GameElement {
}

class Enemy {
	attr ecore.EInt[1] lives;
}


