<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="game"
    nsURI="http://www.example.org/game"
    nsPrefix="game">

  <!-- Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="GameWorld">
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameAreas"
        eType="#//GameArea"
        containment="true"
        upperBound="-1"/>
  </eClassifiers>

  <!-- GameArea class -->
  <eClassifiers xsi:type="ecore:EClass" name="GameArea">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameCharacters"
        eType="#//GameCharacter"
        containment="true"
        upperBound="2"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameElements"
        eType="#//GameElement"
        containment="true"
        upperBound="-1"
        lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="finalBoss"
        eType="#//Enemy"
        lowerBound="1"/>
  </eClassifiers>

  <!-- GameCharacter class -->
  <eClassifiers xsi:type="ecore:EClass" name="GameCharacter"/>

  <!-- GameElement class (abstract base) -->
  <eClassifiers xsi:type="ecore:EClass" name="GameElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
  </eClassifiers>

  <!-- Shape class -->
  <eClassifiers xsi:type="ecore:EClass" name="Shape" eSuperTypes="#//GameElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="isConnectedWith"
        eType="#//Shape"
        upperBound="-1"
        eOpposite="#//Shape/connectedFrom"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="connectedFrom"
        eType="#//Shape"
        upperBound="-1"
        eOpposite="#//Shape/isConnectedWith"/>
  </eClassifiers>

  <!-- Item class -->
  <eClassifiers xsi:type="ecore:EClass" name="Item" eSuperTypes="#//GameElement"/>

  <!-- Enemy class -->
  <eClassifiers xsi:type="ecore:EClass" name="Enemy" eSuperTypes="#//GameElement">
    <eOperations name="toKill"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfLives"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

</ecore:EPackage>
