<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="gamePackage"
    nsURI="http://www.example.com/gamePackage"
    nsPrefix="gamePackage">

  <!-- GameArea class with name attribute and references to GameCharacter, GameElement, and Enemy (finalBoss) -->
  <eClassifiers xsi:type="ecore:EClass" name="GameArea">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Aggregation: 1 GameArea to 1..2 GameCharacter -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameCharacters"
        eType="#//GameCharacter"
        upperBound="2" lowerBound="1"
        containment="false"/>
    <!-- Aggregation: 1 GameArea to 1..* GameElement -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameElements"
        eType="#//GameElement"
        upperBound="-1" lowerBound="1"
        containment="false"/>
    <!-- Directed association: 1 GameArea to 1 Enemy (finalBoss) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="finalBoss"
        eType="#//Enemy"
        lowerBound="1"
        containment="false"/>
  </eClassifiers>

  <!-- GameCharacter class -->
  <eClassifiers xsi:type="ecore:EClass" name="GameCharacter"/>

  <!-- GameElement class with x and y attributes -->
  <eClassifiers xsi:type="ecore:EClass" name="GameElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
  </eClassifiers>

  <!-- Shape class, extends GameElement, with self-association is_connected_with -->
  <eClassifiers xsi:type="ecore:EClass" name="Shape" eSuperTypes="#//GameElement">
    <!-- Self-association: * Shape is_connected_with * Shape, modeled as two opposite references -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="isConnectedWith"
        eType="#//Shape"
        upperBound="-1"
        containment="false"
        eOpposite="#//Shape/isConnectedWithOpposite"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="isConnectedWithOpposite"
        eType="#//Shape"
        upperBound="-1"
        containment="false"
        eOpposite="#//Shape/isConnectedWith"/>
  </eClassifiers>

  <!-- Item class, extends GameElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Item" eSuperTypes="#//GameElement"/>

  <!-- Enemy class, extends GameElement, with numberOfLives attribute and toKill operation -->
  <eClassifiers xsi:type="ecore:EClass" name="Enemy" eSuperTypes="#//GameElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfLives" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eOperations name="toKill"/>
  </eClassifiers>

</ecore:EPackage>
