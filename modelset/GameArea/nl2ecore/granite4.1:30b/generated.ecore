<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="https://www.eclipse.org/emf/[version]/ecore.xsd">
  
  <EClass name="GameArea">
    <!-- The textual name of the game area -->
    <eStructuralFeatures>
      <EAttribute name="name" eType="string"/>
      
      <!-- Composition: a GameArea owns its elements (minimum one) -->
      <EReference name="elements" eType="Element"
                  lowerBound="1" upperBound="-1" containment="true"/>
      
      <!-- Composition: a GameArea owns its pieces (one or two) -->
      <EReference name="pieces" eType="Piece"
                  lowerBound="1" upperBound="2" containment="true"/>
      
      <!-- Role "boss": exactly one opponent known as the boss of this area -->
      <EReference name="boss" eType="Opponent" containment="true"/>
    </eStructuralFeatures>
  </EClass>

  <!-- Abstract base class for all game elements that have a position -->
  <EClass name="Element" abstract="true">
    <eStructuralFeatures>
      <EAttribute name="x" eType="long"/>
      <EAttribute name="y" eType="long"/>
    </eStructuralFeatures>
  </EClass>

  <!-- Concrete subclass representing geometric shapes -->
  <EClass name="Shape" eSuperTypes="Element">
    <eStructuralFeatures>
      <!-- Navigable association to other Shape instances (any number, non‑containing) -->
      <EReference name="connectedShapes" eType="Shape"
                  upperBound="-1" containment="false"/>
    </eStructuralFeatures>
  </EClass>

  <!-- Concrete subclass representing ordinary objects in the game area -->
  <EClass name="Object" eSuperTypes="Element"/>

  <!-- Concrete subclass representing opponents (including enemies) -->
  <EClass name="Opponent" eSuperTypes="Element">
    <eStructuralFeatures>
      <!-- Number of lives; visibility is omitted because it is transient in XMI -->
      <EAttribute name="lives" eType="int"/>
    </eStructuralFeatures>

    <!-- Operation that can be invoked to kill the opponent -->
    <eOperations>
      <EOperation name="kill">
        <eTypeParameters/>
        <eParameters/>
      </EOperation>
    </eOperations>
  </EClass>

  <!-- Abstract classification for anything occupying a position in the game area -->
  <EClass name="Piece" abstract="true"/>
</model>
