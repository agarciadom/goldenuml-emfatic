<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI"
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
         xmi:version="2.0">

  <ecore:EPackage name="GameModel" nsURI="game.model" nsPrefix="gm">
    <!-- GameArea Class -->
    <ecore:EClass name="GameArea">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="gameElements" eType="#//GameElement" containment="true" upperBound="-1"/>
      <ecore:EReference name="boss" eType="#//Opponent"/>
    </ecore:EClass>

    <!-- GameElement Abstract Class -->
    <ecore:EClass name="GameElement" abstract="true">
      <ecore:EAttribute name="x" eType="ecore:ELong"/>
      <ecore:EAttribute name="y" eType="ecore:ELong"/>
    </ecore:EClass>

    <!-- Shape Class (inherits from GameElement) -->
    <ecore:EClass name="Shape" superTypes="#//GameElement">
      <ecore:EReference name="connectedShapes" eType="#//Shape" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Object Class (inherits from GameElement) -->
    <ecore:EClass name="Object" superTypes="#//GameElement"/>

    <!-- Opponent Class (inherits from GameElement) -->
    <ecore:EClass name="Opponent" superTypes="#//GameElement">
      <ecore:EAttribute name="lives" eType="ecore:EInt"/>
      <ecore:EOperation name="kill"/>
    </ecore:EClass>
  </ecore:EPackage>

</xmi:XMI>
