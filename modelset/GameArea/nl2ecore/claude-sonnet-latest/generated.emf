@namespace(uri="http://www.example.org/gamearea", prefix="gamearea")
package gamearea;

class GameWorld {
	val GameArea[*] areas;
}

class GameArea {
	attr String name;
	val GameElement[+] gameElements;
	val GamePiece[1..2] gamePieces;
	ref Opponent[1] boss;
}

class GamePiece {
}

abstract class GameElement {
	attr long x;
	attr long y;
}

class Shape extends GameElement {
	ref Shape[*] connectedShapes;
}

class Object extends GameElement {
}

class Opponent extends GameElement {
	op void kill();
	attr int lives;
}


