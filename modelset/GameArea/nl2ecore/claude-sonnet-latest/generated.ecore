<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="gamearea"
    nsURI="http://www.example.org/gamearea"
    nsPrefix="gamearea">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="GameWorld">
    <eStructuralFeatures xsi:type="ecore:EReference" name="areas"
        eType="#//GameArea"
        containment="true"
        upperBound="-1"/>
  </eClassifiers>

  <!-- GameArea -->
  <eClassifiers xsi:type="ecore:EClass" name="GameArea">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- consists of at least one game element (1..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameElements"
        eType="#//GameElement"
        containment="true"
        upperBound="-1"
        lowerBound="1"/>
    <!-- one or two game pieces (1..2) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gamePieces"
        eType="#//GamePiece"
        containment="true"
        upperBound="2"
        lowerBound="1"/>
    <!-- Exactly one opponent known as boss -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="boss"
        eType="#//Opponent"
        lowerBound="1"
        upperBound="1"/>
  </eClassifiers>

  <!-- GamePiece -->
  <eClassifiers xsi:type="ecore:EClass" name="GamePiece">
  </eClassifiers>

  <!-- GameElement (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="GameElement" abstract="true">
    <!-- x is protected long -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <!-- y is private long -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
  </eClassifiers>

  <!-- Shape extends GameElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Shape">
    <eSuperTypes href="#//GameElement"/>
    <!-- connected to any number of other shapes -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="connectedShapes"
        eType="#//Shape"
        upperBound="-1"/>
  </eClassifiers>

  <!-- Object extends GameElement -->
  <eClassifiers xsi:type="ecore:EClass" name="Object">
    <eSuperTypes href="#//GameElement"/>
  </eClassifiers>

  <!-- Opponent extends GameElement (Enemy) -->
  <eClassifiers xsi:type="ecore:EClass" name="Opponent">
    <eSuperTypes href="#//GameElement"/>
    <!-- lives is protected int -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lives"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- kill operation -->
    <eOperations name="kill"/>
  </eClassifiers>

</ecore:EPackage>
