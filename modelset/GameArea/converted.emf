@namespace(uri="http://www.example.org/game", prefix="game")
package game;

class GameWorld {
	val GameArea[*] gameAreas;
}

class GameArea {
	attr String name;
	val GameCharacter[1..2] gameCharacters;
	val GameElement[+] gameElements;
	ref Enemy[1] finalBoss;
}

class GameCharacter {
}

abstract class GameElement {
	attr long x;
	attr long y;
}

class Shape extends GameElement {
	ref Shape[*]#connectedFrom isConnectedWith;
	ref Shape[*]#isConnectedWith connectedFrom;
}

class Item extends GameElement {
}

class Enemy extends GameElement {
	op void toKill();
	attr int numberOfLives;
}


