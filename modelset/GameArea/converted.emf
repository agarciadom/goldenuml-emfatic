@namespace(uri="http://www.example.com/gamePackage", prefix="gamePackage")
package gamePackage;

class GameArea {
	attr String name;
	ref GameCharacter[1..2] gameCharacters;
	ref GameElement[+] gameElements;
	ref Enemy[1] finalBoss;
}

class GameCharacter {
}

abstract class GameElement {
	attr long x;
	attr long y;
}

class Shape extends GameElement {
	ref Shape[*]#isConnectedWithOpposite isConnectedWith;
	ref Shape[*]#isConnectedWith isConnectedWithOpposite;
}

class Item extends GameElement {
}

class Enemy extends GameElement {
	op void toKill();
	attr int numberOfLives;
}


