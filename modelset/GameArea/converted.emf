@namespace(uri="http://www.example.com/game", prefix="game")
package game;

class GameArea {
	attr String name;
	val GameCharacter[1..2] characters;
	val GameElement[+] elements;
	ref Enemy[1] finalBoss;
}

class GameCharacter {
}

class GameElement {
	attr long x;
	attr long y;
}

class Shape extends GameElement {
	ref Shape[*]#isConnectedWith isConnectedWith;
}

class Item extends GameElement {
}

class Enemy extends GameElement {
	op void toKill();
	attr int numberOfLives;
}


