<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ScienceConnect" nsURI="http://www.example.org/ScienceConnect" nsPrefix="sc">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eReference name="institution" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="personID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="researchKeywords" lowerBound="0" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institution">
      <eStructuralFeatures>
        <eAttribute name="institutionCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScientificArticle">
      <eStructuralFeatures>
        <eAttribute name="doi" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="authors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PeerReviewedPaper" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="citationCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="reviewers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="journal" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TechnicalReport" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eReference name="publisher" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Publisher">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="journals" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Journal">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="impactFactor" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
