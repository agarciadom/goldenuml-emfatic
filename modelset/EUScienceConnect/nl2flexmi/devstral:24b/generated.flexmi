<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ScienceConnect" nsURI="http://scienceconnect.eu/research" nsPrefix="sc">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="personID" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="institution" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institution">
      <eStructuralFeatures>
        <eAttribute name="institutionCode" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="technicalReports" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Article">
      <eStructuralFeatures>
        <eAttribute name="DOI" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="title" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="authors" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PeerReviewedPaper" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="citationCount" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="reviewers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TechnicalReport" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Publisher">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Journal">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="impactFactor" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="publisher" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
    <eDataType name="Double" instanceClassName="java.lang.Double" />
  </eClassifiers>
</ePackage>
