@namespace(uri="http://www.scienceconnect.eu", prefix="sc")
package ScienceConnect;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] personID;
	attr ecore.EString phoneNumber;
	attr ecore.EString[*] keywords;
	ref Institution institution;
}

class Institution {
	attr ecore.EString[1] institutionCode;
	ref Person[*] persons;
	val TechnicalReport[*] technicalReports;
}

class Article {
	attr ecore.EString[1] doi;
	attr ecore.EString[1] title;
	ref Person[*] authors;
}

class PeerReviewedPaper extends Article {
	attr ecore.EInt citationCount;
	ref Person[*] reviewers;
}

class TechnicalReport extends Article {
	ref Institution[1] publishingInstitution;
}

class Journal {
	attr ecore.EString[1] name;
	attr ecore.EString impactFactor;
}

class Publisher {
	attr ecore.EString[1] name;
	ref Journal[*] journals;
}


