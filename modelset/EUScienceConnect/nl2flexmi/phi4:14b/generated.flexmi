<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ScienceConnect" nsURI="http://www.scienceconnect.eu" nsPrefix="sc">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="personID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="keywords" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="institution" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institution">
      <eStructuralFeatures>
        <eAttribute name="institutionCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="persons" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="technicalReports" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Article">
      <eStructuralFeatures>
        <eAttribute name="doi" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="authors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PeerReviewedPaper" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="citationCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="reviewers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TechnicalReport" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eReference name="publishingInstitution" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Journal">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="impactFactor" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Publisher">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="journals" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
