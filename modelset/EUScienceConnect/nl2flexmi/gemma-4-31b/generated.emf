@namespace(uri="http://www.scienceconnect.org/database", prefix="sc")
package ScienceConnect;

import "http://www.eclipse.org/emf/2002/Ecore";

class ResearchDatabase {
	val Person[*] persons;
	val Institution[*] institutions;
	val ScientificArticle[*] articles;
	val Publisher[*] publishers;
}

class Person {
	attr ecore.EString[1] personID;
	attr ecore.EString phoneNumber;
	attr ecore.EString[*] keywords;
	ref Institution[1] worksFor;
}

class Institution {
	attr ecore.EString[1] institutionCode;
	ref Journal[*] subscriptions;
}

class ScientificArticle {
	attr ecore.EString[1] doi;
	attr ecore.EString[1] title;
	val ArticleAuthor[+] authors;
}

class PeerReviewedPaper extends ScientificArticle {
	attr ecore.EInt citationCount;
	ref Person[+] reviewers;
	ref Journal[1] publishedIn;
}

class TechnicalReport extends ScientificArticle {
	ref Institution[1] publishedBy;
}

class Publisher {
	attr ecore.EString[1] name;
}

class Journal {
	attr ecore.EString[1] name;
	attr ecore.EDouble impactFactor;
	ref Publisher[1] publishedBy;
}

class ArticleAuthor {
	attr ecore.EInt[1] position;
	ref Person[1] person;
}


