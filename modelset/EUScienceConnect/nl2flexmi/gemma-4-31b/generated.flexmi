<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ScienceConnect" nsURI="http://www.scienceconnect.org/database" nsPrefix="sc">
  <eClassifiers>
    <eClass name="ResearchDatabase">
      <eStructuralFeatures>
        <eReference name="persons" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="institutions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="articles" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="publishers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="personID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="keywords" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="worksFor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institution">
      <eStructuralFeatures>
        <eAttribute name="institutionCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="subscriptions" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScientificArticle">
      <eStructuralFeatures>
        <eAttribute name="doi" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="authors" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PeerReviewedPaper" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eAttribute name="citationCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="reviewers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="publishedIn" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TechnicalReport" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eReference name="publishedBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Publisher">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Journal">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="impactFactor" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="publishedBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ArticleAuthor">
      <eStructuralFeatures>
        <eAttribute name="position" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="person" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
