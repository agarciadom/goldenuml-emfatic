<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="researchmodel"
    nsURI="http://www.example.org/researchmodel"
    nsPrefix="researchmodel">

  <!-- Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchModel">
    <eStructuralFeatures xsi:type="ecore:EReference" name="persons"
        eType="#//Person" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchInstitutions"
        eType="#//ResearchInstitution" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="articles"
        eType="#//Article" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="publishers"
        eType="#//Publisher" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="journals"
        eType="#//Journal" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors"
        eType="#//Author" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- Person class -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="personID"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keywords"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="worksFor"
        eType="#//ResearchInstitution" lowerBound="1"
        eOpposite="#//ResearchInstitution/employees"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reviews"
        eType="#//PeerReviewedPaper" upperBound="-1"
        eOpposite="#//PeerReviewedPaper/reviewers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authoredArticles"
        eType="#//Author" upperBound="-1"
        eOpposite="#//Author/person"/>
  </eClassifiers>

  <!-- ResearchInstitution class -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchInstitution">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="institutionCode"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        eType="#//Person" upperBound="-1"
        eOpposite="#//Person/worksFor"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subscribesTo"
        eType="#//Journal" upperBound="-1"
        eOpposite="#//Journal/subscribedBy"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="publishesTechnicalReports"
        eType="#//TechnicalReport" upperBound="-1"
        eOpposite="#//TechnicalReport/publishingInstitution"/>
  </eClassifiers>

  <!-- Article class (abstract, since it has total disjoint subclasses) -->
  <eClassifiers xsi:type="ecore:EClass" name="Article" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="doi"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authorLinks"
        eType="#//Author" upperBound="-1"
        eOpposite="#//Author/article"/>
  </eClassifiers>

  <!-- Author association class (between Article and Person) -->
  <eClassifiers xsi:type="ecore:EClass" name="Author">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="position"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="article"
        eType="#//Article" lowerBound="1"
        eOpposite="#//Article/authorLinks"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person"
        eType="#//Person" lowerBound="1"
        eOpposite="#//Person/authoredArticles"/>
  </eClassifiers>

  <!-- PeerReviewedPaper class -->
  <eClassifiers xsi:type="ecore:EClass" name="PeerReviewedPaper" eSuperTypes="#//Article">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="citationCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reviewers"
        eType="#//Person" upperBound="-1"
        eOpposite="#//Person/reviews"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="journal"
        eType="#//Journal" lowerBound="1"
        eOpposite="#//Journal/peerReviewedPapers"/>
  </eClassifiers>

  <!-- TechnicalReport class -->
  <eClassifiers xsi:type="ecore:EClass" name="TechnicalReport" eSuperTypes="#//Article">
    <eStructuralFeatures xsi:type="ecore:EReference" name="publishingInstitution"
        eType="#//ResearchInstitution" lowerBound="1"
        eOpposite="#//ResearchInstitution/publishesTechnicalReports"/>
  </eClassifiers>

  <!-- Publisher class -->
  <eClassifiers xsi:type="ecore:EClass" name="Publisher">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="publishesJournals"
        eType="#//Journal" upperBound="-1"
        eOpposite="#//Journal/publisher"/>
  </eClassifiers>

  <!-- Journal class -->
  <eClassifiers xsi:type="ecore:EClass" name="Journal">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="impactFactor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="publisher"
        eType="#//Publisher" lowerBound="1"
        eOpposite="#//Publisher/publishesJournals"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subscribedBy"
        eType="#//ResearchInstitution" upperBound="-1"
        eOpposite="#//ResearchInstitution/subscribesTo"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="peerReviewedPapers"
        eType="#//PeerReviewedPaper" upperBound="-1"
        eOpposite="#//PeerReviewedPaper/journal"/>
  </eClassifiers>

</ecore:EPackage>
