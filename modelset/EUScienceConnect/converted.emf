@namespace(uri="http://www.example.org/researchmodel", prefix="researchmodel")
package researchmodel;

class ResearchModel {
	val Person[*] persons;
	val ResearchInstitution[*] researchInstitutions;
	val Article[*] articles;
	val Publisher[*] publishers;
	val Journal[*] journals;
	val Author[*] authors;
}

class Person {
	attr int personID;
	attr String phoneNumber;
	attr String keywords;
	ref ResearchInstitution[1]#employees worksFor;
	ref PeerReviewedPaper[*]#reviewers reviews;
	ref Author[*]#person authoredArticles;
}

class ResearchInstitution {
	attr int institutionCode;
	ref Person[*]#worksFor employees;
	ref Journal[*]#subscribedBy subscribesTo;
	ref TechnicalReport[*]#publishingInstitution publishesTechnicalReports;
}

abstract class Article {
	attr int doi;
	attr String title;
	ref Author[*]#article authorLinks;
}

class Author {
	attr int position;
	ref Article[1]#authorLinks article;
	ref Person[1]#authoredArticles person;
}

class PeerReviewedPaper extends Article {
	attr int citationCount;
	ref Person[*]#reviews reviewers;
	ref Journal[1]#peerReviewedPapers journal;
}

class TechnicalReport extends Article {
	ref ResearchInstitution[1]#publishesTechnicalReports publishingInstitution;
}

class Publisher {
	attr String name;
	ref Journal[*]#publisher publishesJournals;
}

class Journal {
	attr String name;
	attr double impactFactor;
	ref Publisher[1]#publishesJournals publisher;
	ref ResearchInstitution[*]#subscribesTo subscribedBy;
	ref PeerReviewedPaper[*]#journal peerReviewedPapers;
}


