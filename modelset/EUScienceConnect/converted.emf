@namespace(uri="http://www.example.org/researchModel", prefix="researchModel")
package researchModel;

class Person {
	attr int personID;
	attr String phoneNumber;
	attr String keywords;
	ref ResearchInstitution[1]#employees worksFor;
	ref Author[*]#person authorships;
	ref PeerReviewedPaper[*]#reviewers reviews;
}

class ResearchInstitution {
	attr int institutionCode;
	val Person[*]#worksFor employees;
	ref Journal[*]#subscribedBy subscribesTo;
	val TechnicalReport[*]#publishedBy publishesTechnicalReports;
}

class Article {
	attr int doi;
	attr String title;
	ref Author[*]#article authorships;
}

class Author {
	attr int position;
	ref Article[1]#authorships article;
	ref Person[1]#authorships person;
}

class PeerReviewedPaper extends Article {
	attr int citationCount;
	ref Person[*]#reviews reviewers;
	ref Journal[1]#papers publishedIn;
}

class TechnicalReport extends Article {
	ref ResearchInstitution[1]#publishesTechnicalReports publishedBy;
}

class Publisher {
	attr String name;
	val Journal[+]#publishedBy publishes;
}

class Journal {
	attr String name;
	attr double impactFactor;
	ref Publisher[1]#publishes publishedBy;
	val PeerReviewedPaper[+]#publishedIn papers;
	ref ResearchInstitution[*]#subscribesTo subscribedBy;
}


