@namespace(uri="http://www.example.org/researchModel", prefix="researchModel")
package researchModel;

class ResearchModel {
	val Person[*] persons;
	val ResearchInstitution[*] researchInstitutions;
	val Publisher[*] publishers;
}

class Person {
	attr int personID;
	attr String phoneNumber;
	attr String keywords;
	ref ResearchInstitution[1]#employees worksFor;
	ref PeerReviewedPaper[*]#reviewers reviews;
	ref Author[*]#person authorships;
}

class ResearchInstitution {
	attr int institutionCode;
	ref Person[*]#worksFor employees;
	ref Journal[*]#subscribingInstitutions subscribesTo;
	val TechnicalReport[*]#publishingInstitution publishesTechnicalReports;
}

abstract class Article {
	attr int doi;
	attr String title;
	val Author[*]#article authorships;
}

class Author {
	attr int position;
	ref Article[1]#authorships article;
	ref Person[1]#authorships person;
}

class PeerReviewedPaper extends Article {
	attr int citationCount;
	ref Person[*]#reviews reviewers;
	ref Journal[1]#peerReviewedPapers publishedIn;
}

class TechnicalReport extends Article {
	ref ResearchInstitution[1]#publishesTechnicalReports publishingInstitution;
}

class Publisher {
	attr String name;
	val Journal[*]#publisher publishes;
}

class Journal {
	attr String name;
	attr double impactFactor;
	ref Publisher[1]#publishes publisher;
	ref ResearchInstitution[*]#subscribesTo subscribingInstitutions;
	val PeerReviewedPaper[*]#publishedIn peerReviewedPapers;
}


