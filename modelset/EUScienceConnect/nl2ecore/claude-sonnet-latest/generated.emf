@namespace(uri="http://www.scienceconnect.eu/metamodel", prefix="scienceconnect")
package scienceconnect;

class ScienceConnectDatabase {
	val Person[*] persons;
	val ResearchInstitution[*] institutions;
	val ScientificArticle[*] articles;
	val Publisher[*] publishers;
	val Journal[*] journals;
	val Authorship[*] authorships;
	val Subscription[*] subscriptions;
}

class Person {
	id attr String personId;
	attr String phoneNumber;
	attr String[*] keywords;
	ref ResearchInstitution#staff worksAt;
	ref Authorship[*]#author authorships;
	ref PeerReviewedPaper#reviewer reviews;
}

class ResearchInstitution {
	id attr String institutionCode;
	attr String name;
	ref Person[*]#worksAt staff;
	ref TechnicalReport[*]#publishedBy technicalReports;
	ref Subscription[*]#institution subscriptions;
}

abstract class ScientificArticle {
	id attr String doi;
	attr String title;
	ref Authorship[*]#article authorships;
}

class Authorship {
	attr int position;
	ref Person#authorships author;
	ref ScientificArticle#authorships article;
}

class PeerReviewedPaper extends ScientificArticle {
	attr int citationCount;
	ref Person#reviews reviewer;
	ref Journal#papers publishedIn;
}

class TechnicalReport extends ScientificArticle {
	ref ResearchInstitution#technicalReports publishedBy;
}

class Publisher {
	id attr String name;
	ref Journal[*]#publisher journals;
}

class Journal {
	attr String name;
	attr double impactFactor;
	ref Publisher#journals publisher;
	ref PeerReviewedPaper[*]#publishedIn papers;
	ref Subscription[*]#journal subscriptions;
}

class Subscription {
	ref ResearchInstitution#subscriptions institution;
	ref Journal#subscriptions journal;
}


