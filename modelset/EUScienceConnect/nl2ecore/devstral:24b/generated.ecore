<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="ResearchDatabase" nsURI="researchdatabase" nsPrefix="rd" xmi:id="pkg_1">
    <!-- EDataTypes -->
    <eClassifiers xmi:type="ecore:EDataType" name="String" instanceClassName="java.lang.String" xmi:id="string"/>
    <eClassifiers xmi:type="ecore:EDataType" name="Integer" instanceClassName="java.lang.Integer" xmi:id="integer"/>

    <!-- Class: RootContainer -->
    <eClassifiers xmi:type="ecore:EClass" name="RootContainer" xmi:id="root_container_class">
      <eStructuralFeatures xmi:type="ecore:EReference" name="institutions" upperBound="-1" containment="true" eType="#//Institution"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="publishers" upperBound="-1" containment="true" eType="#//Publisher"/>
    </eClassifiers>

    <!-- Class: Person -->
    <eClassifiers xmi:type="ecore:EClass" name="Person" xmi:id="person_class">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="personId" eType="#string"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="institution" eType="#//Institution"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="articlesAsAuthor" upperBound="-1" eType="#//Article"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="articlesAsReviewer" upperBound="-1" eType="#//PeerReviewedPaper"/>
    </eClassifiers>

    <!-- Class: Institution -->
    <eClassifiers xmi:type="ecore:EClass" name="Institution" xmi:id="institution_class">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="institutionCode" eType="#string"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="staff" upperBound="-1" eType="#//Person"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="technicalReports" upperBound="-1" containment="true" eType="#//TechnicalReport"/>
    </eClassifiers>

    <!-- Class: Article -->
    <eClassifiers xmi:type="ecore:EClass" name="Article" abstract="true" xmi:id="article_class">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="doi" eType="#string"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="title" eType="#string"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="authors" upperBound="-1" containment="true" eType="#//AuthorPosition"/>
    </eClassifiers>

    <!-- Association Class: AuthorPosition -->
    <eClassifiers xmi:type="ecore:EClass" name="AuthorPosition" xmi:id="author_position_class">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="position" eType="#integer"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="person" containment="false" eType="#//Person"/>
    </eClassifiers>

    <!-- Class: PeerReviewedPaper -->
    <eClassifiers xmi:type="ecore:EClass" name="PeerReviewedPaper" xmi:id="peer_reviewed_paper_class">
      <eStructuralFeatures xmi:type="ecore:EReference" name="reviewers" upperBound="-1" eType="#//Person"/>
    </eClassifiers>

    <!-- Class: TechnicalReport -->
    <eClassifiers xmi:type="ecore:EClass" name="TechnicalReport" xmi:id="technical_report_class">
      <eStructuralFeatures xmi:type="ecore:EReference" name="institution" eType="#//Institution"/>
    </eClassifiers>

    <!-- Class: Publisher -->
    <eClassifiers xmi:type="ecore:EClass" name="Publisher" xmi:id="publisher_class">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#string"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="journals" upperBound="-1" containment="true" eType="#//Journal"/>
    </eClassifiers>

    <!-- Class: Journal -->
    <eClassifiers xmi:type="ecore:EClass" name="Journal" xmi:id="journal_class">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#string"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="publishedPapers" upperBound="-1" containment="true" eType="#//PeerReviewedPaper"/>
    </eClassifiers>
  </ecore:EPackage>
</xmi:XMI>
