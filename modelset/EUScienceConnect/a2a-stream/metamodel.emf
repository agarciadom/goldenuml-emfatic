@namespace(uri="http://scienceconnect.eu/personinstitution", prefix="p")
package PersonInstitution;

class Person {
  attr string ~id;
  attr string phoneNumber;
  attr string[*] researchTopics;
  ref Institution institution;
  ref Article[*] authoredArticles;
  ref PeerReviewedPaper[*] reviewedArticles;
}
class Institution {
  attr string code;
  attr string name;
  val Person[*] employees;
}

@namespace(uri="http://scienceconnect.eu/article", prefix="p")
package Article;

class Article {
  attr string DOI;
  attr string title;
  attr string[*] authors;
  ref Person[*] authorsRef;
}
class PeerReviewedPaper extends Article {
  attr int citationCount;
  val Person[*] reviewers;
}
class TechnicalReport extends Article {
  ref Institution publishingInstitution;
}
class Publisher {
  attr string name;
  val Journal[*] journals;
}
class Journal {
  attr string name;
  attr float impactFactor;
  val PeerReviewedPaper[*] peerReviewedPapers;
}