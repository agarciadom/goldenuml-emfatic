@namespace(uri="http://www.example.org/housePackage", prefix="housePackage")
package housePackage;

enum BMType {
	wood = 0;
	brick = 1;
	concrete = 2;
}

abstract class Basement {
	attr double Size;
	attr String Name;
}

class ConcreteBasement extends Basement {
	attr double Quality;
}

class EarthBasement extends Basement {
	attr double Humidity;
}

class House {
	attr String Address;
	attr BMType BuildingMaterial;
	val Basement basement;
	ref JobLog[*]#house jobLogs;
}

abstract class SemiDetached extends House {
	attr boolean Garden;
	attr int Windows;
}

class SemiDetachedWithCarport extends SemiDetached {
	ref Carport[2] carports;
}

class SemiDetachedWithGarage extends SemiDetached {
	ref Garage[1] garage;
}

class Company {
	attr String Name;
	attr String Address;
	ref JobLog[*]#company jobLogs;
}

class JobLog {
	attr int Hours;
	attr double Price;
	ref House[1]#jobLogs house;
	ref Company[1]#jobLogs company;
}

class Carport {
	attr boolean DoublePort;
	attr boolean flatRoof;
}

class Garage {
	attr boolean Automatic;
}


