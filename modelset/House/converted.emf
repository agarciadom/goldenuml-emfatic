@namespace(uri="http://www.example.org/housing", prefix="housing")
package housing;

class HousingModel {
	val House[*] houses;
	val Company[*] companies;
}

enum BMType {
	wood = 0;
	brick = 1;
	concrete = 2;
}

abstract class Basement {
	attr Double size;
	attr String name;
}

class ConcreteBasement extends Basement {
	attr Double quality;
}

class EarthBasement extends Basement {
	attr Double humidity;
}

class House {
	attr String address;
	attr BMType buildingMaterial;
	val Basement basement;
	val JobLog[*] jobLogs;
}

abstract class SemiDetached extends House {
	attr Boolean garden;
	attr Integer windows;
}

class SemiDetachedWithCarport extends SemiDetached {
	val Carport[2] carports;
}

class SemiDetachedWithGarage extends SemiDetached {
	val Garage[1] garage;
}

class Company {
	attr String name;
	attr String address;
	ref JobLog[*] jobLogs;
}

class JobLog {
	attr Integer hours;
	attr Double price;
	ref Company[1] company;
}

class Carport {
	attr Boolean doublePort;
	attr Boolean flatRoof;
}

class Garage {
	attr Boolean automatic;
}


