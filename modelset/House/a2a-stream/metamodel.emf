@namespace(uri="http://www.example.org/House", prefix="p")
package House;

class House {
  attr String address;
  attr Enum:wood,brick,concrete buildingMaterial;
  val Basement basement;
  ref JobLog[*] jobLogs;
}
class SemiDetachedHouse extends House {
  attr Boolean hasGarden;
  attr Integer numberOfWindows;
  val Carport[*] carports;
  val Garage garage;
}
class Carport {
  attr Boolean isDouble;
  attr Boolean hasFlatRoof;
}
class Garage {
  attr Boolean hasAutomaticDoor;
}

@namespace(uri="http://www.example.org/Basement", prefix="p")
package Basement;

class Basement {
  attr Float size;
  attr String name;
}
class EarthBasement extends Basement {
  attr Float humidityLevel;
}
class ConcreteBasement extends Basement {
}

@namespace(uri="http://www.example.org/Company", prefix="p")
package Company;

class Company {
  attr String name;
  attr String address;
}
class JobLog {
  attr Integer hoursWorked;
  attr Float agreedPrice;
  ref House house;
  ref Company company;
}