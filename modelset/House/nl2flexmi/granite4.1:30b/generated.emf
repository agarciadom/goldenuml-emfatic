@namespace(uri="http://www.example.org/HouseDomain", prefix="hdom")
package HouseDomain;

import "http://www.eclipse.org/emf/2002/Ecore";

class House {
	attr ecore.EString[1] address;
	attr ecore.EString[1] buildingMaterial;
	val Basement basement;
	ref Company[*] serviceCompanies;
}

class Basement {
}

class EarthBasement extends Basement {
	attr ecore.EInt[1] humidityLevel;
}

class ConcreteBasement extends Basement {
}

class SemiDetachedHouse extends House {
	attr ecore.EBoolean[1] hasGarden;
	attr ecore.EInt[1] windowCount;
	val Carport carports;
	val Garage garage;
}

class Carport {
	attr ecore.EBoolean[1] isDouble;
	attr ecore.EBoolean[1] hasFlatRoof;
}

class Garage {
	attr ecore.EBoolean[1] hasAutomaticDoor;
}

class Company {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	ref House[*] servicedHouses;
}

class JobLog {
	attr ecore.EInt[1] hours;
	attr ecore.EBigDecimal[1] agreedPrice;
	ref House[1] house;
	ref Company[1] company;
}


