@namespace(uri="http://www.example.org/HouseModel", prefix="house")
package HouseModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class House {
	attr ecore.EString[1] address;
	attr ecore.EString[1] material;
	val Basement basement;
	ref Company[*] servicingCompanies;
}

class Basement {
	attr ecore.EInt[1] size;
	attr ecore.EString[1] name;
}

class EarthBasement extends Basement {
	attr ecore.EFloat humidityLevel;
}

class ConcreteBasement extends Basement {
}

class SemiDetachedHouse extends House {
	attr ecore.EBoolean[1] hasOwnGarden;
	attr ecore.EInt[1] numberOfWindows;
	val Carport[0..2] carports;
	ref Garage garage;
}

class Carport {
	attr ecore.EBoolean isDouble;
	attr ecore.EBoolean hasFlatRoof;
}

class Garage {
	attr ecore.EBoolean hasAutomaticDoor;
}

class Company {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	val JobLog[*] jobLogs;
}

class JobLog {
	attr ecore.EFloat[1] hoursWorked;
	attr ecore.EDouble[1] priceAgreed;
	ref House[1] house;
	ref Company[1] company;
}


