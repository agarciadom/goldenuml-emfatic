<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HouseModel" nsURI="http://www.example.org/HouseModel" nsPrefix="hm">
  <eClassifiers>
    <eClass name="House">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="material" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="basement" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="serviceCompanies" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Basement">
      <eStructuralFeatures>
        <eAttribute name="size" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EarthBasement" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="humidityLevel" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ConcreteBasement" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SemiDetachedHouse" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="hasOwnGarden" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="numberOfWindows" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="carports" containment="True" lowerBound="0" upperBound="2" eType="//@eClassifiers.5" />
        <eReference name="garage" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Carport">
      <eStructuralFeatures>
        <eAttribute name="isDouble" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="hasFlatRoof" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Garage">
      <eStructuralFeatures>
        <eAttribute name="hasAutomaticDoor" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Company">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="JobLog">
      <eStructuralFeatures>
        <eAttribute name="hoursWorked" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="agreedPrice" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="performedAt" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="byCompany" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
