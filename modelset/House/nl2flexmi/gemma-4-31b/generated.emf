@namespace(uri="http://example.org/housemanagement", prefix="hm")
package HouseManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class House {
	attr ecore.EString[1] address;
	attr ecore.EString[1] buildingMaterial;
	val Basement basement;
	ref Company[+] companies;
	val JobLog[*] jobLogs;
}

class Basement {
	attr ecore.EDouble[1] size;
	attr ecore.EString[1] name;
}

class EarthBasement extends Basement {
	attr ecore.EDouble[1] humidityLevel;
}

class ConcreteBasement extends Basement {
}

class SemiDetachedHouse extends House {
	attr ecore.EBoolean[1] hasOwnGarden;
	attr ecore.EInt[1] numberOfWindows;
	val Carport[0..2] carports;
	val Garage garage;
}

class Carport {
	attr ecore.EBoolean[1] isDoubleCarport;
	attr ecore.EBoolean[1] hasFlatRoof;
}

class Garage {
	attr ecore.EBoolean[1] hasAutomaticDoor;
}

class Company {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class JobLog {
	attr ecore.EDouble[1] hours;
	attr ecore.EDouble[1] price;
	ref Company[1] company;
}


