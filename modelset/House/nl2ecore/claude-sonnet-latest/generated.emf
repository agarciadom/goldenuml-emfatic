@namespace(uri="http://www.example.org/housing", prefix="housing")
package housing;

enum BuildingMaterial {
	wood = 0;
	brick = 0;
	concrete = 0;
}

class HousingSystem {
	val House[*] houses;
	val Company[*] companies;
}

class House {
	attr String address;
	attr BuildingMaterial buildingMaterial;
	val Basement basement;
	val JobLog[*] jobLogs;
	ref JobLog[*]#house servicedBy;
}

class SemiDetachedHouse extends House {
	attr boolean hasOwnGarden;
	attr int numberOfWindows;
	val Parking[1] parking;
}

abstract class Basement {
	attr double size;
	attr String name;
}

class EarthBasement extends Basement {
	attr double humidityLevel;
}

class ConcreteBasement extends Basement {
}

abstract class Parking {
}

class Carport extends Parking {
	attr boolean isDoubleCarport;
	attr boolean hasFlatRoof;
}

class Garage extends Parking {
	attr boolean hasAutomaticGarageDoor;
}

class Company {
	attr String name;
	attr String address;
	ref JobLog[*]#company jobLogs;
}

class JobLog {
	attr double numberOfHours;
	attr double agreedPrice;
	ref House#servicedBy house;
	ref Company#jobLogs company;
}


