@namespace(uri="http://www.example.org/gasstation", prefix="gasstation")
package gasstation;

class GasStation {
	attr int Id;
	attr String Address;
	ref DailyPrice[*]#gasStation dailyPrices;
	val FuelPump[1..12]#gasStation fuelPumps;
}

class DailyPrice {
	attr EDate Date;
	attr double Price;
	ref GasStation[1]#dailyPrices gasStation;
	ref Fuel[1]#dailyPrices fuel;
	ref FuelPurchase[*]#dailyPrice fuelPurchases;
}

class FuelPurchase {
	attr int Id;
	attr int Liter;
	ref FuelPump[1]#fuelPurchases fuelPump;
	ref DailyPrice[1]#fuelPurchases dailyPrice;
}

class FuelPump {
	attr int PumpNumber;
	attr boolean SelfService;
	ref GasStation[1]#fuelPumps gasStation;
	ref FuelPurchase[*]#fuelPump fuelPurchases;
	ref Fuel[*]#fuelPumps fuels;
}

class Fuel {
	attr String Name;
	attr int Octane;
	ref DailyPrice[*]#fuel dailyPrices;
	ref FuelPump[*]#fuels fuelPumps;
}


