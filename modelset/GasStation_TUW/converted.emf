@namespace(uri="http://www.example.org/gasstation", prefix="gasstation")
package gasstation;

class GasStationSystem {
	val GasStation[*] gasStations;
	val Fuel[*] fuels;
}

class GasStation {
	attr int ~id;
	attr String address;
	val DailyPrice[*]#gasStation dailyPrices;
	val FuelPump[1..12]#gasStation fuelPumps;
}

class DailyPrice {
	attr EDate date;
	attr double price;
	ref GasStation#dailyPrices gasStation;
	ref Fuel[1]#dailyPrices fuel;
	ref FuelPurchase[*]#dailyPrice fuelPurchases;
}

class FuelPurchase {
	attr int ~id;
	attr int liter;
	ref FuelPump[1]#fuelPurchases fuelPump;
	ref DailyPrice[1]#fuelPurchases dailyPrice;
}

class FuelPump {
	attr int pumpNumber;
	attr boolean selfService;
	ref GasStation#fuelPumps gasStation;
	val FuelPurchase[*]#fuelPump fuelPurchases;
	ref Fuel[*]#fuelPumps fuels;
}

class Fuel {
	attr String name;
	attr int octane;
	ref DailyPrice[*]#fuel dailyPrices;
	ref FuelPump[*]#fuels fuelPumps;
}


