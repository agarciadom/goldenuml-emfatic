<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="GasStationManagement" nsURI="http://www.example.org/gasstationmanagement" nsPrefix="gs">
  <eClassifiers>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="fuel_pumps" containment="False" lowerBound="0" upperBound="12" eType="//@eClassifiers.1" />
        <eReference name="daily_prices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPump">
      <eStructuralFeatures>
        <eAttribute name="pump_number" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="is_self_service" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="offers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Fuel">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="octane_rating" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DailyPrice">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="price_per_liter" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPurchase">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="liters_dispensed" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="fuel_pump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="fuel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="daily_price" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
