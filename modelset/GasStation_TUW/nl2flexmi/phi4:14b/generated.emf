@namespace(uri="http://www.example.org/gasstationmanagement", prefix="gs")
package GasStationManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class GasStation {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] address;
	ref FuelPump[0..12] fuel_pumps;
	val DailyPrice[*] daily_prices;
}

class FuelPump {
	attr ecore.EInt pump_number;
	attr ecore.EBoolean is_self_service;
	ref Fuel[*] offers;
}

class Fuel {
	attr ecore.EString[1] name;
	attr ecore.EInt octane_rating;
}

class DailyPrice {
	attr ecore.EDate[1] date;
	attr ecore.EDouble price_per_liter;
}

class FuelPurchase {
	attr ecore.EString[1] ~id;
	attr ecore.EDouble liters_dispensed;
	ref FuelPump[1] fuel_pump;
	ref Fuel[1] fuel;
	ref DailyPrice[1] daily_price;
}


