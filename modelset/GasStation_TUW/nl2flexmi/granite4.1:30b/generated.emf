@namespace(uri="http://www.example.com/gasstationchain", prefix="gsc")
package GasStationChain;

import "http://www.eclipse.org/emf/2002/Ecore";

class Fuel {
	attr ecore.EString[1] name;
	attr ecore.EInt octaneRating;
}

class FuelPump {
	attr ecore.EString[1] pumpNumber;
	attr ecore.EBoolean isSelfService;
	ref Fuel[*] fuels;
}

class GasStation {
	attr ecore.EString[1] uniqueID;
	attr ecore.EString address;
	val FuelPump[0..12] fuelPumps;
	val DailyPrice[*] dailyPrices;
}

class DailyPrice {
	attr ecore.EDate[1] date;
	ref Fuel[1] fuel;
	ref GasStation[1] gasStation;
	attr ecore.EDouble pricePerLiter;
}

class FuelPurchase {
	attr ecore.EString[1] purchaseID;
	ref FuelPump[1] fuelPump;
	ref Fuel[1] fuel;
	ref DailyPrice[1] dailyPrice;
	attr ecore.EDouble litersDispensed;
}


