<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="GasStationChain" nsURI="http://www.example.com/gasstationchain" nsPrefix="gsc">
  <eClassifiers>
    <eClass name="Fuel">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="octaneRating" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPump">
      <eStructuralFeatures>
        <eAttribute name="pumpNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isSelfService" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="fuels" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="uniqueID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="fuelPumps" containment="True" lowerBound="0" upperBound="12" eType="//@eClassifiers.1" />
        <eReference name="dailyPrices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DailyPrice">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="fuel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="gasStation" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="pricePerLiter" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPurchase">
      <eStructuralFeatures>
        <eAttribute name="purchaseID" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="fuelPump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="fuel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="dailyPrice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eAttribute name="litersDispensed" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
