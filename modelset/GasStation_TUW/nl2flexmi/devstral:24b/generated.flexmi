<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="GasStationChainModel" nsURI="http://www.example.org/GasStationChainModel" nsPrefix="gsm">
  <eClassifiers>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="fuelPumps" containment="True" lowerBound="0" upperBound="12" eType="//@eClassifiers.1" />
        <eReference name="archives" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPump">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="selfService" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="offers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Fuel">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="octaneRating" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DailyPrice">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pricePerLiter" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="fuel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPurchase">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="litersDispensed" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="dailyPrice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="fuelPump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
