@namespace(uri="http://www.example.org/gasstationchain", prefix="gsc")
package GasStationChain;

import "http://www.eclipse.org/emf/2002/Ecore";

class GasStation {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] address;
	val FuelPump[0..12] fuelPumps;
}

class FuelPump {
	attr ecore.EInt[1] number;
	attr ecore.EBoolean[1] isSelfService;
	val Fuel[*] fuelsOffered;
}

class Fuel {
	attr ecore.EString[1] name;
	attr ecore.EDouble octaneRating;
}

class DailyPrice {
	attr ecore.EDate[1] date;
	attr ecore.EBigDecimal[1] pricePerLiter;
	ref Fuel[1] fuel;
	ref GasStation[1] gasStation;
}

class FuelPurchase {
	attr ecore.EString[1] ~id;
	attr ecore.EDouble litersDispensed;
	ref FuelPump[1] fuelPump;
	ref DailyPrice[1] dailyPrice;
}


