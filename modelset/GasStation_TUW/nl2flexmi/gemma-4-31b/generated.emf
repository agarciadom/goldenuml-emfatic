@namespace(uri="http://www.gasstation.com/management", prefix="gsm")
package GasStationManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class GasStationChain {
	val GasStation[*] gasStations;
	val Fuel[*] fuels;
}

class GasStation {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] address;
	val FuelPump[0..12] fuelPumps;
	val DailyPrice[*] dailyPrices;
	val FuelPurchase[*] fuelPurchases;
}

class FuelPump {
	attr ecore.EInt[1] pumpNumber;
	attr ecore.EBoolean[1] isSelfService;
	ref Fuel[+] offeredFuels;
}

class Fuel {
	attr ecore.EString[1] name;
	attr ecore.EDouble[1] octaneRating;
}

class DailyPrice {
	attr ecore.EDate[1] date;
	attr ecore.EDouble[1] pricePerLiter;
	ref Fuel[1] fuel;
	ref GasStation[1] gasStation;
}

class FuelPurchase {
	attr ecore.EString[1] purchaseID;
	attr ecore.EDouble[1] litersDispensed;
	ref FuelPump[1] fuelPump;
	ref DailyPrice[1] dailyPrice;
}


