<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="GasStationManagement" nsURI="http://www.gasstation.com/management" nsPrefix="gsm">
  <eClassifiers>
    <eClass name="GasStationChain">
      <eStructuralFeatures>
        <eReference name="gasStations" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="fuels" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="fuelPumps" containment="True" lowerBound="0" upperBound="12" eType="//@eClassifiers.2" />
        <eReference name="dailyPrices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="fuelPurchases" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPump">
      <eStructuralFeatures>
        <eAttribute name="pumpNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isSelfService" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="offeredFuels" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Fuel">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="octaneRating" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DailyPrice">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pricePerLiter" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="fuel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="gasStation" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelPurchase">
      <eStructuralFeatures>
        <eAttribute name="purchaseID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="litersDispensed" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="fuelPump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="dailyPrice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
