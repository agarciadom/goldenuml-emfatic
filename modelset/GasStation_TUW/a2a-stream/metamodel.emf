@namespace(uri="http://gasstation/1.0", prefix="p")
package GasStationPackage;

class GasStation {
  attr EString ~id;
  attr EString address;
  val FuelPump[*] fuelPumps;
  val DailyPrice[*] dailyPrices;
}
class FuelPump {
  attr EInt number;
  attr EBoolean isSelfService;
  ref Fuel[*] fuels;
}
class Fuel {
  attr EString ~name;
  attr EFloat octaneRating;
}
class DailyPrice {
  attr EDate date;
  attr EFloat pricePerLiter;
  ref Fuel fuel;
}
class FuelPurchase {
  attr EString ~id;
  attr EFloat litersDispensed;
  ref FuelPump fuelPump;
  ref DailyPrice dailyPrice;
}