@namespace(uri="http://www.example.org/gasstation", prefix="gasstation")
package gasstation;

class GasStationChain {
	val GasStation[*] gasStations;
	val Fuel[*] fuels;
	val FuelPurchase[*] fuelPurchases;
}

class GasStation {
	attr String ~id;
	attr String address;
	val FuelPump[0..12] fuelPumps;
	val DailyPrice[*] dailyPrices;
}

class FuelPump {
	attr int number;
	attr boolean selfService;
	ref Fuel[*] offeredFuels;
}

class Fuel {
	attr String name;
	attr int octaneRating;
}

class DailyPrice {
	attr EDate date;
	attr double pricePerLiter;
	ref Fuel fuel;
}

class FuelPurchase {
	attr String ~id;
	attr double litersDispensed;
	ref FuelPump fuelPump;
	ref DailyPrice dailyPrice;
}


