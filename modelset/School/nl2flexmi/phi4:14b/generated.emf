@namespace(uri="http://example.com/schoolmodel", prefix="sm")
package SchoolModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
}

class Teacher extends Person {
	attr ecore.EString[1] email;
	ref School[0..3] schoolsTaught;
}

class Student extends Person {
	val School[1] school;
}

class School {
	ref Teacher[1..1000] teachers;
	ref Student[1..1000] students;
	ref Teacher[1] principal;
	ref ClassGroup[0..1000] classGroups;
}

class Principal extends Teacher {
}

class Room {
	attr ecore.EString[1] name;
}

class Classroom extends Room {
	attr ecore.EInt[1] capacity;
}

class Gym extends Room {
	attr ecore.EInt[1] sizeInSquareMeters;
}

class ClassGroup {
	ref Student[10..31] students;
	ref Classroom[1] classroom;
}


