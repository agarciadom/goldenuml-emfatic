<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SchoolModel" nsURI="http://example.com/schoolmodel" nsPrefix="sm">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Teacher" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="schoolsTaught" containment="False" lowerBound="0" upperBound="3" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="school" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="School">
      <eStructuralFeatures>
        <eReference name="teachers" containment="False" lowerBound="1" upperBound="1000" eType="//@eClassifiers.1" />
        <eReference name="students" containment="False" lowerBound="1" upperBound="1000" eType="//@eClassifiers.2" />
        <eReference name="principal" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="classGroups" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Principal" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Classroom" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Gym" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="sizeInSquareMeters" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClassGroup">
      <eStructuralFeatures>
        <eReference name="students" containment="False" lowerBound="10" upperBound="31" eType="//@eClassifiers.2" />
        <eReference name="classroom" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
