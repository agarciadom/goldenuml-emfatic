@namespace(uri="http://example.org/schoolsystem", prefix="ss")
package SchoolSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class School {
	attr ecore.EString[1] name;
	ref Teacher[1] principal;
	val Room[*] rooms;
}

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
}

class Teacher extends Person {
	attr ecore.EString email;
	val TeachingAssignment[0..3] assignments;
	ref School principalOf;
}

class Student extends Person {
	ref School[1] school;
	ref ClassGroup[1] classGroup;
}

class TeachingAssignment {
	attr ecore.EInt[1] hours;
	ref Teacher[1] teacher;
	ref School[1] school;
}

class Room {
	attr ecore.EString[1] name;
}

class Classroom extends Room {
	attr ecore.EInt[1] capacity;
	ref ClassGroup[1] classGroup;
}

class Gym extends Room {
	attr ecore.EDouble[1] sizeSqMeters;
}

class ClassGroup {
	attr ecore.EString[1] name;
	ref Student[10..31] students;
	ref Classroom[1] classroom;
}


