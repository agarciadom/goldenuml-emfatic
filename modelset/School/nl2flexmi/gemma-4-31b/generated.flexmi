<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SchoolSystem" nsURI="http://example.org/schoolsystem" nsPrefix="ss">
  <eClassifiers>
    <eClass name="School">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="principal" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Teacher" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="assignments" containment="True" lowerBound="0" upperBound="3" eType="//@eClassifiers.4" />
        <eReference name="principalOf" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="school" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="classGroup" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TeachingAssignment">
      <eStructuralFeatures>
        <eAttribute name="hours" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="teacher" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="school" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Classroom" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="classGroup" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Gym" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="sizeSqMeters" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClassGroup">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="students" containment="False" lowerBound="10" upperBound="31" eType="//@eClassifiers.3" />
        <eReference name="classroom" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
