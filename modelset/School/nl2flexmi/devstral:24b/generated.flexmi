<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SchoolSystem" nsURI="http://www.example.org/schoolsystem" nsPrefix="ss">
  <eClassifiers>
    <eClass name="School">
      <eStructuralFeatures>
        <eReference name="students" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="principal" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Teacher">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="schoolsTaughtAt" containment="False" lowerBound="0" upperBound="3" eType="//@eClassifiers.0" />
        <eAttribute name="hours" lowerBound="0" upperBound="-1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="school" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="classGroup" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Classroom" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Gym" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eAttribute name="size" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClassGroup">
      <eStructuralFeatures>
        <eReference name="classroom" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
