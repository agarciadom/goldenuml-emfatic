<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SchoolSystem" nsURI="http://www.example.org/SchoolSystem" nsPrefix="school">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Teacher" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="schools" containment="False" lowerBound="0" upperBound="3" eType="//@eClassifiers.3" />
        <eAttribute name="teachingHours" lowerBound="0" upperBound="3" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="school" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="School">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="principal" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="teachers" containment="False" lowerBound="0" upperBound="3" eType="//@eClassifiers.1" />
        <eReference name="students" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Classroom" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Gym" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="sizeInSquareMeters" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClassGroup">
      <eStructuralFeatures>
        <eReference name="students" containment="False" lowerBound="10" upperBound="31" eType="//@eClassifiers.2" />
        <eReference name="classroom" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
