@namespace(uri="http://www.example.org/schoolsystem", prefix="ss")
package SchoolSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class School {
	val Student[*] students;
	ref Teacher[1] principal;
	attr ecore.EString[1] name;
}

class Teacher {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] email;
	ref School[0..3] schoolsTaughtAt;
	attr ecore.EInt[*] hours;
}

class Student {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	ref School[1] school;
	ref ClassGroup[1] classGroup;
}

class Room extends School {
}

class Classroom extends Room {
	attr ecore.EInt[1] capacity;
}

class Gym extends Room {
	attr ecore.EDouble[1] size;
}

class ClassGroup {
	ref Classroom[1] classroom;
	attr ecore.EString[1] name;
}


