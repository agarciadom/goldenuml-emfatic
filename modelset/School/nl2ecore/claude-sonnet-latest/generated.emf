@namespace(uri="http://www.example.org/school", prefix="school")
package school;

class SchoolSystem {
	val School[*] schools;
	val Person[*] people;
}

abstract class Person {
	attr String firstName;
	attr String lastName;
}

class Teacher extends Person {
	attr String email;
	ref TeachingRelationship[0..3]#teacher teachingRelationships;
}

class Student extends Person {
	ref School#students school;
	ref ClassGroup#students classGroup;
}

class School {
	attr String name;
	ref Teacher principal;
	ref Student[*]#school students;
	val TeachingRelationship[*]#school teachingRelationships;
	val Room[*] rooms;
	val ClassGroup[*] classGroups;
}

class TeachingRelationship {
	attr int hoursPerWeek;
	ref Teacher#teachingRelationships teacher;
	ref School#teachingRelationships school;
}

abstract class Room {
	attr String name;
}

class Classroom extends Room {
	attr int capacity;
	ref ClassGroup#classroom classGroup;
}

class OtherRoom extends Room {
	attr double sizeInSquareMeters;
}

class ClassGroup {
	attr String name;
	ref Student[10..31]#classGroup students;
	ref Classroom[1]#classGroup classroom;
}


