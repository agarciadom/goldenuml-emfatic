<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="school"
    nsURI="http://www.example.org/school"
    nsPrefix="school">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="SchoolSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="schools"
        eType="#//School" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="people"
        eType="#//Person" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- Abstract Person superclass -->
  <eClassifiers xsi:type="ecore:EClass" name="Person" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Teacher -->
  <eClassifiers xsi:type="ecore:EClass" name="Teacher" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Non-containment reference to TeachingRelationship (the association class) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="teachingRelationships"
        eType="#//TeachingRelationship" upperBound="3"
        eOpposite="#//TeachingRelationship/teacher"/>
  </eClassifiers>

  <!-- Student -->
  <eClassifiers xsi:type="ecore:EClass" name="Student" eSuperTypes="#//Person">
    <eStructuralFeatures xsi:type="ecore:EReference" name="school"
        eType="#//School" eOpposite="#//School/students"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classGroup"
        eType="#//ClassGroup" eOpposite="#//ClassGroup/students"/>
  </eClassifiers>

  <!-- School -->
  <eClassifiers xsi:type="ecore:EClass" name="School">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="principal"
        eType="#//Teacher"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="students"
        eType="#//Student" upperBound="-1"
        eOpposite="#//Student/school"/>
    <!-- Containment reference to TeachingRelationship (the association class) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="teachingRelationships"
        eType="#//TeachingRelationship" upperBound="-1" containment="true"
        eOpposite="#//TeachingRelationship/school"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms"
        eType="#//Room" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classGroups"
        eType="#//ClassGroup" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- Association class: TeachingRelationship (Teacher <-> School) -->
  <eClassifiers xsi:type="ecore:EClass" name="TeachingRelationship">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hoursPerWeek"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="teacher"
        eType="#//Teacher" eOpposite="#//Teacher/teachingRelationships"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="school"
        eType="#//School" eOpposite="#//School/teachingRelationships"/>
  </eClassifiers>

  <!-- Abstract Room superclass -->
  <eClassifiers xsi:type="ecore:EClass" name="Room" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Classroom -->
  <eClassifiers xsi:type="ecore:EClass" name="Classroom" eSuperTypes="#//Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="capacity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classGroup"
        eType="#//ClassGroup" eOpposite="#//ClassGroup/classroom"/>
  </eClassifiers>

  <!-- OtherRoom (e.g., gym) -->
  <eClassifiers xsi:type="ecore:EClass" name="OtherRoom" eSuperTypes="#//Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sizeInSquareMeters"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- ClassGroup -->
  <eClassifiers xsi:type="ecore:EClass" name="ClassGroup">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- lowerBound=10, upperBound=31 for students -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="students"
        eType="#//Student" lowerBound="10" upperBound="31"
        eOpposite="#//Student/classGroup"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="classroom"
        eType="#//Classroom" lowerBound="1" upperBound="1"
        eOpposite="#//Classroom/classGroup"/>
  </eClassifiers>

</ecore:EPackage>
