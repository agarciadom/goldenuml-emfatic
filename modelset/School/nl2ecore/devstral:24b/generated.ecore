<?xml version="1.0" encoding="UTF-8"?>
<xmi:xmi xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="school" nsURI="http://www.example.org/school" nsPrefix="school">
    <!-- Datatypes -->
    <ecore:EDataType name="DurationHours" instanceClassName="java.time.Duration"/>

    <!-- Classes -->
    <ecore:EClass name="SchoolSystem">
      <eStructuralFeatures>
        <ecore:EReference name="schools" upperBound="-1" eType="#//School"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="Person">
      <eStructuralFeatures>
        <ecore:EAttribute name="firstName" eType="ecore:EString"/>
        <ecore:EAttribute name="lastName" eType="ecore:EString"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="Teacher" eSuperTypes="#//Person">
      <eStructuralFeatures>
        <ecore:EAttribute name="email" eType="ecore:EString"/>
        <ecore:EReference name="teachingRelationships" upperBound="-1" eType="#//TeachingRelationship" containment="true"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="Student" eSuperTypes="#//Person">
      <eStructuralFeatures>
        <ecore:EReference name="school" eType="#//School"/>
        <ecore:EReference name="classGroup" eType="#//ClassGroup"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="Room">
      <eStructuralFeatures>
        <ecore:EAttribute name="name" eType="ecore:EString"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="Classroom" eSuperTypes="#//Room">
      <eStructuralFeatures>
        <ecore:EAttribute name="capacity" eType="ecore:EInt"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="OtherRoom" eSuperTypes="#//Room">
      <eStructuralFeatures>
        <ecore:EAttribute name="sizeInSquareMeters" eType="ecore:EDouble"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="School">
      <eStructuralFeatures>
        <ecore:EAttribute name="name" eType="ecore:EString"/>
        <ecore:EReference name="students" upperBound="-1" eType="#//Student"/>
        <ecore:EReference name="teachers" upperBound="-1" eType="#//Teacher"/>
        <ecore:EReference name="principal" eType="#//Teacher"/>
        <ecore:EReference name="rooms" upperBound="-1" eType="#//Room" containment="true"/>
        <ecore:EReference name="classGroups" upperBound="-1" eType="#//ClassGroup" containment="true"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass name="ClassGroup">
      <eStructuralFeatures>
        <ecore:EAttribute name="name" eType="ecore:EString"/>
        <ecore:EReference name="students" upperBound="-1" eType="#//Student"/>
        <ecore:EReference name="classroom" eType="#//Classroom"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <!-- Association Classes -->
    <ecore:EClass name="TeachingRelationship">
      <eStructuralFeatures>
        <ecore:EAttribute name="hours" eType="#//DurationHours"/>
        <ecore:EReference name="teacher" eType="#//Teacher"/>
        <ecore:EReference name="school" eType="#//School"/>
      </eStructuralFeatures>
    </ecore:EClass>

  </ecore:EPackage>
</xmi:xmi>
