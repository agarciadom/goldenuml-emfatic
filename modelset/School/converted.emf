@namespace(uri="http://www.example.org/school", prefix="school")
package school;

abstract class Person {
	attr String FirstName;
	attr String LastName;
}

class Teacher extends Person {
	attr String Email;
	ref TeacherAssignment[*]#teacher teacherAssignments;
	ref School#principal principalOf;
}

class Student extends Person {
	ref ClassGroup[1]#students classGroup;
}

class TeacherAssignment {
	attr int Hours;
	ref Teacher[1]#teacherAssignments teacher;
	ref School[1]#teacherAssignments school;
}

class School {
	attr String Name;
	ref TeacherAssignment[*]#school teacherAssignments;
	ref Teacher#principalOf principal;
	val Room[+]#school rooms;
}

abstract class Room {
	attr String Name;
	ref School[1]#rooms school;
}

class ClassRoom extends Room {
	attr int Capacity;
	ref ClassGroup#classRoom classGroup;
}

class OtherRoom extends Room {
	attr double Size;
}

class ClassGroup {
	attr String Name;
	ref Student[10..31]#classGroup students;
	ref ClassRoom[1]#classGroup classRoom;
}


