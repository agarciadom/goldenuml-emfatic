@namespace(uri="http://www.example.org/schoolMetamodel", prefix="schoolMetamodel")
package schoolMetamodel;

abstract class Person {
	attr String firstName;
	attr String lastName;
}

class Teacher extends Person {
	attr String email;
	val TeacherAssignment[*] teacherAssignments;
	ref School#principal principalOf;
}

class Student extends Person {
	ref ClassGroup#students classGroup;
}

class TeacherAssignment {
	attr int hours;
	ref School[1]#teacherAssignments school;
}

class School {
	attr String name;
	val Room[+] rooms;
	ref Teacher#principalOf principal;
	ref TeacherAssignment[*]#school teacherAssignments;
}

abstract class Room {
	attr String name;
}

class ClassRoom extends Room {
	attr int capacity;
}

class OtherRoom extends Room {
	attr double size;
}

class ClassGroup {
	attr String name;
	ref ClassRoom[1] classRoom;
	ref Student[10..31]#classGroup students;
}

class SchoolSystem {
	val School[*] schools;
	val Teacher[*] teachers;
	val Student[*] students;
	val ClassGroup[*] classGroups;
}


