@namespace(uri="http://www.example.org/destroyblock", prefix="destroyblock")
package destroyblock;

class DestroyBlockApp {
	val User[*] users;
	val Game[*] games;
	val PlayerGameRole[*] playerGameRoles;
}

class User {
	attr String username;
	attr String password;
	val Player playerProfile;
	val Admin adminProfile;
}

class Player {
	val GameSession[*] gameSessions;
	ref GameSession activeSession;
}

class Admin {
	op Game createGame(String name);
	op void publishGame(Game game);
	ref Game[*]#admin administeredGames;
}

class Game {
	attr String name;
	attr boolean published;
	attr double minSpeed;
	attr double speedIncreaseFactor;
	attr double paddleMaxLength;
	attr double paddleMinLength;
	attr int initialBlockCount;
	ref Admin#administeredGames admin;
	val BlockDefinition[*] blockDefinitions;
	val Level[*] levels;
	val HallOfFame hallOfFame;
}

class BlockDefinition {
	attr String color;
	attr int points;
}

class Level {
	attr int levelNumber;
	attr boolean random;
	val BlockPlacement[*] blockPlacements;
}

class BlockPlacement {
	attr int gridX;
	attr int gridY;
	ref BlockDefinition blockDefinition;
}

class HallOfFame {
	val HallOfFameEntry[*] entries;
}

class HallOfFameEntry {
	ref Player player;
	attr int totalScore;
	attr EDate timestamp;
}

class GameSession {
	op void pauseGame();
	op void resumeGame();
	op void confirmNextLevel();
	ref Game game;
	attr int totalScore;
	attr int livesRemaining;
	attr GameSessionStatus status;
	val LevelSession[*] levelSessions;
	ref LevelSession currentLevelSession;
}

enum GameSessionStatus {
	ACTIVE = 0;
	PAUSED = 1;
	FINISHED = 2;
}

class LevelSession {
	ref Level level;
	attr int levelScore;
	attr double ballSpeed;
	attr double ballDirection;
	attr double paddleLength;
	ref BlockPlacement[*] remainingBlocks;
	attr boolean completed;
}

class PlayerGameRole {
	ref Player player;
	ref Game game;
}


