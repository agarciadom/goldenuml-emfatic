<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="destroyblock"
    nsURI="http://www.example.org/destroyblock"
    nsPrefix="destroyblock">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="DestroyBlockApp">
    <eStructuralFeatures xsi:type="ecore:EReference" name="users"
        eType="#//User" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="games"
        eType="#//Game" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="playerGameRoles"
        eType="#//PlayerGameRole" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- User: has a username and password; always a player, optionally an admin -->
  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="password"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- A user always has a Player role -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="playerProfile"
        eType="#//Player" containment="true"/>
    <!-- A user optionally has an Admin role -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="adminProfile"
        eType="#//Admin" containment="true"/>
  </eClassifiers>

  <!-- Player role -->
  <eClassifiers xsi:type="ecore:EClass" name="Player">
    <!-- A player may have multiple game sessions (playing same/different games) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameSessions"
        eType="#//GameSession" containment="true" upperBound="-1"/>
    <!-- The currently active (non-parallel) session, if any -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="activeSession"
        eType="#//GameSession"/>
  </eClassifiers>

  <!-- Admin role -->
  <eClassifiers xsi:type="ecore:EClass" name="Admin">
    <!-- An admin may administer multiple games -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="administeredGames"
        eType="#//Game" upperBound="-1" eOpposite="#//Game/admin"/>
    <eOperations name="createGame" eType="#//Game">
      <eParameters name="name"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="publishGame">
      <eParameters name="game" eType="#//Game"/>
    </eOperations>
  </eClassifiers>

  <!-- Game -->
  <eClassifiers xsi:type="ecore:EClass" name="Game">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="published"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Ball and paddle parameters -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minSpeed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="speedIncreaseFactor"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paddleMaxLength"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paddleMinLength"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Number of blocks shown at the beginning of each level -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="initialBlockCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- The admin who owns this game (only one admin per game) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="admin"
        eType="#//Admin" eOpposite="#//Admin/administeredGames"/>
    <!-- Block types defined by the admin for this game -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blockDefinitions"
        eType="#//BlockDefinition" containment="true" upperBound="-1"/>
    <!-- Levels of this game -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="levels"
        eType="#//Level" containment="true" upperBound="-1"/>
    <!-- Hall of fame for this game -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="hallOfFame"
        eType="#//HallOfFame" containment="true"/>
  </eClassifiers>

  <!-- BlockDefinition: a block type defined by the admin -->
  <eClassifiers xsi:type="ecore:EClass" name="BlockDefinition">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="color"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Points between 1 and 1000 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="points"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Level -->
  <eClassifiers xsi:type="ecore:EClass" name="Level">
    <!-- Level number starting at 1, max 99 -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="levelNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- If true, blocks at the top are randomly selected -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="random"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- The arranged block placements for non-random levels -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blockPlacements"
        eType="#//BlockPlacement" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- BlockPlacement: a block placed at a specific grid cell in a level -->
  <eClassifiers xsi:type="ecore:EClass" name="BlockPlacement">
    <!-- Grid position x (column), starting at 1 from the left -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gridX"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Grid position y (row), starting at 1 from the top -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gridY"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Which block definition is placed here -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blockDefinition"
        eType="#//BlockDefinition"/>
  </eClassifiers>

  <!-- HallOfFame: per-game ranking of players by score -->
  <eClassifiers xsi:type="ecore:EClass" name="HallOfFame">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries"
        eType="#//HallOfFameEntry" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- HallOfFameEntry: one entry (player + total score) in the hall of fame -->
  <eClassifiers xsi:type="ecore:EClass" name="HallOfFameEntry">
    <eStructuralFeatures xsi:type="ecore:EReference" name="player"
        eType="#//Player"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalScore"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>

  <!-- GameSession: a single play-through of a game by a player -->
  <eClassifiers xsi:type="ecore:EClass" name="GameSession">
    <eStructuralFeatures xsi:type="ecore:EReference" name="game"
        eType="#//Game"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalScore"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Player starts with 3 lives -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="livesRemaining"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//GameSessionStatus"/>
    <!-- Level sessions for each level played in this game session -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="levelSessions"
        eType="#//LevelSession" containment="true" upperBound="-1"/>
    <!-- Currently active level session -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="currentLevelSession"
        eType="#//LevelSession"/>
    <eOperations name="pauseGame"/>
    <eOperations name="resumeGame"/>
    <eOperations name="confirmNextLevel"/>
  </eClassifiers>

  <!-- Enum for game session status -->
  <eClassifiers xsi:type="ecore:EEnum" name="GameSessionStatus">
    <eLiterals name="ACTIVE"/>
    <eLiterals name="PAUSED" value="1"/>
    <eLiterals name="FINISHED" value="2"/>
  </eClassifiers>

  <!-- LevelSession: state of a player playing a specific level in a session -->
  <eClassifiers xsi:type="ecore:EClass" name="LevelSession">
    <eStructuralFeatures xsi:type="ecore:EReference" name="level"
        eType="#//Level"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="levelScore"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Current ball speed for this level -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ballSpeed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Current ball direction in degrees -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ballDirection"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Current paddle length for this level -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paddleLength"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Remaining blocks still in play -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="remainingBlocks"
        eType="#//BlockPlacement" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="completed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- PlayerGameRole: records which players are associated with which game,
       ensuring a user cannot be both player and admin for the same game -->
  <eClassifiers xsi:type="ecore:EClass" name="PlayerGameRole">
    <eStructuralFeatures xsi:type="ecore:EReference" name="player"
        eType="#//Player"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="game"
        eType="#//Game"/>
  </eClassifiers>

</ecore:EPackage>
