<?xml version="1.0" encoding="UTF-8"?>
<model xmlns:xmi="http://schema.omg.org/spec/XMI/2.0" xmlns:e="DestroyBlockModel"
       xmi:version="2.0">
  <eClassifiers>
    <!-- Root container class -->
    <e:DestroyBlockModel name="DestroyBlockModel">
      <eStructuralFeatures>
        <eReference name="games" eType="#//Game" lowerBound="0" upperBound="-1"
                     containment="true"/>
      </eStructuralFeatures>
    </e:DestroyBlockModel>

    <!-- User/Player/Admin class -->
    <e:User name="User">
      <eStructuralFeatures>
        <eAttribute name="username" type="String" unique="true"
                     lowerBound="1" upperBound="1"/>
        <eAttribute name="password" type="String" lowerBound="1" upperBound="1"/>
        <eReference name="gamesAsAdmin" eType="#//Game" lowerBound="0"
                     upperBound="-1" containment="false"/>
        <eReference name="gamesPlayed" eType="#//Game" lowerBound="0"
                     upperBound="-1" containment="false"/>
        <eAttribute name="isAdminForGame" type="Boolean" default="false"/>
      </eStructuralFeatures>
    </e:User>

    <!-- Game class -->
    <e:Game name="Game">
      <eStructuralFeatures>
        <eAttribute name="name" type="String" unique="true"
                     lowerBound="1" upperBound="1"/>
        <eReference name="hallOfFame" eType="#//HallOfFame" containment="true"/>
        <eReference name="admin" eType="#//User" lowerBound="1" upperBound="1"
                     containment="false"/>
        <eReference name="levels" eType="#//Level" lowerBound="0" upperBound="-1"
                     containment="true"/>
        <eAttribute name="isPublished" type="Boolean" default="false"/>
      </eStructuralFeatures>
    </e:Game>

    <!-- Hall of Fame class -->
    <e:HallOfFame name="HallOfFame">
      <eStructuralFeatures>
        <eReference name="entries" eType="#//ScoreEntry"
                     lowerBound="0" upperBound="-1" containment="true"/>
      </eStructuralFeatures>
    </e:HallOfFame>

    <!-- Score entry class -->
    <e:ScoreEntry name="ScoreEntry">
      <eStructuralFeatures>
        <eAttribute name="playerUsername" type="String"
                     lowerBound="1" upperBound="1"/>
        <eAttribute name="score" type="int" lowerBound="0" upperBound="1"/>
      </eStructuralFeatures>
    </e:ScoreEntry>

    <!-- Level class -->
    <e:Level name="Level">
      <eStructuralFeatures>
        <eAttribute name="levelNumber" type="int"
                     lowerBound="1" upperBound="1"/>
        <eReference name="blocks" eType="#//BlockPlacement"
                     lowerBound="0" upperBound="-1" containment="true"/>
        <eAttribute name="isRandom" type="Boolean" default="false"/>
      </eStructuralFeatures>
    </e:Level>

    <!-- Block class -->
    <e:Block name="Block">
      <eStructuralFeatures>
        <eAttribute name="color" type="String"
                     lowerBound="1" upperBound="1"/>
        <eAttribute name="points" type="int"
                     lowerBound="1" upperBound="1"/>
      </eStructuralFeatures>
    </e:Block>

    <!-- Block placement association class -->
    <e:BlockPlacement name="BlockPlacement">
      <eStructuralFeatures>
        <eReference name="block" eType="#//Block"
                     lowerBound="1" upperBound="1" containment="false"/>
        <eAttribute name="gridPositionX" type="int"
                     lowerBound="1" upperBound="1"/>
        <eAttribute name="gridPositionY" type="int"
                     lowerBound="1" upperBound="1"/>
        <eReference name="level" eType="#//Level"
                     lowerBound="1" upperBound="1" containment="false"/>
      </eStructuralFeatures>
    </e:BlockPlacement>

    <!-- Game configuration class -->
    <e:GameConfiguration name="GameConfiguration">
      <eStructuralFeatures>
        <eAttribute name="minSpeed" type="double"
                     lowerBound="0" upperBound="1"/>
        <eAttribute name="speedIncreaseFactor" type="double"
                     lowerBound="0" upperBound="1"/>
        <eAttribute name="maxPaddleLength" type="int"
                     lowerBound="1" upperBound="1"/>
        <eAttribute name="minPaddleLength" type="int"
                     lowerBound="1" upperBound="1"/>
      </eStructuralFeatures>
    </e:GameConfiguration>

    <!-- Game play state class -->
    <e:GamePlayState name="GamePlayState">
      <eStructuralFeatures>
        <eReference name="game" eType="#//Game"
                     lowerBound="1" upperBound="1" containment="false"/>
        <eAttribute name="currentLevelNumber" type="int"
                     lowerBound="0" upperBound="1"/>
        <eAttribute name="remainingLives" type="int"
                     lowerBound="0" upperBound="1"/>
        <eAttribute name="totalScore" type="int"
                     lowerBound="0" upperBound="1"/>
        <eAttribute name="isPaused" type="Boolean" default="false"/>
      </eStructuralFeatures>
      <eOperations>
        <e:Operation name="resume">
          <eParameters>
            <e:Parameter name="player" eType="#//User"/>
          </eParameters>
        </e:Operation>
        <e:Operation name="endGame">
          <eParameters>
            <e:Parameter name="reason" eType="String"/>
          </eParameters>
        </e:Operation>
      </eOperations>
    </e:GamePlayState>
  </eClassifiers>
</model>
