<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="DestroyBlock" nsURI="http://www.example.com/destroyblock" nsPrefix="db">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="score" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Admin" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="adminGames" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Game">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="minSpeed" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="speedIncreaseFactor" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="maxPaddleLength" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="minPaddleLength" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="blocks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="levels" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="admin" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="hallOfFame" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Block">
      <eStructuralFeatures>
        <eAttribute name="color" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="points" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Level">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isRandom" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="blocks" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HallOfFame">
      <eStructuralFeatures>
        <eAttribute name="highScores" lowerBound="0" upperBound="-1" eType="//EInt" />
        <eReference name="players" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PausedGame">
      <eStructuralFeatures>
        <eReference name="player" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="game" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
