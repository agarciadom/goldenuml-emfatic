<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="DestroyBlock" nsURI="http://destroyblock/example" nsPrefix="db">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Admin" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="game" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="games" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eAttribute name="lives" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Game">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="hallOfFame" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eAttribute name="minSpeed" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="speedIncreaseFactor" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="maxPaddleLength" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="minPaddleLength" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="blocks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Block">
      <eStructuralFeatures>
        <eAttribute name="color" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="points" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Level">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isRandom" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="startingBlocks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eAttribute name="numBlocksShown" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
