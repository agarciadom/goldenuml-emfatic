@namespace(uri="http://www.example.com/destroyblock", prefix="db")
package DestroyBlock;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}

class Player extends User {
	attr ecore.EInt score;
}

class Admin extends User {
	val Game[*] adminGames;
}

class Game {
	attr ecore.EString[1] name;
	attr ecore.EDouble minSpeed;
	attr ecore.EDouble speedIncreaseFactor;
	attr ecore.EInt maxPaddleLength;
	attr ecore.EInt minPaddleLength;
	val Block[*] blocks;
	val Level[*] levels;
	ref Admin admin;
	val HallOfFame hallOfFame;
}

class Block {
	attr ecore.EString[1] color;
	attr ecore.EInt[1] points;
}

class Level {
	attr ecore.EInt[1] number;
	attr ecore.EBoolean isRandom;
	ref Block[*] blocks;
}

class HallOfFame {
	attr ecore.EInt[*] highScores;
	ref Player[*] players;
}

class PausedGame {
	ref Player[1] player;
	ref Game[1] game;
}


