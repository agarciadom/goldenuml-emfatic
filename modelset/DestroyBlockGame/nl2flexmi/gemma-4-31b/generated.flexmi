<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="DestroyBlock" nsURI="http://www.destroyblock.com" nsPrefix="db">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Admin" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Game">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="minSpeed" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="speedIncreaseFactor" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="maxLength" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="minLength" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="numBlocksPerLevel" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="admin" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="hallOfFame" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="blocks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="levels" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BlockDefinition">
      <eStructuralFeatures>
        <eAttribute name="color" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="points" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Level">
      <eStructuralFeatures>
        <eAttribute name="levelNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isRandom" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="placements" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BlockPlacement">
      <eStructuralFeatures>
        <eAttribute name="gridX" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="gridY" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="blockDef" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HallOfFame">
      <eStructuralFeatures>
        <eReference name="entries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoreEntry">
      <eStructuralFeatures>
        <eAttribute name="totalScore" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="player" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GameSession">
      <eStructuralFeatures>
        <eAttribute name="lives" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="currentScore" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isPaused" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="game" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="player" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
