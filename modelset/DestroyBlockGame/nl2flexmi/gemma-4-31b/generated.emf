@namespace(uri="http://www.destroyblock.com", prefix="db")
package DestroyBlock;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}

class Player extends User {
}

class Admin extends Player {
}

class Game {
	attr ecore.EString[1] name;
	attr ecore.EDouble[1] minSpeed;
	attr ecore.EDouble[1] speedIncreaseFactor;
	attr ecore.EInt[1] maxLength;
	attr ecore.EInt[1] minLength;
	attr ecore.EInt[1] numBlocksPerLevel;
	ref Admin[1] admin;
	val HallOfFame[1] hallOfFame;
	val BlockDefinition[*] blocks;
	val Level[*] levels;
}

class BlockDefinition {
	attr ecore.EString[1] color;
	attr ecore.EInt[1] points;
}

class Level {
	attr ecore.EInt[1] levelNumber;
	attr ecore.EBoolean[1] isRandom;
	val BlockPlacement[*] placements;
}

class BlockPlacement {
	attr ecore.EInt[1] gridX;
	attr ecore.EInt[1] gridY;
	ref BlockDefinition[1] blockDef;
}

class HallOfFame {
	val ScoreEntry[*] entries;
}

class ScoreEntry {
	attr ecore.EInt[1] totalScore;
	ref Player[1] player;
}

class GameSession {
	attr ecore.EInt[1] lives;
	attr ecore.EInt[1] currentScore;
	attr ecore.EBoolean[1] isPaused;
	ref Game[1] game;
	ref Player[1] player;
}


