@namespace(uri="http://www.example.org/DestroyBlock", prefix="db")
package DestroyBlock;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}

class Player extends User {
}

class Admin extends User {
	ref Game[*] games;
}

class Game {
	attr ecore.EString[1] name;
	ref Admin admin;
	val Level[+] levels;
}

class Level {
	attr ecore.EInt[1] number;
	ref Game[*] game;
	ref Block[*] blocks;
}

class Block {
	attr ecore.EString[1] color;
	attr ecore.EInt[1] points;
}


