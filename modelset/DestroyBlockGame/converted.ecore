<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="breakout"
    nsURI="http://www.example.org/breakout"
    nsPrefix="breakout">

  <!-- User class -->
  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="password" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- BlockAssignment class -->
  <eClassifiers xsi:type="ecore:EClass" name="BlockAssignment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gridHorizontalPosition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gridVerticalPosition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference to Block -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="block" lowerBound="1" eType="#//Block"/>
    <!-- Opposite of Level.blockAssignments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="level" eType="#//Level" eOpposite="#//Level/blockAssignments"/>
  </eClassifiers>

  <!-- Level class -->
  <eClassifiers xsi:type="ecore:EClass" name="Level">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isRandom" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Opposite of BlockAssignment.level -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blockAssignments" upperBound="-1" eType="#//BlockAssignment" eOpposite="#//BlockAssignment/level"/>
  </eClassifiers>

  <!-- Game class -->
  <eClassifiers xsi:type="ecore:EClass" name="Game">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nrBlocksPerLevel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="published" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Composition: Game contains Blocks -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blocks" upperBound="-1" eType="#//Block" containment="true"/>
    <!-- Composition: Game contains Paddle -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="paddle" lowerBound="1" eType="#//Paddle" containment="true"/>
    <!-- Composition: Game contains Ball -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="ball" lowerBound="1" eType="#//Ball" containment="true"/>
    <!-- Composition: Game contains Levels (1..99) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="levels" lowerBound="1" upperBound="99" eType="#//Level" containment="true"/>
    <!-- Composition: Game contains BlockAssignments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blockAssignments" upperBound="-1" eType="#//BlockAssignment" containment="true"/>
    <!-- Association: Game to HallOfFameEntry (0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="mostRecentEntry" eType="#//HallOfFameEntry"/>
    <!-- Opposite of PlayedGame.game -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="playedGames" upperBound="-1" eType="#//PlayedGame" eOpposite="#//PlayedGame/game"/>
    <!-- Opposite of Admin.games -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="admin" lowerBound="1" eType="#//Admin" eOpposite="#//Admin/games"/>
  </eClassifiers>

  <!-- Block class -->
  <eClassifiers xsi:type="ecore:EClass" name="Block">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="red" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="green" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="blue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="points" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Opposite of PlayedBlockAssignment.block -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="playedBlockAssignments" upperBound="-1" eType="#//PlayedBlockAssignment" eOpposite="#//PlayedBlockAssignment/block"/>
  </eClassifiers>

  <!-- Paddle class -->
  <eClassifiers xsi:type="ecore:EClass" name="Paddle">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxPaddleLength" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minPaddleLength" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- Ball class -->
  <eClassifiers xsi:type="ecore:EClass" name="Ball">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minBallSpeedX" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minBallSpeedY" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ballSpeedIncreaseFactor" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- HallOfFameEntry class -->
  <eClassifiers xsi:type="ecore:EClass" name="HallOfFameEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="score" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Association: HallOfFameEntry to Game -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="game" lowerBound="1" eType="#//Game"/>
    <!-- Opposite of Player.hallOfFameEntries -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="player" eType="#//Player" eOpposite="#//Player/hallOfFameEntries"/>
  </eClassifiers>

  <!-- PlayedGame class -->
  <eClassifiers xsi:type="ecore:EClass" name="PlayedGame">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="score" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lives" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentLevel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Composition: PlayedGame contains PlayedBlockAssignments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="blocks" upperBound="-1" eType="#//PlayedBlockAssignment" containment="true"/>
    <!-- Composition: PlayedGame contains PlayedPaddle -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="playedPaddle" lowerBound="1" eType="#//PlayedPaddle" containment="true"/>
    <!-- Composition: PlayedGame contains PlayedBall -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="playedBall" lowerBound="1" eType="#//PlayedBall" containment="true"/>
    <!-- Opposite of Game.playedGames -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="game" eType="#//Game" eOpposite="#//Game/playedGames"/>
    <!-- Opposite of Player.playedGames -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="player" eType="#//Player" eOpposite="#//Player/playedGames"/>
  </eClassifiers>

  <!-- PlayedBall class -->
  <eClassifiers xsi:type="ecore:EClass" name="PlayedBall">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ballDirectionX" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ballDirectionY" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentBallX" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentBallY" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- PlayedPaddle class -->
  <eClassifiers xsi:type="ecore:EClass" name="PlayedPaddle">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentPaddleLength" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentPaddleX" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentPaddleY" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- PlayedBlockAssignment class -->
  <eClassifiers xsi:type="ecore:EClass" name="PlayedBlockAssignment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="x" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="y" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Opposite of Block.playedBlockAssignments -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="block" lowerBound="1" eType="#//Block" eOpposite="#//Block/playedBlockAssignments"/>
  </eClassifiers>

  <!-- Player class -->
  <eClassifiers xsi:type="ecore:EClass" name="Player">
    <!-- Association: Player to User -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="user" lowerBound="1" eType="#//User"/>
    <!-- Opposite of PlayedGame.player -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="playedGames" upperBound="-1" eType="#//PlayedGame" eOpposite="#//PlayedGame/player"/>
    <!-- Opposite of HallOfFameEntry.player -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="hallOfFameEntries" upperBound="-1" eType="#//HallOfFameEntry" eOpposite="#//HallOfFameEntry/player"/>
  </eClassifiers>

  <!-- Admin class -->
  <eClassifiers xsi:type="ecore:EClass" name="Admin">
    <!-- Association: Admin to User -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="user" lowerBound="1" eType="#//User"/>
    <!-- Opposite of Game.admin -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="games" upperBound="-1" eType="#//Game" eOpposite="#//Game/admin"/>
  </eClassifiers>

</ecore:EPackage>
