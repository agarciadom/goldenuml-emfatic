@namespace(uri="http://destroyblock/game", prefix="p")
package DestroyBlock;

class User {
  attr String username;
  attr String password;
}
class Player extends User {
  attr String username;
  attr String password;
  ref Game[*] gamesPlayed;
}
class Admin extends User {
  attr String username;
  attr String password;
  ref Game game;
}
class Game {
  attr String name;
  ref Player[*] players;
  ref Admin admin;
  val Block[*] blocks;
  val Level[*] levels;
  val HallOfFame hallOfFame;
  val GameSettings settings;
}
class Block {
  attr String color;
  attr Integer points;
}
class Level {
  attr Integer number;
  attr Boolean isRandom;
  val BlockPosition[*] blockPositions;
}
class BlockPosition {
  attr Integer x;
  attr Integer y;
}
class HallOfFame {
  ref Game gameRef;
  val HighScore[*] highScores;
}
class HighScore {
  attr Integer score;
  ref Player player;
}
class GameSettings {
  attr Float minSpeed;
  attr Float speedIncreaseFactor;
  attr Integer maxPaddleLength;
  attr Integer minPaddleLength;
}
class PausedGame {
  attr Integer currentLevel;
  attr Integer livesRemaining;
  ref Game gameRef;
  ref Player playerRef;
}