@namespace(uri="http://www.example.org/breakout", prefix="breakout")
package breakout;

class User {
	attr String username;
	attr String password;
}

class BlockAssignment {
	attr int gridHorizontalPosition;
	attr int gridVerticalPosition;
	ref Block[1] block;
	ref Level#blockAssignments level;
}

class Level {
	attr boolean isRandom;
	ref BlockAssignment[*]#level blockAssignments;
}

class Game {
	attr String name;
	attr int nrBlocksPerLevel;
	attr boolean published;
	val Block[*] blocks;
	val Paddle[1] paddle;
	val Ball[1] ball;
	val Level[1..99] levels;
	val BlockAssignment[*] blockAssignments;
	ref HallOfFameEntry mostRecentEntry;
	ref PlayedGame[*]#game playedGames;
	ref Admin[1]#games admin;
}

class Block {
	attr int ~id;
	attr int red;
	attr int green;
	attr int blue;
	attr int points;
	ref PlayedBlockAssignment[*]#block playedBlockAssignments;
}

class Paddle {
	attr int maxPaddleLength;
	attr int minPaddleLength;
}

class Ball {
	attr int minBallSpeedX;
	attr int minBallSpeedY;
	attr double ballSpeedIncreaseFactor;
}

class HallOfFameEntry {
	attr int score;
	ref Game[1] game;
	ref Player#hallOfFameEntries player;
}

class PlayedGame {
	attr int ~id;
	attr int score;
	attr int lives;
	attr int currentLevel;
	val PlayedBlockAssignment[*] blocks;
	val PlayedPaddle[1] playedPaddle;
	val PlayedBall[1] playedBall;
	ref Game#playedGames game;
	ref Player#playedGames player;
}

class PlayedBall {
	attr double ballDirectionX;
	attr double ballDirectionY;
	attr double currentBallX;
	attr double currentBallY;
}

class PlayedPaddle {
	attr double currentPaddleLength;
	attr double currentPaddleX;
	attr double currentPaddleY;
}

class PlayedBlockAssignment {
	attr int x;
	attr int y;
	ref Block[1]#playedBlockAssignments block;
}

class Player {
	ref User[1] user;
	ref PlayedGame[*]#player playedGames;
	ref HallOfFameEntry[*]#player hallOfFameEntries;
}

class Admin {
	ref User[1] user;
	ref Game[*]#admin games;
}


