@namespace(uri="http://www.example.org/breakout", prefix="breakout")
package breakout;

class User {
	attr null username;
	attr null password;
}

class BlockAssignment {
	attr null gridHorizontalPosition;
	attr null gridVerticalPosition;
	ref Block[1] block;
	ref Level#blockAssignments level;
}

class Level {
	attr null isRandom;
	ref BlockAssignment[*]#level blockAssignments;
}

class Game {
	attr null name;
	attr null nrBlocksPerLevel;
	attr null published;
	val Block[*] blocks;
	val Paddle[1] paddle;
	val Ball[1] ball;
	val Level[1..99] levels;
	val BlockAssignment[*] blockAssignments;
	ref HallOfFameEntry mostRecentEntry;
	ref PlayedGame[*]#game playedGames;
	ref Admin[1]#games admin;
}

class Block {
	attr null ~id;
	attr null red;
	attr null green;
	attr null blue;
	attr null points;
	ref PlayedBlockAssignment[*]#block playedBlockAssignments;
}

class Paddle {
	attr null maxPaddleLength;
	attr null minPaddleLength;
}

class Ball {
	attr null minBallSpeedX;
	attr null minBallSpeedY;
	attr null ballSpeedIncreaseFactor;
}

class HallOfFameEntry {
	attr null score;
	ref Game[1] game;
	ref Player[1]#hallOfFameEntries player;
}

class PlayedGame {
	attr null ~id;
	attr null score;
	attr null lives;
	attr null currentLevel;
	val PlayedBlockAssignment[*]#playedGame blocks;
	val PlayedPaddle[1] playedPaddle;
	val PlayedBall[1] playedBall;
	ref Game[1]#playedGames game;
	ref Player[1]#playedGames player;
}

class PlayedBall {
	attr null ballDirectionX;
	attr null ballDirectionY;
	attr null currentBallX;
	attr null currentBallY;
}

class PlayedPaddle {
	attr null currentPaddleLength;
	attr null currentPaddleX;
	attr null currentPaddleY;
}

class PlayedBlockAssignment {
	attr null x;
	attr null y;
	ref Block[1]#playedBlockAssignments block;
	ref PlayedGame[1]#blocks playedGame;
}

class Player {
	ref User[1] user;
	ref PlayedGame[*]#player playedGames;
	ref HallOfFameEntry[*]#player hallOfFameEntries;
}

class Admin {
	ref User[1] user;
	ref Game[*]#admin games;
}


