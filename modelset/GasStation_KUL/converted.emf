@namespace(uri="http://www.example.org/gasstation", prefix="gasstation")
package gasstation;

class CardHolder {
	attr String Name;
	attr boolean Suspended;
	val Invoice[*]#cardHolder invoices;
	val RefuelTurn[*]#cardHolder refuelTurns;
}

class Invoice {
	attr int Number;
	attr double Discount;
	attr String status;
	ref CardHolder[1]#invoices cardHolder;
	val InvoiceLine[*]#invoice invoiceLines;
}

class InvoiceLine {
	attr int Number;
	ref Invoice[1]#invoiceLines invoice;
	ref RefuelTurn#invoiceLine refuelTurn;
}

class GasStation {
	attr String Name;
	val Pump[*]#gasStation pumps;
}

class Pump {
	attr String Type;
	attr boolean InUse;
	attr double RefillThreshold;
	attr boolean Blocked;
	ref GasStation[1]#pumps gasStation;
	val RefuelTurn[*]#pump refuelTurns;
	val CashTurn[*]#pump cashTurns;
}

class RefuelTurn {
	attr int RefuelTurnNumber;
	ref Pump[1]#refuelTurns pump;
	ref CardHolder[1]#refuelTurns cardHolder;
	ref InvoiceLine#refuelTurn invoiceLine;
}

class CashTurn {
	ref Pump[1]#cashTurns pump;
}


