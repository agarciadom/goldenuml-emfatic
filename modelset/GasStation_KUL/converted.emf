@namespace(uri="http://www.example.org/gasstation", prefix="gasstation")
package gasstation;

class GasStationSystem {
	val GasStation[*] gasStations;
	val CardHolder[*] cardHolders;
}

class CardHolder {
	attr String name;
	attr boolean suspended;
	val Invoice[*] invoices;
	ref RefuelTurn[*]#cardHolder refuelTurns;
}

class Invoice {
	attr int number;
	attr double discount;
	attr String status;
	val InvoiceLine[*] invoiceLines;
}

class InvoiceLine {
	attr int number;
}

class GasStation {
	attr String name;
	val Pump[*]#gasStation pumps;
}

class Pump {
	attr String type;
	attr boolean inUse;
	attr double refillThreshold;
	attr boolean blocked;
	ref GasStation#pumps gasStation;
	val RefuelTurn[*]#pump refuelTurns;
	val CashTurn[*]#pump cashTurns;
}

class RefuelTurn {
	attr int refuelTurnNumber;
	ref Pump#refuelTurns pump;
	ref CardHolder#refuelTurns cardHolder;
	ref InvoiceLine invoiceLine;
}

class CashTurn {
	ref Pump#cashTurns pump;
}


