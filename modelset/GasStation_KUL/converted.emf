@namespace(uri="http://www.example.org/gasstation", prefix="gasstation")
package gasstation;

class CardHolder {
	attr String Name;
	attr boolean Suspended;
	val Invoice[*] invoices;
	val RefuelTurn[*] refuelTurns;
}

class Invoice {
	attr int Number;
	attr double Discount;
	attr String status;
	val InvoiceLine[*] invoiceLines;
}

class InvoiceLine {
	attr int Number;
}

class GasStation {
	attr String Name;
	val Pump[*] pumps;
}

class Pump {
	attr String Type;
	attr boolean InUse;
	attr double RefillThreshold;
	attr boolean Blocked;
	val RefuelTurn[*] refuelTurns;
	val CashTurn[*] cashTurns;
}

class RefuelTurn {
	attr int RefuelTurnNumber;
	ref InvoiceLine invoiceLine;
}

class CashTurn {
}


