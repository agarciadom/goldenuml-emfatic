<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OilCompany" nsURI="http://oilcompany.example.org" nsPrefix="oc">
  <eClassifiers>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pumps" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pump">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="gasolineType" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="level" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="reorderLevel" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="isBlocked" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="gasStation" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="refuelCards" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="invoices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefuelCard">
      <eStructuralFeatures>
        <eAttribute name="cardNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="balance" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefuelTurn">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="pump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="refuelCard" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="month" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="totalAmount" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="discountPercentage" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="refuelTurns" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="amountPaid" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="datePaid" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="invoice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
