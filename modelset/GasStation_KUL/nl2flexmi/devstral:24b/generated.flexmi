<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OilCompanyModel" nsURI="http://www.example.org/oilcompanymodel" nsPrefix="ocm">
  <eClassifiers>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="pumps" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pump">
      <eStructuralFeatures>
        <eAttribute name="pumpId" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="gasolineType" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="currentLevel" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eAttribute name="reorderLevel" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eReference name="gasStation" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefuelTurn">
      <eStructuralFeatures>
        <eAttribute name="refuelId" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="amountLiters" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eAttribute name="timestamp" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="customerId" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="creditCardNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="invoices" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="payments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceId" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="amountDue" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eAttribute name="month" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="refuelTurns" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="paymentId" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="amountPaid" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eAttribute name="datePaid" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="invoice" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
