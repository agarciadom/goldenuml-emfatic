@namespace(uri="http://oilcompany.example.org", prefix="oc")
package OilCompany;

import "http://www.eclipse.org/emf/2002/Ecore";

class GasStation {
	attr ecore.EString[1] ~id;
	val Pump[*] pumps;
}

class Pump {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] gasolineType;
	attr ecore.EDouble[1] level;
	attr ecore.EDouble[1] reorderLevel;
	attr ecore.EBoolean[1] isBlocked;
	ref GasStation[1] gasStation;
}

class Customer {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	val RefuelCard[*] refuelCards;
	val Invoice[*] invoices;
}

class RefuelCard {
	attr ecore.EString[1] cardNumber;
	attr ecore.EDouble[1] balance;
	ref Customer[1] customer;
}

class RefuelTurn {
	attr ecore.EString[1] ~id;
	attr ecore.EDouble[1] amount;
	attr ecore.EDate[1] date;
	ref Pump[1] pump;
	ref Customer[1] customer;
	ref RefuelCard refuelCard;
}

class Invoice {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] month;
	attr ecore.EDouble[1] totalAmount;
	attr ecore.EDouble discountPercentage;
	val RefuelTurn[*] refuelTurns;
}

class Payment {
	attr ecore.EString[1] ~id;
	attr ecore.EDouble[1] amountPaid;
	attr ecore.EDate[1] datePaid;
	ref Invoice[1] invoice;
}


