<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OilCompanySystem" nsURI="http://example.com/OilCompanySystem" nsPrefix="oc">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="refuelCards" containment="False" lowerBound="0" upperBound="100" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefuelCard">
      <eStructuralFeatures>
        <eAttribute name="cardNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pumps" containment="True" lowerBound="0" upperBound="100" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pump">
      <eStructuralFeatures>
        <eAttribute name="gasolineType" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="currentLevel" lowerBound="0" upperBound="10000" eType="//EDouble" />
        <eReference name="reservoir" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefuelTurn">
      <eStructuralFeatures>
        <eReference name="customer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="pump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="month" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="refuelTurns" containment="False" lowerBound="0" upperBound="100" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eReference name="invoice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Reservoir">
      <eStructuralFeatures>
        <eAttribute name="capacity" lowerBound="0" upperBound="10000" eType="//EDouble" />
        <eReference name="pump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
