@namespace(uri="http://example.com/OilCompanySystem", prefix="oc")
package OilCompanySystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Customer {
	attr ecore.EString[1] name;
	ref RefuelCard[0..100] refuelCards;
}

class RefuelCard {
	attr ecore.EString[1] cardNumber;
	ref Customer customer;
}

class GasStation {
	attr ecore.EString[1] location;
	val Pump[0..100] pumps;
}

class Pump {
	attr ecore.EString[1] gasolineType;
	attr ecore.EDouble[0..10000] currentLevel;
	ref Reservoir[1] reservoir;
}

class RefuelTurn {
	ref Customer customer;
	ref Pump[1] pump;
}

class Invoice {
	attr ecore.EString[1] month;
	ref RefuelTurn[0..100] refuelTurns;
}

class Payment {
	ref Invoice[1] invoice;
}

class Reservoir {
	attr ecore.EDouble[0..10000] capacity;
	ref Pump[1] pump;
}


