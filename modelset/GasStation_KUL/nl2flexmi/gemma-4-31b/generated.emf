@namespace(uri="http://www.oilcompany.com/system", prefix="oc")
package OilCompanySystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class GasStation {
	attr ecore.EString[1] name;
	val Pump[*] pumps;
}

class Pump {
	attr ecore.EString[1] gasolineType;
	attr ecore.EDouble[1] reorderingLevel;
	attr ecore.EDouble[1] currentLevel;
	attr ecore.EDouble[1] orderQuantity;
	attr ecore.EBoolean[1] isBlocked;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString[1] status;
	attr ecore.EInt[1] slackThreshold;
	val FuelCard fuelCard;
}

class FuelCard {
	attr ecore.EString[1] cardNumber;
	attr ecore.EBoolean[1] isBlocked;
}

class RefuelTurn {
	attr ecore.EBigDecimal[1] amount;
	attr ecore.EDate[1] timestamp;
	ref Pump[1] pump;
	ref Customer[1] customer;
	ref FuelCard fuelCard;
}

class Invoice {
	attr ecore.EString[1] invoiceNumber;
	attr ecore.EDate[1] date;
	attr ecore.EBigDecimal[1] totalAmount;
	attr ecore.EBigDecimal[1] discount;
	val RefuelTurn[*] refuelTurns;
	ref Customer[1] customer;
}

class Payment {
	attr ecore.EBigDecimal[1] paymentAmount;
	attr ecore.EDate[1] paymentDate;
	ref Invoice[1] invoice;
}


