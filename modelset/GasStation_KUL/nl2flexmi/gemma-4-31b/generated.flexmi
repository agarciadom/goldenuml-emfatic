<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OilCompanySystem" nsURI="http://www.oilcompany.com/system" nsPrefix="oc">
  <eClassifiers>
    <eClass name="GasStation">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pumps" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pump">
      <eStructuralFeatures>
        <eAttribute name="gasolineType" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="reorderingLevel" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="currentLevel" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="orderQuantity" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="isBlocked" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="slackThreshold" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="fuelCard" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FuelCard">
      <eStructuralFeatures>
        <eAttribute name="cardNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isBlocked" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefuelTurn">
      <eStructuralFeatures>
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="pump" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="fuelCard" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="totalAmount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="discount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="refuelTurns" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="paymentAmount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="paymentDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="invoice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
