@namespace(uri="http://company/oil/1.0", prefix="p")
package Company;

class Company {
  attr EString name;
  val GasStation[*] gasStations;
}
class GasStation extends Company {
  attr EInt ~id;
  attr EString location;
  val Pump[*] pumps;
}
class Pump {
  attr EInt ~id;
  attr EString typeOfGasoline;
  attr EFloat currentLevel;
  attr EFloat reorderLevel;
  attr EFloat criticalLevel;
  attr EBoolean isBlocked;
}

@namespace(uri="http://customers/oil/1.0", prefix="p")
package Customers;

class Customer {
  attr EInt ~id;
  attr EString name;
  val RefuelCard refuelCard;
}

@namespace(uri="http://transactions/oil/1.0", prefix="p")
package Transactions;

class RefuelCard {
  attr EInt ~id;
  attr EBoolean suspended;
  ref Customer customer;
}
class Invoice {
  attr EInt ~id;
  attr EFloat amountDue;
  attr EFloat discountApplied;
  attr EDateTime issuedDate;
  attr EBoolean paid;
  val RefuelTurn[*] refuelTurns;
  ref Customer customer;
}
class Payment {
  attr EInt ~id;
  attr EDateTime paymentDate;
  attr EFloat amountPaid;
  ref Invoice invoice;
}
class RefuelTurn {
  attr EInt ~id;
  attr EDateTime startTime;
  attr EDateTime endTime;
  attr EFloat amountSpent;
  ref Pump pump;
  ref RefuelCard refuelCard;
}