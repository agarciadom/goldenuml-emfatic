<modelElement xmi:version="2.0" xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
    xmlns:Ecore="http://www.eclipse.org/emf/2003/Ecore"
    xmlns:ecore="Ecore">
    <eAnnotations source="http://www.eclipse.org/emf/2003/Ecore">
        <details key="name" value="OilCompanySystem"/>
        <details key="creatorVersion" value="2.0.0"/>
    </eAnnotations>
    <children>
        <!-- Root container class -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.OilCompany" name="OilCompany">
            <eStructuralFeatures>
                <!-- Contains all GasStations without a specific container -->
                <eFeature name="gasStations" type="GasStation"
                    lowerBound="0" upperBound="-1" containment="true"/>
            </eStructuralFeatures>
        </packagedElement>

        <!-- Represents each gas station in the company -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.GasStation" name="GasStation">
            <eStructuralFeatures>
                <!-- List of pumps managed by this station -->
                <eFeature name="pumps" type="Pump"
                    lowerBound="0" upperBound="-1" containment="true"/>
                <!-- Derived reference to daily report generated by the station -->
                <eFeature name="dailyReport" type="DailyReport" derived="true"/>
            </eStructuralFeatures>
        </packagedElement>

        <!-- Represents a fuel pump within a gas station -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.Pump" name="Pump">
            <eStructuralFeatures>
                <eFeature name="gasolineType" type="String"/>
                <eFeature name="currentLevel" type="BigDecimal"/>
                <eFeature name="reorderingLevel" type="BigDecimal"/>
                <eFeature name="criticalLevel" type="BigDecimal"/>
                <eFeature name="isBlocked" type="Boolean"
                    defaultValue="false"/>
            </eStructuralFeatures>
            <!-- Operations related to pump functionality -->
            <eOperations>
                <!-- Initiate refueling with a specific amount -->
                <eOperation name="refuel">
                    <eParameters name="amount" type="BigDecimal"/>
                    <eOperation eType="RefuelTurn"/>
                </eOperation>

                <!-- Block the pump (e.g., due to low fuel or maintenance) -->
                <eOperation name="blockPump">
                    <eOperation eType="void"/>
                </eOperation>

                <!-- Unblock the pump after maintenance or when safe to refuel -->
                <eOperation name="unblockPump">
                    <eOperation eType="void"/>
                </eOperation>
            </eOperations>
        </packagedElement>

        <!-- Represents a customer of the oil company -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.Customer" name="Customer">
            <eStructuralFeatures>
                <!-- Each customer may have an associated refuel card -->
                <eFeature name="refuelCard" type="RefuelCard"
                    containment="true"/>
                <!-- List of invoices issued to the customer -->
                <eFeature name="invoices" type="Invoice"
                    lowerBound="0" upperBound="-1" reference="true"/>
                <!-- Flag indicating if the customer's card is suspended -->
                <eFeature name="isSuspended" type="Boolean"
                    defaultValue="false"/>
            </eStructuralFeatures>
        </packagedElement>

        <!-- Represents a refuel card issued to a customer -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.RefuelCard" name="RefuelCard">
            <eStructuralFeatures>
                <eFeature name="customerId" type="String"/>
                <!-- Discounts applied based on monthly turnover -->
                <eFeature name="turnoverDiscounts"
                    eGenericType="/Ecore/EMap&lt;Month,BigDecimal&gt;" />
                <!-- Number of consecutive unpaid invoices before suspension -->
                <eFeature name="paymentThreshold" type="Integer"/>
            </eStructuralFeatures>
        </packagedElement>

        <!-- Represents a single refueling transaction -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.RefuelTurn" name="RefuelTurn">
            <eStructuralFeatures>
                <eFeature name="amount" type="BigDecimal"/>
                <eFeature name="date" type="LocalDate"/>
                <!-- Reference to the pump used for refueling -->
                <eFeature name="pump" type="Pump" reference="true"/>
                <!-- Reference to the customer who performed the refuel -->
                <eFeature name="customer" type="Customer"
                    reference="true"/>
            </eStructuralFeatures>
        </packagedElement>

        <!-- Represents an invoice sent to a customer for their monthly refueling -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.Invoice" name="Invoice">
            <eStructuralFeatures>
                <!-- List of refuel turns included in this invoice -->
                <eFeature name="refuelTurns" type="RefuelTurn"
                    lowerBound="0" upperBound="-1" containment="true"/>
                <!-- Total amount due on the invoice (derived) -->
                <eFeature name="totalAmount" type="BigDecimal" derived="true"/>
                <eFeature name="month" type="Month"/>
                <eFeature name="isPaid" type="Boolean"
                    defaultValue="false"/>
            </eStructuralFeatures>
        </packagedElement>

        <!-- Represents a daily report of pump statuses and refill needs -->
        <packagedElement xmi:type="ecore:EClass" xmi:id="com.example.DailyReport" name="DailyReport">
            <eStructuralFeatures>
                <eFeature name="reportDate" type="LocalDate"/>
                <!-- Pumps that need refilling based on current level -->
                <eFeature name="pumpsNeedingRefill" type="Pump"
                    lowerBound="0" upperBound="-1" containment="true"/>
                <!-- Map of pumps to the quantity of fuel needed for refill -->
                <eFeature name="refillQuantities"
                    eGenericType="/Ecore/EMap&lt;Pump,BigDecimal&gt;" />
            </eStructuralFeatures>
        </packagedElement>
    </children>
</modelElement>
