<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:eci="http://www.eclipse.org/emf/2002/Ecore/">
  <eci:EPackage name="oilCompanySystem" eNSUri="http://www.oilcompany.com/system">
    
    <!-- Custom Datatype for LocalTime (Times without dates) -->
    <eci:EDataType name="LocalTime" instanceClassName="java.time.LocalTime"/>

    <!-- Enums -->
    <eci:EEnum name="PaymentMethod">
      <eci:ELiteral name="CASH"/>
      <eci:ELiteral name="CREDIT_CARD"/>
      <eci:ELiteral name="REFUEL_CARD"/>
    </eci:EEnum>

    <eci:EEnum name="PumpStatus">
      <eci:ELiteral name="AVAILABLE"/>
      <eci:ELiteral name="OCCUPIED"/>
      <eci:ELiteral name="BLOCKED"/>
    </eci:EEnum>

    <eci:EEnum name="CustomerStatus">
      <eci:ELiteral name="ACTIVE"/>
      <eci:ELiteral name="SUSPENDED"/>
    </eci:EEnum>

    <!-- Root Container -->
    <eci:EClass name="OilCompanySystem">
      <eci:EReference name="gasStations" eClass="GasStation" containment="true"/>
      <eci:EReference name="customers" eClass="Customer" containment="true"/>
      <eci:EOperation name="generateDailyRefillReport"/>
    </eci:EClass>

    <eci:EClass name="GasStation">
      <eci:EAttribute name="name" eType="eString"/>
      <eci:EReference name="pumps" eClass="Pump" containment="true"/>
    </eci:EClass>

    <eci:EClass name="Pump">
      <eci:EAttribute name="pumpId" eType="eString"/>
      <eci:EAttribute name="status" eType="PumpStatus"/>
      <eci:EReference name="gasolineType" eClass="GasolineType"/>
      <eci:EReference name="reservoir" eClass="Reservoir" containment="true"/>
      <!-- RefuelTurn is the association class; non-containment end -->
      <eci:EReference name="refuelTurns" eClass="RefuelTurn"/>
    </eci:EClass>

    <eci:EClass name="GasolineType">
      <eci:EAttribute name="typeName" eType="eString"/>
    </eci:EClass>

    <eci:EClass name="Reservoir">
      <eci:EAttribute name="currentLevel" eType="eDouble"/>
      <eci:EAttribute name="capacity" eType="eDouble"/>
      <eci:EAttribute name="reorderingLevel" eType="eDouble"/>
      <eci:EAttribute name="criticalLevel" eType="eDouble"/>
    </eci:EClass>

    <eci:EClass name="Customer">
      <eci:EAttribute name="name" eType="eString"/>
      <eci:EAttribute name="status" eType="CustomerStatus"/>
      <eci:EAttribute name="blockThreshold" eType="eInteger"/>
      <eci:EReference name="refuelCard" eClass="RefuelCard" containment="true"/>
      <eci:EReference name="invoices" eClass="Invoice" containment="true"/>
      <!-- RefuelTurn is the association class; containment end -->
      <eci:EReference name="refuelTurns" eClass="RefuelTurn" containment="true"/>
    </eci:EClass>

    <eci:EClass name="RefuelCard">
      <eci:EAttribute name="cardNumber" eType="eString"/>
      <eci:EAttribute name="expiryDate" eType="eDate"/>
    </eci:EClass>

    <!-- RefuelTurn serves as the association class for Customer <-> Pump -->
    <eci:EClass name="RefuelTurn">
      <eci:EAttribute name="startTime" eType="eDate"/>
      <eci:EAttribute name="endTime" eType="eDate"/>
      <eci:EAttribute name="quantity" eType="eDouble"/>
      <eci:EAttribute name="amount" eType="eDouble"/>
      <eci:EAttribute name="paymentMethod" eType="PaymentMethod"/>
      <eci:EReference name="customer" eClass="Customer"/>
      <eci:EReference name="pump" eClass="Pump"/>
    </eci:EClass>

    <eci:EClass name="Invoice">
      <eci:EAttribute name="invoiceNumber" eType="eString"/>
      <eci:EAttribute name="dateSent" eType="eDate"/>
      <eci:EAttribute name="totalAmount" eType="eDouble"/>
      <eci:EAttribute name="discountApplied" eType="eDouble"/>
      <eci:EReference name="customer" eClass="Customer"/>
      <eci:EReference name="refuelTurns" eClass="RefuelTurn"/>
      <eci:EReference name="payments" eClass="Payment" containment="true"/>
    </eci:EClass>

    <eci:EClass name="Payment">
      <eci:EAttribute name="paymentDate" eType="eDate"/>
      <eci:EAttribute name="amountPaid" eType="eDouble"/>
      <eci:EReference name="invoice" eClass="Invoice"/>
    </eci:EClass>

  </eci:EPackage>
</xmi:XMI>
