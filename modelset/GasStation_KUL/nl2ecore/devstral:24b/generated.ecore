<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="OilCompanyModel" nsURI="http://www.example.org/OilCompanyModel" nsPrefix="oilmodel">

    <!-- Root container class -->
    <ecore:EClass name="SystemContainer">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Root container for the oil company system"/>
      </eAnnotations>
      <ecore:EReference name="gasStations" eType="#//GasStation" upperBound="-1"/>
    </ecore:EClass>

    <!-- Gas Station class -->
    <ecore:EClass name="GasStation">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents a gas station in the system"/>
      </eAnnotations>
      <ecore:EAttribute name="id" eType="ecore:EString"/>
      <ecore:EReference name="pumps" eType="#//Pump" upperBound="-1"/>
    </ecore:EClass>

    <!-- Pump class -->
    <ecore:EClass name="Pump">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents a pump at a gas station"/>
      </eAnnotations>
      <ecore:EAttribute name="id" eType="ecore:EInt"/>
      <ecore:EAttribute name="gasolineType" eType="ecore:EString"/>
      <ecore:EAttribute name="isBlocked" eType="ecore:EBoolean"/>
      <ecore:EReference name="reservoir" eType="#//Reservoir" containment="true"/>
    </ecore:EClass>

    <!-- Reservoir class -->
    <ecore:EClass name="Reservoir">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents the gasoline reservoir for a pump"/>
      </eAnnotations>
      <ecore:EAttribute name="currentLevel" eType="ecore:EDouble"/>
      <ecore:EAttribute name="reorderingLevel" eType="ecore:EDouble"/>
      <ecore:EAttribute name="criticalLevel" eType="ecore:EDouble"/>
    </ecore:EClass>

    <!-- Customer class -->
    <ecore:EClass name="Customer">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents a customer in the system"/>
      </eAnnotations>
      <ecore:EAttribute name="id" eType="ecore:EInt"/>
      <ecore:EReference name="invoices" eType="#//Invoice" upperBound="-1"/>
      <ecore:EAttribute name="isSuspended" eType="ecore:EBoolean"/>
    </ecore:EClass>

    <!-- RefuelCard class -->
    <ecore:EClass name="RefuelCard">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents a refuel card used by customers"/>
      </eAnnotations>
      <ecore:EReference name="holder" eType="#//Customer" containment="true"/>
    </ecore:EClass>

    <!-- Invoice class -->
    <ecore:EClass name="Invoice">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents a monthly invoice sent to customers"/>
      </eAnnotations>
      <ecore:EAttribute name="invoiceNumber" eType="ecore:EInt"/>
      <ecore:EAttribute name="amount" eType="ecore:EDouble"/>
      <ecore:EReference name="refuelTurns" eType="#//RefuelTurn" upperBound="-1"/>
    </ecore:EClass>

    <!-- Refuel Turn class -->
    <ecore:EClass name="RefuelTurn">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Represents a refuel turn at a pump"/>
      </eAnnotations>
      <ecore:EAttribute name="amount" eType="ecore:EDouble"/>
      <ecore:EReference name="customer" eType="#//Customer"/>
      <ecore:EReference name="pump" eType="#//Pump"/>
    </ecore:EClass>

    <!-- DailyReport class with operation -->
    <ecore:EClass name="DailyReport">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation" value="Generates daily reports for gas stations"/>
      </eAnnotations>
      <ecore:EOperation name="generateDailyReport">
        <eParameters name="gasStation" eType="#//GasStation"/>
      </ecore:EOperation>
    </ecore:EClass>

    <!-- Custom DataType for time without date -->
    <ecore:EDataType name="TimeOfDay">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="instanceClassName" value="java.time.LocalTime"/>
      </eAnnotations>
    </ecore:EDataType>

  </ecore:EPackage>
</xmi:XMI>
