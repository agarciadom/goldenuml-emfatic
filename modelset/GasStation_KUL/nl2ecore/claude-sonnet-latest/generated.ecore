<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="oilcompany"
    nsURI="http://www.example.org/oilcompany"
    nsPrefix="oilcompany">

  <!-- Custom datatypes -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
      instanceClassName="java.time.LocalTime"/>

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="CustomerStatus">
    <eLiterals name="NORMAL" value="0"/>
    <eLiterals name="SUSPENDED" value="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PumpStatus">
    <eLiterals name="AVAILABLE" value="0"/>
    <eLiterals name="IN_USE" value="1"/>
    <eLiterals name="BLOCKED_DIRT_CRITICAL" value="2"/>
    <eLiterals name="BLOCKED_REFILL" value="3"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PaymentMethod">
    <eLiterals name="CASH" value="0"/>
    <eLiterals name="CREDIT_CARD" value="1"/>
    <eLiterals name="FUEL_CARD" value="2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="InvoiceStatus">
    <eLiterals name="SENT" value="0"/>
    <eLiterals name="PAID" value="1"/>
    <eLiterals name="OVERDUE" value="2"/>
  </eClassifiers>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="OilCompanySystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="oilCompany"
        eType="#//OilCompany" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="discountRules"
        eType="#//DiscountRule" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dailyReports"
        eType="#//DailyReport" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- OilCompany -->
  <eClassifiers xsi:type="ecore:EClass" name="OilCompany">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gasStations"
        eType="#//GasStation" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers"
        eType="#//Customer" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="fuelCards"
        eType="#//FuelCard" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices"
        eType="#//Invoice" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- GasStation -->
  <eClassifiers xsi:type="ecore:EClass" name="GasStation">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pumps"
        eType="#//Pump" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="responsible"
        eType="#//GasStationResponsible" containment="true"/>
    <eOperations name="produceDailyReport" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- GasStationResponsible -->
  <eClassifiers xsi:type="ecore:EClass" name="GasStationResponsible">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contactInfo"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eOperations name="blockPump">
      <eParameters name="pump" eType="#//Pump"/>
    </eOperations>
    <eOperations name="releasePump">
      <eParameters name="pump" eType="#//Pump"/>
    </eOperations>
  </eClassifiers>

  <!-- Pump -->
  <eClassifiers xsi:type="ecore:EClass" name="Pump">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pumpId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="gasolineType"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//PumpStatus" defaultValueLiteral="AVAILABLE"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="reservoir"
        eType="#//Reservoir" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refuelTurns"
        eType="#//RefuelTurn" containment="true" upperBound="-1"/>
    <eOperations name="takeNozzle">
      <eParameters name="customer" eType="#//Customer"/>
    </eOperations>
    <eOperations name="putBackNozzle"/>
    <eOperations name="isAvailable"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Reservoir -->
  <eClassifiers xsi:type="ecore:EClass" name="Reservoir">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentLevel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="capacity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reorderLevel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="criticalLevel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refillEvents"
        eType="#//RefillEvent" containment="true" upperBound="-1"/>
    <eOperations name="needsRefill"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eOperations name="isBelowCriticalLevel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eOperations name="quantityToOrder"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- RefillEvent -->
  <eClassifiers xsi:type="ecore:EClass" name="RefillEvent">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="refillDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantityAdded"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="levelBeforeRefill"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pumpBlockedForSettling"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="blockStartTime"
        eType="#//LocalTime"/>
  </eClassifiers>

  <!-- Customer -->
  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="customerId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//CustomerStatus" defaultValueLiteral="NORMAL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nonPaymentThreshold"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="2"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consecutiveUnpaidMonths"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="fuelCard"
        eType="#//FuelCard"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refuelTurns"
        eType="#//RefuelTurn" upperBound="-1" eOpposite="#//RefuelTurn/customer"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices"
        eType="#//Invoice" upperBound="-1" eOpposite="#//Invoice/customer"/>
    <eOperations name="suspend"/>
    <eOperations name="reinstate"/>
    <eOperations name="isBlocked"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- FuelCard -->
  <eClassifiers xsi:type="ecore:EClass" name="FuelCard">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cardNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isBlocked"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="issueDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
        eType="#//Customer"/>
    <eOperations name="block"/>
    <eOperations name="unblock"/>
  </eClassifiers>

  <!-- RefuelTurn -->
  <eClassifiers xsi:type="ecore:EClass" name="RefuelTurn">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endTime"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pricePerUnit"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalAmount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentMethod"
        eType="#//PaymentMethod"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer"
        eType="#//Customer" eOpposite="#//Customer/refuelTurns"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pump"
        eType="#//Pump"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLine"
        eType="#//InvoiceLine"/>
    <eOperations name="computeTotalAmount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- Invoice -->
  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="invoiceId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="invoiceMonth"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sentDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paidDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//InvoiceStatus" defaultValueLiteral="SENT"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalBeforeDiscount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discountRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalAfterDiscount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timesSent"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="0"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer"
        eType="#//Customer" eOpposite="#//Customer/invoices"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lines"
        eType="#//InvoiceLine" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="payments"
        eType="#//Payment" containment="true" upperBound="-1"/>
    <eOperations name="send"/>
    <eOperations name="resend"/>
    <eOperations name="receivePayment">
      <eParameters name="payment" eType="#//Payment"/>
    </eOperations>
    <eOperations name="applyDiscount"/>
    <eOperations name="isPaid"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- InvoiceLine -->
  <eClassifiers xsi:type="ecore:EClass" name="InvoiceLine">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="refuelTurn"
        eType="#//RefuelTurn"/>
  </eClassifiers>

  <!-- Payment -->
  <eClassifiers xsi:type="ecore:EClass" name="Payment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentMethod"
        eType="#//PaymentMethod"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice"
        eType="#//Invoice"/>
  </eClassifiers>

  <!-- DiscountRule -->
  <eClassifiers xsi:type="ecore:EClass" name="DiscountRule">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minimumTurnover"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discountRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eOperations name="applies"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eParameters name="turnover"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eParameters name="customer" eType="#//Customer"/>
    </eOperations>
  </eClassifiers>

  <!-- DailyReport -->
  <eClassifiers xsi:type="ecore:EClass" name="DailyReport">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reportDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries"
        eType="#//DailyReportEntry" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gasStation"
        eType="#//GasStation"/>
  </eClassifiers>

  <!-- DailyReportEntry -->
  <eClassifiers xsi:type="ecore:EClass" name="DailyReportEntry">
    <eStructuralFeatures xsi:type="ecore:EReference" name="pump"
        eType="#//Pump"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentLevel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantityToOrder"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="needsRefill"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

</ecore:EPackage>
