<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="socialnetwork"
    nsURI="http://www.example.org/socialnetwork"
    nsPrefix="socialnetwork">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="SocialNetwork">
    <eStructuralFeatures xsi:type="ecore:EReference" name="users"
        eType="#//User" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="accounts"
        eType="#//Account" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="friendRequests"
        eType="#//FriendRequest" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pages"
        eType="#//Page" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="privileges"
        eType="#//Privilege" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- User class -->
  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="userID"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- 1-to-1 with Account -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="account"
        eType="#//Account" upperBound="1" lowerBound="1"
        eOpposite="#//Account/user"/>
  </eClassifiers>

  <!-- Account abstract class -->
  <eClassifiers xsi:type="ecore:EClass" name="Account" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accountNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="user"
        eType="#//User" upperBound="1" lowerBound="1"
        eOpposite="#//User/account"/>
  </eClassifiers>

  <!-- BusinessAccount class -->
  <eClassifiers xsi:type="ecore:EClass" name="BusinessAccount" eSuperTypes="#//Account">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- 1-to-many with AdvertisementPage -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advertisementPages"
        eType="#//AdvertisementPage" upperBound="-1"
        eOpposite="#//AdvertisementPage/businessAccount"/>
  </eClassifiers>

  <!-- PersonalAccount class -->
  <!-- Association with PersonalPage has an association class (Privilege),
       so both ends point to Privilege -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonalAccount" eSuperTypes="#//Account">
    <!-- administrator: PersonalAccount 1 to many PersonalPage (no association class) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="administratedPages"
        eType="#//PersonalPage" upperBound="-1"
        eOpposite="#//PersonalPage/administrator"/>
    <!-- Privilege association class end: PersonalAccount side -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="privileges"
        eType="#//Privilege" upperBound="-1"
        eOpposite="#//Privilege/personalAccount"/>
    <!-- FriendRequest as sender -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sentFriendRequests"
        eType="#//FriendRequest" upperBound="-1"
        eOpposite="#//FriendRequest/sender"/>
    <!-- FriendRequest as receiver -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="receivedFriendRequests"
        eType="#//FriendRequest" upperBound="-1"
        eOpposite="#//FriendRequest/receiver"/>
  </eClassifiers>

  <!-- FriendRequest class -->
  <eClassifiers xsi:type="ecore:EClass" name="FriendRequest">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sender"
        eType="#//PersonalAccount" upperBound="1" lowerBound="1"
        eOpposite="#//PersonalAccount/sentFriendRequests"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="receiver"
        eType="#//PersonalAccount" upperBound="1" lowerBound="1"
        eOpposite="#//PersonalAccount/receivedFriendRequests"/>
  </eClassifiers>

  <!-- Page abstract class -->
  <eClassifiers xsi:type="ecore:EClass" name="Page" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pageName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="visits"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- PersonalPage class -->
  <eClassifiers xsi:type="ecore:EClass" name="PersonalPage" eSuperTypes="#//Page">
    <!-- administrator relationship back to PersonalAccount -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="administrator"
        eType="#//PersonalAccount" upperBound="1"
        eOpposite="#//PersonalAccount/administratedPages"/>
    <!-- Privilege association class end: PersonalPage side -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="privileges"
        eType="#//Privilege" upperBound="-1"
        eOpposite="#//Privilege/personalPage"/>
  </eClassifiers>

  <!-- Privilege association class (between PersonalAccount and PersonalPage) -->
  <eClassifiers xsi:type="ecore:EClass" name="Privilege">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="typeOfPrivilege"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="personalAccount"
        eType="#//PersonalAccount" upperBound="1" lowerBound="1"
        eOpposite="#//PersonalAccount/privileges"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="personalPage"
        eType="#//PersonalPage" upperBound="1" lowerBound="1"
        eOpposite="#//PersonalPage/privileges"/>
  </eClassifiers>

  <!-- AdvertisementPage class -->
  <eClassifiers xsi:type="ecore:EClass" name="AdvertisementPage" eSuperTypes="#//Page">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bounceRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="clickThroughRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="conversionRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="businessAccount"
        eType="#//BusinessAccount" upperBound="1" lowerBound="1"
        eOpposite="#//BusinessAccount/advertisementPages"/>
  </eClassifiers>

</ecore:EPackage>
