@namespace(uri="http://www.example.org/socialnetwork", prefix="socialnetwork")
package socialnetwork;

class SocialNetwork {
	val User[*] users;
	val Account[*] accounts;
	val FriendRequest[*] friendRequests;
	val Page[*] pages;
	val Privilege[*] privileges;
}

class User {
	attr int userID;
	attr String name;
	attr String email;
	attr EDate birthDate;
	ref Account[1]#user account;
}

abstract class Account {
	attr int accountNumber;
	ref User[1]#account user;
}

class BusinessAccount extends Account {
	attr String companyName;
	ref AdvertisementPage[*]#businessAccount advertisementPages;
}

class PersonalAccount extends Account {
	ref Privilege[*]#administratorAccount administeredPages;
	ref Privilege[*]#memberAccount pagePrivileges;
	ref FriendRequest[*]#sender sentRequests;
	ref FriendRequest[*]#receiver receivedRequests;
}

class FriendRequest {
	ref PersonalAccount[1]#sentRequests sender;
	ref PersonalAccount[1]#receivedRequests receiver;
}

abstract class Page {
	attr String pageName;
	attr int visits;
}

class PersonalPage extends Page {
	ref Privilege[*]#administratorPage administratorPrivileges;
	ref Privilege[*]#memberPage memberPrivileges;
}

class Privilege {
	attr String typeOfPrivilege;
	ref PersonalAccount#administeredPages administratorAccount;
	ref PersonalPage#administratorPrivileges administratorPage;
	ref PersonalAccount#pagePrivileges memberAccount;
	ref PersonalPage#memberPrivileges memberPage;
}

class AdvertisementPage extends Page {
	attr double bounceRate;
	attr double clickThroughRate;
	attr double conversionRate;
	ref BusinessAccount[1]#advertisementPages businessAccount;
}


