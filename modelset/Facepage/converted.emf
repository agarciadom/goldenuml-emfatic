@namespace(uri="http://www.example.org/socialnetwork", prefix="socialnetwork")
package socialnetwork;

class User {
	attr int UserID;
	attr String Name;
	attr String Email;
	attr EDate BirthDate;
	val Account account;
}

abstract class Account {
	attr int AccountNumber;
}

class BusinessAccount extends Account {
	attr String CompanyName;
	val AdvertisementPage[*] advertisementPages;
}

class PersonalAccount extends Account {
	ref Privilege[*] privileges;
	ref FriendRequest[*]#sender sentRequests;
	ref FriendRequest[*]#receiver receivedRequests;
	ref PersonalPage[*]#administrator administeredPages;
}

class FriendRequest {
	ref PersonalAccount#sentRequests sender;
	ref PersonalAccount#receivedRequests receiver;
}

abstract class Page {
	attr String PageName;
	attr int Visits;
}

class PersonalPage extends Page {
	ref PersonalAccount#administeredPages administrator;
	ref Privilege[*] privileges;
}

class Privilege {
	attr String TypeOfPrivilege;
	ref PersonalAccount personalAccount;
	ref PersonalPage personalPage;
}

class AdvertisementPage extends Page {
	attr double BounceRate;
	attr double ClickThroughRate;
	attr double ConversionRate;
}


