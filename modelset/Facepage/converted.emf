@namespace(uri="http://www.example.org/socialnetwork", prefix="socialnetwork")
package socialnetwork;

class User {
	attr int userID;
	attr String name;
	attr String email;
	attr EDate birthDate;
	val Account[1] account;
}

abstract class Account {
	attr int accountNumber;
}

class BusinessAccount extends Account {
	attr String companyName;
	val AdvertisementPage[*] advertisementPages;
}

class PersonalAccount extends Account {
	ref PersonalPage[*] administeredPages;
	ref PersonalPage[*] personalPages;
	val FriendRequest[*] sentRequests;
	ref FriendRequest[*] receivedRequests;
}

class FriendRequest {
	ref PersonalAccount[1]#sentRequests sender;
	ref PersonalAccount[1]#receivedRequests receiver;
}

abstract class Page {
	attr String pageName;
	attr int visits;
}

class PersonalPage extends Page {
}

class Privilege {
	attr String typeOfPrivilege;
	ref PersonalAccount[1] personalAccount;
	ref PersonalPage[1] personalPage;
}

class AdvertisementPage extends Page {
	attr double bounceRate;
	attr double clickThroughRate;
	attr double conversionRate;
}


