@namespace(uri="http://www.facepage.com/metamodel", prefix="facepage")
package facepage;

class Facepage {
	val User[*] users;
	val Account[*] accounts;
}

class User {
	attr String[1] ~id;
	attr String[1] name;
	attr String[1] email;
	attr EDate[1] dateOfBirth;
	ref Account#owner account;
}

abstract class Account {
	id attr String[1] accountNumber;
	ref User[1]#account owner;
	val Page[*]#administrator pages;
}

class BusinessAccount extends Account {
	attr String[1] companyName;
	attr double[1] monthlyFee;
}

class PersonalAccount extends Account {
	op void sendFriendRequest(PersonalAccount target);
	op void receiveFriendRequest(FriendRequest request);
	val FriendRequest[*]#sender sentFriendRequests;
	ref FriendRequest[*]#receiver receivedFriendRequests;
	ref Page[*]#privilegedAccounts privilegedPages;
}

class FriendRequest {
	attr FriendRequestStatus[1] status;
	ref PersonalAccount[1]#sentFriendRequests sender;
	ref PersonalAccount[1]#receivedFriendRequests receiver;
}

enum FriendRequestStatus {
	PENDING = 0;
	ACCEPTED = 0;
	REJECTED = 0;
}

class Page {
	attr String[1] pageName;
	attr int[1] numberOfVisits;
	ref Account[1]#pages administrator;
	ref PersonalAccount[*]#privilegedPages privilegedAccounts;
}

class AdvertisementPage extends Page {
	attr double[1] bounceRate;
	attr double[1] clickThroughRate;
	attr double[1] conversionRate;
}


