<xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://schema.omg.org/spec/XMI/20131001"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns.ecore="http://www.eclipse.org/emf/2002/Ecore">
  <!-- Root container class -->
  <ecore:EPackage xmi:type=".ecore:EPackage" name="facepage"
                  nname="facepage" namespaceURI="facepage:///" 
                  xmlns="http://www.eclipse.org/emf/2002/Ecore">
    <eClassifiers>
      <!-- FacepageModel acts as the root container -->
      <eClass name="FacepageModel" xmi:type=".ecore:EClass">
        <eStructuralFeatures>
          <!-- Contains all users -->
          <eFeature name="users" eType=".facepage:User"
                    upper="-1" containment="true"/>
          <!-- Contains all accounts -->
          <eFeature name="accounts" eType=".facepage:Account"
                    upper="-1" containment="true"/>
          <!-- Contains all pages -->
          <eFeature name="pages" eType=".facepage:Page"
                    upper="-1" containment="true"/>
        </eStructuralFeatures>
      </eClass>

      <!-- User class -->
      <eClass name="User" xmi:type=".ecore:EClass">
        <eStructuralFeatures>
          <eFeature name="id" eType="ecore:EString" upper="1"/>
          <eFeature name="name" eType="ecore:EString" upper="1"/>
          <eFeature name="email" eType="ecore:EString" upper="1"/>
          <!-- Use EDate for date‑only values; if unavailable, use java.time.LocalDate -->
          <eFeature name="dateOfBirth"
                    eType="java.time.LocalDate" upper="1"/>
          <!-- One‑to‑one relationship with Account -->
          <eFeature name="account" eType=".facepage:Account" upper="1"/>
        </eStructuralFeatures>
      </eClass>

      <!-- Account class -->
      <eClass name="Account" xmi:type=".ecore:EClass">
        <eStructuralFeatures>
          <eFeature name="accountNumber"
                    eType="ecore:EString" upper="1"/>
          <eFeature name="type" eType=".facepage:AccountType"
                    upper="1"/>
          <!-- Business‑specific attribute (only for BUSINESS accounts) -->
          <eFeature name="companyName"
                    eType="ecore:EString" upper="1" containment="true"/>
          <!-- Pages created by this account -->
          <eFeature name="pages"
                    eType=".facepage:Page" upper="-1" containment="true"/>
        </eStructuralFeatures>

        <!-- Operations specific to personal accounts (friend request handling) -->
        <eOperations>
          <eOperation name="sendFriendRequest">
            <eParameters>
              <eParameter name="targetUser"
                          eType=".facepage:User" upper="1"/>
            </eParameters>
          </eOperation>
          <eOperation name="receiveFriendRequest">
            <eParameters>
              <eParameter name="sourceUser"
                          eType=".facepage:User" upper="1"/>
            </eParameters>
          </eOperation>
        </eOperations>
      </eClass>

      <!-- Enum for account types -->
      <eEnum name="AccountType" xmi:type=".ecore:EEnum">
        <eLiterals>
          <eLiteral name="PERSONAL"/>
          <eLiteral name="BUSINESS"/>
        </eLiterals>
      </eEnum>

      <!-- Page class (both personal and advertisement pages) -->
      <eClass name="Page" xmi:type=".ecore:EClass">
        <eStructuralFeatures>
          <eFeature name="name" eType="ecore:EString" upper="1"/>
          <eFeature name="visitCount"
                    eType="ecore:ELong" upper="1"/>
          <!-- Reference to the owning account -->
          <eFeature name="ownerAccount"
                    eType=".facepage:Account" upper="1"/>
          <!-- Specialization data for advertisement pages -->
          <eFeature name="advertisementData"
                    eType=".facepage:AdvertisementData"
                    upper="1" containment="true"/>
        </eStructuralFeatures>
      </eClass>

      <!-- Advertisement page additional metrics (percentage values) -->
      <eClass name="AdvertisementData" xmi:type=".ecore:EClass">
        <eStructuralFeatures>
          <eFeature name="bounceRate"
                    eType="ecore:EFloat" upper="1"/>
          <eFeature name="clickThroughRate"
                    eType="ecore:EFloat" upper="1"/>
          <eFeature name="conversionRate"
                    eType="ecore:EFloat" upper="1"/>
        </eStructuralFeatures>
      </eClass>
    </eClassifiers>
  </ecore:EPackage>
</xmi:XMI>
