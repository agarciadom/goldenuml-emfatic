<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.2"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">

    <eAnnotations>
        <eAnnotation source="http://www.eclipse.org/emf/2012/Ecore">
            <details key="originalFile">generated.ecore</details>
            <details key="packageUris">
                emfatic:Facepage - PackageURI for Facepage Ecore model
            </details>
        </eAnnotation>
    </eAnnotations>

    <!-- Define package URI -->
    <eClassifiers xsi:type="EPackage" xmi:id="_A" name="Facepage">

        <!-- RootContainer class -->
        <eClassifiers xsi:type="EClass" name="RootContainer"/>

        <!-- User class -->
        <eClassifiers xsi:type="EClass" name="User">
            <eStructuralFeatures xsi:type="EReference" eType="ecore:EDataType" name="id"/>
            <eStructuralFeatures xsi:type="EReference" eType="ecore:String" name="name"/>
            <eStructuralFeatures xsi:type="EReference" eType="ecore:String" name="email"/>
            <eStructuralFeatures xsi:type="EReference" eType="EDate" name="dateOfBirth"/>
        </eClassifiers>

        <!-- Account base class -->
        <eClassifiers xsi:type="EClass" name="Account">
            <eStructuralFeatures xsi:type="EReference" eType="ecore:EDataType" name="accountNumber"/>
        </eClassifiers>

        <!-- BusinessAccount specialization of Account -->
        <eClassifiers xsi:type="EClass" superTypes="_B" name="BusinessAccount">
            <eStructuralFeatures xsi:type="EReference" eType="ecore:String" name="companyName"/>
            <eStructuralFeatures xsi:type="EDouble" name="monthlyFee"/>
        </eClassifiers>

        <!-- PersonalAccount specialization of Account -->
        <eClassifiers xsi:type="EClass" superTypes="_B" name="PersonalAccount"/>

        <!-- Page class and specializations -->
        <eClassifiers xsi:type="EClass" name="Page">
            <eStructuralFeatures xsi:type="EReference" eType="ecore:String" name="pageName"/>
            <eStructuralFeatures xsi:type="EReference" eType="ecore:EInt" name="numberOfVisits"/>
        </eClassifiers>

        <!-- AdvertisementPage specialization -->
        <eClassifiers xsi:type="EClass" superTypes="_C" name="AdvertisementPage">
            <eStructuralFeatures xsi:type="EDouble" name="bounceRate"/>
            <eStructuralFeatures xsi:type="EDouble" name="clickThroughRate"/>
            <eStructuralFeatures xsi:type="EDouble" name="conversionRate"/>
        </eClassifiers>

        <!-- Define unique identifiers for super types (placeholder IDs) -->
        <eClassifiers xsi:type="EClass" xmi:id="_B" name="AccountBase"/>

        <eClassifiers xsi:type="EClass" xmi:id="_C" name="PageBase"/>

        <!-- Associations without incorrect eAnnotation usage -->

        <!-- User to Account relationship (UsersHoldingAccounts) -->
        <eStructuralFeatures xsi:type="EAssociation" name="usersHoldingAccounts">
            <EReferences>
                <EReference containment="true" xmi:id="_D"/>
                <EReference containment="false" xmi:id="_E"/>
            </EReferences>
        </eStructuralFeatures>

        <!-- Page to Account relationship (AccountsManagingPages) -->
        <eStructuralFeatures xsi:type="EAssociation" name="accountsManagingPages">
            <EReferences>
                <EReference containment="true" xmi:id="_F"/>
                <EReference containment="false" xmi:id="_G"/>
            </EReferences>
        </eStructuralFeatures>

    </eClassifiers>
</ecore:EPackage>
