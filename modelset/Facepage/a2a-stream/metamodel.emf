@namespace(uri="http://www.example.org/Facepage", prefix="p")
package Facepage;

class User {
  attr EString ID;
  attr EString name;
  attr EString email;
  attr EDate dateOfBirth;
  ref Account account;
}
class Account {
  attr EInt accountNumber;
  attr AccountType type;
  ref User user;
  val Page[*] pages;
}
class BusinessAccount extends Account {
  attr EString companyName;
  attr EFloat monthlyFee;
}
class PersonalAccount extends Account {
  val PersonalAccount[*] friends;
  val Page[*] privileges;
}
class Page {
  attr EString pageName;
  attr EInt numberOfVisits;
  ref Account administrator;
}
class AdvertisementPage extends Page {
  attr EFloat bounceRate;
  attr EFloat clickThroughRate;
  attr EFloat conversionRate;
  ref BusinessAccount creator;
}
class AccountType {
}