<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Facepage" nsURI="http://www.facepage.com/emf" nsPrefix="fp">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="account" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Account">
      <eStructuralFeatures>
        <eAttribute name="accountNumber" lowerBound="1" upperBound="1" eType="//ELong" />
        <eReference name="pages" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PersonalAccount" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="friends" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="privilegedPages" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessAccount" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="companyName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="monthlyFee" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Page">
      <eStructuralFeatures>
        <eAttribute name="pageName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="numberOfVisits" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="administrator" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdvertisementPage" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="bounceRate" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="clickThroughRate" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="conversionRate" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
