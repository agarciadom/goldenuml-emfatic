@namespace(uri="http://www.facepage.com/emf", prefix="fp")
package Facepage;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EString[1] email;
	attr ecore.EDate[1] dateOfBirth;
	val Account[1] account;
}

class Account {
	attr ecore.ELong[1] accountNumber;
	val Page[*] pages;
}

class PersonalAccount extends Account {
	ref PersonalAccount[*] friends;
	ref Page[*] privilegedPages;
}

class BusinessAccount extends Account {
	attr ecore.EString[1] companyName;
	attr ecore.EBigDecimal[1] monthlyFee;
}

class Page {
	attr ecore.EString[1] pageName;
	attr ecore.EInt numberOfVisits;
	ref Account[1] administrator;
}

class AdvertisementPage extends Page {
	attr ecore.EDouble bounceRate;
	attr ecore.EDouble clickThroughRate;
	attr ecore.EDouble conversionRate;
}


