@namespace(uri="http://www.facepage.org/model", prefix="facepage")
package Facepage;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] ~id;
	attr ecore.EString name;
	attr ecore.EString email;
	attr ecore.EDate dateOfBirth;
	ref Account account;
}

class Account {
	attr ecore.EString[1] accountNumber;
	val User[1] user;
	val Page[*] pages;
}

class Page {
	ref Account[1] owningAccount;
	attr ecore.EString[1] name;
	attr ecore.EInt visitCount;
}

class BusinessAccount extends Account {
	attr ecore.EString companyName;
	attr ecore.EDouble monthlyFee;
}

class PersonalAccount extends Account {
	ref Page[*] privilegedPages;
}

class AdvertisementPage extends Page {
	attr ecore.EDouble bounceRate;
	attr ecore.EDouble clickThroughRate;
	attr ecore.EDouble conversionRate;
}


