<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Facepage" nsURI="http://www.facepage.org/model" nsPrefix="facepage">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="account" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Account">
      <eStructuralFeatures>
        <eAttribute name="accountNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="user" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="pages" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Page">
      <eStructuralFeatures>
        <eReference name="owningAccount" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="visitCount" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessAccount" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="companyName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="monthlyFee" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PersonalAccount" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="privilegedPages" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdvertisementPage" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="bounceRate" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="clickThroughRate" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="conversionRate" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
