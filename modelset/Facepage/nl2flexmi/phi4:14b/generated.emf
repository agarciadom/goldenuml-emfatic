@namespace(uri="http://example.org/facepage", prefix="fp")
package Facepage;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] ID;
	attr ecore.EString[1] Name;
	attr ecore.EString[1] Email;
	attr ecore.EDate[1] DateOfBirth;
	ref Account[*] Accounts;
}

class Account {
	attr ecore.EString[1] AccountNumber;
	ref Page[*] Pages;
}

class PersonalAccount extends Account {
	ref PersonalAccount[*] Friends;
	ref PersonalAccount[*] FriendRequestsReceived;
	ref Page[*] PrivilegedPages;
}

class BusinessAccount extends Account {
	attr ecore.EString[1] CompanyName;
	ref AdvertisementPage[*] AdPages;
}

class Page {
	attr ecore.EString[1] PageName;
	attr ecore.EInt[1] NumberOfVisits;
}

class AdvertisementPage extends Page {
	attr ecore.EDouble[1] BounceRate;
	attr ecore.EDouble[1] ClickThroughRate;
	attr ecore.EDouble[1] ConversionRate;
}

class FacepageSystem {
	val User[*] Users;
}


