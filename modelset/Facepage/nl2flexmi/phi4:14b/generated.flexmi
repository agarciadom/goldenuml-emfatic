<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Facepage" nsURI="http://example.org/facepage" nsPrefix="fp">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="ID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="Name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="Email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="DateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="Accounts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Account">
      <eStructuralFeatures>
        <eAttribute name="AccountNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="Pages" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PersonalAccount" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="Friends" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="FriendRequestsReceived" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="PrivilegedPages" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessAccount" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="CompanyName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="AdPages" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Page">
      <eStructuralFeatures>
        <eAttribute name="PageName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="NumberOfVisits" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdvertisementPage" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="BounceRate" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="ClickThroughRate" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="ConversionRate" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FacepageSystem">
      <eStructuralFeatures>
        <eReference name="Users" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
