@namespace(uri="http://www.homeTec.de/ehome", prefix="p")
package EHome;

class Sensor {
  attr String vendorId;
  attr String description;
  attr UnitType unit;
  val Room room;
  val MeasuredValue[*] measuredValues;
  val Threshold[*] thresholds;
  attr void getLastMeasuredValue;
}
class TemperatureSensor extends Sensor {
  attr Float minValue;
  attr Float maxValue;
}
class PowerSensor extends Sensor {
  attr Float powerConsumption;
}
class Room {
  attr String description;
}
class Apartment {
  attr String address;
  val Room[*] rooms;
}
class Inhabitant {
  attr String username;
  attr String password;
  attr String email;
  attr Boolean isAdmin;
}
class Controller {
  val Inhabitant[*] inhabitants;
  val Sensor[*] sensors;
  val Apartment apartment;
  ref EMonitor emonitor;
}
class MeasuredValue {
  attr EDate timestamp;
  attr Float value;
}
class Threshold {
  attr Float value;
}
class EMonitor {
  attr void checkThresholds;
}