@namespace(uri="https://homtec.de/ehome2020", prefix="ehome")
package EHome2020;

import "http://www.eclipse.org/emf/2002/Ecore";

datatype UnitType : java.lang.String;

class Room {
	attr ecore.EString[1] description;
	val Sensor[*] sensors;
}

class Sensor {
	attr ecore.EString[1] vendorId;
	attr ecore.EString[1] description;
	attr UnitType[1] unit;
	ref Room[1] room;
	val Value[*] values;
}

class Value {
	attr ecore.EDate[1] timestamp;
	attr ecore.EDouble[1] value;
}

class Inhabitant {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
	attr ecore.EString email;
	attr ecore.EBoolean[1] isAdmin;
}

class Apartment {
	attr ecore.EString[1] address;
	val Room[2..*] rooms;
	val Inhabitant[*] inhabitants;
}

class SensorController {
	val Sensor[*] sensors;
	ref Inhabitant[*] inhabitants;
}

class EMonitor {
	ref SensorController[1] sensorController;
}

class TemperatureSensor extends Sensor {
	attr ecore.EFloat minValue;
	attr ecore.EFloat maxValue;
}

class PowerSensor extends Sensor {
	attr ecore.EFloat[1] totalPowerConsumption;
}


