<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EHome2020" nsURI="https://homtec.de/ehome2020" nsPrefix="ehome">
  <eClassifiers>
    <eDataType name="UnitType" instanceClassName="java.lang.String" />
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="sensors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor">
      <eStructuralFeatures>
        <eAttribute name="vendorId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="unit" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="room" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="values" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Value">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="isAdmin" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Apartment">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="2" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="inhabitants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SensorController">
      <eStructuralFeatures>
        <eReference name="sensors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="inhabitants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EMonitor">
      <eStructuralFeatures>
        <eReference name="sensorController" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TemperatureSensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="minValue" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eAttribute name="maxValue" lowerBound="0" upperBound="1" eType="//EFloat" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PowerSensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="totalPowerConsumption" lowerBound="1" upperBound="1" eType="//EFloat" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
