<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EHome2020" nsURI="http://www.example.org/EHome2020" nsPrefix="ehome">
  <eClassifiers>
    <eClass name="SensorController">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="eMonitor" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Apartment">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="inhabitants" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="rooms" containment="True" lowerBound="2" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isAdmin" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="sensors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="vendorId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="unit" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="room" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="measuredValues" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="lastValue" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TemperatureSensor" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eReference name="base_Sensor" containment="False" lowerBound="1" upperBound="1" />
        <eAttribute name="minValue" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="maxValue" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PowerSensor" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eReference name="base_Sensor" containment="False" lowerBound="1" upperBound="1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MeasuredValue">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EMonitor">
      <eStructuralFeatures />
    </eClass>
    <eDataType name="Unit" instanceClassName="java.lang.String" />
  </eClassifiers>
</ePackage>
