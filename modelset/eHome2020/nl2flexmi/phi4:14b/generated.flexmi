<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EHome2020" nsURI="http://www.example.org/EHome2020.ecore" nsPrefix="eh20">
  <eClassifiers>
    <eClass name="Apartment">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="2" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="inhabitants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor">
      <eStructuralFeatures>
        <eReference name="room" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="vendorId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="unit" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TemperatureSensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="validMin" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="validMax" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PowerSensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="counterReading" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SensorValue">
      <eStructuralFeatures>
        <eReference name="sensor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SensorController">
      <eStructuralFeatures>
        <eReference name="apartment" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="sensors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EMonitor">
      <eStructuralFeatures>
        <eReference name="sensorController" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
