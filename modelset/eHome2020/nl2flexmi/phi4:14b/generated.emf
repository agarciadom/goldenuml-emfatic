@namespace(uri="http://www.example.org/EHome2020.ecore", prefix="eh20")
package EHome2020;

import "http://www.eclipse.org/emf/2002/Ecore";

class Apartment {
	attr ecore.EString[1] address;
	val Room[2..*] rooms;
	val Inhabitant[*] inhabitants;
}

class Room {
	attr ecore.EString[1] description;
}

class Sensor {
	val Room[1] room;
	attr ecore.EString[1] vendorId;
	attr ecore.EString[1] description;
	attr ecore.EString[1] unit;
}

class TemperatureSensor extends Sensor {
	attr ecore.EDouble[1] validMin;
	attr ecore.EDouble[1] validMax;
}

class PowerSensor extends Sensor {
	attr ecore.EDouble[1] counterReading;
}

class Inhabitant {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}

class SensorValue {
	ref Sensor[1] sensor;
	attr ecore.EDate[1] timestamp;
	attr ecore.EDouble[1] value;
}

class SensorController {
	ref Apartment[1] apartment;
	val Sensor[*] sensors;
}

class EMonitor {
	ref SensorController sensorController;
}


