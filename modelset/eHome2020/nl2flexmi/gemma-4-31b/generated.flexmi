<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EHome2020" nsURI="http://www.example.org/ehome2020" nsPrefix="ehome">
  <eClassifiers>
    <eClass name="SensorController">
      <eStructuralFeatures>
        <eReference name="apartment" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="inhabitants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Apartment">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="2" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isAdmin" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="apartment" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="sensors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor">
      <eStructuralFeatures>
        <eAttribute name="vendorId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="unit" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="values" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="threshold" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TemperatureSensor" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="minRange" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="maxRange" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PowerSensor" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="totalConsumption" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Value">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="val" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Threshold">
      <eStructuralFeatures>
        <eAttribute name="thresholdValue" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
