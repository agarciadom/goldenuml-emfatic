@namespace(uri="http://www.example.org/ehome2020", prefix="ehome")
package EHome2020;

import "http://www.eclipse.org/emf/2002/Ecore";

class SensorController {
	val Apartment[1] apartment;
	val Inhabitant[*] inhabitants;
}

class Apartment {
	attr ecore.EString[1] address;
	attr ecore.EString emailAddress;
	val Room[2..*] rooms;
}

class Inhabitant {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
	attr ecore.EBoolean[1] isAdmin;
	ref Apartment[1] apartment;
}

class Room {
	attr ecore.EString[1] description;
	val Sensor[*] sensors;
}

class Sensor {
	attr ecore.EString[1] vendorId;
	attr ecore.EString[1] description;
	attr ecore.EString[1] unit;
	val Value[*] values;
	val Threshold threshold;
}

class TemperatureSensor extends Sensor {
	attr ecore.EDouble[1] minRange;
	attr ecore.EDouble[1] maxRange;
}

class PowerSensor extends Sensor {
	attr ecore.EDouble[1] totalConsumption;
}

class Value {
	attr ecore.EDate[1] timestamp;
	attr ecore.EDouble[1] ~val;
}

class Threshold {
	attr ecore.EDouble[1] thresholdValue;
}


