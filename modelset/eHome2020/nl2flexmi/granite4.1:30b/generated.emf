@namespace(uri="http://www.example.com/EHome2020", prefix="eh")
package EHome2020;

import "http://www.eclipse.org/emf/2002/Ecore";

class Apartment {
	val Room[2..*] rooms;
	attr String contactEmail;
	attr ecore.EString address;
}

class Room extends Apartment {
	val Sensor[*] sensors;
	attr String description;
}

class Sensor extends Room {
	ref Room[1] room;
	val MeasurementValue[*] measurements;
	attr String[1] vendorId;
	attr String unit;
}

class TemperatureSensor extends Sensor {
	attr ecore.EDouble minValue;
	attr ecore.EDouble maxValue;
}

class PowerSensor extends Sensor {
	attr ecore.ELong totalConsumption;
}

class User extends Apartment {
	ref Apartment[1] apartment;
	val Threshold[*] thresholds;
	attr String[1] username;
	attr String password;
	attr Boolean isAdmin;
}

class Threshold extends User {
	ref Sensor[1] sensor;
	attr ecore.EDouble thresholdValue;
	attr Double[1] value;
}

class EmailAddress {
	attr ecore.EString email;
}

class MeasurementValue extends Sensor {
	ref Sensor[1] sensor;
	attr Date[1] timestamp;
	attr Double[1] value;
}

datatype String : java.lang.String;

datatype Boolean : java.lang.Boolean;

datatype Double : java.lang.Double;

datatype Date : java.util.Date;


