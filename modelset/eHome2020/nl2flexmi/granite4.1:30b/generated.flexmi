<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EHome2020" nsURI="http://www.example.com/EHome2020" nsPrefix="eh">
  <eClassifiers>
    <eClass name="Apartment">
      <eStructuralFeatures>
        <eReference name="rooms" containment="True" lowerBound="2" upperBound="-1" eType="//@eClassifiers.1" />
        <eAttribute name="contactEmail" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="sensors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="room" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="measurements" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
        <eAttribute name="vendorId" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="unit" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TemperatureSensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="minValue" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="maxValue" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PowerSensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="totalConsumption" lowerBound="0" upperBound="1" eType="//ELong" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="apartment" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="thresholds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="password" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="isAdmin" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Threshold" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eReference name="sensor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="thresholdValue" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EmailAddress">
      <eStructuralFeatures>
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MeasurementValue" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eReference name="sensor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//@eClassifiers.12" />
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Boolean" instanceClassName="java.lang.Boolean" />
    <eDataType name="Double" instanceClassName="java.lang.Double" />
    <eDataType name="Date" instanceClassName="java.util.Date" />
  </eClassifiers>
</ePackage>
