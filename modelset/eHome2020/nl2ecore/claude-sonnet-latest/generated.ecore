<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="ehome2020"
    nsURI="http://www.ehome2020.org/metamodel"
    nsPrefix="ehome2020">

  <!-- Custom datatype for timestamps using Java's Instant -->
  <eClassifiers xsi:type="ecore:EDataType" name="EInstant"
      instanceClassName="java.time.Instant"/>

  <!-- Enum for sensor units -->
  <eClassifiers xsi:type="ecore:EEnum" name="Unit">
    <eLiterals name="CELSIUS" value="0"/>
    <eLiterals name="WATT" value="1"/>
  </eClassifiers>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="EHomeSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensorController"
        eType="#//SensorController" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="eMonitor"
        eType="#//EMonitor" containment="true"/>
  </eClassifiers>

  <!-- SensorController -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorController">
    <eStructuralFeatures xsi:type="ecore:EReference" name="apartment"
        eType="#//Apartment" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensors"
        upperBound="-1" eType="#//Sensor" containment="true"/>
    <eOperations name="login" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eParameters name="username" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="password" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="querySensorValue" eType="#//MeasuredValue">
      <eParameters name="sensor" eType="#//Sensor"/>
    </eOperations>
    <eOperations name="setThreshold">
      <eParameters name="sensor" eType="#//Sensor"/>
      <eParameters name="threshold" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eOperations>
    <eOperations name="sendAlertMessage">
      <eParameters name="sensor" eType="#//Sensor"/>
    </eOperations>
  </eClassifiers>

  <!-- Apartment -->
  <eClassifiers xsi:type="ecore:EClass" name="Apartment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="emailAddress"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms"
        lowerBound="2" upperBound="-1" eType="#//Room" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inhabitants"
        upperBound="-1" eType="#//Inhabitant" containment="true"/>
  </eClassifiers>

  <!-- Room -->
  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensors"
        upperBound="-1" eType="#//Sensor" eOpposite="#//Sensor/room"/>
  </eClassifiers>

  <!-- Inhabitant -->
  <eClassifiers xsi:type="ecore:EClass" name="Inhabitant">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="password"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hasAdminRights"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eOperations name="querySensorValues" upperBound="-1" eType="#//MeasuredValue">
      <eParameters name="sensor" eType="#//Sensor"/>
    </eOperations>
    <eOperations name="queryLastValue" eType="#//MeasuredValue">
      <eParameters name="sensor" eType="#//Sensor"/>
    </eOperations>
    <eOperations name="setThreshold">
      <eParameters name="sensor" eType="#//Sensor"/>
      <eParameters name="threshold" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eOperations>
    <eOperations name="assignSensorToRoom">
      <eParameters name="sensor" eType="#//Sensor"/>
      <eParameters name="room" eType="#//Room"/>
    </eOperations>
    <eOperations name="changeSensorDescription">
      <eParameters name="sensor" eType="#//Sensor"/>
      <eParameters name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- Abstract Sensor -->
  <eClassifiers xsi:type="ecore:EClass" name="Sensor" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vendorId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unit"
        eType="#//Unit"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="threshold"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="room"
        eType="#//Room" eOpposite="#//Room/sensors"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="measuredValues"
        upperBound="-1" eType="#//MeasuredValue" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lastValue"
        eType="#//MeasuredValue"/>
  </eClassifiers>

  <!-- TemperatureSensor -->
  <eClassifiers xsi:type="ecore:EClass" name="TemperatureSensor" eSuperTypes="#//Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minValue"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxValue"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- PowerSensor -->
  <eClassifiers xsi:type="ecore:EClass" name="PowerSensor" eSuperTypes="#//Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="counterReading"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- MeasuredValue -->
  <eClassifiers xsi:type="ecore:EClass" name="MeasuredValue">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- EMonitor external system -->
  <eClassifiers xsi:type="ecore:EClass" name="EMonitor">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensorController"
        eType="#//SensorController"/>
    <eOperations name="checkThresholds"/>
    <eOperations name="sendAlertMessage">
      <eParameters name="sensor" eType="#//Sensor"/>
      <eParameters name="emailAddress" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

</ecore:EPackage>
