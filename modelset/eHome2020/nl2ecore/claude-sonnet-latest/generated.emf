@namespace(uri="http://www.ehome2020.org/metamodel", prefix="ehome2020")
package ehome2020;

datatype EInstant : java.time.Instant;

enum Unit {
	CELSIUS = 0;
	WATT = 1;
}

class EHomeSystem {
	val SensorController sensorController;
	val EMonitor eMonitor;
}

class SensorController {
	op boolean login(String username, String password);
	op MeasuredValue querySensorValue(Sensor sensor);
	op void setThreshold(Sensor sensor, double threshold);
	op void sendAlertMessage(Sensor sensor);
	val Apartment apartment;
	val Sensor[*] sensors;
}

class Apartment {
	attr String address;
	attr String emailAddress;
	val Room[2..*] rooms;
	val Inhabitant[*] inhabitants;
}

class Room {
	attr String description;
	ref Sensor[*]#room sensors;
}

class Inhabitant {
	op MeasuredValue[*] querySensorValues(Sensor sensor);
	op MeasuredValue queryLastValue(Sensor sensor);
	op void setThreshold(Sensor sensor, double threshold);
	op void assignSensorToRoom(Sensor sensor, Room room);
	op void changeSensorDescription(Sensor sensor, String description);
	attr String username;
	attr String password;
	attr boolean hasAdminRights;
}

abstract class Sensor {
	attr String vendorId;
	attr String description;
	attr Unit unit;
	attr Double threshold;
	ref Room#sensors room;
	val MeasuredValue[*] measuredValues;
	ref MeasuredValue lastValue;
}

class TemperatureSensor extends Sensor {
	attr double minValue;
	attr double maxValue;
}

class PowerSensor extends Sensor {
	attr double counterReading;
}

class MeasuredValue {
	attr EDate timestamp;
	attr double value;
}

class EMonitor {
	op void checkThresholds();
	op void sendAlertMessage(Sensor sensor, String emailAddress);
	ref SensorController sensorController;
}


