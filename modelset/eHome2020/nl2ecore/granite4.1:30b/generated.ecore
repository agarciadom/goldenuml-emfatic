<model xmlns="http://www.eclipse.org/emf/2003/Ecore#" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <eClassifiers xsi:type="ecore:EClass" name="EHome2020Model">
    <eStructuralFeatures xsi:type="ecore:EReference" name="apartments" eType="#//Apartment" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensorControllers" eType="#//SensorController" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Apartment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms" eType="#//Room" containment="true" lowerBound="2"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensors" eType="#//Sensor" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SensorController">
    <eStructuralFeatures xsi:type="ecore:EReference" name="apartmentInfo" eType="#//ApartmentInfo" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="users" eType="#//User" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ApartmentInfo">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="emailAddress" eType="ecore:EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username" eType="ecore:EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="password" eType="ecore:EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="thresholds" eType="#//Threshold" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roomsToAdminister" eType="#//Room" upperBound="-1"/>
  </eClassifiers>

  <!-- Administrative rights are modeled by associating Users with Rooms they can configure -->
  <eClassifiers xsi:type="ecore:EClass" name="Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vendorId" eType="ecore:EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="room" eType="#//Room"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unit" eType="#//Unit"/>
    <!-- Operations are placed inside an eOperations container element -->
    <eOperations>
      <eOperation name="queryCurrentValue" returnType="float"/>
    </eOperations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="TemperatureSensor" eSuperTypes="#//Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minValue" eType="ecore:EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxValue" eType="ecore:EDouble"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PowerSensor" eSuperTypes="#//Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalConsumption" eType="ecore:ELong"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Threshold">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensor" eType="#//Sensor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDouble"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Measurement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensor" eType="#//Sensor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp" eType="#//LocalDateTime"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDouble"/>
  </eClassifiers>

  <!-- Custom datatype for LocalDateTime -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalDateTime" instanceClassName="java.time.LocalDateTime"/>

  <eClassifiers xsi:type="ecore:EEnum" name="Unit">
    <eLiterals>
      <eLiteral name="CELSIUS"/>
      <eLiteral name="WATT"/>
    </eLiterals>
  </eClassifiers>
</model>
