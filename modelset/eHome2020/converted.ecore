<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="smartHome"
    nsURI="http://www.example.org/smartHome"
    nsPrefix="smartHome">

  <!-- Enum: Unit -->
  <eClassifiers xsi:type="ecore:EEnum" name="Unit">
    <eLiterals name="CELSIUS"/>
    <eLiterals name="WATT" value="1"/>
  </eClassifiers>

  <!-- Class: Measurement -->
  <eClassifiers xsi:type="ecore:EClass" name="Measurement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELongObject"/>
  </eClassifiers>

  <!-- Class: Sensor (abstract base) -->
  <eClassifiers xsi:type="ecore:EClass" name="Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="threshold" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
    <!-- Sensor "1" -> "*" Measurement -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="measurements"
        upperBound="-1"
        eType="#//Measurement"
        containment="true"/>
    <!-- Sensor "1" -> "1" Measurement : lastValue -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="lastValue"
        lowerBound="1"
        eType="#//Measurement"/>
    <!-- Sensor "1" -> "1" Unit -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unit"
        lowerBound="1"
        eType="#//Unit"/>
  </eClassifiers>

  <!-- Class: TemperatureSensor extends Sensor -->
  <eClassifiers xsi:type="ecore:EClass" name="TemperatureSensor" eSuperTypes="#//Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="min" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="max" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
  </eClassifiers>

  <!-- Class: PowerMeter extends Sensor -->
  <eClassifiers xsi:type="ecore:EClass" name="PowerMeter" eSuperTypes="#//Sensor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalConsumption" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDoubleObject"/>
  </eClassifiers>

  <!-- Class: Room -->
  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class: Apartment -->
  <eClassifiers xsi:type="ecore:EClass" name="Apartment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Room "2..*" *- "1" Apartment: Apartment contains Rooms -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms"
        lowerBound="2"
        upperBound="-1"
        eType="#//Room"
        containment="true"/>
    <!-- Apartment "1" -> "*" Resident -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="residents"
        upperBound="-1"
        eType="#//Resident"
        containment="true"/>
    <!-- Apartment "1" -> "*" Sensor -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensors"
        upperBound="-1"
        eType="#//Sensor"
        containment="true"/>
  </eClassifiers>

  <!-- Class: Resident -->
  <eClassifiers xsi:type="ecore:EClass" name="Resident">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="username" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="password" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isAdmin" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBooleanObject"/>
  </eClassifiers>

  <!-- Class: SensorController -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorController">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- SensorController "1" -> "0..1" Sensor -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="sensor"
        eType="#//Sensor"/>
    <!-- SensorController "1" -> "1" Room -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="room"
        lowerBound="1"
        eType="#//Room"/>
  </eClassifiers>

</ecore:EPackage>
