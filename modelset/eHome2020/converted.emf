@namespace(uri="http://www.example.org/smartHome", prefix="smartHome")
package smartHome;

enum Unit {
	CELSIUS = 0;
	WATT = 1;
}

class Measurement {
	attr Double value;
	attr Long timestamp;
}

class Sensor {
	attr Integer ~id;
	attr String description;
	attr Double threshold;
	val Measurement[*] measurements;
	ref Measurement[1] lastValue;
	attr Unit[1] unit;
}

class TemperatureSensor extends Sensor {
	attr Double min;
	attr Double max;
}

class PowerMeter extends Sensor {
	attr Double totalConsumption;
}

class Room {
	attr String label;
}

class Apartment {
	attr String address;
	attr String email;
	val Room[2..*] rooms;
	val Resident[*] residents;
	val Sensor[*] sensors;
}

class Resident {
	attr String username;
	attr String password;
	attr Boolean isAdmin;
}

class SensorController {
	attr String ~id;
	ref Sensor sensor;
	ref Room[1] room;
}


