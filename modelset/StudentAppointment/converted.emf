@namespace(uri="http://www.example.org/tutoring", prefix="tutoring")
package tutoring;

class TutoringSystem {
	val Student[*] students;
	val Course[*] courses;
	val Assistant[*] assistants;
	val CourseSubscription[*] courseSubscriptions;
	val TeachingAssistant[*] teachingAssistants;
	val Appointment[*] appointments;
}

class Student {
	ref CourseSubscription[*]#student courseSubscriptions;
}

class Course {
	ref CourseSubscription[*]#course courseSubscriptions;
	ref TeachingAssistant[*]#course teachingAssistants;
}

class Assistant {
	ref TeachingAssistant[*]#assistant teachingAssistants;
}

class CourseSubscription {
	ref Student[1]#courseSubscriptions student;
	ref Course[1]#courseSubscriptions course;
	ref Appointment[*]#courseSubscription appointments;
}

class TeachingAssistant {
	ref Course[1]#teachingAssistants course;
	ref Assistant[1]#teachingAssistants assistant;
	ref Appointment[*]#teachingAssistant appointments;
}

class Appointment {
	ref CourseSubscription[1]#appointments courseSubscription;
	ref TeachingAssistant[1]#appointments teachingAssistant;
}


