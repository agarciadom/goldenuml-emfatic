@namespace(uri="http://www.example.org/appointmentSystem", prefix="appointmentSystem")
package appointmentSystem;

class AppointmentSystem {
	val Student[*] students;
	val TeachingAssistant[*] teachingAssistants;
	val Course[*] courses;
	val Appointment[*] appointments;
}

abstract class Person {
	attr String name;
	attr String email;
}

class Student extends Person {
	attr String studentId;
	ref Course[*]#registeredStudents registeredCourses;
	ref Appointment[*]#students appointments;
}

class TeachingAssistant extends Person {
	attr String assistantId;
	ref Course[*]#teachingAssistants teachingCourses;
	ref Appointment[*]#teachingAssistant appointments;
}

class Course {
	attr String courseId;
	attr String courseName;
	ref Student[*]#registeredCourses registeredStudents;
	ref TeachingAssistant[*]#teachingCourses teachingAssistants;
	ref Appointment[*]#course appointments;
}

class Appointment {
	attr EDate scheduledDate;
	attr LocalTime startTime;
	attr LocalTime endTime;
	attr String location;
	ref Course#appointments course;
	ref TeachingAssistant#appointments teachingAssistant;
	ref Student[*]#appointments students;
}

datatype LocalTime : java.time.LocalTime;


