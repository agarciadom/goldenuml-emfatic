<xmi:XMI xmlns:xmi="http://schema.omg.org/spec/XMI/2.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
         xsi:schemaLocation="http://www.eclipse.org/emf/2002/Ecore http://www.eclipse.org/emf/2002/Ecore.ecore.xsd">
  
  <!-- Root container that aggregates all model elements -->
  <ecore:EClass xmi:id="1" name="SystemRoot"
                eSuperTypes="http://www.eclipse.org/emf/2002/Ecore#EObject">
    <ecore:eStructuralFeatures>
      <!-- Containment reference for any model element (Any serves as a wildcard type) -->
      <ecore:EReference xmi:id="11" name="elements"
                        ordered="true" unique="false" upper="-1"
                        eType="#/3"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Base class for any identifiable entity -->
  <ecore:EClass xmi:id="2" name="Identifiable"
                abstract="true" eSuperTypes="http://www.eclipse.org/emf/2002/Ecore#EObject">
    <ecore:eStructuralFeatures>
      <ecore:EAttribute xmi:id="21" name="id"
                        eType="http://www.eclipse.org/emf/2003/xsd/EString#//EString"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Person serves as the common supertype for Student and TeachingAssistant -->
  <ecore:EClass xmi:id="3" name="Person"
                abstract="true" eSuperTypes="#2">
    <ecore:eStructuralFeatures>
      <ecore:EAttribute xmi:id="31" name="name"
                        eType="http://www.eclipse.org/emf/2003/xsd/EString#//EString"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Student represents a registered learner -->
  <ecore:EClass xmi:id="4" name="Student"
                eSuperTypes="#3">
    <ecore:eStructuralFeatures>
      <!-- Registrations link a student to the courses they are enrolled in (many‑to‑many via Registration) -->
      <ecore:EReference xmi:id="41" name="registrations"
                        ordered="true" unique="false" upper="-1"
                        eType="#/7" containment="true"/>
      
      <!-- Appointments that the student has requested (many‑to‑many via Appointment) -->
      <ecore:EReference xmi:id="42" name="appointments"
                        ordered="true" unique="false" upper="-1"
                        eType="#/10" containment="true"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- TeachingAssistant represents a staff member who can give help -->
  <ecore:EClass xmi:id="5" name="TeachingAssistant"
                eSuperTypes="#3">
    <ecore:eStructuralFeatures>
      <!-- TaAssignments indicate which courses the TA is responsible for (many‑to‑many via TaAssignment) -->
      <ecore:EReference xmi:id="51" name="taAssignments"
                        ordered="true" unique="false" upper="-1"
                        eType="#/8" containment="true"/>
      
      <!-- Appointments that the TA has provided (many‑to‑many via Appointment) -->
      <ecore:EReference xmi:id="52" name="appointments"
                        ordered="true" unique="false" upper="-1"
                        eType="#/10" containment="true"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Course represents an offering that students can enroll in and TAs can teach -->
  <ecore:EClass xmi:id="6" name="Course"
                eSuperTypes="#2">
    <ecore:eStructuralFeatures>
      <ecore:EAttribute xmi:id="61" name="title"
                        eType="http://www.eclipse.org/emf/2003/xsd/EString#//EString"/>
      
      <!-- Registrations linking students to this course (opposite side in Registration) -->
      <ecore:EReference xmi:id="62" name="registrations"
                        ordered="true" unique="false" upper="-1"
                        eType="#/7"
                        eOpposite="#/7_course"/>
      
      <!-- TaAssignments linking TAs to this course (opposite side in TaAssignment) -->
      <ecore:EReference xmi:id="63" name="taAssignments"
                        ordered="true" unique="false" upper="-1"
                        eType="#/8"
                        eOpposite="#/8_course"/>
      
      <!-- Appointments scheduled for this course (opposite side in Appointment) -->
      <ecore:EReference xmi:id="64" name="appointments"
                        ordered="true" unique="false" upper="-1"
                        eType="#/10"
                        eOpposite="#/10_course"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Registration associates a Student with a Course (many‑to‑many) -->
  <ecore:EClass xmi:id="7" name="Registration"
                eSuperTypes="http://www.eclipse.org/emf/2002/Ecore#EObject">
    <ecore:eStructuralFeatures>
      <ecore:EReference xmi:id="71" name="student"
                        lower="1" upper="1"
                        eType="#/4"
                        eOpposite="#/41"/>
      
      <ecore:EReference xmi:id="72" name="course"
                        lower="1" upper="1"
                        eType="#/6"
                        eOpposite="#/62"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- TaAssignment associates a TeachingAssistant with a Course (many‑to‑many) -->
  <ecore:EClass xmi:id="8" name="TaAssignment"
                eSuperTypes="http://www.eclipse.org/emf/2002/Ecore#EObject">
    <ecore:eStructuralFeatures>
      <ecore:EReference xmi:id="81" name="ta"
                        lower="1" upper="1"
                        eType="#/5"
                        eOpposite="#/51"/>
      
      <ecore:EReference xmi:id="82" name="course"
                        lower="1" upper="1"
                        eType="#/6"
                        eOpposite="#/63"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Appointment ties together a Student, a TeachingAssistant and a Course,
       with a specific time (using java.time.LocalTime) -->
  <ecore:EClass xmi:id="10" name="Appointment"
                eSuperTypes="http://www.eclipse.org/emf/2002/Ecore#EObject">
    <ecore:eStructuralFeatures>
      <ecore:EReference xmi:id="101" name="student"
                        lower="1" upper="1"
                        eType="#/4"
                        eOpposite="#/42"/>
      
      <ecore:EReference xmi:id="102" name="ta"
                        lower="1" upper="1"
                        eType="#/5"
                        eOpposite="#/52"/>
      
      <ecore:EReference xmi:id="103" name="course"
                        lower="1" upper="1"
                        eType="#/6"
                        eOpposite="#/64"/>
      
      <!-- Time of the appointment – stored as a string that represents java.time.LocalTime -->
      <ecore:EAttribute xmi:id="104" name="time"
                        eType="http://www.eclipse.org/emf/2003/xsd/EString#//EString"/>
    </ecore:eStructuralFeatures>
  </ecore:EClass>

  <!-- Placeholder for the “Any” wildcard type (used by the root container) -->
  <ecore:EClass xmi:id="3" name="Any"
                eSuperTypes="http://www.eclipse.org/emf/2002/Ecore#EObject"/>

  <!-- Custom EDataType that maps to java.time.LocalTime -->
  <ecore:EDatatype xmi:id="11" name="LocalTime"
                   instanceClassName="java.time.LocalTime">
    <eGenericType href="http://www.eclipse.org/emf/2003/xsd/EString#//EString"/>
  </ecore:EDatatype>

  <!-- The top‑level package that owns all classifiers -->
  <ecore:ePackage xmi:id="12" name="model"
                  nName="model" 
                  xmlns="http://www.eclipse.org/emf/2002/Ecore#//EPackage">
    <eClassifiers>
      <!-- List every classifier defined above -->
      <eElements ref="#1"/>
      <eElements ref="#2"/>
      <eElements ref="#3"/>               <!-- Person -->
      <eElements ref="#4"/>               <!-- Student -->
      <eElements ref="#5"/>               <!-- TeachingAssistant -->
      <eElements ref="#6"/>               <!-- Course -->
      <eElements ref="#7"/>               <!-- Registration -->
      <eElements ref="#8"/>               <!-- TaAssignment -->
      <eElements ref="#10"/>              <!-- Appointment -->
      <eElements ref="#11"/>              <!-- LocalTime (EDatatype) -->
    </eClassifiers>
  </ecore:ePackage>

</xmi:XMI>
