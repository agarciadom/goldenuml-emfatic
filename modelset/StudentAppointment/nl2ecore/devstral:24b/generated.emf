@namespace(uri="appointment.system", prefix="appointment_system")
package AppointmentSystem;

class AppointmentSystem {
	ref Student[*] students;
	ref TeachingAssistant[*] teachingAssistants;
	ref Course[*] courses;
}

class Student {
	ref Appointment[*] appointments;
	ref Course[*] courses;
}

class TeachingAssistant {
	ref Appointment[*] appointments;
	ref Course[*] courses;
}

class Course {
	ref Student[*] students;
	ref TeachingAssistant[*] teachingAssistants;
}

class Appointment {
	ref Student student;
	ref TeachingAssistant teachingAssistant;
	ref Course course;
}


