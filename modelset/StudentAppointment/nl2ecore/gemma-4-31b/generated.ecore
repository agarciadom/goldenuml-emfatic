<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" 
    xmlns:xmi="http://www.omg.org/XMI" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">

    <ePackage name="StudentAppointment" nsURI="http://www.example.org/studentappointment" nsPrefix="sa">
        <eClass name="Course">
            <eStructuralFeatures>
                <eReference name="students" eType="sa:Student"/>
                <eReference name="teachingAssistants" eType="sa:TeachingAssistant"/>
                <eReference name="appointments" eType="sa:Appointment"/>
            </eStructuralFeatures>
        </eClass>

        <eClass name="Student">
            <eStructuralFeatures>
                <eReference name="registeredCourses" eType="sa:Course"/>
                <!-- Non-containment reference to the association class -->
                <eReference name="appointments" eType="sa:Appointment"/>
            </eStructuralFeatures>
        </eClass>

        <eClass name="TeachingAssistant">
            <eStructuralFeatures>
                <eReference name="coursesTaught" eType="sa:Course"/>
                <!-- Containment reference to the association class -->
                <eReference name="appointments" eType="sa:Appointment" containment="true"/>
            </eStructuralFeatures>
        </eClass>

        <eClass name="Appointment">
            <eStructuralFeatures>
                <eReference name="course" eType="sa:Course"/>
                <eReference name="assistant" eType="sa:TeachingAssistant"/>
                <eReference name="students" eType="sa:Student"/>
                <eAttribute name="appointmentDate" eType="ecore:EDate"/>
            </eStructuralFeatures>
        </eClass>

        <eClass name="SystemRoot">
            <eStructuralFeatures>
                <eReference name="students" eType="sa:Student" containment="true"/>
                <eReference name="courses" eType="sa:Course" containment="true"/>
                <eReference name="teachingAssistants" eType="sa:TeachingAssistant" containment="true"/>
                <eReference name="appointments" eType="sa:Appointment" containment="true"/>
            </eStructuralFeatures>
        </eClass>

        <!-- 
        - This metamodel tracks appointments between students and TAs for specific courses.
        - Appointment is treated as the association class linking Student, TeachingAssistant, and Course.
        - To follow instructions on association classes: TeachingAssistant holds containment of the appointment, while Student does not.
        - SystemRoot acts as the root container for all top-level entities.
        -->
    </ePackage>
</xmi:XMI>
