@namespace(uri="http://www.example.org/AppointmentSystem", prefix="as")
package AppointmentSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Student {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] ~id;
}

class TeachingAssistant {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] ~id;
	ref Course[*] courses;
}

class Course {
	attr ecore.EString[1] name;
	attr ecore.EString[1] code;
	ref TeachingAssistant[*] teachingAssistants;
	ref Student[*] students;
}

class Appointment {
	attr ecore.EDate[1] date;
	ref Course[1] course;
	ref TeachingAssistant[1] teachingAssistant;
	ref Student[+] students;
}


