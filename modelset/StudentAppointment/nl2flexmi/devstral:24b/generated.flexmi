<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AppointmentSystem" nsURI="http://www.example.org/AppointmentSystem" nsPrefix="as">
  <eClassifiers>
    <eClass name="Student">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TeachingAssistant">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="courses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="code" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="teachingAssistants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="students" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="course" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="teachingAssistant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="students" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
