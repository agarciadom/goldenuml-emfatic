<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AppointmentManagementSystem" nsURI="http://www.example.org/AppointmentManagementSystem" nsPrefix="ams">
  <eClassifiers>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
    <eClass name="Student">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="courses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TeachingAssistant">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="courses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="course" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="teachingAssistant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="students" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
