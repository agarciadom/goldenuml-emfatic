@namespace(uri="http://example.org/AcademicSystem", prefix="acad")
package AcademicSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Student {
	attr ecore.EString[1] name;
}

class Course {
	attr ecore.EString[1] courseName;
}

class TeachingAssistant {
	attr ecore.EString[1] taName;
}

class Appointment {
	attr ecore.EDate[1] appointmentTime;
}


