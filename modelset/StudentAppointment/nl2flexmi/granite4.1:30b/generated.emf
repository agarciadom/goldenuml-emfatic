@namespace(uri="http://example.com/coursemanagement", prefix="cm")
package CourseManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString name;
}

class Student extends Person {
	ref Course[*] registeredCourses;
	ref Appointment[*] appointments;
}

class TeachingAssistant extends Person {
	ref Course[*] taForCourses;
	ref Appointment[*] appointmentsProvided;
}

class Course {
	attr ecore.EString title;
	ref Student[*] students;
	ref TeachingAssistant[*] teachingAssistants;
}

class Appointment {
	ref Student[1] student;
	ref TeachingAssistant[1] teachingAssistant;
	ref Course[1] course;
}


