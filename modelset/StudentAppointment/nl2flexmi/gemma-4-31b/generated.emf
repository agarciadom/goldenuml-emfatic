@namespace(uri="http://example.com/AppointmentManagement", prefix="am")
package AppointmentManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class UniversitySystem {
	val Student[*] students;
	val TeachingAssistant[*] teachingAssistants;
	val Course[*] courses;
	val Appointment[*] appointments;
}

class Person {
	attr ecore.EString name;
}

class Student extends Person {
	ref Course[*] registeredCourses;
}

class TeachingAssistant extends Person {
	ref Course[*] taughtCourses;
}

class Course {
	attr ecore.EString courseName;
	ref Student[*] enrolledStudents;
	ref TeachingAssistant[*] teachingAssistants;
}

class Appointment {
	ref Student[+] students;
	ref TeachingAssistant[1] assistant;
	ref Course[1] course;
}


