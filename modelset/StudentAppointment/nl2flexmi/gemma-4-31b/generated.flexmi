<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AppointmentManagement" nsURI="http://example.com/AppointmentManagement" nsPrefix="am">
  <eClassifiers>
    <eClass name="UniversitySystem">
      <eStructuralFeatures>
        <eReference name="students" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="teachingAssistants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="courses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="appointments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="registeredCourses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TeachingAssistant" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="taughtCourses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="courseName" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="enrolledStudents" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="teachingAssistants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eReference name="students" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="assistant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="course" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
