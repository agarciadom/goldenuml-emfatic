<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="university"
    nsURI="http://www.example.org/university"
    nsPrefix="university">

  <!-- Root container holding top-level elements -->
  <eClassifiers xsi:type="ecore:EClass" name="University">
    <eStructuralFeatures xsi:type="ecore:EReference" name="students"
        eType="#//Student" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="courses"
        eType="#//Course" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assistants"
        eType="#//Assistant" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- Student class: contains CourseSubscriptions (association class end) -->
  <eClassifiers xsi:type="ecore:EClass" name="Student">
    <eStructuralFeatures xsi:type="ecore:EReference" name="courseSubscriptions"
        eType="#//CourseSubscription" upperBound="-1"
        containment="true" eOpposite="#//CourseSubscription/student"/>
  </eClassifiers>

  <!-- Course class: non-containment ref to CourseSubscription,
       and containment ref to TeachingAssistant -->
  <eClassifiers xsi:type="ecore:EClass" name="Course">
    <eStructuralFeatures xsi:type="ecore:EReference" name="courseSubscriptions"
        eType="#//CourseSubscription" upperBound="-1"
        eOpposite="#//CourseSubscription/course"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="teachingAssistants"
        eType="#//TeachingAssistant" upperBound="-1"
        containment="true" eOpposite="#//TeachingAssistant/course"/>
  </eClassifiers>

  <!-- Assistant class: non-containment ref to TeachingAssistant -->
  <eClassifiers xsi:type="ecore:EClass" name="Assistant">
    <eStructuralFeatures xsi:type="ecore:EReference" name="teachingAssistants"
        eType="#//TeachingAssistant" upperBound="-1"
        eOpposite="#//TeachingAssistant/assistant"/>
  </eClassifiers>

  <!-- CourseSubscription: association class for Student-Course.
       Contains Appointments (single container for Appointment). -->
  <eClassifiers xsi:type="ecore:EClass" name="CourseSubscription">
    <eStructuralFeatures xsi:type="ecore:EReference" name="student"
        eType="#//Student" lowerBound="1"
        eOpposite="#//Student/courseSubscriptions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="course"
        eType="#//Course" lowerBound="1"
        eOpposite="#//Course/courseSubscriptions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appointments"
        eType="#//Appointment" upperBound="-1"
        containment="true" eOpposite="#//Appointment/courseSubscription"/>
  </eClassifiers>

  <!-- TeachingAssistant: association class for Course-Assistant.
       Non-containment ref to Appointment (Appointment is contained by CourseSubscription). -->
  <eClassifiers xsi:type="ecore:EClass" name="TeachingAssistant">
    <eStructuralFeatures xsi:type="ecore:EReference" name="course"
        eType="#//Course" lowerBound="1"
        eOpposite="#//Course/teachingAssistants"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assistant"
        eType="#//Assistant" lowerBound="1"
        eOpposite="#//Assistant/teachingAssistants"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appointments"
        eType="#//Appointment" upperBound="-1"
        eOpposite="#//Appointment/teachingAssistant"/>
  </eClassifiers>

  <!-- Appointment: contained by CourseSubscription,
       non-containment reference back to TeachingAssistant -->
  <eClassifiers xsi:type="ecore:EClass" name="Appointment">
    <eStructuralFeatures xsi:type="ecore:EReference" name="courseSubscription"
        eType="#//CourseSubscription" lowerBound="1"
        eOpposite="#//CourseSubscription/appointments"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="teachingAssistant"
        eType="#//TeachingAssistant" lowerBound="1"
        eOpposite="#//TeachingAssistant/appointments"/>
  </eClassifiers>

</ecore:EPackage>
