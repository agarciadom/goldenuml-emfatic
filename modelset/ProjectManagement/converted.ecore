<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="researchmodel"
    nsURI="http://www.example.org/researchmodel"
    nsPrefix="researchmodel">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="Root">
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments"
        eType="#//Department" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        eType="#//Project" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        eType="#//Service" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchers"
        eType="#//Researcher" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- Department contains ResearchGroups (1 to 0..*) -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroups"
        eType="#//ResearchGroup" upperBound="-1" containment="true"
        eOpposite="#//ResearchGroup/department"/>
  </eClassifiers>

  <!-- ResearchGroup: contained by Department -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroup">
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="#//Department" lowerBound="1"
        eOpposite="#//Department/researchGroups"/>
    <!-- Association class end: ResearchGroup side contains ResearchGroupMember -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupMembers"
        eType="#//ResearchGroupMember" upperBound="-1" containment="true"
        eOpposite="#//ResearchGroupMember/researchGroup"/>
    <!-- Association class end: ResearchGroup side for WorkPackageLeader -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeaders"
        eType="#//WorkPackageLeader" upperBound="-1"
        eOpposite="#//WorkPackageLeader/researchGroup"/>
  </eClassifiers>

  <!-- Researcher: contained by Root -->
  <eClassifiers xsi:type="ecore:EClass" name="Researcher">
    <!-- Association class end: Researcher side points to ResearchGroupMember -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupMembers"
        eType="#//ResearchGroupMember" upperBound="-1"
        eOpposite="#//ResearchGroupMember/researcher"/>
  </eClassifiers>

  <!-- ResearchGroupMember: association class between ResearchGroup and Researcher -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroupMember">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        eType="#//ResearchGroup" lowerBound="1"
        eOpposite="#//ResearchGroup/researchGroupMembers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researcher"
        eType="#//Researcher" lowerBound="1"
        eOpposite="#//Researcher/researchGroupMembers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        eType="#//Service" upperBound="-1"
        eOpposite="#//Service/researchGroupMember"/>
  </eClassifiers>

  <!-- Project contains WorkPackages (1 to 1..*) -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackages"
        eType="#//WorkPackage" lowerBound="1" upperBound="-1" containment="true"
        eOpposite="#//WorkPackage/project"/>
  </eClassifiers>

  <!-- WorkPackage: contained by Project -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkPackage">
    <eStructuralFeatures xsi:type="ecore:EReference" name="project"
        eType="#//Project" lowerBound="1"
        eOpposite="#//Project/workPackages"/>
    <!-- Association class end: WorkPackage side contains WorkPackageLeader -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeaders"
        eType="#//WorkPackageLeader" upperBound="-1" containment="true"
        eOpposite="#//WorkPackageLeader/workPackage"/>
  </eClassifiers>

  <!-- WorkPackageLeader: association class between WorkPackage and ResearchGroup -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkPackageLeader">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackage"
        eType="#//WorkPackage" lowerBound="1"
        eOpposite="#//WorkPackage/workPackageLeaders"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        eType="#//ResearchGroup" lowerBound="1"
        eOpposite="#//ResearchGroup/workPackageLeaders"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        eType="#//Service" upperBound="-1"
        eOpposite="#//Service/workPackageLeader"/>
  </eClassifiers>

  <!-- Service: contained by Root -->
  <eClassifiers xsi:type="ecore:EClass" name="Service">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupMember"
        eType="#//ResearchGroupMember"
        eOpposite="#//ResearchGroupMember/services"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeader"
        eType="#//WorkPackageLeader"
        eOpposite="#//WorkPackageLeader/services"/>
  </eClassifiers>

</ecore:EPackage>
