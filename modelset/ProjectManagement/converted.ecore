<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="researchmodel"
    nsURI="http://www.example.org/researchmodel"
    nsPrefix="researchmodel">

  <!-- Department has 0..* ResearchGroups -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroups"
        upperBound="-1"
        eType="#//ResearchGroup"
        containment="true"/>
  </eClassifiers>

  <!-- ResearchGroup belongs to 1 Department and has 0..* Researchers -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroup">
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        upperBound="-1"
        eType="#//ResearchGroupMember"
        containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Researcher">
  </eClassifiers>

  <!-- Association class between ResearchGroup and Researcher -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroupMember">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        lowerBound="1"
        eType="#//ResearchGroup"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researcher"
        lowerBound="1"
        eType="#//Researcher"/>
    <!-- ResearchGroupMember provides 0..* Services -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        upperBound="-1"
        eType="#//Service"
        containment="true"/>
  </eClassifiers>

  <!-- Project has 1..* WorkPackages -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackages"
        lowerBound="1"
        upperBound="-1"
        eType="#//WorkPackage"
        containment="true"/>
  </eClassifiers>

  <!-- WorkPackage is linked to 0..1 ResearchGroup -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkPackage">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeader"
        upperBound="-1"
        eType="#//WorkPackageLeader"
        containment="true"/>
  </eClassifiers>

  <!-- Association class between WorkPackage and ResearchGroup -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkPackageLeader">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackage"
        lowerBound="1"
        eType="#//WorkPackage"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        eType="#//ResearchGroup"/>
    <!-- WorkPackageLeader provides 0..* Services -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        upperBound="-1"
        eType="#//Service"
        containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Service">
  </eClassifiers>

</ecore:EPackage>
