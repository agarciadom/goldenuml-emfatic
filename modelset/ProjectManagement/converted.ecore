<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="researchmodel"
    nsURI="http://www.example.org/researchmodel"
    nsPrefix="researchmodel">

  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroups"
        lowerBound="0" upperBound="-1"
        eType="#//ResearchGroup"
        containment="true"
        eOpposite="#//ResearchGroup/department"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroup">
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        lowerBound="1" upperBound="1"
        eType="#//Department"
        eOpposite="#//Department/researchGroups"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupMembers"
        lowerBound="0" upperBound="-1"
        eType="#//ResearchGroupMember"
        containment="true"
        eOpposite="#//ResearchGroupMember/researchGroup"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeaders"
        lowerBound="0" upperBound="-1"
        eType="#//WorkPackageLeader"
        eOpposite="#//WorkPackageLeader/researchGroup"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Researcher">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupMembers"
        lowerBound="0" upperBound="-1"
        eType="#//ResearchGroupMember"
        containment="true"
        eOpposite="#//ResearchGroupMember/researcher"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroupMember">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        lowerBound="1" upperBound="1"
        eType="#//ResearchGroup"
        eOpposite="#//ResearchGroup/researchGroupMembers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researcher"
        lowerBound="1" upperBound="1"
        eType="#//Researcher"
        eOpposite="#//Researcher/researchGroupMembers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        lowerBound="0" upperBound="-1"
        eType="#//Service"
        containment="true"
        eOpposite="#//Service/researchGroupMember"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackages"
        lowerBound="1" upperBound="-1"
        eType="#//WorkPackage"
        containment="true"
        eOpposite="#//WorkPackage/project"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="WorkPackage">
    <eStructuralFeatures xsi:type="ecore:EReference" name="project"
        lowerBound="1" upperBound="1"
        eType="#//Project"
        eOpposite="#//Project/workPackages"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeader"
        lowerBound="0" upperBound="1"
        eType="#//WorkPackageLeader"
        containment="true"
        eOpposite="#//WorkPackageLeader/workPackage"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="WorkPackageLeader">
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackage"
        lowerBound="1" upperBound="1"
        eType="#//WorkPackage"
        eOpposite="#//WorkPackage/workPackageLeader"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        lowerBound="1" upperBound="1"
        eType="#//ResearchGroup"
        eOpposite="#//ResearchGroup/workPackageLeaders"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="services"
        lowerBound="0" upperBound="-1"
        eType="#//Service"
        containment="true"
        eOpposite="#//Service/workPackageLeader"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Service">
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupMember"
        lowerBound="0" upperBound="1"
        eType="#//ResearchGroupMember"
        eOpposite="#//ResearchGroupMember/services"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackageLeader"
        lowerBound="0" upperBound="1"
        eType="#//WorkPackageLeader"
        eOpposite="#//WorkPackageLeader/services"/>
  </eClassifiers>

</ecore:EPackage>
