<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="ResearchProjectManagement" nsURI="http://www.example.org/research_project_management" nsPrefix="rpm" xmi:version="2.0">

    <!-- Data Types -->
    <ecore:EDataType name="TimeWithoutDate" instanceClassName="java.time.LocalTime"/>

    <!-- Classes -->

    <ecore:EClass name="Universe">
      <ecore:EReference name="researchGroups" lowerBound="0" eType="#//ResearchGroup"/>
      <ecore:EReference name="projects" lowerBound="0" eType="#//Project"/>
      <ecore:EReference name="departments" lowerBound="0" eType="#//Department"/>
    </ecore:EClass>

    <ecore:EClass name="ResearchGroup">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="researchers" lowerBound="0" eType="#//Researcher" containment="true"/>
      <ecore:EReference name="ledWorkPackages" lowerBound="0" eType="#//WorkPackageAssociation">
        <eannotations source="http://www.eclipse.org/emf/2002/Ecore/Opposite">
          <details key="resolved" value="false"/>
          <details key="derivation" value="forward"/>
          <details key="identifier" value="ledWorkPackages"/>
        </eannotations>
      </ecore:EReference>
    </ecore:EClass>

    <ecore:EClass name="Department">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="researchGroups" lowerBound="0" eType="#//ResearchGroup" containment="true"/>
    </ecore:EClass>

    <ecore:EClass name="Researcher">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="researchGroup" eType="#//ResearchGroup"/>
      <ecore:EReference name="workPackageAssignments" lowerBound="0" eType="#//WorkPackageAssignment">
        <eannotations source="http://www.eclipse.org/emf/2002/Ecore/Opposite">
          <details key="resolved" value="false"/>
          <details key="derivation" value="forward"/>
          <details key="identifier" value="workPackageAssignments"/>
        </eannotations>
      </ecore:EReference>
    </ecore:EClass>

    <ecore:EClass name="Project">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="workPackages" lowerBound="0" eType="#//WorkPackage" containment="true"/>
    </ecore:EClass>

    <ecore:EClass name="WorkPackage">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="workPackageAssociation" eType="#//WorkPackageAssociation" containment="true"/>
    </ecore:EClass>

    <!-- Association Classes -->
    <ecore:EClass name="WorkPackageAssignment">
      <ecore:EAttribute name="startTime" eType="#//TimeWithoutDate"/>
      <ecore:EReference name="researcher" eType="#//Researcher">
        <eannotations source="http://www.eclipse.org/emf/2002/Ecore/Opposite">
          <details key="resolved" value="false"/>
          <details key="derivation" value="forward"/>
          <details key="identifier" value="workPackageAssignments"/>
        </eannotations>
      </ecore:EReference>
    </ecore:EClass>

    <ecore:EClass name="WorkPackageAssociation">
      <ecore:EAttribute name="startDate" eType="#//TimeWithoutDate"/>
      <ecore:EReference name="researchGroup" eType="#//ResearchGroup" containment="true">
        <eannotations source="http://www.eclipse.org/emf/2002/Ecore/Opposite">
          <details key="resolved" value="false"/>
          <details key="derivation" value="forward"/>
          <details key="identifier" value="ledWorkPackages"/>
        </eannotations>
      </ecore:EReference>
    </ecore:EClass>

  </ecore:EPackage>
</xmi:XMI>
