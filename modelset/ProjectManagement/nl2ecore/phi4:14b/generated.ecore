<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    name="ResearchProjectManagement" nsURI="http:///ResearchProjectManagement.ecore" nsPrefix="rpm">
    <eClassifiers>
        <!-- Class: University -->
        <eClass eSuperTypes="#//OrganizationalUnit" name="University">
            <eStructuralFeatures>
                <eReference  eType="#//Department" containment="true" multiplicity="1..*"/>
            </eStructuralFeatures>
        </eClass>

        <!-- Class: Department -->
        <eClass eSuperTypes="#//ResearchGroupContainer" name="Department">
            <eStructuralFeatures>
                <eReference  eType="#//ResearchGroup" containment="true" multiplicity="1..*"/>
                <eReference  eType="#//PersonnelAssignment" aggregation="shared"/>
            </eStructuralFeatures>
        </eClass>

        <!-- Class: ResearchGroup -->
        <eClass eSuperTypes="#//OrganizationalUnit" name="ResearchGroup">
            <eStructuralFeatures>
                <eReference  eType="#//Researcher" containment="true" multiplicity="1..*"/>
                <eReference  eType="#//WorkPackageLeader" multiplicity="0..1" opposite="#//WPLeaderAssignment.workingGroup"/>                
            </eStructuralFeatures>
        </eClass>

        <!-- Class: ResearchGroupContainer (Root Container) -->
        <eClass name="ResearchGroupContainer">
            <eStructuralFeatures>
                <eReference  eType="#//University" containment="true" multiplicity="1" isOpposite="true"/>
            </eStructuralFeatures>
        </eClass>

        <!-- Class: Researcher -->
        <eClass name="Researcher">
            <eStructuralFeatures>
                <eReference  eType="#//WorkPackageAssignment" containment="false" multiplicityEngine="0..*"/>
            </eStructuralFeatures>
        </eClass>

        <!-- Association class: WorkPackageAssignment -->
        <eClass name="WorkPackageAssignment">
          <eReferences>
              <eReference  eType="#//Researcher" 
                            containment="true"
                            opposite = "#//WPAssignment.researcher"/>
              <eReference  eType="#//WorkPackage"  
                           aggregation="shared"
                           multiplicity="1..1"
                           upper="-1"
                           lower="1"
                           eOpposite ="#//wpAssignments.workPackageLeader"/>
          </eReferences>
        </eClass>

        <!-- Association class: WPLeaderAssignment (Association class for Work Package leadership) -->
        <eClass name="WPLeaderAssignment">
            <eReferences>
                <eReference  eType="#//ResearchGroup" 
                                containment="true"
                                opposite = "#/researcher"/>
                <eReference  eType="#//WorkPackage"  
                           aggregation="shared"
                            multiplicity="1..1"
                           upper="-1"
                           lower="1"
                           eOpposite ="#//wpLeaderAssignments.workPackageLeader"/>
            </eReferences>
        </eClass>

        <!-- Class: WorkPackage -->
        <eClass name="WorkPackage">
            <eStructuralFeatures>
                <eReference  eType="#//WPLeaderAssignment" multiplicity="0..1" opposite="#/workingGroup"/>
                <eReference  eType ="#//WorkPackageSubdivision" aggregation="shared"/>
                <eReference  eType ="#//WorkPackageAssignment" containment ="false" upper="-1" lower="1"/>
            </eStructuralFeatures>
        </eClass>

        <!-- Class: WorkPackage (Abstract class for subdivision) -->
        <eClass name="WorkPackageSubdivision">
          <eReferences >
            <eReference  eType="#/WorkPackage"
                           multiplicity="0..1" 
                           containment ="true"
                           opposite = "#/subdivisions"/>
          </eReferences>
        </eClass>

        <!-- Class: OrganizationalUnit -->
        <eClass name="OrganizationalUnit">
            <!-- This class is a base for abstracting University, Department, and ResearchGroup -->
        </eClass>

        <!-- Custom datatype for time without date -->
        <eClassifiers xsi:type="ecore:EDataType" xmi:id="_TimeOnly" name="TimeOnly" upper="-1" lower="1">
            <eAnnotations source="http://www.eclipse.org/emf/2012/Ecore">
                <details key = "typeLiteral">java.time.LocalTime</details>
            </eAnnotations>
        </eClassifiers>

    </eClassifiers>
</ecore:EPackage>
