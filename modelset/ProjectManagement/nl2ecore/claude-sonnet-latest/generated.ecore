<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="researchProjectManagement"
    nsURI="http://www.example.org/researchProjectManagement"
    nsPrefix="rpm">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="University">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments"
        eType="#//Department"
        containment="true" eOpposite="#//Department/university"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="projects"
        eType="#//Project"
        containment="true" eOpposite="#//Project/university"/>
  </eClassifiers>

  <!-- Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="university"
        eType="#//University"
        eOpposite="#//University/departments"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroups"
        eType="#//ResearchGroup"
        containment="true" eOpposite="#//ResearchGroup/department"/>
  </eClassifiers>

  <!-- ResearchGroup -->
  <eClassifiers xsi:type="ecore:EClass" name="ResearchGroup">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="#//Department"
        eOpposite="#//Department/researchGroups"/>
    <!-- Researchers are contained in their ResearchGroup -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="members"
        eType="#//Researcher"
        containment="true" eOpposite="#//Researcher/researchGroup"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ledWorkPackages"
        eType="#//WorkPackage"
        eOpposite="#//WorkPackage/leader"/>
    <!-- Service delivery: WPAssignments where the researcher belonged to this RG -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="recordedAssignments"
        eType="#//WPAssignment"
        eOpposite="#//WPAssignment/researchGroupAtAssignment"/>
    <eOperations name="reassignResearcher">
      <eParameters name="researcher" eType="#//Researcher"/>
      <eParameters name="newGroup" eType="#//ResearchGroup"/>
    </eOperations>
  </eClassifiers>

  <!-- Researcher -->
  <eClassifiers xsi:type="ecore:EClass" name="Researcher">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroup"
        eType="#//ResearchGroup"
        eOpposite="#//ResearchGroup/members"/>
    <!-- Association class end: Researcher side contains WPAssignment instances -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="wpAssignments"
        eType="#//WPAssignment"
        containment="true" eOpposite="#//WPAssignment/researcher"/>
    <eOperations name="changeResearchGroup">
      <eParameters name="newGroup" eType="#//ResearchGroup"/>
    </eOperations>
  </eClassifiers>

  <!-- Project -->
  <eClassifiers xsi:type="ecore:EClass" name="Project">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="university"
        eType="#//University"
        eOpposite="#//University/projects"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackages"
        eType="#//WorkPackage"
        containment="true" eOpposite="#//WorkPackage/project"/>
  </eClassifiers>

  <!-- WorkPackage -->
  <eClassifiers xsi:type="ecore:EClass" name="WorkPackage">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="project"
        eType="#//Project"
        eOpposite="#//Project/workPackages"/>
    <!-- Exactly one ResearchGroup leads this WP -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="leader"
        eType="#//ResearchGroup"
        eOpposite="#//ResearchGroup/ledWorkPackages"/>
    <!-- Association class end: WorkPackage side is non-containment -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="wpAssignments"
        eType="#//WPAssignment"
        eOpposite="#//WPAssignment/workPackage"/>
    <eOperations name="reassignLeader">
      <eParameters name="newLeader" eType="#//ResearchGroup"/>
    </eOperations>
  </eClassifiers>

  <!-- WPAssignment: association class between Researcher and WorkPackage -->
  <!-- Records service delivery: which RG the researcher belonged to at assignment time -->
  <eClassifiers xsi:type="ecore:EClass" name="WPAssignment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="active"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Back-reference to the Researcher who owns/contains this -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="researcher"
        eType="#//Researcher"
        eOpposite="#//Researcher/wpAssignments"/>
    <!-- Non-containment reference to WorkPackage -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="workPackage"
        eType="#//WorkPackage"
        eOpposite="#//WorkPackage/wpAssignments"/>
    <!-- Records the ResearchGroup the researcher belonged to at time of assignment -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="researchGroupAtAssignment"
        eType="#//ResearchGroup"
        eOpposite="#//ResearchGroup/recordedAssignments"/>
    <eOperations name="terminate">
      <eParameters name="endDate"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    </eOperations>
  </eClassifiers>

</ecore:EPackage>
