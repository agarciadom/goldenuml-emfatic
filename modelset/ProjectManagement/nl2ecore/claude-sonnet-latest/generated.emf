@namespace(uri="http://www.example.org/researchProjectManagement", prefix="rpm")
package researchProjectManagement;

class University {
	attr String name;
	val Department#university departments;
	val Project#university projects;
}

class Department {
	attr String name;
	ref University#departments university;
	val ResearchGroup#department researchGroups;
}

class ResearchGroup {
	op void reassignResearcher(Researcher researcher, ResearchGroup newGroup);
	attr String name;
	ref Department#researchGroups department;
	val Researcher#researchGroup members;
	ref WorkPackage#leader ledWorkPackages;
	ref WPAssignment#researchGroupAtAssignment recordedAssignments;
}

class Researcher {
	op void changeResearchGroup(ResearchGroup newGroup);
	attr String name;
	ref ResearchGroup#members researchGroup;
	val WPAssignment#researcher wpAssignments;
}

class Project {
	attr String name;
	attr String description;
	ref University#projects university;
	val WorkPackage#project workPackages;
}

class WorkPackage {
	op void reassignLeader(ResearchGroup newLeader);
	attr String name;
	attr String description;
	ref Project#workPackages project;
	ref ResearchGroup#ledWorkPackages leader;
	ref WPAssignment#workPackage wpAssignments;
}

class WPAssignment {
	op void terminate(EDate endDate);
	attr EDate startDate;
	attr EDate endDate;
	attr boolean active;
	ref Researcher#wpAssignments researcher;
	ref WorkPackage#wpAssignments workPackage;
	ref ResearchGroup#recordedAssignments researchGroupAtAssignment;
}


