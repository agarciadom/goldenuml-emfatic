@namespace(uri="http://www.example.org/researchmodel", prefix="researchmodel")
package researchmodel;

class Department {
	val ResearchGroup[*]#department researchGroups;
}

class ResearchGroup {
	ref Department[1]#researchGroups department;
	val ResearchGroupMember[*]#researchGroup researchGroupMembers;
	ref WorkPackageLeader[*]#researchGroup workPackageLeaders;
}

class Researcher {
	val ResearchGroupMember[*]#researcher researchGroupMembers;
}

class ResearchGroupMember {
	ref ResearchGroup[1]#researchGroupMembers researchGroup;
	ref Researcher[1]#researchGroupMembers researcher;
	val Service[*]#researchGroupMember services;
}

class Project {
	val WorkPackage[+]#project workPackages;
}

class WorkPackage {
	ref Project[1]#workPackages project;
	val WorkPackageLeader#workPackage workPackageLeader;
}

class WorkPackageLeader {
	ref WorkPackage[1]#workPackageLeader workPackage;
	ref ResearchGroup[1]#workPackageLeaders researchGroup;
	val Service[*]#workPackageLeader services;
}

class Service {
	ref ResearchGroupMember#services researchGroupMember;
	ref WorkPackageLeader#services workPackageLeader;
}


