@namespace(uri="http://www.example.org/researchmanagement", prefix="researchmanagement")
package researchmanagement;

class ResearchManagementSystem {
	val Department[*] departments;
	val Project[*] projects;
	val Service[*] services;
	val ResearchGroupMember[*] researchGroupMembers;
	val WorkPackageLeader[*] workPackageLeaders;
}

class Department {
	val ResearchGroup[*] researchGroups;
}

class ResearchGroup {
	ref ResearchGroupMember[*] researchGroupMembers;
	ref WorkPackageLeader[*] workPackageLeaders;
}

class Researcher {
	ref ResearchGroupMember[*] researchGroupMembers;
}

class ResearchGroupMember {
	ref ResearchGroup[1] researchGroup;
	ref Researcher[1] researcher;
	ref Service[*] services;
}

class Project {
	val WorkPackage[+] workPackages;
}

class WorkPackage {
	ref WorkPackageLeader[*] workPackageLeaders;
}

class WorkPackageLeader {
	ref WorkPackage[1] workPackage;
	ref ResearchGroup researchGroup;
	ref Service[*] services;
}

class Service {
}


