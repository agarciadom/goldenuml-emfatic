@namespace(uri="http://www.example.org/researchmodel", prefix="researchmodel")
package researchmodel;

class Department {
	val ResearchGroup[*] researchGroups;
}

class ResearchGroup {
	val ResearchGroupMember[*] members;
}

class Researcher {
}

class ResearchGroupMember {
	ref ResearchGroup[1] researchGroup;
	ref Researcher[1] researcher;
	val Service[*] services;
}

class Project {
	val WorkPackage[+] workPackages;
}

class WorkPackage {
	val WorkPackageLeader[*] workPackageLeader;
}

class WorkPackageLeader {
	ref WorkPackage[1] workPackage;
	ref ResearchGroup researchGroup;
	val Service[*] services;
}

class Service {
}


