@namespace(uri="http://www.example.org/ResearchProjectManagement", prefix="rpm")
package ResearchProjectManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class University {
}

class Department {
	attr ecore.EString[1] name;
}

class ResearchGroup {
	ref Department[1] Department;
}

class Project {
	attr ecore.EString title;
	ref WorkPackage[*] workPackages;
}

class WorkPackage {
	attr ecore.EString name;
	ref ResearchGroup[1] leadingResearchGroup;
	ref Researcher[*] assignedResearchers;
}

class Researcher {
	attr ecore.EString[1] name;
}


