<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ResearchProjectManagement" nsURI="http://www.example.org/ResearchProjectManagement" nsPrefix="rpm">
  <eClassifiers>
    <eClass name="University">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchGroup">
      <eStructuralFeatures>
        <eReference name="Department" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="workPackages" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WorkPackage">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="leadingResearchGroup" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="assignedResearchers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Researcher">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
