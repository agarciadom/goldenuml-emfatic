<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ResearchManagement" nsURI="http://example.org/research" nsPrefix="rm">
  <eClassifiers>
    <eClass name="NamedElement">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Department" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="university" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchGroup" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="department" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Researcher" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="group" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="university" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WorkPackage" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="project" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="leader" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WPAssignment">
      <eStructuralFeatures>
        <eReference name="researcher" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="workPackage" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="workPackageContainer" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="University" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
