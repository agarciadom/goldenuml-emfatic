@namespace(uri="http://example.org/research", prefix="rm")
package ResearchManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class NamedElement {
	attr ecore.EString name;
}

class Department extends NamedElement {
	val University[1] university;
}

class ResearchGroup extends NamedElement {
	ref Department[1] department;
}

class Researcher extends NamedElement {
	ref ResearchGroup[1] group;
}

class Project extends NamedElement {
	val University[1] university;
}

class WorkPackage extends NamedElement {
	val Project[1] project;
	ref ResearchGroup[1] leader;
}

class WPAssignment {
	ref Researcher[1] researcher;
	ref WorkPackage[1] workPackage;
	val WorkPackage[1] workPackageContainer;
}

class University extends NamedElement {
}


