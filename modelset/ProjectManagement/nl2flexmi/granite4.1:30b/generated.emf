@namespace(uri="http://www.example.org/ResearchProjectManagement", prefix="rpm")
package ResearchProjectManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class University {
	attr ecore.EString[1] name;
	val Department[*] departments;
}

class Department {
	attr ecore.EString[1] name;
	val ResearchGroup[*] researchGroups;
}

class ResearchGroup {
	attr ecore.EString[1] name;
}

class Project {
	attr ecore.EString[1] name;
	val WorkPackage[*] workPackages;
}

class WorkPackage {
	attr ecore.EString[1] name;
	ref ResearchGroup[1] leader;
	val Researcher[*] researchers;
}

class Researcher {
	attr ecore.EString[1] name;
	val ResearchGroup[1] group;
}


