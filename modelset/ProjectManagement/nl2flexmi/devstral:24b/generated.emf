@namespace(uri="http://www.example.com/researchprojectmanagement", prefix="rpm")
package ResearchProjectManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Department {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
}

class ResearchGroup {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	ref Department[1] department;
}

class Researcher {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	ref ResearchGroup[1] researchGroup;
	ref WorkPackage[*] workPackageAssignments;
}

class Project {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	val WorkPackage[*] workPackages;
}

class WorkPackage {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	ref Project[1] project;
	ref ResearchGroup[1] leader;
	ref Researcher[*] assignedResearchers;
}


