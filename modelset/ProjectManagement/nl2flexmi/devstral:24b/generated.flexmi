<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ResearchProjectManagement" nsURI="http://www.example.com/researchprojectmanagement" nsPrefix="rpm">
  <eClassifiers>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchGroup">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="department" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Researcher">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="researchGroup" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="workPackageAssignments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="workPackages" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WorkPackage">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="project" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="leader" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="assignedResearchers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
