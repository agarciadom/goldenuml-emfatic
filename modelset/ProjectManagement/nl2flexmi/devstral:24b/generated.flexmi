<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ResearchManagement" nsURI="http://www.example.org/researchmanagement" nsPrefix="rm">
  <eClassifiers>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchGroup">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="department" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Researcher">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="researchGroup" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="title" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WorkPackage">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="project" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="leader" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Assignment">
      <eStructuralFeatures>
        <eReference name="researcher" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="workPackage" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
