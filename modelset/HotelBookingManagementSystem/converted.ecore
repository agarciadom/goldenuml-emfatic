<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="hotelbooking"
    nsURI="http://www.example.org/hotelbooking"
    nsPrefix="hotelbooking">

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoomType">
    <eLiterals name="SINGLE"/>
    <eLiterals name="DOUBLE"/>
    <eLiterals name="TWIN"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="BookingStatus">
    <eLiterals name="FINALIZED"/>
    <eLiterals name="CONFIRMED"/>
    <eLiterals name="CANCELLED_BY_HBMS"/>
    <eLiterals name="PRELIMINARY"/>
    <eLiterals name="CANCELLED_BY_TRAVELLER"/>
    <eLiterals name="CANCELLED_BY_HOTEL"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PaymentType">
    <eLiterals name="PREPAID"/>
    <eLiterals name="PAID_AT_HOTEL"/>
  </eClassifiers>

  <!-- Abstract TripInfo -->
  <eClassifiers xsi:type="ecore:EClass" name="TripInfo" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfRooms" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType" eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arrivalDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="departureDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="budgetPerNight" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
  </eClassifiers>

  <!-- RoomAvailability -->
  <eClassifiers xsi:type="ecore:EClass" name="RoomAvailability" eSuperTypes="#//TripInfo"/>

  <!-- SearchInfo -->
  <eClassifiers xsi:type="ecore:EClass" name="SearchInfo" eSuperTypes="#//TripInfo"/>

  <!-- BookingInfo -->
  <eClassifiers xsi:type="ecore:EClass" name="BookingInfo" eSuperTypes="#//TripInfo">
    <eStructuralFeatures xsi:type="ecore:EReference" name="specialOffers"
        eType="#//SpecialOffer"
        upperBound="-1"
        eOpposite="#//SpecialOffer/bookingInfo"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bestOffers"
        eType="#//SpecialOffer"
        lowerBound="0"
        upperBound="5"
        eOpposite="#//SpecialOffer/bestOfferBookingInfo"/>
  </eClassifiers>

  <!-- Abstract Offer -->
  <eClassifiers xsi:type="ecore:EClass" name="Offer" abstract="true"/>

  <!-- SpecialOffer -->
  <eClassifiers xsi:type="ecore:EClass" name="SpecialOffer" eSuperTypes="#//Offer">
    <eStructuralFeatures xsi:type="ecore:EReference" name="bookingInfo"
        eType="#//BookingInfo"
        upperBound="-1"
        eOpposite="#//BookingInfo/specialOffers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bestOfferBookingInfo"
        eType="#//BookingInfo"
        upperBound="-1"
        eOpposite="#//BookingInfo/bestOffers"/>
  </eClassifiers>

  <!-- RegularOffer -->
  <eClassifiers xsi:type="ecore:EClass" name="RegularOffer" eSuperTypes="#//Offer">
    <eStructuralFeatures xsi:type="ecore:EReference" name="travelSearches"
        eType="#//TravelSearch"
        upperBound="-1"
        eOpposite="#//TravelSearch/regularOffers"/>
  </eClassifiers>

  <!-- TravelPreference -->
  <eClassifiers xsi:type="ecore:EClass" name="TravelPreference">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="preference" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- BillingInformation -->
  <eClassifiers xsi:type="ecore:EClass" name="BillingInformation">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- TravelSearch -->
  <eClassifiers xsi:type="ecore:EClass" name="TravelSearch">
    <eStructuralFeatures xsi:type="ecore:EReference" name="searchInfo"
        eType="#//SearchInfo"
        lowerBound="1"
        upperBound="1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="travelPreferences"
        eType="#//TravelPreference"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="regularOffers"
        eType="#//RegularOffer"
        upperBound="-1"
        eOpposite="#//RegularOffer/travelSearches"/>
  </eClassifiers>

  <!-- Traveller -->
  <eClassifiers xsi:type="ecore:EClass" name="Traveller">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reliabilityRating" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="travelSearches"
        eType="#//TravelSearch"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="travelPreferences"
        eType="#//TravelPreference"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="billingInformation"
        eType="#//BillingInformation"
        lowerBound="1"
        upperBound="1"
        containment="true"/>
  </eClassifiers>

  <!-- Hotel -->
  <eClassifiers xsi:type="ecore:EClass" name="Hotel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="city" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="country" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="area" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="offers"
        eType="#//Offer"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roomAvailabilities"
        eType="#//RoomAvailability"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bookings"
        eType="#//Booking"
        upperBound="-1"
        eOpposite="#//Booking/hotel"/>
  </eClassifiers>

  <!-- HotelChain -->
  <eClassifiers xsi:type="ecore:EClass" name="HotelChain">
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotels"
        eType="#//Hotel"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- HotelBookingManager -->
  <eClassifiers xsi:type="ecore:EClass" name="HotelBookingManager">
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotelChains"
        eType="#//HotelChain"
        upperBound="-1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="travellers"
        eType="#//Traveller"
        upperBound="-1"
        containment="true"/>
  </eClassifiers>

  <!-- Booking -->
  <eClassifiers xsi:type="ecore:EClass" name="Booking">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bookingId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cancellationDeadline" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="creditCardNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bookingStatus" eType="#//BookingStatus"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentType" eType="#//PaymentType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="confirmationDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paidAmount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bookingInfo"
        eType="#//BookingInfo"
        lowerBound="1"
        upperBound="1"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="offer"
        eType="#//Offer"
        lowerBound="0"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="traveller"
        eType="#//Traveller"
        lowerBound="1"
        upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotel"
        eType="#//Hotel"
        lowerBound="1"
        upperBound="1"
        eOpposite="#//Hotel/bookings"/>
  </eClassifiers>

</ecore:EPackage>
