<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="hbms"
    nsURI="http://www.example.org/hbms"
    nsPrefix="hbms">

  <!-- Custom datatypes -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
      instanceClassName="java.time.LocalTime"/>

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="RoomType">
    <eLiterals name="SINGLE"/>
    <eLiterals name="DOUBLE"/>
    <eLiterals name="TWIN"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="BookingStatus">
    <eLiterals name="PRELIMINARY"/>
    <eLiterals name="FINALIZED"/>
    <eLiterals name="CONFIRMED"/>
    <eLiterals name="CANCELLED"/>
    <eLiterals name="COMPLETED"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="PaymentMode">
    <eLiterals name="PRE_PAID"/>
    <eLiterals name="PAY_AT_HOTEL"/>
  </eClassifiers>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="HBMSSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="travellers"
        eType="#//Traveller" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotels"
        eType="#//Hotel" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotelChains"
        eType="#//HotelChain" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cities"
        eType="#//City" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bookings"
        eType="#//Booking" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="searchRequests"
        eType="#//SearchRequest" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- City -->
  <eClassifiers xsi:type="ecore:EClass" name="City">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="country"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Address -->
  <eClassifiers xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="street"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="postalCode"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="area"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="city"
        eType="#//City"/>
  </eClassifiers>

  <!-- BillingInformation -->
  <eClassifiers xsi:type="ecore:EClass" name="BillingInformation">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="companyAddress"
        eType="#//Address" containment="true"/>
  </eClassifiers>

  <!-- CreditCardInformation -->
  <eClassifiers xsi:type="ecore:EClass" name="CreditCardInformation">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cardNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cardHolderName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expiryDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cvv"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- TravelPreference -->
  <eClassifiers xsi:type="ecore:EClass" name="TravelPreference">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Traveller -->
  <eClassifiers xsi:type="ecore:EClass" name="Traveller">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reliabilityRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="billingInformation"
        eType="#//BillingInformation" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="travelPreferences"
        eType="#//TravelPreference" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="creditCardInformation"
        eType="#//CreditCardInformation" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bookings"
        eType="#//Booking" upperBound="-1" eOpposite="#//Booking/traveller"/>
    <eOperations name="calculateReliabilityRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eOperations name="searchAccommodation" eType="#//SearchRequest">
      <eParameters name="request" eType="#//SearchRequest"/>
    </eOperations>
  </eClassifiers>

  <!-- HotelChain -->
  <eClassifiers xsi:type="ecore:EClass" name="HotelChain">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotels"
        eType="#//Hotel" upperBound="-1" eOpposite="#//Hotel/hotelChain"/>
  </eClassifiers>

  <!-- Hotel -->
  <eClassifiers xsi:type="ecore:EClass" name="Hotel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="starRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="address"
        eType="#//Address" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotelChain"
        eType="#//HotelChain" eOpposite="#//HotelChain/hotels"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roomAvailabilities"
        eType="#//RoomAvailability" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="offers"
        eType="#//HotelOffer" containment="true" upperBound="-1"
        eOpposite="#//HotelOffer/hotel"/>
    <eOperations name="announceRoomAvailability">
      <eParameters name="availability" eType="#//RoomAvailability"/>
    </eOperations>
    <eOperations name="reportRoomFullyBooked">
      <eParameters name="roomType" eType="#//RoomType"/>
      <eParameters name="periodStart"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
      <eParameters name="periodEnd"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    </eOperations>
    <eOperations name="provideSpecialOffer" eType="#//SpecialOffer">
      <eParameters name="preliminaryBooking" eType="#//PreliminaryBooking"/>
    </eOperations>
    <eOperations name="confirmBooking">
      <eParameters name="booking" eType="#//FinalizedBooking"/>
    </eOperations>
    <eOperations name="cancelConfirmedBooking">
      <eParameters name="booking" eType="#//FinalizedBooking"/>
    </eOperations>
  </eClassifiers>

  <!-- RoomAvailability -->
  <eClassifiers xsi:type="ecore:EClass" name="RoomAvailability">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType"
        eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodStart"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodEnd"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfRooms"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pricePerNight"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullyBooked"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- SearchRequest -->
  <eClassifiers xsi:type="ecore:EClass" name="SearchRequest">
    <eStructuralFeatures xsi:type="ecore:EReference" name="city"
        eType="#//City"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arrivalDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="departureDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfRooms"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType"
        eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minimumStarRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxCostPerNight"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="additionalPreferences"
        eType="#//TravelPreference" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="results"
        eType="#//HotelOffer" upperBound="-1"/>
  </eClassifiers>

  <!-- HotelOffer (abstract base for regular offer and special offer) -->
  <eClassifiers xsi:type="ecore:EClass" name="HotelOffer" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pricePerNight"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType"
        eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableFrom"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableTo"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hotel"
        eType="#//Hotel" eOpposite="#//Hotel/offers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="includedPreferences"
        eType="#//TravelPreference" upperBound="-1"/>
  </eClassifiers>

  <!-- RegularOffer -->
  <eClassifiers xsi:type="ecore:EClass" name="RegularOffer" eSuperTypes="#//HotelOffer">
  </eClassifiers>

  <!-- SpecialOffer -->
  <eClassifiers xsi:type="ecore:EClass" name="SpecialOffer" eSuperTypes="#//HotelOffer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="submittedAt"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="relatedPreliminaryBooking"
        eType="#//PreliminaryBooking"/>
  </eClassifiers>

  <!-- Booking (abstract) -->
  <eClassifiers xsi:type="ecore:EClass" name="Booking" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bookingId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//BookingStatus"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="arrivalDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="departureDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfRooms"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType"
        eType="#//RoomType"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalCost"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="createdAt"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="traveller"
        eType="#//Traveller" eOpposite="#//Traveller/bookings"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="offer"
        eType="#//HotelOffer"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appliedPreferences"
        eType="#//TravelPreference" upperBound="-1"/>
  </eClassifiers>

  <!-- PreliminaryBooking -->
  <eClassifiers xsi:type="ecore:EClass" name="PreliminaryBooking" eSuperTypes="#//Booking">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="specialOfferDeadline"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="receivedSpecialOffers"
        eType="#//SpecialOffer" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cityArea"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hotelRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eOperations name="selectSpecialOffer" eType="#//FinalizedBooking">
      <eParameters name="specialOffer" eType="#//SpecialOffer"/>
    </eOperations>
    <eOperations name="proceedWithOriginal" eType="#//FinalizedBooking">
      <eParameters name="creditCard" eType="#//CreditCardInformation"/>
      <eParameters name="paymentMode" eType="#//PaymentMode"/>
    </eOperations>
  </eClassifiers>

  <!-- FinalizedBooking -->
  <eClassifiers xsi:type="ecore:EClass" name="FinalizedBooking" eSuperTypes="#//Booking">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentMode"
        eType="#//PaymentMode"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="creditCardInformation"
        eType="#//CreditCardInformation" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="confirmationDeadline"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="confirmedAt"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cancellationDeadline"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cancelledAt"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="cancellationFeeCharged"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="financialCompensationOffered"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reimbursed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eOperations name="cancel">
      <eParameters name="cancelledAt"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    </eOperations>
    <eOperations name="confirm">
      <eParameters name="confirmedAt"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    </eOperations>
    <eOperations name="reimburse"/>
  </eClassifiers>

</ecore:EPackage>
