<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI"
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
         xmi:version="2.0">
  <ecore:EPackage name="HMBS" nsURI="http://www.example.org/HMBS" nsPrefix="hmbs">

    <!-- Root Container Class -->
    <eClassifiers xsi:type="ecore:EClass" name="HMBSModel">
      <eStructuralFeatures xsi:type="ecore:EReference" name="travellers"
                           eType="#//Traveller" containment="true"
                           lowerBound="0" upperBound="-1"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="hotels"
                           eType="#//Hotel" containment="true"
                           lowerBound="0" upperBound="-1"/>
    </eClassifiers>

    <!-- Traveller Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Traveller">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="billingInformation"
                           eType="#//BillingInformation" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="travelPreferences"
                           eType="#//TravelPreference" containment="true"
                           lowerBound="0" upperBound="-1"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="pastBookings"
                           eType="#//Booking" containment="true"
                           lowerBound="0" upperBound="-1"/>
    </eClassifiers>

    <!-- BillingInformation Class -->
    <eClassifiers xsi:type="ecore:EClass" name="BillingInformation">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyName"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- TravelPreference Class -->
    <eClassifiers xsi:type="ecore:EClass" name="TravelPreference">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="preferenceDescription"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- Hotel Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Hotel">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="city"
                           eType="#//City" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="hotelChain"
                           eType="#//HotelChain" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="availableRooms"
                           eType="#//RoomAvailability" containment="true"
                           lowerBound="0" upperBound="-1"/>
    </eClassifiers>

    <!-- City Class -->
    <eClassifiers xsi:type="ecore:EClass" name="City">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- HotelChain Class -->
    <eClassifiers xsi:type="ecore:EClass" name="HotelChain">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- RoomAvailability Class -->
    <eClassifiers xsi:type="ecore:EClass" name="RoomAvailability">
      <eStructuralFeatures xsi:type="ecore:EReference" name="roomType"
                           eType="#//RoomType"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate"
                           eType="#//DateTime"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="endDate"
                           eType="#//DateTime"/>
    </eClassifiers>

    <!-- RoomType Enum -->
    <eClassifiers xsi:type="ecore:EEnum" name="RoomType">
      <eLiterals xsi:type="ecore:EEnumLiteral" name="SINGLE"/>
      <eLiterals xsi:type="ecore:EEnumLiteral" name="DOUBLE"/>
      <eLiterals xsi:type="ecore:EEnumLiteral" name="TWIN"/>
    </eClassifiers>

    <!-- Booking Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Booking">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="bookingId"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="traveller"
                           eType="#//Traveller"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="hotel"
                           eType="#//Hotel"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="arrivalDate"
                           eType="#//DateTime"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="departureDate"
                           eType="#//DateTime"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="pricePerNight"
                           eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="roomType"
                           eType="#//RoomType"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
                           eType="#//BookingStatus"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentMethod"
                           eType="#//PaymentMethod"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="cancellationDeadline"
                           eType="#//DateTime"/>
    </eClassifiers>

    <!-- BookingStatus Enum -->
    <eClassifiers xsi:type="ecore:EEnum" name="BookingStatus">
      <eLiterals xsi:type="ecore:EEnumLiteral" name="PRELIMINARY"/>
      <eLiterals xsi:type="ecore:EEnumLiteral" name="CONFIRMED"/>
      <eLiterals xsi:type="ecore:EEnumLiteral" name="CANCELLED"/>
    </eClassifiers>

    <!-- PaymentMethod Enum -->
    <eClassifiers xsi:type="ecore:EEnum" name="PaymentMethod">
      <eLiterals xsi:type="ecore:EEnumLiteral" name="PRE_PAID"/>
      <eLiterals xsi:type="ecore:EEnumLiteral" name="PAY_AT_HOTEL"/>
    </eClassifiers>

    <!-- DateTime DataType -->
    <eClassifiers xsi:type="ecore:EDataType" name="DateTime">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
        <details key="value" value="java.time.LocalDateTime"/>
      </eAnnotations>
    </eClassifiers>

  </ecore:EPackage>
</xmi:XMI>
