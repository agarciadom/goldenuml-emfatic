@namespace(uri="http://hbms/hotel_booking", prefix="p")
package HBMS;

class Traveller {
  val BillingInfo billingInfo;
  ref TravelPreference[*] travelPreferences;
  val Booking[*] pastBookings;
}
class BillingInfo {
}
class TravelPreference {
}
class Hotel {
  val Address address;
  ref HotelChain hotelChain;
  val RoomAvailability[*] roomAvailabilities;
}
class HotelChain {
}
class Booking {
  ref Traveller traveller;
  ref Hotel hotel;
  val RoomType[*] roomTypes;
}
class PreliminaryBooking extends Booking {
  ref SearchParameters searchParams;
  ref SpecialOffer[*] specialOffers;
}
class SpecialOffer {
  attr String uniqueBookingIdentifier;
}
class RoomType {
}
class RoomAvailability {
  val RoomType roomType;
}
class City {
  val Hotel[*] hotels;
}
class Address {
  ref City city;
}
class SearchParameters {
  ref TravelPreference[*] additionalPreferences;
}