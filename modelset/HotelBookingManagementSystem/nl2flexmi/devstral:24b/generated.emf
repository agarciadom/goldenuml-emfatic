@namespace(uri="http://www.example.org/HBMS", prefix="hbms")
package HBMS;

import "http://www.eclipse.org/emf/2002/Ecore";

class Traveller {
	attr ecore.EString[1] name;
	ref BillingInformation billingInformation;
	ref TravelPreferences travelPreferences;
	ref Booking[*] pastBookings;
}

class BillingInformation {
	attr ecore.EString[1] companyName;
	attr ecore.EString[1] address;
}

class TravelPreferences {
	attr ecore.EBoolean breakfastIncluded;
	attr ecore.EBoolean freeWifi;
	attr ecore.EBoolean frontDesk247;
}

class AccommodationSearchCriteria {
	attr ecore.EString[1] city;
	attr ecore.EDate[1] arrivalDate;
	attr ecore.EDate[1] departureDate;
	attr ecore.EInt[1] numberOfRooms;
	ref RoomType[1] roomType;
	attr ecore.EInt minHotelRating;
	attr ecore.EBigDecimal maxCostPerNight;
	ref TravelPreferences travelPreferences;
}

class Hotel {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	attr ecore.EString[1] city;
	attr ecore.EInt rating;
	attr ecore.EString chainName;
}

class RoomType {
	attr ecore.EString[1] typeName;
}

class Booking {
	ref Traveller[1] traveller;
	ref Hotel[1] hotel;
	ref RoomType[1] roomType;
	attr ecore.EDate checkInDate;
	attr ecore.EDate checkOutDate;
	attr ecore.EBigDecimal totalCost;
	attr ecore.EBoolean isPrepaid;
	attr ecore.EString[1] bookingStatus;
	attr ecore.EDate cancellationDeadline;
	attr ecore.EDouble reliabilityRating;
}

class Offer {
	ref Booking[1] booking;
	attr ecore.EBigDecimal[1] specialPrice;
	attr ecore.EString cityArea;
	attr ecore.EInt hotelRating;
	ref TravelPreferences keyPreferences;
}


