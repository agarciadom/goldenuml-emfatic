<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HBMS" nsURI="http://www.example.org/HBMS" nsPrefix="hbms">
  <eClassifiers>
    <eClass name="Traveller">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="billingInformation" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="travelPreferences" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="pastBookings" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BillingInformation">
      <eStructuralFeatures>
        <eAttribute name="companyName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TravelPreferences">
      <eStructuralFeatures>
        <eAttribute name="breakfastIncluded" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="freeWifi" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="frontDesk247" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AccommodationSearchCriteria">
      <eStructuralFeatures>
        <eAttribute name="city" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="arrivalDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="departureDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfRooms" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="roomType" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eAttribute name="minHotelRating" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="maxCostPerNight" lowerBound="0" upperBound="1" eType="//EBigDecimal" />
        <eReference name="travelPreferences" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Hotel">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="city" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rating" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="chainName" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RoomType">
      <eStructuralFeatures>
        <eAttribute name="typeName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Booking">
      <eStructuralFeatures>
        <eReference name="traveller" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="hotel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="roomType" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eAttribute name="checkInDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="checkOutDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="totalCost" lowerBound="0" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="isPrepaid" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="bookingStatus" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="cancellationDeadline" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="reliabilityRating" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Offer">
      <eStructuralFeatures>
        <eReference name="booking" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="specialPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="cityArea" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="hotelRating" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="keyPreferences" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
