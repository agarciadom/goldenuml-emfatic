@namespace(uri="http://www.example.org/HBMS", prefix="hbms")
package HBMS;

import "http://www.eclipse.org/emf/2002/Ecore";

class Traveller {
	attr ecore.EString[1] name;
	attr ecore.EString[1] billingInfo;
	attr ecore.EString companyName;
	attr ecore.EString companyAddress;
	attr Set travelPreferences;
	attr ecore.EInt reliabilityRating;
}

class Booking {
	ref Traveller[1] traveller;
	ref Hotel[1] hotel;
	attr ecore.EBoolean prePaid;
	attr ecore.EBoolean confirmedByHotel;
	attr ecore.EDate cancellationDeadline;
	attr ecore.EString uniqueBookingIdentifier;
}

class Hotel {
	ref City[1] city;
	ref HotelChain chain;
	val RoomType[*] roomTypes;
	val Booking[*] bookings;
}

class HotelChain {
}

class City {
	val Hotel[*] hotels;
	ref RoomType[*] hotelTypes;
}

class RoomType {
	attr ecore.EString[1] type;
	attr ecore.EInt minimumRating;
	attr ecore.EDouble tentativeBudget;
	attr ecore.EDouble budgetPerNight;
	attr ecore.EDouble tentiveBudget;
}

datatype Set : java.util.Set;


