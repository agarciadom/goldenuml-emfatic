<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HBMS" nsURI="http://www.example.org/HBMS" nsPrefix="hbms">
  <eClassifiers>
    <eClass name="Traveller">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="billingInfo" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="companyName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="companyAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="travelPreferences" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="reliabilityRating" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Booking">
      <eStructuralFeatures>
        <eReference name="traveller" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="hotel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="prePaid" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="confirmedByHotel" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="cancellationDeadline" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="uniqueBookingIdentifier" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Hotel">
      <eStructuralFeatures>
        <eReference name="city" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="chain" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="roomTypes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="bookings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HotelChain">
      <eStructuralFeatures />
    </eClass>
    <eClass name="City">
      <eStructuralFeatures>
        <eReference name="hotels" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="hotelTypes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RoomType">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="minimumRating" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="tentativeBudget" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="budgetPerNight" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="tentiveBudget" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Set" instanceClassName="java.util.Set" />
  </eClassifiers>
</ePackage>
