@namespace(uri="http://www.hmbs.com/ns", prefix="hmbs")
package HMBS;

import "http://www.eclipse.org/emf/2002/Ecore";

class Traveller {
	attr ecore.EString[1] name;
	attr ecore.EDouble reliabilityRating;
	val BillingInformation[1] billingInfo;
	val TravelPreference[*] preferences;
	val Booking[*] bookings;
}

class BillingInformation {
	attr ecore.EString[1] companyName;
	attr ecore.EString[1] address;
}

class TravelPreference {
	attr ecore.EString[1] description;
}

class Hotel {
	attr ecore.EString[1] name;
	attr ecore.EString[1] city;
	attr ecore.EString[1] address;
	ref HotelChain chain;
	val RoomType[+] roomTypes;
}

class HotelChain {
	attr ecore.EString[1] name;
	val Hotel[*] hotels;
}

class RoomType {
	attr ecore.EString[1] typeName;
}

class Booking {
	attr ecore.EDate[1] dateOfArrival;
	attr ecore.EDate[1] dateOfDeparture;
	attr ecore.EInt[1] roomsNeeded;
	attr ecore.EString[1] bookingId;
	ref Traveller[1] traveller;
	ref Hotel[1] hotel;
	ref RoomType[1] roomType;
}

class PreliminaryBooking extends Booking {
	attr ecore.EDouble[1] price;
	attr ecore.EString[1] cityArea;
	attr ecore.EInt[1] hotelRating;
	val Offer[*] specialOffers;
}

class FinalizedBooking extends Booking {
	attr ecore.EString[1] paymentType;
	attr ecore.EDate cancellationDeadline;
	attr ecore.EBoolean[1] confirmationStatus;
	ref CreditCardInfo[1] creditCard;
}

class Offer {
	attr ecore.EDouble[1] offerPrice;
	attr ecore.EInt[1] validityPeriod;
	ref Hotel[1] providingHotel;
}

class CreditCardInfo {
	attr ecore.EString[1] cardNumber;
	attr ecore.EDate[1] expiryDate;
	attr ecore.EString[1] cvv;
}


