<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HMBS" nsURI="http://www.hmbs.com/ns" nsPrefix="hmbs">
  <eClassifiers>
    <eClass name="Traveller">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="reliabilityRating" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="billingInfo" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="preferences" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="bookings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BillingInformation">
      <eStructuralFeatures>
        <eAttribute name="companyName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TravelPreference">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Hotel">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="city" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="chain" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="roomTypes" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HotelChain">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="hotels" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RoomType">
      <eStructuralFeatures>
        <eAttribute name="typeName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Booking">
      <eStructuralFeatures>
        <eAttribute name="dateOfArrival" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dateOfDeparture" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="roomsNeeded" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="bookingId" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="traveller" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="hotel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="roomType" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PreliminaryBooking" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="cityArea" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="hotelRating" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="specialOffers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FinalizedBooking" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="paymentType" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="cancellationDeadline" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="confirmationStatus" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="creditCard" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Offer">
      <eStructuralFeatures>
        <eAttribute name="offerPrice" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="validityPeriod" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="providingHotel" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreditCardInfo">
      <eStructuralFeatures>
        <eAttribute name="cardNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="expiryDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="cvv" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
