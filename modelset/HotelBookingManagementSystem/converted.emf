@namespace(uri="http://www.example.org/hotelbooking", prefix="hotelbooking")
package hotelbooking;

enum RoomType {
	SINGLE = 0;
	DOUBLE = 0;
	TWIN = 0;
}

enum BookingStatus {
	FINALIZED = 0;
	CONFIRMED = 0;
	CANCELLED_BY_HBMS = 0;
	PRELIMINARY = 0;
	CANCELLED_BY_TRAVELLER = 0;
	CANCELLED_BY_HOTEL = 0;
}

enum PaymentType {
	PREPAID = 0;
	PAID_AT_HOTEL = 0;
}

abstract class TripInfo {
	attr int numberOfRooms;
	attr RoomType roomType;
	attr EDate arrivalDate;
	attr EDate departureDate;
	attr float budgetPerNight;
}

class RoomAvailability extends TripInfo {
}

class SearchInfo extends TripInfo {
}

class BookingInfo extends TripInfo {
	ref SpecialOffer[*]#bookingInfo specialOffers;
	ref SpecialOffer[0..5]#bestOfferBookingInfo bestOffers;
}

abstract class Offer {
}

class SpecialOffer extends Offer {
	ref BookingInfo[*]#specialOffers bookingInfo;
	ref BookingInfo[*]#bestOffers bestOfferBookingInfo;
}

class RegularOffer extends Offer {
	ref TravelSearch[*]#regularOffers travelSearches;
}

class TravelPreference {
	attr String preference;
	attr String value;
}

class BillingInformation {
	attr String companyName;
	attr String address;
}

class TravelSearch {
	val SearchInfo[1] searchInfo;
	val TravelPreference[*] travelPreferences;
	ref RegularOffer[*]#travelSearches regularOffers;
}

class Traveller {
	attr String name;
	attr int reliabilityRating;
	val TravelSearch[*] travelSearches;
	val TravelPreference[*] travelPreferences;
	val BillingInformation[1] billingInformation;
}

class Hotel {
	attr String city;
	attr String country;
	attr String area;
	val Offer[*] offers;
	val RoomAvailability[*] roomAvailabilities;
	ref Booking[*]#hotel bookings;
}

class HotelChain {
	val Hotel[*] hotels;
}

class HotelBookingManager {
	val HotelChain[*] hotelChains;
	val Traveller[*] travellers;
}

class Booking {
	attr int bookingId;
	attr EDate cancellationDeadline;
	attr String creditCardNumber;
	attr BookingStatus bookingStatus;
	attr PaymentType paymentType;
	attr EDate confirmationDate;
	attr float paidAmount;
	val BookingInfo[1] bookingInfo;
	ref Offer offer;
	ref Traveller[1] traveller;
	ref Hotel[1]#bookings hotel;
}


