@namespace(uri="http://example.org/ebike", prefix="ebike")
package EBikePackage;

import "http://www.eclipse.org/emf/2002/Ecore";

class EBike {
	val Frame[1] frame;
	val DriveSystem[1] driveSystem;
	ref Battery battery;
	ref Controller[1] controller;
}

class Frame {
	attr ecore.EString[1] material;
	ref Wheel[2] wheels;
}

class DriveSystem {
	val Motor[1] motor;
}

class Motor {
}

class Wheel {
}

class Battery {
	attr ecore.EInt[1] storedEnergyWh;
}

class Controller {
	val State[1] state;
}

class BasicController extends Controller {
}

class AdvancedController extends Controller {
	val Date nextMaintenanceDate;
}

class State {
	attr ecore.EString[1] value;
}

class Date {
	attr ecore.EString[1] value;
}


