@namespace(uri="http://example.com/ebikemodel", prefix="ebike")
package EBikeModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class EBike {
	val Frame[1] frame;
	val Controller[1] controller;
	val DriveSystem[1] driveSystem;
}

class Frame {
	val Wheel[2] wheels;
	attr ecore.EString[1] material;
}

class Wheel {
}

class DriveSystem {
	val Motor[1] motor;
}

class Motor {
}

class Battery {
	attr ecore.EInt[1] storedEnergyWh;
}

class Controller {
	attr ecore.EString[1] state;
	ref Battery battery;
	ref DriveSystem[1] driveSystem;
}

class BasicController extends Controller {
}

class AdvancedController extends Controller {
	attr ecore.EDate nextInspectionDate;
}


