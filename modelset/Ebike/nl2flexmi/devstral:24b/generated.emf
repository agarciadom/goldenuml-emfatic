@namespace(uri="http://example.com/ebikesystem", prefix="ebikesys")
package EBikeSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class EBike {
	val Frame[1] Frame;
	val DriveSystem[1] DriveSystem;
	val ControllerBase[1] Controller;
	val Battery Battery;
}

class Frame {
	attr ecore.EString[1] Material;
	val Wheel[1] Wheel1;
	val Wheel[1] Wheel2;
}

class Wheel {
	attr ecore.EInt[1] Size;
}

class DriveSystem {
	val Motor[1] Motor;
}

class Motor {
	attr ecore.EDouble[1] Power;
}

class ControllerBase {
	attr ecore.EString[1] State;
}

class AdvancedController extends ControllerBase {
	attr ecore.EDate NextInspectionDate;
}

class Battery {
	attr ecore.EDouble[1] StoredEnergy;
}


