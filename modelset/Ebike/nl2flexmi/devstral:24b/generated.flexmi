<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EBikePackage" nsURI="http://www.example.org/ebikepackage" nsPrefix="ebp">
  <eClassifiers>
    <eClass name="Frame">
      <eStructuralFeatures>
        <eAttribute name="material" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="wheels" containment="True" lowerBound="2" upperBound="2" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Wheel">
      <eStructuralFeatures />
    </eClass>
    <eClass name="DriveSystem">
      <eStructuralFeatures>
        <eReference name="motor" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Motor">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Controller">
      <eStructuralFeatures>
        <eAttribute name="state" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="controlledBattery" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="driveSystem" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Battery">
      <eStructuralFeatures>
        <eAttribute name="storedEnergy" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EBike">
      <eStructuralFeatures>
        <eReference name="frame" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="driveSystem" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="battery" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BasicController" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures />
    </eClass>
    <eClass name="AdvancedController" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="nextInspectionDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="ControllerState" instanceClassName="" />
  </eClassifiers>
</ePackage>
