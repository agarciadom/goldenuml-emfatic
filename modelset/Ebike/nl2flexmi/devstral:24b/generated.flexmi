<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EBikeSystem" nsURI="http://example.com/ebikesystem" nsPrefix="ebikesys">
  <eClassifiers>
    <eClass name="EBike">
      <eStructuralFeatures>
        <eReference name="Frame" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="DriveSystem" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="Controller" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="Battery" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Frame">
      <eStructuralFeatures>
        <eAttribute name="Material" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="Wheel1" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="Wheel2" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Wheel">
      <eStructuralFeatures>
        <eAttribute name="Size" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DriveSystem">
      <eStructuralFeatures>
        <eReference name="Motor" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Motor">
      <eStructuralFeatures>
        <eAttribute name="Power" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ControllerBase">
      <eStructuralFeatures>
        <eAttribute name="State" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdvancedController" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="NextInspectionDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Battery">
      <eStructuralFeatures>
        <eAttribute name="StoredEnergy" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
