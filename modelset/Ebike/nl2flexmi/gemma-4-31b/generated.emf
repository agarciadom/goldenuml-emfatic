@namespace(uri="http://example.com/ebike", prefix="ebike")
package EBikePackage;

import "http://www.eclipse.org/emf/2002/Ecore";

class EBike {
	val Frame[1] frame;
	val DriveSystem[1] driveSystem;
	val Controller[1] controller;
	ref Battery battery;
}

class Frame {
	attr ecore.EString material;
	val Wheel[2] wheels;
}

class Wheel {
}

class DriveSystem {
	val Motor[1] motor;
}

class Motor {
}

class Controller {
	attr ecore.EString state;
	ref Battery controlledBattery;
	ref DriveSystem[1] commandedDriveSystem;
}

class BasicController extends Controller {
}

class AdvancedController extends Controller {
	attr ecore.EDate nextInspectionDate;
}

class Battery {
	attr ecore.EDouble storedEnergy;
}


