<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EBikePackage" nsURI="http://example.com/ebike" nsPrefix="ebike">
  <eClassifiers>
    <eClass name="EBike">
      <eStructuralFeatures>
        <eReference name="frame" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="driveSystem" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="controller" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="battery" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Frame">
      <eStructuralFeatures>
        <eAttribute name="material" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="wheels" containment="True" lowerBound="2" upperBound="2" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Wheel">
      <eStructuralFeatures />
    </eClass>
    <eClass name="DriveSystem">
      <eStructuralFeatures>
        <eReference name="motor" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Motor">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Controller">
      <eStructuralFeatures>
        <eAttribute name="state" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="controlledBattery" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="commandedDriveSystem" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BasicController" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
    <eClass name="AdvancedController" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="nextInspectionDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Battery">
      <eStructuralFeatures>
        <eAttribute name="storedEnergy" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
