<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="ebike"
    nsURI="http://www.example.org/ebike"
    nsPrefix="ebike">

  <eClassifiers xsi:type="ecore:EClass" name="EBike">
    <eStructuralFeatures xsi:type="ecore:EReference" name="frame"
        eType="#//Frame" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driveSystem"
        eType="#//DriveSystem" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="controller"
        eType="#//Controller" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="battery"
        eType="#//Battery" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="wheel"
        eType="#//Wheel" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Frame">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="steel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Wheel"/>

  <eClassifiers xsi:type="ecore:EClass" name="DriveSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="motor"
        eType="#//Motor" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Motor"/>

  <eClassifiers xsi:type="ecore:EClass" name="Controller" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentState"
        eType="#//State"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="battery"
        eType="#//Battery"/>
    <eOperations name="commandDriveSystem"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="BasicController" eSuperTypes="#//Controller"/>

  <eClassifiers xsi:type="ecore:EClass" name="AdvancedController" eSuperTypes="#//Controller">
    <eOperations name="nextInspection"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Battery">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="storedEnergy"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="State">
    <eLiterals name="On" value="0"/>
    <eLiterals name="Off" value="1"/>
    <eLiterals name="Charging" value="2"/>
  </eClassifiers>

</ecore:EPackage>
