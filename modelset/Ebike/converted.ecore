<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="ebike"
    nsURI="http://www.example.org/ebike"
    nsPrefix="ebike">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="EBikeSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="bikes"
        eType="#//EBike" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="frames"
        eType="#//Frame" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="wheels"
        eType="#//Wheel" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driveSystems"
        eType="#//DriveSystem" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="motors"
        eType="#//Motor" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="controllers"
        eType="#//Controller" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="batteries"
        eType="#//Battery" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- EBike class -->
  <eClassifiers xsi:type="ecore:EClass" name="EBike">
    <eStructuralFeatures xsi:type="ecore:EReference" name="frame"
        eType="#//Frame"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driveSystem"
        eType="#//DriveSystem"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="controller"
        eType="#//Controller"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="battery"
        eType="#//Battery"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="wheel"
        eType="#//Wheel"/>
  </eClassifiers>

  <!-- Frame class -->
  <eClassifiers xsi:type="ecore:EClass" name="Frame">
    <!-- 'steel' represents a material property modeled as a String attribute -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="steel"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Wheel class -->
  <eClassifiers xsi:type="ecore:EClass" name="Wheel"/>

  <!-- DriveSystem class -->
  <eClassifiers xsi:type="ecore:EClass" name="DriveSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="motor"
        eType="#//Motor"/>
  </eClassifiers>

  <!-- Motor class -->
  <eClassifiers xsi:type="ecore:EClass" name="Motor"/>

  <!-- Controller class (abstract, since it has concrete subclasses) -->
  <eClassifiers xsi:type="ecore:EClass" name="Controller" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentState"
        eType="#//State"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="battery"
        eType="#//Battery"/>
    <eOperations name="commandDriveSystem"/>
  </eClassifiers>

  <!-- BasicController class -->
  <eClassifiers xsi:type="ecore:EClass" name="BasicController"
      eSuperTypes="#//Controller"/>

  <!-- AdvancedController class -->
  <eClassifiers xsi:type="ecore:EClass" name="AdvancedController"
      eSuperTypes="#//Controller">
    <eOperations name="nextInspection"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>

  <!-- Battery class -->
  <eClassifiers xsi:type="ecore:EClass" name="Battery">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="storedEnergy"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
  </eClassifiers>

  <!-- State enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="State">
    <eLiterals name="On"/>
    <eLiterals name="Off" value="1"/>
    <eLiterals name="Charging" value="2"/>
  </eClassifiers>

</ecore:EPackage>
