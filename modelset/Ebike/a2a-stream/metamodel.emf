@namespace(uri="http://www.example.org/ebike", prefix="p")
package EBikePackage;

class EBike {
  val Frame frame;
  val DriveSystem driveSystem;
  val Wheel[*] wheels;
  ref Battery battery;
  val Controller controller;
}
class Frame {
  attr String materialType;
  val Wheel[*] wheels;
}
class DriveSystem {
  val Motor motor;
}
class Controller {
  attr String state;
}
class Battery {
  attr float storedEnergy;
}
class Wheel {
}
class Motor {
}
class BasicController extends Controller {
}
class AdvancedController extends Controller {
  attr Date nextInspectionDate;
}