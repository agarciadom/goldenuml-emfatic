@namespace(uri="http://www.example.org/ebike", prefix="ebike")
package ebike;

class EBikeSystem {
	val EBike[*] bikes;
	val Frame[*] frames;
	val Wheel[*] wheels;
	val DriveSystem[*] driveSystems;
	val Motor[*] motors;
	val Controller[*] controllers;
	val Battery[*] batteries;
}

class EBike {
	ref Frame frame;
	ref DriveSystem driveSystem;
	ref Controller controller;
	ref Battery battery;
	ref Wheel wheel;
}

class Frame {
	attr String steel;
}

class Wheel {
}

class DriveSystem {
	ref Motor motor;
}

class Motor {
}

abstract class Controller {
	op void commandDriveSystem();
	attr State currentState;
	ref Battery battery;
}

class BasicController extends Controller {
}

class AdvancedController extends Controller {
	op EDate nextInspection();
}

class Battery {
	attr float storedEnergy;
}

enum State {
	On = 0;
	Off = 1;
	Charging = 2;
}


