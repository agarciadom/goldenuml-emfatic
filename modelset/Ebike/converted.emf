@namespace(uri="http://www.example.org/ebike", prefix="ebike")
package ebike;

class EBike {
	val Frame frame;
	val DriveSystem driveSystem;
	val Controller controller;
	val Battery battery;
	val Wheel wheel;
}

class Frame {
	attr String steel;
}

class Wheel {
}

class DriveSystem {
	val Motor motor;
}

class Motor {
}

abstract class Controller {
	op void commandDriveSystem();
	attr State currentState;
	ref Battery battery;
}

class BasicController extends Controller {
}

class AdvancedController extends Controller {
	op EDate nextInspection();
}

class Battery {
	attr float storedEnergy;
}

enum State {
	On = 0;
	Off = 1;
	Charging = 2;
}


