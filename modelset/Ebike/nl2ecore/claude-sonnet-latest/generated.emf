@namespace(uri="http://www.example.org/ebike", prefix="ebike")
package ebike;

datatype LocalDate : java.time.LocalDate;

class EBikeSystem {
	val EBike[*] ebikes;
	val Battery[*] batteries;
}

class EBike {
	val Frame[1] frame;
	val DriveSystem[1] driveSystem;
	val Controller[1] controller;
	ref Battery battery;
}

class Frame {
	attr String material = "steel";
	val Wheel[2] wheels;
}

class Wheel {
}

class DriveSystem {
	val Motor[1] motor;
}

class Motor {
}

enum ControllerState {
	On = 0;
	Off = 1;
	Charging = 2;
}

abstract class Controller {
	attr ControllerState[1] state;
	ref Battery battery;
	ref DriveSystem[1] driveSystem;
}

class BasicController extends Controller {
}

class AdvancedController extends Controller {
	op LocalDate estimateNextInspectionDate();
}

class Battery {
	attr double[1] storedEnergyWh;
}


