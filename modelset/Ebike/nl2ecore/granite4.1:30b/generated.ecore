<xmi:XMI xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
         xmlns:ecl="http://www.eclipse.org/emf/2002/Ecore">
  <!-- Root package for the model -->
  <ecl:EPackage xmi:id="_package0" name="ebike" nillable="true">

    <!-- Root container class that holds all EBike instances -->
    <ecl:EClass xmi:id="_EBikeModel" name="EBikeModel">
      <!-- Holds a list of EBike objects (containment) -->
      <ecl:EReference xmi:id="_ebikes" name="ebikes"
                      eType="_EBike" upper="-1" containment="true"/>
    </ecl:EClass>

    <!-- Main EBike class -->
    <ecl:EClass xmi:id="_EBike" name="EBike">
      <!-- Composition references -->
      <ecl:EReference xmi:id="_ebikeFrame"   name="frame"
                      eType="_Frame"   lower="0" upper="1"/>
      <ecl:EReference xmi:id="_ebikeDriveSystem" name="driveSystem"
                      eType="_DriveSystem" upper="-1"/>
      <ecl:EReference xmi:id="_ebikeController" name="controller"
                      eType="_Controller" lower="0" upper="1"/>
      <ecl:EReference xmi:id="_ebikeBattery"   name="battery"
                      eType="_Battery"   upper="-1"/>
    </ecl:EClass>

    <!-- Frame (steel) -->
    <ecl:EClass xmi:id="_Frame" name="Frame">
      <ecl:EAttribute xmi:id="_frameMaterial" name="material"
                       eType="ecl:EString" default="steel"/>
      <!-- Two wheels per frame, containment indicates owned by the frame -->
      <ecl:EReference xmi:id="_frameWheels" name="wheels"
                      eType="_Wheel" upper="-1" containment="true"/>
    </ecl:EClass>

    <!-- Drive system contains a motor -->
    <ecl:EClass xmi:id="_DriveSystem" name="DriveSystem">
      <ecl:EReference xmi:id="_driveMotor" name="motor"
                      eType="_Motor" lower="0" upper="1"/>
    </ecl:EClass>

    <!-- Battery with stored energy in Wh -->
    <ecl:EClass xmi:id="_Battery" name="Battery">
      <ecl:EAttribute xmi:id="_storedEnergyWh" name="storedEnergyWh"
                       eType="ecl:ELong" default="0"/>
    </ecl:EClass>

    <!-- Simple wheel class (no attributes needed) -->
    <ecl:EClass xmi:id="_Wheel" name="Wheel"/>

    <!-- Motor class (placeholder for future details) -->
    <ecl:EClass xmi:id="_Motor" name="Motor"/>

    <!-- Controller hierarchy -->
    <ecl:EClass xmi:id="_Controller" name="Controller">
      <!-- State of the controller -->
      <ecl:EAttribute xmi:id="_controllerState" name="state"
                       eType="_ControllerState" default="Off"/>
    </ecl:EClass>

    <!-- Basic (non‑advanced) controller -->
    <ecl:EClass xmi:id="_BasicController" name="BasicController"
                eSuperTypes="_Controller"/>

    <!-- Advanced controller with maintenance estimation capability -->
    <ecl:EClass xmi:id="_AdvancedController" name="AdvancedController"
                eSuperTypes="_Controller">
      <!-- Estimated next inspection date (date‑only) -->
      <ecl:EAttribute xmi:id="_nextInspectionDate" name="nextInspectionDate"
                       eType="ecl:EDate"/>
      <!-- Operation that returns the estimated date (body omitted for brevity) -->
      <ecl:EOperation xmi:id="_estimateNextInspectionDate" name="estimateNextInspectionDate"
                      returnType="ecl:EDate">
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore-OCL/Pivot">
          <detail key="body" value="..."/>
          <detail key="description" value="Estimates the next maintenance inspection date."/>
        </eAnnotations>
      </ecl:EOperation>
    </ecl:EClass>

    <!-- Enumeration for controller states -->
    <ecl:EEnum xmi:id="_ControllerState" name="ControllerState">
      <eLiterals>
        <ecl:EEnumLiteral xmi:id="_On"   name="On"   literal="1"/>
        <ecl:EEnumLiteral xmi:id="_Off"  name="Off"  literal="0"/>
        <ecl:EEnumLiteral xmi:id="_Charging" name="Charging" literal="2"/>
      </eLiterals>
    </ecl:EEnum>

    <!-- Package contents – list all classifiers defined above -->
    <ecl:EClassifiers>
      <item elementID="_EBikeModel"/>
      <item elementID="_EBike"/>
      <item elementID="_Frame"/>
      <item elementID="_DriveSystem"/>
      <item elementID="_Controller"/>
      <item elementID="_BasicController"/>
      <item elementID="_AdvancedController"/>
      <item elementID="_Battery"/>
      <item elementID="_Wheel"/>
      <item elementID="_Motor"/>
      <item elementID="_ControllerState"/>
    </ecl:EClassifiers>

  </ecl:EPackage>
</xmi:XMI>
