<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ePackage name="AlphaInsurance" nsUri="http://www.alphainsurance.com/model">
    
    <!-- Root Container for the system -->
    <eClass name="RootContainer">
      <eStructuralFeatures>
        <eReference name="customers" reference="Customer"/>
        <eReference name="brokers" reference="Broker"/>
        <eReference name="policyTypes" reference="InsurancePolicyType"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="customerName" type="eString"/>
        <eAttribute name="email" type="eString"/>
        <eReference name="assignedBroker" reference="Broker"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Broker">
      <eStructuralFeatures>
        <eAttribute name="brokerName" type="eString"/>
        <eAttribute name="employeeId" type="eString"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="InsurancePolicyType">
      <eStructuralFeatures>
        <eAttribute name="typeName" type="eString"/>
        <eAttribute name="description" type="eString"/>
        <eAttribute name="basePrice" type="eDouble"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Offer">
      <eStructuralFeatures>
        <eAttribute name="offerDate" type="eDate"/>
        <eAttribute name="amount" type="eDouble"/>
        <eAttribute name="isEmailOffer" type="eBoolean"/>
        <eReference name="recipient" reference="Customer"/>
        <eReference name="policyType" reference="InsurancePolicyType"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="signingDate" type="eDate"/>
        <eAttribute name="price" type="eDouble"/>
        <eAttribute name="billingCycle" type="eString"/>
        <eReference name="client" reference="Customer"/>
        <eReference name="policyType" reference="InsurancePolicyType"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceDate" type="eDate"/>
        <eAttribute name="amount" type="eDouble"/>
        <eReference name="contract" reference="Contract"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Claim">
      <eStructuralFeatures>
        <eAttribute name="claimDate" type="eDate"/>
        <eAttribute name="description" type="eString"/>
        <eReference name="customer" reference="Customer"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="ClaimCase">
      <eStructuralFeatures>
        <eAttribute name="caseType" type="eString"/>
        <eAttribute name="status" type="eString"/>
        <eReference name="parentClaim" reference="Claim"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Estimator">
      <eStructuralFeatures>
        <eAttribute name="estimatorName" type="eString"/>
        <eAttribute name="areaOfExpertise" type="eString"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="EstimationReport">
      <eStructuralFeatures>
        <eAttribute name="reportDate" type="eDate"/>
        <eAttribute name="findings" type="eString"/>
        <eAttribute name="estimatedValue" type="eDouble"/>
        <eReference name="author" reference="Estimator"/>
        <eReference name="targetCase" reference="ClaimCase"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="CompensationDecision">
      <eStructuralFeatures>
        <eAttribute name="decisionDate" type="eDate"/>
        <eAttribute name="isApproved" type="eBoolean"/>
        <eAttribute name="eligibleAmount" type="eDouble"/>
        <eReference name="claimCase" reference="ClaimCase"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="paymentDate" type="eDate"/>
        <eAttribute name="finalAmountPaid" type="eDouble"/>
        <eReference name="decision" reference="CompensationDecision"/>
        <eReference name="recipientAccount" reference="Customer"/>
      </eStructuralFeatures>
    </eClass>

  </ePackage>
</xmi:XMI>
