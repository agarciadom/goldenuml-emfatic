<model xsi:type="ecore:EPackage" name="alpha_insurance" nsURI="alpha_insurance" nsWithPrefix="">
  <eClassifiers>
    <!-- AlphaInsurance as root container -->
    <eClassifiers xsi:type="ecore:EClass" name="AlphaInsurance" />

    <!-- Person -->
    <eClassifiers xsi:type="ecore:EClass" name="Person">
      <eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore://EString" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" eType="ecore://EString" />
      </eStructuralFeatures>
    </eClassifiers>

    <!-- Customer -->
    <eClassifiers xsi:type="ecore:EClass" name="Customer" eSuperTypes="ecore://Person">
      <eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="contracts" eType="ecore://Contract" upper="-1" contain="true" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="claims" eType="ecore://Claim" upper="-1" contain="true" />
      </eStructuralFeatures>
    </eClassifiers>

    <!-- Broker -->
    <eClassifiers xsi:type="ecore:EClass" name="Broker" eSuperTypes="ecore://Person">
      <eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="assignedCustomers" eType="ecore://Customer" upper="-1" contain="true" />
      </eStructuralFeatures>
      <eOperations>
        <eOperation name="assignToCustomer">
          <eParameters xsi:type="ecore:EParameter" name="customer" eType="ecore://Customer" />
        </eOperation>
        <eOperation name="assessProfile">
          <eParameters xsi:type="ecore:EParameter" name="customer" eType="ecore://Customer" />
        </eOperation>
        <eOperation name="sendForAnalysis">
          <eParameters xsi:type="ecore:EParameter" name="customerFile" eType="ecore://CustomerFile" />
        </eOperation>
      </eOperations>
    </eClassifiers>

    <!-- Contract -->
    <eClassifiers xsi:type="ecore:EClass" name="Contract">
      <eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EReference" name="customer" eType="ecore://Customer" />
        <eStructuralFeatures xsi:type="ecore:EReference" name="insurancePolicy" eType="ecore://InsurancePolicy" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="signingDate" eType="java.time.LocalDateTime" />
      </eStructuralFeatures>
      <eOperations>
        <eOperation name="makeOffer">
          <eParameters xsi:type="ecore:EParameter" name="insurancePolicy" eType="ecore://InsurancePolicy" />
          <eParameters xsi:type="ecore:EParameter" name="offerDate" eType="java.time.LocalDateTime" />
        </eOperation>
        <eOperation name="signContract">
          <eParameters xsi:type="ecore:EParameter" name="signingDate" eType="java.time.LocalDateTime" />
        </eOperation>
      </eOperations>
    </eClassifiers>

    <!-- InsurancePolicy -->
    <eClassifiers xsi:type="ecore:EClass" name="InsurancePolicy">
      <eStructuralFeatures>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="ecore://EString" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="price" eType="java.lang.Double" />
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="billingFrequency" eType="ecore://BillingFrequency" />
      </eStructuralFeatures>
    </eClassifiers>

    <!-- BillingFrequency Enumeration -->
    <eClassifiers xsi:type="ecore:EEnum" name="BillingFrequency">
      <eLiterals value="MONTHLY" />
      <eLiterals value="YEARLY" />
    </eLiterals>
  </eEnum>

  <!-- Claim -->
  <eClassifiers xsi:type="ecore:EClass" name="Claim">
    <eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="customer" eType="ecore://Customer" />
      <eStructuralFeatures xsi:type="ecore:EReference" name="claimCases" eType="ecore://ClaimCase" upper="-1" contain="true" />
    </eStructuralFeatures>
    <eOperations>
      <eOperation name="submitClaim">
        <eParameters xsi:type="ecore:EParameter" name="documents" eType="ecore://EDocument" upper="-1" />
      </eParameters>
    </eOperation>
  </eOperations>
</eClassifiers>

<!-- ClaimCase -->
<eClassifiers xsi:type="ecore:EClass" name="ClaimCase">
  <eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="claim" eType="ecore://Claim" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="estimatorReports" eType="ecore://EstimatorReport" upper="-1" contain="true" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="approvalStatus" eType="ecore://ApprovalStatus" />
  </eStructuralFeatures>
  <eOperations>
    <eOperation name="assessCase">
      <eParameters xsi:type="ecore:EParameter" name="estimator" eType="ecore://Estimator" />
    </eParameters>
  </eOperation>
  <eOperation name="decideApproval" />
  <eOperation name="calculateCompensation">
    <eParameters xsi:type="ecore:EParameter" name="documents" eType="ecore://EDocument" upper="-1" />
    <eReturnTypes xsi:type="ecore:ETypeReference" name="java.lang.Double" />
  </eParameters>
</eOperations>
</eClassifiers>

<!-- ApprovalStatus Enumeration -->
<eClassifiers xsi:type="ecore:EEnum" name="ApprovalStatus">
  <eLiterals value="PENDING" />
  <eLiterals value="APPROVED" />
  <eLiterals value="REJECTED" />
</eLiterals>
</eEnum>

<!-- EstimatorReport -->
<eClassifiers xsi:type="ecore:EClass" name="EstimatorReport">
  <eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="claimCase" eType="ecore://ClaimCase" />
    <eStructuralFeatures xsi:type="ecore:EReference" name="estimator" eType="ecore://Estimator" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reportDate" eType="java.time.LocalDateTime" />
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="content" eType="ecore://EString" />
  </eStructuralFeatures>
</eClassifiers>

<!-- Estimator -->
<eClassifiers xsi:type="ecore:EClass" name="Estimator">
  <eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expertiseArea" eType="ecore://EString" />
  </eStructuralFeatures>
</eClassifiers>

<!-- EDocument DataType -->
<eClassifiers xsi:type="ecore:EDataType" name="EDocument">
  <eBaseType href="ecore://EByteObjectType"/>
</eDataType>
</eClassifiers>
</model>
