<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI"
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
         xmi:version="2.0">
  <ecore:EPackage name="alphaInsurance" nsURI="http://alphaInsurance" nsPrefix="alphaInsurance" xmi:id="package_1">

    <!-- RootContainer Class -->
    <ecore:EClass name="RootContainer" xmi:id="class_rootcontainer">
      <eStructuralFeatures xmi:type="ecore:EReference" name="brokers" eType="#//Broker" lowerBound="0" upperBound="-1"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="customers" eType="#//Customer" lowerBound="0" upperBound="-1"/>
    </ecore:EClass>

    <!-- Broker Class -->
    <ecore:EClass name="Broker" xmi:id="class_broker">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="brokerId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </ecore:EClass>

    <!-- Customer Class -->
    <ecore:EClass name="Customer" xmi:id="class_customer">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="customerId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="broker" eType="#//Broker" lowerBound="1"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="contracts" eType="#//Contract" lowerBound="0" upperBound="-1"/>
    </ecore:EClass>

    <!-- InsuranceProduct Class -->
    <ecore:EClass name="InsuranceProduct" xmi:id="class_insuranceproduct">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="productId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </ecore:EClass>

    <!-- Contract Class -->
    <ecore:EClass name="Contract" xmi:id="class_contract">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="contractId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="customer" eType="#//Customer" lowerBound="1"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="insuranceProduct" eType="#//InsuranceProduct" lowerBound="1"/>
    </ecore:EClass>

    <!-- ClaimCase Class -->
    <ecore:EClass name="ClaimCase" xmi:id="class_claimcase">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="caseId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </ecore:EClass>

    <!-- EstimatorReport Class -->
    <ecore:EClass name="EstimatorReport" xmi:id="class_estimatorreport">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="reportId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    </ecore:EClass>

    <!-- Association class for ClaimCase and EstimatorReport -->
    <ecore:EClass name="ClaimCaseEstimatorReport" xmi:id="class_claimcaseestimatorreport">
      <eStructuralFeatures xmi:type="ecore:EReference" name="claimCase" eType="#//ClaimCase"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="estimatorReport" eType="#//EstimatorReport"/>
    </ecore:EClass>

    <!-- Custom Data Type for Date -->
    <ecore:EDataType name="EDate" instanceClassName="java.time.LocalDate" xmi:id="datatype_date">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
        <details key="documentation">Represents a date without time zone in the ISO-8601 calendar system.</details>
      </eAnnotations>
    </ecore:EDataType>

  </ecore:EPackage>
</xmi:XMI>
