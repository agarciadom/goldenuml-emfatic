@namespace(uri="http://www.example.org/insurance", prefix="insurance")
package insurance;

class InsuranceSystem {
	val Customer[*] customers;
	val InsurancePolicy[*] insurancePolicies;
	val Broker[*] brokers;
	val Estimator[*] estimators;
}

class Customer {
	attr String name;
	attr String email;
	val Contract[*]#customer contracts;
	val Claim[*]#customer claims;
	ref Broker#customers broker;
}

class InsurancePolicy {
	attr String type;
	attr double monthlyPrice;
	attr double yearlyPrice;
	ref Contract[*]#insurancePolicy contracts;
}

class Contract {
	attr String status;
	attr String invoiceFrequency;
	ref Customer#contracts customer;
	ref InsurancePolicy#contracts insurancePolicy;
	val Invoice[*]#contract invoices;
	ref ClaimCase[*]#contract claimCases;
}

class Invoice {
	ref Contract#invoices contract;
}

class Broker {
	attr String name;
	ref Customer[*]#broker customers;
}

class Claim {
	op double calculateCompensationSum();
	attr double compensationTotal;
	ref Customer#claims customer;
	val ClaimCase[*]#claim claimCases;
}

class ClaimCase {
	attr String status;
	attr String compensationDecision;
	ref Claim#claimCases claim;
	ref Contract#claimCases contract;
	val CompensationPayment[*]#claimCase compensationPayments;
	val Report[*]#claimCase reports;
}

class Report {
	ref ClaimCase#reports claimCase;
	ref Estimator#reports estimator;
}

class Estimator {
	attr String areaOfExpertise;
	ref Report[*]#estimator reports;
}

class CompensationPayment {
	attr EDate paymentDate;
	ref ClaimCase#compensationPayments claimCase;
}


