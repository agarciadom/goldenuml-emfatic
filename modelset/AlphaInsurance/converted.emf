@namespace(uri="http://www.example.org/insurance", prefix="insurance")
package insurance;

class Customer {
	attr String Name;
	attr String email;
	val Contract[*]#customer contracts;
	val Claim[*]#customer claims;
	ref Broker#customers broker;
}

class InsurancePolicy {
	attr String Type;
	attr double MonthlyPrice;
	attr double YearlyPrice;
	ref Contract[*]#insurancePolicy contracts;
}

class Contract {
	attr String Status;
	attr String InvoiceFrequency;
	ref Customer[1]#contracts customer;
	val Invoice[*]#contract invoices;
	ref InsurancePolicy[1]#contracts insurancePolicy;
	val ClaimCase[*]#contract claimCases;
}

class Invoice {
	ref Contract[1]#invoices contract;
}

class Broker {
	attr String Name;
	ref Customer[*]#broker customers;
}

class Claim {
	attr double CompensationTotal;
	ref Customer[1]#claims customer;
	ref ClaimCase[*]#claim claimCases;
}

class ClaimCase {
	attr String Status;
	attr String CompensationDecision;
	ref Contract[1]#claimCases contract;
	ref Claim[1]#claimCases claim;
	val CompensationPayment[*]#claimCase compensationPayments;
	ref Estimator[*]#claimCases estimators;
	val Report[*]#claimCase reports;
}

class Report {
	ref ClaimCase[1]#reports claimCase;
	ref Estimator[1]#reports estimator;
}

class Estimator {
	attr String AreaOfExpertise;
	ref ClaimCase[*]#estimators claimCases;
	ref Report[*]#estimator reports;
}

class CompensationPayment {
	attr EDate PaymentDate;
	ref ClaimCase[1]#compensationPayments claimCase;
}


