<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AlphaInsurance" nsURI="http://www.alphainsurance.com/epackage" nsPrefix="alpha">
  <eClassifiers>
    <eClass name="AlphaInsuranceCompany">
      <eStructuralFeatures>
        <eReference name="brokers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="products" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Broker">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="accountNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="accountManager" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="InsuranceProduct">
      <eStructuralFeatures>
        <eAttribute name="productName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="basePrice" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="contractId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="signingDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="billingCycle" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="finalPrice" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="handlingBroker" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Claim">
      <eStructuralFeatures>
        <eAttribute name="claimId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="submissionDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="contract" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="cases" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClaimCase">
      <eStructuralFeatures>
        <eAttribute name="caseId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="decision" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="reports" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Estimator">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="expertise" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EstimationReport">
      <eStructuralFeatures>
        <eAttribute name="content" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="issueDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="claimCase" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="estimator" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CompensationDecision">
      <eStructuralFeatures>
        <eAttribute name="isApproved" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="refundAmount" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="paymentDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
