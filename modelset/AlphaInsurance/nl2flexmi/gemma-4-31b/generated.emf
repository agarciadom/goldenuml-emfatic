@namespace(uri="http://www.alphainsurance.com/epackage", prefix="alpha")
package AlphaInsurance;

import "http://www.eclipse.org/emf/2002/Ecore";

class AlphaInsuranceCompany {
	val Broker[*] brokers;
	val Customer[*] customers;
	val InsuranceProduct[*] products;
}

class Broker {
	attr ecore.EString[1] name;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString email;
	attr ecore.EString[1] accountNumber;
	ref Broker[1] accountManager;
}

class InsuranceProduct {
	attr ecore.EString[1] productName;
	attr ecore.EDouble[1] basePrice;
}

class Contract {
	attr ecore.EString[1] contractId;
	attr ecore.EDate[1] signingDate;
	attr ecore.EString[1] billingCycle;
	attr ecore.EDouble[1] finalPrice;
	ref Customer[1] customer;
	ref InsuranceProduct[1] product;
	ref Broker[1] handlingBroker;
}

class Claim {
	attr ecore.EString[1] claimId;
	attr ecore.EDate[1] submissionDate;
	ref Customer[1] customer;
	ref Contract[1] contract;
	val ClaimCase[+] cases;
}

class ClaimCase {
	attr ecore.EString[1] caseId;
	attr ecore.EString[1] status;
	val CompensationDecision decision;
	val EstimationReport[*] reports;
}

class Estimator {
	attr ecore.EString[1] name;
	attr ecore.EString[1] expertise;
}

class EstimationReport {
	attr ecore.EString[1] content;
	attr ecore.EDate[1] issueDate;
	ref ClaimCase[1] claimCase;
	ref Estimator[1] estimator;
}

class CompensationDecision {
	attr ecore.EBoolean[1] isApproved;
	attr ecore.EDouble[1] refundAmount;
	attr ecore.EDate paymentDate;
}


