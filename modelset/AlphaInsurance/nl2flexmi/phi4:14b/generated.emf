@namespace(uri="http://www.example.com/alpha-insurance", prefix="ai")
package AlphaInsurance;

import "http://www.eclipse.org/emf/2002/Ecore";

class Broker {
	attr ecore.EString[1] name;
	attr ecore.EString email;
}

class Client {
	attr ecore.EString[1] name;
	attr ecore.EString contactNumber;
	ref Broker assignedBroker;
	val Policy[*] policies;
}

class Policy {
	attr ecore.EString[1] type;
	attr ecore.EString[*] terms;
	val ContractOffer[*] contractOffers;
}

class ContractOffer {
	attr ecore.EString[1] description;
	attr ecore.EInt validityPeriod;
}

class ClaimCase {
	attr ecore.EString[1] status;
	attr ecore.EBigDecimal amountClaimed;
	val EstimatorReport[*] relatedEstimatorReports;
}

class EstimatorReport extends Policy {
	attr ecore.EString[1] reportDetails;
	attr ecore.EString conclusion;
}


