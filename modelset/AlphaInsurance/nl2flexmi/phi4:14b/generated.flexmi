<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AlphaInsurance" nsURI="http://www.example.com/alpha-insurance" nsPrefix="ai">
  <eClassifiers>
    <eClass name="Broker">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Client">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="contactNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="assignedBroker" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="policies" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Policy">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="terms" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="contractOffers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ContractOffer">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="validityPeriod" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClaimCase">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="amountClaimed" lowerBound="0" upperBound="1" eType="//EBigDecimal" />
        <eReference name="relatedEstimatorReports" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EstimatorReport" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="reportDetails" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="conclusion" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
