@namespace(uri="http://www.alpha-insurance.com/model", prefix="ai")
package AlphaInsurance;

import "http://www.eclipse.org/emf/2002/Ecore";

class Broker {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
}

class Customer {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EString contactInfo;
	ref Broker broker;
}

class Contract {
	attr ecore.EString[1] contractNumber;
	attr ecore.EDate signDate;
	attr ecore.EString[1] paymentFrequency;
	ref Customer[1] customer;
	ref Broker[1] broker;
	val InsurancePolicy[+] insurancePolicies;
}

class InsurancePolicy {
	attr ecore.EInt[1] policyId;
	attr ecore.EString[1] type;
	attr ecore.EString coverageDetails;
}

class ClaimCase {
	attr ecore.EInt[1] claimId;
	attr ecore.EDate dateOpened;
	attr ecore.EString[1] status;
	ref Contract contract;
	ref Estimator[+] estimators;
	val CompensationDecision compensationDecision;
}

class Estimator {
	attr ecore.EInt[1] estimatorId;
	attr ecore.EString[1] name;
	attr ecore.EString areaOfExpertise;
	ref ClaimCase[*] assessedClaimCases;
}

class CompensationDecision {
	attr ecore.EInt[1] decisionId;
	attr ecore.EDouble approvedAmount;
	attr ecore.EDate paymentDate;
}


