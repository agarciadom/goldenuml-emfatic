<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AlphaInsurance" nsURI="http://www.example.org/alphaInsurance" nsPrefix="ai">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="broker" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phone" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="contracts" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Broker">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="InsurancePolicy">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="coverageAmount" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="durationMonths" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="policy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="paymentFrequency" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="claims" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Claim">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="contract" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="estimators" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eAttribute name="compensationAmount" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Estimator">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
  </eClassifiers>
</ePackage>
