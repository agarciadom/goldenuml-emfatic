<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AlphaInsurance" nsURI="http://www.alpha-insurance.com/model" nsPrefix="ai">
  <eClassifiers>
    <eClass name="Broker">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="contactInfo" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="broker" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="contractNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="signDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="paymentFrequency" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="broker" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="insurancePolicies" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="InsurancePolicy">
      <eStructuralFeatures>
        <eAttribute name="policyId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="coverageDetails" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClaimCase">
      <eStructuralFeatures>
        <eAttribute name="claimId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="dateOpened" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="contract" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="estimators" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="compensationDecision" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Estimator">
      <eStructuralFeatures>
        <eAttribute name="estimatorId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="areaOfExpertise" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="assessedClaimCases" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CompensationDecision">
      <eStructuralFeatures>
        <eAttribute name="decisionId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="approvedAmount" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="paymentDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
