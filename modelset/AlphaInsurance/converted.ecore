<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="insurance"
    nsURI="http://www.example.org/insurance"
    nsPrefix="insurance">

  <!-- Customer class -->
  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Customer to Contract: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="contracts" upperBound="-1"
        eType="#//Contract" containment="true" eOpposite="#//Contract/customer"/>
    <!-- Customer to Claim: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claims" upperBound="-1"
        eType="#//Claim" containment="true" eOpposite="#//Claim/customer"/>
    <!-- Customer to Broker: 0..* to 0..1 -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="broker" lowerBound="0" upperBound="1"
        eType="#//Broker" eOpposite="#//Broker/customers"/>
  </eClassifiers>

  <!-- InsurancePolicy class -->
  <eClassifiers xsi:type="ecore:EClass" name="InsurancePolicy">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Type" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="MonthlyPrice" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="YearlyPrice" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- InsurancePolicy to Contract: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="contracts" upperBound="-1"
        eType="#//Contract" containment="false" eOpposite="#//Contract/insurancePolicy"/>
  </eClassifiers>

  <!-- Contract class -->
  <eClassifiers xsi:type="ecore:EClass" name="Contract">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Status" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="InvoiceFrequency" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Contract back-reference to Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer" lowerBound="1" upperBound="1"
        eType="#//Customer" eOpposite="#//Customer/contracts"/>
    <!-- Contract to Invoice: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices" upperBound="-1"
        eType="#//Invoice" containment="true" eOpposite="#//Invoice/contract"/>
    <!-- Contract to InsurancePolicy -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="insurancePolicy" lowerBound="1" upperBound="1"
        eType="#//InsurancePolicy" eOpposite="#//InsurancePolicy/contracts"/>
    <!-- Contract to ClaimCase: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claimCases" upperBound="-1"
        eType="#//ClaimCase" containment="true" eOpposite="#//ClaimCase/contract"/>
  </eClassifiers>

  <!-- Invoice class -->
  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <!-- Invoice back-reference to Contract -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="contract" lowerBound="1" upperBound="1"
        eType="#//Contract" eOpposite="#//Contract/invoices"/>
  </eClassifiers>

  <!-- Broker class -->
  <eClassifiers xsi:type="ecore:EClass" name="Broker">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Broker to Customer: 0..1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers" upperBound="-1"
        eType="#//Customer" eOpposite="#//Customer/broker"/>
  </eClassifiers>

  <!-- Claim class -->
  <eClassifiers xsi:type="ecore:EClass" name="Claim">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="CompensationTotal" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Claim back-reference to Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer" lowerBound="1" upperBound="1"
        eType="#//Customer" eOpposite="#//Customer/claims"/>
    <!-- Claim to ClaimCase: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claimCases" upperBound="-1"
        eType="#//ClaimCase" containment="false" eOpposite="#//ClaimCase/claim"/>
  </eClassifiers>

  <!-- ClaimCase class -->
  <eClassifiers xsi:type="ecore:EClass" name="ClaimCase">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="Status" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="CompensationDecision" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- ClaimCase back-reference to Contract -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="contract" lowerBound="1" upperBound="1"
        eType="#//Contract" eOpposite="#//Contract/claimCases"/>
    <!-- ClaimCase back-reference to Claim -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claim" lowerBound="1" upperBound="1"
        eType="#//Claim" eOpposite="#//Claim/claimCases"/>
    <!-- ClaimCase to CompensationPayment: 1 to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="compensationPayments" upperBound="-1"
        eType="#//CompensationPayment" containment="true" eOpposite="#//CompensationPayment/claimCase"/>
    <!-- ClaimCase to Estimator: 0..* to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="estimators" upperBound="-1"
        eType="#//Estimator" eOpposite="#//Estimator/claimCases"/>
    <!-- ClaimCase to Report (association class) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="reports" upperBound="-1"
        eType="#//Report" containment="true" eOpposite="#//Report/claimCase"/>
  </eClassifiers>

  <!-- Report class (association class between ClaimCase and Estimator) -->
  <eClassifiers xsi:type="ecore:EClass" name="Report">
    <!-- Report back-reference to ClaimCase -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claimCase" lowerBound="1" upperBound="1"
        eType="#//ClaimCase" eOpposite="#//ClaimCase/reports"/>
    <!-- Report reference to Estimator -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="estimator" lowerBound="1" upperBound="1"
        eType="#//Estimator" eOpposite="#//Estimator/reports"/>
  </eClassifiers>

  <!-- Estimator class -->
  <eClassifiers xsi:type="ecore:EClass" name="Estimator">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="AreaOfExpertise" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Estimator to ClaimCase: 0..* to 0..* -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claimCases" upperBound="-1"
        eType="#//ClaimCase" eOpposite="#//ClaimCase/estimators"/>
    <!-- Estimator to Report (association class) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="reports" upperBound="-1"
        eType="#//Report" eOpposite="#//Report/estimator"/>
  </eClassifiers>

  <!-- CompensationPayment class -->
  <eClassifiers xsi:type="ecore:EClass" name="CompensationPayment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="PaymentDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- CompensationPayment back-reference to ClaimCase -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="claimCase" lowerBound="1" upperBound="1"
        eType="#//ClaimCase" eOpposite="#//ClaimCase/compensationPayments"/>
  </eClassifiers>

</ecore:EPackage>
