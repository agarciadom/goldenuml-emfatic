@namespace(uri="http://alpha-insurance.com", prefix="p")
package AlphaInsurance;

class Customer {
  attr String name;
  attr String contactInfo;
  ref Broker broker;
  val Contract[*] contracts;
}
class Broker {
  attr String name;
  attr Integer employeeId;
  val Customer[*] customers;
}
class InsurancePolicy {
  attr String type;
  attr String coverageDetails;
}
class Contract {
  attr String contractNumber;
  attr Date startDate;
  attr Date endDate;
  ref InsurancePolicy insurancePolicy;
  ref Customer customer;
  val ClaimCase[*] claimCases;
}
class ClaimCase {
  attr String caseNumber;
  attr String status;
  ref Contract contract;
  val EstimationReport[*] estimationReports;
  val CompensationDecision[*] compensationDecisions;
}
class Estimator {
  attr String name;
  attr Integer estimatorId;
  val EstimationReport[*] estimationReports;
}
class EstimationReport {
  attr Date reportDate;
  attr String reportContent;
  attr Boolean storedForLegalPurposes;
  ref ClaimCase claimCase;
  ref Estimator estimator;
}
class CompensationDecision {
  attr Double compensationAmount;
  attr String eligibleCosts;
  attr Date decisionDate;
  attr Boolean approved;
  ref ClaimCase claimCase;
}
class Offer {
  attr String offerDetails;
  attr Date offerDate;
  ref InsurancePolicy insurancePolicy;
  ref Customer customer;
}
class Assessment {
  attr Boolean isAssessed;
  attr Date assessmentDate;
  ref Customer customer;
}