@namespace(uri="http://www.example.org/university", prefix="university")
package university;

class UniversitySystem {
	val Employee[*] employees;
	val Faculty[*] faculties;
	val Course[*] courses;
	val Project[*] projects;
}

abstract class Employee {
	attr int ssNo;
	attr String name;
	attr String email;
	attr int counter;
	ref Faculty#leadBy leads;
}

class Faculty {
	attr String name;
	ref Employee[1]#leads leadBy;
	val Institute[+]#faculty institutes;
}

class AdministrativeEmployee extends Employee {
}

class ResearchAssociate extends Employee {
	attr String fieldOfStudy;
	ref Institute[+]#researchAssociates institutes;
	val Participation[*]#researchAssociate participations;
}

class Institute {
	attr String name;
	attr String address;
	ref Faculty[1]#institutes faculty;
	ref ResearchAssociate[+]#institutes researchAssociates;
}

class Lecturer extends ResearchAssociate {
	ref Course[+]#taughtBy teaches;
}

class Course {
	attr String name;
	attr int ~id;
	attr float hours;
	ref Lecturer[+]#teaches taughtBy;
}

class Project {
	attr String name;
	attr EDate start;
	attr EDate end;
	ref Participation[*]#project participations;
}

class Participation {
	attr int hours;
	ref ResearchAssociate[1]#participations researchAssociate;
	ref Project[1]#participations project;
}


