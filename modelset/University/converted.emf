@namespace(uri="http://www.example.org/university", prefix="university")
package university;

abstract class Employee {
	attr int ssNo;
	attr String name;
	attr String email;
	attr int counter;
	ref Faculty leads;
}

class Faculty {
	attr String name;
	val Institute[+]#faculty institutes;
	ref Employee[1]#leads ledBy;
}

class AdministrativeEmployee extends Employee {
}

class ResearchAssociate extends Employee {
	attr String fieldOfStudy;
	ref Institute[+]#researchAssociates institutes;
	ref Project[*]#researchAssociates projects;
	ref Participation[*]#researchAssociate participations;
}

class Institute {
	attr String name;
	attr String address;
	ref Faculty[1]#institutes faculty;
	ref ResearchAssociate[+]#institutes researchAssociates;
}

class Course {
	attr String name;
	attr int ~id;
	attr float hours;
	ref Lecturer[+]#courses lecturers;
}

class Lecturer extends ResearchAssociate {
	ref Course[+]#lecturers courses;
}

class Project {
	attr String name;
	attr EDate start;
	attr EDate end;
	ref ResearchAssociate[+]#projects researchAssociates;
	ref Participation[*]#project participations;
}

class Participation {
	attr int hours;
	ref ResearchAssociate[1]#participations researchAssociate;
	ref Project[1]#participations project;
}


