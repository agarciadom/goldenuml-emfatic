@namespace(uri="http://www.example.org/university", prefix="university")
package university;

class UniversitySystem {
	val University university;
	val Course[*] courses;
}

class University {
	attr int totalEmployees;
	val Faculty[*] faculties;
	val Employee[*] employees;
	val Project[*] projects;
}

class Faculty {
	attr String name;
	val Institute[*] institutes;
	ref Employee dean;
}

class Institute {
	attr String name;
	attr String address;
}

abstract class Employee {
	attr String socialSecurityNumber;
	attr String name;
	attr String email;
}

class AdministrativeStaff extends Employee {
}

class ResearchAssistant extends Employee {
	attr String fieldOfResearch;
	ref Institute[+] institutes;
	val ProjectInvolvement[*] projectInvolvements;
}

class Lecturer extends ResearchAssistant {
	ref Course[*] courses;
}

class Project {
	attr String name;
	attr EDate startDate;
	attr EDate endDate;
}

class ProjectInvolvement {
	attr int hours;
	ref Project project;
}

class Course {
	attr String courseId;
	attr String name;
	attr int weeklyHours;
}


