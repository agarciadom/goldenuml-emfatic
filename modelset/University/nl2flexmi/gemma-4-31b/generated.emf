@namespace(uri="http://www.example.org/university", prefix="univ")
package UniversityModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class University {
	val Faculty[+] faculties;
	val Employee[*] employees;
	val Project[*] projects;
	val Course[*] courses;
}

class Faculty {
	attr ecore.EString[1] name;
	val Institute[*] institutes;
	ref Employee[1] dean;
}

class Institute {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class Employee {
	attr ecore.EString[1] ssn;
	attr ecore.EString[1] name;
	attr ecore.EString email;
}

class ResearchStaff extends Employee {
}

class AdministrativeStaff extends Employee {
}

class RA extends ResearchStaff {
	attr ecore.EString[1] researchField;
	ref Institute[+] institutes;
	val ProjectInvolvement[*] involvements;
}

class Lecturer extends RA {
	ref Course[*] courses;
}

class Course {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EDouble[1] duration;
}

class Project {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate[1] endDate;
}

class ProjectInvolvement {
	attr ecore.EInt[1] hours;
	ref Project[1] project;
}


