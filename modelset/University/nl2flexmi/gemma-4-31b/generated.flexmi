<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="UniversityModel" nsURI="http://www.example.org/university" nsPrefix="univ">
  <eClassifiers>
    <eClass name="University">
      <eStructuralFeatures>
        <eReference name="faculties" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="employees" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="projects" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="courses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Faculty">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="institutes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="dean" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institute">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="ssn" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchStaff" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures />
    </eClass>
    <eClass name="AdministrativeStaff" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures />
    </eClass>
    <eClass name="RA" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="researchField" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="institutes" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="involvements" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Lecturer" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eReference name="courses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ProjectInvolvement">
      <eStructuralFeatures>
        <eAttribute name="hours" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="project" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
