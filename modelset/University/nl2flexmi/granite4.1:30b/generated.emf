@namespace(uri="http://example.com/universitymodel", prefix="uni")
package UniversityModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class University {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] totalEmployees;
	val Faculty[*] faculties;
}

class Faculty {
	attr ecore.EString[1] name;
	ref Employee dean;
	val Institute[*] institutes;
}

class Institute {
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class Employee {
	attr ecore.EString[1] socialSecurityNumber;
	attr ecore.EString[1] name;
	attr ecore.EString[1] email;
	attr ecore.EString type;
}

class ResearchAssistant extends Employee {
	attr ecore.EString researchField;
	ref Project[*] projects;
}

class Lecturer extends ResearchAssistant {
	val Course[*] courses;
}

class Project {
	attr ecore.EString[1] name;
	attr ecore.EDate startDate;
	attr ecore.EDate endDate;
	attr ecore.EInt hours;
}

class Course {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EInt[1] weeklyDurationHours;
}


