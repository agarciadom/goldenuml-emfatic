@namespace(uri="http://example.org/university", prefix="uni")
package University;

import "http://www.eclipse.org/emf/2002/Ecore";

class University {
	val Faculty[+] faculties;
	attr ecore.EInt totalEmployees;
}

class Faculty {
	attr ecore.EString[1] name;
	val Institute[+] institutes;
	val Employee[1] dean;
}

class Institute {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	ref ResearchAssistant[0..1000] researchAssistants;
}

class Employee {
	attr ecore.EString[1] socialSecurityNumber;
	attr ecore.EString[1] name;
	attr ecore.EString[1] emailAddress;
}

class ResearchAssistant extends Employee {
	attr ecore.EString[1] fieldOfResearch;
	ref Project[0..1000] projects;
	ref Course[0..1000] courses;
}

class Project {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate[1] endDate;
}

class Course {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EInt[1] weeklyDuration;
}


