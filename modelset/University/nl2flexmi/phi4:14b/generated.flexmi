<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="University" nsURI="http://example.org/university" nsPrefix="uni">
  <eClassifiers>
    <eClass name="University">
      <eStructuralFeatures>
        <eReference name="faculties" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eAttribute name="totalEmployees" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Faculty">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="institutes" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="dean" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institute">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="researchAssistants" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchAssistant" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eAttribute name="fieldOfResearch" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="projects" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.5" />
        <eReference name="courses" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="weeklyDuration" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
