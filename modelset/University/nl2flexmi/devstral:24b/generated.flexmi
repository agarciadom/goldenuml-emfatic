<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="University" nsURI="http://www.example/university" nsPrefix="uni">
  <eClassifiers>
    <eClass name="University">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="totalEmployees" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="faculties" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Faculty">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="dean" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="institutes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institute">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="ssn" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isResearchStaff" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchAssistant" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eAttribute name="fieldOfResearch" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="institutes" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="projects" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Lecturer" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="weeklyHours" lowerBound="1" upperBound="1" eType="//EFloat" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
