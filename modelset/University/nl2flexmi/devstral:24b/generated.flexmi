<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="UniversityModel" nsURI="http://www.example.org/universitymodel" nsPrefix="univ">
  <eClassifiers>
    <eClass name="Faculty">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="institutes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="dean" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Institute">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="faculty" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ResearchAssistant">
      <eStructuralFeatures>
        <eAttribute name="fieldOfResearch" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="institutes" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="projects" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="taughtCourses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Project">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Course">
      <eStructuralFeatures>
        <eAttribute name="ID" lowerBound="1" upperBound="1" eType="//EIntegerObject" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="weeklyDurationHours" lowerBound="1" upperBound="1" eType="//EFloatObject" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Dean" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="University">
      <eStructuralFeatures>
        <eReference name="employees" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="faculties" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
