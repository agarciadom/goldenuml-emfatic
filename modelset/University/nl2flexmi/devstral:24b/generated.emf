@namespace(uri="http://www.example/university", prefix="uni")
package University;

import "http://www.eclipse.org/emf/2002/Ecore";

class University {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] totalEmployees;
	val Faculty[*] faculties;
}

class Faculty {
	attr ecore.EString[1] name;
	ref Employee[1] dean;
	val Institute[*] institutes;
}

class Institute {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class Employee {
	attr ecore.EString[1] ssn;
	attr ecore.EString[1] name;
	attr ecore.EString[1] email;
	attr ecore.EBoolean[1] isResearchStaff;
}

class ResearchAssistant extends Employee {
	attr ecore.EString[1] fieldOfResearch;
	ref Institute[+] institutes;
	ref Project[*] projects;
}

class Lecturer extends ResearchAssistant {
}

class Project {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate[1] endDate;
}

class Course {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EFloat[1] weeklyHours;
}


