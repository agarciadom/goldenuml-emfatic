<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ElderlyHomeEPackage" nsURI="http://example.org/elderlyhome" nsPrefix="eh">
  <eClassifiers>
    <eClass name="Home">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="departments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="departmentName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eAttribute name="departmentCode" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="roomNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="beds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bed">
      <eStructuralFeatures>
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="fullName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="registration" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="waitlistPosition" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="requestedStay" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="StayCategory">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="pricePerDay" lowerBound="1" upperBound="1" eType="Decimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Stay">
      <eStructuralFeatures>
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="suspendedStay" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Registration">
      <eStructuralFeatures>
        <eAttribute name="registrationDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Assessment">
      <eStructuralFeatures>
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eAttribute name="assessmentDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eReference name="stay" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="amountDue" lowerBound="1" upperBound="1" eType="Decimal" />
        <eAttribute name="invoiceDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="payments" lowerBound="0" upperBound="-1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Payment" instanceClassName="Payment" />
  </eClassifiers>
</ePackage>
