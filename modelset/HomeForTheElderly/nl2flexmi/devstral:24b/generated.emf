@namespace(uri="http://www.example.org/HomeForElderlyModel", prefix="home")
package HomeForElderlyModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class Home {
	attr ecore.EString[1] name;
	attr ecore.EString address;
	val Department[*] departments;
}

class Department {
	attr ecore.EString[1] name;
	attr ecore.EInt floorNumber;
	val Room[*] rooms;
}

class Room {
	attr ecore.EInt[1] number;
	attr ecore.EInt[1] capacity;
	val Bed[*] beds;
}

class Bed {
	attr ecore.EString[1] identifier;
}

class Inhabitant {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EDate dateOfBirth;
	ref Stay[*] stays;
}

class Category {
	attr ecore.EString[1] name;
	attr ecore.EDouble[1] price;
}

class Stay {
	attr ecore.EDate startDate;
	attr ecore.EDate endDate;
	attr ecore.EBoolean[1] isSuspended;
	ref Inhabitant[1] inhabitant;
	ref Bed bed;
	ref Category[1] category;
}

class RegistrationProcess {
	attr ecore.EDate registrationDate;
	attr ecore.EString[1] status;
	val WaitingListEntry waitingListEntry;
}

class Assessment {
	attr ecore.EDate evaluationDate;
	attr ecore.EString[1] needsAssessment;
	ref Inhabitant[1] inhabitant;
}

class WaitingListEntry {
	attr ecore.EInt[1] position;
	attr ecore.EString requestedStayType;
	ref RegistrationProcess[1] registrationProcess;
	val Proposal[*] proposals;
}

class Proposal {
	attr ecore.EDate proposalDate;
	attr ecore.EDate expirationDate;
	attr ecore.EString[1] status;
	ref WaitingListEntry[1] waitingListEntry;
	ref Inhabitant inhabitant;
}

class Invoice {
	attr ecore.EDate invoiceDate;
	attr ecore.EDouble[1] amount;
	attr ecore.EString[1] status;
}

class Payment {
	attr ecore.EDate paymentDate;
	attr ecore.EDouble[1] amount;
}

class RestHomeStay extends Stay {
}

class NursingHomeStay extends Stay {
}

class ServiceFlatStay extends Stay {
}


