<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HomeForElderlyModel" nsURI="http://www.example.org/HomeForElderlyModel" nsPrefix="home">
  <eClassifiers>
    <eClass name="Home">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="departments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="floorNumber" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="beds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bed">
      <eStructuralFeatures>
        <eAttribute name="identifier" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="stays" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Category">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Stay">
      <eStructuralFeatures>
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="isSuspended" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="bed" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RegistrationProcess">
      <eStructuralFeatures>
        <eAttribute name="registrationDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="waitingListEntry" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Assessment">
      <eStructuralFeatures>
        <eAttribute name="evaluationDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="needsAssessment" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WaitingListEntry">
      <eStructuralFeatures>
        <eAttribute name="position" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="requestedStayType" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="registrationProcess" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="proposals" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Proposal">
      <eStructuralFeatures>
        <eAttribute name="proposalDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="expirationDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="waitingListEntry" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="inhabitant" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="paymentDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RestHomeStay" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="NursingHomeStay" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="ServiceFlatStay" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
