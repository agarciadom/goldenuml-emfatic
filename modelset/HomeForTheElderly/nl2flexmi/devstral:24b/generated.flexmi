<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HomeForElderlyModel" nsURI="http://www.example.org/HomeForElderlyModel" nsPrefix="home">
  <eClassifiers>
    <eClass name="HomeForElderly">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="departments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="beds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bed">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="category" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="inhabitant" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Category">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//@eClassifiers.18" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Inhabitant">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//@eClassifiers.17" />
        <eReference name="stays" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="currentBeds" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Stay">
      <eStructuralFeatures>
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//@eClassifiers.17" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eAttribute name="isSuspended" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RestHomeStay" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="ServiceFlatStay" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="RestNursingHomeStay" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="RegistrationProcess">
      <eStructuralFeatures>
        <eAttribute name="registrationDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Assessment">
      <eStructuralFeatures>
        <eAttribute name="assessmentDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eAttribute name="result" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="recommendedStayType" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WaitingList">
      <eStructuralFeatures>
        <eReference name="entries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.19" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Proposal">
      <eStructuralFeatures>
        <eAttribute name="proposalDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eReference name="bed" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eAttribute name="accepted" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="responseDate" lowerBound="0" upperBound="1" eType="//@eClassifiers.17" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="dueDate" lowerBound="0" upperBound="1" eType="//@eClassifiers.17" />
        <eReference name="stays" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="payments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.15" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="paymentDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreditNote">
      <eStructuralFeatures>
        <eAttribute name="creditDate" lowerBound="1" upperBound="1" eType="//@eClassifiers.17" />
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Date" instanceClassName="java.util.Date" />
    <eDataType name="BigDecimal" instanceClassName="java.math.BigDecimal" />
    <eClass name="WaitingListEntry">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
