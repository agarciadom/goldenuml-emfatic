<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ElderlyCareSystem" nsURI="http://elderlycare.com/system" nsPrefix="ecs">
  <eClassifiers>
    <eClass name="Home">
      <eStructuralFeatures>
        <eReference name="departments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="categories" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="people" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="registrations" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="assessments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="questions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
        <eReference name="waitingListEntries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="proposals" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.10" />
        <eReference name="stays" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.11" />
        <eReference name="invoices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.12" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Department">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="beds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bed">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Category">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RegistrationProcess">
      <eStructuralFeatures>
        <eAttribute name="registrationDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="person" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="questions" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Assessment">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="score" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="person" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="recommendedCategory" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Question">
      <eStructuralFeatures>
        <eAttribute name="text" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="WaitingListEntry">
      <eStructuralFeatures>
        <eAttribute name="position" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="entryDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="person" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Proposal">
      <eStructuralFeatures>
        <eAttribute name="proposalDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="deadlineDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="waitingListEntry" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="proposedBed" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="person" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Stay">
      <eStructuralFeatures>
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="state" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="inhabitant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="bed" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="totalAmount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="remainingAmount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="stay" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
        <eReference name="person" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
