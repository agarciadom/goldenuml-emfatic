@namespace(uri="http://elderlycare.com/system", prefix="ecs")
package ElderlyCareSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Home {
	val Department[*] departments;
	val Category[*] categories;
	val Person[*] people;
	val RegistrationProcess[*] registrations;
	val Assessment[*] assessments;
	val Question[*] questions;
	val WaitingListEntry[*] waitingListEntries;
	val Proposal[*] proposals;
	val Stay[*] stays;
	val Invoice[*] invoices;
}

class Department {
	attr ecore.EString[1] name;
	val Room[*] rooms;
}

class Room {
	attr ecore.EString[1] number;
	val Bed[*] beds;
}

class Bed {
	attr ecore.EString[1] ~id;
	ref Category[1] category;
}

class Category {
	attr ecore.EString[1] name;
	attr ecore.EBigDecimal[1] price;
}

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EDate[1] birthDate;
}

class RegistrationProcess {
	attr ecore.EDate[1] registrationDate;
	attr ecore.EString[1] status;
	ref Person[1] person;
	ref Question[*] questions;
}

class Assessment {
	attr ecore.EDate[1] date;
	attr ecore.EDouble score;
	ref Person[1] person;
	ref Category[1] recommendedCategory;
}

class Question {
	attr ecore.EString[1] text;
}

class WaitingListEntry {
	attr ecore.EInt[1] position;
	attr ecore.EDate[1] entryDate;
	ref Person[1] person;
	ref Category[1] category;
}

class Proposal {
	attr ecore.EDate[1] proposalDate;
	attr ecore.EDate[1] deadlineDate;
	attr ecore.EString[1] status;
	ref WaitingListEntry[1] waitingListEntry;
	ref Bed[1] proposedBed;
	ref Person[1] person;
}

class Stay {
	attr ecore.EDate[1] startDate;
	attr ecore.EDate endDate;
	attr ecore.EString[1] state;
	ref Person[1] inhabitant;
	ref Bed[1] bed;
	ref Category[1] category;
}

class Invoice {
	attr ecore.EString[1] invoiceNumber;
	attr ecore.EDate[1] date;
	attr ecore.EBigDecimal[1] totalAmount;
	attr ecore.EBigDecimal[1] remainingAmount;
	attr ecore.EString[1] status;
	ref Stay[1] stay;
	ref Person[1] person;
}


