@namespace(uri="http://homeforelderly", prefix="p")
package HomeForElderly;

class Home {
  val Department[*] departments;
}
class Department extends Home {
  attr EString departmentName;
  val Room[*] rooms;
}
class Room extends Department {
  attr EInt roomNumber;
  val Bed[*] beds;
  ref Department department;
}
class Bed extends Room {
  attr EString bedID;
  ref Category category;
  ref Room room;
}
class Category {
  attr EDouble price;
  val Stay[*] stays;
}
class Stay {
  attr EDate startDate;
  attr EDate endDate;
  attr EString typeOfStay;
  ref Inhabitant inhabitant;
  ref Category category;
  val Invoice[*] invoices;
}
class Inhabitant {
  attr EString name;
  attr EInt ~id;
  ref Stay[*] stays;
  ref RegistrationProcess registrationProcess;
  ref Assessment assessment;
  ref WaitingListEntry waitingListEntry;
}
class RegistrationProcess {
  attr EString[*] identificationData;
}
class Assessment {
  attr EString typeOfStay;
  val Inhabitant[*] inhabitants;
}
class WaitingListEntry {
  attr EInt position;
  ref Category category;
  ref Inhabitant inhabitant;
}
class Invoice {
  attr EDouble amount;
  attr EDate date;
  attr EString status;
  attr EDouble paidAmount;
  ref Stay stay;
  val PaymentEvent[*] paymentEvents;
}
class PaymentEvent {
  attr EDate paymentDate;
  attr EDouble amountPaid;
  ref Invoice invoice;
}
class CreditNote {
  attr EDouble creditAmount;
  ref Invoice invoice;
}