<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="HomeForTheElderlyModel" nsURI="http://www.example.org/HomeForTheElderlyModel" nsPrefix="HomeForTheElderlyModel" eClassifiers="RootContainer Department Room Bed Category StayType Inhabitant WaitingList Proposal Invoice Payment CreditNote">
    <eClassifiers xmi:type="ecore:EClass" name="RootContainer">
      <eStructuralFeatures xmi:type="ecore:EReference" name="departments" eType="#//Department" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="inhabitants" eType="#//Inhabitant" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="waitingLists" eType="#//WaitingList" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="proposals" eType="#//Proposal" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="invoices" eType="#//Invoice" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="payments" eType="#//Payment" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="creditNotes" eType="#//CreditNote" upperBound="-1" containment="true"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Department">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="departmentName" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="rooms" eType="#//Room" upperBound="-1" containment="true"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Room">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="roomNumber" eType="ecore:EInt"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="beds" eType="#//Bed" upperBound="-1" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="department" eType="#//Department"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Bed">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="bedId" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="category" eType="#//Category"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="room" eType="#//Room"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="inhabitants" eType="#//Inhabitant" upperBound="-1"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Category">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="categoryName" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="price" eType="ecore:EDouble"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="StayType">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="typeName" eType="ecore:EString"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Inhabitant">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="inhabitantId" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="firstName" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="lastName" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="dateOfBirth" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="registrationDate" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="stays" eType="#//StayType" upperBound="-1"/>
      <eOperations xmi:type="ecore:EOperation" name="addStay"/>
      <eOperations xmi:type="ecore:EOperation" name="switchStay"/>
      <eOperations xmi:type="ecore:EOperation" name="validateStays"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="WaitingList">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="waitingList" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="stayType" eType="#//StayType"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="inhabitants" eType="#//Inhabitant" upperBound="-1"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Proposal">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="proposalId" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="inhabitant" eType="#//Inhabitant"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="bed" eType="#//Bed"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="proposalDate" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="responseDate" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="accepted" eType="ecore:EBoolean"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Invoice">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="invoiceId" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="inhabitant" eType="#//Inhabitant"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="amount" eType="ecore:EDouble"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="dueDate" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="paymentDate" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="paid" eType="ecore:EBoolean"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="status" eType="ecore:EString"/>
      <eOperations xmi:type="ecore:EOperation" name="modify"/>
      <eOperations xmi:type="ecore:EOperation" name="adjustAmount"/>
      <eOperations xmi:type="ecore:EOperation" name="resend"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="Payment">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="paymentId" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="invoice" eType="#//Invoice"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="amount" eType="ecore:EDouble"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="date" eType="ecore:EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="received" eType="ecore:EBoolean"/>
    </eClassifiers>

    <eClassifiers xmi:type="ecore:EClass" name="CreditNote">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="creditNoteId" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="inhabitant" eType="#//Inhabitant"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="amount" eType="ecore:EDouble"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="reason" eType="ecore:EString"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="refundDate" eType="ecore:EDate"/>
    </eClassifiers>
  </ecore:EPackage>
</xmi:XMI>
