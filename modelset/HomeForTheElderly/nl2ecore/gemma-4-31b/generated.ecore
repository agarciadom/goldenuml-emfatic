<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ePackage name="HomeForTheElderly" nsURI="http://www.example.org/homefortheelderly" xmi:id="package_root">

    <!-- Root Container -->
    <eClass name="ElderlyCareSystem" xmi:id="class_ElderlyCareSystem">
      <eStructuralFeatures>
        <eReference name="departments" eClassifier="Department" xmi:id="ref_sys_dept"/>
        <eReference name="persons" eClassifier="Person" xmi:id="ref_sys_pers"/>
        <eReference name="categories" eClassifier="Category" xmi:id="ref_sys_cat"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Department" xmi:id="class_Department">
      <eStructuralFeatures>
        <eReference name="rooms" eClassifier="Room" xmi:id="ref_dept_room"/>
        <eReference name="parentSystem" eClassifier="ElderlyCareSystem" xmi:id="ref_dept_sys"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Room" xmi:id="class_Room">
      <eStructuralFeatures>
        <eReference name="beds" eClassifier="Bed" xmi:id="ref_room_bed"/>
        <eReference name="department" eClassifier="Department" xmi:id="ref_room_dept"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Bed" xmi:id="class_Bed">
      <eStructuralFeatures>
        <eReference name="category" eClassifier="Category" xmi:id="ref_bed_cat"/>
        <eReference name="room" eClassifier="Room" xmi:id="ref_bed_room"/>
        <eReference name="currentStay" eClassifier="Stay" xmi:id="ref_bed_stay"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Category" xmi:id="class_Category">
      <eStructuralFeatures>
        <eAttribute name="name" eType="EString" xmi:id="attr_cat_name"/> <!-- RH, RNH, SF -->
        <eAttribute name="price" eType="EDouble" xmi:id="attr_cat_price"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Person" xmi:id="class_Person">
      <eStructuralFeatures>
        <eAttribute name="basicIdentificationData" eType="EString" xmi:id="attr_pers_data"/>
        <eAttribute name="registrationDate" eType="EDate" xmi:id="attr_pers_regdate"/>
        <eReference name="assessments" eClassifier="Assessment" xmi:id="ref_pers_ass"/>
        <eReference name="waitingListEntries" eClassifier="WaitingListEntry" xmi:id="ref_pers_wait"/>
        <eReference name="stays" eClassifier="Stay" xmi:id="ref_pers_stay"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Assessment" xmi:id="class_Assessment">
      <eStructuralFeatures>
        <eAttribute name="eatingAbilityScore" eType="EInt" xmi:id="attr_ass_eat"/>
        <eAttribute name="dressingAbilityScore" eType="EInt" xmi:id="attr_ass_dress"/>
        <eAttribute name="personalCareAbilityScore" eType="EInt" xmi:id="attr_ass_care"/>
        <eAttribute name="assessmentDate" eType="EDate" xmi:id="attr_ass_date"/>
        <eReference name="person" eClassifier="Person" xmi:id="ref_ass_pers"/>
        <eReference name="suggestedCategory" eClassifier="Category" xmi:id="ref_ass_cat"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="WaitingListEntry" xmi:id="class_WaitingListEntry">
      <eStructuralFeatures>
        <eAttribute name="entryDate" eType="EDate" xmi:id="attr_wait_date"/>
        <eReference name="person" eClassifier="Person" xmi:id="ref_wait_pers"/>
        <eReference name="category" eClassifier="Category" xmi:id="ref_wait_cat"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Proposal" xmi:id="class_Proposal">
      <eStructuralFeatures>
        <eAttribute name="proposalDate" eType="EDate" xmi:id="attr_prop_date"/>
        <eAttribute name="responseDeadline" eType="EDate" xmi:id="attr_prop_deadline"/>
        <eAttribute name="responseDate" eType="EDate" xmi:id="attr_prop_respdate"/>
        <eReference name="bed" eClassifier="Bed" xmi:id="ref_prop_bed"/>
        <eReference name="waitingListEntry" eClassifier="WaitingListEntry" xmi:id="ref_prop_wait"/>
        <eReference name="status" eClassifier="ProposalStatus" xmi:id="ref_prop_stat"/>
      </eStructuralFeatures>
    </eClass>

    <eEnum name="ProposalStatus" xmi:id="enum_ProposalStatus">
      <eLiterals name="PENDING" xmi:id="lit_prop_pend"/>
      <eLiterals name="ACCEPTED" xmi:id="lit_prop_acc"/>
      <eLiterals name="REFUSED" xmi:id="lit_prop_ref"/>
      <eLiterals name="INVALIDATED" xmi:id="lit_prop_inv"/>
    </eEnum>

    <eClass name="Stay" xmi:id="class_Stay">
      <eStructuralFeatures>
        <eAttribute name="startDate" eType="EDate" xmi:id="attr_stay_start"/>
        <eAttribute name="endDate" eType="EDate" xmi:id="attr_stay_end"/>
        <eReference name="inhabitant" eClassifier="Person" xmi:id="ref_stay_pers"/>
        <eReference name="bed" eClassifier="Bed" xmi:id="ref_stay_bed"/>
        <eReference name="category" eClassifier="Category" xmi:id="ref_stay_cat"/>
        <eReference name="status" eClassifier="StayStatus" xmi:id="ref_stay_stat"/>
      </eStructuralFeatures>
    </eClass>

    <eEnum name="StayStatus" xmi:id="enum_StayStatus">
      <eLiterals name="ACTIVE" xmi:id="lit_stay_act"/>
      <eLiterals name="SUSPENDED" xmi:id="lit_stay_sus"/>
      <eLiterals name="ENDED" xmi:id="lit_stay_end"/>
    </eEnum>

    <eClass name="Invoice" xmi:id="class_Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceDate" eType="EDate" xmi:id="attr_inv_date"/>
        <eAttribute name="totalAmount" eType="EDouble" xmi:id="attr_inv_total"/>
        <eAttribute name="outstandingAmount" eType="EDouble" xmi:id="attr_inv_outst"/>
        <eAttribute name="discountApplied" eType="EDouble" xmi:id="attr_inv_disc"/>
        <eReference name="stay" eClassifier="Stay" xmi:id="ref_inv_stay"/>
        <eReference name="status" eClassifier="InvoiceStatus" xmi:id="ref_inv_stat"/>
        <eReference name="payments" eClassifier="Payment" xmi:id="ref_inv_pay"/>
      </eStructuralFeatures>
    </eClass>

    <eEnum name="InvoiceStatus" xmi:id="enum_InvoiceStatus">
      <eLiterals name="UNPAID" xmi:id="lit_inv_unpaid"/>
      <eLiterals name="PAID" xmi:id="lit_inv_paid"/>
      <eLiterals name="MODIFIED" xmi:id="lit_inv_mod"/>
    </eEnum>

    <eClass name="Payment" xmi:id="class_Payment">
      <eStructuralFeatures>
        <eAttribute name="paymentDate" eType="EDate" xmi:id="attr_pay_date"/>
        <eAttribute name="amountPaid" eType="EDouble" xmi:id="attr_pay_amt"/>
        <eReference name="invoice" eClassifier="Invoice" xmi:id="ref_pay_inv"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="CreditNote" xmi:id="class_CreditNote">
      <eStructuralFeatures>
        <eAttribute name="creditDate" eType="EDate" xmi:id="attr_cn_date"/>
        <eAttribute name="amount" eType="EDouble" xmi:id="attr_cn_amt"/>
        <eReference name="person" eClassifier="Person" xmi:id="ref_cn_pers"/>
        <eReference name="triggeringPayment" eClassifier="Payment" xmi:id="ref_cn_pay"/>
      </eStructuralFeatures>
    </eClass>

  </ePackage>
</xmi:XMI>
