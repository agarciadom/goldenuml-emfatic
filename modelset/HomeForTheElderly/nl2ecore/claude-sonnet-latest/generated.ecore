<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="elderlyHome"
    nsURI="http://www.example.org/elderlyHome"
    nsPrefix="elderlyHome">

  <!-- Custom datatypes -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
      instanceClassName="java.time.LocalTime"/>

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="StayCategory">
    <eLiterals name="RH" value="0" literal="RH"/>
    <eLiterals name="RNH" value="1" literal="RNH"/>
    <eLiterals name="SF" value="2" literal="SF"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ProposalStatus">
    <eLiterals name="PENDING" value="0" literal="PENDING"/>
    <eLiterals name="ACCEPTED" value="1" literal="ACCEPTED"/>
    <eLiterals name="REFUSED" value="2" literal="REFUSED"/>
    <eLiterals name="INVALIDATED" value="3" literal="INVALIDATED"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="InvoiceStatus">
    <eLiterals name="OPEN" value="0" literal="OPEN"/>
    <eLiterals name="SENT" value="1" literal="SENT"/>
    <eLiterals name="PAID" value="2" literal="PAID"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="StayStatus">
    <eLiterals name="ACTIVE" value="0" literal="ACTIVE"/>
    <eLiterals name="SUSPENDED" value="1" literal="SUSPENDED"/>
    <eLiterals name="ENDED" value="2" literal="ENDED"/>
  </eClassifiers>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="ElderlyHomeSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="home"
        eType="#//Home" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="persons"
        upperBound="-1" eType="#//Person" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="categories"
        upperBound="-1" eType="#//Category" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="waitingLists"
        upperBound="-1" eType="#//WaitingList" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="registrationQuestions"
        upperBound="-1" eType="#//RegistrationQuestion" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assessmentQuestions"
        upperBound="-1" eType="#//AssessmentQuestion" containment="true"/>
  </eClassifiers>

  <!-- Home -->
  <eClassifiers xsi:type="ecore:EClass" name="Home">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="departments"
        upperBound="-1" eType="#//Department" containment="true"
        eOpposite="#//Department/home"/>
  </eClassifiers>

  <!-- Department -->
  <eClassifiers xsi:type="ecore:EClass" name="Department">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="home"
        eType="#//Home" eOpposite="#//Home/departments"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms"
        upperBound="-1" eType="#//Room" containment="true"
        eOpposite="#//Room/department"/>
  </eClassifiers>

  <!-- Room -->
  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="department"
        eType="#//Department" eOpposite="#//Department/rooms"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="beds"
        upperBound="-1" eType="#//Bed" containment="true"
        eOpposite="#//Bed/room"/>
  </eClassifiers>

  <!-- Bed -->
  <eClassifiers xsi:type="ecore:EClass" name="Bed">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bedNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="room"
        eType="#//Room" eOpposite="#//Room/beds"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="category"
        eType="#//Category"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isFree"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Category (type of stay) -->
  <eClassifiers xsi:type="ecore:EClass" name="Category">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stayCategory"
        eType="#//StayCategory"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pricePerDay"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- Person (can be a prospect or an inhabitant) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateOfBirth"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contactDetails"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="registration"
        eType="#//Registration" containment="true"
        eOpposite="#//Registration/person"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stays"
        upperBound="-1" eType="#//Stay" containment="true"
        eOpposite="#//Stay/inhabitant"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="proposals"
        upperBound="-1" eType="#//Proposal" containment="true"
        eOpposite="#//Proposal/person"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assessments"
        upperBound="-1" eType="#//Assessment" containment="true"
        eOpposite="#//Assessment/person"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="representative"
        eType="#//Person"/>
  </eClassifiers>

  <!-- Registration -->
  <eClassifiers xsi:type="ecore:EClass" name="Registration">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="registrationDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isComplete"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person"
        eType="#//Person" eOpposite="#//Person/registration"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="answers"
        upperBound="-1" eType="#//RegistrationAnswer" containment="true"/>
  </eClassifiers>

  <!-- RegistrationQuestion -->
  <eClassifiers xsi:type="ecore:EClass" name="RegistrationQuestion">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="questionText"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- RegistrationAnswer -->
  <eClassifiers xsi:type="ecore:EClass" name="RegistrationAnswer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="answerText"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="question"
        eType="#//RegistrationQuestion"/>
  </eClassifiers>

  <!-- Assessment -->
  <eClassifiers xsi:type="ecore:EClass" name="Assessment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="assessmentDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isReAssessment"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person"
        eType="#//Person" eOpposite="#//Person/assessments"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="determinedStayCategory"
        eType="#//StayCategory"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="answers"
        upperBound="-1" eType="#//AssessmentAnswer" containment="true"/>
    <eOperations name="determineStayCategory" eType="#//StayCategory"/>
  </eClassifiers>

  <!-- AssessmentQuestion -->
  <eClassifiers xsi:type="ecore:EClass" name="AssessmentQuestion">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="questionText"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="activity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- AssessmentAnswer -->
  <eClassifiers xsi:type="ecore:EClass" name="AssessmentAnswer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="answerText"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="question"
        eType="#//AssessmentQuestion"/>
  </eClassifiers>

  <!-- WaitingList -->
  <eClassifiers xsi:type="ecore:EClass" name="WaitingList">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stayCategory"
        eType="#//StayCategory"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries"
        upperBound="-1" eType="#//WaitingListEntry" containment="true"
        eOpposite="#//WaitingListEntry/waitingList"/>
    <eOperations name="getNextCandidate" eType="#//WaitingListEntry"/>
    <eOperations name="addEntry">
      <eParameters name="entry" eType="#//WaitingListEntry"/>
    </eOperations>
    <eOperations name="removeEntry">
      <eParameters name="entry" eType="#//WaitingListEntry"/>
    </eOperations>
  </eClassifiers>

  <!-- WaitingListEntry -->
  <eClassifiers xsi:type="ecore:EClass" name="WaitingListEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="position"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="requestedCategory"
        eType="#//StayCategory"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="waitingList"
        eType="#//WaitingList" eOpposite="#//WaitingList/entries"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person"
        eType="#//Person"/>
  </eClassifiers>

  <!-- Proposal -->
  <eClassifiers xsi:type="ecore:EClass" name="Proposal">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="proposalDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="responseDeadline"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="responseDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//ProposalStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person"
        eType="#//Person" eOpposite="#//Person/proposals"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bed"
        eType="#//Bed"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="category"
        eType="#//Category"/>
    <eOperations name="accept"/>
    <eOperations name="refuse"/>
    <eOperations name="invalidate"/>
  </eClassifiers>

  <!-- Stay -->
  <eClassifiers xsi:type="ecore:EClass" name="Stay">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//StayStatus"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discountApplied"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discountRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="inhabitant"
        eType="#//Person" eOpposite="#//Person/stays"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bed"
        eType="#//Bed"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="category"
        eType="#//Category"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices"
        upperBound="-1" eType="#//Invoice" containment="true"
        eOpposite="#//Invoice/stay"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="proposal"
        eType="#//Proposal"/>
    <eOperations name="suspend"/>
    <eOperations name="resume"/>
    <eOperations name="end"/>
  </eClassifiers>

  <!-- Invoice -->
  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="invoiceDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodStart"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="periodEnd"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalAmount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="outstandingAmount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//InvoiceStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="stay"
        eType="#//Stay" eOpposite="#//Stay/invoices"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLines"
        upperBound="-1" eType="#//InvoiceLine" containment="true"
        eOpposite="#//InvoiceLine/invoice"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="payments"
        upperBound="-1" eType="#//Payment" containment="true"
        eOpposite="#//Payment/invoice"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="creditNote"
        eType="#//CreditNote" containment="true"
        eOpposite="#//CreditNote/invoice"/>
    <eOperations name="registerPayment">
      <eParameters name="amount"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    </eOperations>
    <eOperations name="modify"/>
    <eOperations name="resend"/>
    <eOperations name="markAsPaid"/>
  </eClassifiers>

  <!-- InvoiceLine -->
  <eClassifiers xsi:type="ecore:EClass" name="InvoiceLine">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice"
        eType="#//Invoice" eOpposite="#//Invoice/invoiceLines"/>
  </eClassifiers>

  <!-- Payment -->
  <eClassifiers xsi:type="ecore:EClass" name="Payment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice"
        eType="#//Invoice" eOpposite="#//Invoice/payments"/>
  </eClassifiers>

  <!-- CreditNote -->
  <eClassifiers xsi:type="ecore:EClass" name="CreditNote">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="issueDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="refundAmount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="refundExecuted"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice"
        eType="#//Invoice" eOpposite="#//Invoice/creditNote"/>
    <eOperations name="executeRefund"/>
  </eClassifiers>

</ecore:EPackage>
