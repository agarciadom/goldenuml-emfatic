@namespace(uri="http://www.example.org/hospital", prefix="hospital")
package hospital;

class HospitalSystem {
	val Department[*] departments;
	val Category[*] categories;
	val Person[*] persons;
	val Invoice[*] invoices;
	val Proposal[*] proposals;
}

class Department {
	val Room[*]#department rooms;
}

class Category {
	attr Double price;
	attr String type;
	ref Room[*]#category rooms;
}

class Room {
	ref Department#rooms department;
	ref Category#rooms category;
	val Bed[*]#room beds;
}

class Bed {
	ref Room#beds room;
	ref Proposal#bed proposal;
	val Stay[*]#bed stays;
}

class Proposal {
	attr String status;
	attr Boolean validated;
	ref Bed#proposal bed;
	ref Person#proposal person;
}

class Person {
	attr String name;
	attr EDate birthdate;
	attr EDate registrationDate;
	attr String abilities;
	ref Proposal#person proposal;
	ref Stay[*]#person stays;
	ref Invoice[*]#person invoices;
}

class Stay {
	attr EDate intakeDate;
	attr EDate endDate;
	ref Person#stays person;
	ref Bed#stays bed;
	ref InvoiceItem#stay invoiceItem;
}

class Invoice {
	op String payment(Double paymentAmount);
	attr EDate invoiceDate;
	attr Double outstandingAmount;
	attr String status;
	ref Person#invoices person;
	val InvoiceLine[*]#invoice invoiceLines;
}

class InvoiceItem {
	ref Stay#invoiceItem stay;
	ref InvoiceLine#invoiceItem invoiceLine;
}

class InvoiceLine {
	ref Invoice#invoiceLines invoice;
	ref InvoiceItem#invoiceLine invoiceItem;
}


