@namespace(uri="http://www.example.org/hospital", prefix="hospital")
package hospital;

class Department {
	val Room[*]#department rooms;
}

class Category {
	attr double price;
	attr String type;
	ref Room[*]#category rooms;
}

class Room {
	ref Department[1]#rooms department;
	ref Category[1]#rooms category;
	val Bed[*]#room beds;
}

class Bed {
	ref Room[1]#beds room;
	ref Proposal#bed proposal;
	ref Stay[*]#bed stays;
}

class Proposal {
	attr String status;
	attr boolean validated;
	ref Bed[1]#proposal bed;
	ref Person[1]#proposal person;
}

class Person {
	attr String name;
	attr EDate birthdate;
	attr EDate registrationDate;
	attr String abilities;
	ref Proposal#person proposal;
	ref Stay[*]#person stays;
	val Invoice[*]#person invoices;
}

class Stay {
	attr EDate intakeDate;
	attr EDate endDate;
	ref Person[1]#stays person;
	ref Bed[1]#stays bed;
	ref InvoiceItem#stay invoiceItem;
}

class Invoice {
	attr EDate invoiceDate;
	attr double outstandingAmount;
	attr String status;
	ref Person[1]#invoices person;
	val InvoiceLine[*]#invoice invoiceLines;
}

class InvoiceItem {
	ref Stay[1]#invoiceItem stay;
	ref InvoiceLine#invoiceItem invoiceLine;
}

class InvoiceLine {
	ref Invoice[1]#invoiceLines invoice;
	ref InvoiceItem#invoiceLine invoiceItem;
}


