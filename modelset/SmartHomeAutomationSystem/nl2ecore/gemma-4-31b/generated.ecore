<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ePackage name="SmartHomeAutomation" nsURI="http://www.example.org/SmartHomeAutomation">
    <eClass name="SHASSystem">
      <eStructuralFeatures>
        <eReference name="smartHomes" eType="SmartHome" containment="true"/>
        <eReference name="owners" eType="Owner" containment="true"/>
        <eReference name="automationRules" eType="AutomationRule" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="SmartHome">
      <eStructuralFeatures>
        <eAttribute name="physicalAddress" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EString"/>
        <eReference name="rooms" eType="Room" containment="true"/>
        <eReference name="activityLog" eType="ActivityLog" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="roomName" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EString"/>
        <eReference name="devices" eType="Device" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Device" abstract="true">
      <eStructuralFeatures>
        <eAttribute name="deviceId" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EString"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="SensorDevice">
      <eSuperClass>Device</eSuperClass>
      <eStructuralFeatures>
        <eReference name="readings" eType="SensorReading" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="ActuatorDevice">
      <eSuperClass>Device</eSuperClass>
      <eStructuralFeatures>
        <eReference name="commands" eType="ControlCommand" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="SensorReading">
      <eStructuralFeatures>
        <eAttribute name="measuredValue" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EDouble"/>
        <eAttribute name="timestamp" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EDate"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="ControlCommand">
      <eStructuralFeatures>
        <eAttribute name="commandName" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EString"/>
        <eAttribute name="timestamp" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EDate"/>
        <eReference name="status" eType="CommandStatus"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="CommandStatus">
      <eEnumLiterals>
        <eLiteral name="REQUESTED"/>
        <eLiteral name="COMPLETED"/>
        <eLiteral name="FAILED"/>
      </eEnumLiterals>
    </eClass>

    <eClass name="ActivityLog">
      <eStructuralFeatures>
        <eReference name="recordedReadings" eType="SensorReading"/>
        <eReference name="recordedCommands" eType="ControlCommand"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Owner">
      <eStructuralFeatures>
        <eAttribute name="ownerName" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EString"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="AutomationRule">
      <eStructuralFeatures>
        <eAttribute name="isActive" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EBoolean"/>
        <eReference name="owner" eType="Owner"/>
        <eReference name="precondition" eType="Precondition" containment="true"/>
        <eReference name="action" eType="Action" containment="true"/>
        <eReference name="dependsOn" eType="AutomationRule"/>
        <eReference name="conflictsWith" eType="AutomationRule"/>
        <eReference name="triggerLogs" eType="RuleTriggerLog" containment="true"/>
      </eStructuralFeatures>
      <eOperations>
        <eOperation name="activate"/>
        <eOperation name="deactivate"/>
        <eOperation name="edit"/>
      </eOperations>
    </eClass>

    <eClass name="RuleTriggerLog">
      <eStructuralFeatures>
        <eAttribute name="timestamp" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EDate"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Precondition" abstract="true"/>

    <eClass name="BooleanExpression">
      <eSuperClass>Precondition</eSuperClass>
      <eStructuralFeatures>
        <eReference name="leftOperand" eType="Precondition"/>
        <eReference name="rightOperand" eType="Precondition"/>
        <eReference name="operator" eType="BooleanOperator"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="NotExpression">
      <eSuperClass>Precondition</eSuperClass>
      <eStructuralFeatures>
        <eReference name="operand" eType="Precondition"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="RelationalTerm">
      <eSuperClass>Precondition</eSuperClass>
      <eStructuralFeatures>
        <eReference name="targetRoom" eType="Room"/>
        <eReference name="targetSensor" eType="SensorDevice"/>
        <eReference name="targetActuator" eType="ActuatorDevice"/>
        <eReference name="targetReading" eType="SensorReading"/>
        <eReference name="targetCommand" eType="ControlCommand"/>
        <eAttribute name="comparisonValue" eType="ecore://xmlns.eclipse.org/emf/Ecore#//EString"/>
        <eReference name="operator" eType="RelationalOperator"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="BooleanOperator">
      <eEnumLiterals>
        <eLiteral name="AND"/>
        <eLiteral name="OR"/>
        <eLiteral name="NOT"/>
      </eEnumLiterals>
    </eClass>

    <eClass name="RelationalOperator">
      <eEnumLiterals>
        <eLiteral name="EQUALS"/>
        <eLiteral name="NOT_EQUALS"/>
        <eLiteral name="LESS_THAN"/>
        <eLiteral name="GREATER_THAN"/>
        <eLiteral name="LESS_THAN_OR_EQUAL"/>
        <eLiteral name="GREATER_THAN_OR_EQUAL"/>
      </eEnumLiterals>
    </eClass>

    <eClass name="Action">
      <eStructuralFeatures>
        <eReference name="commands" eType="ControlCommand" containment="true"/>
      </eStructuralFeatures>
    </eClass>
  </ePackage>
</xmi:XMI>
