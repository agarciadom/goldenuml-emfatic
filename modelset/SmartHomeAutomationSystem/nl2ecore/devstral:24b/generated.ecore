<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
                xmlns:xmi="http://www.omg.org/XMI"
                xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                name="SmartHomeAutomationSystem" nsURI="http://www.example.org/SHAS" nsPrefix="SHAS">

    <!-- Root Container -->
    <eClassifiers xsi:type="ecore:EClass" name="RootContainer">
        <eStructuralFeatures xsi:type="ecore:EReference" name="smartHomes" lowerBound="0"
                              eType="#//SmartHome"/>
    </eClassifiers>

    <!-- Smart Home -->
    <eClassifiers xsi:type="ecore:EClass" name="SmartHome">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EString"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="rooms" lowerBound="0"
                              eType="#//Room" containment="true"/>
    </eClassifiers>

    <!-- Room -->
    <eClassifiers xsi:type="ecore:EClass" name="Room">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomName" eType="ecore:EString"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="sensorDevices" lowerBound="0"
                              eType="#//SensorDevice" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="actuatorDevices" lowerBound="0"
                              eType="#//ActuatorDevice" containment="true"/>
    </eClassifiers>

    <!-- Device -->
    <eClassifiers xsi:type="ecore:EClass" name="Device">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="deviceId" eType="ecore:EString"/>
    </eClassifiers>

    <!-- Sensor Device -->
    <eClassifiers xsi:type="ecore:EClass" name="SensorDevice" eSuperTypes="#//Device">
        <eOperations xsi:type="ecore:EOperation" name="getReadings"
                     eType="#//SensorReading" lowerBound="0"/>
    </eClassifiers>

    <!-- Actuator Device -->
    <eClassifiers xsi:type="ecore:EClass" name="ActuatorDevice" eSuperTypes="#//Device">
        <eOperations xsi:type="ecore:EOperation" name="getCommands"
                     eType="#//ControlCommand" lowerBound="0"/>
    </eClassifiers>

    <!-- Sensor Reading -->
    <eClassifiers xsi:type="ecore:EClass" name="SensorReading">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="measuredValue" eType="ecore:EFloat"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="timestamp" eType="#//TimeWithoutDate"/>
    </eClassifiers>

    <!-- Control Command -->
    <eClassifiers xsi:type="ecore:EClass" name="ControlCommand">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="commandName" eType="ecore:EString"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="status" eType="#//CommandStatus"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="timestamp" eType="#//TimeWithoutDate"/>
    </eClassifiers>

    <!-- Time Without Date -->
    <eClassifiers xsi:type="ecore:EDataType" name="TimeWithoutDate">
        <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
            <details key="instanceClassName" value="java.time.LocalTime"/>
        </eAnnotations>
    </eClassifiers>

    <!-- Command Status -->
    <eClassifiers xsi:type="ecore:EEnum" name="CommandStatus">
        <eLiterals name="Requested" value="0" literal="requested"/>
        <eLiterals name="Completed" value="1" literal="completed"/>
        <eLiterals name="Failed" value="2" literal="failed"/>
    </eClassifiers>

    <!-- Activity Log -->
    <eClassifiers xsi:type="ecore:EClass" name="ActivityLog">
        <eStructuralFeatures xsi:type="ecore:EReference" name="sensorReadings" lowerBound="0"
                              eType="#//SensorReading" containment="true"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="controlCommands" lowerBound="0"
                              eType="#//ControlCommand" containment="true"/>
    </eClassifiers>

    <!-- Automation Rule -->
    <eClassifiers xsi:type="ecore:EClass" name="AutomationRule">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="precondition" eType="ecore:EString"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="action" eType="ecore:EString"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="isActive" eType="ecore:EBoolean"/>
    </eClassifiers>

    <!-- Rule Dependency (Association Class) -->
    <eClassifiers xsi:type="ecore:EClass" name="RuleDependency">
        <eStructuralFeatures xsi:type="ecore:EReference" name="dependentRule"
                              containment="true" eType="#//AutomationRule"/>
        <eStructuralFeatures xsi:type="ecore:EReference" name="dependsOnRule" eType="#//AutomationRule"/>
    </eClassifiers>
</ecore:EPackage>
