<?xml version="1.0" encoding="UTF-8"?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:type="ecore:EPackage"
       name="smartHomeAutomationSystem"
       namespaceURI="http://smart.home.automation/system"
       nsPrefix="shas">
  <!-- EPackage definition -->
  
  <!-- SmartHomeAutomationSystem (root container) -->
  <eClassifiers xsi:type="ecore:EClass" name="SmartHomeAutomationSystem">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="smartHomes"
                         upperBound="-1"
                         type="shas/SmartHome"
                         containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="activityLog"
                         type="shas/ActivityLog"
                         containment="true"/>
  </eClassifiers>

  <!-- SmartHome -->
  <eClassifiers xsi:type="ecore:EClass" name="SmartHome">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="address"
                         type="java/lang/String"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="rooms"
                         upperBound="-1"
                         type="shas/Room"
                         containment="true"/>
  </eClassifiers>

  <!-- Room -->
  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="name"
                         type="java/lang/String"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="sensors"
                         upperBound="-1"
                         type="shas/SensorDevice"
                         containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="actuators"
                         upperBound="-1"
                         type="shas/ActuatorDevice"
                         containment="true"/>
  </eClassifiers>

  <!-- Device (abstract base for all devices) -->
  <eClassifiers xsi:type="ecore:EClass" name="Device">
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="deviceId"
                         type="java/lang/String"
                         unique="true"/>
  </eClassifiers>

  <!-- SensorDevice -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorDevice">
    <eSuperTypes xsi:type="ecore:EReference" href="#//shas/Device"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="sensorType"
                         type="shas/SensorType"/>
  </eClassifiers>

  <!-- ActuatorDevice -->
  <eClassifiers xsi:type="ecore:EClass" name="ActuatorDevice">
    <eSuperTypes xsi:type="ecore:EReference" href="#//shas/Device"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="actuatorType"
                         type="shas/ActuatorType"/>
  </eClassifiers>

  <!-- SensorType (EEnum) -->
  <eClassifiers xsi:type="ecore:EEnum" name="SensorType">
    <eLiterals>
      <item value="Temperature"/>
      <item value="Movement"/>
    </eLiterals>
  </eClassifiers>

  <!-- ActuatorType (EEnum) -->
  <eClassifiers xsi:type="ecore:EEnum" name="ActuatorType">
    <eLiterals>
      <item value="LightController"/>
      <item value="LockController"/>
    </eLiterals>
  </eClassifiers>

  <!-- ActivityLog -->
  <eClassifiers xsi:type="ecore:EClass" name="ActivityLog">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="sensorReadings"
                         upperBound="-1"
                         type="shas/SensorReading"
                         containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="controlCommands"
                         upperBound="-1"
                         type="shas/ControlCommand"
                         containment="true"/>
  </eClassifiers>

  <!-- SensorReading -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorReading">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="sensor"
                         type="shas/SensorDevice"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="value"
                         type="java/lang/Double"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="timestamp"
                         type="java/time/Instant"/>
  </eClassifiers>

  <!-- ControlCommand -->
  <eClassifiers xsi:type="ecore:EClass" name="ControlCommand">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="actuator"
                         type="shas/ActuatorDevice"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="commandName"
                         type="java/lang/String"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="timestamp"
                         type="java/time/Instant"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="status"
                         type="shas/CommandStatus"/>
  </eClassifiers>

  <!-- CommandStatus (EEnum) -->
  <eClassifiers xsi:type="ecore:EEnum" name="CommandStatus">
    <eLiterals>
      <item value="requested"/>
      <item value="completed"/>
      <item value="failed"/>
    </eLiterals>
  </eClassifiers>

  <!-- AutomationRule -->
  <eClassifiers xsi:type="ecore:EClass" name="AutomationRule">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="precondition"
                         type="shas/BooleanExpression"/>
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="action"
                         type="shas/ControlCommandSequence"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="isActive"
                         type="java/lang/Boolean"
                         defaultValue="true"/>
  </eClassifiers>

  <!-- User (owner of automation rules) -->
  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="automationRules"
                         upperBound="-1"
                         type="shas/AutomationRule"
                         containment="true"/>
  </eClassifiers>

  <!-- BooleanExpression (representing preconditions) -->
  <eClassifiers xsi:type="ecore:EClass" name="BooleanExpression">
    <!-- Left operand for binary operators or the sole term for NOT -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="leftOperand"
                         lowerBound="0"
                         upperBound="-1"
                         type="shas/BooleanExpression"
                         containment="true"/>
    <!-- Right operand only used with AND/OR -->
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="rightOperand"
                         lowerBound="0"
                         upperBound="-1"
                         type="shas/BooleanExpression"
                         containment="true"/>
    <!-- Operator (AND, OR, NOT); for NOT only leftOperand is used -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="operator"
                         type="shas/BooleanOperator"/>
    <!-- When this expression represents an atomic relational term (e.g., "actualTemperature<18") -->
    <eStructuralFeatures xsi:type="ecore:EAttribute"
                         name="atomicTerm"
                         type="java/lang/String"/>
  </eClassifiers>

  <!-- BooleanOperator (EEnum) -->
  <eClassifiers xsi:type="ecore:EEnum" name="BooleanOperator">
    <eLiterals>
      <item value="AND"/>
      <item value="OR"/>
      <item value="NOT"/>
    </eLiterals>
  </eClassifiers>

  <!-- ControlCommandSequence (ordered list of commands to execute as an action) -->
  <eClassifiers xsi:type="ecore:EClass" name="ControlCommandSequence">
    <eStructuralFeatures xsi:type="ecore:EReference"
                         name="commands"
                         upperBound="-1"
                         type="shas/ControlCommand"
                         containment="true"/>
  </eClassifiers>

</model>
