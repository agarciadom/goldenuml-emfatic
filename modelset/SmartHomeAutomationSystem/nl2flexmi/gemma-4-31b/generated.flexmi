<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SHAS" nsURI="http://www.shas.org/efs" nsPrefix="shas">
  <eClassifiers>
    <eClass name="SmartHome">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="activityLog" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="automationRules" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eReference name="devices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Device">
      <eStructuralFeatures>
        <eAttribute name="deviceId" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Actuator" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SensorReading">
      <eStructuralFeatures>
        <eAttribute name="value" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="timestamp" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="sensor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ControlCommand">
      <eStructuralFeatures>
        <eAttribute name="commandName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="timestamp" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="actuator" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActivityLog">
      <eStructuralFeatures>
        <eReference name="sensorReadings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="controlCommands" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AutomationRule">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="isActive" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="precondition" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="action" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.12" />
        <eReference name="relatedRules" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Precondition">
      <eStructuralFeatures />
    </eClass>
    <eClass name="BooleanExpression" eSuperTypes="//@eClassifiers.9">
      <eStructuralFeatures>
        <eAttribute name="operator" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="operands" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RelationalTerm" eSuperTypes="//@eClassifiers.9">
      <eStructuralFeatures>
        <eAttribute name="operator" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="device" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="room" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="sensorReading" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="controlCommand" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Action">
      <eStructuralFeatures>
        <eReference name="commands" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RuleTrigger">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="triggeredRule" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="userName" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="managedRules" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
