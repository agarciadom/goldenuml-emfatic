@namespace(uri="http://www.shas.org/efs", prefix="shas")
package SHAS;

import "http://www.eclipse.org/emf/2002/Ecore";

class SmartHome {
	attr ecore.EString address;
	val Room[+] rooms;
	val ActivityLog activityLog;
	val AutomationRule[*] automationRules;
}

class Room {
	val Device[*] devices;
}

class Device {
	attr ecore.EString deviceId;
}

class Sensor extends Device {
}

class Actuator extends Device {
}

class SensorReading {
	attr ecore.EDouble value;
	attr ecore.EDate timestamp;
	ref Sensor[1] sensor;
}

class ControlCommand {
	attr ecore.EString commandName;
	attr ecore.EDate timestamp;
	attr ecore.EString status;
	ref Actuator[1] actuator;
}

class ActivityLog {
	val SensorReading[*] sensorReadings;
	val ControlCommand[*] controlCommands;
}

class AutomationRule {
	attr ecore.EString name;
	attr ecore.EBoolean isActive;
	val Precondition[1] precondition;
	val Action[1] action;
	ref AutomationRule[*] relatedRules;
}

class Precondition {
}

class BooleanExpression extends Precondition {
	attr ecore.EString operator;
	val Precondition[*] operands;
}

class RelationalTerm extends Precondition {
	attr ecore.EString operator;
	ref Device device;
	ref Room room;
	ref SensorReading sensorReading;
	ref ControlCommand controlCommand;
}

class Action {
	val ControlCommand[+] commands;
}

class RuleTrigger {
	attr ecore.EDate timestamp;
	ref AutomationRule[1] triggeredRule;
}

class User {
	attr ecore.EString userName;
	ref AutomationRule[*] managedRules;
}


