<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SmartHomeAutomationSystem" nsURI="http://example.com/SHAS" nsPrefix="shas">
  <eClassifiers>
    <eClass name="SmartHome">
      <eStructuralFeatures>
        <eReference name="rooms" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="sensors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="actuators" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="rules" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eReference name="sensorDevices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="actuatorDevices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SensorDevice">
      <eStructuralFeatures>
        <eAttribute name="deviceIdentifier" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="smartHome" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActuatorDevice">
      <eStructuralFeatures>
        <eAttribute name="deviceIdentifier" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="smartHome" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AutomationRule">
      <eStructuralFeatures>
        <eReference name="precondition" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="action" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ControlCommand">
      <eStructuralFeatures>
        <eReference name="actuatorDevice" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActivityLog">
      <eStructuralFeatures>
        <eReference name="sensorReadings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="controlCommands" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BooleanExpression">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SequenceOfCommands">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SensorReading">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
