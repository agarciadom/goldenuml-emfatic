@namespace(uri="http://example.com/SHAS", prefix="shas")
package SmartHomeAutomationSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class SmartHome {
	val Room[+] rooms;
	ref SensorDevice[*] sensors;
	ref ActuatorDevice[*] actuators;
	ref AutomationRule[*] rules;
}

class Room {
	val SensorDevice[*] sensorDevices;
	val ActuatorDevice[*] actuatorDevices;
}

class SensorDevice {
	attr ecore.EString[1] deviceIdentifier;
	ref SmartHome smartHome;
}

class ActuatorDevice {
	attr ecore.EString[1] deviceIdentifier;
	ref SmartHome smartHome;
}

class AutomationRule {
	ref BooleanExpression[1] precondition;
	val SequenceOfCommands[*] action;
}

class ControlCommand {
	ref ActuatorDevice[1] actuatorDevice;
	attr ecore.EDate[1] timestamp;
}

class ActivityLog {
	val SensorReading[*] sensorReadings;
	val ControlCommand[*] controlCommands;
}

class BooleanExpression {
}

class SequenceOfCommands {
}

class SensorReading {
}


