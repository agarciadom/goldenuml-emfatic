@namespace(uri="http://www.example.org/smart_home_automation_system", prefix="shas")
package SmartHomeAutomationSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class SmartHome {
	attr ecore.EString address;
	val Room[+] rooms;
}

class Room {
	attr ecore.EString[1] name;
	attr ecore.EInt xCoordinate;
	attr ecore.EInt yCoordinate;
	val Device[*] devices;
}

class Device {
	attr ecore.EString[1] deviceID;
	attr ecore.EString type;
}

class Sensor extends Device {
}

class Actuator extends Device {
}

class SensorReading {
	attr ecore.EDouble[1] measuredValue;
	attr ecore.EDate[1] timestamp;
	ref Sensor[1] sensor;
}

class ControlCommand {
	attr ecore.EString[1] commandName;
	attr ecore.EString status;
	attr ecore.EDate[1] timestamp;
	ref Actuator[1] actuator;
}

class AutomationRule {
	attr ecore.EInt[1] ruleID;
	attr ecore.EBoolean[1] isActive;
	val BooleanExpression precondition;
	val ControlCommand[*] actions;
}

class BooleanExpression {
	attr ecore.EString expression;
}

class ActivityLog {
	val SensorReading[*] sensorReadings;
	val ControlCommand[*] controlCommands;
}


