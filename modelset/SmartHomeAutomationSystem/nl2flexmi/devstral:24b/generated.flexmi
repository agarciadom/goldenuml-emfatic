<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SmartHomeAutomationSystem" nsURI="http://smart-home-automation-system" nsPrefix="shas">
  <eClassifiers>
    <eClass name="SmartHome">
      <eStructuralFeatures>
        <eAttribute name="physicalAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="activityLog" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="automationRules" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eReference name="sensorDevices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="actuatorDevices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Device">
      <eStructuralFeatures>
        <eAttribute name="deviceID" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SensorDevice" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="ActuatorDevice" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SensorReading">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="measuredValue" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ControlCommand">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActivityLog">
      <eStructuralFeatures>
        <eReference name="sensorReadings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="controlCommands" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AutomationRule">
      <eStructuralFeatures>
        <eAttribute name="precondition" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="actionCommands" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="dependsOnRules" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
        <eReference name="conflictsWithRules" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
