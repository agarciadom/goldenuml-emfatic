<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SmartHomeAutomationSystem" nsURI="http://www.example.org/smart_home_automation_system" nsPrefix="shas">
  <eClassifiers>
    <eClass name="SmartHome">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="xCoordinate" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="yCoordinate" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="devices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Device">
      <eStructuralFeatures>
        <eAttribute name="deviceID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="type" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Sensor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Actuator" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SensorReading">
      <eStructuralFeatures>
        <eAttribute name="measuredValue" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="sensor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ControlCommand">
      <eStructuralFeatures>
        <eAttribute name="commandName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="timestamp" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="actuator" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AutomationRule">
      <eStructuralFeatures>
        <eAttribute name="ruleID" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isActive" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="precondition" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="actions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BooleanExpression">
      <eStructuralFeatures>
        <eAttribute name="expression" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActivityLog">
      <eStructuralFeatures>
        <eReference name="sensorReadings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="controlCommands" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
