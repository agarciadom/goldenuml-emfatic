@namespace(uri="http://www.example.org/smarthome", prefix="smarthome")
package smarthome;

enum DeviceStatus {
	Activated = 0;
	Deactivated = 1;
}

enum CommandType {
	lockDoor = 0;
	turnOnHeating = 1;
}

enum CommandStatus {
	Requested = 0;
	Completed = 1;
	Failed = 2;
}

enum RuleStatus {
	created = 0;
	edited = 1;
	activated = 2;
	deactivated = 3;
}

enum BinaryOp {
	AND = 0;
	OR = 1;
}

class Address {
	attr String address;
}

class User {
	attr String name;
	ref SmartHome[*]#owners smartHomes;
}

class SmartHome {
	val Address address;
	val Room[*] rooms;
	val ActivityLog log;
	ref User[*]#smartHomes owners;
}

class Room {
	val Sensor[*] sensors;
	val Actuator[*] actuators;
}

abstract class Device {
	attr DeviceStatus deviceStatus;
	attr Integer deviceID;
}

class Sensor extends Device {
}

class Actuator extends Device {
}

class ActivityLog {
	val SensorReading[*] recordedReadings;
	val ControlCommand[*] recordedCommands;
}

abstract class RuntimeElement {
	attr EDate timestamp;
}

class SensorReading extends RuntimeElement {
	attr Double value;
	ref Sensor[1] sensor;
}

class ControlCommand extends RuntimeElement {
	attr CommandType commandType;
	attr CommandStatus commandStatus;
	ref Actuator[1] actuator;
}

class CommandSequence {
	ref CommandSequence nextCommand;
	val ControlCommand command;
}

class AlertRule {
	attr RuleStatus ruleStatus;
	val BooleanExpression precondition;
	val CommandSequence[*] actions;
}

abstract class BooleanExpression {
}

class RelationalTerm extends BooleanExpression {
	ref Room room;
	ref Device device;
	ref RuntimeElement runtimeElement;
}

class NotExpression extends BooleanExpression {
	ref BooleanExpression[1] expression;
}

class BinaryExpression extends BooleanExpression {
	attr BinaryOp ~op;
	ref BooleanExpression[1] leftExpr;
	ref BooleanExpression[1] rightExpr;
}

class SmartHomeSystem {
	val SmartHome[*] smartHomes;
	val User[*] users;
	val AlertRule[*] alertRules;
}


