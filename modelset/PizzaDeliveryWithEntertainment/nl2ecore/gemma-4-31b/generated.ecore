<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ePackage name="PizzaDeliveryEntertainment" nsUri="http://www.example.org/pizzadelivery" nsPrefix="pizza">
    
    <!-- Custom DataType for java.time.LocalTime as requested -->
    <eDataType name="LocalTime" uri="java.time.LocalTime"/>

    <!-- Root container acting as the system entry point, containing all top-level entities -->
    <eClass name="PizzaDeliverySystem">
      <eStructuralFeatures>
        <eReference name="users" reference="User" containment="true"/>
        <eReference name="restaurants" reference="PizzaRestaurant" containment="true"/>
        <eReference name="orders" reference="Order" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="userId" eType="ecore.EString"/>
        <eAttribute name="name" eType="ecore.EString"/>
        <eAttribute name="birthday" eType="ecore.EDate"/>
        <eAttribute name="address" eType="ecore.EString"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="BusinessOwner" eSuperClass="User">
      <eStructuralFeatures>
        <eAttribute name="linkedInAccount" eType="ecore.EString"/>
        <eReference name="ownedRestaurants" reference="PizzaRestaurant"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="HungryCustomer" eSuperClass="User">
      <eStructuralFeatures>
        <eAttribute name="deliveryAddress" eType="ecore.EString"/>
        <eReference name="customerOrders" reference="Order"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Entertainer" eSuperClass="User">
      <eStructuralFeatures>
        <eAttribute name="stageName" eType="ecore.EString"/>
        <eAttribute name="bio" eType="ecore.EString"/>
        <eAttribute name="pricePer30Minutes" eType="ecore.EDouble"/>
        <!-- Association class: Entertainer end of the association with PizzaRestaurant -->
        <eReference name="availabilities" reference="Availability" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="PizzaRestaurant">
      <eStructuralFeatures>
        <eAttribute name="zipCode" eType="ecore.EString"/>
        <eAttribute name="address" eType="ecore.EString"/>
        <eAttribute name="phoneNumber" eType="ecore.EString"/>
        <eAttribute name="website" eType="ecore.EString"/>
        <eAttribute name="openingHours" eType="ecore.EString"/>
        <eReference name="owner" reference="BusinessOwner"/>
        <eReference name="menuPizzas" reference="Pizza" containment="true"/>
        <!-- Association class: PizzaRestaurant end of the association with Entertainer -->
        <eReference name="restaurantAvailabilities" reference="Availability"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Pizza">
      <eStructuralFeatures>
        <eAttribute name="name" eType="ecore.EString"/>
        <eAttribute name="crustStructure" eType="ecore.EString"/>
        <eAttribute name="price" eType="ecore.EDouble"/>
        <eReference name="restaurant" reference="PizzaRestaurant"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="orderId" eType="ecore.EString"/>
        <eAttribute name="dateTimePlaced" eType="ecore.EDate"/>
        <eAttribute name="latestDeliveryTime" eType="pizza.LocalTime"/>
        <eAttribute name="numberOfPeople" eType="ecore.EInt"/>
        <eReference name="customer" reference="HungryCustomer"/>
        <eReference name="orderedPizzas" reference="Pizza"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="EntertainmentOrder" eSuperClass="Order">
      <eStructuralFeatures>
        <eAttribute name="entertainmentType" eType="ecore.EString"/>
        <eAttribute name="duration" eType="ecore.EInt"/>
        <eReference name="assignedEntertainer" reference="Entertainer"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Association Class for the relationship between Entertainer and PizzaRestaurant -->
    <eClass name="Availability">
      <eStructuralFeatures>
        <eAttribute name="dayOfWeek" eType="ecore.EString"/>
        <!-- Non-containment reference to complete the association loop -->
        <eReference name="restaurant" reference="PizzaRestaurant"/>
        <eReference name="entertainer" reference="Entertainer"/>
      </eStructuralFeatures>
    </eClass>

  </ePackage>
</xmi:XMI>
