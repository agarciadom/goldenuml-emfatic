@namespace(uri="http://www.example.org/pizzaEntertainment", prefix="pizzaEntertainment")
package pizzaEntertainment;

datatype LocalTime : java.time.LocalTime;

class App {
	val AppUser[*] users;
	val PizzaRestaurant[*] pizzaRestaurants;
	val Order[*] orders;
	val EntertainerAvailability[*] availabilities;
}

abstract class AppUser {
	id attr String userId;
	attr String name;
	attr String address;
	attr EDate birthday;
}

class BusinessOwner extends AppUser {
	attr String linkedInAccount;
	ref PizzaRestaurant[*]#owner ownedRestaurants;
}

class PizzaRestaurant {
	attr String zipCode;
	attr String address;
	attr String phoneNumber;
	attr String website;
	attr String openingHours;
	ref BusinessOwner#ownedRestaurants owner;
	val Pizza[*]#restaurant offeredPizzas;
}

class Pizza {
	attr String name;
	attr String crustStructure;
	attr double price;
	ref PizzaRestaurant#offeredPizzas restaurant;
}

class HungryCustomer extends AppUser {
	attr String deliveryAddress;
	ref Order[*]#customer orders;
}

class Order {
	id attr String orderId;
	attr EDate dateTime;
	attr EDate latestDeliveryTime;
	attr int numberOfPeople;
	ref HungryCustomer#orders customer;
	ref Pizza[+] pizzas;
}

class EntertainmentOrder extends Order {
	attr String entertainmentType;
	attr int duration;
	ref Entertainer#entertainmentOrders entertainer;
}

class Entertainer extends AppUser {
	attr String stageName;
	attr String bio;
	attr double pricePer30Minutes;
	ref EntertainmentOrder[*]#entertainer entertainmentOrders;
	ref EntertainerAvailability[*]#entertainer availabilities;
}

enum Day {
	MONDAY = 0;
	TUESDAY = 0;
	WEDNESDAY = 0;
	THURSDAY = 0;
	FRIDAY = 0;
	SATURDAY = 0;
	SUNDAY = 0;
}

class EntertainerAvailability {
	attr Day[*] availableDays;
	ref Entertainer#availabilities entertainer;
	ref PizzaRestaurant pizzaRestaurant;
}


