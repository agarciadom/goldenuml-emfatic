<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
  xmlns:xmi="http://www.omg.org/XMI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
  name="pizzaEntertainment"
  nsURI="http://www.example.org/pizzaEntertainment"
  nsPrefix="pizzaEntertainment">

  <!-- Custom datatype for time-of-day without date -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
    instanceClassName="java.time.LocalTime"/>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="App">
    <eStructuralFeatures xsi:type="ecore:EReference" name="users"
      eType="#//AppUser" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pizzaRestaurants"
      eType="#//PizzaRestaurant" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orders"
      eType="#//Order" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="availabilities"
      eType="#//EntertainerAvailability" upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- AppUser: base class for all users -->
  <eClassifiers xsi:type="ecore:EClass" name="AppUser" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="userId"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
      iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthday"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>

  <!-- BusinessOwner -->
  <eClassifiers xsi:type="ecore:EClass" name="BusinessOwner" eSuperTypes="#//AppUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="linkedInAccount"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedRestaurants"
      eType="#//PizzaRestaurant" upperBound="-1" eOpposite="#//PizzaRestaurant/owner"/>
  </eClassifiers>

  <!-- PizzaRestaurant -->
  <eClassifiers xsi:type="ecore:EClass" name="PizzaRestaurant">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="zipCode"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="website"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="openingHours"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="owner"
      eType="#//BusinessOwner" eOpposite="#//BusinessOwner/ownedRestaurants"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="offeredPizzas"
      eType="#//Pizza" upperBound="-1" containment="true" eOpposite="#//Pizza/restaurant"/>
  </eClassifiers>

  <!-- Pizza -->
  <eClassifiers xsi:type="ecore:EClass" name="Pizza">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="crustStructure"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="restaurant"
      eType="#//PizzaRestaurant" eOpposite="#//PizzaRestaurant/offeredPizzas"/>
  </eClassifiers>

  <!-- HungryCustomer -->
  <eClassifiers xsi:type="ecore:EClass" name="HungryCustomer" eSuperTypes="#//AppUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deliveryAddress"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orders"
      eType="#//Order" upperBound="-1" eOpposite="#//Order/customer"/>
  </eClassifiers>

  <!-- Order -->
  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderId"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
      iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateTime"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="latestDeliveryTime"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfPeople"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer"
      eType="#//HungryCustomer" eOpposite="#//HungryCustomer/orders"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pizzas"
      eType="#//Pizza" upperBound="-1" lowerBound="1"/>
  </eClassifiers>

  <!-- EntertainmentOrder: special subtype of Order -->
  <eClassifiers xsi:type="ecore:EClass" name="EntertainmentOrder" eSuperTypes="#//Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="entertainmentType"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entertainer"
      eType="#//Entertainer" eOpposite="#//Entertainer/entertainmentOrders"/>
  </eClassifiers>

  <!-- Entertainer -->
  <eClassifiers xsi:type="ecore:EClass" name="Entertainer" eSuperTypes="#//AppUser">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stageName"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bio"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pricePer30Minutes"
      eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entertainmentOrders"
      eType="#//EntertainmentOrder" upperBound="-1" eOpposite="#//EntertainmentOrder/entertainer"/>
    <!-- Association to PizzaRestaurant via association class EntertainerAvailability -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="availabilities"
      eType="#//EntertainerAvailability" upperBound="-1"
      eOpposite="#//EntertainerAvailability/entertainer"/>
  </eClassifiers>

  <!-- Day enumeration -->
  <eClassifiers xsi:type="ecore:EEnum" name="Day">
    <eLiterals name="MONDAY"/>
    <eLiterals name="TUESDAY"/>
    <eLiterals name="WEDNESDAY"/>
    <eLiterals name="THURSDAY"/>
    <eLiterals name="FRIDAY"/>
    <eLiterals name="SATURDAY"/>
    <eLiterals name="SUNDAY"/>
  </eClassifiers>

  <!-- EntertainerAvailability: association class between Entertainer and PizzaRestaurant -->
  <eClassifiers xsi:type="ecore:EClass" name="EntertainerAvailability">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="availableDays"
      eType="#//Day" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entertainer"
      eType="#//Entertainer" eOpposite="#//Entertainer/availabilities"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pizzaRestaurant"
      eType="#//PizzaRestaurant"/>
  </eClassifiers>

</ecore:EPackage>
