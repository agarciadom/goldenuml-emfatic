<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="PizzaDelivery" nsURI="http://pizzadelivery/1.0" nsPrefix="pd">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthday" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessOwner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="linkedInAccount" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PizzaRestaurant">
      <eStructuralFeatures>
        <eAttribute name="zipCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="website" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="openingHours" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="businessOwner" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pizza">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="crustStructure" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="pizzaRestaurant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HungryCustomer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="deliveryAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateTimePlaced" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="latestDeliveryTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfPeople" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="pizzas" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EntertainmentOrder" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="entertainmentType" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entertainer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="stageName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="bio" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="pricePer30Minutes" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
