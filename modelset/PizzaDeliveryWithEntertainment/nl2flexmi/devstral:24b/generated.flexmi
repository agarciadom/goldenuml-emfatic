<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="PizzaDeliveryWithEntertainment" nsURI="http://www.example.org/pizzadelivery" nsPrefix="pde">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthday" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessOwner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="linkedInAccount" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="ownedRestaurants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PizzaRestaurant">
      <eStructuralFeatures>
        <eAttribute name="zipCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="website" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="openingHours" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="offersPizzas" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pizza">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="crustStructure" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HungryCustomer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="deliveryAddress" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="orderDateTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="latestDeliveryTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="peopleCount" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="includesPizzas" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EntertainmentOrder" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="entertainmentType" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="entertainer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entertainer">
      <eStructuralFeatures>
        <eAttribute name="stageName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="bio" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="pricePer30Minutes" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="worksAtRestaurants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eAttribute name="availabilityByDay" lowerBound="0" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
