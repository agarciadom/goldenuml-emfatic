@namespace(uri="http://www.example.com/pizza-delivery-entertainment", prefix="pwe")
package PizzaDeliveryWithEntertainment;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	attr ecore.EDate[1] birthday;
	attr ecore.EString[1] uniqueIdentifier;
}

class BusinessOwner extends User {
	attr ecore.EString linkedinAccount;
	val PizzaRestaurant[*] ownedRestaurants;
}

class HungryCustomer extends User {
	attr ecore.EString[1] deliveryAddress;
	val Order[*] ordersMade;
}

class Entertainer extends User {
	attr ecore.EString[1] stageName;
	attr ecore.EString[1] bio;
	attr ecore.EDouble[1] pricePer30Minutes;
	ref PizzaRestaurant[*] availableRestaurants;
}

class PizzaRestaurant {
	attr ecore.EString[1] zipCode;
	attr ecore.EString[1] phoneNumber;
	attr ecore.EString website;
	attr ecore.EString[1] openingHours;
	ref Pizza[+] pizzasOffered;
}

class Pizza {
	attr ecore.EString[1] name;
	attr ecore.EString[1] crustStructure;
	attr ecore.EDouble[1] price;
}

class Order {
	ref Pizza[+] pizzasOrdered;
	attr ecore.EString[1] orderId;
	attr ecore.EDate[1] orderTime;
	attr ecore.EDate latestDeliveryTime;
	attr ecore.EInt[1] numberOfPeople;
}

class EntertainmentOrder extends Order {
	attr ecore.EString[1] typeOfEntertainment;
	attr ecore.EInt[1] durationOfEntertainment;
	ref Entertainer[1] assignedEntertainer;
}


