<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="PizzaDeliveryWithEntertainment" nsURI="http://www.example.com/pizza-delivery-entertainment" nsPrefix="pwe">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthday" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="uniqueIdentifier" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessOwner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="linkedinAccount" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="ownedRestaurants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HungryCustomer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="deliveryAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="ordersMade" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entertainer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="stageName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="bio" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="pricePer30Minutes" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="availableRestaurants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PizzaRestaurant">
      <eStructuralFeatures>
        <eAttribute name="zipCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="website" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="openingHours" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pizzasOffered" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pizza">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="crustStructure" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eReference name="pizzasOrdered" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
        <eAttribute name="orderId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="orderTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="latestDeliveryTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfPeople" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EntertainmentOrder" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="typeOfEntertainment" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="durationOfEntertainment" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="assignedEntertainer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
