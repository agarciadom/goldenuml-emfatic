<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="PizzaEntertainment" nsURI="http://www.pizzaentertainment.com/ns" nsPrefix="pe">
  <eClassifiers>
    <eClass name="AppUser">
      <eStructuralFeatures>
        <eAttribute name="birthday" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="userId" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessOwner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="linkedinAccount" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="restaurants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HungryCustomer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="deliveryAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="orders" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entertainer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="stageName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="bio" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="pricePer30Mins" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="availabilities" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PizzaRestaurant">
      <eStructuralFeatures>
        <eAttribute name="zipCode" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="website" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="openingHours" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pizzas" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pizza">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="crustStructure" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="orderId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="latestDeliveryTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfPeople" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="pizzas" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="restaurant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EntertainmentOrder" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="entertainmentType" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="entertainer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EntertainerAvailability">
      <eStructuralFeatures>
        <eAttribute name="day" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="restaurant" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
