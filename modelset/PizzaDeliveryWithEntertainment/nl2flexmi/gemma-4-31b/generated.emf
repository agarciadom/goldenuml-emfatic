@namespace(uri="http://www.pizzaentertainment.com/ns", prefix="pe")
package PizzaEntertainment;

import "http://www.eclipse.org/emf/2002/Ecore";

class AppUser {
	attr ecore.EDate[1] birthday;
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	attr ecore.EString[1] userId;
}

class BusinessOwner extends AppUser {
	attr ecore.EString[1] linkedinAccount;
	val PizzaRestaurant[*] restaurants;
}

class HungryCustomer extends AppUser {
	attr ecore.EString[1] deliveryAddress;
	val Order[*] orders;
}

class Entertainer extends AppUser {
	attr ecore.EString[1] stageName;
	attr ecore.EString[1] bio;
	attr ecore.EBigDecimal[1] pricePer30Mins;
	val EntertainerAvailability[*] availabilities;
}

class PizzaRestaurant {
	attr ecore.EString[1] zipCode;
	attr ecore.EString[1] address;
	attr ecore.EString[1] phoneNumber;
	attr ecore.EString[1] website;
	attr ecore.EString[1] openingHours;
	val Pizza[*] pizzas;
}

class Pizza {
	attr ecore.EString[1] name;
	attr ecore.EString[1] crustStructure;
	attr ecore.EBigDecimal[1] price;
}

class Order {
	attr ecore.EString[1] orderId;
	attr ecore.EDate[1] dateTime;
	attr ecore.EDate latestDeliveryTime;
	attr ecore.EInt[1] numberOfPeople;
	ref Pizza[+] pizzas;
	ref PizzaRestaurant[1] restaurant;
}

class EntertainmentOrder extends Order {
	attr ecore.EString[1] entertainmentType;
	attr ecore.EInt[1] duration;
	ref Entertainer[1] entertainer;
}

class EntertainerAvailability {
	attr ecore.EString[1] day;
	ref PizzaRestaurant[1] restaurant;
}


