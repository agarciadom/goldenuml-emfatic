@namespace(uri="http://www.example.org/pizzaEntertainment", prefix="pizzaEntertainment")
package pizzaEntertainment;

class PizzaEntertainmentSystem {
	val User[*] users;
	val PizzaRestaurant[*] pizzaRestaurants;
	val Pizza[*] pizzas;
	val Employment[*] employments;
}

datatype DateTime : java.time.LocalDateTime;

abstract class User {
	attr int userID;
	attr EDate birthdate;
	attr String name;
	attr String address;
}

class Customer extends User {
	attr String deliveryAddress;
	val Order[*]#customer orders;
}

class Order {
	attr int orderID;
	attr DateTime orderPlacement;
	attr DateTime latestDelivery;
	attr int numberOfPeople;
	ref Customer#orders customer;
	ref PizzaRestaurant#orders pizzaRestaurant;
	ref Pizza[+]#orders pizzas;
}

class EntertainmentOrder extends Order {
	attr String entertainmentType;
	attr int duration;
	ref Entertainer#entertainmentOrders entertainer;
}

class BusinessOwner extends User {
	attr String linkedInAccount;
	ref PizzaRestaurant[*]#businessOwner pizzaRestaurants;
}

class PizzaRestaurant {
	attr int zipCode;
	attr String address;
	attr String phoneNumber;
	attr String website;
	attr String openingHours;
	ref BusinessOwner#pizzaRestaurants businessOwner;
	ref Pizza[*]#pizzaRestaurants pizzas;
	ref Order[*]#pizzaRestaurant orders;
	ref Employment[*]#pizzaRestaurant employments;
}

class Pizza {
	attr String name;
	attr String crustStructure;
	attr double price;
	ref PizzaRestaurant[*]#pizzas pizzaRestaurants;
	ref Order[*]#pizzas orders;
}

class Entertainer extends User {
	attr String stageName;
	attr String bio;
	attr double priceThirtyMin;
	ref Employment[*]#entertainer employments;
	ref EntertainmentOrder[*]#entertainer entertainmentOrders;
}

class Employment {
	attr String availability;
	ref PizzaRestaurant#employments pizzaRestaurant;
	ref Entertainer#employments entertainer;
}


