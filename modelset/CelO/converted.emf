@namespace(uri="http://www.example.org/eventmanagement", prefix="eventmanagement")
package eventmanagement;

enum AttendeeStatus {
	Yes = 0;
	Maybe = 1;
	No = 2;
	NoResponse = 3;
}

enum CompletionStatus {
	ToBeDone = 0;
	Done = 1;
	NotApplicable = 2;
	Attendee = 3;
}

class EventManagementSystem {
	val Person[*] persons;
	val Location[*] locations;
	val EventType[*] eventTypes;
	val Event[*] events;
	val CheckListTask[*] checkListTasks;
	val Registration[*] registrations;
	val TaskStatus[*] taskStatuses;
}

class Person {
	attr String lastName;
	attr String firstName;
	attr String emailAddress;
	attr String password;
	val PersonRole[0..2] roles;
}

abstract class PersonRole {
}

class Organizer extends PersonRole {
	attr String address;
	attr String phoneNumber;
	ref Event[+]#organizers events;
}

class Attendee extends PersonRole {
	ref TaskStatus[*]#attendee taskStatuses;
	ref Registration[*]#attendee registrations;
}

class Registration {
	attr AttendeeStatus status;
	ref Attendee[1]#registrations attendee;
	ref Event[1]#registrations event;
}

class TaskStatus {
	attr CompletionStatus status;
	ref Attendee#taskStatuses attendee;
	ref Event[1]#taskStatuses event;
	ref CheckListTask[1]#taskStatuses checkListTask;
}

class CheckListTask {
	attr String description;
	ref TaskStatus[*]#checkListTask taskStatuses;
	ref EventType#checkListTasks eventType;
}

class Location {
	attr String name;
	attr String address;
	ref Event[*]#location events;
}

class Event {
	attr String occasion;
	attr EDate startTime;
	attr EDate endTime;
	ref Organizer[+]#events organizers;
	ref Registration[*]#event registrations;
	ref TaskStatus[*]#event taskStatuses;
	ref Location[1]#events location;
	ref EventType[1]#events eventType;
}

class EventType {
	attr String name;
	ref Event[*]#eventType events;
	ref CheckListTask[*]#eventType checkListTasks;
}


