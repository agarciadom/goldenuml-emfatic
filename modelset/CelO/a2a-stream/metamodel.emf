@namespace(uri="http://www.example.org/CelebrationsOrganizationSystem", prefix="p")
package CelebrationsOrganizationSystem;

class Organizer {
  attr EString firstName;
  attr EString lastName;
  attr EString email;
  attr EString address;
  attr EString phoneNumber;
  attr EString password;
  attr EString selectedEventTypeName;
  attr EString customEventTypeName;
  attr EDate eventStartDateTime;
  attr EDate eventEndDateTime;
  attr EString occasion;
  attr EString locationName;
  attr EString locationAddress;
  attr EBoolean isAttendingEvent;
}
class EventType {
  attr EString name;
  val Task[*] defaultTasks;
}
class Event {
  val Organizer[*] organizers;
  ref Attendee[*] attendees;
  val Task[*] tasks;
  ref EventType eventType;
  val Location location;
  attr EDate startDateTime;
  attr EDate endDateTime;
  attr EString occasion;
}
class Attendee {
  attr EString firstName;
  attr EString lastName;
  attr EString email;
  attr EString password;
  attr EString rsvpStatus;
  ref Event[*] events;
  ref Task[*] assignedTasks;
}
class Task {
  attr EString name;
  attr EString status;
  attr EString category;
  ref Attendee[*] attendees;
}
class Location {
  attr EString name;
  attr EString address;
}