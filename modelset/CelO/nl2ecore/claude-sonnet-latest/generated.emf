@namespace(uri="http://www.example.org/celo", prefix="celo")
package celo;

class CelOSystem {
	val User[*] users;
	val Event[*] events;
	val EventKind[*] eventKinds;
	val Location[*] locations;
	val Task[*] tasks;
}

abstract class User {
	attr String firstName;
	attr String lastName;
	attr String email;
	attr String password;
}

class Organizer extends User {
	op void viewInvitationStatus(Event event);
	op void setTaskStatus(EventTask task, TaskStatus status);
	op void addTask(Task task, Event event);
	op void designateTaskForAttendee(EventTask task);
	op void inviteAttendee(String firstName, String lastName, String email);
	attr String postalAddress;
	attr String phoneNumber;
	ref EventOrganizer[*]#organizer organizedEvents;
}

class Attendee extends User {
	op void respondToInvitation(Invitation invitation, InvitationStatus status);
	op void selectTask(EventTask eventTask);
	ref Invitation[*]#attendee invitations;
	ref AttendeeTask[*]#attendee assignedTasks;
}

class OrganizerAttendee extends Organizer, Attendee {
}

class EventKind {
	attr String name;
	ref Task[*] defaultTasks;
}

class Location {
	attr String name;
	attr String address;
}

class Event {
	attr String occasion;
	attr EDate startDateTime;
	attr EDate endDateTime;
	ref EventKind kind;
	ref Location location;
	val EventOrganizer[*]#event organizers;
	val Invitation[*]#event invitations;
	val EventTask[*]#event checklist;
}

class EventOrganizer {
	ref Event#organizers event;
	ref Organizer#organizedEvents organizer;
}

class Invitation {
	attr InvitationStatus status;
	ref Event#invitations event;
	ref Attendee#invitations attendee;
}

class Task {
	attr String description;
	ref EventKind eventKind;
}

class EventTask {
	attr TaskStatus status;
	attr boolean assignedToAttendee;
	ref Task task;
	ref Event#checklist event;
	val AttendeeTask[*]#eventTask attendeeTasks;
}

class AttendeeTask {
	ref EventTask#attendeeTasks eventTask;
	ref Attendee#assignedTasks attendee;
}

enum InvitationStatus {
	ATTENDING = 0;
	MAYBE_ATTENDING = 1;
	NOT_ATTENDING = 2;
	NO_REPLY = 3;
}

enum TaskStatus {
	TODO = 0;
	DONE = 1;
	NOT_APPLICABLE = 2;
}


