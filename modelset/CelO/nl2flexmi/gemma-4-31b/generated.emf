@namespace(uri="http://www.example.org/CelebrationsOrganizationSystem", prefix="celo")
package CelebrationsOrganizationSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class CelebrationSystem {
	val User[*] users;
	val Event[*] events;
	val EventType[*] eventTypes;
	val Location[*] locations;
	val Task[*] tasks;
}

class User {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] email;
	attr ecore.EString[1] password;
}

class Organizer extends User {
	attr ecore.EString[1] postalAddress;
	attr ecore.EString[1] phoneNumber;
}

class Attendee extends User {
}

class Event {
	attr ecore.EString[1] occasion;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate[1] endDate;
	ref EventType[1] eventType;
	ref Location[1] location;
	ref Organizer[+] organizers;
	val Invitation[*] invitations;
	val EventTask[*] eventTasks;
}

class EventType {
	attr ecore.EString[1] name;
}

class Location {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class Invitation {
	attr ecore.EString[1] status;
	ref Attendee[1] attendee;
	ref Event[1] event;
}

class Task {
	attr ecore.EString[1] description;
	ref EventType[1] eventType;
}

class EventTask {
	attr ecore.EString[1] status;
	ref Task[1] task;
	ref Event[1] event;
	ref Attendee assignedAttendee;
}


