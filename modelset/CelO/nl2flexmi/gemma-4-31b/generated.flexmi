<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CelebrationsOrganizationSystem" nsURI="http://www.example.org/CelebrationsOrganizationSystem" nsPrefix="celo">
  <eClassifiers>
    <eClass name="CelebrationSystem">
      <eStructuralFeatures>
        <eReference name="users" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="events" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="eventTypes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="locations" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="tasks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Organizer" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="postalAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Attendee" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Event">
      <eStructuralFeatures>
        <eAttribute name="occasion" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="eventType" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="location" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="organizers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="invitations" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="eventTasks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EventType">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invitation">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="attendee" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="event" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Task">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="eventType" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EventTask">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="task" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="event" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="assignedAttendee" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
