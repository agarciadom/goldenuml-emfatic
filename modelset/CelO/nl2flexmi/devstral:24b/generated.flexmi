<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="" nsURI="" nsPrefix="">
  <eClassifiers>
    <eClass name="Organizer">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Attendee">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Event">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDateTime" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="endDateTime" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="occasion" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="organizers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="attendees" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="location" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="tasks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Task">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Email" instanceClassName="java.lang.String" />
    <eDataType name="Address" instanceClassName="java.lang.String" />
    <eDataType name="Date" instanceClassName="java.util.Date" />
  </eClassifiers>
</ePackage>
