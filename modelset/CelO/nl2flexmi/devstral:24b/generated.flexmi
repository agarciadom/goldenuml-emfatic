<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CelebrationsOrgSystem" nsURI="http://www.example.org/celo" nsPrefix="celo">
  <eClassifiers>
    <eClass name="Organizer">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="postalAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="eventKind" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eAttribute name="startDateTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="endDateTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="occasion" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="event" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="location" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Event">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="location" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="attendees" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="tasks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Attendee">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="event" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="selectedTasks" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Task">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="assignedAttendee" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="event" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="EventKind" instanceClassName="java.lang.String" />
    <eDataType name="InvitationStatus" instanceClassName="java.lang.String" />
  </eClassifiers>
</ePackage>
