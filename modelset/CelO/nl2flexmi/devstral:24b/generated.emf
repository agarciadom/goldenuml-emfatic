@namespace(uri="http://www.example.org/celo", prefix="celo")
package CelebrationsOrgSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Organizer {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] email;
	attr ecore.EString postalAddress;
	attr ecore.EString phoneNumber;
	attr ecore.EString[1] password;
	attr EventKind eventKind;
	attr ecore.EDate startDateTime;
	attr ecore.EDate endDateTime;
	attr ecore.EString occasion;
	val Event event;
	ref Location location;
}

class Event {
	attr ecore.EString[1] name;
	val Location[1] location;
	val Attendee[*] attendees;
	val Task[*] tasks;
}

class Location {
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class Attendee {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] email;
	attr InvitationStatus status;
	ref Event event;
	ref Task[*] selectedTasks;
}

class Task {
	attr ecore.EString[1] name;
	attr ecore.EString status;
	ref Attendee assignedAttendee;
	ref Event event;
}

datatype EventKind : java.lang.String;

datatype InvitationStatus : java.lang.String;


