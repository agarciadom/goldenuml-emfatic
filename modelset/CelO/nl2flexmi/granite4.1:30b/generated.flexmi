<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CelO" nsURI="http://www.example.com/CelO" nsPrefix="celo">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Organizer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="postalAddress" lowerBound="0" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Attendee" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="bringingItem" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="attendedEvents" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Event">
      <eStructuralFeatures>
        <eAttribute name="eventType" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="0" upperBound="-1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="-1" eType="//EDate" />
        <eAttribute name="occasion" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="locationName" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="organizers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="location" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="tasks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="EventType">
      <eStructuralFeatures>
        <eAttribute name="typeName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Task">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="assignedTo" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Item">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
