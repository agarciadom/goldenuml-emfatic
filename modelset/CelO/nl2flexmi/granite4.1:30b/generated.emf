@namespace(uri="http://www.example.com/CelO", prefix="celo")
package CelO;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] email;
	attr ecore.EString[1] password;
}

class Organizer extends Person {
	attr ecore.EString[*] phoneNumber;
	attr ecore.EString[*] postalAddress;
}

class Attendee extends Person {
	ref Item[*] bringingItem;
	ref Event[*] attendedEvents;
}

class Event {
	attr ecore.EString[1] eventType;
	attr ecore.EDate[*] startDate;
	attr ecore.EDate[*] endDate;
	attr ecore.EString[1] occasion;
	attr ecore.EString[*] locationName;
	ref Organizer[*] organizers;
	val Location location;
	val Task[*] tasks;
}

class Location {
	attr ecore.EString[1] name;
	attr ecore.EString[*] address;
}

class EventType {
	attr ecore.EString[1] typeName;
}

class Task {
	attr ecore.EString[1] description;
	attr ecore.EString[1] status;
	ref Attendee assignedTo;
}

class Item {
	attr ecore.EString[1] description;
}


