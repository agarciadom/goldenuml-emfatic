<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Sober" nsURI="http://sober.com/model" nsPrefix="sober">
  <eClassifiers>
    <eClass name="Car">
      <eStructuralFeatures>
        <eAttribute name="vin" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CompanyCar" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="UserCar" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trip">
      <eStructuralFeatures>
        <eAttribute name="pickupTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dropoffTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pickupLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dropoffLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="distance" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideHail" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="passengerCount" lowerBound="0" upperBound="6" eType="//EInt" />
        <eAttribute name="fee" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="requestType" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="leadCustomerName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="leadCustomerCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="car" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideShare" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="passengerCount" lowerBound="0" upperBound="10" eType="//EInt" />
        <eAttribute name="negotiatedFee" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="customerNames" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="car" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Accident">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="damageAmount" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="car" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
