@namespace(uri="http://sober.com/model", prefix="sober")
package Sober;

import "http://www.eclipse.org/emf/2002/Ecore";

class Car {
	attr ecore.EString[1] vin;
}

class CompanyCar extends Car {
}

class UserCar extends Car {
	ref Person[1] owner;
}

class Person {
	attr ecore.EString[1] name;
}

class Trip {
	attr ecore.EDate[1] pickupTime;
	attr ecore.EDate[1] dropoffTime;
	attr ecore.EString[1] pickupLocation;
	attr ecore.EString[1] dropoffLocation;
	attr ecore.EInt duration;
	attr ecore.EDouble distance;
}

class RideHail extends Trip {
	attr ecore.EInt[0..6] passengerCount;
	attr ecore.EDouble fee;
	attr ecore.EString requestType;
	attr ecore.EString leadCustomerName;
	attr ecore.EInt leadCustomerCount;
	ref Car[1] car;
}

class RideShare extends Trip {
	attr ecore.EInt[0..10] passengerCount;
	attr ecore.EDouble negotiatedFee;
	attr ecore.EString[*] customerNames;
	ref Car[1] car;
}

class Accident {
	attr ecore.EDate[1] date;
	attr ecore.EString[1] location;
	attr ecore.EDouble damageAmount;
	ref Car[1] car;
}


