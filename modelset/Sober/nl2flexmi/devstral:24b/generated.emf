@namespace(uri="http://www.sober.com/system", prefix="ss")
package SoberSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Car {
	attr ecore.EString[1] licensePlate;
	attr ecore.EString[1] make;
	attr ecore.EString[1] model;
	attr ecore.EInt[1] year;
	val Accident[*] accidents;
}

class Cab extends Car {
	attr ecore.EBoolean[1] isAvailable;
	attr ecore.EString currentLocation;
}

class Owner {
	attr ecore.EString[1] name;
	attr ecore.EString contactInfo;
	val Car[1] car;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString contactInfo;
}

class RideHailService {
	attr ecore.EDate[1] pickUpTime;
	attr ecore.EDate[1] dropOffTime;
	attr ecore.EString[1] pickUpLocation;
	attr ecore.EString[1] dropOffLocation;
	attr ecore.EDouble[1] rideDuration;
	attr ecore.EDouble[1] distance;
	attr ecore.EInt[1] numPassengers;
	attr ecore.EDouble[1] fee;
	attr ecore.EString[1] requestType;
	ref Customer[1] leadCustomer;
}

class RideShareService {
	attr ecore.EDate[1] pickUpTime;
	attr ecore.EDate[1] dropOffTime;
	attr ecore.EString[1] pickUpLocation;
	attr ecore.EString[1] dropOffLocation;
	attr ecore.EDouble[1] rideDuration;
	attr ecore.EDouble[1] distance;
	attr ecore.EDouble[1] negotiatedFee;
	ref Customer[2..10] customers;
}

class Accident {
	attr ecore.EDate[1] date;
	attr ecore.EString[1] location;
	attr ecore.EDouble[1] damageAmount;
}


