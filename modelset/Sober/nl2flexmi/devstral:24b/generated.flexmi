<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SoberSystem" nsURI="http://www.sober.com/system" nsPrefix="ss">
  <eClassifiers>
    <eClass name="Car">
      <eStructuralFeatures>
        <eAttribute name="licensePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="make" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="model" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="year" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="accidents" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cab" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="isAvailable" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="currentLocation" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Owner">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="contactInfo" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="car" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="contactInfo" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideHailService">
      <eStructuralFeatures>
        <eAttribute name="pickUpTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dropOffTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pickUpLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dropOffLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rideDuration" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="distance" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="numPassengers" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="fee" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="requestType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="leadCustomer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideShareService">
      <eStructuralFeatures>
        <eAttribute name="pickUpTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dropOffTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pickUpLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dropOffLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rideDuration" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="distance" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="negotiatedFee" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="customers" containment="False" lowerBound="2" upperBound="10" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Accident">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="damageAmount" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
