<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SoberTaxi" nsURI="http://sober-taxi.com/model" nsPrefix="st">
  <eClassifiers>
    <eClass name="Company">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="fleetSize" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="cars" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Car">
      <eStructuralFeatures>
        <eAttribute name="licensePlate" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="model" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="year" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="owner" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="accidents" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Owner">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="contactInfo" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideHailService" eSuperTypes="//@eClassifiers.7">
      <eStructuralFeatures>
        <eAttribute name="numberOfPassengers" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="fee" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
        <eAttribute name="requestType" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="leadCustomerName" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideShareService" eSuperTypes="//@eClassifiers.7">
      <eStructuralFeatures>
        <eAttribute name="numberOfPassengers" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="negotiatedFee" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
        <eAttribute name="customerNames" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="contactInfo" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="rideShareCount" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Accident">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="damageAmount" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideService">
      <eStructuralFeatures>
        <eAttribute name="pickUpTime" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="dropOffTime" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="pickUpLocation" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="dropOffLocation" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
        <eAttribute name="distance" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
        <eReference name="customers" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
    <eDataType name="Date" instanceClassName="java.util.Date" />
    <eDataType name="Float" instanceClassName="java.lang.Float" />
  </eClassifiers>
</ePackage>
