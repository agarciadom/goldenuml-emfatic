<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SoberTaxi" nsURI="http://sobertaxi.com" nsPrefix="sober">
  <eClassifiers>
    <eClass name="SoberCompany">
      <eStructuralFeatures>
        <eReference name="cabs" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="owners" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="rides" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cab">
      <eStructuralFeatures>
        <eReference name="owner" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="accidents" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Owner">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rideSharingCount" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Accident">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="damageAmount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ride">
      <eStructuralFeatures>
        <eAttribute name="pickUpTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dropOffTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pickUpLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dropOffLocation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="distance" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="cab" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideHail" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="numPassengers" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="fee" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="requestType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="leadCustomer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideShare" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="negotiatedFee" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="numPassengers" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="customers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
