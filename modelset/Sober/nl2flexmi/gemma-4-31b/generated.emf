@namespace(uri="http://sobertaxi.com", prefix="sober")
package SoberTaxi;

import "http://www.eclipse.org/emf/2002/Ecore";

class SoberCompany {
	val Cab[*] cabs;
	val Customer[*] customers;
	val Owner[*] owners;
	val Ride[*] rides;
}

class Cab {
	ref Owner owner;
	val Accident[*] accidents;
}

class Owner {
	attr ecore.EString[1] name;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EInt rideSharingCount;
}

class Accident {
	attr ecore.EDate[1] date;
	attr ecore.EString[1] location;
	attr ecore.EBigDecimal[1] damageAmount;
}

class Ride {
	attr ecore.EDate[1] pickUpTime;
	attr ecore.EDate[1] dropOffTime;
	attr ecore.EString[1] pickUpLocation;
	attr ecore.EString[1] dropOffLocation;
	attr ecore.EDouble[1] duration;
	attr ecore.EDouble[1] distance;
	ref Cab[1] cab;
}

class RideHail extends Ride {
	attr ecore.EInt[1] numPassengers;
	attr ecore.EBigDecimal[1] fee;
	attr ecore.EString[1] requestType;
	ref Customer[1] leadCustomer;
}

class RideShare extends Ride {
	attr ecore.EBigDecimal[1] negotiatedFee;
	attr ecore.EInt[1] numPassengers;
	ref Customer[+] customers;
}


