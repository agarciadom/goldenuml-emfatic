@namespace(uri="http://www.example.org/SoberTaxiService", prefix="st")
package SoberTaxiService;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] rideHailingCount;
}

class Car {
	ref Person owner;
	val Accident[*] accidents;
}

class RideHailing {
	attr ecore.EDate[1] pickupTime;
	attr ecore.EDate[1] dropoffTime;
	attr ecore.EString pickupLocation;
	attr ecore.EString dropoffLocation;
	attr ecore.EInt rideDuration;
	attr ecore.EDouble distance;
	attr ecore.EInt numPassengers;
	attr ecore.EDouble fee;
	ref Person[1] leadCustomer;
	attr ecore.EString requestType;
}

class RideSharing {
	attr ecore.EDate[1] pickupTime;
	attr ecore.EDate[1] dropoffTime;
	attr ecore.EString pickupLocation;
	attr ecore.EString dropoffLocation;
	attr ecore.EInt rideDuration;
	attr ecore.EDouble distance;
	ref Person[+] customers;
	attr ecore.EDouble fee;
}

class Accident {
	attr ecore.EDate[1] date;
	attr ecore.EString location;
	attr ecore.EDouble damageAmount;
}


