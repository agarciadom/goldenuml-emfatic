<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SoberTaxiService" nsURI="http://www.example.org/SoberTaxiService" nsPrefix="st">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rideHailingCount" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Car">
      <eStructuralFeatures>
        <eReference name="owner" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="accidents" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideHailing">
      <eStructuralFeatures>
        <eAttribute name="pickupTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dropoffTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pickupLocation" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="dropoffLocation" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="rideDuration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="distance" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="numPassengers" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="fee" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="leadCustomer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eAttribute name="requestType" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RideSharing">
      <eStructuralFeatures>
        <eAttribute name="pickupTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="dropoffTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="pickupLocation" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="dropoffLocation" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="rideDuration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="distance" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="customers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.0" />
        <eAttribute name="fee" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Accident">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="location" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="damageAmount" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
