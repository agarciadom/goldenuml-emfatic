<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmi:version="2.0">
  <ecore:EPackage name="sober" nsURI="http://sober.com/model" nsPrefix="sober" xmi:id="sober">

    <!-- Root container class -->
    <ecore:EClass name="SoberSystem" xmi:id="SoberSystem">
      <ecore:EReference name="cabs" eType="#//Cab" upperBound="-1" containment="true"/>
      <ecore:EReference name="rideHailServices" eType="#//RideHailService" upperBound="-1" containment="true"/>
      <ecore:EReference name="rideShareServices" eType="#//RideShareService" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Cab class and related classes -->
    <ecore:EClass name="Cab" xmi:id="Cab">
      <ecore:EAttribute name="id" eType="ecore:EString"/>
      <ecore:EReference name="owner" eType="#//Owner" lowerBound="1"/>
      <ecore:EReference name="accidents" eType="#//Accident" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <ecore:EClass name="Owner" xmi:id="Owner">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <ecore:EClass name="Accident" xmi:id="Accident">
      <ecore:EReference name="date" eType="#//TimeStamp"/>
      <ecore:EAttribute name="location" eType="ecore:EString"/>
      <ecore:EAttribute name="damageAmount" eType="ecore:EDouble"/>
    </ecore:EClass>

    <!-- Service classes -->
    <ecore:EClass name="RideHailService" xmi:id="RideHailService">
      <ecore:EReference name="timeOfPickUp" eType="#//TimeStamp"/>
      <ecore:EAttribute name="pickUpLocation" eType="ecore:EString"/>
      <ecore:EReference name="timeOfDropOff" eType="#//TimeStamp"/>
      <ecore:EAttribute name="dropOffLocation" eType="ecore:EString"/>
      <ecore:EAttribute name="rideDuration" eType="ecore:EDouble"/> <!-- duration in minutes -->
      <ecore:EAttribute name="distance" eType="ecore:EDouble"/> <!-- distance in km -->
      <ecore:EAttribute name="numberOfPassengers" eType="ecore:EInt"/>
      <ecore:EAttribute name="fee" eType="ecore:EDouble"/>
      <ecore:EReference name="requestType" eType="#//RequestType"/>
      <ecore:EReference name="leadCustomer" eType="#//LeadCustomer"/>
    </ecore:EClass>

    <ecore:EEnum name="RequestType" xmi:id="RequestType">
      <ecore:ELiteral name="APP" value="0"/>
      <ecore:ELiteral name="HAND_WAVE" value="1"/>
    </ecore:EEnum>

    <ecore:EClass name="LeadCustomer" xmi:id="LeadCustomer">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <ecore:EClass name="RideShareService" xmi:id="RideShareService">
      <ecore:EReference name="timeOfPickUp" eType="#//TimeStamp"/>
      <ecore:EAttribute name="pickUpLocation" eType="ecore:EString"/>
      <ecore:EReference name="timeOfDropOff" eType="#//TimeStamp"/>
      <ecore:EAttribute name="dropOffLocation" eType="ecore:EString"/>
      <ecore:EAttribute name="rideDuration" eType="ecore:EDouble"/> <!-- duration in minutes -->
      <ecore:EAttribute name="distance" eType="ecore:EDouble"/> <!-- distance in km -->
      <ecore:EReference name="customers" eType="#//Customer" upperBound="-1"/>
      <ecore:EAttribute name="negotiatedFee" eType="ecore:EDouble"/>
    </ecore:EClass>

    <ecore:EClass name="Customer" xmi:id="Customer">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Custom DataTypes -->
    <ecore:EDataType name="TimeWithoutDate" instanceClassName="java.time.LocalTime" xmi:id="TimeWithoutDate"/>

    <ecore:EDataType name="TimeStamp" instanceClassName="java.time.Instant" xmi:id="TimeStamp"/>
  </ecore:EPackage>
</xmi:XMI>
