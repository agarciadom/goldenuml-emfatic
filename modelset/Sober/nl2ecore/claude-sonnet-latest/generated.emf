@namespace(uri="http://www.sober.com/metamodel", prefix="sober")
package sober;

datatype LocalTime : java.time.LocalTime;

enum RequestType {
	SOBER_APP = 0;
	HAND_WAVING = 1;
}

class SoberSystem {
	val Car[*] cars;
	val Customer[*] customers;
	val CarOwner[*] carOwners;
	val RideHailService[*] rideHailServices;
	val RideShareService[*] rideShareServices;
	val Accident[*] accidents;
}

class Car {
	attr String licensePlate;
	attr String model;
	attr boolean isOwnedByCompany;
	ref CarOwner#cars owner;
	ref Accident[*]#car accidents;
}

class CarOwner {
	attr String name;
	attr String contactInfo;
	ref Car[*]#owner cars;
}

class Customer {
	op boolean checkTreeReward();
	attr String name;
	attr String number;
	attr int rideShareUseCount;
	ref RideShareBooking[*]#customer rideShareBookings;
}

abstract class TaxiService {
	attr LocalTime pickUpTime;
	attr LocalTime dropOffTime;
	attr EDate pickUpDate;
	attr EDate dropOffDate;
	attr String pickUpLocation;
	attr String dropOffLocation;
	attr double rideDuration;
	attr double distance;
	attr int numberOfPassengers;
	ref Car car;
}

class RideHailService extends TaxiService {
	attr double fee;
	attr RequestType requestType;
	attr LocalTime estimatedWaitTime;
	ref Customer leadCustomer;
}

class RideShareService extends TaxiService {
	attr double negotiatedFee;
	val RideShareBooking[*]#rideShareService rideShareBookings;
}

class RideShareBooking {
	ref Customer#rideShareBookings customer;
	ref RideShareService#rideShareBookings rideShareService;
}

class Accident {
	attr EDate date;
	attr String location;
	attr double damageAmount;
	ref Car#accidents car;
}


