<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="rideHailingPackage"
    nsURI="http://www.example.org/rideHailingPackage"
    nsPrefix="rideHailingPackage">

  <!-- Abstract base class: Ride -->
  <eClassifiers xsi:type="ecore:EClass" name="Ride" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="rideNr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pickupDateTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dropoffDateTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pickupLocation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dropoffLocation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="distance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fee" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference to Car via OperatedBy -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="operatedBy" eType="#//Car" lowerBound="1"/>
    <eOperations name="calcDuration"/>
  </eClassifiers>

  <!-- RideHailing extends Ride -->
  <eClassifiers xsi:type="ecore:EClass" name="RideHailing" eSuperTypes="#//Ride">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="passengers" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="waitTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="requestType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- LeadCustomer: many RideHailing to one Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="leadCustomer" eType="#//Customer" lowerBound="1"/>
  </eClassifiers>

  <!-- RideSharing extends Ride -->
  <eClassifiers xsi:type="ecore:EClass" name="RideSharing" eSuperTypes="#//Ride">
    <!-- Book: many RideSharing to one Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="book" eType="#//Customer" lowerBound="1"/>
    <eOperations name="numberOfCustomers"/>
  </eClassifiers>

  <!-- Customer -->
  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="custNr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="custName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Owned OtherCar(s): opposite of OtherCar.owns -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="ownedCars" eType="#//OtherCar" upperBound="-1" eOpposite="#//OtherCar/owns"/>
    <eOperations name="top5customerHail"/>
    <eOperations name="top5customerShare"/>
  </eClassifiers>

  <!-- Abstract base class: Car -->
  <eClassifiers xsi:type="ecore:EClass" name="Car" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="carNr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="carType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Car to Involved (association class side) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="involved" eType="#//Involved" upperBound="-1"/>
    <eOperations name="numberOfRides"/>
  </eClassifiers>

  <!-- SoberCar extends Car -->
  <eClassifiers xsi:type="ecore:EClass" name="SoberCar" eSuperTypes="#//Car">
    <eOperations name="numberOfSoberCars"/>
  </eClassifiers>

  <!-- OtherCar extends Car -->
  <eClassifiers xsi:type="ecore:EClass" name="OtherCar" eSuperTypes="#//Car">
    <!-- Owns: many OtherCar to one Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="owns" eType="#//Customer" lowerBound="1" eOpposite="#//Customer/ownedCars"/>
  </eClassifiers>

  <!-- Involved (association class between Car and Accident) -->
  <eClassifiers xsi:type="ecore:EClass" name="Involved">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="damageAmount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Reference to Car end -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="car" eType="#//Car" lowerBound="1"/>
    <!-- Reference to Accident end -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="accident" eType="#//Accident" lowerBound="1"/>
    <eOperations name="generateReport"/>
  </eClassifiers>

  <!-- Accident -->
  <eClassifiers xsi:type="ecore:EClass" name="Accident">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accNr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accLocation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="accDateTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Accident to Involved (association class side) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="involved" eType="#//Involved" upperBound="-1"/>
    <eOperations name="top3AccidentHotSpots"/>
    <eOperations name="top3AccidentPeakTimes"/>
  </eClassifiers>

</ecore:EPackage>
