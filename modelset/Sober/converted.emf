@namespace(uri="http://www.example.org/ridehailingpackage", prefix="ridehailingpackage")
package ridehailingpackage;

abstract class Ride {
	attr int RideNr;
	attr String PickupDateTime;
	attr String DropoffDateTime;
	attr int Duration;
	attr String PickupLocation;
	attr String DropoffLocation;
	attr int Distance;
	attr int Fee;
	ref Car[1]#rides operatedBy;
}

class RideHailing extends Ride {
	attr int Passengers;
	attr String WaitTime;
	attr String RequestType;
	ref Customer[1]#hailingRides leadCustomer;
}

class RideSharing extends Ride {
	ref Customer[1]#sharingRides book;
}

class Customer {
	attr int CustNr;
	attr String CustName;
	ref RideHailing[*]#leadCustomer hailingRides;
	ref RideSharing[*]#book sharingRides;
	ref OtherCar[*]#owner ownedCars;
}

abstract class Car {
	attr int CarNr;
	attr String CarType;
	ref Ride[*]#operatedBy rides;
	val Involved[*]#car accidents;
}

class SoberCar extends Car {
}

class OtherCar extends Car {
	ref Customer[1]#ownedCars owner;
}

class Involved {
	attr int DamageAmount;
	ref Car[1]#accidents car;
	ref Accident[1]#involved accident;
}

class Accident {
	attr int AccNr;
	attr String AccLocation;
	attr String AccDateTime;
	val Involved[*]#accident involved;
}


