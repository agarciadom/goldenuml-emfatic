@namespace(uri="http://www.example.org/rideHailingPackage", prefix="rideHailingPackage")
package rideHailingPackage;

datatype Time : java.time.LocalTime;

class RideHailingSystem {
	val Ride[*] rides;
	val Customer[*] customers;
	val Car[*] cars;
	val Accident[*] accidents;
}

abstract class Ride {
	op void fetchRideNr();
	op void updateRideNr(int newRideNr);
	op void calcDuration();
	id attr int rideNr;
	attr EDate pickupDateTime;
	attr EDate dropoffDateTime;
	attr int duration;
	attr String pickupLocation;
	attr String dropoffLocation;
	attr int distance;
	attr int fee;
	ref Car[1] operatedBy;
}

class RideHailing extends Ride {
	op void fetchPassengers();
	attr int passengers;
	attr Time waitTime;
	attr String requestType;
	ref Customer[1] leadCustomer;
}

class RideSharing extends Ride {
	op void numberOfCustomers();
	ref Customer[1] book;
}

class Customer {
	op void fetchCustNr();
	op void updateCustNr(int newCustNr);
	op void top5customerHail();
	op void top5customerShare();
	id attr int custNr;
	attr String custName;
	ref OtherCar[*]#owns ownedCars;
}

abstract class Car {
	op void fetchCarNr();
	op void updateCarNr(int newCarNr);
	op void numberOfRides();
	id attr int carNr;
	attr String carType;
	ref Involved[*]#car involvements;
}

class SoberCar extends Car {
	op void numberOfSoberCars();
}

class OtherCar extends Car {
	ref Customer[1]#ownedCars owns;
}

class Involved {
	op void generateReport();
	attr int damageAmount;
	ref Car[1]#involvements car;
	ref Accident[1]#involvements accident;
}

class Accident {
	op void fetchAccNr();
	op void updateAccNr(int newAccNr);
	op void top3AccidentHotSpots();
	op void top3AccidentPeakTimes();
	id attr int accNr;
	attr String accLocation;
	attr EDate accDateTime;
	val Involved[*]#accident involvements;
}


