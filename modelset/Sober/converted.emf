@namespace(uri="http://www.example.org/ridehailing", prefix="ridehailing")
package ridehailing;

datatype LocalTime : java.time.LocalTime;

class RideHailingSystem {
	val Ride[*] rides;
	val Customer[*] customers;
	val Car[*] cars;
	val Accident[*] accidents;
	val Involved[*] involvements;
}

abstract class Ride {
	op void calcDuration();
	id attr int rideNr;
	attr EDate pickupDateTime;
	attr EDate dropoffDateTime;
	attr int duration;
	attr String pickupLocation;
	attr String dropoffLocation;
	attr int distance;
	attr int fee;
	ref Car[1]#rides operatedBy;
}

class RideHailing extends Ride {
	attr int passengers;
	attr LocalTime waitTime;
	attr String requestType;
	ref Customer[1]#leadRideHailings leadCustomer;
}

class RideSharing extends Ride {
	op void numberOfCustomers();
	ref Customer[1]#bookedRideSharings bookedBy;
}

class Customer {
	op void top5customerHail();
	op void top5customerShare();
	id attr int custNr;
	attr String custName;
	ref RideHailing[*]#leadCustomer leadRideHailings;
	ref RideSharing[*]#bookedBy bookedRideSharings;
	ref OtherCar[*]#owner ownedCars;
}

abstract class Car {
	op void numberOfRides();
	id attr int carNr;
	attr String carType;
	ref Ride[*]#operatedBy rides;
	ref Involved[+]#car involvements;
}

class SoberCar extends Car {
	op void numberOfSoberCars();
}

class OtherCar extends Car {
	ref Customer[1]#ownedCars owner;
}

class Involved {
	op void generateReport();
	attr int damageAmount;
	ref Car[1]#involvements car;
	ref Accident[1]#involvements accident;
}

class Accident {
	op void top3AccidentHotSpots();
	op void top3AccidentPeakTimes();
	id attr int accNr;
	attr String accLocation;
	attr EDate accDateTime;
	ref Involved[*]#accident involvements;
}


