<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="cardgame"
    nsURI="http://www.example.org/cardgame"
    nsPrefix="cardgame">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="CardGameModel">
    <eStructuralFeatures xsi:type="ecore:EReference" name="games"
        eType="#//Game" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players"
        eType="#//Player" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="decks"
        eType="#//Deck" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cards"
        eType="#//Card" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="scoreboards"
        eType="#//Scoreboard" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rounds"
        eType="#//Round" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roundTypes"
        eType="#//RoundType" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- Game class -->
  <eClassifiers xsi:type="ecore:EClass" name="Game">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="scoreboard"
        eType="#//Scoreboard" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deck"
        eType="#//Deck" lowerBound="1" upperBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players"
        eType="#//Player" lowerBound="4" upperBound="4"/>
  </eClassifiers>

  <!-- Player class -->
  <eClassifiers xsi:type="ecore:EClass" name="Player">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rounds"
        eType="#//Round" lowerBound="1" upperBound="3"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roundTypes"
        eType="#//RoundType" lowerBound="1" upperBound="2"/>
  </eClassifiers>

  <!-- Deck class -->
  <eClassifiers xsi:type="ecore:EClass" name="Deck">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cards"
        eType="#//Card" upperBound="48"/>
  </eClassifiers>

  <!-- Card class -->
  <eClassifiers xsi:type="ecore:EClass" name="Card">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="suit"
        eType="#//Suit"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="compare"
        eType="#//Compare"/>
    <eOperations name="compare" eType="#//Compare">
      <eParameters name="card" eType="#//Card"/>
    </eOperations>
  </eClassifiers>

  <!-- Scoreboard class -->
  <eClassifiers xsi:type="ecore:EClass" name="Scoreboard">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rounds"
        eType="#//Round" upperBound="-1"/>
  </eClassifiers>

  <!-- Round class -->
  <eClassifiers xsi:type="ecore:EClass" name="Round">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="points"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- RoundType abstract class -->
  <eClassifiers xsi:type="ecore:EClass" name="RoundType" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iD"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>

  <!-- SoloRound class -->
  <eClassifiers xsi:type="ecore:EClass" name="SoloRound" eSuperTypes="#//RoundType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="solo"
        eType="#//SoloType"/>
  </eClassifiers>

  <!-- MandatorySolo class -->
  <eClassifiers xsi:type="ecore:EClass" name="MandatorySolo" eSuperTypes="#//SoloRound"/>

  <!-- DoubleRound class -->
  <eClassifiers xsi:type="ecore:EClass" name="DoubleRound" eSuperTypes="#//RoundType"/>

  <!-- Suit enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="Suit">
    <eLiterals name="Diamonds" value="0"/>
    <eLiterals name="Hearts" value="1"/>
    <eLiterals name="Spades" value="2"/>
    <eLiterals name="Clubs" value="3"/>
  </eClassifiers>

  <!-- Compare enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="Compare">
    <eLiterals name="Lower" value="0"/>
    <eLiterals name="Higher" value="1"/>
    <eLiterals name="Equal" value="2"/>
  </eClassifiers>

  <!-- SoloType enum -->
  <eClassifiers xsi:type="ecore:EEnum" name="SoloType">
    <eLiterals name="Trump" value="0"/>
    <eLiterals name="Jacks" value="1"/>
    <eLiterals name="Queens" value="2"/>
  </eClassifiers>

</ecore:EPackage>
