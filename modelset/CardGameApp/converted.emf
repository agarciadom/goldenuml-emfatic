@namespace(uri="http://www.example.org/cardgame", prefix="cardgame")
package cardgame;

enum Suit {
	Diamonds = 0;
	Hearts = 1;
	Spades = 2;
	Clubs = 3;
}

enum Compare {
	Lower = 0;
	Higher = 1;
	Equal = 2;
}

enum SoloType {
	Trump = 0;
	Jacks = 1;
	Queens = 2;
}

class Game {
	attr int ID;
	val Scoreboard[1] scoreboard;
	val Deck[1] deck;
	val Player[4] players;
}

class Player {
	attr int ID;
	ref Round[1..3] rounds;
	ref RoundType[1..2] roundTypes;
}

class Deck {
	attr int ID;
	val Card[0..48] cards;
}

class Card {
	attr int ID;
	attr Suit suit;
	attr Compare compare;
}

class Scoreboard {
	attr int ID;
	val Round[*] rounds;
}

class Round {
	attr int ID;
	attr int points;
}

abstract class RoundType {
	attr int ID;
}

class SoloRound extends RoundType {
	attr SoloType solo;
}

class MandatorySolo extends SoloRound {
}

class DoubleRound extends RoundType {
}


