@namespace(uri="http://www.example.org/cardgame", prefix="cardgame")
package cardgame;

class CardGameModel {
	val Game[*] games;
	val Player[*] players;
	val Deck[*] decks;
	val Card[*] cards;
	val Scoreboard[*] scoreboards;
	val Round[*] rounds;
	val RoundType[*] roundTypes;
}

class Game {
	attr int iD;
	ref Scoreboard[1] scoreboard;
	ref Deck[1] deck;
	ref Player[4] players;
}

class Player {
	attr int iD;
	ref Round[1..3] rounds;
	ref RoundType[1..2] roundTypes;
}

class Deck {
	attr int iD;
	ref Card[0..48] cards;
}

class Card {
	op Compare compare(Card card);
	attr int iD;
	attr Suit suit;
	attr Compare compare;
}

class Scoreboard {
	attr int iD;
	ref Round[*] rounds;
}

class Round {
	attr int iD;
	attr int points;
}

abstract class RoundType {
	attr int iD;
}

class SoloRound extends RoundType {
	attr SoloType solo;
}

class MandatorySolo extends SoloRound {
}

class DoubleRound extends RoundType {
}

enum Suit {
	Diamonds = 0;
	Hearts = 1;
	Spades = 2;
	Clubs = 3;
}

enum Compare {
	Lower = 0;
	Higher = 1;
	Equal = 2;
}

enum SoloType {
	Trump = 0;
	Jacks = 1;
	Queens = 2;
}


