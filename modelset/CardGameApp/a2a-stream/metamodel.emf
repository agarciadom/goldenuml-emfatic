@namespace(uri="http://cardgame.example.org", prefix="p")
package CardGame;

class Game {
  attr EString ~id;
  val Player[*] players;
  val Deck deck;
  ref ScoringTable scoringTable;
}
class Player {
  attr EString ~id;
}
class Deck {
  attr EString ~id;
  val Card[*] cards;
}
class Card {
  attr EString ~id;
  attr SuitEnum suit;
  attr ComparisonResultEnum comparisonResult;
}
class ScoringTable {
  attr EString ~id;
  val Round[*] rounds;
}
class Round {
  attr EString ~id;
  val Player[*] winningPlayers;
  attr EInt points;
  attr EBoolean isJackRound;
  attr EBoolean isSoloRound;
}
class SoloRound extends Round {
  attr EString ~id;
  attr SoloTypeEnum soloType;
  val Player soloPlayer;
}
class MandatorySoloRound extends SoloRound {
  attr EString ~id;
}
class SuitEnum {
}
class ComparisonResultEnum {
}
class SoloTypeEnum {
}