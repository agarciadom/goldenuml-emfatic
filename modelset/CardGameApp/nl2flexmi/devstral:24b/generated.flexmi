<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CardGame" nsURI="http://www.example.org/cardgame" nsPrefix="cardgame">
  <eClassifiers>
    <eClass name="Game">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="players" containment="True" lowerBound="4" upperBound="4" eType="//@eClassifiers.1" />
        <eReference name="deck" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="scoringTable" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Deck">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="cards" containment="True" lowerBound="0" upperBound="48" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Card">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="height" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="suit" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoringTable">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rounds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Round">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="winningPlayers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eAttribute name="pointValue" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SoloRound" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="soloType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="soloPlayer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MandatorySoloRound" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="JackRound">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="SoloType" instanceClassName="java.lang.String" />
  </eClassifiers>
</ePackage>
