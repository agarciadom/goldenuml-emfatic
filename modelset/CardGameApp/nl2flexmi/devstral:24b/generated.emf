@namespace(uri="http://www.example.org/CardGameModel", prefix="cardgame")
package CardGameModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class Game {
	attr ecore.EString[1] ~id;
	val Player[4] players;
	val Deck[1] deck;
	val ScoringTable[1] scoringTable;
}

class Player {
	attr ecore.EString[1] ~id;
}

class Deck {
	attr ecore.EString[1] ~id;
	attr ecore.EInt[1] maxCards;
	val Card[0..48] cards;
}

class Card {
	attr ecore.EString[1] ~id;
	attr SuitType[1] suit;
	attr ecore.EInt[1] height;
}

class ScoringTable {
	attr ecore.EString[1] ~id;
	val Round[*] rounds;
}

class Round {
	attr ecore.EString[1] ~id;
	val Player[*] winningPlayers;
	attr ecore.EInt[1] pointValue;
}

class SoloRound extends Round {
	ref Player[1] soloPlayer;
	attr SoloType[1] soloType;
}

class JackRound extends SoloRound {
}

class MandatorySoloRound extends SoloRound {
}

datatype SuitType : java.lang.String;

datatype SoloType : java.lang.String;


