@namespace(uri="http://cardgame.org/ns", prefix="cg")
package CardGame;

import "http://www.eclipse.org/emf/2002/Ecore";

class BaseObject {
	attr ecore.EString[1] ~id;
}

class Game extends BaseObject {
	val Player[4] players;
	val Deck[1] deck;
	val ScoringTable[1] scoringTable;
}

class Player extends BaseObject {
}

class Deck extends BaseObject {
	val Card[0..48] cards;
}

class Card extends BaseObject {
	attr ecore.EString[1] suit;
	attr ecore.EInt[1] rank;
}

class ScoringTable extends BaseObject {
	val Round[*] rounds;
}

class Round extends BaseObject {
	attr ecore.EInt[1] pointValue;
	ref Player[+] winningPlayers;
}

class JackRound extends Round {
}

class SoloRound extends Round {
	attr ecore.EString[1] soloType;
	ref Player[1] soloPlayer;
}

class MandatorySoloRound extends SoloRound {
}


