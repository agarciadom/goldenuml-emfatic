<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CardGame" nsURI="http://cardgame.org/ns" nsPrefix="cg">
  <eClassifiers>
    <eClass name="BaseObject">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Game" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="players" containment="True" lowerBound="4" upperBound="4" eType="//@eClassifiers.2" />
        <eReference name="deck" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="scoringTable" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Deck" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="cards" containment="True" lowerBound="0" upperBound="48" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Card" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="suit" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rank" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoringTable" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="rounds" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Round" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="pointValue" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="winningPlayers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="JackRound" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SoloRound" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="soloType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="soloPlayer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MandatorySoloRound" eSuperTypes="//@eClassifiers.8">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
