<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="cardgame"
    nsURI="http://www.example.org/cardgame"
    nsPrefix="cardgame">

  <!-- Enumerations -->

  <eClassifiers xsi:type="ecore:EEnum" name="Suit">
    <eLiterals name="DIAMONDS"/>
    <eLiterals name="HEARTS"/>
    <eLiterals name="SPADES"/>
    <eLiterals name="CLUBS"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ComparisonResult">
    <eLiterals name="LOWER"/>
    <eLiterals name="EQUAL"/>
    <eLiterals name="HIGHER"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="SoloType">
    <eLiterals name="TRUMP"/>
    <eLiterals name="JACK"/>
    <eLiterals name="QUEEN"/>
  </eClassifiers>

  <!-- Root Container -->

  <eClassifiers xsi:type="ecore:EClass" name="CardGameApp">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="games" eType="#//Game"
        upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players" eType="#//Player"
        upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- DocumentRoot acts as the true root, containing CardGameApp -->

  <eClassifiers xsi:type="ecore:EClass" name="DocumentRoot">
    <eStructuralFeatures xsi:type="ecore:EReference" name="cardGameApp" eType="#//CardGameApp"
        lowerBound="1" upperBound="1" containment="true"/>
  </eClassifiers>

  <!-- Player -->

  <eClassifiers xsi:type="ecore:EClass" name="Player">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Game -->

  <eClassifiers xsi:type="ecore:EClass" name="Game">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players" eType="#//Player"
        upperBound="4" lowerBound="4"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deck" eType="#//Deck"
        lowerBound="1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="scoringTable" eType="#//ScoringTable"
        lowerBound="1" containment="true"/>
  </eClassifiers>

  <!-- Deck -->

  <eClassifiers xsi:type="ecore:EClass" name="Deck">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cards" eType="#//Card"
        upperBound="48" containment="true"/>
  </eClassifiers>

  <!-- Card -->

  <eClassifiers xsi:type="ecore:EClass" name="Card">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="suit" eType="#//Suit"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eOperations name="compareTo" eType="#//ComparisonResult">
      <eParameters name="other" eType="#//Card"/>
    </eOperations>
  </eClassifiers>

  <!-- ScoringTable -->

  <eClassifiers xsi:type="ecore:EClass" name="ScoringTable">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rounds" eType="#//Round"
        upperBound="-1" containment="true"/>
  </eClassifiers>

  <!-- Round -->

  <eClassifiers xsi:type="ecore:EClass" name="Round">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="winningPlayers" eType="#//Player"
        upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pointValue" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isJackRound" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- SoloRound -->

  <eClassifiers xsi:type="ecore:EClass" name="SoloRound" eSuperTypes="#//Round">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="soloType" eType="#//SoloType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="soloPlayer" eType="#//Player"
        lowerBound="1"/>
  </eClassifiers>

  <!-- MandatorySoloRound -->

  <eClassifiers xsi:type="ecore:EClass" name="MandatorySoloRound" eSuperTypes="#//SoloRound">
  </eClassifiers>

</ecore:EPackage>
