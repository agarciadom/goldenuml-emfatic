@namespace(uri="http://www.example.org/cardgame", prefix="cardgame")
package cardgame;

enum Suit {
	DIAMONDS = 0;
	HEARTS = 0;
	SPADES = 0;
	CLUBS = 0;
}

enum ComparisonResult {
	LOWER = 0;
	EQUAL = 0;
	HIGHER = 0;
}

enum SoloType {
	TRUMP = 0;
	JACK = 0;
	QUEEN = 0;
}

class CardGameApp {
	id attr String ~id;
	val Game[*] games;
	val Player[*] players;
}

class DocumentRoot {
	val CardGameApp[1] cardGameApp;
}

class Player {
	id attr String ~id;
	attr String name;
}

class Game {
	id attr String ~id;
	ref Player[4] players;
	val Deck[1] deck;
	val ScoringTable[1] scoringTable;
}

class Deck {
	id attr String ~id;
	val Card[0..48] cards;
}

class Card {
	op ComparisonResult compareTo(Card other);
	id attr String ~id;
	attr Suit suit;
	attr int value;
}

class ScoringTable {
	id attr String ~id;
	val Round[*] rounds;
}

class Round {
	id attr String ~id;
	ref Player[*] winningPlayers;
	attr int pointValue;
	attr boolean isJackRound;
}

class SoloRound extends Round {
	attr SoloType soloType;
	ref Player[1] soloPlayer;
}

class MandatorySoloRound extends SoloRound {
}


