<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="CardGameModel" nsURI="cardgame.model" nsPrefix="cardgame" xmi:version="2.0">

    <!-- Root Container -->
    <ecore:EClass name="GameSystem">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EReference name="games" eType="#//Game" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Game -->
    <ecore:EClass name="Game">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EReference name="players" eType="#//Player" containment="true" upperBound="-1"/>
      <ecore:EReference name="deck" eType="#//Deck" containment="true"/>
      <ecore:EReference name="scoringTable" eType="#//ScoringTable" containment="true"/>
    </ecore:EClass>

    <!-- Player -->
    <ecore:EClass name="Player">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EAttribute name="name" type="ecore:EString"/>
    </ecore:EClass>

    <!-- Deck -->
    <ecore:EClass name="Deck">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EReference name="cards" eType="#//Card" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Card -->
    <ecore:EClass name="Card">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EAttribute name="suit" type="#//Suit"/>
      <ecore:EAttribute name="value" type="ecore:EInt"/>
      <ecore:EOperation name="compareHeight">
        <ecore:EParameter name="otherCard" eType="#//Card"/>
        <ecore:EGenericType>
          <ecore:EClassifier xmi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
        </ecore:EGenericType> <!-- Returns "lower", "equal" or "higher" -->
      </ecore:EOperation>
    </ecore:EClass>

    <!-- Suit Enum -->
    <ecore:EEnum name="Suit">
      <ecore:ELiteral name="DIAMONDS"/>
      <ecore:ELiteral name="HEARTS"/>
      <ecore:ELiteral name="SPADES"/>
      <ecore:ELiteral name="CLUBS"/>
    </ecore:EEnum>

    <!-- Scoring Table -->
    <ecore:EClass name="ScoringTable">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EReference name="rounds" eType="#//Round" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Round -->
    <ecore:EClass name="Round">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EReference name="winningPlayers" eType="#//Player" upperBound="-1"/>
      <ecore:EAttribute name="pointValue" type="ecore:EInt"/>
      <ecore:EAttribute name="isJackRound" type="ecore:EBoolean"/>
      <ecore:EAttribute name="isSoloRound" type="ecore:EBoolean"/>

      <!-- Association end for Solo Round -->
      <ecore:EReference name="soloRounds" eType="#//SoloRound" upperBound="-1"/>
    </ecore:EClass>

    <!-- Solo Round -->
    <ecore:EClass name="SoloRound">
      <ecore:EAttribute name="id" type="ecore:EString"/>
      <ecore:EAttribute name="soloType" type="#//SoloType"/>
      <ecore:EReference name="soloPlayer" eType="#//Player"/>

      <!-- Association end to Round -->
      <ecore:EReference name="round" eType="#//Round" containment="true"/>
    </ecore:EClass>

    <!-- Mandatory Solo Round -->
    <ecore:EClass name="MandatorySoloRound">
      <ecore:EAttribute name="id" type="ecore:EString"/>

      <!-- Association end to Round -->
      <ecore:EReference name="round" eType="#//Round" containment="true"/>
    </ecore:EClass>

    <!-- Solo Type Enum -->
    <ecore:EEnum name="SoloType">
      <ecore:ELiteral name="TRUMP"/>
      <ecore:ELiteral name="JACK"/>
      <ecore:ELiteral name="QUEEN"/>
    </ecore:EEnum>
  </ecore:EPackage>
</xmi:XMI>
