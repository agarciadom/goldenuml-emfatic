<?xml version="1.0" encoding="UTF-8"?>
<model xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
       xmlns:Ecore="http://www.eclipse.org/emf/2002/Ecore"
       xmi:XMIversion="2.0">
  <eClassifiers>
    <!-- Root container class -->
    <Ecore:EClass name="CardGameApp">
      <eStructuralFeatures>
        <Ecore:EReference name="games" eType="#//CardGame" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- Game class -->
    <Ecore:EClass name="CardGame">
      <eStructuralFeatures>
        <Ecore:EAttribute name="id" eType="EString" unique="true"/>
        <Ecore:EReference name="players" eType="#//Player" lowerBound="4" upperBound="-1" containment="true"/>
        <Ecore:EReference name="deck" eType="#//Deck" containment="true"/>
        <Ecore:EReference name="scoringTable" eType="#//ScoringTable" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- Player class -->
    <Ecore:EClass name="Player">
      <eStructuralFeatures>
        <Ecore:EAttribute name="id" eType="EString" unique="true"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- Deck class -->
    <Ecore:EClass name="Deck">
      <eStructuralFeatures>
        <Ecore:EAttribute name="id" eType="EString" unique="true"/>
        <Ecore:EReference name="cards" eType="#//Card" lowerBound="0" upperBound="48" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- Card class -->
    <Ecore:EClass name="Card">
      <eStructuralFeatures>
        <Ecore:EAttribute name="id" eType="EString" unique="true"/>
        <Ecore:EAttribute name="suit" eType="#//Suit"/>
      </eStructuralFeatures>
      <eOperations>
        <Ecore:EOperation name="compareHeight">
          <eTypeParameters/>
          <eOperationFeatures>
            <Ecore:EParameter name="otherCard" eType="#//Card"/>
            <Ecore:EParameter name="result" eType="#//ComparisonResult"/>
          </eOperationFeatures>
        </Ecore:EOperation>
      </eOperations>
    </Ecore:EClass>

    <!-- Enum for Suit -->
    <Ecore:EEnum name="Suit">
      <eLiterals>
        <Ecore:EEnumLiteral name="Diamonds"/>
        <Ecore:EEnumLiteral name="Hearts"/>
        <Ecore:EEnumLiteral name="Spades"/>
        <Ecore:EEnumLiteral name="Clubs"/>
      </eLiterals>
    </Ecore:EEnum>

    <!-- Enum for ComparisonResult -->
    <Ecore:EEnum name="ComparisonResult">
      <eLiterals>
        <Ecore:EEnumLiteral name="LOWER"/>
        <Ecore:EEnumLiteral name="EQUAL"/>
        <Ecore:EEnumLiteral name="HIGHER"/>
      </eLiterals>
    </Ecore:EEnum>

    <!-- ScoringTable class -->
    <Ecore:EClass name="ScoringTable">
      <eStructuralFeatures>
        <Ecore:EAttribute name="id" eType="EString" unique="true"/>
        <Ecore:EReference name="rounds" eType="#//Round" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- Round class -->
    <Ecore:EClass name="Round">
      <eStructuralFeatures>
        <Ecore:EAttribute name="id" eType="EString" unique="true"/>
        <Ecore:EReference name="winningPlayers" eType="#//Player" upperBound="-1"/>
        <Ecore:EAttribute name="pointValue" eType="EInt"/>
        <Ecore:EAttribute name="isJackRound" eType="EBoolean" defaultValueLiteral="false"/>
        <Ecore:EAttribute name="isSoloRound" eType="EBoolean" defaultValueLiteral="false"/>
        <Ecore:EAttribute name="isMandatorySoloRound" eType="EBoolean" defaultValueLiteral="false"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- SoloRound class (specialization of Round) -->
    <Ecore:EClass name="SoloRound">
      <eSuperTypes>
        <Ecore:EReference href="CardGame#//Round"/>
      </eSuperTypes>
      <eStructuralFeatures>
        <Ecore:EReference name="soloPlayer" eType="#//Player" containment="true"/>
        <Ecore:EAttribute name="soloType" eType="#//SoloType"/>
      </eStructuralFeatures>
    </Ecore:EClass>

    <!-- Enum for SoloType -->
    <Ecore:EEnum name="SoloType">
      <eLiterals>
        <Ecore:EEnumLiteral name="TRUMP"/>
        <Ecore:EEnumLiteral name="JACK"/>
        <Ecore:EEnumLiteral name="QUEEN"/>
      </eLiterals>
    </Ecore:EEnum>

  </eClassifiers>
</model>
