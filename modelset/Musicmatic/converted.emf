@namespace(uri="http://www.example.org/musicModel", prefix="musicModel")
package musicModel;

class Song {
	attr String Title;
	attr int Year;
	attr int length;
	attr String Genre;
	ref Artist[1]#songs artist;
	ref BusinessUser[1]#songs businessUser;
}

class Artist {
	attr EDate BirthDate;
	attr String Name;
	attr String Website;
	ref Song[*]#artist songs;
}

class User {
	attr int UserID;
	attr String Name;
	attr String Address;
}

class RegularUser extends User {
	ref Single[*]#regularUsers singles;
	val Album[*]#composer composedAlbums;
	ref Album[*]#suggestedBy suggestedAlbums;
}

class BusinessUser extends User {
	attr int VATnumber;
	ref Song[*]#businessUser songs;
}

class Hit extends Song {
	ref Track[*]#hit tracks;
}

class Single extends Song {
	ref RegularUser[*]#singles regularUsers;
}

class Album {
	ref Track[*]#album tracks;
	ref RegularUser[1]#composedAlbums composer;
	ref RegularUser[*]#suggestedAlbums suggestedBy;
}

class Track {
	attr int TrackNumber;
	ref Hit[1]#tracks hit;
	ref Album[1]#tracks album;
}


