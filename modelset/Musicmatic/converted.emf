@namespace(uri="http://www.example.org/music", prefix="music")
package music;

class MusicCatalog {
	val Artist[*] artists;
	val User[*] users;
	val Album[*] albums;
}

class Song {
	attr String title;
	attr int year;
	attr int length;
	attr String genre;
	ref Artist#songs artist;
	ref BusinessUser#songs publishedBy;
}

class Artist {
	attr EDate birthDate;
	attr String name;
	attr String website;
	val Song[*]#artist songs;
}

abstract class User {
	attr int userID;
	attr String name;
	attr String address;
}

class RegularUser extends User {
	ref Single[*]#regularUsers singles;
	ref Album[*]#composer composedAlbums;
	ref Album[*]#suggestedBy suggestedAlbums;
}

class BusinessUser extends User {
	attr int vatNumber;
	ref Song[*]#publishedBy songs;
}

class Single extends Song {
	ref RegularUser[*]#singles regularUsers;
}

class Hit extends Song {
	val Track[*]#hit tracks;
}

class Album {
	ref Track[*]#album tracks;
	ref RegularUser#composedAlbums composer;
	ref RegularUser[*]#suggestedAlbums suggestedBy;
}

class Track {
	attr int trackNumber;
	ref Hit#tracks hit;
	ref Album#tracks album;
}


