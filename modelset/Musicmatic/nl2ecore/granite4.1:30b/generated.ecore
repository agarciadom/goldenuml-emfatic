<model xmlns="http://www.eclipse.org/emf/2003/XMI"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.eclipse.org/emf/2003/XMI http://archive.eclipse.org/modeling/emf/xsd/xmi.xsd">
  <metaModel href="../tmdm/tmdm.ecore#/" name="tmdm"/>

  <!-- Root container class -->
  <modelElement xsi:type="ecore:EClass" name="MusicmaticContainer">
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="songs"
                          eType="#//Song"
                          upperBound="-1"
                          containment="true"/>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="artists"
                          eType="#//Artist"
                          upperBound="-1"
                          containment="true"/>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="users"
                          eType="#//User"
                          upperBound="-1"
                          containment="true"/>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="albums"
                          eType="#//Album"
                          upperBound="-1"
                          containment="true"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- Artist class -->
  <modelElement xsi:type="ecore:EClass" name="Artist">
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="name"
                          eType="ecore:EString"
                          unique="true"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="dateOfBirth"
                          eType="tmdm:EDate"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="infoUrl"
                          eType="ecore:EString"/>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="songs"
                          eType="#//Song"
                          upperBound="-1"
                          containment="true"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- Song class -->
  <modelElement xsi:type="ecore:EClass" name="Song">
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="title"
                          eType="ecore:EString"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="year"
                          eType="ecore:EInt"/>
      <!-- Use java.time.Duration as a primitive type -->
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="length"
                          eType="java:Duration"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="genre"
                          eType="ecore:EString"/>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="artist"
                          eType="#//Artist"
                          lowerBound="1"/>
      <!-- Classification of the song when uploaded -->
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="classification"
                          eType="SongClassification"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- User class (abstract) -->
  <modelElement xsi:type="ecore:EClass" abstract="true" name="User">
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="id"
                          eType="ecore:EString"
                          unique="true"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="name"
                          eType="ecore:EString"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="address"
                          eType="ecore:EString"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- RegularUser class -->
  <modelElement xsi:type="ecore:EClass" name="RegularUser">
    <eSuperTypes>
      <eReference type="#//User"/>
    </eSuperTypes>
    <eStructuralFeatures>
      <!-- Purchased albums -->
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="purchasedAlbums"
                          eType="#//Album"
                          upperBound="-1"
                          containment="true"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- BusinessUser class -->
  <modelElement xsi:type="ecore:EClass" name="BusinessUser">
    <eSuperTypes>
      <eReference type="#//User"/>
    </eSuperTypes>
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="vatNumber"
                          eType="ecore:EString"/>
      <!-- Uploaded songs -->
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="uploadedSongs"
                          eType="#//Song"
                          upperBound="-1"
                          containment="true"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- Album class with composition of hits (no singles) -->
  <modelElement xsi:type="ecore:EClass" name="Album">
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="hits"
                          eType="#//HitTrack"
                          upperBound="-1"
                          containment="true"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- Association class for hit tracks in an album (captures track number) -->
  <modelElement xsi:type="ecore:EClass" name="HitTrack">
    <eStructuralFeatures>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="hitSong"
                          eType="#//Song"
                          lowerBound="1"/>
      <eStructuralFeature xsi:type="ecore:EAttribute"
                          name="trackNumber"
                          eType="ecore:EInt"/>
      <eStructuralFeature xsi:type="ecore:EReference"
                          name="album"
                          eType="#//Album"
                          lowerBound="1"/>
    </eStructuralFeatures>
  </modelElement>

  <!-- Enumeration for song classification (single or hit) -->
  <modelElement xsi:type="ecore:EEnum" name="SongClassification">
    <eLiterals>
      <eLiteral name="SINGLE"/>
      <eLiteral name="HIT"/>
    </eLiterals>
  </modelElement>

</model>
