@namespace(uri="http://www.example.org/musicmatic", prefix="musicmatic")
package musicmatic;

datatype Duration : java.time.Duration;

class Musicmatic {
	val Song[*] songs;
	val Artist[*] artists;
	val User[*] users;
	val Album[*] albums;
	val Suggestion[*] suggestions;
}

class Artist {
	attr String[1] name;
	attr EDate dateOfBirth;
	attr String url;
	ref Song[*]#artist songs;
}

abstract class Song {
	attr String[1] title;
	attr int[1] year;
	attr Duration[1] length;
	attr String genre;
	ref Artist[1]#songs artist;
	ref BusinessUser#uploadedSongs uploadedBy;
}

class Single extends Song {
	ref RegularUser[*]#purchasedSingles purchasedBy;
}

class Hit extends Song {
	ref AlbumTrack[*]#hit albumTracks;
}

class AlbumTrack {
	attr int[1] trackNumber;
	ref Album#albumTracks album;
	ref Hit[1]#albumTracks hit;
}

class Album {
	attr String title;
	val AlbumTrack[*]#album albumTracks;
	ref RegularUser[*]#purchasedAlbums purchasedBy;
}

class Suggestion {
	ref Album[1] album;
	ref RegularUser[*]#suggestions suggestedTo;
}

abstract class User {
	id attr String[1] ~id;
	attr String[1] name;
	attr String address;
}

class RegularUser extends User {
	ref Single[*]#purchasedBy purchasedSingles;
	ref Album[*]#purchasedBy purchasedAlbums;
	ref Suggestion[*]#suggestedTo suggestions;
}

class BusinessUser extends User {
	attr String[1] vatNumber;
	ref Song[*]#uploadedBy uploadedSongs;
}


