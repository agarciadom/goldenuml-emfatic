@namespace(uri="http://musicmatic.com/epackage", prefix="mm")
package Musicmatic;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EInt[1] ID;
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class Artist {
	attr ecore.EDate[1] dateOfBirth;
	attr ecore.EString[1] name;
	attr ecore.EString infoURL;
}

class Song {
	attr ecore.EString[1] title;
	attr ecore.EInt year;
	attr ecore.EDouble length;
	attr ecore.EString genre;
	ref Artist[1] artist;
}

class RegularUser extends User {
}

class BusinessUser extends User {
	attr ecore.EString VATNumber;
}

class Album {
	val Track[*] tracks;
}

class Track {
	attr ecore.EInt[1] trackNumber;
}


