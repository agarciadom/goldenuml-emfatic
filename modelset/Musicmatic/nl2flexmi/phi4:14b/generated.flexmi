<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Musicmatic" nsURI="http://musicmatic.com/epackage" nsPrefix="mm">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="ID" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Artist">
      <eStructuralFeatures>
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="infoURL" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Song">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="year" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="length" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="genre" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="artist" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RegularUser" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="BusinessUser" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="VATNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Album">
      <eStructuralFeatures>
        <eReference name="tracks" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Track">
      <eStructuralFeatures>
        <eAttribute name="trackNumber" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
