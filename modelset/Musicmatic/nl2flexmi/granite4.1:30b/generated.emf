@namespace(uri="http://www.musicmatic.com/model", prefix="music")
package Musicmatic;

import "http://www.eclipse.org/emf/2002/Ecore";

class Song {
	attr ecore.EString[1] title;
	attr ecore.EInt year;
	attr ecore.EInt length;
	attr ecore.EString genre;
	ref Artist[1] artist;
}

class Artist {
	attr ecore.EString[1] name;
	attr ecore.EDate dateOfBirth;
	attr ecore.EString websiteUrl;
}

class User {
	attr ecore.EString[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class RegularUser extends User {
	val Album[*] ownedAlbums;
	val Song[*] ownedSingles;
}

class BusinessUser extends User {
	attr ecore.EString vatNumber;
	val Song[*] uploadedSongs;
}

class Album {
	val HitTrack[*] hits;
}

class HitTrack {
	attr ecore.EInt[1] trackNumber;
	ref Song[1] song;
}


