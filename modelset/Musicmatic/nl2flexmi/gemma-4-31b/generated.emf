@namespace(uri="http://www.musicmatic.com", prefix="mm")
package Musicmatic;

import "http://www.eclipse.org/emf/2002/Ecore";

class Artist {
	attr ecore.EDate dateOfBirth;
	attr ecore.EString[1] name;
	attr ecore.EString url;
}

class Song {
	attr ecore.EString[1] title;
	attr ecore.EInt[1] year;
	attr ecore.EInt[1] length;
	attr ecore.EString genre;
	ref Artist[1] artist;
}

class Single extends Song {
}

class Hit extends Song {
}

class User {
	attr ecore.EInt[1] userId;
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class RegularUser extends User {
	ref Single[*] boughtSingles;
}

class BusinessUser extends User {
	attr ecore.EString[1] vatNumber;
	ref Song[*] uploadedSongs;
}

class Album {
	val Track[+] tracks;
	ref RegularUser[1] composer;
}

class Track {
	attr ecore.EInt[1] trackNumber;
	ref Hit[1] hit;
	ref Album[1] album;
}


