<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Musicmatic" nsURI="http://www.musicmatic.com" nsPrefix="mm">
  <eClassifiers>
    <eClass name="Artist">
      <eStructuralFeatures>
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="url" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Song">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="year" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="length" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="genre" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="artist" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Single" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Hit" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="userId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RegularUser" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eReference name="boughtSingles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessUser" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="vatNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="uploadedSongs" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Album">
      <eStructuralFeatures>
        <eReference name="tracks" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.8" />
        <eReference name="composer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Track">
      <eStructuralFeatures>
        <eAttribute name="trackNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="hit" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="album" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
