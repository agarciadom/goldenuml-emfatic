@namespace(uri="http://www.musicmatic.com/schema", prefix="musicmatic")
package Musicmatic;

import "http://www.eclipse.org/emf/2002/Ecore";

class Song {
	attr ecore.EString[1] title;
	attr ecore.EInt year;
	attr ecore.EFloat length;
	attr ecore.EString genre;
	ref Artist[1] artist;
}

class Artist {
	attr ecore.EDate[1] dateOfBirth;
	attr ecore.EString[1] name;
	attr ecore.EString websiteURL;
	attr ecore.EInt[*] songs;
}

class User {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class RegularUser extends User {
	ref Single[*] singlesPurchased;
	val Album[*] albums;
}

class BusinessUser extends User {
	attr ecore.EString vatNumber;
	val Song[*] uploadedSongs;
}

class Single extends Song {
}

class Hit extends Song {
	attr ecore.EInt trackNumber;
	ref Album album;
}

class Album {
	val Hit[*] hits;
}

class Suggestion {
	ref RegularUser[1] sourceUser;
	ref RegularUser[1] targetUser;
	ref Album[1] suggestedAlbum;
}


