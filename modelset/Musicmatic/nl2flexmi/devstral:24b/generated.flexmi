<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Musicmatic" nsURI="http://www.musicmatic.com/schema" nsPrefix="musicmatic">
  <eClassifiers>
    <eClass name="Song">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="year" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="length" lowerBound="0" upperBound="1" eType="//EFloat" />
        <eAttribute name="genre" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="artist" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Artist">
      <eStructuralFeatures>
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="websiteURL" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="songs" lowerBound="0" upperBound="-1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RegularUser" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eReference name="singlesPurchased" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="albums" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessUser" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="vatNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="uploadedSongs" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Single" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Hit" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="trackNumber" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="album" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Album">
      <eStructuralFeatures>
        <eReference name="hits" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Suggestion">
      <eStructuralFeatures>
        <eReference name="sourceUser" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="targetUser" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="suggestedAlbum" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
