<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Musicmatic" nsURI="http://www.example.org/Musicmatic" nsPrefix="mm">
  <eClassifiers>
    <eClass name="Song">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="year" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="length" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eAttribute name="genre" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="artist" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Artist">
      <eStructuralFeatures>
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="websiteURL" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessUser" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="vatNumber" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="uploadedSongs" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RegularUser" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eReference name="purchasedSingles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SingleSong" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="HitSong" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="trackNumber" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Album">
      <eStructuralFeatures>
        <eReference name="tracks" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eDataType name="Integer" instanceClassName="java.lang.Integer" />
    <eDataType name="Date" instanceClassName="java.util.Date" />
  </eClassifiers>
</ePackage>
