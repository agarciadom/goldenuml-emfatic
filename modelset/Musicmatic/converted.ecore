<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="musicmodel"
    nsURI="http://www.example.org/musicmodel"
    nsPrefix="musicmodel">

  <!--
    Root container class holding all top-level instances.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="MusicCatalog">
    <eStructuralFeatures xsi:type="ecore:EReference" name="songs"
        eType="#//Song" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="artists"
        eType="#//Artist" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="users"
        eType="#//User" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="albums"
        eType="#//Album" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tracks"
        eType="#//Track" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!--
    Song class with basic attributes.
    Subclasses: Hit {total; disjoint}, Single
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Song">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="year"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="length"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="genre"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!--
      Back-reference to the Artist who authored this Song.
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="artist"
        eType="#//Artist"
        eOpposite="#//Artist/songs"/>
    <!--
      Song "* - 1" BusinessUser: a Song is published/owned by one BusinessUser.
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="businessUser"
        eType="#//BusinessUser"
        eOpposite="#//BusinessUser/songs"/>
  </eClassifiers>

  <!--
    Hit extends Song. Associated with Album via Track association class.
    Constraint: {total; disjoint} with Single under Song.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Hit" eSuperTypes="#//Song">
    <!--
      Hit "* - *" Album mediated by Track association class.
      So Hit references Track only.
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="tracks"
        eType="#//Track" upperBound="-1"
        eOpposite="#//Track/hit"/>
  </eClassifiers>

  <!--
    Single extends Song.
    Single "* - *" RegularUser
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Single" eSuperTypes="#//Song">
    <eStructuralFeatures xsi:type="ecore:EReference" name="regularUsers"
        eType="#//RegularUser" upperBound="-1"
        eOpposite="#//RegularUser/singles"/>
  </eClassifiers>

  <!--
    Track is the association class between Hit and Album.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Track">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="trackNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hit"
        eType="#//Hit"
        eOpposite="#//Hit/tracks"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="album"
        eType="#//Album"
        eOpposite="#//Album/tracks"/>
  </eClassifiers>

  <!--
    Album class (implied by the diagram).
    Composed and suggested by RegularUser.
    Associated with Hit via Track.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Album">
    <!--
      Album side of the Track association class.
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="tracks"
        eType="#//Track" upperBound="-1"
        eOpposite="#//Track/album"/>
    <!--
      RegularUser "1 - *" Album : compose (RegularUser is the container).
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="composer"
        eType="#//RegularUser"
        eOpposite="#//RegularUser/composedAlbums"/>
    <!--
      RegularUser "* - *" Album : suggestion
    -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="suggestedBy"
        eType="#//RegularUser" upperBound="-1"
        eOpposite="#//RegularUser/suggestedAlbums"/>
  </eClassifiers>

  <!--
    Artist class. One artist has many songs.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Artist">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="website"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="songs"
        eType="#//Song" upperBound="-1"
        eOpposite="#//Song/artist"/>
  </eClassifiers>

  <!--
    User base class.
    Subclasses: BusinessUser {total; overlap}, RegularUser
  -->
  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="userID"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!--
    RegularUser extends User.
    Composes albums (1 RegularUser - * Albums).
    Suggests albums (* RegularUser - * Albums).
    Accesses Singles (* RegularUser - * Single).
  -->
  <eClassifiers xsi:type="ecore:EClass" name="RegularUser" eSuperTypes="#//User">
    <eStructuralFeatures xsi:type="ecore:EReference" name="composedAlbums"
        eType="#//Album" upperBound="-1"
        containment="true"
        eOpposite="#//Album/composer"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="suggestedAlbums"
        eType="#//Album" upperBound="-1"
        eOpposite="#//Album/suggestedBy"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="singles"
        eType="#//Single" upperBound="-1"
        eOpposite="#//Single/regularUsers"/>
  </eClassifiers>

  <!--
    BusinessUser extends User.
    Owns/publishes Songs (1 BusinessUser - * Songs).
    Constraint: {total; overlap} with User.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="BusinessUser" eSuperTypes="#//User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vATnumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="songs"
        eType="#//Song" upperBound="-1"
        eOpposite="#//Song/businessUser"/>
  </eClassifiers>

</ecore:EPackage>
