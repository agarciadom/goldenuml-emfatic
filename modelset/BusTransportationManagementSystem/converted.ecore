<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="busManagement"
    nsURI="http://www.example.org/busManagement"
    nsPrefix="busManagement">

  <!-- Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="BusManagementSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="busVehicles"
        eType="#//BusVehicle" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routes"
        eType="#//Route" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routeAssignments"
        eType="#//RouteAssignment" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="drivers"
        eType="#//Driver" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driverSchedules"
        eType="#//DriverSchedule" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- Enum: Shift -->
  <eClassifiers xsi:type="ecore:EEnum" name="Shift">
    <eLiterals name="Morning" value="0"/>
    <eLiterals name="Afternoon" value="1"/>
    <eLiterals name="Night" value="2"/>
  </eClassifiers>

  <!-- Class: BusVehicle -->
  <eClassifiers xsi:type="ecore:EClass" name="BusVehicle">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="licencePlate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inRepairShop"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routeAssignments"
        eType="#//RouteAssignment" upperBound="-1" eOpposite="#//RouteAssignment/busVehicle"/>
  </eClassifiers>

  <!-- Class: Route -->
  <eClassifiers xsi:type="ecore:EClass" name="Route">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routeAssignments"
        eType="#//RouteAssignment" upperBound="-1" eOpposite="#//RouteAssignment/route"/>
  </eClassifiers>

  <!-- Class: RouteAssignment (association class between BusVehicle and Route) -->
  <eClassifiers xsi:type="ecore:EClass" name="RouteAssignment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="busVehicle"
        eType="#//BusVehicle" eOpposite="#//BusVehicle/routeAssignments"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="route"
        eType="#//Route" eOpposite="#//Route/routeAssignments"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driverSchedules"
        eType="#//DriverSchedule" upperBound="-1" eOpposite="#//DriverSchedule/routeAssignment"/>
  </eClassifiers>

  <!-- Class: Driver -->
  <eClassifiers xsi:type="ecore:EClass" name="Driver">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="onSickLeave"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driverSchedules"
        eType="#//DriverSchedule" upperBound="-1" eOpposite="#//DriverSchedule/driver"/>
  </eClassifiers>

  <!-- Class: DriverSchedule (association class between Driver and RouteAssignment) -->
  <eClassifiers xsi:type="ecore:EClass" name="DriverSchedule">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="shift"
        eType="#//Shift"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="driver"
        eType="#//Driver" eOpposite="#//Driver/driverSchedules"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="routeAssignment"
        eType="#//RouteAssignment" eOpposite="#//RouteAssignment/driverSchedules"/>
  </eClassifiers>

</ecore:EPackage>
