@namespace(uri="http://www.example.org/busManagement", prefix="busManagement")
package busManagement;

class BusManagementSystem {
	val BusVehicle[*] busVehicles;
	val Route[*] routes;
	val RouteAssignment[*] routeAssignments;
	val Driver[*] drivers;
	val DriverSchedule[*] driverSchedules;
}

enum Shift {
	Morning = 0;
	Afternoon = 1;
	Night = 2;
}

class BusVehicle {
	attr String licencePlate;
	attr boolean inRepairShop;
	ref RouteAssignment[*]#busVehicle routeAssignments;
}

class Route {
	attr int number;
	ref RouteAssignment[*]#route routeAssignments;
}

class RouteAssignment {
	attr EDate date;
	ref BusVehicle#routeAssignments busVehicle;
	ref Route#routeAssignments route;
	ref DriverSchedule[*]#routeAssignment driverSchedules;
}

class Driver {
	attr String name;
	attr String ~id;
	attr boolean onSickLeave;
	ref DriverSchedule[*]#driver driverSchedules;
}

class DriverSchedule {
	attr Shift shift;
	ref Driver#driverSchedules driver;
	ref RouteAssignment#driverSchedules routeAssignment;
}


