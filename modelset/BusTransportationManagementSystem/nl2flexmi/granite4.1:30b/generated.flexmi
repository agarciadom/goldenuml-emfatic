<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BTMS" nsURI="http://example.com/btms" nsPrefix="btms">
  <eClassifiers>
    <eClass name="IdentifiableEntity">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="sickLeave" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="shifts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="licencePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="repairShop" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="shifts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Route">
      <eStructuralFeatures>
        <eAttribute name="routeNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="buses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shift">
      <eStructuralFeatures>
        <eAttribute name="shiftType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="assignedDriver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="assignedBus" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
