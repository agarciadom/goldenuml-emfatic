@namespace(uri="http://example.com/btms", prefix="btms")
package BTMS;

import "http://www.eclipse.org/emf/2002/Ecore";

class IdentifiableEntity {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] ~id;
}

class Driver extends IdentifiableEntity {
	attr ecore.EBoolean sickLeave;
	ref Shift[*] shifts;
}

class Bus extends IdentifiableEntity {
	attr ecore.EString[1] licencePlate;
	attr ecore.EBoolean repairShop;
	ref Shift[*] shifts;
}

class Route {
	attr ecore.EInt[1] routeNumber;
	attr ecore.EString name;
	ref Bus[*] buses;
}

class Shift {
	attr ecore.EString[1] shiftType;
	ref Driver assignedDriver;
	ref Bus assignedBus;
}


