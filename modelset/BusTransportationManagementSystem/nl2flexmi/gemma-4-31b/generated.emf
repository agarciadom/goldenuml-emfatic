@namespace(uri="http://www.example.com/btms", prefix="btms")
package BTMS;

import "http://www.eclipse.org/emf/2002/Ecore";

class BTMS {
	val Driver[*] drivers;
	val Bus[*] buses;
	val Route[*] routes;
	val DailyAssignment[*] dailyAssignments;
}

class Driver {
	attr ecore.EString name;
	attr ecore.EInt[1] ~id;
	attr ecore.EBoolean isOnSickLeave;
}

class Bus {
	attr ecore.EString[1] licencePlate;
	attr ecore.EBoolean isInRepairShop;
}

class Route {
	attr ecore.EInt[1] routeNameNumber;
}

class DailyAssignment {
	attr ecore.EDate[1] date;
	ref Bus[1] bus;
	ref Route[1] route;
	val ShiftAssignment[*] shifts;
}

class ShiftAssignment {
	attr ecore.EString[1] shiftType;
	ref Driver[1] driver;
}


