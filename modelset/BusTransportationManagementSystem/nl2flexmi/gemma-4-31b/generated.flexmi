<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BTMS" nsURI="http://www.example.com/btms" nsPrefix="btms">
  <eClassifiers>
    <eClass name="BTMS">
      <eStructuralFeatures>
        <eReference name="drivers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="buses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="routes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="dailyAssignments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isOnSickLeave" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="licencePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isInRepairShop" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Route">
      <eStructuralFeatures>
        <eAttribute name="routeNameNumber" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DailyAssignment">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="bus" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="route" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="shifts" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ShiftAssignment">
      <eStructuralFeatures>
        <eAttribute name="shiftType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="driver" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
