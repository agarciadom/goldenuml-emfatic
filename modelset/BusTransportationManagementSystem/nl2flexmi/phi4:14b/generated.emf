@namespace(uri="http://www.example.com/BTMS.ecore", prefix="btms")
package BTMS;

import "http://www.eclipse.org/emf/2002/Ecore";

class Driver {
	attr ecore.EString[1] name;
	attr ecore.EString[1] ~id;
	attr ecore.EBoolean sickLeave;
}

class Bus {
	attr ecore.EString[1] licensePlate;
	attr ecore.EBoolean inRepair;
}

class Route {
	attr ecore.EInt[1] number;
}

class Shift {
	attr ecore.EBoolean isMorning;
	attr ecore.EBoolean isAfternoon;
	attr ecore.EBoolean isNight;
}

class Schedule {
	ref Driver[1] driver;
	ref Shift[1] shift;
	ref Route[1] route;
	ref Day[1] day;
}

class Day {
}

class BusAssignment {
	ref Route[1] route;
	ref Bus[1] bus;
	ref Day[1] day;
}


