<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BTMS" nsURI="http://www.example.com/BTMS.ecore" nsPrefix="btms">
  <eClassifiers>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="sickLeave" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="licensePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="inRepair" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Route">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shift">
      <eStructuralFeatures>
        <eAttribute name="isMorning" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isAfternoon" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isNight" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Schedule">
      <eStructuralFeatures>
        <eReference name="driver" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="shift" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="route" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="day" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Day">
      <eStructuralFeatures />
    </eClass>
    <eClass name="BusAssignment">
      <eStructuralFeatures>
        <eReference name="route" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="bus" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="day" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
