@namespace(uri="http://www.example.com/BTMS", prefix="btms")
package BTMS;

import "http://www.eclipse.org/emf/2002/Ecore";

class Driver {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EBoolean onSickLeave;
}

class BusRoute {
	attr ecore.EInt[1] routeNumber;
	ref Bus[*] buses;
	val ShiftAssignment[*] shiftAssignments;
}

class Bus {
	attr ecore.EString[1] licencePlate;
	attr ecore.EBoolean inRepairShop;
}

class ShiftAssignment {
	attr ecore.EString[1] shiftType;
	val Driver[1] driver;
	ref BusRoute[1] busRoute;
}


