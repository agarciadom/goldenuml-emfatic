<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BusTransportationManagementSystem" nsURI="http://bus-transport-management-system" nsPrefix="btms">
  <eClassifiers>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="onSickLeave" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="schedules" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="assignments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusRoute">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="assignments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusAssignment">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="assignedBus" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="assignedDriver" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="assignedShift" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="assignedRoute" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Schedule">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="scheduledDriver" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="scheduledShift" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shift">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="licencePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="inRepairShop" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="assignments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
