<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BTMS" nsURI="http://www.example.com/BTMS" nsPrefix="btms">
  <eClassifiers>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="onSickLeave" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusRoute">
      <eStructuralFeatures>
        <eAttribute name="routeNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="buses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="shiftAssignments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="licencePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="inRepairShop" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ShiftAssignment">
      <eStructuralFeatures>
        <eAttribute name="shiftType" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="driver" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="busRoute" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
