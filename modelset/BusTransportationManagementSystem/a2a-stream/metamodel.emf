@namespace(uri="http://example.com/btms", prefix="p")
package BTMS;

class Driver {
  attr int ~id;
  attr string name;
  attr boolean sickLeave;
}
class Route {
  attr int routeNumber;
}
class Bus {
  attr string licensePlate;
  attr boolean inRepairShop;
}
class Assignment {
  attr string date;
  val Bus bus;
  val Route route;
}
class ShiftAssignment {
  attr Enumeration(MORNING|AFTERNOON|NIGHT) shiftType;
  val Driver driver;
  val Assignment assignment;
}