@namespace(uri="http://www.example.org/btms", prefix="btms")
package btms;

datatype LocalTime : java.time.LocalTime;

enum ShiftType {
	MORNING = 0;
	AFTERNOON = 1;
	NIGHT = 2;
}

class BTMS {
	val Driver[*] drivers;
	val Bus[*] buses;
	val BusRoute[*] routes;
	val BusAssignment[*] busAssignments;
	val Shift[*] shifts;
	val DailyOverview[*] dailyOverviews;
}

class Driver {
	op void addDriver();
	op void deleteDriver();
	id attr int driverId;
	attr String name;
	attr boolean onSickLeave;
	ref DriverShiftAssignment[*]#driver assignedShifts;
}

class Bus {
	op void addBus();
	op void deleteBus();
	id attr String licencePlate;
	attr boolean inRepairShop;
	ref BusAssignment[*]#bus busAssignments;
}

class BusRoute {
	id attr int routeNumber;
	ref BusAssignment[*]#route busAssignments;
	ref Shift[*]#route shifts;
}

class BusAssignment {
	attr EDate date;
	ref Bus#busAssignments bus;
	ref BusRoute#busAssignments route;
	val DriverShiftAssignment[*]#busAssignment driverShiftAssignments;
}

class Shift {
	attr ShiftType shiftType;
	attr EDate date;
	ref BusRoute#shifts route;
	ref DriverShiftAssignment[*]#shift driverShiftAssignments;
}

class DriverShiftAssignment {
	ref Driver#assignedShifts driver;
	ref Shift#driverShiftAssignments shift;
	ref BusAssignment#driverShiftAssignments busAssignment;
}

class DailyOverview {
	op void generateOverview(EDate date);
	attr EDate date;
}


