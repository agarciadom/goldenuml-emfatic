<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI"
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="btms" nsURI="http://example.org/btms" nsPrefix="btms">

    <!-- Data Types -->
    <ecore:EDataType xmi:id="_TimeOfDay" name="TimeOfDay"
                     instanceClassName="java.time.LocalTime"/>

    <!-- Classes -->
    <ecore:EClass xmi:id="_BTMS" name="BusTransportationManagementSystem">
      <eStructuralFeatures>
        <ecore:EReference xmi:id="_BTMS_Drivers" name="drivers"
                          eType="#_Driver" upperBound="-1" containment="true"/>
        <ecore:EReference xmi:id="_BTMS_Buses" name="buses"
                          eType="#_Bus" upperBound="-1" containment="true"/>
        <ecore:EReference xmi:id="_BTMS_Routes" name="routes"
                          eType="#_Route" upperBound="-1" containment="true"/>
        <ecore:EReference xmi:id="_BTMS_Schedules" name="schedules"
                          eType="#_Schedule" upperBound="-1" containment="true"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass xmi:id="_Driver" name="Driver">
      <eAttributes>
        <ecore:EAttribute xmi:id="_Driver_Id" name="id"
                          eType="ecore:EInt" unique="true" changeable="false"/>
        <ecore:EAttribute xmi:id="_Driver_Name" name="name"
                          eType="ecore:EString"/>
        <ecore:EAttribute xmi:id="_Driver_OnSickLeave" name="onSickLeave"
                          eType="ecore:EBoolean" defaultValueLiteral="false"/>
      </eAttributes>
    </ecore:EClass>

    <ecore:EClass xmi:id="_Bus" name="Bus">
      <eAttributes>
        <ecore:EAttribute xmi:id="_Bus_LicencePlate" name="licencePlate"
                          eType="ecore:EString" unique="true"/>
        <ecore:EAttribute xmi:id="_Bus_InRepairShop" name="inRepairShop"
                          eType="ecore:EBoolean" defaultValueLiteral="false"/>
      </eAttributes>
    </ecore:EClass>

    <ecore:EClass xmi:id="_Route" name="Route">
      <eAttributes>
        <ecore:EAttribute xmi:id="_Route_RouteNumber" name="routeNumber"
                          eType="ecore:EInt" unique="true"/>
      </eAttributes>
      <eStructuralFeatures>
        <ecore:EReference xmi:id="_Route_AssignedBuses" name="assignedBuses"
                          eType="#_BusAssignment" upperBound="-1" containment="true"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass xmi:id="_BusAssignment" name="BusAssignment">
      <eAttributes>
        <ecore:EAttribute xmi:id="_BusAssignment_Date" name="date"
                          eType="ecore:EDate"/>
      </eAttributes>
      <eReferences>
        <ecore:EReference xmi:id="_BusAssignment_Bus" name="bus"
                          eType="#_Bus" containment="false"/>
      </eReferences>
    </ecore:EClass>

    <ecore:EClass xmi:id="_Schedule" name="Schedule">
      <eStructuralFeatures>
        <ecore:EReference xmi:id="_Schedule_DriverAssignments" name="driverAssignments"
                          eType="#_DriverAssignment" upperBound="-1" containment="true"/>
      </eStructuralFeatures>
    </ecore:EClass>

    <ecore:EClass xmi:id="_DriverAssignment" name="DriverAssignment">
      <eAttributes>
        <ecore:EAttribute xmi:id="_DriverAssignment_Date" name="date"
                          eType="ecore:EDate"/>
        <ecore:EAttribute xmi:id="_DriverAssignment_Shift" name="shift"
                          eType="#_Shift"/>
      </eAttributes>
      <eReferences>
        <ecore:EReference xmi:id="_DriverAssignment_Driver" name="driver"
                          eType="#_Driver" containment="false"/>
        <ecore:EReference xmi:id="_DriverAssignment_BusAssignment" name="busAssignment"
                          eType="#_BusAssignment" containment="false"/>
      </eReferences>
    </ecore:EClass>

    <!-- Enumerations -->
    <ecore:EEnum xmi:id="_Shift" name="Shift">
      <eLiterals>
        <ecore:EEnumLiteral xmi:id="_Shift_Morning" name="MORNING"/>
        <ecore:EEnumLiteral xmi:id="_Shift_Afternoon" name="AFTERNOON"/>
        <ecore:EEnumLiteral xmi:id="_Shift_Night" name="NIGHT"/>
      </eLiterals>
    </ecore:EEnum>

  </ecore:EPackage>
</xmi:XMI>
