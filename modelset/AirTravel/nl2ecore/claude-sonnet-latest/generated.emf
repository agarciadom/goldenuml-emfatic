@namespace(uri="http://www.example.org/aviation", prefix="aviation")
package aviation;

datatype EDate : java.util.Date;

class AviationSystem {
	val Airline[*] airlines;
	val Airport[*] airports;
	val Aircraft[*] aircraft;
	val Passenger[*] passengers;
	val Flight[*] flights;
}

class Aircraft {
	attr String name;
	attr String type;
	attr int yearOfManufacture;
	attr EDate nextInspectionDate;
	ref Flight[*]#aircraft flights;
	ref Airline#aircraft airline;
	ref Airport#basedAircraft homeAirport;
}

class PassengerAircraft extends Aircraft {
	attr int numberOfSeats;
	val SeatCategory[*]#passengerAircraft seatCategories;
}

class SeatCategory {
	attr String designation;
	attr boolean hasEntertainmentProgram;
	attr int numberOfSeats;
	ref PassengerAircraft#seatCategories passengerAircraft;
	ref Ticket[*]#seatCategory tickets;
}

class Flight {
	attr String flightNumber;
	attr EDate date;
	ref Aircraft#flights aircraft;
	val Ticket[*]#flight tickets;
	ref Airport#departingFlights departureAirport;
	ref Airport#arrivingFlights destinationAirport;
	ref FlightAttendant[*]#flights flightAttendants;
	ref Pilot#flightsAsCaptain captain;
	ref Pilot[0..2]#flightsAsCoPilot coPilots;
}

class Ticket {
	attr String ticketNumber;
	attr double price;
	attr boolean upgradeDesired;
	ref Passenger#tickets passenger;
	ref Flight#tickets flight;
	ref SeatCategory#tickets seatCategory;
}

class Passenger {
	attr String name;
	attr String passportNumber;
	ref Ticket[*]#passenger tickets;
}

class Airline {
	attr String name;
	ref Aircraft[*]#airline aircraft;
	val FlightAttendant[*]#airline flightAttendants;
	val Pilot[*]#airline pilots;
}

abstract class Employee {
	attr String name;
	attr EDate dateOfEmployment;
}

class FlightAttendant extends Employee {
	attr boolean isChiefSteward;
	ref Airline#flightAttendants airline;
	ref Flight[*]#flightAttendants flights;
}

class Pilot extends Employee {
	attr String license;
	ref Airline#pilots airline;
	ref Flight[*]#captain flightsAsCaptain;
	ref Flight[*]#coPilots flightsAsCoPilot;
}

class Airport {
	attr String name;
	attr String address;
	attr int numberOfRunways;
	ref Aircraft[*]#homeAirport basedAircraft;
	ref Flight[*]#departureAirport departingFlights;
	ref Flight[*]#destinationAirport arrivingFlights;
}


