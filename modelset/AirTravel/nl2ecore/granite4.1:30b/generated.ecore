<xmi:XMI xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
         xmlns:Ecore="org.eclipse.emf.ecore#//Ecore">
  <Ecore:EPackage xmi:id="_root" name="system" nsURI="http://system" nsPrefix="system">
    <!-- Root container class -->
    <eClassifiers mixed="true">
      <Ecore:EClass xmi:id="_SystemRoot" name="SystemRoot">
        <eStructuralFeatures>
          <eReference name="aircrafts" eType="#/_Aircraft"
                      upper="-1" containment="true"/>
          <eReference name="airlines" eType="#/_Airline"
                      upper="-1" containment="true"/>
          <eReference name="airports" eType="#/_Airport"
                      upper="-1" containment="true"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Aircraft -->
      <Ecore:EClass xmi:id="_Aircraft" name="Aircraft">
        <eStructuralFeatures mixed="true">
          <eAttribute name="name" eType="EString"/>
          <eAttribute name="type" eType="EString"/>
          <eAttribute name="yearOfManufacture" eType="EInt"/>
          <!-- Using java.time:LocalDateTime as a custom datatype -->
          <eAttribute name="nextInspectionDate" eType="java.time:LocalDateTime"/>
          <eReference name="flights" eType="#/_Flight"
                      upper="-1" containment="true"/>
          <eReference name="homeAirport" eType="#/_Airport"
                      upper="1"/>
          <eReference name="airline"   eType="#/_Airline"
                      upper="1"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- PassengerAircraft (subclass of Aircraft) -->
      <Ecore:EClass xmi:id="_PassengerAircraft" name="PassengerAircraft">
        <eSuperTypes>#/_Aircraft</eSuperTypes>
        <eStructuralFeatures mixed="true">
          <eAttribute name="numberOfSeats" eType="EInt"/>
          <!-- Seat‑category aggregation -->
          <eReference name="seatCategories" eType="#/_SeatCategory"
                      upper="-1" containment="true"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Flight -->
      <Ecore:EClass xmi:id="_Flight" name="Flight">
        <eStructuralFeatures mixed="true">
          <eAttribute name="flightNumber" eType="EString"/>
          <eAttribute name="date"         eType="java.time:LocalDate"/>
          <!-- Navigation to airports -->
          <eReference name="departureAirport"  eType="#/_Airport"
                      upper="1" eOpposite="departureFlights"/>
          <eReference name="destinationAirport" eType="#/_Airport"
                      upper="1" eOpposite="destinationFlights"/>
          <!-- Back‑link to aircraft -->
          <eReference name="aircraft" eType="#/_Aircraft"
                      upper="1" eOpposite="flights"/>
          <!-- Registrations of passengers (association class) -->
          <eReference name="passengerRegistrations" eType="#/_PassengerRegistration"
                      upper="-1" containment="true"/>
          <!-- Crew assignments for pilots -->
          <eReference name="crewAssignments"  eType="#/_CrewAssignment"
                      upper="-1" containment="true"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Passenger (plain entity) -->
      <Ecore:EClass xmi:id="_Passenger" name="Passenger">
        <eStructuralFeatures mixed="true">
          <eAttribute name="name"       eType="EString"/>
          <eAttribute name="passportNumber" eType="EString"/>
          <eReference name="flights"   eType="#/_Flight"
                      upper="-1" eOpposite="passengerRegistrations"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- PassengerRegistration (link between Flight ↔ Passenger) -->
      <Ecore:EClass xmi:id="_PassengerRegistration" name="PassengerRegistration">
        <eStructuralFeatures mixed="true">
          <eReference name="flight" eType="#/_Flight"
                      upper="1" eOpposite="passengerRegistrations"/>
          <eReference name="passenger" eType="#/_Passenger"
                      upper="1" eOpposite="flights"/>
          <!-- Ticket is stored inside the registration -->
          <eReference name="ticket"  eType="#/_Ticket"
                      upper="1" containment="true"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Ticket (simple data holder) -->
      <Ecore:EClass xmi:id="_Ticket" name="Ticket">
        <eStructuralFeatures mixed="true">
          <eAttribute name="ticketNumber" eType="EString"/>
          <eAttribute name="price"       eType="EDouble"/>
          <eAttribute name="upgradeDesired" eType="EBoolean"/>
          <!-- Optional link to a seat category -->
          <eReference name="seatCategory" eType="#/_SeatCategory"
                      upper="1"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- SeatCategory (belongs to PassengerAircraft) -->
      <Ecore:EClass xmi:id="_SeatCategory" name="SeatCategory">
        <eStructuralFeatures mixed="true">
          <eAttribute name="designation" eType="EString"/>
          <eAttribute name="offersEntertainmentProgram" eType="EBoolean"/>
          <eAttribute name="numberOfSeats"               eType="EInt"/>
          <eReference name="passengerAircraft" eType="#/_PassengerAircraft"
                      upper="1" eOpposite="seatCategories"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Airline -->
      <Ecore:EClass xmi:id="_Airline" name="Airline">
        <eStructuralFeatures mixed="true">
          <eAttribute name="name" eType="EString"/>
          <eReference name="aircrafts"   eType="#/_Aircraft"
                      upper="-1" containment="true"/>
          <eReference name="flightAttendants" eType="#/_FlightAttendant"
                      upper="-1" containment="true"/>
          <eReference name="pilots"       eType="#/_Pilot"
                      upper="-1" containment="true"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- FlightAttendant -->
      <Ecore:EClass xmi:id="_FlightAttendant" name="FlightAttendant">
        <eStructuralFeatures mixed="true">
          <eAttribute name="name" eType="EString"/>
          <eAttribute name="employmentDate" eType="java.time:LocalDate"/>
          <eAttribute name="isChiefStewardOrStewardess" eType="EBoolean"/>
          <eReference name="airline" eType="#/_Airline"
                      upper="1" eOpposite="flightAttendants"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Pilot -->
      <Ecore:EClass xmi:id="_Pilot" name="Pilot">
        <eStructuralFeatures mixed="true">
          <eAttribute name="name"   eType="EString"/>
          <eAttribute name="employmentDate" eType="java.time:LocalDate"/>
          <eAttribute name="license" eType="EString"/>
          <eReference name="airline" eType="#/_Airline"
                      upper="1" eOpposite="pilots"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- CrewAssignment (Flight ↔ Pilot, indicating role) -->
      <Ecore:EClass xmi:id="_CrewAssignment" name="CrewAssignment">
        <eStructuralFeatures mixed="true">
          <eReference name="flight" eType="#/_Flight"
                      upper="1" eOpposite="crewAssignments"/>
          <eReference name="pilot"  eType="#/_Pilot"
                      upper="1" eOpposite="crewAssignments"/>
          <eAttribute name="isCaptain" eType="EBoolean"/>
        </eStructuralFeatures>
      </Ecore:EClass>

      <!-- Airport -->
      <Ecore:EClass xmi:id="_Airport" name="Airport">
        <eStructuralFeatures mixed="true">
          <eAttribute name="name"                eType="EString"/>
          <eAttribute name="address"             eType="EString"/>
          <eAttribute name="numberOfRunways"     eType="EInt"/>
          <eReference name="homeAircraft"        eType="#/_Aircraft"
                      upper="-1" eOpposite="homeAirport"/>
          <eReference name="departureFlights"    eType="#/_Flight"
                      upper="-1" eOpposite="departureAirport"/>
          <eReference name="destinationFlights"  eType="#/_Flight"
                      upper="-1" eOpposite="destinationAirport"/>
        </eStructuralFeatures>
      </Ecore:EClass>

    </eClassifiers>
  </Ecore:EPackage>

  <!-- Instance of the root object (empty model) -->
  <xmi:XMI id="ID_0">
    <system:SystemRoot xmi:id="ID_SystemRoot"/>
  </xmi:XMI>
</xmi:XMI>
