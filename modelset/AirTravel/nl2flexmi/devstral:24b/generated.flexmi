<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AircraftPackage" nsURI="http://www.example.org/aircraft" nsPrefix="aircraft">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfManufacture" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="nextInspectionDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="homeAirport" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="flights" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="airline" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Flight">
      <eStructuralFeatures>
        <eAttribute name="flightNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="aircraft" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="passengers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="departureAirport" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="destinationAirport" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="tickets" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="captain" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="coPilots" containment="False" lowerBound="0" upperBound="2" eType="//@eClassifiers.7" />
        <eReference name="flightAttendants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Passenger">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="passportNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="flights" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eAttribute name="ticketNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="upgradeDesired" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="seatCategory" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="flight" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SeatCategory">
      <eStructuralFeatures>
        <eAttribute name="designation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="hasEntertainment" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="numberOfSeats" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="passengerAircraft" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airline">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="aircrafts" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfEmployment" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pilot" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="license" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FlightAttendant" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="isChiefSteward" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PassengerAircraft" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Airport">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="numberOfRunways" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="homeAircrafts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="departingFlights" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="arrivingFlights" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
