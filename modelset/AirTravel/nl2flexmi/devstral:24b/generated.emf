@namespace(uri="http://www.example.org/aircraft", prefix="aircraft")
package AircraftPackage;

import "http://www.eclipse.org/emf/2002/Ecore";

class Aircraft {
	attr ecore.EString[1] name;
	attr ecore.EString[1] type;
	attr ecore.EInt[1] yearOfManufacture;
	attr ecore.EDate nextInspectionDate;
	ref Airport homeAirport;
	val Flight[*] flights;
	ref Airline airline;
}

class Flight {
	attr ecore.EString[1] flightNumber;
	attr ecore.EDate[1] date;
	ref Aircraft[1] aircraft;
	val Passenger[*] passengers;
	ref Airport[1] departureAirport;
	ref Airport[1] destinationAirport;
	val Ticket[*] tickets;
	ref Pilot[1] captain;
	ref Pilot[0..2] coPilots;
	val FlightAttendant[*] flightAttendants;
}

class Passenger {
	attr ecore.EString[1] name;
	attr ecore.EString[1] passportNumber;
	ref Flight[*] flights;
}

class Ticket {
	attr ecore.EString[1] ticketNumber;
	attr ecore.EInt[1] price;
	attr ecore.EBoolean[1] upgradeDesired;
	ref SeatCategory[1] seatCategory;
	ref Flight[1] flight;
}

class SeatCategory {
	attr ecore.EString[1] designation;
	attr ecore.EBoolean[1] hasEntertainment;
	attr ecore.EInt[1] numberOfSeats;
	ref PassengerAircraft passengerAircraft;
}

class Airline {
	attr ecore.EString[1] name;
	val Aircraft[*] aircrafts;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] dateOfEmployment;
}

class Pilot extends Employee {
	attr ecore.EString license;
}

class FlightAttendant extends Employee {
	attr ecore.EBoolean[1] isChiefSteward;
}

class PassengerAircraft extends Aircraft {
}

class Airport {
	attr ecore.EString[1] name;
	attr ecore.EString address;
	attr ecore.EInt[1] numberOfRunways;
	ref Aircraft[*] homeAircrafts;
	val Flight[*] departingFlights;
	val Flight[*] arrivingFlights;
}


