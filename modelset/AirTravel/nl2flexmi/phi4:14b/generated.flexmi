<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AircraftManagement" nsURI="http://www.example.org/AircraftManagement.ecore" nsPrefix="am">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfManufacture" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="dateOfNextInspection" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="flights" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="airline" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="homeAirport" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Flight">
      <eStructuralFeatures>
        <eReference name="aircraft" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="tickets" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="flightAttendants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="captain" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="coPilots" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="departureAirport" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="destinationAirport" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Passenger">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="passportNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="tickets" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eAttribute name="ticketNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="upgradeDesired" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="flight" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="passenger" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="seatCategory" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SeatCategory">
      <eStructuralFeatures>
        <eAttribute name="designation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="entertainmentProgram" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="numberOfSeats" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="aircraft" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airline">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="aircrafts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="flightAttendants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="pilots" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FlightAttendant">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfEmployment" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="isChiefSteward" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isStewardess" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pilot">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfEmployment" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="licenseNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airport">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="numberOfRunways" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PassengerAircraft" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="numberOfSeats" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="seatCategories" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
