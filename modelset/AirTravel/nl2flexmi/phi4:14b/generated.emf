@namespace(uri="http://www.example.org/AircraftManagement.ecore", prefix="am")
package AircraftManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Aircraft {
	attr ecore.EString[1] name;
	attr ecore.EString[1] type;
	attr ecore.EInt[1] yearOfManufacture;
	attr ecore.EDate dateOfNextInspection;
	ref Flight[*] flights;
	ref Airline airline;
	ref Airport homeAirport;
}

class Flight {
	ref Aircraft[1] aircraft;
	val Ticket[*] tickets;
	val FlightAttendant[*] flightAttendants;
	ref Pilot[1] captain;
	ref Pilot[*] coPilots;
	ref Airport[1] departureAirport;
	ref Airport[1] destinationAirport;
}

class Passenger {
	attr ecore.EString[1] name;
	attr ecore.EString[1] passportNumber;
	ref Ticket[*] tickets;
}

class Ticket {
	attr ecore.EString[1] ticketNumber;
	attr ecore.EDouble[1] price;
	attr ecore.EBoolean upgradeDesired;
	ref Flight[1] flight;
	ref Passenger[1] passenger;
	ref SeatCategory[1] seatCategory;
}

class SeatCategory {
	attr ecore.EString[1] designation;
	attr ecore.EBoolean entertainmentProgram;
	attr ecore.EInt[1] numberOfSeats;
	ref PassengerAircraft[1] aircraft;
}

class Airline {
	attr ecore.EString[1] name;
	ref Aircraft[*] aircrafts;
	ref FlightAttendant[*] flightAttendants;
	ref Pilot[*] pilots;
}

class FlightAttendant {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] dateOfEmployment;
	attr ecore.EBoolean isChiefSteward;
	attr ecore.EBoolean isStewardess;
}

class Pilot {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] dateOfEmployment;
	attr ecore.EString[1] licenseNumber;
}

class Airport {
	attr ecore.EString[1] name;
	attr ecore.EString address;
	attr ecore.EInt[1] numberOfRunways;
}

class PassengerAircraft extends Aircraft {
	attr ecore.EInt[1] numberOfSeats;
	ref SeatCategory[*] seatCategories;
}


