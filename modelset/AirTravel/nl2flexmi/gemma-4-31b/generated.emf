@namespace(uri="http://www.aviation.org/system", prefix="av")
package AviationSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Aircraft {
	attr ecore.EString[1] name;
	attr ecore.EString[1] type;
	attr ecore.EInt[1] yearOfManufacture;
	attr ecore.EDate[1] dateOfNextInspection;
	ref Airline airline;
	ref Airport homeAirport;
}

class PassengerAircraft extends Aircraft {
	attr ecore.EInt[1] numberOfSeats;
	val SeatCategory[+] seatCategories;
}

class Flight {
	attr ecore.EString[1] flightNumber;
	attr ecore.EDate[1] flightDate;
	ref Aircraft[1] aircraft;
	ref Airport[1] departureAirport;
	ref Airport[1] destinationAirport;
	ref FlightAttendant[+] crewFlightAttendants;
	ref Pilot[1] captain;
	ref Pilot[1..2] coPilots;
	val Ticket[*] tickets;
}

class Passenger {
	attr ecore.EString[1] name;
	attr ecore.EString[1] passportNumber;
}

class Ticket {
	attr ecore.EString[1] ticketNumber;
	attr ecore.EBigDecimal[1] price;
	attr ecore.EBoolean[1] upgradeDesired;
	ref Passenger[1] passenger;
	ref SeatCategory[1] seatCategory;
}

class SeatCategory {
	attr ecore.EString[1] designation;
	attr ecore.EBoolean[1] offersEntertainment;
	attr ecore.EInt[1] numberOfSeats;
}

class Airline {
	attr ecore.EString[1] name;
	val Employee[*] employees;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EDate[1] dateOfEmployment;
}

class FlightAttendant extends Employee {
	attr ecore.EBoolean[1] isChief;
}

class Pilot extends Employee {
	attr ecore.EString[1] license;
}

class Airport {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	attr ecore.EInt[1] numberOfRunways;
}


