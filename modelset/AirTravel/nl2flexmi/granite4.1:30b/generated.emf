@namespace(uri="http://example.com/aircraftmodel", prefix="acm")
package AircraftModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class Aircraft {
	attr ecore.EString[1] name;
	attr ecore.EString type;
	attr ecore.EInt yearOfManufacture;
	val Flight[*] flights;
	ref Airline airline;
	ref Airport homeAirport;
}

class PassengerAircraft extends Aircraft {
	attr ecore.EInt seatCount;
	val SeatCategory[*] seatCategories;
}

class Flight {
	attr ecore.EString[1] flightNumber;
	attr ecore.EDate date;
	val Ticket[*] tickets;
	ref Airport departureAirport;
	ref Airport destinationAirport;
	ref Pilot captain;
	ref Pilot[*] coPilots;
	ref FlightAttendant[*] flightAttendants;
}

class Passenger {
	attr ecore.EString[1] name;
	attr ecore.EString[1] passportNumber;
}

class Ticket {
	attr ecore.EString[1] ticketNumber;
	attr ecore.EBigDecimal price;
	attr ecore.EBoolean upgradeWanted;
	ref Flight flight;
	ref Passenger passenger;
	ref SeatCategory seatCategory;
}

class SeatCategory {
	attr ecore.EString[1] designation;
	attr ecore.EBoolean hasEntertainmentProgram;
	attr ecore.EInt seatCount;
}

class Airline {
	attr ecore.EString[1] name;
	ref Pilot[*] pilots;
	ref FlightAttendant[*] flightAttendants;
}

class Employee {
}

class FlightAttendant extends Employee {
	attr ecore.EString[1] name;
	attr ecore.EDate employmentDate;
	attr ecore.EBoolean isChief;
}

class Pilot extends Employee {
	attr ecore.EString[1] name;
	attr ecore.EDate employmentDate;
	attr ecore.EString license;
}

class Airport {
	attr ecore.EString[1] name;
	attr ecore.EString address;
	attr ecore.EInt runwayCount;
}


