<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="AircraftModel" nsURI="http://example.com/aircraftmodel" nsPrefix="acm">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="type" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfManufacture" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="flights" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="airline" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="homeAirport" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PassengerAircraft" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="seatCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="seatCategories" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Flight">
      <eStructuralFeatures>
        <eAttribute name="flightNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="tickets" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="departureAirport" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="destinationAirport" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="captain" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="coPilots" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="flightAttendants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Passenger">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="passportNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eAttribute name="ticketNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="0" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="upgradeWanted" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="flight" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="passenger" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="seatCategory" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SeatCategory">
      <eStructuralFeatures>
        <eAttribute name="designation" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="hasEntertainmentProgram" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="seatCount" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airline">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pilots" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="flightAttendants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures />
    </eClass>
    <eClass name="FlightAttendant" eSuperTypes="//@eClassifiers.7">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="employmentDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="isChief" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pilot" eSuperTypes="//@eClassifiers.7">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="employmentDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="license" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Airport">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="runwayCount" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
