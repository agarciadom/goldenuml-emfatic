<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="airline"
    nsURI="http://www.example.org/airline"
    nsPrefix="airline">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="AirlineSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="airlines"
        eType="#//Airline" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="airports"
        eType="#//Airport" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="flights"
        eType="#//Flight" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="passengers"
        eType="#//Passenger" upperBound="-1" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="flightExecutions"
        eType="#//FlightExecution" upperBound="-1" containment="true"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Airline">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Airline "0..1" to "0..*" Employee -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        eType="#//Employee" upperBound="-1" containment="true"
        eOpposite="#//Employee/airline"/>
    <!-- Airline "0..1" aggregates "0..*" Airplane -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="airplanes"
        eType="#//Airplane" upperBound="-1"
        eOpposite="#//Airplane/airline"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="true">
    <!-- Note: PlantUML has a typo "Nmae" - corrected to "name" -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="airline"
        eType="#//Airline" lowerBound="0" upperBound="1"
        eOpposite="#//Airline/employees"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="FlightAttendant" eSuperTypes="#//Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="purser"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- FlightExecution to FlightAttendant many-to-many -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="flightExecutions"
        eType="#//FlightExecution" upperBound="-1"
        eOpposite="#//FlightExecution/flightAttendants"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Pilot" eSuperTypes="#//Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="license"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Captain role -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="captainOf"
        eType="#//FlightExecution" upperBound="-1"
        eOpposite="#//FlightExecution/captain"/>
    <!-- Co-pilot role -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="coPilotOf"
        eType="#//FlightExecution" upperBound="-1"
        eOpposite="#//FlightExecution/coPilots"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Airport">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="runwayCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Airport "0..1" to "0..*" Flight as Source -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="departingFlights"
        eType="#//Flight" upperBound="-1"
        eOpposite="#//Flight/source"/>
    <!-- Airport "0..1" to "0..*" Flight as Destination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="arrivingFlights"
        eType="#//Flight" upperBound="-1"
        eOpposite="#//Flight/destination"/>
    <!-- Airplane "0..*" to "0..1" Airport -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="basedAirplanes"
        eType="#//Airplane" upperBound="-1"
        eOpposite="#//Airplane/homeAirport"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Airplane">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="constructionYear"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nextInspection"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- Airline "0..1" aggregates "0..*" Airplane -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="airline"
        eType="#//Airline" lowerBound="0" upperBound="1"
        eOpposite="#//Airline/airplanes"/>
    <!-- Airplane "0..*" to "0..1" Airport -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="homeAirport"
        eType="#//Airport" lowerBound="0" upperBound="1"
        eOpposite="#//Airport/basedAirplanes"/>
    <!-- Airplane "0..1" to "0..*" FlightExecution -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="flightExecutions"
        eType="#//FlightExecution" upperBound="-1"
        eOpposite="#//FlightExecution/airplane"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PassengerPlane" eSuperTypes="#//Airplane">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="seats"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- PassengerPlane "0..1" composes "0..*" SeatCategory -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="seatCategories"
        eType="#//SeatCategory" upperBound="-1" containment="true"
        eOpposite="#//SeatCategory/passengerPlane"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Flight">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="flightNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Airport "0..1" to "0..*" Flight as Source -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="source"
        eType="#//Airport" lowerBound="0" upperBound="1"
        eOpposite="#//Airport/departingFlights"/>
    <!-- Airport "0..1" to "0..*" Flight as Destination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="destination"
        eType="#//Airport" lowerBound="0" upperBound="1"
        eOpposite="#//Airport/arrivingFlights"/>
    <!-- Flight "0..1" to "0..*" FlightExecution -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="flightExecutions"
        eType="#//FlightExecution" upperBound="-1"
        eOpposite="#//FlightExecution/flight"/>
  </eClassifiers>

  <!--
    FlightExecution participates in the association class pattern with Passenger via Ticket.
    Each Ticket corresponds to one (FlightExecution, Passenger) pair.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="FlightExecution">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- Flight "0..1" to "0..*" FlightExecution -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="flight"
        eType="#//Flight" lowerBound="0" upperBound="1"
        eOpposite="#//Flight/flightExecutions"/>
    <!-- Airplane "0..1" to "0..*" FlightExecution -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="airplane"
        eType="#//Airplane" lowerBound="0" upperBound="1"
        eOpposite="#//Airplane/flightExecutions"/>
    <!-- FlightExecution to FlightAttendant many-to-many -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="flightAttendants"
        eType="#//FlightAttendant" upperBound="-1"
        eOpposite="#//FlightAttendant/flightExecutions"/>
    <!-- FlightExecution "0..*" to "0..1" Pilot as Captain -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="captain"
        eType="#//Pilot" lowerBound="0" upperBound="1"
        eOpposite="#//Pilot/captainOf"/>
    <!-- FlightExecution "0..*" to "0..2" Pilot as Co-pilot -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="coPilots"
        eType="#//Pilot" upperBound="2"
        eOpposite="#//Pilot/coPilotOf"/>
    <!-- Association class: FlightExecution side contains Ticket instances -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="tickets"
        eType="#//Ticket" upperBound="-1" containment="true"
        eOpposite="#//Ticket/flightExecution"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="SeatCategory">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="entertainment"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="seatCount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="passengerPlane"
        eType="#//PassengerPlane" lowerBound="0" upperBound="1"
        eOpposite="#//PassengerPlane/seatCategories"/>
    <!-- SeatCategory "0..1" to "0..*" Ticket -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="tickets"
        eType="#//Ticket" upperBound="-1"
        eOpposite="#//Ticket/seatCategory"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Passenger">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="passportNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Association class: Passenger side references Ticket instances -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="tickets"
        eType="#//Ticket" upperBound="-1"
        eOpposite="#//Ticket/passenger"/>
  </eClassifiers>

  <!--
    Ticket is the association class between FlightExecution and Passenger.
    It is contained by FlightExecution and references Passenger.
  -->
  <eClassifiers xsi:type="ecore:EClass" name="Ticket">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ticketId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="upgrade"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Link back to FlightExecution (container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="flightExecution"
        eType="#//FlightExecution" lowerBound="0" upperBound="1"
        eOpposite="#//FlightExecution/tickets"/>
    <!-- Link to Passenger -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="passenger"
        eType="#//Passenger" lowerBound="0" upperBound="1"
        eOpposite="#//Passenger/tickets"/>
    <!-- SeatCategory "0..1" to "0..*" Ticket -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="seatCategory"
        eType="#//SeatCategory" lowerBound="0" upperBound="1"
        eOpposite="#//SeatCategory/tickets"/>
  </eClassifiers>

</ecore:EPackage>
