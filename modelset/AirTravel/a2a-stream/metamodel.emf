@namespace(uri="http://www.example.org/aircraftpackage", prefix="p")
package AircraftPackage;

class Aircraft {
  attr String name;
  attr String type;
  attr Integer yearOfManufacture;
  attr Date dateOfNextInspection;
  val Flight[*] flights;
  ref Airline airline;
  ref Airport homeAirport;
}
class Passenger {
  attr String name;
  attr String passportNumber;
  ref Flight[*] flights;
}
class Flight {
  attr Integer flightNumber;
  attr Date date;
  val Ticket[*] tickets;
  ref Passenger[*] passengers;
  ref FlightAttendant[*] flightAttendants;
  ref Pilot captainPilot;
  ref Pilot[*] coPilots;
  ref Airport departureAirport;
  ref Airport destinationAirport;
}
class Ticket {
  attr String ticketNumber;
  attr Double price;
  attr Boolean upgradeDesired;
  ref Passenger passenger;
  ref Flight flight;
  ref SeatCategory seatCategory;
}
class Airline {
  attr String name;
  val Aircraft[*] aircrafts;
  val FlightAttendant[*] flightAttendants;
  val Pilot[*] pilots;
}
class Airport {
  attr String name;
  attr String address;
  attr Integer numberOfRunways;
}
class SeatCategory {
  attr String designation;
  attr Boolean hasEntertainmentProgram;
  attr Integer numberOfSeats;
}
class CrewMember {
  attr String name;
  attr Date dateOfEmployment;
}
class FlightAttendant extends CrewMember {
  attr Boolean isChiefSteward;
  ref Flight[*] flightsWorkedOn;
}
class Pilot extends CrewMember {
  attr String license;
  ref Flight[*] flightsFlown;
}
class PassengerAircraft extends Aircraft {
  attr Integer numberOfSeats;
  val SeatCategory[*] seatCategories;
}