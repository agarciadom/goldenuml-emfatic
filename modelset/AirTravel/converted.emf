@namespace(uri="http://www.example.org/airline", prefix="airline")
package airline;

class Airline {
	attr String name;
	ref Employee[*]#airline employees;
	ref Airplane[*]#airline airplanes;
}

class Employee {
	attr String name;
	attr EDate startDate;
	ref Airline#employees airline;
}

class Airport {
	attr String name;
	attr String address;
	attr int runwayCount;
	ref Airplane[*]#baseAirport basedAirplanes;
	ref Flight[*]#source sourceFlights;
	ref Flight[*]#destination destinationFlights;
}

class FlightAttendant extends Employee {
	attr boolean purser;
	ref FlightExecution[*]#flightAttendants flightExecutions;
}

class Airplane {
	attr String name;
	attr String type;
	attr EDate constructionYear;
	attr EDate nextInspection;
	ref Airline#airplanes airline;
	ref Airport#basedAirplanes baseAirport;
	ref FlightExecution[*]#airplane flightExecutions;
}

class Flight {
	attr String flightNumber;
	ref Airport#sourceFlights source;
	ref Airport#destinationFlights destination;
	ref FlightExecution[*]#flight flightExecutions;
}

class Pilot extends Employee {
	attr String license;
	ref FlightExecution[*]#captain captainExecutions;
	ref FlightExecution[*]#copilots copilotExecutions;
}

class PassengerPlane extends Airplane {
	attr int seats;
	val SeatCategory[*]#passengerPlane seatCategories;
}

class FlightExecution {
	attr EDate date;
	ref Airplane#flightExecutions airplane;
	ref Flight#flightExecutions flight;
	ref FlightAttendant[*]#flightExecutions flightAttendants;
	ref Pilot#captainExecutions captain;
	ref Pilot[0..2]#copilotExecutions copilots;
	ref Passenger[*]#flightExecutions passengers;
	ref Ticket[*]#flightExecution tickets;
}

class SeatCategory {
	attr String description;
	attr boolean entertainment;
	attr int seatCount;
	ref PassengerPlane#seatCategories passengerPlane;
	ref Ticket[*]#seatCategory tickets;
}

class Passenger {
	attr String name;
	attr String passportNumber;
	ref FlightExecution[*]#passengers flightExecutions;
	ref Ticket[*]#passenger tickets;
}

class Ticket {
	attr String ticketId;
	attr float price;
	attr boolean upgrade;
	ref SeatCategory#tickets seatCategory;
	ref Passenger#tickets passenger;
	ref FlightExecution#tickets flightExecution;
}


