@namespace(uri="http://www.example.org/cruise", prefix="cruise")
package cruise;

datatype Duration : java.time.Duration;

class CruiseSystem {
	val Provider[*] providers;
	val Cruise[*] cruises;
	val Employee[*] employees;
	val Guest[*] guests;
	val Ship[*] ships;
	val TravelAgency[*] travelAgencies;
	val DestinationArea[*] destinationAreas;
	val Booking[*] bookings;
	val Ticket[*] tickets;
}

class Provider {
	attr String name;
	attr String location;
	ref Cruise[*]#provider cruises;
}

class Cruise {
	attr int number;
	attr String name;
	attr EDate startDate;
	attr EDate endDate;
	ref Provider#cruises provider;
	ref Employee[*]#cruises employees;
	ref Ship#cruises ship;
	ref DestinationArea#cruises destinationArea;
	val Show[*] shows;
	ref Ticket[*]#cruise tickets;
	ref Booking[*]#cruise bookings;
}

class Employee {
	attr String name;
	attr String socialSecurityNumber;
	ref Cruise[*]#employees cruises;
}

class Guest {
	attr String name;
	attr boolean vip;
	ref Ticket[*]#guest tickets;
}

class Ticket {
	attr int ticketNumber;
	ref Cruise#tickets cruise;
	ref Guest#tickets guest;
}

class Ship {
	attr String name;
	attr int numberOfDecks;
	attr double length;
	attr int numberOfPassengers;
	ref Cruise[*]#ship cruises;
}

class TravelAgency {
	attr String name;
	attr String address;
	ref Booking[*]#travelAgency bookings;
}

class Booking {
	attr int bookingNumber;
	attr EDate bookingDate;
	ref TravelAgency#bookings travelAgency;
	ref Cruise#bookings cruise;
}

class DestinationArea {
	attr String name;
	attr String seaName;
	ref Cruise[*]#destinationArea cruises;
}

class Show {
	attr String title;
	attr Duration duration;
}


