<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmi:version="2.0">
  <ecore:EPackage name="CruiseMetamodel" nsURI="http://www.example.org/cruisemetamodel" nsPrefix="cruisemetamodel" xmi:uuid="e541b69d-3f08-4a27-ba77-d29a3bba6fa9">
    <eClassifiers xmi:type="ecore:EDataType" name="String"/>
    <eClassifiers xmi:type="ecore:EDataType" name="Int" instanceClassName="java.lang.Integer"/>
    <eClassifiers xmi:type="ecore:EDataType" name="Float" instanceClassName="java.lang.Float"/>
    <eClassifiers xmi:type="ecore:EDataType" name="Boolean" instanceClassName="java.lang.Boolean"/>
    <eClassifiers xmi:type="ecore:EDataType" name="Duration" instanceClassName="java.time.Duration"/>

    <!-- Define EDate -->
    <eClassifiers xmi:type="ecore:EDataType" name="EDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="instanceClassName">org.eclipse.emf.common.util.EDate</details>
      </eAnnotations>
    </eClassifiers>

    <!-- Root container -->
    <eClassifiers xmi:type="ecore:EClass" name="CruiseSystem">
      <eStructuralFeatures xmi:type="ecore:EReference" name="providers" upperBound="-1" eType="#//Provider"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="ships" upperBound="-1" eType="#//Ship"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="destinations" upperBound="-1" eType="#//DestinationArea"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="travelAgencies" upperBound="-1" eType="#//TravelAgency"/>
    </eClassifiers>

    <!-- Provider class -->
    <eClassifiers xmi:type="ecore:EClass" name="Provider">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="location" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="organizedCruises" upperBound="-1" eType="#//Cruise"/>
    </eClassifiers>

    <!-- Cruise class -->
    <eClassifiers xmi:type="ecore:EClass" name="Cruise">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="cruiseNumber" eType="#//Int"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="startDate" eType="#//EDate"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="endDate" eType="#//EDate"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="provider" eType="#//Provider"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="employees" upperBound="-1" eType="#//Employee"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="guestAssociations" upperBound="-1" eType="#//CruiseGuest"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="tickets" upperBound="-1" eType="#//Ticket"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="shows" upperBound="-1" eType="#//Show"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="ship" eType="#//Ship"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="destinationArea" eType="#//DestinationArea"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="bookings" upperBound="-1" eType="#//Booking"/>
    </eClassifiers>

    <!-- Employee class -->
    <eClassifiers xmi:type="ecore:EClass" name="Employee">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="socialSecurityNumber" eType="#//String"/>
    </eClassifiers>

    <!-- Guest class -->
    <eClassifiers xmi:type="ecore:EClass" name="Guest">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="isVIP" eType="#//Boolean"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="cruiseAssociations" upperBound="-1" eType="#//CruiseGuest"/>
    </eClassifiers>

    <!-- Ship class -->
    <eClassifiers xmi:type="ecore:EClass" name="Ship">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="numberOfDecks" eType="#//Int"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="length" eType="#//Float"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="passengerCapacity" eType="#//Int"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="cruises" upperBound="-1" eType="#//Cruise"/>
    </eClassifiers>

    <!-- TravelAgency class -->
    <eClassifiers xmi:type="ecore:EClass" name="TravelAgency">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="address" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="bookings" upperBound="-1" eType="#//Booking"/>
    </eClassifiers>

    <!-- Booking class -->
    <eClassifiers xmi:type="ecore:EClass" name="Booking">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="bookingNumber" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="bookingDate" eType="#//EDate"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="cruise" eType="#//Cruise"/>
    </eClassifiers>

    <!-- DestinationArea class -->
    <eClassifiers xmi:type="ecore:EClass" name="DestinationArea">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="seaName" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="cruises" upperBound="-1" eType="#//Cruise"/>
    </eClassifiers>

    <!-- Show class -->
    <eClassifiers xmi:type="ecore:EClass" name="Show">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="title" eType="#//String"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="duration" eType="#//Duration"/>
    </eClassifiers>

    <!-- Association class for Guest-Cruise -->
    <eClassifiers xmi:type="ecore:EClass" name="CruiseGuest">
      <eStructuralFeatures xmi:type="ecore:EReference" name="guest" eType="#//Guest" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="cruise" eType="#//Cruise"/>
    </eClassifiers>

  </ecore:EPackage>
</xmi:XMI>
