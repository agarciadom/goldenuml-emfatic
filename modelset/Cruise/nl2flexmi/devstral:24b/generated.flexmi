<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CruiseModel" nsURI="http://www.example.org/cruisemodel" nsPrefix="cruisemodel">
  <eClassifiers>
    <eClass name="CruiseProvider">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="String" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cruise">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="Integer" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="Date" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="Date" />
        <eReference name="provider" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="ship" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="destinationArea" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="employees" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="guests" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="shows" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
        <eReference name="tickets" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="booking" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="String" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Guest">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="isVIP" lowerBound="1" upperBound="1" eType="Boolean" />
        <eReference name="cruises" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ship">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="numberOfDecks" lowerBound="1" upperBound="1" eType="Integer" />
        <eAttribute name="length" lowerBound="1" upperBound="1" eType="Double" />
        <eAttribute name="passengerCapacity" lowerBound="1" upperBound="1" eType="Integer" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TravelAgency">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="String" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Booking">
      <eStructuralFeatures>
        <eAttribute name="bookingNumber" lowerBound="1" upperBound="1" eType="Integer" />
        <eAttribute name="bookingDate" lowerBound="1" upperBound="1" eType="Date" />
        <eReference name="travelAgency" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DestinationArea">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="seaName" lowerBound="1" upperBound="1" eType="String" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="Integer" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eReference name="guest" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="cruise" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
