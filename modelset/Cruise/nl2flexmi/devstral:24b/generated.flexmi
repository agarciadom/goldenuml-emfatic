<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Cruise" nsURI="http://www.example.org/cruise" nsPrefix="cr">
  <eClassifiers>
    <eClass name="CruiseProvider">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cruise">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="provider" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="employees" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="guests" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="ships" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="travelAgency" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="bookings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="destination" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="shows" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
        <eReference name="tickets" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Guest">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isVIP" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="cruises" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="tickets" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ship">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="decks" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="length" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="passengerCapacity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="cruises" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TravelAgency">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Booking">
      <eStructuralFeatures>
        <eAttribute name="bookingNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="bookingDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="cruise" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DestinationArea">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="seaName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eReference name="guest" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="cruise" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
