@namespace(uri="http://www.example.org/cruise", prefix="cr")
package Cruise;

import "http://www.eclipse.org/emf/2002/Ecore";

class CruiseProvider {
	attr ecore.EString[1] name;
	attr ecore.EString[1] location;
}

class Cruise {
	attr ecore.EInt[1] number;
	attr ecore.EString[1] name;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate[1] endDate;
	ref CruiseProvider[1] provider;
	val Employee[+] employees;
	ref Guest[+] guests;
	ref Ship[+] ships;
	ref TravelAgency[1] travelAgency;
	val Booking[*] bookings;
	ref DestinationArea[1] destination;
	val Show[*] shows;
	val Ticket[+] tickets;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString[1] socialSecurityNumber;
}

class Guest {
	attr ecore.EString[1] name;
	attr ecore.EBoolean[1] isVIP;
	ref Cruise[*] cruises;
	ref Ticket[*] tickets;
}

class Ship {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] decks;
	attr ecore.EDouble[1] length;
	attr ecore.EInt[1] passengerCapacity;
	ref Cruise[*] cruises;
}

class TravelAgency {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class Booking {
	attr ecore.EInt[1] bookingNumber;
	attr ecore.EDate[1] bookingDate;
	ref Cruise[1] cruise;
}

class DestinationArea {
	attr ecore.EString[1] name;
	attr ecore.EString[1] seaName;
}

class Show {
	attr ecore.EString[1] title;
	attr ecore.EInt[1] duration;
}

class Ticket {
	ref Guest[1] guest;
	ref Cruise[1] cruise;
}


