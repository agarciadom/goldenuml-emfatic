@namespace(uri="http://example.com/CruiseDomain", prefix="cd")
package CruiseDomain;

import "http://www.eclipse.org/emf/2002/Ecore";

class Provider {
	attr ecore.EString[1] name;
	attr ecore.EString[1] location;
	ref Cruise[*] cruises;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString[1] socialSecurityNumber;
	ref Cruise[*] cruisesWorked;
}

class Guest {
	attr ecore.EString[1] name;
	attr ecore.EBoolean[1] isVIP;
	ref Cruise[*] participatedCruises;
	ref Ticket[*] ticketsHeld;
}

class Ship {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] numberOfDecks;
	attr ecore.EDouble[1] lengthOfTheShip;
	attr ecore.EInt[1] numberOfPassengers;
	ref Cruise[*] cruisesUsedFor;
}

class Booking {
	attr ecore.EString[1] bookingNumber;
	attr ecore.EDate[1] bookingDate;
}

class TravelAgency {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	ref Booking[*] bookingsMade;
}

class DestinationArea {
	attr ecore.EString[1] name;
	attr ecore.EString[1] seaName;
}

class Show {
	attr ecore.EString[1] title;
	attr ecore.EInt[1] duration;
}

class Ticket {
}

class Cruise {
	attr ecore.EString[1] number;
	attr ecore.EString[1] name;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate[1] endDate;
	ref DestinationArea[1] destination;
	ref Show[*] showsOffered;
	ref Guest[*] guests;
	val Ticket[*] ticketsIssued;
}


