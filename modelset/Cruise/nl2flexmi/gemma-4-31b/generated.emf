@namespace(uri="http://www.example.org/cruise", prefix="cruise")
package CruiseManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class CruiseManagementSystem {
	val Provider[*] providers;
	val Ship[*] ships;
	val TravelAgency[*] agencies;
	val Guest[*] guests;
	val DestinationArea[*] destinationAreas;
}

class NamedEntity {
	attr ecore.EString name;
}

class Provider extends NamedEntity {
	attr ecore.EString location;
	val Cruise[*] cruises;
}

class Cruise extends NamedEntity {
	attr ecore.EInt number;
	attr ecore.EDate startDate;
	attr ecore.EDate endDate;
	ref Provider[1] provider;
	ref Employee[*] employees;
	ref Guest[*] guests;
	ref Ship[1] ship;
	ref DestinationArea[1] destinationArea;
	ref Show[*] shows;
	val Ticket[*] tickets;
}

class Employee extends NamedEntity {
	attr ecore.EString socialSecurityNumber;
}

class Guest extends NamedEntity {
	attr ecore.EBoolean isVIP;
}

class Ship extends NamedEntity {
	attr ecore.EInt numDecks;
	attr ecore.EDouble length;
	attr ecore.EInt numPassengers;
}

class TravelAgency extends NamedEntity {
	attr ecore.EString address;
	val Booking[*] bookings;
}

class DestinationArea extends NamedEntity {
	attr ecore.EString seaName;
}

class Show extends NamedEntity {
	attr ecore.EInt duration;
}

class Booking {
	attr ecore.EString bookingNumber;
	attr ecore.EDate bookingDate;
	ref Cruise[1] cruise;
	ref TravelAgency[1] travelAgency;
}

class Ticket {
	ref Cruise[1] cruise;
	ref Guest[1] guest;
}


