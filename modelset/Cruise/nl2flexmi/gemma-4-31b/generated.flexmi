<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CruiseManagement" nsURI="http://www.example.org/cruise" nsPrefix="cruise">
  <eClassifiers>
    <eClass name="CruiseManagementSystem">
      <eStructuralFeatures>
        <eReference name="providers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="ships" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="agencies" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="guests" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="destinationAreas" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="NamedEntity">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Provider" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="location" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="cruises" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cruise" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="provider" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="employees" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="guests" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="ship" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="destinationArea" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="shows" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
        <eReference name="tickets" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="socialSecurityNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Guest" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="isVIP" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ship" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="numDecks" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="length" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="numPassengers" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TravelAgency" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="bookings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DestinationArea" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="seaName" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Booking">
      <eStructuralFeatures>
        <eAttribute name="bookingNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="bookingDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="cruise" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="travelAgency" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eReference name="cruise" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="guest" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
