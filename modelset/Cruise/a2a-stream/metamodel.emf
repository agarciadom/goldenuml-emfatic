@namespace(uri="http://cruise/model", prefix="p")
package Cruise;

class Provider {
  attr String name;
  attr String location;
}
class Ship {
  attr String name;
  attr Integer numberOfDecks;
  attr Float length;
  attr Integer passengerCapacity;
  ref Cruise[*] cruises;
}
class Employee {
  attr String name;
  attr String socialSecurityNumber;
}
class Guest {
  attr String name;
  attr Boolean isVIP;
  ref Cruise[*] cruises;
}
class Cruise {
  attr Integer cruiseNumber;
  attr String name;
  attr Date startDate;
  attr Date endDate;
  val Employee[*] employees;
  ref Provider provider;
  ref Guest[*] guests;
  ref Ship ship;
  ref DestinationArea destinationArea;
  val Show[*] shows;
}
class DestinationArea {
  attr String name;
  attr String seaName;
}
class Show {
  attr String title;
  attr Long duration;
}
class TravelAgency {
  attr String name;
  attr String address;
  ref Booking[*] bookings;
}
class Booking {
  attr Integer bookingNumber;
  attr Date bookingDate;
  ref TravelAgency travelAgency;
  ref Cruise cruise;
}
class Ticket {
  attr Integer ticketNumber;
  ref Guest guest;
  ref Booking booking;
  ref Cruise cruise;
}