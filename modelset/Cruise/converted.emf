@namespace(uri="http://www.example.org/travelagency", prefix="travelagency")
package travelagency;

class TravelAgency {
	attr String Name;
	attr String Address;
	val Ticket[*] tickets;
}

class Ticket {
	attr int BookingNumber;
	attr EDate BookingDate;
}

class Guest {
	attr String Name;
	attr boolean VIP;
}

class Employee {
	attr String Name;
	attr int Ssn;
}

class Cruise {
	attr int CruiseNumber;
	attr String Name;
	attr EDate StartDate;
	attr EDate EndDate;
	ref ProviderCompany providerCompany;
	ref Employee[*] employees;
	ref Ship ship;
	ref Destination destination;
	ref Show[*] shows;
}

class ProviderCompany {
	attr String Name;
	attr String Location;
}

class Ship {
	attr String Name;
	attr int DeckCount;
	attr float length;
	attr int PassengerCount;
}

class Show {
	attr String Title;
	attr int Duration;
}

class Destination {
	attr String Name;
	attr String Sea;
}

class GuestTicketCruise {
	ref Guest guest;
	ref Ticket ticket;
	ref Cruise cruise;
}


