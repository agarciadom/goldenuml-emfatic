@namespace(uri="http://www.example.org/travelagency", prefix="travelagency")
package travelagency;

class TravelAgencySystem {
	val TravelAgency travelAgency;
	val Guest[*] guests;
	val Employee[*] employees;
	val Cruise[*] cruises;
	val ProviderCompany[*] providerCompanies;
	val Ship[*] ships;
	val Show[*] shows;
	val Destination[*] destinations;
	val Booking[*] bookings;
}

class TravelAgency {
	attr String name;
	attr String address;
	val Ticket[*] tickets;
}

class Booking {
	ref Guest guest;
	ref Ticket ticket;
	ref Cruise cruise;
}

class Ticket {
	attr int bookingNumber;
	attr EDate bookingDate;
}

class Guest {
	attr String name;
	attr boolean vip;
}

class Employee {
	attr String name;
	attr int ssn;
}

class Cruise {
	attr int cruiseNumber;
	attr String name;
	attr EDate startDate;
	attr EDate endDate;
	ref ProviderCompany providerCompany;
	ref Employee[*] employees;
	ref Ship ship;
	ref Destination destination;
	ref Show[*] shows;
}

class ProviderCompany {
	attr String name;
	attr String location;
}

class Ship {
	attr String name;
	attr int deckCount;
	attr float length;
	attr int passengerCount;
}

class Show {
	attr String title;
	attr int duration;
}

class Destination {
	attr String name;
	attr String sea;
}


