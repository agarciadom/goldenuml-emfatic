@namespace(uri="http://example.com/hospitalsystem", prefix="hs")
package HospitalSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Hospital {
	attr ecore.EString[1] name;
	ref Doctor[0..1000] doctors;
	ref Patient[0..1000] patients;
	ref Examination[0..1000] examinations;
	ref Examination[*] permissions;
}

class Doctor {
	attr ecore.EString[1] name;
	ref Hospital[1] hospital;
	val Hospital affiliation;
}

class Patient {
	attr ecore.EString[1] name;
	ref Hospital[1] hospital;
	ref TreatmentPlan[*] treatmentHistory;
}

class Examination {
	attr ecore.EString[1] type;
	attr ecore.EDate datePerformed;
	ref Patient[1] patient;
	ref Hospital[1] hospital;
}

class TreatmentPlan {
	attr ecore.EString[1] name;
	ref Examination[0..1000] examinationTypes;
}

class Problem {
	attr ecore.EString[1] description;
	ref TreatmentPlan[*] treatmentPlans;
}


