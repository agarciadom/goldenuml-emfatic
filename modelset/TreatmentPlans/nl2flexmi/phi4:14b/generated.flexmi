<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalSystem" nsURI="http://example.com/hospitalsystem" nsPrefix="hs">
  <eClassifiers>
    <eClass name="Hospital">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="doctors" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.1" />
        <eReference name="patients" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.2" />
        <eReference name="examinations" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.3" />
        <eReference name="permissions" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="hospital" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="affiliation" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="hospital" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="treatmentHistory" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Examination">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="datePerformed" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="hospital" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TreatmentPlan">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="examinationTypes" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Problem">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="treatmentPlans" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
