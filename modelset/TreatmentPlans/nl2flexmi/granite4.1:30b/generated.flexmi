<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalDomain" nsURI="http://example.com/hospitaldomain" nsPrefix="hosp">
  <eClassifiers>
    <eClass name="Hospital">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="location" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="doctors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="permissions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="treatmentPlans" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="specialty" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ExaminationType">
      <eStructuralFeatures>
        <eAttribute name="typeName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Permission">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="examinationType" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TreatmentPlan">
      <eStructuralFeatures>
        <eAttribute name="problemDescription" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="createdAt" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="advisedExams" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Diagnosis" eSuperTypes="//@eClassifiers.8">
      <eStructuralFeatures>
        <eReference name="doctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="treatmentPlan" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActualTreatment" eSuperTypes="//@eClassifiers.8">
      <eStructuralFeatures>
        <eAttribute name="notes" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="diagnosis" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="advisedExams" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="additionalActions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MedicalActionBase">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
