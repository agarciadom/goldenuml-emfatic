@namespace(uri="http://example.com/hospitaldomain", prefix="hosp")
package HospitalDomain;

import "http://www.eclipse.org/emf/2002/Ecore";

class Hospital {
	attr ecore.EString[1] name;
	attr ecore.EString location;
	val Doctor[*] doctors;
	val Permission[*] permissions;
	val TreatmentPlan[*] treatmentPlans;
}

class Doctor {
	attr ecore.EString[1] name;
	attr ecore.EString specialty;
}

class Patient {
	attr ecore.EString[1] name;
	attr ecore.EDate birthDate;
}

class ExaminationType {
	attr ecore.EString[1] typeName;
	attr ecore.EString description;
}

class Permission {
	attr ecore.EString[1] status;
	ref ExaminationType[1] examinationType;
}

class TreatmentPlan {
	attr ecore.EString[1] problemDescription;
	attr ecore.EDate createdAt;
	ref ExaminationType[*] advisedExams;
}

class Diagnosis extends MedicalActionBase {
	ref Doctor[1] doctor;
	ref Patient[1] patient;
	ref TreatmentPlan treatmentPlan;
}

class ActualTreatment extends MedicalActionBase {
	attr ecore.EString notes;
	ref Diagnosis[1] diagnosis;
	ref ExaminationType[*] advisedExams;
	val ExaminationType[*] additionalActions;
}

class MedicalActionBase {
}


