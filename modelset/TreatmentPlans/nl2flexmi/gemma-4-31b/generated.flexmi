<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalManagement" nsURI="http://www.example.org/hospital" nsPrefix="hm">
  <eClassifiers>
    <eClass name="Hospital">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="permittedExaminationTypes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="specialization" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="hospital" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ExaminationType">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Problem">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="standardTreatmentPlan" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TreatmentPlan">
      <eStructuralFeatures>
        <eAttribute name="planName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="advisedExaminations" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Diagnosis">
      <eStructuralFeatures>
        <eAttribute name="diagnosisDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="doctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="problem" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActualTreatment">
      <eStructuralFeatures>
        <eAttribute name="startDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="diagnosis" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="basedOnPlan" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="actions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MedicalAction">
      <eStructuralFeatures>
        <eAttribute name="actionDescription" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Examination" eSuperTypes="//@eClassifiers.8">
      <eStructuralFeatures>
        <eAttribute name="examinationDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="type" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="performedAt" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="prescribedBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
