@namespace(uri="http://www.example.org/hospital", prefix="hm")
package HospitalManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Hospital {
	attr ecore.EString[1] name;
	ref ExaminationType[*] permittedExaminationTypes;
}

class Doctor {
	attr ecore.EString[1] name;
	attr ecore.EString specialization;
	ref Hospital[1] hospital;
}

class Patient {
	attr ecore.EString[1] name;
}

class ExaminationType {
	attr ecore.EString[1] name;
}

class Problem {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	ref TreatmentPlan standardTreatmentPlan;
}

class TreatmentPlan {
	attr ecore.EString[1] planName;
	ref ExaminationType[*] advisedExaminations;
}

class Diagnosis {
	attr ecore.EDate[1] diagnosisDate;
	ref Doctor[1] doctor;
	ref Patient[1] patient;
	ref Problem[1] problem;
}

class ActualTreatment {
	attr ecore.EDate[1] startDate;
	attr ecore.EDate endDate;
	ref Diagnosis[1] diagnosis;
	ref TreatmentPlan basedOnPlan;
	val MedicalAction[*] actions;
}

class MedicalAction {
	attr ecore.EString[1] actionDescription;
}

class Examination extends MedicalAction {
	attr ecore.EDate[1] examinationDate;
	ref ExaminationType[1] type;
	ref Hospital[1] performedAt;
	ref Patient[1] patient;
	ref Doctor[1] prescribedBy;
}


