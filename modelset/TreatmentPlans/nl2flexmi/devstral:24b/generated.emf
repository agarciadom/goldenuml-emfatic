@namespace(uri="http://www.example.org/hospitalmanagement", prefix="hm")
package HospitalManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Hospital {
	attr ecore.EString[1] name;
	ref ExaminationType[*] examinationTypes;
}

class ExaminationType {
	attr ecore.EString[1] name;
}

class TreatmentPlan {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	ref ExaminationType[*] treatmentExaminations;
}

class Patient {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EDate dateOfBirth;
}

class Problem {
	attr ecore.EString[1] name;
	attr ecore.EString description;
}

class Doctor {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	ref Hospital[1] hospital;
}

class ActualTreatment {
	val Patient[1] patient;
	val Problem[1] problem;
	val Doctor[1] doctor;
	val Examination[*] treatments;
}

class CardiologicTest extends ExaminationType {
}

class Echography extends ExaminationType {
}

class Radiology extends ExaminationType {
}

class Scanner extends ExaminationType {
}

class NMRScan extends ExaminationType {
}

class Examination {
	ref ExaminationType[1] type;
}


