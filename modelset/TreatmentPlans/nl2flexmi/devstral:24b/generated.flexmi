<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalManagement" nsURI="http://www.example.org/hospitalmanagement" nsPrefix="hm">
  <eClassifiers>
    <eClass name="Hospital">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="examinationTypes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ExaminationType">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TreatmentPlan">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="treatmentExaminations" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Problem">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="hospital" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActualTreatment">
      <eStructuralFeatures>
        <eReference name="patient" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="problem" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="doctor" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="treatments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.12" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CardiologicTest" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Echography" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Radiology" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Scanner" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="NMRScan" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Examination">
      <eStructuralFeatures>
        <eReference name="type" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
