@namespace(uri="http://www.example.org/healthcareSystem", prefix="healthcareSystem")
package healthcareSystem;

class HealthcareSystem {
	val ProblemType[*] problemTypes;
	val Patient[*] patients;
	val Doctor[*] doctors;
	val Hospital[*] hospitals;
	val ExaminationType[*] examinationTypes;
}

class ProblemType {
	attr String type;
	val TreatmentPlan treatmentPlan;
	val Diagnosis[*] diagnoses;
}

class TreatmentPlan {
	val AdvisedExaminationType[*]#treatmentPlan advisedExaminationTypes;
	val Treatment[*]#treatmentPlan treatments;
}

class AdvisedExaminationType {
	ref TreatmentPlan#advisedExaminationTypes treatmentPlan;
	ref ExaminationType#advisedExaminationTypes examinationType;
	ref AdvisedExamination[*]#advisedExaminationType advisedExaminations;
}

class ExaminationType {
	attr String type;
	ref AdvisedExaminationType[*]#examinationType advisedExaminationTypes;
	ref Permission[*]#examinationType permissions;
}

class Diagnosis {
	val Treatment[*]#diagnosis treatments;
	ref Consultation#diagnoses consultation;
}

class Treatment {
	val AdvisedExamination[*]#treatment advisedExaminations;
	val FreeExamination[*]#treatment freeExaminations;
	ref Diagnosis#treatments diagnosis;
	ref TreatmentPlan#treatments treatmentPlan;
}

class AdvisedExamination {
	ref Permission#advisedExaminations permission;
	ref AdvisedExaminationType#advisedExaminations advisedExaminationType;
	ref Treatment#advisedExaminations treatment;
}

class FreeExamination {
	ref Permission#freeExaminations permission;
	ref Treatment#freeExaminations treatment;
}

class Permission {
	ref AdvisedExamination[*]#permission advisedExaminations;
	ref FreeExamination[*]#permission freeExaminations;
	ref ExaminationType#permissions examinationType;
	ref Hospital#permissions hospital;
}

class Consultation {
	ref Diagnosis[*]#consultation diagnoses;
	ref Affiliation#consultations affiliation;
	ref Patient#consultations patient;
}

class Patient {
	ref Consultation[*]#patient consultations;
}

class Affiliation {
	ref Consultation[*]#affiliation consultations;
	ref Doctor#affiliations doctor;
	ref Hospital#affiliations hospital;
}

class Doctor {
	val Affiliation[*]#doctor affiliations;
}

class Hospital {
	val Affiliation[*]#hospital affiliations;
	val Permission[*]#hospital permissions;
}


