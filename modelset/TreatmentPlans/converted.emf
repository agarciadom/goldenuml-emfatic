@namespace(uri="http://www.example.org/medicalSystem", prefix="medicalSystem")
package medicalSystem;

class ProblemType {
	attr String type;
	ref TreatmentPlan#problemType treatmentPlan;
	ref Diagnosis[*]#problemType diagnoses;
}

class TreatmentPlan {
	ref ProblemType[1]#treatmentPlan problemType;
	ref AdvisedExaminationType[*]#treatmentPlan advisedExaminationTypes;
	ref Treatment[*]#treatmentPlan treatments;
}

class AdvisedExaminationType {
	ref TreatmentPlan[1]#advisedExaminationTypes treatmentPlan;
	ref ExaminationType[1]#advisedExaminationTypes examinationType;
	ref AdvisedExamination[*]#advisedExaminationType advisedExaminations;
}

class ExaminationType {
	attr String type;
	ref AdvisedExaminationType[*]#examinationType advisedExaminationTypes;
	ref Permission[*]#examinationType permissions;
}

class Diagnosis {
	ref ProblemType[1]#diagnoses problemType;
	ref Treatment[*]#diagnosis treatments;
	ref Consultation[1]#diagnoses consultation;
}

class Treatment {
	ref TreatmentPlan[1]#treatments treatmentPlan;
	ref Diagnosis[1]#treatments diagnosis;
	ref AdvisedExamination[*]#treatment advisedExaminations;
	ref FreeExamination[*]#treatment freeExaminations;
}

class AdvisedExamination {
	ref AdvisedExaminationType[1]#advisedExaminations advisedExaminationType;
	ref Treatment[1]#advisedExaminations treatment;
	ref Permission[1]#advisedExaminations permission;
}

class Permission {
	ref AdvisedExamination[*]#permission advisedExaminations;
	ref FreeExamination[*]#permission freeExaminations;
	ref ExaminationType[1]#permissions examinationType;
	ref Hospital[1]#permissions hospital;
}

class Consultation {
	ref Diagnosis[*]#consultation diagnoses;
	ref Affiliation[1]#consultations affiliation;
	ref Patient[1]#consultations patient;
}

class FreeExamination {
	ref Treatment[1]#freeExaminations treatment;
	ref Permission[1]#freeExaminations permission;
}

class Patient {
	ref Consultation[*]#patient consultations;
}

class Affiliation {
	ref Consultation[*]#affiliation consultations;
	ref Doctor[1]#affiliations doctor;
	ref Hospital[1]#affiliations hospital;
}

class Doctor {
	ref Affiliation[*]#doctor affiliations;
}

class Hospital {
	ref Affiliation[*]#hospital affiliations;
	ref Permission[*]#hospital permissions;
}


