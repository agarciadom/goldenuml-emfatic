<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="hospitalSystem" nsURI="http://www.example.org/hospitalSystem" nsPrefix="hospitalSystem">

    <!-- Root container class -->
    <ecore:EClass name="HospitalSystem">
      <ecore:EReference xmi:id="_HospitalSystem_hospitals" name="hospitals" eType="#//Hospital" upperBound="-1" containment="true"/>
      <ecore:EReference xmi:id="_HospitalSystem_treatmentPlans" name="treatmentPlans" eType="#//TreatmentPlan" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Hospital class -->
    <ecore:EClass name="Hospital">
      <ecore:EAttribute xmi:id="_Hospital_name" name="name" eType="ecore:EString"/>
      <ecore:EReference xmi:id="_Hospital_permissions" name="permissions" eType="#//ExaminationType" upperBound="-1"/>
      <ecore:EReference xmi:id="_Hospital_affiliatedDoctors" name="affiliatedDoctors" eType="#//Doctor" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Doctor class -->
    <ecore:EClass name="Doctor">
      <ecore:EAttribute xmi:id="_Doctor_name" name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Patient class -->
    <ecore:EClass name="Patient">
      <ecore:EAttribute xmi:id="_Patient_name" name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Examination class -->
    <ecore:EClass name="Examination">
      <ecore:EReference xmi:id="_Examination_type" name="type" eType="#//ExaminationType" containment="false"/>
      <ecore:EAttribute xmi:id="_Examination_performedAtHospital" name="performedAtHospital" eType="#//Hospital"/>
    </ecore:EClass>

    <!-- Examination type class -->
    <ecore:EClass name="ExaminationType">
      <ecore:EAttribute xmi:id="_ExaminationType_name" name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Treatment plan class -->
    <ecore:EClass name="TreatmentPlan">
      <ecore:EAttribute xmi:id="_TreatmentPlan_problemDescription" name="problemDescription" eType="ecore:EString"/>
      <ecore:EReference xmi:id="_TreatmentPlan_advisedExaminations" name="advisedExaminations" eType="#//ExaminationType" upperBound="-1"/>
    </ecore:EClass>

    <!-- Actual treatment class -->
    <ecore:EClass name="ActualTreatment">
      <ecore:EAttribute xmi:id="_ActualTreatment_patientName" name="patientName" eType="ecore:EString"/>
      <ecore:EReference xmi:id="_ActualTreatment_treatmentPlan" name="treatmentPlan" eType="#//TreatmentPlan"/>
      <ecore:EReference xmi:id="_ActualTreatment_performedExaminations" name="performedExaminations" eType="#//Examination" upperBound="-1" containment="true"/>
    </ecore:EClass>

  </ecore:EPackage>
</xmi:XMI>
