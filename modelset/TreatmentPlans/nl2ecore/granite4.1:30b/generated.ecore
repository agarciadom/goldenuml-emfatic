<xmi:XMI xmlns:xmi="http://schema.omg.org/spec/XMI/20131001"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Ecore="http://www.eclipse.org/emf/2002/Ecore"
         xmi:version="2.0">
  <Ecore:EPackage xmi:id="_root" name="HospitalSystem">
    <!-- Hospital -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_Hospital" name="Hospital">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents a hospital that can hold permissions for examination types,
                                        manage treatment plans, and have doctors affiliated to it.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- name -->
        <Ecore:EAttribute xsi:type="Ecore:EAttribute" xmi:id="_Hospital_name"
                           name="name" type="Ecore:EString"/>
        <!-- doctors -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Hospital_doctors"
                           name="doctors" upper="-1" ordered="true"
                           type="_Doctor" containment="true"/>
        <!-- examinationPermissions -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Hospital_examinationPermissions"
                           name="examinationPermissions" upper="-1" ordered="true"
                           type="_ExaminationPermission" containment="true"/>
        <!-- treatmentPlans -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Hospital_treatmentPlans"
                           name="treatmentPlans" upper="-1" ordered="true"
                           type="_TreatmentPlan" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- Doctor -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_Doctor" name="Doctor">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents a medical doctor affiliated to a hospital,
                                        capable of diagnosing patients and defining actual treatments.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- name -->
        <Ecore:EAttribute xsi:type="Ecore:EAttribute" xmi:id="_Doctor_name"
                           name="name" type="Ecore:EString"/>
        <!-- hospital -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Doctor_hospital"
                           name="hospital" type="_Hospital"/>
        <!-- treatments -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Doctor_treatments"
                           name="treatments" upper="-1" ordered="true"
                           type="_Treatment" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- Patient -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_Patient" name="Patient">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents a patient who undergoes treatments and examinations.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- name -->
        <Ecore:EAttribute xsi:type="Ecore:EAttribute" xmi:id="_Patient_name"
                           name="name" type="Ecore:EString"/>
        <!-- treatments -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Patient_treatments"
                           name="treatments" upper="-1" ordered="true"
                           type="_Treatment" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- ExaminationType -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_ExaminationType" name="ExaminationType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents a distinct type of medical examination
                                        (e.g., cardiologic test, echography, radiology).</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- name -->
        <Ecore:EAttribute xsi:type="Ecore:EAttribute" xmi:id="_ExaminationType_name"
                           name="name" type="Ecore:EString"/>
        <!-- permissions (non‑containing) -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_ExaminationType_permissions"
                           name="permissions" upper="-1" ordered="true"
                           type="_ExaminationPermission" containment="false"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- ExaminationPermission -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_ExaminationPermission"
                       name="ExaminationPermission">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents a permission granted to a specific hospital
                                        for performing a particular type of examination.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- hospital -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_ExaminationPermission_hospital"
                           name="hospital" type="_Hospital"/>
        <!-- examinationType -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_ExaminationPermission_examinationType"
                           name="examinationType" type="_ExaminationType"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- Problem -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_Problem" name="Problem">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents a medical problem for which a standard treatment plan
                                        can be defined.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- name -->
        <Ecore:EAttribute xsi:type="Ecore:EAttribute" xmi:id="_Problem_name"
                           name="name" type="Ecore:EString"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- TreatmentPlan -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_TreatmentPlan" name="TreatmentPlan">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Defines a standard treatment plan for a specific medical problem,
                                        listing the advised types of examinations.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- problem -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_TreatmentPlan_problem"
                           name="problem" type="_Problem"/>
        <!-- advisedExaminations -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_TreatmentPlan_advisedExaminations"
                           name="advisedExaminations" upper="-1" ordered="true"
                           type="_ExaminationType" containment="true"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- Treatment -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_Treatment" name="Treatment">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Represents an actual treatment applied to a patient,
                                        which may follow or deviate from a standard treatment plan.</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- patient -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Treatment_patient"
                           name="patient" type="_Patient"/>
        <!-- doctor -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Treatment_doctor"
                           name="doctor" type="_Doctor"/>
        <!-- baseTreatmentPlan -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Treatment_baseTreatmentPlan"
                           name="baseTreatmentPlan" type="_TreatmentPlan"/>
        <!-- advisedExaminationsPerformed (via association class) -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Treatment_advisedExaminationsPerformed"
                           name="advisedExaminationsPerformed" upper="-1" ordered="true"
                           type="_PerformerExamination" containment="true"/>
        <!-- additionalActions (free‑form strings) -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_Treatment_additionalActions"
                           name="additionalActions" upper="-1" ordered="true">
          <eTypeParameters href="http://www.eclipse.org/emf/2003/XMLType#String"/>
        </Ecore:EReference>
      </eStructuralFeatures>
    </Ecore:EClassifier>

    <!-- PerformerExamination (association class) -->
    <Ecore:EClassifier xsi:type="Ecore:EClass" xmi:id="_PerformerExamination"
                       name="PerformerExamination">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="documentation">Links a performed examination within a treatment to the
                                        treatment, the examination type, and optionally the hosting hospital
                                        (if the exam is executed at another facility).</details>
      </eAnnotations>
      <eStructuralFeatures>
        <!-- treatment -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_PerformerExamination_treatment"
                           name="treatment" type="_Treatment"/>
        <!-- examinationType -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_PerformerExamination_examinationType"
                           name="examinationType" type="_ExaminationType"/>
        <!-- hostingHospital (optional) -->
        <Ecore:EReference xsi:type="Ecore:EReference" xmi:id="_PerformerExamination_hostingHospital"
                           name="hostingHospital" type="_Hospital"/>
      </eStructuralFeatures>
    </Ecore:EClassifier>
  </Ecore:EPackage>
</xmi:XMI>
