<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="hospital"
    nsURI="http://www.example.org/hospital"
    nsPrefix="hospital">

  <!-- Custom datatypes -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
      instanceClassName="java.time.LocalTime"/>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="HospitalSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospitals"
        eType="#//Hospital" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinationTypes"
        eType="#//ExaminationType" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatmentPlans"
        eType="#//TreatmentPlan" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patients"
        eType="#//Patient" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="problems"
        eType="#//Problem" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- ExaminationType: e.g. "cardiologic test", "echography", "radiology", "scanner", "NMR" -->
  <eClassifiers xsi:type="ecore:EClass" name="ExaminationType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Hospital -->
  <eClassifiers xsi:type="ecore:EClass" name="Hospital">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Doctors affiliated to this hospital -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="affiliatedDoctors"
        eType="#//Doctor" containment="true" upperBound="-1"
        eOpposite="#//Doctor/hospital"/>
    <!-- Permissions held by this hospital - containment side of association class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="permissions"
        eType="#//Permission" containment="true" upperBound="-1"
        eOpposite="#//Permission/hospital"/>
    <!-- Examinations performed at this hospital -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinations"
        eType="#//Examination" containment="true" upperBound="-1"
        eOpposite="#//Examination/performingHospital"/>
  </eClassifiers>

  <!-- Permission: association class between Hospital and ExaminationType -->
  <eClassifiers xsi:type="ecore:EClass" name="Permission">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="grantedDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="expiryDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- Back-reference to hospital (non-containment, opposite of Hospital.permissions) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospital"
        eType="#//Hospital" eOpposite="#//Hospital/permissions"/>
    <!-- Reference to examination type -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinationType"
        eType="#//ExaminationType"/>
  </eClassifiers>

  <!-- Doctor -->
  <eClassifiers xsi:type="ecore:EClass" name="Doctor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="specialization"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Hospital this doctor is affiliated to -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospital"
        eType="#//Hospital" eOpposite="#//Hospital/affiliatedDoctors"/>
    <!-- Diagnoses made by this doctor -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnoses"
        eType="#//Diagnosis" containment="true" upperBound="-1"
        eOpposite="#//Diagnosis/doctor"/>
  </eClassifiers>

  <!-- Patient -->
  <eClassifiers xsi:type="ecore:EClass" name="Patient">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateOfBirth"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- Diagnoses received by this patient -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnoses"
        eType="#//Diagnosis" upperBound="-1"
        eOpposite="#//Diagnosis/patient"/>
  </eClassifiers>

  <!-- Problem: a type of medical problem -->
  <eClassifiers xsi:type="ecore:EClass" name="Problem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Treatment plans defined for this problem -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatmentPlans"
        eType="#//TreatmentPlan" upperBound="-1"
        eOpposite="#//TreatmentPlan/problem"/>
  </eClassifiers>

  <!-- TreatmentPlan: standard plan per type of problem -->
  <eClassifiers xsi:type="ecore:EClass" name="TreatmentPlan">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The problem this plan addresses -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="problem"
        eType="#//Problem" eOpposite="#//Problem/treatmentPlans"/>
    <!-- Advised examination types in this plan -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminationTypes"
        eType="#//ExaminationType" upperBound="-1"/>
    <!-- Actual treatments derived from this plan -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="actualTreatments"
        eType="#//ActualTreatment" upperBound="-1"
        eOpposite="#//ActualTreatment/basedOnPlan"/>
  </eClassifiers>

  <!-- Diagnosis: a doctor identifies a problem for a patient and defines an actual treatment -->
  <eClassifiers xsi:type="ecore:EClass" name="Diagnosis">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="notes"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Doctor who made this diagnosis -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="doctor"
        eType="#//Doctor" eOpposite="#//Doctor/diagnoses"/>
    <!-- Patient being diagnosed -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="patient"
        eType="#//Patient" eOpposite="#//Patient/diagnoses"/>
    <!-- Problem identified -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="problem"
        eType="#//Problem"/>
    <!-- The actual treatment defined for this diagnosis -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="actualTreatment"
        eType="#//ActualTreatment" containment="true"
        eOpposite="#//ActualTreatment/diagnosis"/>
  </eClassifiers>

  <!-- ActualTreatment: the concrete treatment of a patient, possibly deviating from the plan -->
  <eClassifiers xsi:type="ecore:EClass" name="ActualTreatment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="notes"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- The treatment plan this actual treatment is based on -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="basedOnPlan"
        eType="#//TreatmentPlan" eOpposite="#//TreatmentPlan/actualTreatments"/>
    <!-- Back-reference to the diagnosis that triggered this treatment -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnosis"
        eType="#//Diagnosis" eOpposite="#//Diagnosis/actualTreatment"/>
    <!-- Medical actions in this treatment (mix of advised examinations and free actions) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="medicalActions"
        eType="#//MedicalAction" containment="true" upperBound="-1"
        eOpposite="#//MedicalAction/actualTreatment"/>
    <!-- Operation: compute divergence from the treatment plan -->
    <eOperations name="computeDivergence"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- MedicalAction: abstract base for things done in an actual treatment -->
  <eClassifiers xsi:type="ecore:EClass" name="MedicalAction" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Whether this action was part of the advised plan -->
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isAdvised"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <!-- Back-reference to the actual treatment -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="actualTreatment"
        eType="#//ActualTreatment" eOpposite="#//ActualTreatment/medicalActions"/>
  </eClassifiers>

  <!-- Examination: a concrete examination performed on a patient, a subtype of MedicalAction -->
  <eClassifiers xsi:type="ecore:EClass" name="Examination" eSuperTypes="#//MedicalAction">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="result"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="scheduledTime"
        eType="#//LocalTime"/>
    <!-- The type of examination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinationType"
        eType="#//ExaminationType"/>
    <!-- The hospital where this examination is performed -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="performingHospital"
        eType="#//Hospital" eOpposite="#//Hospital/examinations"/>
    <!-- The permission under which this examination is authorized -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="permission"
        eType="#//Permission"/>
    <!-- The doctor who requested this examination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="requestingDoctor"
        eType="#//Doctor"/>
  </eClassifiers>

  <!-- FreeAction: a freely chosen medical action not corresponding to any standard examination type -->
  <eClassifiers xsi:type="ecore:EClass" name="FreeAction" eSuperTypes="#//MedicalAction">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actionType"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="justification"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

</ecore:EPackage>
