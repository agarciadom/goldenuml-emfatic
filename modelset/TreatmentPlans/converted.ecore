<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="medicalSystem"
    nsURI="http://www.example.org/medicalSystem"
    nsPrefix="medicalSystem">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="MedicalSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="problemTypes"
        eType="#//ProblemType" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinationTypes"
        eType="#//ExaminationType" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patients"
        eType="#//Patient" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="doctors"
        eType="#//Doctor" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospitals"
        eType="#//Hospital" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="consultations"
        eType="#//Consultation" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- ProblemType -->
  <eClassifiers xsi:type="ecore:EClass" name="ProblemType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- ProblemType "1" - "0..1" TreatmentPlan -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatmentPlan"
        eType="#//TreatmentPlan" containment="true" upperBound="1"
        eOpposite="#//TreatmentPlan/problemType"/>
    <!-- ProblemType "1" - "0..*" Diagnosis -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnoses"
        eType="#//Diagnosis" containment="true" upperBound="-1"
        eOpposite="#//Diagnosis/problemType"/>
  </eClassifiers>

  <!-- TreatmentPlan -->
  <eClassifiers xsi:type="ecore:EClass" name="TreatmentPlan">
    <!-- Association class end: TreatmentPlan contains AdvisedExaminationType -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminationTypes"
        eType="#//AdvisedExaminationType" containment="true" upperBound="-1"
        eOpposite="#//AdvisedExaminationType/treatmentPlan"/>
    <!-- TreatmentPlan "1" - "0..*" Treatment (non-containment, Diagnosis is the container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatments"
        eType="#//Treatment" upperBound="-1"
        eOpposite="#//Treatment/treatmentPlan"/>
    <!-- Opposite back-reference to ProblemType -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="problemType"
        eType="#//ProblemType" eOpposite="#//ProblemType/treatmentPlan"/>
  </eClassifiers>

  <!-- AdvisedExaminationType (association class between TreatmentPlan and ExaminationType) -->
  <eClassifiers xsi:type="ecore:EClass" name="AdvisedExaminationType">
    <!-- Non-containment reference back to TreatmentPlan -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatmentPlan"
        eType="#//TreatmentPlan" eOpposite="#//TreatmentPlan/advisedExaminationTypes"/>
    <!-- Non-containment reference to ExaminationType -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinationType"
        eType="#//ExaminationType" eOpposite="#//ExaminationType/advisedExaminationTypes"/>
    <!-- AdvisedExaminationType "1" - "0..*" AdvisedExamination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminations"
        eType="#//AdvisedExamination" containment="true" upperBound="-1"
        eOpposite="#//AdvisedExamination/advisedExaminationType"/>
  </eClassifiers>

  <!-- ExaminationType -->
  <eClassifiers xsi:type="ecore:EClass" name="ExaminationType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Non-containment reference to AdvisedExaminationType (association class) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminationTypes"
        eType="#//AdvisedExaminationType" upperBound="-1"
        eOpposite="#//AdvisedExaminationType/examinationType"/>
    <!-- ExaminationType "1" - "0..*" Permission -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="permissions"
        eType="#//Permission" upperBound="-1"
        eOpposite="#//Permission/examinationType"/>
  </eClassifiers>

  <!-- Diagnosis -->
  <eClassifiers xsi:type="ecore:EClass" name="Diagnosis">
    <!-- Diagnosis "1" - "0..*" Treatment (Diagnosis is the container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatments"
        eType="#//Treatment" containment="true" upperBound="-1"
        eOpposite="#//Treatment/diagnosis"/>
    <!-- Opposite back-reference to ProblemType -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="problemType"
        eType="#//ProblemType" eOpposite="#//ProblemType/diagnoses"/>
    <!-- Opposite back-reference to Consultation -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="consultation"
        eType="#//Consultation" eOpposite="#//Consultation/diagnoses"/>
  </eClassifiers>

  <!-- Treatment -->
  <eClassifiers xsi:type="ecore:EClass" name="Treatment">
    <!-- Treatment "1" - "0..*" AdvisedExamination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminations"
        eType="#//AdvisedExamination" upperBound="-1"
        eOpposite="#//AdvisedExamination/treatment"/>
    <!-- Treatment "1" - "0..*" FreeExamination -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="freeExaminations"
        eType="#//FreeExamination" containment="true" upperBound="-1"
        eOpposite="#//FreeExamination/treatment"/>
    <!-- Back-reference to Diagnosis (container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnosis"
        eType="#//Diagnosis" eOpposite="#//Diagnosis/treatments"/>
    <!-- Non-containment back-reference to TreatmentPlan -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatmentPlan"
        eType="#//TreatmentPlan" eOpposite="#//TreatmentPlan/treatments"/>
  </eClassifiers>

  <!-- AdvisedExamination -->
  <eClassifiers xsi:type="ecore:EClass" name="AdvisedExamination">
    <!-- Opposite back-reference to AdvisedExaminationType (container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminationType"
        eType="#//AdvisedExaminationType"
        eOpposite="#//AdvisedExaminationType/advisedExaminations"/>
    <!-- AdvisedExamination "0..*" - "1" Permission -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="permission"
        eType="#//Permission" eOpposite="#//Permission/advisedExaminations"/>
    <!-- Non-containment back-reference to Treatment -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatment"
        eType="#//Treatment" eOpposite="#//Treatment/advisedExaminations"/>
  </eClassifiers>

  <!-- FreeExamination -->
  <eClassifiers xsi:type="ecore:EClass" name="FreeExamination">
    <!-- FreeExamination "0..*" - "1" Permission -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="permission"
        eType="#//Permission" eOpposite="#//Permission/freeExaminations"/>
    <!-- Back-reference to Treatment (container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatment"
        eType="#//Treatment" eOpposite="#//Treatment/freeExaminations"/>
  </eClassifiers>

  <!-- Permission -->
  <eClassifiers xsi:type="ecore:EClass" name="Permission">
    <!-- Permission "0..*" - "1" Hospital -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospital"
        eType="#//Hospital" eOpposite="#//Hospital/permissions"/>
    <!-- ExaminationType "1" - "0..*" Permission -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="examinationType"
        eType="#//ExaminationType" eOpposite="#//ExaminationType/permissions"/>
    <!-- AdvisedExamination "0..*" - "1" Permission (non-containment, AdvisedExaminationType is container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="advisedExaminations"
        eType="#//AdvisedExamination" upperBound="-1"
        eOpposite="#//AdvisedExamination/permission"/>
    <!-- FreeExamination "0..*" - "1" Permission (non-containment, Treatment is container) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="freeExaminations"
        eType="#//FreeExamination" upperBound="-1"
        eOpposite="#//FreeExamination/permission"/>
  </eClassifiers>

  <!-- Consultation -->
  <eClassifiers xsi:type="ecore:EClass" name="Consultation">
    <!-- Consultation "0..*" - "1" Affiliation -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="affiliation"
        eType="#//Affiliation" eOpposite="#//Affiliation/consultations"/>
    <!-- Consultation "0..*" - "1" Patient -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="patient"
        eType="#//Patient" eOpposite="#//Patient/consultations"/>
    <!-- Diagnosis "0..*" - "1" Consultation -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnoses"
        eType="#//Diagnosis" upperBound="-1"
        eOpposite="#//Diagnosis/consultation"/>
  </eClassifiers>

  <!-- Patient -->
  <eClassifiers xsi:type="ecore:EClass" name="Patient">
    <eStructuralFeatures xsi:type="ecore:EReference" name="consultations"
        eType="#//Consultation" upperBound="-1"
        eOpposite="#//Consultation/patient"/>
  </eClassifiers>

  <!-- Affiliation -->
  <eClassifiers xsi:type="ecore:EClass" name="Affiliation">
    <!-- Affiliation "0..*" - "1" Doctor -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="doctor"
        eType="#//Doctor" eOpposite="#//Doctor/affiliations"/>
    <!-- Affiliation "0..*" - "1" Hospital -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospital"
        eType="#//Hospital" eOpposite="#//Hospital/affiliations"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="consultations"
        eType="#//Consultation" upperBound="-1"
        eOpposite="#//Consultation/affiliation"/>
  </eClassifiers>

  <!-- Doctor -->
  <eClassifiers xsi:type="ecore:EClass" name="Doctor">
    <eStructuralFeatures xsi:type="ecore:EReference" name="affiliations"
        eType="#//Affiliation" containment="true" upperBound="-1"
        eOpposite="#//Affiliation/doctor"/>
  </eClassifiers>

  <!-- Hospital -->
  <eClassifiers xsi:type="ecore:EClass" name="Hospital">
    <eStructuralFeatures xsi:type="ecore:EReference" name="affiliations"
        eType="#//Affiliation" upperBound="-1"
        eOpposite="#//Affiliation/hospital"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="permissions"
        eType="#//Permission" containment="true" upperBound="-1"
        eOpposite="#//Permission/hospital"/>
  </eClassifiers>

</ecore:EPackage>
