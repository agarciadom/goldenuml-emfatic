<modelElement xmi:version="2.0" xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <packagedElement xsi:type="ecore:EPackage" name="HospitalHouseMD">
    <eClassifiers>
      <!-- Doctor -->
      <packagedElement xsi:type="ecore:EClass" name="Doctor">
        <eStructuralFeatures>
          <packagedElement xsi:type="ecore:EAttribute"
                            name="name"
                            eType="ecore:EString"/>
        </eStructuralFeatures>
        <eOperations>
          <packagedElement xsi:type="ecore:EOperation" name="approveDiagnosis">
            <eParameters>
              <packagedElement xsi:type="ecore:EParameter"
                                name="diagnosis"
                                eType="?"/>
            </eParameters>
          </packagedElement>
        </eOperations>
      </packagedElement>

      <!-- Patient -->
      <packagedElement xsi:type="ecore:EClass" name="Patient">
        <eStructuralFeatures>
          <packagedElement xsi:type="ecore:EAttribute"
                            name="name"
                            eType="ecore:EString"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="assignedDoctors"
                            eType="Doctor"
                            lowerBound="0"
                            upperBound="-1"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="diagnoses"
                            eType="Diagnosis"
                            lowerBound="0"
                            upperBound="-1"/>
        </eStructuralFeatures>
      </packagedElement>

      <!-- Diagnosis -->
      <packagedElement xsi:type="ecore:EClass" name="Diagnosis">
        <eStructuralFeatures>
          <packagedElement xsi:type="ecore:EAttribute"
                            name="description"
                            eType="ecore:EString"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="madeByDoctor"
                            eType="Doctor"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="patient"
                            eType="Patient"/>
        </eStructuralFeatures>
      </packagedElement>

      <!-- Illness -->
      <packagedElement xsi:type="ecore:EClass" name="Illness">
        <eStructuralFeatures>
          <packagedElement xsi:type="ecore:EAttribute"
                            name="name"
                            eType="ecore:EString"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="priorityScore"
                            eType="?"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="treatments"
                            eType="Treatment"
                            lowerBound="0"
                            upperBound="-1"/>
        </eStructuralFeatures>
      </packagedElement>

      <!-- Priority Score Enum -->
      <packagedElement xsi:type="ecore:EEnum" name="PriorityScore">
        <eLiterals>
          <packagedElement xsi:type="ecore:ELiteral" name="HIGH"/>
          <packagedElement xsi:type="ecore:ELiteral" name="LOW"/>
        </eLiterals>
      </packagedElement>

      <!-- Treatment -->
      <packagedElement xsi:type="ecore:EClass" name="Treatment">
        <eStructuralFeatures>
          <packagedElement xsi:type="ecore:EAttribute"
                            name="name"
                            eType="ecore:EString"/>
          <packagedElement xsi:type="ecore:EAttribute"
                            name="stage"
                            eType="ecore:EInt"/>
          <packagedElement xsi:type="ecore:EReference"
                            name="assignedToIllness"
                            eType="Illness"/>
        </eStructuralFeatures>
      </packagedElement>

    </eClassifiers>
  </packagedElement>
</modelElement>
