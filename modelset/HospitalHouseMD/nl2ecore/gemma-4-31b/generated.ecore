<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/Ecore/">
  <ePackage xmi:id="hospitalHouseMDPackage" name="HospitalHouseMD" nsURI="http://www.hospitalhousemd.org/model">
    
    <!-- Root Container -->
    <eClass xmi:id="hospitalHouseMDSystem" name="HospitalHouseMDSystem">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="systemPatients" name="patients" eType="patient"/>
        <eStructuralFeature xmi:id="systemDoctors" name="doctors" eType="doctor"/>
        <eStructuralFeature xmi:id="systemNurses" name="nurses" eType="nurse"/>
        <eStructuralFeature xmi:id="systemIllnesses" name="illnesses" eType="illness"/>
        <eStructuralFeature xmi:id="systemTreatmentDatabase" name="treatmentDatabase" eType="treatmentTemplate"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Enums -->
    <eEnum xmi:id="priorityScore" name="PriorityScore">
      <eLiterals>
        <eLiteral name="LOW"/>
        <eLiteral name="HIGH"/>
      </eLiterals>
    </eEnum>

    <eEnum xmi:id="treatmentStage" name="TreatmentStage">
      <eLiterals>
        <eLiteral name="STAGE_1"/>
        <eLiteral name="STAGE_2"/>
        <eLiteral name="STAGE_3"/>
      </eLiterals>
    </eEnum>

    <!-- Classes -->
    <eClass xmi:id="patient" name="Patient">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="patientName" name="name" eType="EString"/>
        <eStructuralFeature xmi:id="patientConsent" name="hasGivenConsent" eType="EBoolean"/>
        <eStructuralFeature xmi:id="patientDoctors" name="assignedDoctors" eType="doctor"/>
        <eStructuralFeature xmi:id="patientDiagnoses" name="diagnoses" eType="diagnosis"/>
      </eStructuralFeatures>
    </eClass>

    <eClass xmi:id="doctor" name="Doctor">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="doctorName" name="name" eType="EString"/>
        <eStructuralFeature xmi:id="doctorIsHead" name="isHeadDoctor" eType="EBoolean"/>
      </eStructuralFeatures>
      <eOperations>
        <eOperation xmi:id="opApproveDiagnosis" name="approveDiagnosis">
          <eParameters>
            <eParameter xmi:id="paramDiag" name="diagnosis" eType="diagnosis"/>
          </eParameters>
        </eOperation>
        <eOperation xmi:id="opDowngradeTreatment" name="downgradeTreatmentStage">
          <eParameters>
            <eParameter xmi:id="paramTreat" name="treatment" eType="appliedTreatment"/>
            <eParameter xmi:id="paramStage" name="targetStage" eType="treatmentStage"/>
          </eParameters>
        </eOperation>
      </eOperations>
    </eClass>

    <eClass xmi:id="nurse" name="Nurse">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="nurseName" name="name" eType="EString"/>
      </eStructuralFeatures>
    </eClass>

    <eClass xmi:id="illness" name="Illness">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="illnessName" name="name" eType="EString"/>
        <eStructuralFeature xmi:id="illnessPriority" name="priorityScore" eType="priorityScore"/>
        <eStructuralFeature xmi:id="illnessTreatments" name="possibleTreatments" eType="treatmentTemplate"/>
      </eStructuralFeatures>
    </eClass>

    <eClass xmi:id="treatmentTemplate" name="TreatmentTemplate">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="templateDesc" name="description" eType="EString"/>
        <eStructuralFeature xmi:id="templateIllness" name="associatedIllness" eType="illness"/>
      </eStructuralFeatures>
    </eClass>

    <eClass xmi:id="diagnosis" name="Diagnosis">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="diagPatient" name="patient" eType="patient"/>
        <eStructuralFeature xmi:id="diagDoctor" name="diagnosingDoctor" eType="doctor"/>
        <eStructuralFeature xmi:id="diagIllness" name="illness" eType="illness"/>
        <eStructuralFeature xmi:id="diagIsApproved" name="isApproved" eType="EBoolean"/>
        <eStructuralFeature xmi:id="diagApprovedBy" name="approvedBy" eType="doctor"/>
      </eStructuralFeatures>
    </eClass>

    <eClass xmi:id="appliedTreatment" name="AppliedTreatment">
      <eStructuralFeatures>
        <eStructuralFeature xmi:id="appTreatDiag" name="diagnosis" eType="diagnosis"/>
        <eStructuralFeature xmi:id="appTreatTemplate" name="treatmentTemplate" eType="treatmentTemplate"/>
        <eStructuralFeature xmi:id="appTreatStage" name="stage" eType="treatmentStage"/>
      </eStructuralFeatures>
    </eClass>

  </ePackage>
</xmi:XMI>
