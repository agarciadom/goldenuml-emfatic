@namespace(uri="hospital.housemd", prefix="hospital.housemd")
package HospitalHouseMD;

class SystemContainer {
	val Patient[*] patients;
	val Doctor[*] doctors;
	val Illness[*] illnesses;
}

class Patient {
	attr int ~id;
	attr String name;
	ref Doctor[*] doctors;
	attr boolean hasGivenConsent;
	val Diagnosis[*] diagnoses;
}

class Doctor {
	attr int ~id;
	attr String name;
}

class Illness {
	attr int ~id;
	attr String name;
	attr PriorityScore priorityScore;
}

enum PriorityScore {
	HIGH = 0;
	LOW = 0;
}

class Diagnosis {
	ref Patient patient;
	ref Doctor doctor;
	attr boolean approvedByHeadDoctor;
	val Treatment[*] treatments;
}

class Treatment {
	ref Diagnosis diagnosis;
	attr Stage stage;
}

enum Stage {
	STAGE_1 = 0;
	STAGE_2 = 0;
	STAGE_3 = 0;
}


