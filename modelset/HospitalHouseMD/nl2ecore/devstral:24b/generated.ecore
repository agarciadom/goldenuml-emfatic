<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="HospitalHouseMD" nsURI="hospital.housemd" nsPrefix="hospital.housemd" xmi:version="2.0">
    <!-- Root container class -->
    <eClassifiers xmi:type="ecore:EClass" name="SystemContainer">
      <eStructuralFeatures xmi:type="ecore:EReference" name="patients" upperBound="-1" eType="#//Patient" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="doctors" upperBound="-1" eType="#//Doctor" containment="true"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="illnesses" upperBound="-1" eType="#//Illness" containment="true"/>
    </eClassifiers>

    <!-- Patient class -->
    <eClassifiers xmi:type="ecore:EClass" name="Patient">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="doctors" upperBound="-1" eType="#//Doctor"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="hasGivenConsent" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="diagnoses" upperBound="-1" eType="#//Diagnosis" containment="true"/>
    </eClassifiers>

    <!-- Doctor class -->
    <eClassifiers xmi:type="ecore:EClass" name="Doctor">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eClassifiers>

    <!-- Illness class -->
    <eClassifiers xmi:type="ecore:EClass" name="Illness">
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="priorityScore" eType="#//PriorityScore"/>
    </eClassifiers>

    <!-- PriorityScore enum -->
    <eClassifiers xmi:type="ecore:EEnum" name="PriorityScore">
      <eLiterals name="HIGH"/>
      <eLiterals name="LOW"/>
    </eClassifiers>

    <!-- Diagnosis class -->
    <eClassifiers xmi:type="ecore:EClass" name="Diagnosis">
      <eStructuralFeatures xmi:type="ecore:EReference" name="patient" eType="#//Patient"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="doctor" eType="#//Doctor"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="approvedByHeadDoctor" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
      <eStructuralFeatures xmi:type="ecore:EReference" name="treatments" upperBound="-1" eType="#//Treatment" containment="true"/>
    </eClassifiers>

    <!-- Treatment class -->
    <eClassifiers xmi:type="ecore:EClass" name="Treatment">
      <eStructuralFeatures xmi:type="ecore:EReference" name="diagnosis" eType="#//Diagnosis"/>
      <eStructuralFeatures xmi:type="ecore:EAttribute" name="stage" eType="#//Stage"/>
    </eClassifiers>

    <!-- Stage enum -->
    <eClassifiers xmi:type="ecore:EEnum" name="Stage">
      <eLiterals name="STAGE_1"/>
      <eLiterals name="STAGE_2"/>
      <eLiterals name="STAGE_3"/>
    </eClassifiers>
  </ecore:EPackage>
</xmi:XMI>
