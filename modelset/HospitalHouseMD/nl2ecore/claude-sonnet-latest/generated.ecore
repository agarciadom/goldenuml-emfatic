<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="hospitalHouseMD"
    nsURI="http://www.hospitalHouseMD.com/metamodel"
    nsPrefix="hospitalHouseMD">

  <!-- Custom Datatypes -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
      instanceClassName="java.time.LocalTime"/>

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="PriorityScore">
    <eLiterals name="LOW" value="0"/>
    <eLiterals name="HIGH" value="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="TreatmentStage">
    <eLiterals name="STAGE_1" value="1"/>
    <eLiterals name="STAGE_2" value="2"/>
    <eLiterals name="STAGE_3" value="3"/>
  </eClassifiers>

  <!-- Root Container -->
  <eClassifiers xsi:type="ecore:EClass" name="HospitalSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="hospital"
        eType="#//HospitalHouseMD" containment="true"/>
  </eClassifiers>

  <!-- Hospital -->
  <eClassifiers xsi:type="ecore:EClass" name="HospitalHouseMD">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patients"
        eType="#//Patient" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="doctors"
        eType="#//Doctor" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nurses"
        eType="#//Nurse" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="illnesses"
        eType="#//Illness" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatments"
        eType="#//Treatment" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="headDoctor"
        eType="#//HeadDoctor"/>
  </eClassifiers>

  <!-- Doctor (abstract base) -->
  <eClassifiers xsi:type="ecore:EClass" name="Doctor" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="licenseNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedPatients"
        eType="#//Patient" upperBound="-1" eOpposite="#//Patient/assignedDoctors"/>
    <eOperations name="makeDiagnosis">
      <eParameters name="patient" eType="#//Patient"/>
      <eParameters name="illness" eType="#//Illness"/>
    </eOperations>
    <eOperations name="downgradeTreatment">
      <eParameters name="appliedTreatment" eType="#//AppliedTreatment"/>
      <eParameters name="targetStage" eType="#//TreatmentStage"/>
    </eOperations>
  </eClassifiers>

  <!-- HeadDoctor -->
  <eClassifiers xsi:type="ecore:EClass" name="HeadDoctor" eSuperTypes="#//Doctor">
    <eOperations name="approveDiagnosis">
      <eParameters name="diagnosis" eType="#//Diagnosis"/>
    </eOperations>
  </eClassifiers>

  <!-- Nurse -->
  <eClassifiers xsi:type="ecore:EClass" name="Nurse">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="monitoredPatients"
        eType="#//Patient" upperBound="-1"/>
    <eOperations name="checkPatient">
      <eParameters name="patient" eType="#//Patient"/>
    </eOperations>
  </eClassifiers>

  <!-- Patient -->
  <eClassifiers xsi:type="ecore:EClass" name="Patient">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="patientId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="consentGiven"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedDoctors"
        eType="#//Doctor" upperBound="-1" eOpposite="#//Doctor/assignedPatients"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnoses"
        eType="#//Diagnosis" containment="true" upperBound="-1"
        eOpposite="#//Diagnosis/patient"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="consentForm"
        eType="#//ConsentForm" containment="true"/>
    <eOperations name="signConsent">
      <eParameters name="form" eType="#//ConsentForm"/>
    </eOperations>
    <eOperations name="retractConsent"/>
  </eClassifiers>

  <!-- ConsentForm -->
  <eClassifiers xsi:type="ecore:EClass" name="ConsentForm">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="signed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="signedDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patient"
        eType="#//Patient"/>
  </eClassifiers>

  <!-- Illness -->
  <eClassifiers xsi:type="ecore:EClass" name="Illness">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priorityScore"
        eType="#//PriorityScore"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="availableTreatments"
        eType="#//Treatment" upperBound="-1"/>
    <eOperations name="changePriorityScore">
      <eParameters name="score" eType="#//PriorityScore"/>
    </eOperations>
  </eClassifiers>

  <!-- Treatment -->
  <eClassifiers xsi:type="ecore:EClass" name="Treatment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Diagnosis -->
  <eClassifiers xsi:type="ecore:EClass" name="Diagnosis">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="approved"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diagnosisDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patient"
        eType="#//Patient" eOpposite="#//Patient/diagnoses"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="doctor"
        eType="#//Doctor"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="illness"
        eType="#//Illness"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appliedTreatments"
        eType="#//AppliedTreatment" containment="true" upperBound="-1"
        eOpposite="#//AppliedTreatment/diagnosis"/>
  </eClassifiers>

  <!-- AppliedTreatment -->
  <eClassifiers xsi:type="ecore:EClass" name="AppliedTreatment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stage"
        eType="#//TreatmentStage"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="requiresHigherFollowUp"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="priorityUpgraded"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="treatment"
        eType="#//Treatment"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="diagnosis"
        eType="#//Diagnosis" eOpposite="#//Diagnosis/appliedTreatments"/>
    <eOperations name="upgradeStage">
      <eParameters name="targetStage" eType="#//TreatmentStage"/>
    </eOperations>
    <eOperations name="downgradeStage">
      <eParameters name="targetStage" eType="#//TreatmentStage"/>
    </eOperations>
    <eOperations name="priorityStageUpgrade"/>
  </eClassifiers>

</ecore:EPackage>
