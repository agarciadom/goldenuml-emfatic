@namespace(uri="http://www.hospitalHouseMD.com/metamodel", prefix="hospitalHouseMD")
package hospitalHouseMD;

datatype LocalTime : java.time.LocalTime;

enum PriorityScore {
	LOW = 0;
	HIGH = 1;
}

enum TreatmentStage {
	STAGE_1 = 1;
	STAGE_2 = 2;
	STAGE_3 = 3;
}

class HospitalSystem {
	val HospitalHouseMD hospital;
}

class HospitalHouseMD {
	attr String name;
	val Patient[*] patients;
	val Doctor[*] doctors;
	val Nurse[*] nurses;
	val Illness[*] illnesses;
	val Treatment[*] treatments;
	ref HeadDoctor headDoctor;
}

abstract class Doctor {
	op void makeDiagnosis(Patient patient, Illness illness);
	op void downgradeTreatment(AppliedTreatment appliedTreatment, TreatmentStage targetStage);
	attr String name;
	attr String licenseNumber;
	ref Patient[*]#assignedDoctors assignedPatients;
}

class HeadDoctor extends Doctor {
	op void approveDiagnosis(Diagnosis diagnosis);
}

class Nurse {
	op void checkPatient(Patient patient);
	attr String name;
	ref Patient[*] monitoredPatients;
}

class Patient {
	op void signConsent(ConsentForm form);
	op void retractConsent();
	attr String name;
	attr String patientId;
	attr boolean consentGiven;
	ref Doctor[*]#assignedPatients assignedDoctors;
	val Diagnosis[*]#patient diagnoses;
	val ConsentForm consentForm;
}

class ConsentForm {
	attr boolean signed;
	attr EDate signedDate;
	ref Patient patient;
}

class Illness {
	op void changePriorityScore(PriorityScore score);
	attr String name;
	attr String description;
	attr PriorityScore priorityScore;
	ref Treatment[*] availableTreatments;
}

class Treatment {
	attr String name;
	attr String description;
}

class Diagnosis {
	attr boolean approved;
	attr EDate diagnosisDate;
	ref Patient#diagnoses patient;
	ref Doctor doctor;
	ref Illness illness;
	val AppliedTreatment[*]#diagnosis appliedTreatments;
}

class AppliedTreatment {
	op void upgradeStage(TreatmentStage targetStage);
	op void downgradeStage(TreatmentStage targetStage);
	op void priorityStageUpgrade();
	attr TreatmentStage stage;
	attr boolean requiresHigherFollowUp;
	attr boolean priorityUpgraded;
	ref Treatment treatment;
	ref Diagnosis#appliedTreatments diagnosis;
}


