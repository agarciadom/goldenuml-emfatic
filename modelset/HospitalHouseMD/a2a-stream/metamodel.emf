@namespace(uri="http://www.example.org/HospitalHouseMD", prefix="p")
package HospitalHouseMD;

class Patient {
  attr String name;
  attr Integer ~id;
  val Diagnosis[*] diagnoses;
  ref Doctor headDoctor;
}
class Doctor {
  attr String name;
  attr Integer ~id;
  val Diagnosis[*] approvedDiagnoses;
  ref Patient[*] headPatients;
}
class Diagnosis {
  attr Date diagnosedDate;
  ref Doctor doctor;
  ref Patient patient;
  val Approval approval;
}
class Treatment {
  attr Integer stage;
  ref Illness illness;
  val ConsentForm[*] consentForms;
  ref Diagnosis[*] diagnoses;
}
class Illness {
  attr String name;
  attr String priorityScore;
  val Treatment[*] treatments;
}
class ConsentForm {
  attr Boolean isGiven;
}
class Approval {
  ref Doctor doctor;
  ref Diagnosis diagnosis;
}