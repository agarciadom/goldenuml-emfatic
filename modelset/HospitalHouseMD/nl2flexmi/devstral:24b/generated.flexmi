<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalHouseMD" nsURI="http://www.hospitalhousemd.org/HospitalHouseMD" nsPrefix="hhmd">
  <eClassifiers>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="treatmentsApplied" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="consentsGiven" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eReference name="patients" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="diagnosesMade" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Treatment">
      <eStructuralFeatures>
        <eAttribute name="stage" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="illnessAssociated" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="patientAssociated" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="consentForm" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Illness">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="priorityScore" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="possibleTreatments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ConsentForm">
      <eStructuralFeatures>
        <eAttribute name="signed" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Nurse">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="patientsChecked" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eAttribute name="patientsToFollowUp" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
