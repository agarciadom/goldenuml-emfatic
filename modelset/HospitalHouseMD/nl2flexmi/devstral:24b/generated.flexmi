<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalHouseMD" nsURI="http://www.hospitalhouse.com/model" nsPrefix="hhmd">
  <eClassifiers>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="age" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="doctors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="consent" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="specialty" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="patients" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="diagnoses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Diagnosis">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="illness" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="treatments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Treatment">
      <eStructuralFeatures>
        <eAttribute name="stage" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="consentRequired" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="priorityUpgrade" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="consent" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Illness">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="priorityScore" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Consent">
      <eStructuralFeatures>
        <eAttribute name="patientConsent" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PriorityScore">
      <eStructuralFeatures>
        <eAttribute name="score" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
