@namespace(uri="http://www.hospitalhouse.com/model", prefix="hhmd")
package HospitalHouseMD;

import "http://www.eclipse.org/emf/2002/Ecore";

class Patient {
	attr ecore.EString[1] name;
	attr ecore.EInt age;
	ref Doctor[*] doctors;
	val Consent consent;
}

class Doctor {
	attr ecore.EString[1] name;
	attr ecore.EString specialty;
	ref Patient[*] patients;
	val Diagnosis[*] diagnoses;
}

class Diagnosis {
	attr ecore.EDate[1] date;
	ref Illness[1] illness;
	val Treatment[*] treatments;
}

class Treatment {
	attr ecore.EInt[1] stage;
	attr ecore.EBoolean consentRequired;
	attr ecore.EBoolean priorityUpgrade;
	ref Consent consent;
}

class Illness {
	attr ecore.EString[1] name;
	ref PriorityScore[1] priorityScore;
}

class Consent {
	attr ecore.EBoolean patientConsent;
}

class PriorityScore {
	attr ecore.EInt[1] score;
}


