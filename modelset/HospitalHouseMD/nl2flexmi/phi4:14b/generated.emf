@namespace(uri="http://www.example.org/hospitalhousemd", prefix="hmd")
package HospitalHouseMD;

import "http://www.eclipse.org/emf/2002/Ecore";

class Patient {
	attr ecore.EString[1] name;
	val Patient[*] treatments;
}

class Doctor extends Illness {
	ref Patient[*] assignedPatients;
}

class Illness {
	attr ecore.EString[1] name;
	attr ecore.EString priorityScore;
	ref Patient[*] possibleTreatments;
}

class Treatment {
	attr ecore.EString[1] name;
	attr ecore.EInt treatmentStage;
	ref Patient[1] patient;
}


