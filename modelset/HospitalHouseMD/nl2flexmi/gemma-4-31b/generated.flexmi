<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HospitalHouseMD" nsURI="http://www.hospitalhousemd.org" nsPrefix="hhmd">
  <eClassifiers>
    <eClass name="Hospital">
      <eStructuralFeatures>
        <eReference name="doctors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="nurses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="patients" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="illnessDatabase" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HeadDoctor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Nurse">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="assignedDoctors" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="consentForms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Illness">
      <eStructuralFeatures>
        <eAttribute name="priorityScore" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="possibleTreatments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Diagnosis">
      <eStructuralFeatures>
        <eAttribute name="diagnosisDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="diagnosingDoctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="illness" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="approvingHeadDoctor" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Treatment">
      <eStructuralFeatures>
        <eAttribute name="stage" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="treatmentName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="appliedToDiagnosis" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ConsentForm">
      <eStructuralFeatures>
        <eAttribute name="isSigned" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="signatureDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
