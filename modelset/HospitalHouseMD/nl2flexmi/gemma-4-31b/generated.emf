@namespace(uri="http://www.hospitalhousemd.org", prefix="hhmd")
package HospitalHouseMD;

import "http://www.eclipse.org/emf/2002/Ecore";

class Hospital {
	val Doctor[*] doctors;
	val Nurse[*] nurses;
	val Patient[*] patients;
	val Illness[*] illnessDatabase;
}

class Doctor {
	attr ecore.EString[1] name;
}

class HeadDoctor extends Doctor {
}

class Nurse {
	attr ecore.EString[1] name;
}

class Patient {
	attr ecore.EString[1] name;
	ref Doctor[+] assignedDoctors;
	val ConsentForm[*] consentForms;
}

class Illness {
	attr ecore.EString[1] priorityScore;
	val Treatment[*] possibleTreatments;
}

class Diagnosis {
	attr ecore.EDate[1] diagnosisDate;
	ref Patient[1] patient;
	ref Doctor[1] diagnosingDoctor;
	ref Illness[1] illness;
	ref HeadDoctor approvingHeadDoctor;
}

class Treatment {
	attr ecore.EInt[1] stage;
	attr ecore.EString[1] treatmentName;
	ref Diagnosis[1] appliedToDiagnosis;
}

class ConsentForm {
	attr ecore.EBoolean[1] isSigned;
	attr ecore.EDate signatureDate;
}


