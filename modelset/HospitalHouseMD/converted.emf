@namespace(uri="http://www.example.org/medicalSystem", prefix="medicalSystem")
package medicalSystem;

class MedicalSystem {
	val Patient[*] patients;
	val Doctor[*] doctors;
	val Illness[*] illnesses;
	val Treatment[*] treatments;
}

class Patient {
	attr Boolean consent;
	val Diagnosis[*]#patient diagnoses;
}

class Doctor {
	ref Diagnosis[*]#doctor diagnoses;
}

class Diagnosis {
	op int upgradeStage();
	op int downgradeStage();
	op int priorityUpgrade();
	attr int stage;
	ref Patient#diagnoses patient;
	ref Doctor#diagnoses doctor;
	ref Illness#diagnoses illness;
	val AppliedTreatment[*]#diagnosis appliedTreatments;
}

class Illness {
	attr String priority;
	ref Diagnosis[*]#illness diagnoses;
	ref Treatment[*]#illness treatments;
}

class Treatment {
	ref Illness#treatments illness;
	ref AppliedTreatment[*]#treatment appliedTreatments;
}

class AppliedTreatment {
	ref Diagnosis#appliedTreatments diagnosis;
	ref Treatment#appliedTreatments treatment;
}


