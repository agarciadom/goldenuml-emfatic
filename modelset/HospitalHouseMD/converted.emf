@namespace(uri="http://www.example.org/medicalPackage", prefix="medicalPackage")
package medicalPackage;

class Patient {
	attr boolean Consent;
	ref Diagnosis[*]#patient diagnoses;
}

class Doctor {
	ref Diagnosis[*]#doctor diagnoses;
}

class Diagnosis {
	op int upgradeStage();
	op int downgradeStage();
	op int priorityUpgrade();
	attr int Stage;
	ref Patient[1]#diagnoses patient;
	ref Doctor[1]#diagnoses doctor;
	ref Illness[1]#diagnoses illness;
	ref AppliedTreatment[*]#diagnosis appliedTreatments;
}

class Illness {
	attr String Priority;
	ref Diagnosis[*]#illness diagnoses;
	ref Treatment[*]#illness treatments;
}

class Treatment {
	ref Illness[1]#treatments illness;
	ref AppliedTreatment[*]#treatment appliedTreatments;
}

class AppliedTreatment {
	ref Diagnosis[1]#appliedTreatments diagnosis;
	ref Treatment[1]#appliedTreatments treatment;
}


