<modelElement xmi:version="2.0" xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
              xmlns:Ecore="org.eclipse.emf.ecore#//Ecore">
  <eClassifiers>
    <!-- Root container -->
    <eClass name="Model"/>
    
    <!-- Core classes -->
    <eClass name="Kinepolis">
      <eStructuralFeatures>
        <eAttribute name="name" eType="string"/>
        <eReference name="cinemas" eType="#//Cinema"
                    containment="true" lowerBound="0" upperBound="-1"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Cinema">
      <eStructuralFeatures>
        <eAttribute name="name" eType="string"/>
        <eAttribute name="town" eType="string"/>
        <eReference name="theatres" eType="#//Theatre"
                    containment="true" lowerBound="0" upperBound="-1"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Theatre">
      <eStructuralFeatures>
        <eAttribute name="name" eType="string"/>
        <eAttribute name="seatCount" eType="int"/>
        <eReference name="shows" eType="#//Show"
                    containment="true" lowerBound="0" upperBound="-1"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Movie">
      <eStructuralFeatures>
        <eAttribute name="title" eType="string"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Show">
      <eStructuralFeatures>
        <eReference name="theatre" eType="#//Theatre"
                    lowerBound="1" upperBound="1"/>
        <eReference name="movie" eType="#//Movie"
                    lowerBound="1" upperBound="1"/>
        <eAttribute name="startTime" eType="LocalTime"/>
        <eReference name="reservations" eType="#//Reservation"
                    containment="true" lowerBound="0" upperBound="-1"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Reservation">
      <eStructuralFeatures>
        <eReference name="show" eType="#//Show"
                    lowerBound="1" upperBound="1"/>
        <eAttribute name="seatNumber" eType="int"/>
        <eAttribute name="creditCardInfo" eType="string"/>
        <eAttribute name="reservedAt" eType="Instant"/>
        <eReference name="offer" eType="#//ShowOffer"
                    lowerBound="0" upperBound="1" containment="false"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="ShowOffer">
      <eStructuralFeatures>
        <eReference name="originalReservation" eType="#//Reservation"
                    lowerBound="1" upperBound="1" containment="false"/>
        <eReference name="newShow" eType="#//Show"
                    lowerBound="0" upperBound="1" containment="false"/>
        <eAttribute name="expiresAt" eType="Instant"/>
        <eAttribute name="accepted" eType="boolean" defaultValue="false"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Ecore primitive types -->
    <eDataType name="string" instanceClassName="java.lang.String"/>
    <eDataType name="int"   instanceClassName="int"/>
    <eDataType name="boolean" instanceClassName="boolean"/>

    <!-- Java Time types (custom datatypes) -->
    <eDataType name="LocalTime"  instanceClassName="java.time.LocalTime"/>
    <eDataType name="Instant"    instanceClassName="java.time.Instant"/>
    
  </eClassifiers>
</modelElement>
