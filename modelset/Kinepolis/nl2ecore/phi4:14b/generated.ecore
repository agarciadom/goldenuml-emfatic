<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.1"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
    
    <!-- Define LocalTimeType EDataType -->
    <eClassifiers xsi:type="ecore:EDataType" name="LocalTimeType"/>
    
    <eClassifiers xsi:type="ecore:EClass" name="SystemRoot">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            lower="-1" upper="-1"
            eOpposite="_LocatedIn_Cinema"
            target="_Cinema"/>
    </eClassifiers>
    
    <!-- Cinema contains name, Theatres, and MovieCopies (non-contain) -->
    <eClassifiers xsi:type="ecore:EClass" name="Cinema">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            multiple="true"
            eOpposite="_LocatedIn_Cinema"
            target="_Theatre"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            multiple="true"
            eOpposite="_Owned_By_Cinema"
            target="_MovieCopy"/>  
    </eClassifiers>
    
    <!-- Theatre is contained by Cinema, organizes Shows -->
    <eClassifiers xsi:type="ecore:EClass" name="Theatre">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            lower="1" upper="1"
            target="_Cinema"
            eOpposite="_LocatedIn_Cinema"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            multiple="true"
            containment="false"
            target="_Show"
            eOpposite="_Scheduled_In_Theatre"/>
    </eClassifiers>
    
    <!-- Movie is linked by Ownership to Cinemas -->
    <eClassifiers xsi:type="ecore:EClass" name="Movie">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="title"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            multiple="true"
            eOpposite="_Owned_By_Cinema"
            target="_Cinema"/>

    </eClassifiers>
    
    <!-- Show contains Schedule information, linked to Reservations -->
    <eClassifiers xsi:type="ecore:EClass" name="Show">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="startDate" eType="_EDate.eDataType"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            multiple="true"
            containment="false"
            target="_Reservation"
            eOpposite="_Reserved_Show"/> 
    </eClassifiers>
    
    <!-- Reservation is linked to a single Show with timing details -->
    <eClassifiers xsi:type="ecore:EClass" name="Reservation">
        <eStructuralFeatures xsi:type="ecore:EAttribute"
            name="reservationTime" eType="_LocalTimeType.eDataType"/> 
        <eStructuralFeatures xsi:type="ecore:EReference"
            lower="1" upper="1"
            containment="false"
            target="_Show"
            eOpposite="_Reserved_Show"/>
    </eClassifiers>
    
    <!-- Ticket linked to a Show (no seat info needed) -->
    <eClassifiers xsi:type="ecore:EClass" name="Ticket">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            lower="1" upper="1"
            target="_Show"
            eOpposite="_IssuedIn_Show"/>
    </eClassifiers>

    <!-- Seat has a potential link to Reservation -->
    <eClassifiers xsi:type="ecore:EClass" name="Seat">
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="number"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            lower="0" upper="1"
            target="_Reservation"
            eOpposite="_Reserved_For_Reservation"/>
    </eClassifiers>
    
    <!-- Association: Cinema to Theatre -->
    <eClassifiers xsi:type="ecore:EClass" name="LocatedIn_Cinema">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            lower="1" upper="1"
            eOpposite="_Theatre"
            target="_Cinema"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            eOpposite="_LocatedIn_Cinema"
            target="_Theatre"/> 
    </eClassifiers>

    <!-- Association: Theatre to Show -->
    <eClassifiers xsi:type="ecore:EClass" name="Scheduled_In_Theatre">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            eOpposite="_Show"
            target="_Theatre"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            target="_Show"/> 
    </eClassifiers>
    
    <!-- Association: Cinema to MovieCopy -->
    <eClassifiers xsi:type="ecore:EClass" name="Owned_By_Cinema">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            lower="1" upper="1"
            eOpposite="_Cinema"
            target="_MovieCopy"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            target="_Cinema"/> 
    </eClassifiers>

    <!-- Association: Show to Reservation -->
    <eClassifiers xsi:type="ecore:EClass" name="Reserved_Show">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            eOpposite="_Reservation"
            target="_Show"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            lower="1" upper="-1"
            target="_Reservation"/> 
    </eClassifiers>

    <!-- Association: Show to Ticket -->
    <eClassifiers xsi:type="ecore:EClass" name="IssuedIn_Show">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            eOpposite="_Ticket"
            target="_Show"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            lower="1" upper="1"
            target="_Ticket"/> 
    </eClassifiers>

    <!-- Association: Seat to Reservation -->
    <eClassifiers xsi:type="ecore:EClass" name="Reserved_For_Reservation">
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="false"
            eOpposite="_Seat"
            target="_Reservation"/>
        <eStructuralFeatures xsi:type="ecore:EReference"
            containment="true"
            lower="0" upper="1"
            target="_Seat"/> 
    </eClassifiers>
    
</ecore:EPackage>
