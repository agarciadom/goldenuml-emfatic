@namespace(uri="http://www.kinepolis.com/metamodel", prefix="kinepolis")
package kinepolis;

datatype LocalTime : java.time.LocalTime;

enum ReservationStatus {
	PENDING = 0;
	CONFIRMED = 0;
	CANCELLED = 0;
}

enum OfferStatus {
	PENDING = 0;
	ACCEPTED = 0;
	DECLINED = 0;
	EXPIRED = 0;
}

enum ShowStatus {
	SCHEDULED = 0;
	PUBLISHED = 0;
	CANCELLED = 0;
}

class KinepolisSystem {
	val Cinema[*] cinemas;
	val Movie[*] movies;
	val Customer[*] customers;
	val WeeklyProgram[*] weeklyPrograms;
}

class Cinema {
	attr String name;
	attr String town;
	val Theatre[*] theatres;
	val Copy[*] copies;
}

class Theatre {
	op int getAvailableSeats(Show show);
	attr String name;
	attr int totalSeats;
	val Seat[*] seats;
	val Show[*] shows;
}

class Seat {
	attr String seatNumber;
	attr String row;
}

class Movie {
	attr String title;
	attr int durationMinutes;
}

class Copy {
	attr String copyId;
	ref Movie movie;
}

class WeeklyProgram {
	attr EDate publishedOn;
	attr EDate validFrom;
	attr EDate validUntil;
}

class Show {
	op void cancel();
	op int getAvailableSeatCount();
	attr EDate date;
	attr LocalTime startTime;
	attr ShowStatus status;
	ref Copy copy;
	ref WeeklyProgram weeklyProgram;
	val SeatReservation[*] seatReservations;
	val Ticket[*] tickets;
}

class Customer {
	attr String firstName;
	attr String lastName;
	attr String email;
	attr String address;
	val CreditCard creditCard;
	ref SeatReservation[*] seatReservations;
	val FreeTicket[*] freeTickets;
}

class CreditCard {
	op void debit(double amount);
	attr String cardNumber;
	attr String holderName;
	attr EDate expiryDate;
}

class SeatReservation {
	op void cancel();
	op void debitCreditCard();
	attr String reservationId;
	attr EDate reservationTime;
	attr ReservationStatus status;
	attr double price;
	ref Seat seat;
	ref Customer customer;
	val AlternativeOffer alternativeOffer;
}

class AlternativeOffer {
	op void accept();
	op void decline();
	attr OfferStatus offerStatus;
	attr EDate expiryTime;
	ref Show offeredShow;
	ref Seat offeredSeat;
}

class Ticket {
	attr String ticketId;
	attr double price;
	attr EDate issuedAt;
	ref Seat seat;
}

class FreeTicket {
	attr String ticketCode;
	attr EDate issuedDate;
	attr boolean sentHome;
	ref SeatReservation originalReservation;
}


