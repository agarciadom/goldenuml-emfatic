@namespace(uri="http://www.kinepolis.com", prefix="p")
package Kinepolis;

class Cinema {
  attr String name;
  attr String town;
  val Theatre[*] theatres;
  val MovieCopy[*] movieCopies;
}
class Theatre {
  attr Integer number;
  val Show[*] shows;
  val Ticket[*] tickets;
}
class MovieCopy {
  attr String movieTitle;
}
class Show {
  attr DateTime startTime;
  attr DateTime endTime;
  attr Boolean published;
  attr Boolean cancellationAllowed;
  attr Integer availableSeats;
  val Reservation[*] reservations;
  ref Theatre theatre;
  ref MovieCopy movieCopy;
}
class Reservation {
  attr String customerName;
  attr DateTime reservationTime;
  attr DateTime cancellationDeadline;
  attr Integer seatNumber;
  attr Boolean paid;
  attr Boolean cancellationAllowed;
  val AlternativeSeatOffer[*] alternativeOffers;
  ref Customer customer;
}
class Customer {
  attr String creditCardNumber;
  attr String name;
}
class AlternativeSeatOffer {
  attr DateTime expirationTime;
  ref Show show;
  ref Reservation reservation;
}
class Ticket {
  ref Show show;
}

@namespace(uri="http://www.kinepolis.com/datatypes", prefix="p")
package DataTypes;