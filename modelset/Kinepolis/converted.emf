@namespace(uri="http://www.example.org/cinema", prefix="cinema")
package cinema;

class CinemaSystem {
	val Cinema[*] cinemas;
	val Movie[*] movies;
	val Customer[*] customers;
}

class Cinema {
	attr String name;
	attr String city;
	val Theatre[*] theatres;
	val CopyLocation[*] copyLocations;
}

class Theatre {
	attr int number;
	val Seat[*] seats;
	val Show[*] shows;
}

class Movie {
	attr String title;
	attr int durationMinutes;
	val MovieCopy[*] movieCopies;
}

class MovieCopy {
	attr int ~id;
	ref CopyLocation[*] copyLocations;
}

class CopyLocation {
	attr EDate startDate;
	attr EDate endDate;
	ref Show[*] shows;
}

class Seat {
	attr int seatNumber;
	val Ticket[*] tickets;
	ref OnlineTicket[*] onlineTickets;
	ref AlternativeOffer[*] alternativeOffers;
}

class Show {
	op void publish();
	op void cancelShow();
	attr EDate startTime;
	attr EDate endTime;
	ref Ticket[*] tickets;
	ref OnlineTicket[*] onlineTickets;
	ref AlternativeOffer[*] alternativeOffers;
}

class Ticket {
	attr int ticketId;
	attr float price;
	ref Show[1] show;
}

class Customer {
	attr String name;
	attr int customerId;
	val OnlineTicket[*] onlineTickets;
}

class OnlineTicket {
	op void cancelReservationCustomer();
	op void cancelReservationKinepolis();
	attr int onlineTicketId;
	attr float price;
	ref Seat[1] seat;
	ref Show[1] show;
	val AlternativeOffer alternativeOffer;
}

class AlternativeOffer {
	op void accept();
	op void decline();
	op void expire();
	op void refund();
	attr int alternativeOfferId;
	ref Seat[1] seat;
	ref Show[1] show;
}


