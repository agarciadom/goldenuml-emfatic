@namespace(uri="http://www.example.org/cinema", prefix="cinema")
package cinema;

class Cinema {
	attr String Name;
	attr String City;
	ref Theatre[*]#cinema theatres;
	ref CopyLocation[*]#cinema copyLocations;
}

class Theatre {
	attr int Number;
	ref Cinema[1]#theatres cinema;
	ref Seat[*]#theatre seats;
	ref Show[*]#theatre shows;
}

class Movie {
	attr String Title;
	attr int durationMinutes;
	ref MovieCopy[*]#movie movieCopies;
}

class MovieCopy {
	attr int Id;
	ref Movie[1]#movieCopies movie;
	ref CopyLocation[*]#movieCopy copyLocations;
}

class CopyLocation {
	attr String StartDate;
	attr String EndDate;
	ref Cinema[1]#copyLocations cinema;
	ref MovieCopy[1]#copyLocations movieCopy;
	ref Show[*]#copyLocation shows;
}

class Seat {
	attr int SeatNumber;
	ref Theatre[1]#seats theatre;
	ref Ticket[*]#seat tickets;
	ref OnlineTicket[*]#seat onlineTickets;
	ref AlternativeOffer[*]#seat alternativeOffers;
}

class Show {
	op void publish();
	op void cancelShow();
	attr String StartTime;
	attr String EndTime;
	ref Theatre[1]#shows theatre;
	ref CopyLocation[1]#shows copyLocation;
	ref Ticket[*]#show tickets;
	ref OnlineTicket[*]#show onlineTickets;
	ref AlternativeOffer[*]#show alternativeOffers;
}

class Ticket {
	attr int TicketId;
	attr float Price;
	ref Seat[1]#tickets seat;
	ref Show[1]#tickets show;
}

class Customer {
	attr String Name;
	attr int CustomerId;
	ref OnlineTicket[*]#customer onlineTickets;
}

class OnlineTicket {
	op void cancelReservationCustomer();
	op void cancelReservationKinepolis();
	attr int OnlineTicketId;
	attr float Price;
	ref Customer[1]#onlineTickets customer;
	ref Seat[1]#onlineTickets seat;
	ref Show[1]#onlineTickets show;
	ref AlternativeOffer#onlineTicket alternativeOffer;
}

class AlternativeOffer {
	op void accept();
	op void decline();
	op void expire();
	op void refund();
	attr int AlternativeOfferId;
	ref OnlineTicket[1]#alternativeOffer onlineTicket;
	ref Seat[1]#alternativeOffers seat;
	ref Show[1]#alternativeOffers show;
}


