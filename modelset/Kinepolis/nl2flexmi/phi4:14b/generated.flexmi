<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CinemaManagement" nsURI="http://www.example.com/CinemaManagement" nsPrefix="cinema">
  <eClassifiers>
    <eClass name="Kinepolis">
      <eStructuralFeatures>
        <eReference name="cinemas" containment="False" lowerBound="1" upperBound="1000" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cinema">
      <eStructuralFeatures>
        <eReference name="theatres" containment="False" lowerBound="1" upperBound="1000" eType="//@eClassifiers.2" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Theatre">
      <eStructuralFeatures>
        <eReference name="shows" containment="False" lowerBound="1" upperBound="1000" eType="//@eClassifiers.4" />
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MovieCopy">
      <eStructuralFeatures>
        <eReference name="location" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show">
      <eStructuralFeatures>
        <eReference name="movieCopies" containment="False" lowerBound="1" upperBound="1000" eType="//@eClassifiers.3" />
        <eReference name="reservations" containment="False" lowerBound="0" upperBound="1000" eType="//@eClassifiers.5" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="DateTime" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="DateTime" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Reservation">
      <eStructuralFeatures>
        <eAttribute name="customerID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="paymentStatus" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="cancellationStatus" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
