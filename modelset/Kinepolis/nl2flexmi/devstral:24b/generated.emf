@namespace(uri="http://www.kinepolis.com/model", prefix="kine")
package Kinepolis;

import "http://www.eclipse.org/emf/2002/Ecore";

class Cinema {
	attr ecore.EString[1] name;
	ref Theatre[*] theatres;
}

class Theatre {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] seatCount;
	val Show[*] shows;
}

class Movie {
	attr ecore.EString[1] title;
	attr ecore.EInt[1] duration;
}

class Copy {
	attr ecore.EString[1] ~id;
	ref Movie[1] movie;
}

class Show {
	attr ecore.EDate[1] startTime;
	attr ecore.EDate[1] endTime;
	val Copy[1] copy;
	ref Reservation[*] reservations;
}

class Reservation {
	attr ecore.EString[1] ~id;
	attr ecore.EBoolean isCancelled;
}

class Ticket {
	attr ecore.EInt[1] number;
	attr ecore.EString[1] seatNumber;
}


