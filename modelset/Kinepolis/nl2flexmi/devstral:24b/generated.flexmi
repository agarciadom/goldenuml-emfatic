<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="KinepolisCinema" nsURI="http://www.kinepolis.com/cinema" nsPrefix="kc">
  <eClassifiers>
    <eClass name="Cinema">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="theatres" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="movieCopies" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Theatre">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="seatCount" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="cinema" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="shows" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="theatre" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="movieCopy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MovieCopy">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="movieTitle" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Reservation">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="customerName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="creditCardNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="show" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
