@namespace(uri="http://www.kinepolis.com/model", prefix="kine")
package Kinepolis;

import "http://www.eclipse.org/emf/2002/Ecore";

class DomainObject {
	attr ecore.EString[1] ~id;
	attr ecore.EString name;
}

class Cinema extends DomainObject {
	attr ecore.EString city;
	ref Town town;
}

class Town extends DomainObject {
}

class Theatre extends DomainObject {
	attr ecore.EInt seatCount;
	val Cinema cinema;
}

class Movie extends DomainObject {
	attr ecore.EString title;
}

class MovieCopy extends DomainObject {
	attr ecore.EInt copiesCount;
	ref Movie[1] movie;
	ref Cinema locationCinema;
}

class Show extends DomainObject {
	attr ecore.EDate startTime;
	attr ecore.EBoolean published;
	ref MovieCopy[*] movieCopies;
	ref Theatre[1] theatre;
}

class Reservation extends DomainObject {
	attr ecore.EString customerName;
	attr ecore.EString seatNumber;
	attr ecore.EDate cancellationAllowedUntil;
	ref Show[1] show;
	ref CreditCardPayment payment;
}

class CreditCardPayment extends DomainObject {
	attr ecore.EString cardNumber;
	attr ecore.EString expiryDate;
	attr ecore.EBoolean processed;
}


