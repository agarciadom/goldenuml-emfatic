<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Kinepolis" nsURI="http://www.kinepolis.com/model" nsPrefix="kine">
  <eClassifiers>
    <eClass name="DomainObject">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cinema" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="city" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="town" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Town" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Theatre" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="seatCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="cinema" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Movie" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MovieCopy" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="copiesCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="movie" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="locationCinema" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="startTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="published" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="movieCopies" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="theatre" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Reservation" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="customerName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="seatNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="cancellationAllowedUntil" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="show" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="payment" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreditCardPayment" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="cardNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="expiryDate" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="processed" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
