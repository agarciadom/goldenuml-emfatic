@namespace(uri="http://www.kinepolis.com/model", prefix="kp")
package Kinepolis;

import "http://www.eclipse.org/emf/2002/Ecore";

class KinepolisCompany {
	val Cinema[*] cinemas;
	val Customer[*] customers;
	val Movie[*] movieCatalog;
}

class Cinema {
	attr ecore.EString[1] name;
	attr ecore.EString[1] town;
	val Theatre[*] theatres;
	val MovieCopy[*] movieCopies;
}

class Theatre {
	attr ecore.EString[1] name;
	val Seat[*] seats;
}

class Seat {
	attr ecore.EString[1] seatNumber;
}

class Movie {
	attr ecore.EString[1] title;
	attr ecore.EInt[1] duration;
}

class MovieCopy {
	attr ecore.EString[1] copyId;
	ref Movie[1] movie;
}

class Show {
	attr ecore.EDate[1] startTime;
	attr ecore.EDate[1] endTime;
	ref Theatre[1] theatre;
	ref MovieCopy[1] movieCopy;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString[1] email;
	attr ecore.EString[1] creditCardNumber;
}

class Reservation {
	attr ecore.EDate[1] reservationTime;
	attr ecore.EDate[1] cancellationDeadline;
	attr ecore.EString[1] status;
	ref Customer[1] customer;
	ref Show[1] show;
	ref Seat[1] seat;
}

class Ticket {
	attr ecore.EString[1] ticketId;
	attr ecore.EDate[1] issueTime;
	ref Show[1] show;
	ref Seat[1] seat;
}

class Offer {
	attr ecore.EDate[1] offerStartTime;
	attr ecore.EDate[1] offerExpiryTime;
	attr ecore.EString[1] status;
	ref Customer[1] customer;
	ref Show[1] suggestedShow;
	ref Reservation[1] originalReservation;
}


