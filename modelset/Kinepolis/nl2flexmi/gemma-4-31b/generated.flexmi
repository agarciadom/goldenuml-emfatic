<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Kinepolis" nsURI="http://www.kinepolis.com/model" nsPrefix="kp">
  <eClassifiers>
    <eClass name="KinepolisCompany">
      <eStructuralFeatures>
        <eReference name="cinemas" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="movieCatalog" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Cinema">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="town" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="theatres" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="movieCopies" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Theatre">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="seats" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Seat">
      <eStructuralFeatures>
        <eAttribute name="seatNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Movie">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MovieCopy">
      <eStructuralFeatures>
        <eAttribute name="copyId" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="movie" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Show">
      <eStructuralFeatures>
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="theatre" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="movieCopy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="creditCardNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Reservation">
      <eStructuralFeatures>
        <eAttribute name="reservationTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="cancellationDeadline" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="show" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="seat" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Ticket">
      <eStructuralFeatures>
        <eAttribute name="ticketId" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="issueTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="show" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="seat" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Offer">
      <eStructuralFeatures>
        <eAttribute name="offerStartTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="offerExpiryTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="suggestedShow" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="originalReservation" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
