@namespace(uri="http://www.example.org/transport", prefix="transport")
package transport;

datatype LocalTime : java.time.LocalTime;

class Address {
	attr String street;
	attr String city;
	attr String postalCode;
	attr String country;
}

abstract class Employee {
	attr String name;
	attr String socialSecurityNumber;
}

class Driver extends Employee {
	ref Order[*]#driver orders;
}

abstract class SystemUser extends Employee {
	attr String username;
	attr String password;
}

class Planner extends SystemUser {
	ref Order[*]#assignedBy assignedOrders;
}

class AdministrativeStaff extends SystemUser {
	attr String fieldOfActivity;
}

class Customer {
	attr String name;
	val Address billingAddress;
	ref Order[*]#customer orders;
}

abstract class Vehicle {
	attr String licensePlateNumber;
	attr double mileage;
	val RepairRecord[*]#vehicle repairRecords;
}

class RefrigeratedTruck extends Vehicle {
}

class SmallVan extends Vehicle {
}

class LoadingPlatform extends Vehicle {
}

class BoxTruck extends Vehicle {
}

class RepairShop {
	attr String name;
	val Address address;
}

class RepairRecord {
	ref Vehicle#repairRecords vehicle;
	ref RepairShop repairShop;
	ref Employee responsibleEmployee;
	attr int durationInDays;
	attr double cost;
}

abstract class OrderPlacementChannel {
}

class OrderPlacedByAdminStaff extends OrderPlacementChannel {
	ref AdministrativeStaff administrativeStaff;
}

class PartnerCompany extends OrderPlacementChannel {
	attr String name;
	val Address address;
}

class Order {
	attr String comment;
	attr LocalTime startTime;
	attr LocalTime endTime;
	attr double packageSize;
	val Address pickUpAddress;
	val Address deliveryAddress;
	ref Customer#orders customer;
	ref Driver#orders driver;
	ref Vehicle vehicle;
	ref Planner#assignedOrders assignedBy;
	val OrderPlacementChannel placementChannel;
}

class TransportSystem {
	val TransportCompany[*] companies;
}

class TransportCompany {
	attr String name;
	val Employee[*] employees;
	val Customer[*] customers;
	val Vehicle[*] vehicles;
	val RepairShop[*] repairShops;
	val Order[*] orders;
}


