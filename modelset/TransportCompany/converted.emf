@namespace(uri="http://www.example.org/repairAndDelivery", prefix="repairAndDelivery")
package repairAndDelivery;

enum VehicleType {
	RefrigeratedTruck = 0;
	SmallVan = 1;
	LoadingPlatform = 2;
	BoxTruck = 3;
}

class RepairShop {
	attr String name;
	attr String address;
	val Repair[+]#repairShop repairs;
}

class Repair {
	attr int duration;
	attr double cost;
	ref RepairShop[1]#repairs repairShop;
	ref Vehicle[1]#repairs vehicle;
	ref Employee[1]#repairs employee;
}

class Vehicle {
	attr String licensePlateNumber;
	attr int mileage;
	attr VehicleType type;
	ref Repair[*]#vehicle repairs;
	ref Order[+]#vehicle orders;
}

class Order {
	attr int packetSize;
	attr String date;
	attr String comment;
	attr String startTime;
	attr String endTime;
	attr String pickUpAddress;
	attr String deliveryAddress;
	ref Vehicle[1]#orders vehicle;
	ref Driver[1]#orders driver;
	ref Planner[1]#createdOrders createdByPlanner;
	ref AdministrationEmployee#orders administrationEmployee;
	ref PartnerFirm#orders partnerFirm;
	ref Customer[1]#orders customer;
}

abstract class Employee {
	attr int ssn;
	attr String firstName;
	attr String lastName;
	ref Repair[*]#employee repairs;
}

class Driver extends Employee {
	ref Order[+]#driver orders;
}

abstract class OtherEmployee extends Employee {
	attr String userName;
	attr String password;
}

class Planner extends OtherEmployee {
	ref Order[+]#createdByPlanner createdOrders;
}

class AdministrationEmployee extends OtherEmployee {
	attr String fieldOfActivity;
	ref Order[*]#administrationEmployee orders;
}

class PartnerFirm {
	attr String name;
	attr String address;
	ref Order[*]#partnerFirm orders;
}

class Customer {
	attr String name;
	attr String address;
	ref Order[+]#customer orders;
}


