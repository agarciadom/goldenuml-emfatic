@namespace(uri="http://www.example.org/deliveryRepair", prefix="deliveryRepair")
package deliveryRepair;

datatype LocalTime : java.time.LocalTime;

enum VehicleType {
	RefrigeratedTruck = 0;
	SmallVan = 1;
	LoadingPlatform = 2;
	BoxTruck = 3;
}

class DeliveryRepairSystem {
	val RepairShop[*] repairShops;
	val Vehicle[*] vehicles;
	val Employee[*] employees;
	val Order[*] orders;
	val PartnerFirm[*] partnerFirms;
	val Customer[*] customers;
}

class RepairShop {
	attr String name;
	attr String address;
	val Repair[*]#repairShop repairs;
}

class Repair {
	attr int duration;
	attr double cost;
	ref RepairShop#repairs repairShop;
	ref Vehicle#repairs vehicle;
	ref Employee#repairs employee;
}

class Vehicle {
	attr String licensePlateNumber;
	attr int mileage;
	attr VehicleType type;
	ref Repair[*]#vehicle repairs;
	ref Order[*]#vehicle orders;
}

class Order {
	attr int packetSize;
	attr EDate date;
	attr String comment;
	attr LocalTime startTime;
	attr LocalTime endTime;
	attr String pickUpAddress;
	attr String deliveryAddress;
	ref Vehicle#orders vehicle;
	ref Driver#orders driver;
	ref Planner#createdOrders planner;
	ref AdministrationEmployee#orders administrationEmployee;
	ref PartnerFirm#orders partnerFirm;
	ref Customer#orders customer;
}

abstract class Employee {
	attr int ssn;
	attr String firstName;
	attr String lastName;
	ref Repair[*]#employee repairs;
}

class Driver extends Employee {
	ref Order[*]#driver orders;
}

abstract class OtherEmployee extends Employee {
	attr String userName;
	attr String password;
}

class Planner extends OtherEmployee {
	ref Order[*]#planner createdOrders;
}

class AdministrationEmployee extends OtherEmployee {
	attr String fieldOfActivity;
	ref Order[*]#administrationEmployee orders;
}

class PartnerFirm {
	attr String name;
	attr String address;
	ref Order[*]#partnerFirm orders;
}

class Customer {
	attr String name;
	attr String address;
	ref Order[*]#customer orders;
}


