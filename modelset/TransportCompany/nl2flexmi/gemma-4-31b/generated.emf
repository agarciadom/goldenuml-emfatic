@namespace(uri="http://transport.company/model", prefix="tc")
package TransportCompanyModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class TransportCompany {
	val Employee[*] employees;
	val Customer[*] customers;
	val Vehicle[*] vehicles;
	val RepairShop[*] repairShops;
	val PartnerCompany[*] partnerCompanies;
	val Order[*] orders;
	val RepairEvent[*] repairEvents;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString[1] ssn;
}

class Driver extends Employee {
}

class Planner extends AuthenticatedEmployee, Employee {
}

class AdminStaff extends AuthenticatedEmployee, Employee {
	attr ecore.EString activityField;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString[1] billingAddress;
}

class Vehicle {
	attr ecore.EString[1] licensePlate;
	attr ecore.EInt mileage;
}

class RefrigeratedTruck extends Vehicle {
}

class SmallVan extends Vehicle {
}

class LoadingPlatform extends Vehicle {
}

class BoxTruck extends Vehicle {
}

class RepairShop {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class RepairEvent {
	attr ecore.EString duration;
	attr ecore.EDouble cost;
	ref Vehicle[1] vehicle;
	ref RepairShop[1] repairShop;
	ref Employee[1] employee;
}

class Order {
	attr ecore.EString packageSize;
	attr ecore.EString comment;
	attr ecore.EDate startTime;
	attr ecore.EDate finishTime;
	attr ecore.EString[1] pickupAddress;
	attr ecore.EString[1] deliveryAddress;
	ref Customer[1] customer;
	ref Driver driver;
	ref Vehicle vehicle;
	ref Planner planner;
	ref AdminStaff placedByAdmin;
	ref PartnerCompany placedByPartner;
}

class PartnerCompany {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class AuthenticatedEmployee extends Employee {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}


