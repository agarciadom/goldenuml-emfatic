      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="billingAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="licensePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="mileage" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefrigeratedTruck" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SmallVan" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="LoadingPlatform" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="BoxTruck" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="RepairShop">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RepairEvent">
      <eStructuralFeatures>
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="cost" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="vehicle" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="repairShop" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
        <eReference name="employee" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="packageSize" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="comment" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="startTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="finishTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="pickupAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="deliveryAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="vehicle" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
