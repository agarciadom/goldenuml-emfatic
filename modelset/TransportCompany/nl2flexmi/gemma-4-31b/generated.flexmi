<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportCompanyModel" nsURI="http://transport.company/model" nsPrefix="tc">
  <eClassifiers>
    <eClass name="TransportCompany">
      <eStructuralFeatures>
        <eReference name="employees" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="vehicles" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="repairShops" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.11" />
        <eReference name="partnerCompanies" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.14" />
        <eReference name="orders" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.13" />
        <eReference name="repairEvents" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.12" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="ssn" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Planner" eSuperTypes="//@eClassifiers.15, //@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="AdminStaff" eSuperTypes="//@eClassifiers.15, //@eClassifiers.1">
      <eStructuralFeatures>
