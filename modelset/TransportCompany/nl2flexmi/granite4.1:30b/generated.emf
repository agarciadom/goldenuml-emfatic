@namespace(uri="http://www.transportcompany/model", prefix="tc")
package TransportCompany;

import "http://www.eclipse.org/emf/2002/Ecore";

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString socialSecurityNumber;
}

class Driver extends Employee {
}

class Planner extends Employee {
	attr ecore.EString username;
	attr ecore.EString password;
}

class AdministrativeStaff extends Employee {
	attr ecore.EString activityField;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString billingAddress;
}

class Vehicle {
	attr ecore.EString[1] licensePlate;
	attr ecore.EInt mileage;
	ref RepairShop repairShop;
	ref Employee employeeForRepair;
	attr ecore.EInt repairDuration;
	attr ecore.EBigDecimal repairCost;
	val Order[*] orders;
}

class RefrigeratedTruck extends Vehicle {
}

class SmallVan extends Vehicle {
}

class LoadingPlatform extends Vehicle {
}

class BoxTruck extends Vehicle {
}

class RepairShop {
	attr ecore.EString[1] name;
	attr ecore.EString address;
}

class Order {
	attr ecore.EString orderID;
	attr ecore.EString pickupAddress;
	attr ecore.EString deliveryAddress;
	attr ecore.EString comment;
	attr ecore.EDate startTime;
	attr ecore.EDate finishTime;
	ref Customer[1] customer;
	ref Planner planner;
	ref Driver driver;
	ref Vehicle vehicle;
	ref PartnerCompany partnerCompany;
}

class PartnerCompany {
	attr ecore.EString[1] name;
	attr ecore.EString address;
}


