<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportCompany" nsURI="http://www.transportcompany/model" nsPrefix="tc">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Planner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdministrativeStaff" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="activityField" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="billingAddress" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="licensePlate" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="mileage" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="repairShop" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="employeeForRepair" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eAttribute name="repairDuration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="repairCost" lowerBound="0" upperBound="1" eType="//EBigDecimal" />
        <eReference name="orders" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RefrigeratedTruck" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
    <eClass name="SmallVan" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
    <eClass name="LoadingPlatform" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
    <eClass name="BoxTruck" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
    <eClass name="RepairShop">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="orderID" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="pickupAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="deliveryAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="comment" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="startTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="finishTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="planner" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="vehicle" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="partnerCompany" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.12" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PartnerCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
