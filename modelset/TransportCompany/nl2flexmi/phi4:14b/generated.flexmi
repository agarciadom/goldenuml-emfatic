<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportCompany" nsURI="http://www.example.org/TransportCompany" nsPrefix="tc">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Planner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="AdministrativeStaff" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="billingAddress" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="licensePlateNumber" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="mileage" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Repair">
      <eStructuralFeatures>
        <eReference name="vehicle" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eAttribute name="repairShopName" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="cost" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="orders" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eReference name="customer" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="planner" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eAttribute name="comment" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="pickupAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="deliveryAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PartnerCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
