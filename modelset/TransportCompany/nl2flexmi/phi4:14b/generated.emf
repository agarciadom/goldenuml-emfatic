@namespace(uri="http://www.example.org/TransportCompany", prefix="tc")
package TransportCompany;

import "http://www.eclipse.org/emf/2002/Ecore";

class Employee {
	attr ecore.EString[*] name;
	attr ecore.EString socialSecurityNumber;
}

class Planner extends Employee {
}

class AdministrativeStaff extends Employee {
	attr ecore.EString[*] fieldOfActivity;
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}

class Customer {
	attr ecore.EString[*] name;
	attr ecore.EString billingAddress;
}

class Vehicle {
	attr ecore.EString[*] licensePlateNumber;
	attr ecore.EInt mileage;
}

class Repair {
	ref Vehicle[*] vehicle;
	attr ecore.EString[*] repairShopName;
	attr ecore.EInt duration;
	attr ecore.EDouble cost;
}

class Driver extends Employee {
	ref Order[*] orders;
}

class Order {
	ref Customer[*] customer;
	ref Planner[*] planner;
	attr ecore.EString[*] comment;
	attr ecore.EString pickupAddress;
	attr ecore.EString deliveryAddress;
	ref Driver[*] driver;
}

class PartnerCompany {
	attr ecore.EString[*] name;
	attr ecore.EString address;
}


