<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportCompany" nsURI="http://www.example.com/transportcompany" nsPrefix="tc">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Planner" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdministrativeStaff" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="fieldOfActivity" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Customer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="billingAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="licensePlateNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="mileage" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RepairShop">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PartnerCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="startTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="endTime" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="comment" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="sizeOfPackage" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="vehicle" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="planner" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="pickUpAddress" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
        <eReference name="deliveryAddress" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="String" instanceClassName="java.lang.String" />
    <eClass name="Address">
      <eStructuralFeatures>
        <eAttribute name="street" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="city" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="postalCode" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="country" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
