<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportCompany" nsURI="http://transportcompany.example.com" nsPrefix="tc">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="orders" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Planner" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="assignedOrders" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdministrativeStaff" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="partnerCompanies" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="billingAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="licensePlateNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="mileage" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="type" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="repairShop" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RepairShop">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="comment" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="vehicle" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="driver" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PartnerCompany">
      <eStructuralFeatures />
    </eClass>
    <eDataType name="VehicleType" instanceClassName="java.lang.String" />
  </eClassifiers>
</ePackage>
