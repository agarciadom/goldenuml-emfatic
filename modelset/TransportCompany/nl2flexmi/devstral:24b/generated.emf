@namespace(uri="http://www.example.com/transportcompany", prefix="tc")
package TransportCompany;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] name;
	attr ecore.EString socialSecurityNumber;
}

class Employee extends Person {
}

class Planner extends Employee {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
}

class AdministrativeStaff extends Employee {
	attr ecore.EString[1] username;
	attr ecore.EString[1] password;
	attr ecore.EString fieldOfActivity;
}

class Driver extends Employee {
}

class Customer extends Person {
	attr ecore.EString[1] billingAddress;
}

class Vehicle {
	attr ecore.EString[1] licensePlateNumber;
	attr ecore.EDouble[1] mileage;
}

class RepairShop {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class PartnerCompany {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
}

class Order {
	attr ecore.EDate startTime;
	attr ecore.EDate endTime;
	attr ecore.EString comment;
	attr ecore.EDouble[1] sizeOfPackage;
	ref Customer[1] customer;
	ref Driver driver;
	ref Vehicle vehicle;
	ref Planner planner;
	ref Address[1] pickUpAddress;
	ref Address[1] deliveryAddress;
}

datatype String : java.lang.String;

class Address {
	attr ecore.EString[1] street;
	attr ecore.EString[1] city;
	attr ecore.EString postalCode;
	attr ecore.EString[1] country;
}


