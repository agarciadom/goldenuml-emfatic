<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="FilmProduction" nsURI="http://www.example.com/filmproduction" nsPrefix="fp">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="hasOscar" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreativeEmployee" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Director" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eReference name="assistant" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Actor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="education" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="filmsPerformedIn" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Technician">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FilmSet">
      <eStructuralFeatures>
        <eReference name="location" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.12" />
        <eReference name="films" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Film">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="releaseYear" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="genre" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="filmSets" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Genre">
      <eStructuralFeatures>
        <eReference name="films" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScreenWriter">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="mostSuccessfulFilm" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="screenplays" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScreenPlay">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="version" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfScenes" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="plot" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="novelSource" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="conceptSource" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
        <eReference name="film" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Novel">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Concept">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Location">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
