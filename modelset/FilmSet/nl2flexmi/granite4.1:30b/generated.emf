@namespace(uri="http://www.example.com/filmproduction", prefix="fp")
package FilmProduction;

import "http://www.eclipse.org/emf/2002/Ecore";

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString socialSecurityNumber;
	attr ecore.EBoolean hasOscar;
}

class CreativeEmployee extends Employee {
}

class Director extends CreativeEmployee {
	val Employee assistant;
}

class Actor extends CreativeEmployee {
	attr ecore.EString education;
	ref Film[*] filmsPerformedIn;
}

class Technician {
	attr ecore.EString fieldOfActivity;
}

class FilmSet {
	val Location location;
	ref Film[*] films;
}

class Film {
	attr ecore.EString[1] title;
	attr ecore.EInt releaseYear;
	ref Genre[*] genre;
	ref FilmSet[*] filmSets;
}

class Genre {
	ref Film[*] films;
}

class ScreenWriter {
	attr ecore.EString[1] name;
	ref Film mostSuccessfulFilm;
	val ScreenPlay[*] screenplays;
}

class ScreenPlay {
	attr ecore.EString[1] title;
	attr ecore.EString version;
	attr ecore.EDate date;
	attr ecore.EInt numberOfScenes;
	attr ecore.EString plot;
	val Novel novelSource;
	val Concept conceptSource;
	ref Film film;
}

class Novel {
}

class Concept {
}

class Location {
}


