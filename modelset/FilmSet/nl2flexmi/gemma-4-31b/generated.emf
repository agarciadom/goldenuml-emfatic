@namespace(uri="http://example.org/filmproduction", prefix="fp")
package FilmProduction;

import "http://www.eclipse.org/emf/2002/Ecore";

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString[1] socialSecurityNumber;
	ref FilmSet workSet;
}

class CreativeEmployee extends Employee {
	attr ecore.EBoolean[1] hasOscar;
}

class Director extends CreativeEmployee {
	attr ecore.EString assistantName;
	ref Film[*] directedFilms;
}

class Actor extends CreativeEmployee {
	attr ecore.EString education;
	ref Film[*] films;
	ref Screenplay[*] readsScreenplay;
}

class Technician extends Employee {
	attr ecore.EString fieldOfActivity;
}

class FilmSet {
	attr ecore.EString[1] location;
	ref Film[*] films;
}

class Film {
	attr ecore.EString[1] title;
	attr ecore.EInt[1] releaseYear;
	attr ecore.EString[1] genre;
	ref FilmSet[+] filmSets;
	ref Screenplay[1] screenplay;
	ref Actor[*] actors;
	ref Director[1] director;
}

class Screenwriter {
	attr ecore.EString[1] name;
	val Screenplay[*] screenplays;
	ref Film mostSuccessfulFilm;
}

class Screenplay {
	attr ecore.EString[1] title;
	attr ecore.EString version;
	attr ecore.EDate date;
	attr ecore.EInt numberOfScenes;
	attr ecore.EString plot;
	ref Screenwriter[1] screenwriter;
	val ScreenplayBasis[1] basis;
	ref Film[1] film;
}

class ScreenplayBasis {
}

class Novel extends ScreenplayBasis {
	attr ecore.EString[1] title;
	attr ecore.EString[1] author;
}

class Concept extends ScreenplayBasis {
}

class Production {
	val Employee[*] employees;
	val FilmSet[*] filmSets;
	val Film[*] films;
}


