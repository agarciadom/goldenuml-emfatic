<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="FilmProduction" nsURI="http://example.org/filmproduction" nsPrefix="fp">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="workSet" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreativeEmployee" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="hasOscar" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Director" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="assistantName" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="directedFilms" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Actor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="education" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="films" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="readsScreenplay" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Technician" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FilmSet">
      <eStructuralFeatures>
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="films" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Film">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="releaseYear" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="genre" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="filmSets" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="screenplay" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="actors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="director" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenwriter">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="screenplays" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
        <eReference name="mostSuccessfulFilm" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenplay">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="version" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfScenes" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="plot" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="screenwriter" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="basis" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="film" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScreenplayBasis">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Novel" eSuperTypes="//@eClassifiers.9">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="author" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Concept" eSuperTypes="//@eClassifiers.9">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Production">
      <eStructuralFeatures>
        <eReference name="employees" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="filmSets" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="films" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
