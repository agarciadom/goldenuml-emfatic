<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="FilmProduction" nsURI="http://www.example.com/filmproduction" nsPrefix="fp">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreativeEmployee" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="hasOscar" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Director" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="assistantName" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Actor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="education" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="preparationScreenplays" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Technician" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FilmSet">
      <eStructuralFeatures>
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="films" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Film">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfRelease" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="genre" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="filmSets" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="director" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="actors" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="technicians" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="screenplay" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Genre" instanceClassName="java.lang.String" />
    <eClass name="Screenwriter">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="mostSuccessfulFilm" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="screenplays" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenplay">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="version" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfScenes" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="plot" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="screenwriter" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="basedOnNovel" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
        <eReference name="basedOnConcept" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Novel">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="author" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Concept">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
