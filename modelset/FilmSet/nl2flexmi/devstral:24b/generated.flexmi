<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="FilmIndustry" nsURI="http://www.example.org/filmindustry" nsPrefix="film">
  <eClassifiers>
    <eClass name="FilmSet">
      <eStructuralFeatures>
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="films" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CreativeEmployee" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="hasOscar" lowerBound="0" upperBound="1" eType="//EBooleanObject" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Director" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="assistantName" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="directedFilms" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="assistant" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Actor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="educationCompleted" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="actingInFilms" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Technician" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Film">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="year" lowerBound="0" upperBound="1" eType="//EIntegerObject" />
        <eAttribute name="genre" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="directors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="actors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="screenwriter" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="screenplay" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenwriter">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="mostSuccessfulFilm" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="createdScreenplays" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenplay">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="version" lowerBound="0" upperBound="1" eType="//EIntegerObject" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfScenes" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="plot" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="basedOn" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="film" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="novel" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Novel">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="author" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="screenplays" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
