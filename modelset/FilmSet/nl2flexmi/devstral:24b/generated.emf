@namespace(uri="http://www.example.org/filmindustry", prefix="film")
package FilmIndustry;

import "http://www.eclipse.org/emf/2002/Ecore";

class FilmSet {
	attr ecore.EString[1] location;
	val Film[*] films;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString[1] socialSecurityNumber;
}

class CreativeEmployee extends Employee {
	attr ecore.EBooleanObject hasOscar;
}

class Director extends CreativeEmployee {
	attr ecore.EString assistantName;
	ref Film[*] directedFilms;
	ref CreativeEmployee assistant;
}

class Actor extends CreativeEmployee {
	attr ecore.EString educationCompleted;
	ref Film[*] actingInFilms;
}

class Technician extends Employee {
	attr ecore.EString[1] fieldOfActivity;
}

class Film {
	attr ecore.EString[1] title;
	attr ecore.EIntegerObject year;
	attr ecore.EString[1] genre;
	val Director[*] directors;
	val Actor[*] actors;
	ref Screenwriter screenwriter;
	ref Screenplay[1] screenplay;
}

class Screenwriter {
	attr ecore.EString[1] name;
	attr ecore.EString mostSuccessfulFilm;
	ref Screenplay[*] createdScreenplays;
}

class Screenplay {
	attr ecore.EString[1] title;
	attr ecore.EIntegerObject version;
	attr ecore.EDate date;
	attr ecore.EInt[1] numberOfScenes;
	attr ecore.EString plot;
	attr ecore.EString basedOn;
	ref Film film;
	ref Novel novel;
}

class Novel {
	attr ecore.EString[1] title;
	attr ecore.EString[1] author;
	ref Screenplay[*] screenplays;
}


