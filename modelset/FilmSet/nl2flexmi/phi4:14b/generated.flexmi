<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="FilmSetModel" nsURI="http://www.example.org/filmsetmodel" nsPrefix="fsm">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Director" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="assistantName" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="isOscarWinner" containment="False" lowerBound="0" upperBound="1" eType="/" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Actor" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="educationCompleted" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="isOscarWinner" containment="False" lowerBound="0" upperBound="1" eType="/" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Technician">
      <eStructuralFeatures>
        <eAttribute name="fieldOfActivity" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FilmSet">
      <eStructuralFeatures>
        <eAttribute name="location" lowerBound="1" upperBound="1" eType="/" />
        <eReference name="filmsShotHere" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Film">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfRelease" lowerBound="1" upperBound="1" eType="/" />
        <eReference name="filmSetsUsed" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="basedOnScreenplay" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenwriter">
      <eStructuralFeatures>
        <eAttribute name="mostSuccessfulFilm" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="screenplaysWritten" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Screenplay">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="version" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="numberOfScenes" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="plot" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="screenwriter" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="filmBasedOnIt" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Novel">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="author" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Genre">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
