@namespace(uri="http://www.example.org/FilmIndustry", prefix="p")
package FilmIndustry;

class Employee {
  attr EString name;
  attr EString socialSecurityNumber;
}
class CreativeEmployee extends Employee {
  attr EBoolean oscarWinner;
}
class Actor extends CreativeEmployee {
  attr EString education;
  ref Screenplay[*] screenplays;
}
class Director extends CreativeEmployee {
  attr EString assistantName;
}
class Technician extends Employee {
  attr EString fieldOfActivity;
}
class FilmSet {
  attr EString location;
  val Film[*] films;
}
class Genre {
  attr http://www.example.org/FilmIndustry/GenreType::THRILLER type;
}
class Screenwriter {
  attr EString name;
  attr EString mostSuccessfulFilm;
  val Screenplay[*] screenplays;
}
class Screenplay {
  attr EString title;
  attr EInt version;
  attr EDate date;
  attr EInt numberOfScenes;
  attr EString plot;
  ref Screenwriter screenwriter;
  val Film film;
  ref Novel[*] basedOnNovels;
}
class Novel {
  attr EString title;
  attr EString author;
}
class Film {
  attr EString title;
  attr EInt yearOfRelease;
  ref Director director;
  ref Screenplay screenplay;
  ref Actor[*] actors;
  ref FilmSet[*] filmSets;
  ref Genre genre;
}

@namespace(uri="http://www.example.org/FilmIndustry/GenreType", prefix="p")
package GenreTypeEnum;

class THRILLER {
}
class ACTION {
}
class HORROR {
}
class COMEDY {
}