@namespace(uri="http://www.example.org/filmstudio", prefix="filmstudio")
package filmstudio;

enum Genre {
	Thriller = 0;
	Action = 1;
	Horror = 2;
	Comedy = 3;
}

abstract class Employee {
	attr String Name;
	attr int Ssn;
	ref FilmSet[1]#employees filmsSet;
}

abstract class CreativeEmployee extends Employee {
	attr boolean Oscar;
}

class Technician extends Employee {
	attr String FieldOfActivity;
}

class Director extends CreativeEmployee {
	attr String AssistentName;
	ref Screenplay[*]#implementedBy implements;
}

class Actor extends CreativeEmployee {
	attr String Education;
	ref Screenplay[*]#readBy reads;
}

class Screenplay {
	attr String Title;
	attr String Version;
	attr EDate Date;
	attr int NumberOfScenes;
	attr String Plot;
	ref Director[1]#implements implementedBy;
	ref Actor[*]#reads readBy;
	ref ScreenplayAuthor[1]#creates createdBy;
	ref Book#screenplay basedOnBook;
	ref Concept#screenplay basedOnConcept;
}

class FilmSet {
	attr String Location;
	ref Employee[*]#filmsSet employees;
	ref Film[*]#filmSets films;
}

class Film {
	attr String Title;
	attr int Year;
	attr Genre Genre;
	ref FilmSet[*]#films filmSets;
	ref ScreenplayAuthor#mostSuccessfulFilm mostSuccessful;
	ref Screenplay[1] screenplay;
}

class ScreenplayAuthor {
	attr String Name;
	ref Screenplay[+]#createdBy creates;
	ref Film#mostSuccessful mostSuccessfulFilm;
}

class Book {
	attr String Title;
	attr String Author;
	ref Screenplay#basedOnBook screenplay;
}

class Concept {
	ref Screenplay#basedOnConcept screenplay;
}


