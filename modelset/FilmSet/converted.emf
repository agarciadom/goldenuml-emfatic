@namespace(uri="http://www.example.org/filmstudio", prefix="filmstudio")
package filmstudio;

enum Genre {
	Thriller = 0;
	Action = 1;
	Horror = 2;
	Comedy = 3;
}

abstract class Employee {
	attr String name;
	attr int ssn;
	ref FilmSet filmSet;
}

abstract class CreativeEmployee extends Employee {
	attr boolean oscar;
}

class Technician extends Employee {
	attr String fieldOfActivity;
}

class Director extends CreativeEmployee {
	attr String assistentName;
	ref Screenplay[*]#implementingDirector implementedScreenplays;
}

class Actor extends CreativeEmployee {
	attr String education;
	ref Screenplay[*]#readingActors readScreenplays;
}

class Screenplay {
	attr String title;
	attr String version;
	attr EDate date;
	attr int numberOfScenes;
	attr String plot;
	ref Director#implementedScreenplays implementingDirector;
	ref Actor[*]#readScreenplays readingActors;
	ref ScreenplayAuthor#createdScreenplays screenplayAuthor;
	val Book basedOnBook;
	val Concept basedOnConcept;
}

class FilmSet {
	attr String location;
	ref Film[*]#filmSets films;
}

class Film {
	attr String title;
	attr int year;
	attr Genre genre;
	ref FilmSet[*]#films filmSets;
	ref ScreenplayAuthor#mostSuccessfulFilm mostSuccessful;
	val Screenplay[1] screenplay;
}

class ScreenplayAuthor {
	attr String name;
	ref Screenplay[*]#screenplayAuthor createdScreenplays;
	ref Film#mostSuccessful mostSuccessfulFilm;
}

class Book {
	attr String title;
	attr String author;
}

class Concept {
}

class Studio {
	val Employee[*] employees;
	val FilmSet[*] filmSets;
	val Film[*] films;
	val ScreenplayAuthor[*] screenplayAuthors;
}


