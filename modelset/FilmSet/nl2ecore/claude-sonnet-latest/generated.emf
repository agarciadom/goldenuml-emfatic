@namespace(uri="http://www.example.org/filmset", prefix="filmset")
package filmset;

enum Genre {
	THRILLER = 0;
	ACTION = 0;
	HORROR = 0;
	COMEDY = 0;
}

datatype LocalDate : java.time.LocalDate;

abstract class Employee {
	attr String name;
	attr String socialSecurityNumber;
}

abstract class CreativeEmployee extends Employee {
	attr boolean hasOscar;
}

class Director extends CreativeEmployee {
	attr String assistantName;
	ref Film#director implements_;
}

class Actor extends CreativeEmployee {
	attr String education;
	ref Screenplay[*]#actors screenplaysToRead;
}

class Technician extends Employee {
	attr String fieldOfActivity;
}

class FilmSet {
	attr String location;
	val Employee[*] employees;
	ref Film[*]#filmSets films;
}

class Film {
	attr String title;
	attr int yearOfRelease;
	attr Genre genre;
	ref FilmSet[*]#films filmSets;
	ref Screenplay#film screenplay;
	ref Director#implements_ director;
}

class Screenwriter {
	attr String name;
	attr String mostSuccessfulFilm;
	val Screenplay[*]#screenwriter screenplays;
}

class Screenplay {
	attr String title;
	attr String version;
	attr LocalDate date;
	attr int numberOfScenes;
	attr String plot;
	ref Screenwriter#screenplays screenwriter;
	val ScreenplayBasis basis;
	ref Film#screenplay film;
	ref Actor[*]#screenplaysToRead actors;
}

abstract class ScreenplayBasis {
}

class Novel extends ScreenplayBasis {
	attr String title;
	attr String author;
}

class Concept extends ScreenplayBasis {
}

class FilmStudio {
	val FilmSet[*] filmSets;
	val Film[*] films;
	val Screenwriter[*] screenwriters;
}


