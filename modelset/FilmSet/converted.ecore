<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="filmstudio"
    nsURI="http://www.example.org/filmstudio"
    nsPrefix="filmstudio">

  <!-- Enum: Genre -->
  <eClassifiers xsi:type="ecore:EEnum" name="Genre">
    <eLiterals name="Thriller"/>
    <eLiterals name="Action" value="1"/>
    <eLiterals name="Horror" value="2"/>
    <eLiterals name="Comedy" value="3"/>
  </eClassifiers>

  <!-- Abstract class: Employee -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ssn" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Association to FilmSet: many Employees work on one FilmSet -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="filmSet" eType="#//FilmSet"/>
  </eClassifiers>

  <!-- Abstract class: CreativeEmployee (extends Employee) -->
  <eClassifiers xsi:type="ecore:EClass" name="CreativeEmployee" abstract="true" eSuperTypes="#//Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="oscar" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Class: Technician (extends Employee) -->
  <eClassifiers xsi:type="ecore:EClass" name="Technician" eSuperTypes="#//Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="fieldOfActivity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class: Director (extends CreativeEmployee) -->
  <eClassifiers xsi:type="ecore:EClass" name="Director" eSuperTypes="#//CreativeEmployee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="assistentName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Director implements many Screenplays (1 Director to many Screenplays) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="implementedScreenplays"
        upperBound="-1"
        eType="#//Screenplay"
        eOpposite="#//Screenplay/implementingDirector"/>
  </eClassifiers>

  <!-- Class: Actor (extends CreativeEmployee) -->
  <eClassifiers xsi:type="ecore:EClass" name="Actor" eSuperTypes="#//CreativeEmployee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="education" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Actor reads many Screenplays (many-to-many) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="readScreenplays"
        upperBound="-1"
        eType="#//Screenplay"
        eOpposite="#//Screenplay/readingActors"/>
  </eClassifiers>

  <!-- Class: Screenplay -->
  <eClassifiers xsi:type="ecore:EClass" name="Screenplay">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="version" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfScenes" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="plot" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Opposite of Director.implementedScreenplays -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="implementingDirector"
        eType="#//Director"
        eOpposite="#//Director/implementedScreenplays"/>
    <!-- Opposite of Actor.readScreenplays -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="readingActors"
        upperBound="-1"
        eType="#//Actor"
        eOpposite="#//Actor/readScreenplays"/>
    <!-- Opposite of ScreenplayAuthor.createdScreenplays -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="screenplayAuthor"
        eType="#//ScreenplayAuthor"
        eOpposite="#//ScreenplayAuthor/createdScreenplays"/>
    <!-- XOR: Screenplay is based on either a Book or a Concept (0..1 each) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="basedOnBook"
        eType="#//Book"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="basedOnConcept"
        eType="#//Concept"
        containment="true"/>
  </eClassifiers>

  <!-- Class: FilmSet -->
  <eClassifiers xsi:type="ecore:EClass" name="FilmSet">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="location" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- FilmSet is associated with many Films -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="films"
        upperBound="-1"
        eType="#//Film"
        eOpposite="#//Film/filmSets"/>
  </eClassifiers>

  <!-- Class: Film -->
  <eClassifiers xsi:type="ecore:EClass" name="Film">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="year" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="genre" eType="#//Genre"/>
    <!-- Film is associated with many FilmSets -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="filmSets"
        upperBound="-1"
        eType="#//FilmSet"
        eOpposite="#//FilmSet/films"/>
    <!-- Film has one MostSuccessful ScreenplayAuthor (0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="mostSuccessful"
        upperBound="1"
        eType="#//ScreenplayAuthor"
        eOpposite="#//ScreenplayAuthor/mostSuccessfulFilm"/>
    <!-- Film has exactly one Screenplay -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="screenplay"
        lowerBound="1"
        eType="#//Screenplay"
        containment="true"/>
  </eClassifiers>

  <!-- Class: ScreenplayAuthor -->
  <eClassifiers xsi:type="ecore:EClass" name="ScreenplayAuthor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- ScreenplayAuthor creates many Screenplays -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="createdScreenplays"
        lowerBound="1"
        upperBound="-1"
        eType="#//Screenplay"
        eOpposite="#//Screenplay/screenplayAuthor"/>
    <!-- Opposite of Film.mostSuccessful -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="mostSuccessfulFilm"
        eType="#//Film"
        eOpposite="#//Film/mostSuccessful"/>
  </eClassifiers>

  <!-- Class: Book -->
  <eClassifiers xsi:type="ecore:EClass" name="Book">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="author" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Class: Concept -->
  <eClassifiers xsi:type="ecore:EClass" name="Concept">
  </eClassifiers>

  <!-- Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="Studio">
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        upperBound="-1"
        eType="#//Employee"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="filmSets"
        upperBound="-1"
        eType="#//FilmSet"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="films"
        upperBound="-1"
        eType="#//Film"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="screenplayAuthors"
        upperBound="-1"
        eType="#//ScreenplayAuthor"
        containment="true"/>
  </eClassifiers>

</ecore:EPackage>
