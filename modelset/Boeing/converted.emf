@namespace(uri="http://www.example.org/airline", prefix="airline")
package airline;

class AirlineRegistry {
	val AirplaneModel[*] airplaneModels;
	val Airline[*] airlines;
	val Employee[*] employees;
}

class AirplaneModel {
	attr int modelId;
	val Airplane[*]#airplaneModel airplanes;
}

class Airplane {
	attr int airPlaneId;
	ref AirplaneModel#airplanes airplaneModel;
	ref Acquisition#airplane acquisition;
}

class Acquisition {
	attr int acquisitionId;
	attr float negotiatedPrice;
	attr String options;
	attr EDate deliveryDate;
	ref Airplane#acquisition airplane;
	ref Contract#acquisitions contract;
}

class Contract {
	attr int contractId;
	attr String text;
	val Acquisition[*]#contract acquisitions;
	ref Airline#contracts airline;
	ref Employee#contracts employee;
}

class Employee {
	attr int employeeId;
	ref Contract[*]#employee contracts;
}

class Airline {
	attr String name;
	val Contract[*]#airline contracts;
	ref Airline#subsidiaries parentAirline;
	ref Airline[*]#parentAirline subsidiaries;
}


