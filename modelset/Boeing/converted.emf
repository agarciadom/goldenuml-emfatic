@namespace(uri="http://www.example.org/airplane", prefix="airplane")
package airplane;

class AirplaneModel {
	attr int modelId;
	ref Airplane[*]#airplaneModel airplanes;
}

class Airplane {
	attr int airPlaneId;
	ref AirplaneModel[1]#airplanes airplaneModel;
	ref Acquisition#airplane acquisition;
}

class Acquisition {
	attr int acquisitionId;
	attr float negotiatedPrice;
	attr String options;
	attr EDate deliveryDate;
	ref Airplane#acquisition airplane;
	ref Contract[1]#acquisitions contract;
}

class Contract {
	attr int contractId;
	attr String text;
	ref Acquisition[*]#contract acquisitions;
	ref Airline[1]#contracts airline;
	ref Employee[1]#contracts employee;
}

class Employee {
	attr int employeeId;
	ref Contract[*]#employee contracts;
}

class Airline {
	attr String name;
	ref Contract[*]#airline contracts;
	ref Airline#subsidiaryAirlines parentAirline;
	ref Airline[*]#parentAirline subsidiaryAirlines;
}


