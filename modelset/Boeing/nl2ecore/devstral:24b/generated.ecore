<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="boeingModel" nsURI="http://www.example.org/boeingModel" nsPrefix="boeingModel" xmi:version="2.0">

    <!-- Root container class -->
    <ecore:EClass name="BoeingSystem">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Root container for the Boeing system"/>
      </eAnnotations>
      <ecore:EReference name="contracts" eType="#//Contract" upperBound="-1" containment="true"/>
      <ecore:EReference name="airlineCompanies" eType="#//AirlineCompany" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Contract class -->
    <ecore:EClass name="Contract">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Represents a contract between Boeing and an airline company"/>
      </eAnnotations>
      <ecore:EAttribute name="contractId" eType="ecore:EString"/>
      <ecore:EReference name="salesperson" eType="#//Employee" containment="false"/>
      <ecore:EReference name="acquisitions" eType="#//Acquisition" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Acquisition class -->
    <ecore:EClass name="Acquisition">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Represents an acquisition of an airplane under a contract"/>
      </eAnnotations>
      <ecore:EAttribute name="airplaneModel" eType="ecore:EString"/>
      <ecore:EAttribute name="negotiatedPrice" eType="ecore:EFloat"/>
      <ecore:EReference name="deliveryDate" eType="#//TimeWithoutDate"/>
      <ecore:EReference name="optionsCustomizations" eType="#//OptionCustomization" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- OptionCustomization class -->
    <ecore:EClass name="OptionCustomization">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Represents an option or customization for an airplane acquisition"/>
      </eAnnotations>
      <ecore:EAttribute name="description" eType="ecore:EString"/>
      <ecore:EAttribute name="cost" eType="ecore:EFloat"/>
    </ecore:EClass>

    <!-- AirlineCompany class -->
    <ecore:EClass name="AirlineCompany">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Represents an airline company"/>
      </eAnnotations>
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="motherCompany" eType="#//AirlineCompany" containment="false" upperBound="1"/>
      <ecore:EReference name="daughterCompanies" eType="#//AirlineCompany" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Employee class -->
    <ecore:EClass name="Employee">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Represents an employee of Boeing"/>
      </eAnnotations>
      <ecore:EAttribute name="employeeId" eType="ecore:EString"/>
      <ecore:EReference name="managedContracts" eType="#//Contract" upperBound="-1" containment="false"/>
    </ecore:EClass>

    <!-- Custom datatype for TimeWithoutDate -->
    <ecore:EDataType name="TimeWithoutDate">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Validation">
        <details key="description" value="Custom data type for time without date"/>
      </eAnnotations>
      <ecore:eAnnotation source="http://www.eclipse.org/emf/2002/Ecore">
        <details key="instanceClassName" value="java.time.LocalTime"/>
      </ecore:eAnnotation>
    </ecore:EDataType>

  </ecore:EPackage>
</xmi:XMI>
