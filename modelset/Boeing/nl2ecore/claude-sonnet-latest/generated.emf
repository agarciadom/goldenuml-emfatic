@namespace(uri="http://www.boeing.com/sales", prefix="boeing")
package boeing;

datatype LocalDate : java.time.LocalDate;

class BoeingSystem {
	val AirlineCompany[*] airlineCompanies;
	val Employee[*] employees;
	val Contract[*] contracts;
	val AircraftModel[*] aircraftModels;
}

class AirlineCompany {
	attr String name;
	attr String registrationNumber;
	ref AirlineCompany#daughterCompanies motherCompany;
	ref AirlineCompany[*]#motherCompany daughterCompanies;
	ref Contract[*]#airlineCompany contracts;
}

class Employee {
	attr String employeeId;
	attr String firstName;
	attr String lastName;
	ref Contract[*]#salesperson managedContracts;
}

class Contract {
	attr String contractId;
	attr String deliveryConditions;
	attr String legalAspects;
	attr EDate signDate;
	ref AirlineCompany#contracts airlineCompany;
	ref Employee#managedContracts salesperson;
	val Acquisition[*]#contract acquisitions;
}

class Acquisition {
	attr double negotiatedPrice;
	attr EDate deliveryDate;
	ref Contract#acquisitions contract;
	ref AircraftModel aircraftModel;
	ref Option[*] chosenOptions;
	val Aircraft aircraft;
}

class AircraftModel {
	attr String modelName;
	attr String modelCode;
	attr double basePrice;
	val Option[*] availableOptions;
}

class Option {
	attr String optionName;
	attr String description;
	attr double additionalPrice;
}

class Aircraft {
	attr String serialNumber;
	attr EDate buildDate;
	attr AircraftStatus status;
}

enum AircraftStatus {
	ORDERED = 0;
	IN_PRODUCTION = 1;
	BUILT = 2;
	DELIVERED = 3;
}


