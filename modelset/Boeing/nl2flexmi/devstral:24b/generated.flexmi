<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BoeingSales" nsURI="http://www.example.org/boeingsales" nsPrefix="bs">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="model" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Acquisition">
      <eStructuralFeatures>
        <eAttribute name="airplaneModel" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="negotiatedPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="optionsCustomizations" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="deliveryDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="salesAgreement" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="aircraft" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SalesAgreement">
      <eStructuralFeatures>
        <eAttribute name="contractDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="deliveryConditions" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="legalAspects" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="salesperson" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AirlineCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="motherAirline" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
