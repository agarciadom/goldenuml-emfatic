<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BoeingSales" nsURI="http://www.boeing.com/sales" nsPrefix="bs">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="model" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="options" lowerBound="0" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Acquisition">
      <eStructuralFeatures>
        <eReference name="aircraft" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eAttribute name="negotiatedPrice" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="deliveryDate" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eReference name="acquisitions" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="salesPerson" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="airlineCompany" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SalesPerson">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AirlineCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="motherAirline" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
