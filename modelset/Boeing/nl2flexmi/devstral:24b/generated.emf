@namespace(uri="http://www.boeing.com/sales", prefix="bs")
package BoeingSales;

import "http://www.eclipse.org/emf/2002/Ecore";

class Aircraft {
	attr ecore.EString[1] model;
	attr ecore.EDouble[1] price;
	attr ecore.EString[*] options;
}

class Acquisition {
	ref Aircraft[1] aircraft;
	attr ecore.EDouble[1] negotiatedPrice;
	attr ecore.EDate deliveryDate;
}

class Contract {
	val Acquisition[+] acquisitions;
	ref SalesPerson[1] salesPerson;
	ref AirlineCompany[1] airlineCompany;
}

class SalesPerson {
	attr ecore.EString[1] name;
}

class AirlineCompany {
	attr ecore.EString[1] name;
	ref AirlineCompany motherAirline;
}


