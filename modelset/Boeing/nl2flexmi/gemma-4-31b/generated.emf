@namespace(uri="http://www.boeing.com/sales", prefix="bs")
package BoeingSales;

import "http://www.eclipse.org/emf/2002/Ecore";

class AirlineCompany {
	ref AirlineCompany parentCompany;
	val Contract[*] contracts;
}

class BoeingEmployee {
	attr ecore.EString name;
}

class Contract {
	attr ecore.EString deliveryConditions;
	attr ecore.EString legalAspects;
	ref AirlineCompany[1] customer;
	ref BoeingEmployee[1] salesperson;
	val Acquisition[*] acquisitions;
}

class Acquisition {
	attr ecore.EString airplaneModel;
	attr ecore.EBigDecimal negotiatedPrice;
	attr ecore.EString customizations;
	attr ecore.EDate deliveryDate;
	ref Contract[1] parentContract;
}


