<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BoeingSales" nsURI="http://www.boeing.com/sales" nsPrefix="bs">
  <eClassifiers>
    <eClass name="AirlineCompany">
      <eStructuralFeatures>
        <eReference name="parentCompany" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="contracts" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BoeingEmployee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="deliveryConditions" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="legalAspects" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="salesperson" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="acquisitions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Acquisition">
      <eStructuralFeatures>
        <eAttribute name="airplaneModel" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="negotiatedPrice" lowerBound="0" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="customizations" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="deliveryDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="parentContract" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
