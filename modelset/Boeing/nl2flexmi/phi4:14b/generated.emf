@namespace(uri="http://example.com/boeing/sales/model", prefix="bsm")
package BoeingSalesModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class Aircraft {
	attr ecore.EString[1] Model;
	attr ecore.EInt[1] Capacity;
}

class SalesAgreement {
	attr ecore.EDate[1] DateSigned;
	ref AirlineCustomer[1] Customer;
	ref Contract[+] Contracts;
}

class Acquisition {
	attr ecore.EString[1] ChosenModel;
	attr ecore.EBigDecimal[1] NegotiatedPrice;
	attr ecore.EDate[1] DeliveryDate;
	ref Aircraft[1] Aircraft;
}

class Contract {
	attr ecore.EString[*] GlobalConditions;
	val Acquisition[+] Acquisitions;
}

class AirlineCustomer {
	attr ecore.EString[1] Name;
	ref AirlineCustomer MotherCompany;
}

class Salesperson {
	attr ecore.EString[1] Name;
	ref Contract[*] ManagedContracts;
}


