<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BoeingSalesModel" nsURI="http://example.com/boeing/sales/model" nsPrefix="bsm">
  <eClassifiers>
    <eClass name="Aircraft">
      <eStructuralFeatures>
        <eAttribute name="Model" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="Capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SalesAgreement">
      <eStructuralFeatures>
        <eAttribute name="DateSigned" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="Customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="Contracts" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Acquisition">
      <eStructuralFeatures>
        <eAttribute name="ChosenModel" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="NegotiatedPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="DeliveryDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="Aircraft" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Contract">
      <eStructuralFeatures>
        <eAttribute name="GlobalConditions" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="Acquisitions" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AirlineCustomer">
      <eStructuralFeatures>
        <eAttribute name="Name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="MotherCompany" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Salesperson">
      <eStructuralFeatures>
        <eAttribute name="Name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="ManagedContracts" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
