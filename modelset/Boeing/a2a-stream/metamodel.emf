@namespace(uri="http://www.example.org/boeing", prefix="p")
package BoeingSales;

class Contract {
  attr EString ~id;
  attr EString deliveryConditions;
  attr EString legalAspects;
  val Acquisition[*] acquisitions;
  ref AirlineCompany customer;
  ref Salesperson currentManager;
  val ContractHistoryEntry[*] history;
}
class Acquisition {
  attr EDouble negotiatedPrice;
  attr EString optionsAndCustomizations;
  attr EDate deliveryDate;
  val BuiltAircraft[*] builtAircraft;
  ref AircraftModel aircraftModel;
}
class AircraftModel {
  attr EString modelName;
}
class AirlineCompany {
  attr EString name;
  ref AirlineCompany[*] relatedCompanies;
  ref AirlineCompany motherCompany;
  ref AirlineCompany[*] daughterCompanies;
}
class Salesperson {
  attr EString name;
}
class ContractHistoryEntry {
  attr EDate managerChangeDate;
  ref Salesperson previousManager;
}
class BuiltAircraft {
  attr EString serialNumber;
  ref Acquisition acquisition;
}