<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="airline"
    nsURI="http://www.example.org/airline"
    nsPrefix="airline">

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="AirlineRegistry">
    <eStructuralFeatures xsi:type="ecore:EReference" name="airplaneModels"
        eType="#//AirplaneModel" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="airlines"
        eType="#//Airline" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        eType="#//Employee" containment="true" upperBound="-1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="AirplaneModel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="modelId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="airplanes"
        eType="#//Airplane" containment="true" upperBound="-1"
        eOpposite="#//Airplane/airplaneModel"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Airplane">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="airPlaneId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="airplaneModel"
        eType="#//AirplaneModel"
        eOpposite="#//AirplaneModel/airplanes"/>
    <!-- 0..1 association with Acquisition -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="acquisition"
        eType="#//Acquisition" upperBound="1"
        eOpposite="#//Acquisition/airplane"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Acquisition">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="acquisitionId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="negotiatedPrice"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="options"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deliveryDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- opposite side of Airplane - Acquisition (0..1 to 0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="airplane"
        eType="#//Airplane" upperBound="1"
        eOpposite="#//Airplane/acquisition"/>
    <!-- Acquisition is contained by Contract -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="contract"
        eType="#//Contract"
        eOpposite="#//Contract/acquisitions"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Contract">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contractId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="text"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="acquisitions"
        eType="#//Acquisition" containment="true" upperBound="-1"
        eOpposite="#//Acquisition/contract"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="airline"
        eType="#//Airline"
        eOpposite="#//Airline/contracts"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="employee"
        eType="#//Employee"
        eOpposite="#//Employee/contracts"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Employee">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employeeId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="contracts"
        eType="#//Contract" upperBound="-1"
        eOpposite="#//Contract/employee"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Airline">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="contracts"
        eType="#//Contract" containment="true" upperBound="-1"
        eOpposite="#//Contract/airline"/>
    <!-- Self-association: an Airline can be associated with 0..1 parent Airline -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="parentAirline"
        eType="#//Airline" upperBound="1"
        eOpposite="#//Airline/subsidiaries"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subsidiaries"
        eType="#//Airline" upperBound="-1"
        eOpposite="#//Airline/parentAirline"/>
  </eClassifiers>

</ecore:EPackage>
