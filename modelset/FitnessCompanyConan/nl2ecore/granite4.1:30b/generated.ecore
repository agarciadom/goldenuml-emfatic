<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" version="2.0">
  <!-- Root container that aggregates the entire model -->
  <eClass xmi:type="ecore:EClass" name="ConanMetamodel">
    <eStructuralFeatures>
      <!-- Contains all centers in the fitness company -->
      <eReference name="centers" type="Center" containment="true"/>
    </eStructuralFeatures>
  </eClass>

  <!-- Represents a fitness center located in a city -->
  <eClass xmi:type="ecore:EClass" name="Center">
    <eStructuralFeatures>
      <!-- Unique identifier for the center -->
      <eAttribute name="name" eType="ecore:EString" unique="true"/>
      <!-- Physical address of the center -->
      <eAttribute name="address" eType="ecore:EString"/>
      <!-- All rooms that belong to this center -->
      <eReference name="rooms" type="Room" containment="true"/>
    </eStructuralFeatures>
  </eClass>

  <!-- Represents a room within a fitness center -->
  <eClass xmi:type="ecore:EClass" name="Room">
    <eStructuralFeatures>
      <!-- Unique number of the room inside its center (e.g., 1, 2, 3…) -->
      <eAttribute name="number" eType="ecore:EInt" unique="true"/>
      <!-- Maximum capacity that the room can accommodate -->
      <eAttribute name="maxCapacity" eType="ecore:EInt"/>
      <!-- Back reference to the center this room belongs to (non‑containing) -->
      <eReference name="center" type="Center" containment="false"/>
      <!-- Sessions scheduled in this room -->
      <eReference name="sessions" type="Session" containment="true"/>
    </eStructuralFeatures>
  </eClass>

  <!-- Base class for any person involved with Conan (member, prospect, trainer, …) -->
  <eClass xmi:type="ecore:EClass" name="Person">
    <eStructuralFeatures>
      <eAttribute name="firstName" eType="ecore:EString"/>
      <eAttribute name="familyName" eType="ecore:EString"/>
      <!-- Birth date stored as an EDate -->
      <eAttribute name="birthDate" eType="EDate"/>
      <!-- Operation that checks whether the (first‑name, family‑name, birth‑date) tuple is unique
           within the whole model.  The EMF validator will enforce uniqueness via the `unique`
           flag on the EAttributes. -->
      <eOperation name="isUnique">
        <eParameters>
          <eParameter name="other" type="Person"/>
          <eParameter name="result" type="EBoolean"/>
        </eParameters>
      </eOperation>
    </eStructuralFeatures>
  </eClass>

  <!-- A person that holds a diploma and can supervise group sessions -->
  <eClass xmi:type="ecore:EClass" name="Trainer" eSuperTypes="Person">
    <eStructuralFeatures>
      <!-- Diploma or certification held by the trainer -->
      <eAttribute name="diploma" eType="ecore:EString"/>
      <!-- All group sessions that this trainer has supervised (many‑to‑many) -->
      <eReference name="groupSessions" type="GroupSession" upper="-1" containment="false"/>
    </eStructuralFeatures>
  </eClass>

  <!-- Abstract base class for any fitness session (individual or group) -->
  <eClass xmi:type="ecore:EClass" name="Session">
    <eStructuralFeatures>
      <!-- Date on which the session occurs -->
      <eAttribute name="date" eType="EDate"/>
      <!-- Start time of the session, using java.time.LocalTime (time without date) -->
      <eAttribute name="startTime" eType="java.time.LocalTime"/>
      <!-- Room where the session takes place -->
      <eReference name="room" type="Room" containment="false"/>
    </eStructuralFeatures>
  </eClass>

  <!-- A session for a single participant without a trainer -->
  <eClass xmi:type="ecore:EClass" name="IndividualSession" eSuperTypes="Session">
    <!-- The person attending the individual session (may be more than one in edge cases) -->
    <eReference name="participant" type="Person" upper="-1" containment="false"/>
  </eClass>

  <!-- A group‑exercise session led by a trainer -->
  <eClass xmi:type="ecore:EClass" name="GroupSession" eSuperTypes="Session">
    <eStructuralFeatures>
      <!-- Type/category of the group exercise (e.g., aerobics, bodystyling) -->
      <eAttribute name="type" eType="ecore:EString"/>
      <!-- Trainer responsible for supervising this session -->
      <eReference name="trainer" type="Trainer" containment="false"/>
      <!-- All participants attending the group session -->
      <eReference name="participants" type="Person" upper="-1" containment="false"/>
    </eStructuralFeatures>
  </eClass>
</xmi:XMI>
