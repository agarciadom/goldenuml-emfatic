<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="conan"
    nsURI="http://www.conan.com/fitness"
    nsPrefix="conan">

  <!-- Custom datatype for time without date -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime"
      instanceClassName="java.time.LocalTime"/>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="FitnessSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="centers"
        eType="#//FitnessCenter" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="people"
        eType="#//Person" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- FitnessCenter -->
  <eClassifiers xsi:type="ecore:EClass" name="FitnessCenter">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms"
        eType="#//Room" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- Room -->
  <eClassifiers xsi:type="ecore:EClass" name="Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="number"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maximumCapacity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sessions"
        eType="#//Session" containment="true" upperBound="-1" eOpposite="#//Session/room"/>
  </eClassifiers>

  <!-- Person (superclass for both regular members and trainers) -->
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="familyName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="birthDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- A person may act as a trainer (has diploma info stored in Trainer subtype) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="trainerProfile"
        eType="#//Trainer" containment="true" upperBound="1"/>
    <!-- Participations in sessions (individual or group) via association class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="participations"
        eType="#//Participation" containment="true" upperBound="-1"
        eOpposite="#//Participation/participant"/>
  </eClassifiers>

  <!-- Trainer (not a separate top-level entity; embedded in Person as profile) -->
  <eClassifiers xsi:type="ecore:EClass" name="Trainer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diploma"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Group sessions supervised by this trainer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="supervisedSessions"
        eType="#//GroupSession" upperBound="-1" eOpposite="#//GroupSession/trainer"/>
  </eClassifiers>

  <!-- Abstract Session -->
  <eClassifiers xsi:type="ecore:EClass" name="Session" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startingHour"
        eType="#//LocalTime"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="room"
        eType="#//Room" eOpposite="#//Room/sessions"/>
    <!-- Participations in this session via association class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="participations"
        eType="#//Participation" upperBound="-1"
        eOpposite="#//Participation/session"/>
  </eClassifiers>

  <!-- IndividualSession -->
  <eClassifiers xsi:type="ecore:EClass" name="IndividualSession" eSuperTypes="#//Session">
  </eClassifiers>

  <!-- GroupSession -->
  <eClassifiers xsi:type="ecore:EClass" name="GroupSession" eSuperTypes="#//Session">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trainer"
        eType="#//Trainer" eOpposite="#//Trainer/supervisedSessions"/>
  </eClassifiers>

  <!-- Participation (association class between Person and Session) -->
  <eClassifiers xsi:type="ecore:EClass" name="Participation">
    <eStructuralFeatures xsi:type="ecore:EReference" name="participant"
        eType="#//Person" eOpposite="#//Person/participations"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="session"
        eType="#//Session" eOpposite="#//Session/participations"/>
  </eClassifiers>

</ecore:EPackage>
