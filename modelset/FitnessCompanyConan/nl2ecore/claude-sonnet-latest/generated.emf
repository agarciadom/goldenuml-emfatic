@namespace(uri="http://www.conan.com/fitness", prefix="conan")
package conan;

datatype LocalTime : java.time.LocalTime;

class FitnessSystem {
	val FitnessCenter[*] centers;
	val Person[*] people;
}

class FitnessCenter {
	attr String name;
	attr String address;
	val Room[*] rooms;
}

class Room {
	attr int number;
	attr int maximumCapacity;
	val Session[*]#room sessions;
}

class Person {
	attr String firstName;
	attr String familyName;
	attr EDate birthDate;
	val Trainer trainerProfile;
	val Participation[*]#participant participations;
}

class Trainer {
	attr String diploma;
	ref GroupSession[*]#trainer supervisedSessions;
}

abstract class Session {
	attr EDate date;
	attr LocalTime startingHour;
	ref Room#sessions room;
	ref Participation[*]#session participations;
}

class IndividualSession extends Session {
}

class GroupSession extends Session {
	attr String type;
	ref Trainer#supervisedSessions trainer;
}

class Participation {
	ref Person#participations participant;
	ref Session#participations session;
}


