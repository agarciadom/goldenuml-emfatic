@namespace(uri="http://www.example.org/ConanFitness", prefix="p")
package ConanFitness;

class Center {
  attr String name;
  attr String address;
  val Room[*] rooms;
}
class Room {
  attr Integer maximumCapacity;
  attr Integer number;
  ref Center center;
}
class Person {
  attr String firstName;
  attr String familyName;
  attr Date birthDate;
}
class Trainer extends Person {
  attr String diploma;
}
class Session {
  attr Date date;
  attr String startingHour;
  ref Room room;
  ref Center center;
  val Person[*] participants;
}
class IndividualSession extends Session {
}
class GroupSession extends Session {
  attr String type;
  val Trainer trainer;
}