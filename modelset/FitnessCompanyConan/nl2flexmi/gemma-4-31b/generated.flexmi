<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ConanFitness" nsURI="http://www.conanfitness.com" nsPrefix="conan">
  <eClassifiers>
    <eClass name="ConanSystem">
      <eStructuralFeatures>
        <eReference name="fitnessCenters" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="people" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="sessions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FitnessCenter">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="familyName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trainer" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures>
        <eAttribute name="diploma" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Session">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="startHour" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="room" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="participants" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GroupSession" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="trainer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="IndividualSession" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
