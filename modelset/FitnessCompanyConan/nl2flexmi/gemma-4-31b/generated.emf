@namespace(uri="http://www.conanfitness.com", prefix="conan")
package ConanFitness;

import "http://www.eclipse.org/emf/2002/Ecore";

class ConanSystem {
	val FitnessCenter[*] fitnessCenters;
	val Person[*] people;
	val Session[*] sessions;
}

class FitnessCenter {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	val Room[+] rooms;
}

class Room {
	attr ecore.EInt[1] number;
	attr ecore.EInt[1] capacity;
}

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] familyName;
	attr ecore.EDate[1] birthDate;
}

class Trainer extends Person {
	attr ecore.EString diploma;
}

class Session {
	attr ecore.EDate[1] date;
	attr ecore.EString[1] startHour;
	ref Room[1] room;
	ref Person[*] participants;
}

class GroupSession extends Session {
	attr ecore.EString[1] type;
	ref Trainer[1] trainer;
}

class IndividualSession extends Session {
}


