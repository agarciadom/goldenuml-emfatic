<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Conan" nsURI="http://www.example.org/Conan" nsPrefix="cn">
  <eClassifiers>
    <eClass name="Center">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="number" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="capacity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="sessions" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="familyName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="sessionsAsParticipant" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trainer" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="diploma" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="sessionsAsTrainer" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Session">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="startHour" lowerBound="1" upperBound="1" eType="//EFloat" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GroupSession" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="trainer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="IndividualSession" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
