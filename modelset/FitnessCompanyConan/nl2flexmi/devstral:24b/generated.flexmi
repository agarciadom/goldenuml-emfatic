<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="FitnessDB" nsURI="http://fitnessdb/" nsPrefix="fit">
  <eClassifiers>
    <eClass name="Center">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="rooms" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Room">
      <eStructuralFeatures>
        <eAttribute name="roomNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="maxCapacity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="center" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="birthDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trainer" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="diploma" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="groupSessionsSupervised" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Session">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="startHour" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="room" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="participants" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="GroupSession" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="sessionType" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="supervisor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
