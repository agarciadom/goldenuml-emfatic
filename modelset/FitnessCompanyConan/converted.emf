@namespace(uri="http://www.example.org/fitnessCenter", prefix="fitnessCenter")
package fitnessCenter;

class FitnessCenterModel {
	val Center[*] centers;
	val Person[*] persons;
	val Trainer[*] trainers;
}

class Center {
	attr String name;
	attr String address;
	val Room[+] rooms;
}

class Room {
	attr int roomNr;
	attr int maxCapacity;
	val Session[*] sessions;
}

abstract class Session {
	attr EDate startDateTime;
}

class IndividualSession extends Session {
	ref Member[1]#individualSessions member;
}

class GroupSession extends Session {
	attr String type;
	ref Member[*]#groupSessions members;
	ref Trainer[1]#groupSessions trainer;
}

abstract class Person {
	attr String firstName;
	attr String lastName;
	attr EDate birthDate;
}

class Member extends Person {
	ref IndividualSession[*]#member individualSessions;
	ref GroupSession[*]#members groupSessions;
}

class Trainer extends Person {
	attr String diploma;
	ref GroupSession[*]#trainer groupSessions;
}


