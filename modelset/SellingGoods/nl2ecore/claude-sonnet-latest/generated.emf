@namespace(uri="http://www.example.org/supplychain", prefix="supplychain")
package supplychain;

datatype LocalTime : java.time.LocalTime;

class SupplyChainSystem {
	val Customer[*] customers;
	val Product[*] products;
	val Order[*] orders;
	val Shipment[*] shipments;
}

class Address {
	attr String street;
	attr String city;
	attr String postalCode;
	attr String country;
}

class Warehouse {
	val Address address;
	ref Customer#warehouses customer;
}

class Customer {
	attr String vatNumber;
	val Address headOfficeAddress;
	val Warehouse[*]#customer warehouses;
	ref Order[*]#customer orders;
}

class Product {
	attr String name;
	attr String description;
	attr double price;
	attr int stockLevel;
}

enum OrderStatus {
	PLACED = 0;
	PAID = 1;
	PARTIALLY_SHIPPED = 2;
	FULLY_SHIPPED = 3;
}

enum PaymentTiming {
	ON_ORDER = 0;
	AFTER_DELIVERY = 1;
}

class Invoice {
	attr EDate issueDate;
	attr double totalAmount;
	attr boolean paid;
	attr EDate paymentDate;
	ref Order#invoice order;
}

class Order {
	attr EDate orderDate;
	attr OrderStatus status;
	attr EDate paymentDate;
	attr PaymentTiming paymentTiming;
	ref Customer#orders customer;
	val OrderLine[*]#order orderLines;
	ref Warehouse deliveryWarehouse;
	val Invoice#order invoice;
	ref Shipment[*]#order shipments;
}

enum OrderLineStatus {
	PENDING = 0;
	SHIPPED = 1;
}

class OrderLine {
	attr int quantity;
	attr OrderLineStatus status;
	ref Product product;
	ref Order#orderLines order;
	ref Shipment#orderLines shipment;
}

enum ShipmentStatus {
	PACKING = 0;
	SHIPPED = 1;
	RECEIVED = 2;
}

class Shipment {
	attr EDate shipmentDate;
	attr EDate receivedDate;
	attr ShipmentStatus status;
	attr String trackingNumber;
	ref Order#shipments order;
	ref OrderLine[*]#shipment orderLines;
}


