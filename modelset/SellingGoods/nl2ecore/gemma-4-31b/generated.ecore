<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ePackage name="SellingGoods" nsURI="http://www.example.org/sellinggoods">
    <eClass name="SystemRoot">
      <eStructuralFeatures>
        <eReference name="customers" reference="Customer" containment="true"/>
        <eReference name="products" reference="Product" containment="true"/>
        <eReference name="orders" reference="Order" containment="true"/>
        <eReference name="shipments" reference="Shipment" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="headOfficeAddress" eType="eString"/>
        <eAttribute name="vatNumber" eType="eString"/>
        <eReference name="orders" reference="Order"/>
        <eReference name="deliveryAddresses" reference="DeliveryAddress" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="DeliveryAddress">
      <eStructuralFeatures>
        <eAttribute name="addressDetails" eType="eString"/>
        <eReference name="customer" reference="Customer"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="productName" eType="eString"/>
        <eAttribute name="currentStock" eType="eInt"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="paymentDate" eType="eDate"/>
        <eAttribute name="isPaidInFull" eType="eBoolean"/>
        <eAttribute name="isFullyShipped" eType="eBoolean"/>
        <eReference name="customer" reference="Customer"/>
        <eReference name="deliveryAddress" reference="DeliveryAddress"/>
        <eReference name="invoice" reference="Invoice" containment="true"/>
        <eReference name="orderLines" reference="OrderLine" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="OrderLine">
      <eStructuralFeatures>
        <eAttribute name="quantity" eType="eInt"/>
        <eReference name="product" reference="Product"/>
        <eReference name="order" reference="Order"/>
        <eReference name="shipment" reference="Shipment"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceDate" eType="eDate"/>
        <eAttribute name="amount" eType="eDouble"/>
        <eReference name="order" reference="Order"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Shipment">
      <eStructuralFeatures>
        <eAttribute name="shipDate" eType="eDate"/>
        <eReference name="status" reference="ShipmentStatus"/>
        <eReference name="orderLines" reference="OrderLine"/>
      </eStructuralFeatures>
    </eClass>

    <eEnum name="ShipmentStatus">
      <eLiteral name="PACKED"/>
      <eLiteral name="SHIPPED"/>
      <eLiteral name="RECEIVED"/>
    </eEnum>
  </ePackage>
</xmi:XMI>
