<xmi:XMI id="" version="2.0"
     xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" >
  <ecore:EPackage xmi:type="ecore:EPackage" xmi:id="" name="company" nsURI="company" eNSPrefix="comp">
    <!-- Root container class -->
    <eClassifiers>
      <eClassifiers xmi:type="ecore:EClass" xmi:id="CompanyModel">
        <eStructuralFeatures>
          <eReference name="customers" eType="Customer" containment="true"/>
          <eReference name="products" eType="Product" containment="true"/>
          <eReference name="orders" eType="Order" containment="true"/>
          <eReference name="deliveries" eType="Delivery" containment="true"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- Customer class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="Customer">
        <eStructuralFeatures>
          <eAttribute name="address" eType="ecore:EString"/>
          <eAttribute name="vatNumber" eType="ecore:EString"/>
          <eReference name="headOfficeAddress" eType="Address"/>
          <eReference name="deliveryAddresses" eType="Address" upper="-1"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- Address class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="Address">
        <eStructuralFeatures>
          <eAttribute name="street" eType="ecore:EString"/>
          <eAttribute name="city" eType="ecore:EString"/>
          <eAttribute name="postalCode" eType="ecore:EString"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- Product class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="Product">
        <eStructuralFeatures>
          <eAttribute name="name" eType="ecore:EString"/>
          <eAttribute name="stockQuantity" eType="ecore:ELong"/>
          <eAttribute name="exclusive" eType="ecore:EBoolean"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- Order class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="Order">
        <eStructuralFeatures>
          <eReference name="customer" eType="Customer"/>
          <eAttribute name="totalAmount" eType="ecore:EDouble"/>
          <eAttribute name="paid" eType="ecore:EBoolean"/>
          <eAttribute name="shipped" eType="ecore:EBoolean"/>
          <eReference name="orderLines" eType="OrderLine" containment="true"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- OrderLine class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="OrderLine">
        <eStructuralFeatures>
          <eReference name="order" eType="Order"/>
          <eReference name="product" eType="Product"/>
          <eAttribute name="quantity" eType="ecore:ELong"/>
          <eAttribute name="shipped" eType="ecore:EBoolean"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- Invoice class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="Invoice">
        <eStructuralFeatures>
          <eReference name="order" eType="Order"/>
          <eAttribute name="amount" eType="ecore:EDouble"/>
          <eAttribute name="paidImmediately" eType="ecore:EBoolean"/>
        </eStructuralFeatures>
        <eOperations>
          <eOperations xmi:type="ecore:EOperation" xmi:id="" name="sendInvoice">
            <eTypeParameters/>
            <eParameters>
              <eParameters xmi:type="ecore:EParameter" xmi:id="" name="email" eType="ecore:EString"/>
            </eParameters>
          </eOperations>
        </eOperations>
      </eClassifiers>

      <!-- Delivery class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="Delivery">
        <eStructuralFeatures>
          <eReference name="orderGroup" eType="OrderGroup"/>
          <eAttribute name="status" eType="DeliveryStatus"/>
          <eAttribute name="packedTime" eType="java.time.LocalTime"/>
          <eAttribute name="shippedTime" eType="java.time.LocalDateTime"/>
          <eAttribute name="receivedTime" eType="java.time.LocalDateTime"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- OrderGroup class -->
      <eClassifiers xmi:type="ecore:EClass" xmi:id="OrderGroup">
        <eStructuralFeatures>
          <eReference name="orderLines" eType="OrderLine" containment="true"/>
          <eReference name="delivery" eType="Delivery"/>
        </eStructuralFeatures>
      </eClassifiers>

      <!-- Enumerations -->
      <eClassifiers xmi:type="ecore:EEnum" xmi:id="DeliveryStatus">
        <eLiterals>
          <eLiterals xmi:type="ecore:EEnumLiteral" xmi:id="" name="Packed"/>
          <eLiterals xmi:type="ecore:EEnumLiteral" xmi:id="" name="Shipped"/>
          <eLiterals xmi:type="ecore:EEnumLiteral" xmi:id="" name="Received"/>
        </eLiterals>
      </eClassifiers>

    </eClassifiers>
  </ecore:EPackage>
</xmi:XMI>
