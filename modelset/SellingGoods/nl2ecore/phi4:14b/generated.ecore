<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.1"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">

  <!-- Root package -->
  
  <eClassifiers xsi:type="ecore:EEnum" name="ShipmentStatus">
    <eAnnotations>
      <source>Shipped Status</source>
    </eAnnotations>
    <eLiterals>
      <eEnumLiteral literal="PACKED"/>
      <eEnumLiteral literal="SHIPPED"/>
      <eEnumLiteral literal="RECEIVED"/>
    </eLiterals>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Company">
    <eStructuralFeatures>
      <eManyToMany supplierRole="customers" eType="#//Customer"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures>
      <eAttribute name="address" type="string"/>
      <eAttribute name="vatNumber" type="string"/>
      <eManyToMany supplierRole="orders" eType="#//Order"/>
      <eOneToOne eOpposite="headOffice" container="true" eType="#//CustomerAddress"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures>
      <eAttribute name="name" type="string"/>
      <eAttribute name="stockLevel" type="int"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures>
      <eReference eType="#//Customer" lower="1" upper="1" containment="false"/>
      <eOneToMany eOpposite="order" container="true" eType="#//OrderLine"/>
      <eReference type="#//Invoice" multiplicity="(0 -1)" containment="false"/>
      <eMany target="deliveries" eType="#//Delivery"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="OrderLine">
    <eStructuralFeatures>
      <eAttribute name="quantity" type="int"/>
      <eReference eOpposite="orderLines" upper="1" lower="1" containment="false" eType="#//Product"/>
      <eAttribute name="isShipped" type="boolean" initialValue="false"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <eStructuralFeatures>
      <eReference eOpposite="invoice" container="false" eType="#//Order" multiplicity="(1 -1)"/>
      <eAttribute name="paymentStatus" type="string"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Delivery">
    <eStructuralFeatures>
      <eReference eType="#//Order" lower="1" upper="1" containment="false"/>
      <eAttribute name="status" type="#//ShipmentStatus"/>
    </eStructuralFeatures>
  </eClassifiers>

  <!-- Association classes for multiple warehouses/delivery addresses -->
  <eClassifiers xsi:type="ecore:EClass" name="CustomerAddress">
    <eStructuralFeatures>
      <eMany eOpposite="addresses"
        upper="-1" lower="0" containment="false"
        eType="#//DeliveryAddress"/>
    </eStructuralFeatures>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DeliveryAddress">
    <eStructuralFeatures>
      <eReference eOpposite="addresses" eType="#//CustomerAddress" upper="1" lower="1" containment="false"/>
      <eAttribute name="addressLine" type="string"/>
    </eStructuralFeatures>
  </eClassifiers>

</ecore:EPackage>
