<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="orderManagement" nsURI="http://www.example.org/orderManagement"
    nsPrefix="orderManagement">
  <eClassifiers xsi:type="ecore:EClass" name="Store">
    <eStructuralFeatures xsi:type="ecore:EReference" name="products" upperBound="-1"
        eType="#//Product" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers" upperBound="-1"
        eType="#//Customer" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stock" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLines" upperBound="-1"
        eType="#//OrderLine" eOpposite="#//OrderLine/product"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vatNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orders" upperBound="-1"
        eType="#//Order" containment="true" eOpposite="#//Order/customer"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deliveryAddress" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer" eType="#//Customer"
        eOpposite="#//Customer/orders"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLines" upperBound="-1"
        eType="#//OrderLine" containment="true" eOpposite="#//OrderLine/order"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices" upperBound="-1"
        eType="#//Invoice" containment="true" eOpposite="#//Invoice/order"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliveries" upperBound="-1"
        eType="#//Delivery" containment="true" eOpposite="#//Delivery/order"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="OrderLine">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lineNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="product" eType="#//Product"
        eOpposite="#//Product/orderLines"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="order" eType="#//Order"
        eOpposite="#//Order/orderLines"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLine" eType="#//InvoiceLine"
        eOpposite="#//InvoiceLine/orderLine"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliveryLine" eType="#//DeliveryLine"
        eOpposite="#//DeliveryLine/orderLine"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <eStructuralFeatures xsi:type="ecore:EReference" name="order" eType="#//Order"
        eOpposite="#//Order/invoices"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLines" upperBound="-1"
        eType="#//InvoiceLine" containment="true" eOpposite="#//InvoiceLine/invoice"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="InvoiceLine">
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice" eType="#//Invoice"
        eOpposite="#//Invoice/invoiceLines"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLine" eType="#//OrderLine"
        eOpposite="#//OrderLine/invoiceLine"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Delivery">
    <eStructuralFeatures xsi:type="ecore:EReference" name="order" eType="#//Order"
        eOpposite="#//Order/deliveries"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliveryLines" upperBound="-1"
        eType="#//DeliveryLine" containment="true" eOpposite="#//DeliveryLine/delivery"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DeliveryLine">
    <eStructuralFeatures xsi:type="ecore:EReference" name="delivery" eType="#//Delivery"
        eOpposite="#//Delivery/deliveryLines"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLine" eType="#//OrderLine"
        eOpposite="#//OrderLine/deliveryLine"/>
  </eClassifiers>
</ecore:EPackage>
