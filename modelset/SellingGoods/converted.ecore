<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="orderManagement"
    nsURI="http://www.example.org/orderManagement"
    nsPrefix="orderManagement">

  <!-- Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="Store">
    <eStructuralFeatures xsi:type="ecore:EReference" name="products"
        eType="#//Product" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers"
        eType="#//Customer" containment="true" upperBound="-1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="stock"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Association: Product to OrderLine (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLines"
        eType="#//OrderLine" upperBound="-1" eOpposite="#//OrderLine/product"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vaTnumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Association: Customer to Order (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="orders"
        eType="#//Order" containment="true" upperBound="-1" eOpposite="#//Order/customer"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deliveryAddress"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Back-reference to Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer"
        eType="#//Customer" eOpposite="#//Customer/orders"/>
    <!-- Association: Order to OrderLine (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLines"
        eType="#//OrderLine" containment="true" upperBound="-1" eOpposite="#//OrderLine/order"/>
    <!-- Association: Order to Invoice (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices"
        eType="#//Invoice" containment="true" upperBound="-1" eOpposite="#//Invoice/order"/>
    <!-- Association: Order to Delivery (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliveries"
        eType="#//Delivery" containment="true" upperBound="-1" eOpposite="#//Delivery/order"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="OrderLine">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lineNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="quantity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <!-- Back-reference to Product -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="product"
        eType="#//Product" eOpposite="#//Product/orderLines"/>
    <!-- Back-reference to Order -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="order"
        eType="#//Order" eOpposite="#//Order/orderLines"/>
    <!-- Association: OrderLine to InvoiceLine (1 to 0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLine"
        eType="#//InvoiceLine" eOpposite="#//InvoiceLine/orderLine"/>
    <!-- Association: OrderLine to DeliveryLine (1 to 0..1) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliveryLine"
        eType="#//DeliveryLine" eOpposite="#//DeliveryLine/orderLine"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <!-- Back-reference to Order -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="order"
        eType="#//Order" eOpposite="#//Order/invoices"/>
    <!-- Association: Invoice to InvoiceLine (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLines"
        eType="#//InvoiceLine" containment="true" upperBound="-1" eOpposite="#//InvoiceLine/invoice"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="InvoiceLine">
    <!-- Back-reference to Invoice -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice"
        eType="#//Invoice" eOpposite="#//Invoice/invoiceLines"/>
    <!-- Back-reference to OrderLine -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLine"
        eType="#//OrderLine" eOpposite="#//OrderLine/invoiceLine"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Delivery">
    <!-- Back-reference to Order -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="order"
        eType="#//Order" eOpposite="#//Order/deliveries"/>
    <!-- Association: Delivery to DeliveryLine (1 to 0..*) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="deliveryLines"
        eType="#//DeliveryLine" containment="true" upperBound="-1" eOpposite="#//DeliveryLine/delivery"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="DeliveryLine">
    <!-- Back-reference to Delivery -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="delivery"
        eType="#//Delivery" eOpposite="#//Delivery/deliveryLines"/>
    <!-- Back-reference to OrderLine -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="orderLine"
        eType="#//OrderLine" eOpposite="#//OrderLine/deliveryLine"/>
  </eClassifiers>

</ecore:EPackage>
