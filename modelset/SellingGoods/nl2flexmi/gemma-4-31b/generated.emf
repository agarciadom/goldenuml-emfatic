@namespace(uri="http://company.com/stockmanagement", prefix="csm")
package CompanyStockManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Customer {
	attr ecore.EString vatNumber;
	ref Address[1] headOfficeAddress;
}

class Address {
	attr ecore.EString street;
	attr ecore.EString city;
	attr ecore.EString zipCode;
	attr ecore.EString country;
}

class Product {
	attr ecore.EString name;
	attr ecore.EInt currentStock;
}

class Order {
	attr ecore.EDate orderDate;
	attr ecore.EDate paidDate;
	ref Customer[1] customer;
	ref Address[1] deliveryAddress;
	val OrderLine[+] orderLines;
}

class OrderLine {
	attr ecore.EInt[1] quantity;
	ref Product[1] product;
	ref Shipment shipment;
}

class Shipment {
	attr ecore.EString status;
	attr ecore.EDate shipDate;
	ref OrderLine[+] shippedLines;
}


