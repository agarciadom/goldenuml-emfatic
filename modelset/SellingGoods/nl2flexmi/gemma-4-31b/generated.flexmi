<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CompanyStockManagement" nsURI="http://company.com/stockmanagement" nsPrefix="csm">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="vatNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="headOfficeAddress" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Address">
      <eStructuralFeatures>
        <eAttribute name="street" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="city" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="zipCode" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="country" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="currentStock" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="orderDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="paidDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="deliveryAddress" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="orderLines" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="OrderLine">
      <eStructuralFeatures>
        <eAttribute name="quantity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="shipment" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shipment">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="shipDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="shippedLines" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
