<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="CompanySystem" nsURI="http://companysystem/model" nsPrefix="cs">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="vatNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="orders" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eAttribute name="headOfficeAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="stock" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="isPaid" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isShipped" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="orderLines" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
        <eAttribute name="isPartiallyShipped" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="deliveryAddresses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eAttribute name="invoiceNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="invoiceDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="shipments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="OrderLine">
      <eStructuralFeatures>
        <eAttribute name="quantity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="order" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="isShipped" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isFullyShipped" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shipment">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="orderLines" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
