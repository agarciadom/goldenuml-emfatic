@namespace(uri="http://www.example.org/salessystem", prefix="sales")
package SalesSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Customer {
	attr ecore.EString[1] address;
	attr ecore.EString[1] vatNumber;
	val Order[*] orders;
	attr ecore.EString headOfficeAddress;
}

class Product {
	attr ecore.EString[1] name;
	attr ecore.EInt[1] stock;
}

class Order {
	attr ecore.EDate[1] orderDate;
	attr ecore.EDate paidDate;
	val OrderLine[+] orderLines;
	attr ecore.EBoolean fullyShipped;
	attr ecore.EString[1] deliveryAddress;
	attr ecore.EDate invoiceDate;
	attr ecore.EBoolean isPaid;
	val Shipment[*] shipments;
}

class OrderLine {
	attr ecore.EInt[1] quantity;
	ref Product[1] product;
}

class Shipment {
	attr ecore.EString[1] status;
	attr ecore.EDate shippedDate;
	val OrderLine[+] orderLines;
	ref Order[1] order;
}


