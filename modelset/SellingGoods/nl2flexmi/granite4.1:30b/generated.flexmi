<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Company" nsURI="http://example.com/company" nsPrefix="comp">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eReference name="orders" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="vatNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="stockQuantity" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="orderDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="paidDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="shippedDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="orderLines" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="deliveries" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="OrderLine">
      <eStructuralFeatures>
        <eAttribute name="quantity" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="order" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Delivery">
      <eStructuralFeatures>
        <eAttribute name="packedDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="shippedDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="receivedDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="order" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CustomerHeadOffice" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="headOfficeAddress" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
