@namespace(uri="http://example.com/company", prefix="comp")
package Company;

import "http://www.eclipse.org/emf/2002/Ecore";

class Customer {
	ref Order[*] orders;
	attr ecore.EString address;
	attr ecore.EString vatNumber;
}

class Product {
	attr ecore.EString name;
	attr ecore.EInt stockQuantity;
}

class Order {
	attr ecore.EDate orderDate;
	attr ecore.EDate paidDate;
	attr ecore.EDate shippedDate;
	ref Customer[1] customer;
	val OrderLine orderLines;
	val Delivery deliveries;
}

class OrderLine {
	attr ecore.EInt quantity;
	ref Product[1] product;
	ref Order[1] order;
}

class Delivery {
	attr ecore.EDate packedDate;
	attr ecore.EDate shippedDate;
	attr ecore.EDate receivedDate;
	attr ecore.EString status;
	ref Order[1] order;
}

class CustomerHeadOffice extends Customer {
	attr ecore.EString headOfficeAddress;
}


