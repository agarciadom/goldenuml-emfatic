<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="SupplyChain" nsURI="http://www.example.com/supplychain" nsPrefix="sc">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="VAT_number" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="headOfficeAddress" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="stockItem" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="StockItem">
      <eStructuralFeatures>
        <eAttribute name="quantity" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="productID" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="orderLines" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="paymentStatus" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="deliveryAddress" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="OrderLine">
      <eStructuralFeatures>
        <eReference name="product" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="quantity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isShipped" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Shipment">
      <eStructuralFeatures>
        <eReference name="orderLines" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.4" />
        <eAttribute name="packingStatus" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="shippingStatus" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="receivingStatus" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
