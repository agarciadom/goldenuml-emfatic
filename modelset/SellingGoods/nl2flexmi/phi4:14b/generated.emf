@namespace(uri="http://www.example.com/supplychain", prefix="sc")
package SupplyChain;

import "http://www.eclipse.org/emf/2002/Ecore";

class Customer {
	attr ecore.EString[1] address;
	attr ecore.EString[1] VAT_number;
	attr ecore.EString headOfficeAddress;
}

class Product {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	val StockItem stockItem;
}

class StockItem {
	attr ecore.EInt quantity;
	attr ecore.EInt[1] productID;
}

class Order {
	ref Customer[1] customer;
	val OrderLine[*] orderLines;
	attr ecore.EString[1] status;
	attr ecore.EString[1] paymentStatus;
	attr ecore.EString deliveryAddress;
}

class OrderLine {
	val Product[1] product;
	attr ecore.EInt[1] quantity;
	attr ecore.EBoolean[1] isShipped;
}

class Shipment {
	val OrderLine[+] orderLines;
	attr ecore.EString[1] packingStatus;
	attr ecore.EString[1] shippingStatus;
	attr ecore.EString receivingStatus;
}


