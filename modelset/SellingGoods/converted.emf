@namespace(uri="http://www.example.org/orderManagement", prefix="orderManagement")
package orderManagement;

class Product {
	attr String Name;
	attr int Stock;
	ref OrderLine[*]#product orderLines;
}

class Customer {
	attr String Name;
	attr String Address;
	attr String VATnumber;
	ref Order[*]#customer orders;
}

class OrderLine {
	attr String LineNumber;
	attr int Quantity;
	ref Product[1]#orderLines product;
	ref InvoiceLine#orderLine invoiceLine;
	ref DeliveryLine#orderLine deliveryLine;
	ref Order[1]#orderLines order;
}

class InvoiceLine {
	ref OrderLine[1]#invoiceLine orderLine;
	ref Invoice[1]#invoiceLines invoice;
}

class Order {
	attr String OrderNumber;
	attr String DeliveryAddress;
	ref Customer[1]#orders customer;
	ref Invoice[*]#order invoices;
	ref Delivery[*]#order deliveries;
	ref OrderLine[*]#order orderLines;
}

class Invoice {
	ref Order[1]#invoices order;
	ref InvoiceLine[*]#invoice invoiceLines;
}

class DeliveryLine {
	ref OrderLine[1]#deliveryLine orderLine;
	ref Delivery[1]#deliveryLines delivery;
}

class Delivery {
	ref Order[1]#deliveries order;
	ref DeliveryLine[*]#delivery deliveryLines;
}


