@namespace(uri="http://www.example.org/orderManagement", prefix="orderManagement")
package orderManagement;

class Store {
	val Product[*] products;
	val Customer[*] customers;
}

class Product {
	attr String name;
	attr int stock;
	ref OrderLine[*]#product orderLines;
}

class Customer {
	attr String name;
	attr String address;
	attr String vatNumber;
	val Order[*]#customer orders;
}

class Order {
	attr String orderNumber;
	attr String deliveryAddress;
	ref Customer#orders customer;
	val OrderLine[*]#order orderLines;
	val Invoice[*]#order invoices;
	val Delivery[*]#order deliveries;
}

class OrderLine {
	attr String lineNumber;
	attr int quantity;
	ref Product#orderLines product;
	ref Order#orderLines order;
	ref InvoiceLine#orderLine invoiceLine;
	ref DeliveryLine#orderLine deliveryLine;
}

class Invoice {
	ref Order#invoices order;
	val InvoiceLine[*]#invoice invoiceLines;
}

class InvoiceLine {
	ref Invoice#invoiceLines invoice;
	ref OrderLine#invoiceLine orderLine;
}

class Delivery {
	ref Order#deliveries order;
	val DeliveryLine[*]#delivery deliveryLines;
}

class DeliveryLine {
	ref Delivery#deliveryLines delivery;
	ref OrderLine#deliveryLine orderLine;
}


