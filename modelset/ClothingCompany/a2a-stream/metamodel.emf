@namespace(uri="http://clothingstore.com", prefix="p")
package ClothingStore;

class Country {
  attr EString name;
  attr VATRate[*] vatRate;
  attr Currency currency;
  val Product[*] availableProducts;
}
class VATRate {
  attr EDouble rate;
}
class Currency {
  attr EString code;
  attr EString symbol;
  attr EDouble conversionRateToEuro;
}
class ProductType {
  attr EString SHOES;
  attr EString HEADWEAR;
  attr EString OTHER;
}
class Product {
  attr EString name;
  attr EString description;
  attr EDouble netPrice;
  attr EString manufacturer;
  ref Country countryOfManufacture;
  ref Currency currency;
  ref ProductType type;
  val Country[*] availableInCountry;
  ref Country[*] availableInCountries;
}
class Representative {
  attr EString ~id;
  attr EString firstName;
  attr EString lastName;
  attr EString ssn;
  attr EString phoneNumber;
  attr EString email;
  ref Country responsibleCountry;
  ref Country[*] countries;
}
class Customer {
  attr EString name;
  attr EString address;
  attr EString phoneNumber;
  attr EString email;
  ref Country[*] resellCountries;
}
class Order {
  attr EString ~id;
  attr EInt quantity;
  attr EDate orderDate;
  attr EDate deliveryDate;
  ref Product product;
  ref Representative representative;
  ref Customer customer;
}