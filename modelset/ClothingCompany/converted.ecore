<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="orderManagement"
    nsURI="http://www.example.org/orderManagement"
    nsPrefix="orderManagement">

  <!-- Root container class -->
  <eClassifiers xsi:type="ecore:EClass" name="OrderManagementSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="orders"
        eType="#//Order" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="categories"
        eType="#//Category" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="products"
        eType="#//Product" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="representatives"
        eType="#//Representative" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manufacturers"
        eType="#//Manufacturer" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="countries"
        eType="#//Country" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers"
        eType="#//Customer" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="manufacturerCountries"
        eType="#//ManufacturerCountry" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- Association class for Manufacturer - Country -->
  <eClassifiers xsi:type="ecore:EClass" name="ManufacturerCountry">
    <eStructuralFeatures xsi:type="ecore:EReference" name="manufacturer"
        eType="#//Manufacturer" lowerBound="1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="country"
        eType="#//Country" lowerBound="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Order">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderQuantity"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="orderDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deliveryDate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <!-- Reference to Product (many Orders to one Product, from Product side it is 1 to many) -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="product"
        eType="#//Product" lowerBound="1"/>
    <!-- Reference to Representative -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="placedBy"
        eType="#//Representative" lowerBound="1"/>
    <!-- Reference to Customer -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer"
        eType="#//Customer" lowerBound="1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Category">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Opposite side: Category contains many Products -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="products"
        eType="#//Product" upperBound="-1" eOpposite="#//Product/category"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Product">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="netPrice"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <!-- Product belongs to one Category -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="category"
        eType="#//Category" lowerBound="1" eOpposite="#//Category/products"/>
    <!-- Product is linked via ManufacturerCountry association class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manufacturerCountry"
        eType="#//ManufacturerCountry" lowerBound="1"/>
    <!-- Product sold in many Countries -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="soldIn"
        eType="#//Country" upperBound="-1" eOpposite="#//Country/products"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Representative">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ssn"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Representative is responsible for one Country -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="responsibleFor"
        eType="#//Country" lowerBound="1" eOpposite="#//Country/representatives"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Manufacturer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Manufacturer linked via ManufacturerCountry association class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manufacturerCountries"
        eType="#//ManufacturerCountry" upperBound="-1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Country">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="vat"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currency"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="conversionRate"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <!-- Country linked via ManufacturerCountry association class -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="manufacturerCountries"
        eType="#//ManufacturerCountry" upperBound="-1"/>
    <!-- Opposite of Product soldIn -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="products"
        eType="#//Product" upperBound="-1" eOpposite="#//Product/soldIn"/>
    <!-- Opposite of Representative responsibleFor -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="representatives"
        eType="#//Representative" upperBound="-1" eOpposite="#//Representative/responsibleFor"/>
    <!-- Country resells to many Customers -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="customers"
        eType="#//Customer" upperBound="-1" eOpposite="#//Customer/countries"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <!-- Opposite of Country resell -->
    <eStructuralFeatures xsi:type="ecore:EReference" name="countries"
        eType="#//Country" upperBound="-1" eOpposite="#//Country/customers"/>
  </eClassifiers>

</ecore:EPackage>
