<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ClothingManagement" nsURI="http://clothing.company/model" nsPrefix="clo">
  <eClassifiers>
    <eClass name="Entity">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CountryInfo" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="vatRate" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="currency" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="euroConversionRate" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Representative" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="country" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="netPrice" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="manufacturerName" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="manufacturerCountry" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="resellCountries" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="orderId" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="quantity" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="orderDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="deliveryDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="representative" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
