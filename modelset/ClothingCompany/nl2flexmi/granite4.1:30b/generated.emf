@namespace(uri="http://clothing.company/model", prefix="clo")
package ClothingManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Entity {
	attr ecore.EString name;
	attr ecore.EString description;
}

class CountryInfo extends Entity {
	attr ecore.EDouble vatRate;
	attr ecore.EString currency;
	attr ecore.EDouble euroConversionRate;
}

class Representative extends Entity {
	attr ecore.EString firstName;
	attr ecore.EString lastName;
	attr ecore.EString socialSecurityNumber;
	attr ecore.EString phoneNumber;
	attr ecore.EString emailAddress;
	ref CountryInfo[1] country;
}

class Product extends Entity {
	attr ecore.EDouble netPrice;
	attr ecore.EString manufacturerName;
	ref CountryInfo manufacturerCountry;
}

class Customer extends Entity {
	attr ecore.EString address;
	attr ecore.EString phoneNumber;
	attr ecore.EString emailAddress;
	ref CountryInfo[*] resellCountries;
}

class Order extends Entity {
	attr ecore.EString orderId;
	attr ecore.EInt quantity;
	attr ecore.EDate orderDate;
	attr ecore.EDate deliveryDate;
	ref Product[1] product;
	ref Representative[1] representative;
}


