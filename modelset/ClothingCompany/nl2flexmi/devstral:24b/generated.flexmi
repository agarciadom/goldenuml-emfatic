<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ClothingManagement" nsURI="http://www.example.com/clothingmanagement" nsPrefix="cm">
  <eClassifiers>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="netPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="manufacturer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="availableInCountry" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Country">
      <eStructuralFeatures>
        <eAttribute name="vatRate" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="currency" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="conversionRateToEuro" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Manufacturer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Representative">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="socialSecurityNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="telephoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="country" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="telephoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="resellCountries" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="identifier" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="orderQuantity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="orderDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="desiredDeliveryDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="representative" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
