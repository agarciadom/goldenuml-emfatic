@namespace(uri="http://www.example.com/clothingmanagement", prefix="cm")
package ClothingManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Product {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	attr ecore.EBigDecimal[1] netPrice;
	ref Manufacturer[1] manufacturer;
	ref Country[*] availableInCountry;
}

class Country {
	attr ecore.EBigDecimal[1] vatRate;
	attr ecore.EString[1] currency;
	attr ecore.EBigDecimal[1] conversionRateToEuro;
}

class Manufacturer {
	attr ecore.EString[1] name;
}

class Representative {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] socialSecurityNumber;
	attr ecore.EString[1] telephoneNumber;
	attr ecore.EString emailAddress;
	ref Country[1] country;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString address;
	attr ecore.EString[1] telephoneNumber;
	attr ecore.EString emailAddress;
	ref Country[*] resellCountries;
}

class Order {
	attr ecore.EString[1] identifier;
	attr ecore.EInt[1] orderQuantity;
	attr ecore.EDate[1] orderDate;
	attr ecore.EDate desiredDeliveryDate;
	ref Product[1] product;
	ref Customer[1] customer;
	ref Representative[1] representative;
}


