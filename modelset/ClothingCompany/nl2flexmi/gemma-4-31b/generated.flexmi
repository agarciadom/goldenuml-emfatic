<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ClothingCompanyManagement" nsURI="http://www.example.com/clothing" nsPrefix="clothing">
  <eClassifiers>
    <eClass name="ClothingCompany">
      <eStructuralFeatures>
        <eReference name="products" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="countries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="representatives" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="orders" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="availabilities" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Country">
      <eStructuralFeatures>
        <eAttribute name="vatRate" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="currency" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="conversionRateToEuro" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="netPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="manufacturingCountry" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Representative">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="ssn" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phone" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="responsibleCountry" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phone" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="resellCountries" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="orderQuantity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="orderDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="deliveryDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="representative" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="customer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ProductCountryAvailability">
      <eStructuralFeatures>
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="country" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
