@namespace(uri="http://www.example.com/clothing", prefix="clothing")
package ClothingCompanyManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class ClothingCompany {
	val Product[*] products;
	val Country[*] countries;
	val Representative[*] representatives;
	val Customer[*] customers;
	val Order[*] orders;
	val ProductCountryAvailability[*] availabilities;
}

class Country {
	attr ecore.EDouble[1] vatRate;
	attr ecore.EString[1] currency;
	attr ecore.EDouble[1] conversionRateToEuro;
}

class Product {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	attr ecore.EBigDecimal[1] netPrice;
	ref Country[1] manufacturingCountry;
}

class Representative {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] ssn;
	attr ecore.EString phone;
	attr ecore.EString email;
	ref Country[1] responsibleCountry;
}

class Customer {
	attr ecore.EString[1] name;
	attr ecore.EString[1] address;
	attr ecore.EString phone;
	attr ecore.EString email;
	ref Country[*] resellCountries;
}

class Order {
	attr ecore.EInt[1] orderQuantity;
	attr ecore.EDate[1] orderDate;
	attr ecore.EDate[1] deliveryDate;
	ref Product[1] product;
	ref Representative[1] representative;
	ref Customer[1] customer;
}

class ProductCountryAvailability {
	ref Product[1] product;
	ref Country[1] country;
}


