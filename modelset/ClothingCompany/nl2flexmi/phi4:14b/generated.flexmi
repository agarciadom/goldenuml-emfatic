<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="ClothingManagement" nsURI="http://example.com/ClothingManagement" nsPrefix="cm">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="telephone_number" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email_address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Product">
      <eStructuralFeatures>
        <eAttribute name="unique_name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="net_price" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="manufacturer_country" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eAttribute name="vat_rate" lowerBound="0" upperBound="1" eType="VAT" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="identifier" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="product" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="order_quantity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="order_date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="desired_delivery_date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="representative" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Country">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="vat_rate" lowerBound="1" upperBound="1" eType="VAT" />
        <eAttribute name="currency" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="conversion_rate_to_euro" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Representative">
      <eStructuralFeatures>
        <eAttribute name="first_name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="last_name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="social_security_number" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="telephone_number" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
