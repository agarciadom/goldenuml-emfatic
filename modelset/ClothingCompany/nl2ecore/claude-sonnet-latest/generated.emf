@namespace(uri="http://www.example.com/clothing", prefix="clothing")
package clothing;

datatype LocalTime : java.time.LocalTime;

class Country {
	attr String name;
	attr double vatRate;
	attr String currency;
	attr double conversionRateToEuro;
}

class Manufacturer {
	attr String name;
	ref Country country;
}

class Product {
	op double getGrossPrice(Country country);
	attr String name;
	attr String description;
	attr double netPrice;
	ref Manufacturer manufacturer;
	val ProductAvailability[*]#product availabilities;
}

class ProductAvailability {
	ref Product#availabilities product;
	ref Country country;
}

class Representative {
	attr String firstName;
	attr String lastName;
	attr String socialSecurityNumber;
	attr String telephoneNumber;
	attr String emailAddress;
	ref Country country;
}

class Address {
	attr String street;
	attr String city;
	attr String postalCode;
	ref Country country;
}

class Customer {
	attr String name;
	val Address address;
	attr String telephoneNumber;
	attr String emailAddress;
	ref Country[*] resellingCountries;
}

class Order {
	attr String orderId;
	attr int orderQuantity;
	attr EDate orderDate;
	attr EDate desiredDeliveryDate;
	ref Product product;
	ref Customer customer;
	ref Representative representative;
}

class ClothingStore {
	val Country[*] countries;
	val Manufacturer[*] manufacturers;
	val Product[*] products;
	val Representative[*] representatives;
	val Customer[*] customers;
	val Order[*] orders;
}


