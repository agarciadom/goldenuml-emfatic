@namespace(uri="http://www.example.org/orderManagement", prefix="orderManagement")
package orderManagement;

class OrderManagementSystem {
	val Order[*] orders;
	val Category[*] categories;
	val Product[*] products;
	val Representative[*] representatives;
	val Manufacturer[*] manufacturers;
	val Country[*] countries;
	val Customer[*] customers;
	val ManufacturerCountry[*] manufacturerCountries;
}

class ManufacturerCountry {
	ref Manufacturer[1] manufacturer;
	ref Country[1] country;
}

class Order {
	attr int orderNumber;
	attr int orderQuantity;
	attr EDate orderDate;
	attr EDate deliveryDate;
	ref Product[1] product;
	ref Representative[1]#orders placedBy;
	ref Customer[1]#orders customer;
}

class Category {
	attr String name;
	ref Product[*]#category products;
}

class Product {
	attr String name;
	attr String description;
	attr double netPrice;
	ref Category[1]#products category;
	ref ManufacturerCountry[1] manufacturerCountry;
	ref Country[*]#products soldIn;
}

class Representative {
	attr String firstName;
	attr String lastName;
	attr int ssn;
	attr String phoneNumber;
	attr String email;
	ref Country[1]#representatives responsibleFor;
	ref Order[*]#placedBy orders;
}

class Manufacturer {
	attr String name;
	ref ManufacturerCountry[*] manufacturerCountries;
}

class Country {
	attr String name;
	attr double vat;
	attr String currency;
	attr float conversionRate;
	ref ManufacturerCountry[*] manufacturerCountries;
	ref Product[*]#soldIn products;
	ref Representative[*]#responsibleFor representatives;
	ref Customer[*]#countries customers;
}

class Customer {
	attr String name;
	attr String address;
	attr String phoneNumber;
	attr String email;
	ref Country[*]#customers countries;
	ref Order[*]#customer orders;
}


