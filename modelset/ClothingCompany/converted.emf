@namespace(uri="http://www.example.com/orderManagement", prefix="orderManagement")
package orderManagement;

class Order {
	attr int orderNumber;
	attr int orderQuantity;
	attr EDate orderDate;
	attr EDate deliveryDate;
	ref Product[1] product;
	ref Representative[1] placedBy;
	ref Customer[1] customer;
}

class Category {
	attr String name;
	ref Product[*]#category products;
}

class Product {
	attr String name;
	attr String description;
	attr double netPrice;
	ref Category[1]#products category;
	ref Order[*] orders;
	ref Country[*]#products countries;
	ref ManufacturerCountry[*] manufacturerCountries;
}

class Representative {
	attr String firstName;
	attr String lastName;
	attr int ssn;
	attr String phoneNumber;
	attr String email;
	ref Order[*] orders;
	ref Country[1] responsibleFor;
}

class Manufacturer {
	attr String name;
	ref Country[*]#manufacturers countries;
}

class Country {
	attr String name;
	attr double vat;
	attr String currency;
	attr float conversionRate;
	ref Manufacturer[*]#countries manufacturers;
	ref Product[*]#countries products;
	ref Customer[*]#countries customers;
}

class Customer {
	attr String name;
	attr String address;
	attr String phoneNumber;
	attr String email;
	ref Order[*] orders;
	ref Country[*]#customers countries;
}

class ManufacturerCountry {
	ref Manufacturer[1] manufacturer;
	ref Country[1] country;
}


