@namespace(uri="http://www.example.org/BuildingManagement", prefix="bm")
package BuildingManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class WebPortal {
	attr ecore.EString[1] versionNumber;
	attr ecore.EString[1] urlAddress;
}

class Building {
	attr ecore.EInt[1] uniqueID;
	attr ecore.EString[1] name;
	attr ecore.EString[1] energyClass;
	attr ecore.EString[1] address;
	attr ecore.EInt[1] yearOfConstruction;
	ref User[1] owner;
	val AdditionalEntry[0..1000] additionalEntries;
	ref Image[1..100] images;
}

class AdditionalEntry {
	attr ecore.EString[1] name;
	ref Building[1] building;
	attr ecore.EString valueText;
	attr ecore.EString valueNumberWithUnit;
}

class Image {
	attr ecore.EString[1] fileName;
}

class User {
	attr ecore.EString[1] username;
	attr ecore.EString[1] emailAddress;
	attr ecore.EString[1] password;
}

class Administrator extends User {
	attr ecore.EString idCardNumber;
}


