<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BuildingManagement" nsURI="http://www.example.org/BuildingManagement" nsPrefix="bm">
  <eClassifiers>
    <eClass name="WebPortal">
      <eStructuralFeatures>
        <eAttribute name="versionNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="urlAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Building">
      <eStructuralFeatures>
        <eAttribute name="uniqueID" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="energyClass" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfConstruction" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="additionalEntries" containment="True" lowerBound="0" upperBound="1000" eType="//@eClassifiers.2" />
        <eReference name="images" containment="False" lowerBound="1" upperBound="100" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdditionalEntry">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="building" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="valueText" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="valueNumberWithUnit" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Image">
      <eStructuralFeatures>
        <eAttribute name="fileName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Administrator" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="idCardNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
