<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="EnergyPortal" nsURI="http://www.energyportal.org/model" nsPrefix="ep">
  <eClassifiers>
    <eClass name="WebPortal">
      <eStructuralFeatures>
        <eAttribute name="version" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="url" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="users" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="buildings" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="isActive" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="ownedBuildings" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Administrator" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="idCardNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Building">
      <eStructuralFeatures>
        <eAttribute name="uniqueID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="energyClass" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfConstruction" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="entries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="images" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eAttribute name="profileImage" lowerBound="0" upperBound="1" eType="Image" />
        <eReference name="comments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entry">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isPublic" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TextualInfo" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="textContent" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="NumericValue" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures>
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//EFloat" />
        <eAttribute name="unit" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Image">
      <eStructuralFeatures>
        <eAttribute name="fileName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Comment">
      <eStructuralFeatures>
        <eAttribute name="text" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="targetBuilding" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
