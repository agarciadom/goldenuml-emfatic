<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="WebPortalModel" nsURI="http://www.example.org/webportalmodel" nsPrefix="webportal">
  <eClassifiers>
    <eClass name="WebPortal">
      <eStructuralFeatures>
        <eAttribute name="versionNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="url" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="buildings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="users" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Building">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="energyClass" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfConstruction" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="images" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="profilePhoto" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="entries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="comments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Admin" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="idCardNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Image">
      <eStructuralFeatures>
        <eAttribute name="fileName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="building" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entry">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="value" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="unit" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="isPublic" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="building" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="createdBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Comment">
      <eStructuralFeatures>
        <eAttribute name="content" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="building" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="createdBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
