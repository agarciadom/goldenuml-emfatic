<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="WebPortalSystem" nsURI="http://www.example.org/webportalsystem" nsPrefix="wps">
  <eClassifiers>
    <eClass name="WebPortal">
      <eStructuralFeatures>
        <eAttribute name="version" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="URL" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Building">
      <eStructuralFeatures>
        <eAttribute name="ID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="energyClass" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="yearOfConstruction" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="entries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="images" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="username" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Entry">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="textualInfo" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="numericValue" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="unit" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="isPublic" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Image">
      <eStructuralFeatures>
        <eAttribute name="filename" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Administrator" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="IDCardNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
