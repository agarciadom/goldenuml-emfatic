@namespace(uri="http://www.example.org/webportalmodel", prefix="webportal")
package WebPortalModel;

import "http://www.eclipse.org/emf/2002/Ecore";

class WebPortal {
	attr ecore.EString[1] versionNumber;
	attr ecore.EString[1] url;
	val Building[*] buildings;
	val User[*] users;
}

class Building {
	attr ecore.EInt[1] ~id;
	attr ecore.EString[1] name;
	attr ecore.EString energyClass;
	attr ecore.EString[1] address;
	attr ecore.EInt yearOfConstruction;
	ref User[1] owner;
	val Image[*] images;
	ref Image profilePhoto;
	val Entry[*] entries;
	ref Comment[*] comments;
}

class User {
	attr ecore.EString[1] username;
	attr ecore.EString[1] email;
	attr ecore.EString[1] password;
}

class Admin extends User {
	attr ecore.EString idCardNumber;
}

class Image {
	attr ecore.EString[1] fileName;
	ref Building[1] building;
}

class Entry {
	attr ecore.EString[1] name;
	attr ecore.EDouble value;
	attr ecore.EString unit;
	attr ecore.EBoolean[1] isPublic;
	ref Building[1] building;
	ref User[1] createdBy;
}

class Comment {
	attr ecore.EString[1] content;
	ref Building[1] building;
	ref User[1] createdBy;
}


