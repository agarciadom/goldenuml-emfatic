@namespace(uri="http://www.ebuntu-nrw.org/system", prefix="wp")
package WebPortalSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class WebPortal {
	attr ecore.EString[1] versionNumber;
	attr ecore.EString[1] urlAddress;
	val Building[*] buildings;
	val User[*] registeredUsers;
}

class Building {
	attr ecore.EString[1] buildingID;
	attr ecore.EString[1] name;
	attr ecore.EString[1] energyClass;
	attr ecore.EString[1] address;
	attr ecore.EInt[1] constructionYear;
	ref User[1] owner;
	val AdditionalEntry[*] additionalEntries;
	val Image[*] images;
}

class AdditionalEntry {
	attr ecore.EString[1] entryName;
	attr ecore.EBoolean[1] isPublic;
}

class TextualEntry extends AdditionalEntry {
	attr ecore.EString[1] textValue;
}

class NumericEntry extends AdditionalEntry {
	attr ecore.EDouble[1] numericValue;
	attr ecore.EString[1] unit;
}

class Image {
	attr ecore.EString[1] fileName;
	attr ecore.EBoolean[1] isProfilePhoto;
}

class User {
	attr ecore.EString[1] userName;
	attr ecore.EString[1] emailAddress;
	attr ecore.EString[1] password;
}

class Administrator extends User {
	attr ecore.EString[1] idCardNumber;
}

class Comment {
	attr ecore.EString[1] commentText;
	ref Building[1] targetBuilding;
	ref User[1] author;
}


