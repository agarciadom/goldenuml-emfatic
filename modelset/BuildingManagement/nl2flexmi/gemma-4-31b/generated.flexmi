<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="WebPortalSystem" nsURI="http://www.ebuntu-nrw.org/system" nsPrefix="wp">
  <eClassifiers>
    <eClass name="WebPortal">
      <eStructuralFeatures>
        <eAttribute name="versionNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="urlAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="buildings" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="registeredUsers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Building">
      <eStructuralFeatures>
        <eAttribute name="buildingID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="energyClass" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="constructionYear" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="additionalEntries" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="images" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AdditionalEntry">
      <eStructuralFeatures>
        <eAttribute name="entryName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isPublic" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TextualEntry" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="textValue" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="NumericEntry" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="numericValue" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="unit" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Image">
      <eStructuralFeatures>
        <eAttribute name="fileName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isProfilePhoto" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="userName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="password" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Administrator" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures>
        <eAttribute name="idCardNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Comment">
      <eStructuralFeatures>
        <eAttribute name="commentText" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="targetBuilding" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="author" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
