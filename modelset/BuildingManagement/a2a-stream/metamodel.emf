@namespace(uri="http://www.webportal.org", prefix="p")
package WebPortal;

class WebPortal {
  attr EString versionNumber;
  attr EString urlAddress;
  val Building[*] buildings;
}
class Building {
  attr EString buildingID;
  attr EString name;
  attr EString energyClass;
  attr EString address;
  attr EInt yearOfConstruction;
  ref User owner;
  val Image profilePhoto;
  val Image[*] images;
  val Entry[*] additionalEntries;
}
class User {
  attr EString userName;
  attr EString emailAddress;
  attr EString password;
  val Comment[*] createdComments;
}
class Admin extends User {
  attr EString idCardNumber;
}
class Image {
  attr EString fileName;
  attr EBoolean isProfilePhoto;
}
class Entry {
  attr EString name;
  attr EBoolean isPublic;
}
class TextEntry extends Entry {
  attr EString textContent;
}
class NumericEntry extends Entry {
  attr EDouble value;
  attr EString unit;
}
class Comment {
  attr EString content;
  attr EDate createdAt;
  ref User author;
}