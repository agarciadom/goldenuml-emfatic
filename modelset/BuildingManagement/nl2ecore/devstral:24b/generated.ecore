<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
                xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
                name="WebPortal" nsURI="http://webportal/model" nsPrefix="webportal">

  <!-- Data Types -->
  <eClassifiers xmi:type="ecore:EDataType" name="String" instanceClassName="java.lang.String"/>
  <eClassifiers xmi:type="ecore:EDataType" name="Integer" instanceClassName="java.lang.Integer"/>
  <eClassifiers xmi:type="ecore:EDataType" name="Double" instanceClassName="java.lang.Double"/>
  <eClassifiers xmi:type="ecore:EDataType" name="Boolean" instanceClassName="java.lang.Boolean"/>

  <!-- Root Container -->
  <eClassifiers xmi:type="ecore:EClass" name="Root">
    <eStructuralFeatures xmi:type="ecore:EReference" name="webPortals" upperBound="-1"
                         eType="#//WebPortal" containment="true"/>
    <eStructuralFeatures xmi:type="ecore:EReference" name="admins" upperBound="-1"
                         eType="#//Admin" containment="true"/>
  </eClassifiers>

  <!-- Web Portal Class -->
  <eClassifiers xmi:type="ecore:EClass" name="WebPortal">
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="versionNumber" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="urlAddress" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EReference" name="buildings" upperBound="-1"
                         eType="#//Building" containment="true"/>
  </eClassifiers>

  <!-- Building Class -->
  <eClassifiers xmi:type="ecore:EClass" name="Building">
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="id" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="energyClass" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="address" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="yearOfConstruction" eType="#//Integer"/>
    <eStructuralFeatures xmi:type="ecore:EReference" name="owner" eType="#//BuildingOwner"
                         containment="true"/>
    <eStructuralFeatures xmi:type="ecore:EReference" name="entries" upperBound="-1"
                         eType="#//Entry" containment="true"/>
    <eStructuralFeatures xmi:type="ecore:EReference" name="images" upperBound="-1"
                         eType="#//Image" containment="true"/>
  </eClassifiers>

  <!-- User Class -->
  <eClassifiers xmi:type="ecore:EClass" name="User">
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="username" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="emailAddress" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="password" eType="#//String"/>
  </eClassifiers>

  <!-- Admin Class -->
  <eClassifiers xmi:type="ecore:EClass" name="Admin">
    <eStructuralFeatures xmi:type="ecore:EReference" name="baseUser" eType="#//User"
                         containment="true"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="adminIdNumber" eType="#//String"/>
  </eClassifiers>

  <!-- Entry Class -->
  <eClassifiers xmi:type="ecore:EClass" name="Entry">
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="name" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="publiclyReleased" eType="#//Boolean"/>
  </eClassifiers>

  <!-- TextEntry Class -->
  <eClassifiers xmi:type="ecore:EClass" name="TextEntry">
    <eStructuralFeatures xmi:type="ecore:EReference" name="baseEntry" eType="#//Entry"
                         containment="true"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="textContent" eType="#//String"/>
  </eClassifiers>

  <!-- NumberEntry Class -->
  <eClassifiers xmi:type="ecore:EClass" name="NumberEntry">
    <eStructuralFeatures xmi:type="ecore:EReference" name="baseEntry" eType="#//Entry"
                         containment="true"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="numberValue" eType="#//Double"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="unit" eType="#//String"/>
  </eClassifiers>

  <!-- Image Class -->
  <eClassifiers xmi:type="ecore:EClass" name="Image">
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="filename" eType="#//String"/>
    <eStructuralFeatures xmi:type="ecore:EAttribute" name="profilePhoto" eType="#//Boolean"/>
  </eClassifiers>

</ecore:EPackage>
