@namespace(uri="http://www.example.org/energyportal", prefix="energyportal")
package energyportal;

datatype EnergyClass : java.lang.String;

class System {
	val WebPortal[*] portals;
	val User[*] users;
}

class WebPortal {
	attr String versionNumber;
	attr String url;
	val Building[*] buildings;
	val Registration[*] registrations;
	val Comment[*] comments;
}

class Building {
	attr String buildingId;
	attr String name;
	attr EnergyClass energyClass;
	attr String address;
	attr int yearOfConstruction;
	ref User owner;
	val AdditionalEntry[*] entries;
	val Image[*] images;
	ref Image profilePhoto;
	ref Comment[*] comments;
}

abstract class AdditionalEntry {
	attr String name;
	attr boolean publiclyReleased;
}

class TextEntry extends AdditionalEntry {
	attr String text;
}

class NumericEntry extends AdditionalEntry {
	attr double value;
	attr String unit;
}

class Image {
	attr String fileName;
}

class User {
	op void login(String userName, String password);
	op void logout();
	op Building createBuilding(Building building);
	op AdditionalEntry addEntry(Building building, AdditionalEntry entry);
	op Comment commentOnBuilding(Building building, String text);
	op Building[*] searchBuildings(String query);
	attr String userName;
	attr String email;
	attr String password;
	attr boolean activated;
}

class Administrator extends User {
	op void setupUserAccount(Registration registration);
	op void deleteComment(Comment comment);
	attr String idCardNumber;
}

class Registration {
	op void sendConfirmationLink();
	op boolean checkUserNameUniqueness(String userName);
	op void notifyActivation();
	attr String userName;
	attr String email;
	attr String password;
	attr boolean confirmationSent;
	attr boolean emailConfirmed;
	attr boolean adminSetup;
	ref User user;
}

class Comment {
	attr String text;
	attr EDate createdAt;
	ref User author;
	ref Building building;
}


