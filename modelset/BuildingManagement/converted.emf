@namespace(uri="http://www.example.org/buildingPortal", prefix="buildingPortal")
package buildingPortal;

class User {
	attr String username;
	attr String password;
	attr String email;
	ref Building[*] owner;
	ref Building[*] author;
}

class Administrator extends User {
	attr String idCardNumber;
}

class WebPortal {
	attr String versionNumber;
	attr String url;
	ref Entry[*] ~id;
	ref User username;
}

class Building {
	attr String ~id;
	attr String label;
	attr String address;
	attr int yearOfConstruction;
	val Comment[*] comments;
	val Image[1] profilePicture;
	attr EnergyClass energyClass;
}

class Entry {
	attr String name;
	attr boolean public;
}

class TextEntry extends Entry {
	attr String text;
}

class NumericEntry extends Entry {
	attr double value;
	attr String unit;
}

class EntryGroup {
	val Entry[*] entries;
}

enum EnergyClass {
	A = 0;
	B = 1;
	C = 2;
	D = 3;
}

class Comment {
	attr String text;
}

class Image {
	attr String fileName;
}


