@namespace(uri="http://louvre/museum", prefix="p")
package MuseumPackage;

class Museum {
  attr String name;
  val Location[*] locations;
}
class Location {
  attr Integer ~id;
  attr String name;
}

@namespace(uri="http://louvre/exhibition", prefix="p")
package ExhibitionPackage;

class Exhibition {
  attr String name;
  attr Date openingDate;
  ref Employee coordinator;
  val Item[*] items;
}
class Item {
  attr String description;
  val Piece[*] pieces;
}
class Collector {
  attr Integer ~id;
  attr String name;
}
class Piece {
  attr String title;
  ref Collector collector;
  ref Item item;
}

@namespace(uri="http://louvre/employee", prefix="p")
package EmployeePackage;

class Employee {
  attr Integer ~id;
  attr String name;
  ref Employee coach;
  val Employee[*] coachees;
}