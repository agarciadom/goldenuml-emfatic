<?xml version="1.0" encoding="UTF-8"?>
<ePackage name="louvre" nsURI="http://www.louvre.org/museum" xmlns:xmi="http://www.omg.org/XMI" xmlns:xmiC="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/Ecore/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  
  <!-- Root container containing everything that does not have a container already -->
  <eClass name="LouvreMuseumSystem">
    <eReferences>
      <eReference name="locations" containment="true" eType="Location"/>
    </eReferences>
    <eReferences>
      <eReference name="employees" containment="true" eType="Employee"/>
    </eReferences>
    <eReferences>
      <eReference name="collectors" containment="true" eType="Collector"/>
    </eReferences>
  </eClass>

  <eClass name="Location">
    <eAttributes>
      <eAttribute name="name" eType="eString"/>
    </eAttributes>
    <eReferences>
      <eReference name="exhibitions" containment="true" eType="Exhibition"/>
    </eReferences>
  </eClass>

  <eClass name="Exhibition">
    <eAttributes>
      <eAttribute name="title" eType="eString"/>
      <eAttribute name="openingDate" eType="EDate"/>
    </eAttributes>
    <eReferences>
      <eReference name="coordinator" eType="Employee"/>
    </eReferences>
    <eReferences>
      <eReference name="desiredItems" containment="true" eType="DesiredItem"/>
    </eReferences>
  </eClass>

  <eClass name="Employee">
    <eAttributes>
      <eAttribute name="name" eType="eString"/>
    </eAttributes>
    <eReferences>
      <eReference name="coach" eType="Employee"/>
    </eReferences>
  </eClass>

  <eClass name="DesiredItem">
    <eAttributes>
      <eAttribute name="description" eType="eString"/>
    </eAttributes>
    <!-- Association Class implementation: DesiredItem contains the Request -->
    <eReferences>
      <eReference name="requests" containment="true" eType="Request"/>
    </eReferences>
  </eClass>

  <!-- Association Class: links DesiredItem to a Piece. 
       One end (DesiredItem) has containment, this end does not. -->
  <eClass name="Request">
    <eReferences>
      <eReference name="piece" eType="Piece"/>
    </eReferences>
  </eClass>

  <eClass name="Piece">
    <eAttributes>
      <eAttribute name="title" eType="eString"/>
    </eAttributes>
    <eReferences>
      <eReference name="collector" eType="Collector"/>
    </eReferences>
  </eClass>

  <eClass name="Collector">
    <eAttributes>
      <eAttribute name="name" eType="eString"/>
    </eAttributes>
    <eReferences>
      <eReference name="pieces" containment="true" eType="Piece"/>
    </eReferences>
  </eClass>

</ePackage>
