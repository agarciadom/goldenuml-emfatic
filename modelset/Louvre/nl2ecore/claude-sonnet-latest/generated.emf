@namespace(uri="http://www.example.org/louvre", prefix="louvre")
package louvre;

class MuseumManagementSystem {
	val Museum museum;
	val Collector[*] collectors;
	val Employee[*] employees;
}

class Museum {
	attr String name;
	attr String city;
	val Location[*] locations;
}

class Location {
	attr String name;
	attr String description;
	val Exhibition[*] exhibitions;
}

class Exhibition {
	attr String name;
	attr EDate openingDate;
	attr EDate planningStartDate;
	attr ExhibitionStatus status;
	ref Employee coordinator;
	val DesiredItem[*] desiredItems;
}

class DesiredItem {
	attr String description;
	attr String category;
	val PieceRequest[*] pieceRequests;
}

class Piece {
	attr String title;
	attr String artist;
	attr int year;
	attr String medium;
	ref Collector owner;
}

class PieceRequest {
	attr EDate requestDate;
	attr RequestStatus status;
	attr String notes;
	ref Piece piece;
	ref Collector collector;
}

class Collector {
	attr String name;
	attr String contactInfo;
	val Piece[*] pieces;
}

class Employee {
	attr String name;
	attr String email;
	attr EmployeeRole role;
	ref Employee[*]#coach coachees;
	ref Employee#coachees coach;
}

enum ExhibitionStatus {
	PLANNING = 0;
	IN_PREPARATION = 1;
	OPEN = 2;
	CLOSED = 3;
	CANCELLED = 4;
}

enum RequestStatus {
	PENDING = 0;
	ACCEPTED = 1;
	DECLINED = 2;
	WITHDRAWN = 3;
}

enum EmployeeRole {
	JUNIOR = 0;
	SENIOR = 1;
	MANAGER = 2;
}


