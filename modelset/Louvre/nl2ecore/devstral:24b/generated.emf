@namespace(uri="http://www.example.org/louvreMuseum", prefix="louvreMuseum")
package louvreMuseum;

class RootContainer {
	!ordered ref Location[*] locations;
	!ordered ref Employee[*] employees;
}

class Location {
	!ordered ref Exhibition[*] exhibitions;
}

class Exhibition {
	!ordered ref Employee[1] coordinator;
	!ordered ref ExhibitionItem[*] desiredItems;
}

class ExhibitionItem {
	!ordered ref RequestedPiece[*] requestedPieces;
}

class RequestedPiece {
	!ordered ref Collector[1] collector;
}

class Employee {
	!ordered ref Employee coachedBy;
}

class Collector {
}

datatype TimeWithoutDate : java.time.LocalTime;

class ExhibitionCoordinator {
	!ordered ref Exhibition[1] exhibition;
	!ordered val Employee[1] employee;
}


