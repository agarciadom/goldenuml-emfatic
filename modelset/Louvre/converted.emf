@namespace(uri="http://www.example.org/museum", prefix="museum")
package museum;

class Museum {
	val Collector[*] collectors;
	val Piece[*] pieces;
	val Item[*] items;
	val Exhibition[*] exhibitions;
	val Location[*] locations;
	val Room[*] rooms;
	val Employee[*] employees;
}

class Collector {
	ref Piece[*]#collector pieces;
}

class Piece {
	attr String title;
	attr String description;
	ref Collector[1]#pieces collector;
	ref Item[*]#pieces items;
}

class Item {
	attr String description;
	ref Piece[*]#items pieces;
	ref Exhibition[1]#items exhibition;
}

class Exhibition {
	attr String title;
	attr String stage;
	ref Item[*]#exhibition items;
	ref Employee[1]#exhibitions coordinator;
	ref Location#exhibitions assignedLocation;
}

class Location {
	ref Exhibition[*]#assignedLocation exhibitions;
	ref Room[*]#locations rooms;
}

class Room {
	ref Location[*]#rooms locations;
}

class Employee {
	attr String level;
	ref Exhibition[*]#coordinator exhibitions;
	ref Employee#subordinates coach;
	ref Employee[*]#coach subordinates;
}


