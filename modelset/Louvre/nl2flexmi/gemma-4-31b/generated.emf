@namespace(uri="http://www.louvre.org/management", prefix="louvre")
package LouvreManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Location {
	attr ecore.EString[1] name;
	val Exhibition[*] exhibitions;
}

class Exhibition {
	attr ecore.EString[1] name;
	attr ecore.EDate startDate;
	attr ecore.EDate endDate;
	ref Employee[1] coordinator;
	val DesiredItem[*] desiredItems;
}

class Employee {
	attr ecore.EString[1] name;
	ref Employee coach;
}

class DesiredItem {
	attr ecore.EString[1] description;
	val Request[*] requests;
}

class Piece {
	attr ecore.EString[1] title;
	attr ecore.EString artist;
	ref Collector[1] owner;
}

class Collector {
	attr ecore.EString[1] name;
	attr ecore.EString contactInfo;
}

class Request {
	attr ecore.EDate[1] requestDate;
	ref Piece[1] piece;
	ref Collector[1] collector;
}

class Museum {
	val Location[*] locations;
	val Employee[*] employees;
	val Collector[*] collectors;
	val Piece[*] allPieces;
}


