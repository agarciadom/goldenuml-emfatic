@namespace(uri="http://www.example.com/louvre", prefix="le")
package LouvreExhibition;

import "http://www.eclipse.org/emf/2002/Ecore";

class Location {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	ref Exhibition[*] exhibitions;
}

class Exhibition {
	attr ecore.EString[1] title;
	attr ecore.EDate[1] startDate;
	attr ecore.EDate endDate;
	ref Employee[1] coordinator;
	ref Item[*] items;
}

class Item {
	attr ecore.EString[1] description;
	attr ecore.EString period;
	ref Piece[*] pieces;
}

class Piece {
	attr ecore.EString[1] collectorName;
	attr ecore.EString value;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString position;
	ref Employee coach;
}


