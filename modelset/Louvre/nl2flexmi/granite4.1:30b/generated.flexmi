<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LouvreManagement" nsURI="http://www.louvre.museum/model" nsPrefix="louv">
  <eClassifiers>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="exhibitions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Exhibition">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="openingDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="coordinator" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="desiredItems" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DesiredItem">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pieces" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Piece">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="collectorId" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="employeeId" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="coach" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
