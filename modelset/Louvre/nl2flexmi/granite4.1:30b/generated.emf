@namespace(uri="http://www.louvre.museum/model", prefix="louv")
package LouvreManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Location {
	attr ecore.EString[1] name;
	val Exhibition[*] exhibitions;
}

class Exhibition {
	attr ecore.EString[1] title;
	attr ecore.EDate openingDate;
	ref Employee coordinator;
	val DesiredItem[*] desiredItems;
}

class DesiredItem {
	attr ecore.EString[1] description;
	ref Piece[*] pieces;
}

class Piece {
	attr ecore.EString[1] title;
	attr ecore.EString collectorId;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EString employeeId;
	ref Employee coach;
}


