<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LouvreMuseum" nsURI="http://www.example.org/LouvreMuseum" nsPrefix="lm">
  <eClassifiers>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="String" />
        <eReference name="exhibitions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Exhibition">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="Date" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="Date" />
        <eReference name="location" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="coordinator" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="desiredItems" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="isSenior" lowerBound="0" upperBound="1" eType="Boolean" />
        <eReference name="coach" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ExhibitionItem">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="String" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DesiredItem">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="String" />
        <eReference name="piecesRequested" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Collector">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="contactInfo" lowerBound="0" upperBound="1" eType="String" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Piece">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="String" />
        <eAttribute name="artist" lowerBound="0" upperBound="1" eType="String" />
        <eAttribute name="yearCreated" lowerBound="0" upperBound="1" eType="Integer" />
        <eReference name="collector" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CoachingRelationship">
      <eStructuralFeatures>
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="Date" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="Date" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
