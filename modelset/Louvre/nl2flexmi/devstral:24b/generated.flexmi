<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LouvreMuseum" nsURI="http://www.example.org/louvremuseum" nsPrefix="lm">
  <eClassifiers>
    <eClass name="Museum">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="locations" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="exhibitions" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Exhibition">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="openingDate" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="coordinator" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="desiredItems" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isSenior" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="coach" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ExhibitionItem">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="requests" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Collector">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Piece">
      <eStructuralFeatures>
        <eAttribute name="title" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="artist" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Request">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="piece" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="collector" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
