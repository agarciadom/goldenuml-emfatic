@namespace(uri="http://www.example.org/louvremuseum", prefix="lm")
package LouvreMuseum;

import "http://www.eclipse.org/emf/2002/Ecore";

class Museum {
	attr ecore.EString[1] name;
	val Location[*] locations;
}

class Location {
	attr ecore.EString[1] name;
	attr ecore.EString description;
	val Exhibition[*] exhibitions;
}

class Exhibition {
	attr ecore.EString[1] name;
	attr ecore.EString openingDate;
	ref Employee coordinator;
	val ExhibitionItem[*] desiredItems;
}

class Employee {
	attr ecore.EString[1] name;
	attr ecore.EBoolean[1] isSenior;
	ref Employee coach;
}

class ExhibitionItem {
	attr ecore.EString[1] description;
	val Request[*] requests;
}

class Collector {
	attr ecore.EString[1] name;
}

class Piece {
	attr ecore.EString[1] title;
	attr ecore.EString artist;
}

class Request {
	attr ecore.EString[1] status;
	ref Piece[1] piece;
	ref Collector[1] collector;
}


