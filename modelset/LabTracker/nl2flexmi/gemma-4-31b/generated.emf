@namespace(uri="http://www.labtracker.com/ns", prefix="lt")
package LabTracker;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	attr ecore.EString[1] address;
	attr ecore.EString[1] phoneNumber;
	attr ecore.EDate[1] dateOfBirth;
}

class Doctor extends Person {
	attr ecore.ELong[1] practitionerNumber;
	attr ecore.EString[1] signature;
}

class Patient extends Person {
	attr ecore.EString[1] healthNumber;
}

class Requisition {
	attr ecore.EDate[1] validDate;
	attr ecore.EInt repetitionCount;
	attr ecore.EString repetitionInterval;
	ref Doctor[1] doctor;
	ref Patient[1] patient;
	val Test[+] tests;
}

class Test {
	attr ecore.EInt[1] duration;
	attr ecore.EString[1] group;
	attr ecore.EBoolean[1] appointmentRequired;
	attr ecore.EBoolean[1] sampleOnly;
}

class TestResult {
	attr ecore.EString[1] result;
	attr ecore.EString[1] report;
	ref Requisition[1] requisition;
	ref Test[1] test;
}

class Lab {
	attr ecore.EString[1] address;
	attr ecore.EString[1] registrationNumber;
	attr ecore.EDouble[1] cancellationFee;
	val BusinessHour[+] businessHours;
}

class BusinessHour {
	attr ecore.EString[1] startTime;
	attr ecore.EString[1] endTime;
}

class Appointment {
	attr ecore.EString[1] confirmationNumber;
	attr ecore.EDate[1] date;
	attr ecore.EString[1] startTime;
	attr ecore.EString[1] endTime;
	ref Requisition[1] requisition;
	ref Lab[1] lab;
}


