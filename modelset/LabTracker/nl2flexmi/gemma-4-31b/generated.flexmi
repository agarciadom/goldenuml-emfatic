<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LabTracker" nsURI="http://www.labtracker.com/ns" nsPrefix="lt">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Doctor" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="practitionerNumber" lowerBound="1" upperBound="1" eType="//ELong" />
        <eAttribute name="signature" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="healthNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Requisition">
      <eStructuralFeatures>
        <eAttribute name="validDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="repetitionCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="repetitionInterval" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="doctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="tests" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Test">
      <eStructuralFeatures>
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="group" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="appointmentRequired" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="sampleOnly" lowerBound="1" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TestResult">
      <eStructuralFeatures>
        <eAttribute name="result" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="report" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="requisition" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="test" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Lab">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="registrationNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="cancellationFee" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="businessHours" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusinessHour">
      <eStructuralFeatures>
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eAttribute name="confirmationNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="requisition" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="lab" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
