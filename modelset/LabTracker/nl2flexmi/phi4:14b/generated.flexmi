<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LabTracker" nsURI="http://example.com/LabTracker" nsPrefix="lt">
  <eClassifiers>
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute name="practitionerNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="fullName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="signature" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute name="healthNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Requisition">
      <eStructuralFeatures>
        <eAttribute name="validFromDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="doctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="tests" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eAttribute name="repetitionCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="repetitionInterval" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="signature" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="validFrom" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="patientInfo" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="practitioner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.12" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Test">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="code" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="datePerformed" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="sampleRequired" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="requisition" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eAttribute name="practitionerNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="practitioner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eAttribute name="repetitionPattern" lowerBound="0" upperBound="1" eType="RepetitionPattern" />
        <eReference name="appointment" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eReference name="lab" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="SignatureType" instanceClassName="byte[]" />
    <eDataType name="RepetitionIntervalType" instanceClassName="String" />
    <eClass name="PatientInfo">
      <eStructuralFeatures>
        <eAttribute name="healthNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Practitioner">
      <eStructuralFeatures>
        <eAttribute name="fullName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="RepetitionPattern">
      <eStructuralFeatures>
        <eAttribute name="frequency" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="numRepetitions" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Lab">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="businessHours" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="registrationNumber" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="IntegerObject" instanceClassName="java.lang.Integer" />
    <eClass name="Integer">
      <eStructuralFeatures>
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//@eClassifiers.11" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
