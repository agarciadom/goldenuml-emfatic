<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LabTracker" nsURI="http://www.example.org/LabTracker" nsPrefix="lt">
  <eClassifiers>
    <eClass name="Doctor" eSuperTypes="//@eClassifiers.7">
      <eStructuralFeatures>
        <eAttribute name="practitionerNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="signature" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="fullName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient" eSuperTypes="//@eClassifiers.7">
      <eStructuralFeatures>
        <eAttribute name="healthNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Requisition">
      <eStructuralFeatures>
        <eAttribute name="validFrom" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="doctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="repetitions" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="interval" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="results" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="reports" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="tests" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Test">
      <eStructuralFeatures>
        <eAttribute name="duration" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="group" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eReference name="lab" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="confirmationNumber" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Lab">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="businessHoursStart" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="businessHoursEnd" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eAttribute name="registrationNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="cancellationFee" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Date" instanceClassName="java.util.Date" />
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
