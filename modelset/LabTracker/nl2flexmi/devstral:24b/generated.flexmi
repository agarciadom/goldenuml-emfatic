<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="LabTracker" nsURI="http://labtracker/model" nsPrefix="lt">
  <eClassifiers>
    <eClass name="Doctor" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="practitionerNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="signature" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Patient" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="healthNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dateOfBirth" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="address" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Requisition">
      <eStructuralFeatures>
        <eAttribute name="validFrom" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="repeatCount" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="interval" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="doctor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="testGroup" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TestGroup">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="tests" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Test">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="duration" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eAttribute name="appointmentNumber" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="requisition" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="patient" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="lab" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Lab">
      <eStructuralFeatures>
        <eAttribute name="registrationNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startTime" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="endTime" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="address" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Address">
      <eStructuralFeatures>
        <eAttribute name="street" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="city" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="province" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="postalCode" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="country" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
