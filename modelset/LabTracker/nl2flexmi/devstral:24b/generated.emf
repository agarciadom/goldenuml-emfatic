@namespace(uri="http://labtracker/model", prefix="lt")
package LabTracker;

import "http://www.eclipse.org/emf/2002/Ecore";

class Doctor extends Person {
	attr ecore.EInt[1] practitionerNumber;
	attr ecore.EString signature;
}

class Patient extends Person {
	attr ecore.EString[1] healthNumber;
	attr ecore.EDate dateOfBirth;
}

class Person {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	val Address address;
}

class Requisition {
	attr ecore.EDate[1] validFrom;
	attr ecore.EInt repeatCount;
	attr ecore.EString interval;
	ref Doctor[1] doctor;
	ref Patient[1] patient;
	val TestGroup[1] testGroup;
}

class TestGroup {
	attr ecore.EString[1] name;
	val Test[*] tests;
}

class Test {
	attr ecore.EString[1] name;
	attr ecore.EInt duration;
}

class Appointment {
	attr ecore.EInt appointmentNumber;
	attr ecore.EDate[1] startTime;
	attr ecore.EDate[1] endTime;
	ref Requisition requisition;
	ref Patient[1] patient;
	val Lab lab;
}

class Lab {
	attr ecore.EString[1] registrationNumber;
	attr ecore.EString startTime;
	attr ecore.EString endTime;
	val Address[1] address;
}

class Address {
	attr ecore.EString[1] street;
	attr ecore.EString[1] city;
	attr ecore.EString province;
	attr ecore.EString postalCode;
	attr ecore.EString country;
}


