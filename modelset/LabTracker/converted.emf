@namespace(uri="http://www.example.org/labmodel", prefix="labmodel")
package labmodel;

enum Interval {
	Weekly = 0;
	Monthly = 0;
	EveryHalfYear = 0;
	Yearly = 0;
}

enum AccessType {
	Reservable = 0;
	WalkIn = 0;
	DropOff = 0;
}

enum DayOfWeek {
	Monday = 0;
	Tuesday = 0;
	Wednesday = 0;
	Thursday = 0;
	Friday = 0;
	Saturday = 0;
	Sunday = 0;
}

class Person {
	attr String LastName;
	attr String FirstName;
	attr String Address;
	attr String PhoneNumber;
	ref PersonRole[0..2]#person roles;
}

abstract class PersonRole {
	attr int IdNumber;
	ref Person#roles person;
}

class Patient extends PersonRole {
	attr String DateOfBirth;
	ref Requisition[*]#patient requisitions;
}

class Doctor extends PersonRole {
	attr String Signature;
	ref Requisition[*]#doctor requisitions;
}

class Requisition {
	attr String EffectiveDate;
	attr int RepetitionCount;
	attr Interval RepetitionInterval;
	ref Patient#requisitions patient;
	ref Doctor#requisitions doctor;
	ref Appointment[*]#requisition labAppointments;
	ref SpecificTest[*]#requisition specificTests;
}

class TestResult {
	attr boolean Result;
	attr String Report;
	ref SpecificTest#testResult specificTest;
}

class SpecificTest {
	attr String Date;
	ref TestResult#specificTest testResult;
	ref Requisition#specificTests requisition;
	ref Test#specificTests test;
}

class Appointment {
	attr String Confirmation;
	attr String Date;
	attr String startTime;
	attr String endTime;
	ref Lab#appointments lab;
	ref Requisition#labAppointments requisition;
}

class BusinessHour {
	attr DayOfWeek DayOfWeek;
	attr String startTime;
	attr String endTime;
	ref Lab#businessHours lab;
}

class Lab {
	attr String RegistrationNumber;
	attr String Name;
	attr String Address;
	attr boolean ChangeCancelFee;
	ref BusinessHour[7]#lab businessHours;
	ref Appointment[*]#lab appointments;
}

class Test {
	attr String Name;
	attr String Duration;
	ref TestType#tests testType;
	ref SpecificTest[*]#test specificTests;
}

class TestType {
	attr String Name;
	attr String DurationAdditive;
	attr AccessType Access;
	ref Test[*]#testType tests;
}


