@namespace(uri="http://www.example.org/labSystem", prefix="labSystem")
package labSystem;

datatype LocalTime : java.time.LocalTime;

enum Interval {
	Weekly = 0;
	Monthly = 0;
	EveryHalfYear = 0;
	Yearly = 0;
}

enum AccessType {
	Reservable = 0;
	WalkIn = 0;
	DropOff = 0;
}

enum DayOfWeek {
	Monday = 0;
	Tuesday = 0;
	Wednesday = 0;
	Thursday = 0;
	Friday = 0;
	Saturday = 0;
	Sunday = 0;
}

class LabSystem {
	val Person[*] persons;
	val PersonRole[*] personRoles;
	val Lab[*] labs;
	val TestType[*] testTypes;
	val Test[*] tests;
}

class Person {
	attr String lastName;
	attr String firstName;
	attr String address;
	attr String phoneNumber;
	ref PersonRole[0..2]#person roles;
}

abstract class PersonRole {
	attr int idNumber;
	ref Person#roles person;
}

class Patient extends PersonRole {
	attr String dateOfBirth;
	val Requisition[*]#patient requisitions;
}

class Doctor extends PersonRole {
	attr String signature;
	ref Requisition[*]#doctor requisitions;
}

class Requisition {
	attr String effectiveDate;
	attr int repetitionCount;
	attr Interval repetitionInterval;
	ref Patient#requisitions patient;
	ref Doctor#requisitions doctor;
	ref Lab#requisitions lab;
	ref Appointment#requisition appointment;
	val SpecificTest[*]#requisition specificTests;
}

class Appointment {
	attr String confirmation;
	attr EDate date;
	attr LocalTime startTime;
	attr LocalTime endTime;
	ref Lab#appointments lab;
	ref Requisition#appointment requisition;
}

class SpecificTest {
	attr EDate date;
	ref Requisition#specificTests requisition;
	val TestResult#specificTest testResult;
	ref Test#specificTests test;
}

class TestResult {
	attr boolean result;
	attr String report;
	ref SpecificTest#testResult specificTest;
}

class BusinessHour {
	attr DayOfWeek dayOfWeek;
	attr LocalTime startTime;
	attr LocalTime endTime;
	ref Lab#businessHours lab;
}

class Lab {
	attr String registrationNumber;
	attr String name;
	attr String address;
	attr boolean changeCancelFee;
	ref Requisition[*]#lab requisitions;
	val Appointment[*]#lab appointments;
	val BusinessHour[0..7]#lab businessHours;
}

class Test {
	attr String name;
	attr String duration;
	ref SpecificTest[*]#test specificTests;
	ref TestType#tests testType;
}

class TestType {
	attr String name;
	attr String durationAdditive;
	attr AccessType access;
	ref Test[*]#testType tests;
}


