@namespace(uri="http://www.example.org/labmodel", prefix="labmodel")
package labmodel;

enum Interval {
	Weekly = 0;
	Monthly = 0;
	EveryHalfYear = 0;
	Yearly = 0;
}

enum AccessType {
	Reservable = 0;
	WalkIn = 0;
	DropOff = 0;
}

enum DayOfWeek {
	Monday = 0;
	Tuesday = 0;
	Wednesday = 0;
	Thursday = 0;
	Friday = 0;
	Saturday = 0;
	Sunday = 0;
}

class Person {
	attr String lastName;
	attr String firstName;
	attr String address;
	attr String phoneNumber;
	ref PersonRole[0..2]#person roles;
}

abstract class PersonRole {
	attr int idNumber;
	ref Person[1]#roles person;
}

class Patient extends PersonRole {
	attr String dateOfBirth;
	ref Requisition[*]#patient requisitions;
}

class Doctor extends PersonRole {
	attr String signature;
	ref Requisition[*]#doctor requisitions;
}

class Requisition {
	attr String effectiveDate;
	attr int repetitionCount;
	attr Interval repetitionInterval;
	ref Patient[1]#requisitions patient;
	ref Doctor[1]#requisitions doctor;
	ref Lab[1]#requisitions lab;
	val SpecificTest[*]#requisition specificTests;
	val Appointment#requisition appointment;
}

class TestResult {
	attr boolean result;
	attr String report;
}

class SpecificTest {
	attr String date;
	val TestResult testResult;
	ref Requisition[1]#specificTests requisition;
	ref Test[1]#specificTests test;
}

class Appointment {
	attr String confirmation;
	attr String date;
	attr String startTime;
	attr String endTime;
	ref Requisition[1]#appointment requisition;
	ref Lab[1]#appointments lab;
}

class BusinessHour {
	attr DayOfWeek dayOfWeek;
	attr String startTime;
	attr String endTime;
	ref Lab[1]#businessHours lab;
}

class Lab {
	attr String registrationNumber;
	attr String name;
	attr String address;
	attr boolean changeCancelFee;
	ref Requisition[*]#lab requisitions;
	val BusinessHour[7]#lab businessHours;
	ref Appointment[*]#lab appointments;
}

class Test {
	attr String name;
	attr String duration;
	ref SpecificTest[*]#test specificTests;
	ref TestType[1]#tests testType;
}

class TestType {
	attr String name;
	attr String durationAdditive;
	attr AccessType access;
	ref Test[*]#testType tests;
}


