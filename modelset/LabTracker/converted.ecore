<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="labSystem" nsURI="http://www.example.org/labSystem" nsPrefix="labSystem">
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime" instanceClassName="java.time.LocalTime"/>
  <eClassifiers xsi:type="ecore:EEnum" name="Interval">
    <eLiterals name="Weekly"/>
    <eLiterals name="Monthly" value="1"/>
    <eLiterals name="EveryHalfYear" value="2"/>
    <eLiterals name="Yearly" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="AccessType">
    <eLiterals name="Reservable"/>
    <eLiterals name="WalkIn" value="1"/>
    <eLiterals name="DropOff" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="DayOfWeek">
    <eLiterals name="Monday"/>
    <eLiterals name="Tuesday" value="1"/>
    <eLiterals name="Wednesday" value="2"/>
    <eLiterals name="Thursday" value="3"/>
    <eLiterals name="Friday" value="4"/>
    <eLiterals name="Saturday" value="5"/>
    <eLiterals name="Sunday" value="6"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LabSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="persons" upperBound="-1"
        eType="#//Person" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="labs" upperBound="-1" eType="#//Lab"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="testTypes" upperBound="-1"
        eType="#//TestType" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tests" upperBound="-1"
        eType="#//Test" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Person">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roles" upperBound="2" eType="#//PersonRole"
        containment="true" eOpposite="#//PersonRole/person"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PersonRole" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="idNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="person" eType="#//Person"
        eOpposite="#//Person/roles"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Patient" eSuperTypes="#//PersonRole">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateOfBirth" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="requisitions" upperBound="-1"
        eType="#//Requisition" containment="true" eOpposite="#//Requisition/patient"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Doctor" eSuperTypes="#//PersonRole">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="signature" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="requisitions" upperBound="-1"
        eType="#//Requisition" eOpposite="#//Requisition/doctor"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Requisition">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="effectiveDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="repetitionCount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="repetitionInterval" eType="#//Interval"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="patient" eType="#//Patient"
        eOpposite="#//Patient/requisitions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="doctor" eType="#//Doctor"
        eOpposite="#//Doctor/requisitions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appointment" eType="#//Appointment"
        eOpposite="#//Appointment/requisition"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specificTests" upperBound="-1"
        eType="#//SpecificTest" containment="true" eOpposite="#//SpecificTest/requisition"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Appointment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="confirmation" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime" eType="#//LocalTime"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endTime" eType="#//LocalTime"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lab" eType="#//Lab" eOpposite="#//Lab/appointments"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="requisition" eType="#//Requisition"
        eOpposite="#//Requisition/appointment"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SpecificTest">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="requisition" eType="#//Requisition"
        eOpposite="#//Requisition/specificTests"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="testResult" eType="#//TestResult"
        containment="true" eOpposite="#//TestResult/specificTest"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="test" eType="#//Test" eOpposite="#//Test/specificTests"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TestResult">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="result" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="report" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specificTest" eType="#//SpecificTest"
        eOpposite="#//SpecificTest/testResult"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BusinessHour">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dayOfWeek" eType="#//DayOfWeek"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime" eType="#//LocalTime"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endTime" eType="#//LocalTime"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="lab" eType="#//Lab" eOpposite="#//Lab/businessHours"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Lab">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="registrationNumber" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="changeCancelFee" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="appointments" upperBound="-1"
        eType="#//Appointment" containment="true" eOpposite="#//Appointment/lab"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="businessHours" upperBound="7"
        eType="#//BusinessHour" containment="true" eOpposite="#//BusinessHour/lab"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Test">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="specificTests" upperBound="-1"
        eType="#//SpecificTest" eOpposite="#//SpecificTest/test"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="testType" eType="#//TestType"
        eOpposite="#//TestType/tests"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TestType">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="durationAdditive" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="access" eType="#//AccessType"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tests" upperBound="-1"
        eType="#//Test" eOpposite="#//Test/testType"/>
  </eClassifiers>
</ecore:EPackage>
