@namespace(uri="http://www.example.org/Doctor", prefix="p")
package Doctor;

class Doctor {
  attr int practitionerNumber;
  attr Image signature;
  attr string fullName;
  attr string address;
  attr string phoneNumber;
}

@namespace(uri="http://www.example.org/Patient", prefix="p")
package Patient;

class Patient {
  attr string healthNumber;
  attr string firstName;
  attr string lastName;
  attr Date dateOfBirth;
  attr string address;
  attr string phoneNumber;
}

@namespace(uri="http://www.example.org/Requisition", prefix="p")
package Requisition;

class Requisition {
  attr Date validFromDate;
  attr int repetitionCount;
  attr string repetitionInterval;
  ref Doctor prescribedBy;
  ref Patient forPatient;
  val Test[*] tests;
  val Appointment[*] appointments;
}

@namespace(uri="http://www.example.org/Test", prefix="p")
package Test;

class Test {
  attr string name;
  attr int duration;
  ref TestGroup group;
}
class TestGroup {
  attr string groupName;
}

@namespace(uri="http://www.example.org/Appointment", prefix="p")
package Appointment;

class Appointment {
  attr string confirmationNumber;
  attr Date date;
  attr time startTime;
  attr time endTime;
  ref Patient patient;
  ref Lab lab;
}

@namespace(uri="http://www.example.org/Lab", prefix="p")
package Lab;

class Lab {
  attr string address;
  attr string businessHours;
  attr float changeCancellationFee;
  attr string registrationNumber;
}