<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ecore PUBLIC "-//Eclipse//DTD Ecore//EN" "http://www.eclipse.org/emf/2002/Ecore">
<ecore:EPackage xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    ecore:exporter="org.eclipse.emf.ecore.xmi.EcoreXMI" 
    name="LabTracker" nsURI="platform:/resource/LabTracker/nl2ecore/phoenix/generated.ecore" nsPrefix="ptk">
  
  <eClassifiers>

    <!-- Root Container Class -->
    <eClass eSuperTypes="_EClassifier" name="LabTracker"/>
    
    <!-- Doctor Class -->
    <eClass name="Doctor">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:EString" name="fullName"/>
        <eAttribute dataType="ecore:EString" name="address"/>
        <eAttribute dataType="ecore:EString" name="phoneNumber"/>
        <eAttribute dataType="ecore:ELong" name="practitionerNumber"/>
        <eAttribute dataType="ecore:EImage" name="digitalSignature"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Patient Class -->
    <eClass name="Patient">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:EString" name="healthNumber"/>
        <eAttribute dataType="ecore:EString" name="firstName"/>
        <eAttribute dataType="ecore:EString" name="lastName"/>
        <eAttribute dataType="ecore:ZonedDateTime" name="dateOfBirth"/>
        <eAttribute dataType="ecore:EString" name="address"/>
        <eAttribute dataType="ecore:EString" name="phoneNumber"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Test Class -->
    <eClass name="Test">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:EString" name="name"/>
        <eAttribute dataType="ecore:EDuration" name="duration"/> 
        <eReference multiplicity="0..*" name="requisitions" containment="false"
                     eType="ptk:LabTest">
          <eOpposite>eClassifiers/#//Requisition</eOpposite>
        </eReference>
      </eStructuralFeatures>
    </eClass>

    <!-- Requisition Class and Related Classes -->
    <eClass name="Requisition">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:ELocalDate" name="validFrom"/>
        <eReference multiplicity="1.." name="associatedDoctor" eType="#ptk:Doctor" containment="false"/>
        <eReference multiplicity="1..*" name="labTest" eType="#ptk:LabTest" containment="false">
          <eOpposite>eClassifiers/#//Requisition</eOpposite>
        </eReference>
      </eStructuralFeatures>
    </eClass>

    <!-- Association with Requisition and Repeat Test Info -->
    <eClass name="RepetitionPattern">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:EInt" name="numberOfTimes"/>
        <eAttribute name="repeatInterval" eType="ptk:RepeatIntervalEnum"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="LabTest">
      <eStructuralFeatures>
        <eReference multiplicity="1..*" name="tests" containment="true"
                    eOpposite="requisitions" eType="#ptk:Test"/>
        <eReference multiplicity="0..1" name="repetitionPattern" eType="#ptk:RepetitionPattern"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Lab Class -->
    <eClass name="Lab">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:EString" name="name"/>
        <eAttribute dataType="ecore:EString" name="address"/>
        <eAttribute dataType="ecore:EInt" name="registrationNumber"/>
        <eAttribute multiplicity="*" name="businessHours" eType="#ptk:LocalTimeRange"/>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Appointment">
      <eStructuralFeatures>
        <eReference containment="true" multiplicity="0..*" name="patient"
                     eOpposite="_Appointments" eType="#ptk:Patient"/>
        <eAttribute dataType="ecore:EInt" name="confirmationNumber"/>
        <eAttribute dataType="ecore:ELocalDateTime" name="appointmentDate"/>
        <eAttribute dataType="#ptk.LocalTimeRange" name="startAndEndTime"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Enum for Repeat Interval -->
    <eEnum name="RepeatIntervalEnum">
      <eLiterals>
        <eEnumLiteral name="WEEKLY"/>
        <eEnumLiteral name="MONTHLY"/>
        <eEnumLiteral name="HALF_YEARLY"/>
        <eEnumLiteral name="YEARLY"/>
      </eLiterals>
    </eEnum>

    <!-- Custom Datatype for Time Ranges -->
    <eClass name="LocalTimeRange">
      <eStructuralFeatures>
        <eAttribute dataType="ecore:EJDT" name="start"/> <!-- Using EJavaDate or similar object type here should be aligned with usage context -->
        <eAttribute dataType="ecore:EJDT" name="end"/>
      </eStructuralFeatures>
    </eClass>

  </eClassifiers>
</ecore:EPackage>
