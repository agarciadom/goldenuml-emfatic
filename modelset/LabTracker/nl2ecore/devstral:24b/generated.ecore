<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="LabTracker" nsURI="http://labtracker.example" nsPrefix="LabTracker" xmi:version="2.0">

    <!-- Root Container -->
    <eClassifiers xsi:type="ecore:EClass" name="SystemContainer">
      <eStructuralFeatures xsi:type="ecore:EReference" name="doctors" upperBound="-1" eType="#//Doctor" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="patients" upperBound="-1" eType="#//Patient" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="tests" upperBound="-1" eType="#//Test" containment="true"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="labs" upperBound="-1" eType="#//Lab" containment="true"/>
    </eClassifiers>

    <!-- Doctor Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Doctor">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="practitionerNumber" eType="ecore:EInt"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="signatureImage" eType="#//DigitalSignature"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="fullName" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber" eType="ecore:EString"/>
    </eClassifiers>

    <!-- Patient Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Patient">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="healthNumber" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstName" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastName" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateOfBirth" eType="#//DateTime"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="phoneNumber" eType="ecore:EString"/>
    </eClassifiers>

    <!-- Test Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Test">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="testGroup" eType="#//TestGroup"/>
    </eClassifiers>

    <!-- Test Group Class -->
    <eClassifiers xsi:type="ecore:EClass" name="TestGroup">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="groupName" eType="ecore:EString"/>
    </eClassifiers>

    <!-- Requisition Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Requisition">
      <eStructuralFeatures xsi:type="ecore:EReference" name="doctor" eType="#//Doctor"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="patient" eType="#//Patient"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="validFromDate" eType="#//DateTime"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="tests" upperBound="-1" eType="#//Test"/>
    </eClassifiers>

    <!-- Test Result Class -->
    <eClassifiers xsi:type="ecore:EClass" name="TestResult">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="resultStatus" eType="ecore:EString"/> <!-- Positive/Negative -->
      <eStructuralFeatures xsi:type="ecore:EReference" name="report" upperBound="-1" eType="#//Report"/>
    </eClassifiers>

    <!-- Report Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Report">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="content" eType="ecore:EString"/>
    </eClassifiers>

    <!-- Appointment Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Appointment">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="confirmationNumber" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="lab" eType="#//Lab"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="appointmentDateTime" eType="#//DateTime"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime" eType="#//TimeWithoutDate"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="endTime" eType="#//TimeWithoutDate"/>
    </eClassifiers>

    <!-- Lab Class -->
    <eClassifiers xsi:type="ecore:EClass" name="Lab">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="registrationNumber" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="address" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EReference" name="businessHours" upperBound="-1" eType="#//BusinessHour"/>
    </eClassifiers>

    <!-- Business Hour Class -->
    <eClassifiers xsi:type="ecore:EClass" name="BusinessHour">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="dayOfWeek" eType="ecore:EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime" eType="#//TimeWithoutDate"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="endTime" eType="#//TimeWithoutDate"/>
    </eClassifiers>

    <!-- Custom Data Types -->
    <eClassifiers xsi:type="ecore:EDataType" name="DigitalSignature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL">
        <details key="documentation">Represents a digital signature (image of actual signature)</details>
      </eAnnotations>
    </eClassifiers>

    <!-- Custom Data Type for Date and Time -->
    <eClassifiers xsi:type="ecore:EDataType" name="DateTime"/>
    <eClassifiers xsi:type="ecore:EDataType" name="TimeWithoutDate"/>

  </ecore:EPackage>
</xmi:XMI>
