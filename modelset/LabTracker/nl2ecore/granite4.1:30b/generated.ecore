<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="labtracker"
    xmlns="http://www.eclipse.org/emf/2003/xsd"
    eClassifiers="
        $class@LabTrackerRoot
        $class@Person
        $class@Doctor
        $class@Patient
        $class@Requisition
        $class@TestGroup
        $class@Test
        $class@Appointment
        $class@Result
        $class@Lab
        $class@BusinessHours
        $enum@IntervalType
        $type@LocalTime">

  <eClassifiers>
    <!-- Root container class -->
    <eClass name="LabTrackerRoot">
      <eStructuralFeatures>
        <eFeature name="doctors" type="$class@Doctor" upperBound="-1" containment="true"/>
        <eFeature name="patients" type="$class@Patient" upperBound="-1" containment="true"/>
        <eFeature name="requisitions" type="$class@Requisition" upperBound="-1" containment="true"/>
        <eFeature name="labs" type="$class@Lab" upperBound="-1" containment="true"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Base class for persons -->
    <eClass name="Person">
      <eStructuralFeatures>
        <eFeature name="fullName"   type="String"/>
        <eFeature name="address"    type="String"/>
        <eFeature name="phoneNumber"type="String"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Doctor class -->
    <eClass name="Doctor" eSuperTypes="$class@Person">
      <eStructuralFeatures>
        <eFeature name="practitionerNumber" type="Long"/>
        <eFeature name="signatureImage"     type="byte[]"/>
      </eStructuralFeatures>

      <!-- createRequisition operation -->
      <eOperations>
        <eOperation name="createRequisition">
          <eParameter name="patient"    type="$class@Patient"/>
          <eParameter name="testGroup"  type="$class@TestGroup"/>
          <eParameter name="validFrom"  type="EDate"/>
          <eParameter name="repeatPattern"
                       type="$enum@IntervalType" upperBound="-1"/>
          <eType                type="$class@Requisition"/>
        </eOperation>
      </eOperations>
    </eClass>

    <!-- Patient class -->
    <eClass name="Patient" eSuperTypes="$class@Person">
      <eStructuralFeatures>
        <eFeature name="healthNumber"  type="String"/>
        <eFeature name="dateOfBirth"   type="EDate"/>
      </eStructuralFeatures>

      <!-- bookAppointment operation -->
      <eOperations>
        <eOperation name="bookAppointment">
          <eParameter name="requisition" type="$class@Requisition"/>
          <eParameter name="lab"         type="$class@Lab"/>
          <eParameter name="startTime"   type="$type@LocalTime"/>
          <eType                type="$class@Appointment"/>
        </eOperation>
      </eOperations>
    </eClass>

    <!-- Requisition class -->
    <eClass name="Requisition">
      <eStructuralFeatures>
        <eFeature name="doctor"     type="$class@Doctor"   lowerBound="1"/>
        <eFeature name="patient"    type="$class@Patient"  lowerBound="1"/>
        <eFeature name="validFrom"  type="EDate"/>
        <eFeature name="testGroup"  type="$class@TestGroup" lowerBound="1"/>
        <eFeature name="repeatPattern"
                  type="$enum@IntervalType" upperBound="1"/>
        <eFeature name="tests"      type="$class@Test"     upperBound="-1"
                  containment="true"/>
        <eFeature name="appointment"type="$class@Appointment" upperBound="1"/>
      </eStructuralFeatures>
    </eClass>

    <!-- TestGroup class -->
    <eClass name="TestGroup">
      <eStructuralFeatures>
        <eFeature name="name"           type="String"/>
        <eFeature name="tests"          type="$class@Test"
                  upperBound="-1" containment="true"/>
        <eFeature name="singleDuration" type="boolean"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Test class -->
    <eClass name="Test">
      <eStructuralFeatures>
        <eFeature name="name"     type="String"/>
        <eFeature name="duration" type="$type@LocalTime"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Appointment class -->
    <eClass name="Appointment">
      <eStructuralFeatures>
        <eFeature name="requisition"type="$class@Requisition" lowerBound="1"/>
        <eFeature name="lab"         type="$class@Lab"        lowerBound="1"/>
        <eFeature name="confirmationNumber" type="String"/>
        <eFeature name="date"        type="EDate"/>
        <eFeature name="startTime"   type="$type@LocalTime"/>
        <eFeature name="endTime"     type="$type@LocalTime"/>
        <eFeature name="fee"         type="Double"/>
      </eStructuralFeatures>

      <!-- cancel operation -->
      <eOperations>
        <eOperation name="cancel">
          <eParameter name="reason" type="String"/>
          <eType                name="void"/>
        </eOperation>
      </eOperations>
    </eClass>

    <!-- Result class -->
    <eClass name="Result">
      <eStructuralFeatures>
        <eFeature name="test"   type="$class@Test"  lowerBound="1"/>
        <eFeature name="outcome"type="String"       lowerBound="1"/>
        <eFeature name="report" type="String"/>
      </eStructuralFeatures>
    </eClass>

    <!-- Lab class -->
    <eClass name="Lab">
      <eStructuralFeatures>
        <eFeature name="name"                 type="String"/>
        <eFeature name="address"              type="String"/>
        <eFeature name="registrationNumber"   type="String"/>
        <eFeature name="businessHours"
                  type="$class@BusinessHours" lowerBound="1"/>
      </eStructuralFeatures>
    </eClass>

    <!-- BusinessHours class -->
    <eClass name="BusinessHours">
      <eStructuralFeatures>
        <eFeature name="dailyStartTime" type="$type@LocalTime"/>
        <eFeature name="dailyEndTime"   type="$type@LocalTime"/>
      </eStructuralFeatures>
    </eClass>

    <!-- IntervalType enumeration -->
    <eEnum name="IntervalType">
      <eLiterals>
        <eLiteral name="weekly"/>
        <eLiteral name="monthly"/>
        <eLiteral name="halfYearly"/>
        <eLiteral name="yearly"/>
      </eLiterals>
    </eEnum>

    <!-- Custom datatype for LocalTime -->
    <eDataType name="LocalTime" instanceClassName="java.time.LocalTime"/>
  </eClassifiers>
</ecore:EPackage>
