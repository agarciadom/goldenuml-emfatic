<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="busSystem"
    nsURI="http://www.example.org/busSystem"
    nsPrefix="busSystem">

  <!-- Custom datatype for DateTime using java.time.LocalDateTime -->
  <eClassifiers xsi:type="ecore:EDataType" name="DateTime"
      instanceClassName="java.time.LocalDateTime"/>

  <eClassifiers xsi:type="ecore:EClass" name="BusLine">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="destination"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="priceCategory"
        eType="#//PriceCategory"
        eOpposite="#//PriceCategory/busLines"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trajectories"
        upperBound="-1"
        eType="#//Trajectory"
        containment="true"
        eOpposite="#//Trajectory/busLine"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PriceCategory">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="price"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="busLines"
        upperBound="-1"
        eType="#//BusLine"
        eOpposite="#//BusLine/priceCategory"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Trajectory">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="busLine"
        eType="#//BusLine"
        eOpposite="#//BusLine/trajectories"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="busOnTrajectories"
        upperBound="-1"
        eType="#//BusOnTrajectory"
        containment="true"
        eOpposite="#//BusOnTrajectory/trajectory"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Bus">
    <eStructuralFeatures xsi:type="ecore:EReference" name="busOnTrajectories"
        upperBound="-1"
        eType="#//BusOnTrajectory"
        eOpposite="#//BusOnTrajectory/bus"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="BusOnTrajectory">
    <eStructuralFeatures xsi:type="ecore:EReference" name="trajectory"
        eType="#//Trajectory"
        eOpposite="#//Trajectory/busOnTrajectories"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="bus"
        eType="#//Bus"
        eOpposite="#//Bus/busOnTrajectories"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trips"
        upperBound="-1"
        eType="#//Trip"
        containment="true"
        eOpposite="#//Trip/busOnTrajectory"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mensoTrips"
        upperBound="-1"
        eType="#//MensoTrip"
        eOpposite="#//MensoTrip/busOnTrajectory"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Trip">
    <eStructuralFeatures xsi:type="ecore:EReference" name="busOnTrajectory"
        eType="#//BusOnTrajectory"
        eOpposite="#//BusOnTrajectory/trips"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="MensoTicket">
    <eStructuralFeatures xsi:type="ecore:EReference" name="mensoTrips"
        upperBound="-1"
        eType="#//MensoTrip"
        containment="true"
        eOpposite="#//MensoTrip/mensoTicket"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="customer"
        eType="#//Customer"
        eOpposite="#//Customer/mensoTickets"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoices"
        upperBound="-1"
        eType="#//Invoice"
        eOpposite="#//Invoice/mensoTicket"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="MensoTrip">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tripDateTime"
        eType="#//DateTime"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mensoTicket"
        eType="#//MensoTicket"
        eOpposite="#//MensoTicket/mensoTrips"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="busOnTrajectory"
        eType="#//BusOnTrajectory"
        eOpposite="#//BusOnTrajectory/mensoTrips"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLine"
        eType="#//InvoiceLine"
        eOpposite="#//InvoiceLine/mensoTrip"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="InvoiceLine">
    <eStructuralFeatures xsi:type="ecore:EReference" name="mensoTrip"
        eType="#//MensoTrip"
        eOpposite="#//MensoTrip/invoiceLine"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoice"
        eType="#//Invoice"
        eOpposite="#//Invoice/invoiceLines"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Invoice">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="total"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="invoiceLines"
        upperBound="-1"
        eType="#//InvoiceLine"
        containment="true"
        eOpposite="#//InvoiceLine/invoice"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mensoTicket"
        eType="#//MensoTicket"
        eOpposite="#//MensoTicket/invoices"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Customer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="homeAddress"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="officeAddress"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="workingHours"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="mensoTickets"
        upperBound="-1"
        eType="#//MensoTicket"
        containment="true"
        eOpposite="#//MensoTicket/customer"/>
  </eClassifiers>

</ecore:EPackage>
