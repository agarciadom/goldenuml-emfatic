<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="DeLijn" nsURI="http://www.de-lijn.be/schema/DeLijn" nsPrefix="de-lijn">
  <eClassifiers>
    <eClass name="BusCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trajectory">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="approvalStatus" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="suspensionReason" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="approvalStates" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="busLine" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ApprovalState">
      <eStructuralFeatures>
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="approvalDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="comments" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusLine">
      <eStructuralFeatures>
        <eAttribute name="lineNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="category" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="trajectories" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="buses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="busId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="trajectory" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MENSO_Ticket">
      <eStructuralFeatures>
        <eReference name="customer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="trips" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="homeAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="officeAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="workingHours" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="invoiceId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="amount" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="paymentDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="customer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
