<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="BusCompany" nsURI="http://www.deLijn.be/BusCompany" nsPrefix="delijn">
  <eClassifiers>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lineNumber" lowerBound="0" upperBound="1" eType="//EInt" />
        <eReference name="assignedTo" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Line">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="category" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="trajectories" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="mensoCustomers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trajectory">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="endDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="belongsTo" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="approvals" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="assignedBuses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Approval">
      <eStructuralFeatures>
        <eAttribute name="approvalDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="refusalReason" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="forTrajectory" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusCompany">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="ownsBuses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="managesLines" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="managesTrajectories" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MENSO">
      <eStructuralFeatures>
        <eAttribute name="customerID" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="issueDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="validityPeriod" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="homeAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="officeAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="workingHours" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="mensoTicket" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="usedLines" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
