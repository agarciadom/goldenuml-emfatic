@namespace(uri="http://www.deLijn.be/BusCompany", prefix="delijn")
package BusCompany;

import "http://www.eclipse.org/emf/2002/Ecore";

class Bus {
	attr ecore.EString[1] ~id;
	attr ecore.EInt lineNumber;
	ref Trajectory assignedTo;
}

class Line {
	attr ecore.EString[1] ~id;
	attr ecore.EString category;
	attr ecore.EString name;
	val Trajectory[*] trajectories;
	ref Customer[*] mensoCustomers;
}

class Trajectory {
	attr ecore.EString[1] ~id;
	attr ecore.EString status;
	attr ecore.EDate startDate;
	attr ecore.EDate endDate;
	ref Line[1] belongsTo;
	val Approval[*] approvals;
	ref Bus[*] assignedBuses;
}

class Approval {
	attr ecore.EDate approvalDate;
	attr ecore.EString refusalReason;
	ref Trajectory[1] forTrajectory;
}

class BusCompany {
	attr ecore.EString name;
	val Bus[*] ownsBuses;
	val Line[*] managesLines;
	val Trajectory[*] managesTrajectories;
}

class MENSO {
	attr ecore.EString[1] customerID;
	attr ecore.EDate issueDate;
	attr ecore.EInt validityPeriod;
}

class Customer {
	attr ecore.EString[1] ~id;
	attr ecore.EString name;
	attr ecore.EString homeAddress;
	attr ecore.EString officeAddress;
	attr ecore.EString workingHours;
	val MENSO mensoTicket;
	ref Line[*] usedLines;
}


