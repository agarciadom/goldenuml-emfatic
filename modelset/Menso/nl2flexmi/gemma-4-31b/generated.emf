@namespace(uri="http://www.delijn.be/emodel", prefix="delijn")
package DeLijn;

import "http://www.eclipse.org/emf/2002/Ecore";

class DeLijnSystem {
	val BusLine[*] busLines;
	val Trajectory[*] trajectories;
	val Bus[*] buses;
	val Customer[*] customers;
	val TownAuthority[*] townAuthorities;
	val Trip[*] trips;
}

class BusLine {
	attr ecore.EString[1] lineNumber;
	attr ecore.EString[1] category;
	ref Trajectory[+] trajectories;
}

class Trajectory {
	attr ecore.EString description;
	attr ecore.EString[1] status;
	attr ecore.EDate startDate;
	ref ApprovalRequest[*] approvalRequests;
	ref Bus[*] assignedBuses;
}

class Bus {
	attr ecore.EString[1] identifier;
}

class ApprovalRequest {
	attr ecore.EDate[1] requestDate;
	attr ecore.EString[1] result;
	ref TownAuthority[1] authority;
}

class TownAuthority {
	attr ecore.EString[1] name;
}

class Customer {
	attr ecore.EString[1] homeAddress;
	attr ecore.EString officeAddress;
	attr ecore.EString workingHours;
	val MENSO_Card[*] mensoCards;
	val Invoice[*] invoices;
}

class MENSO_Card {
	attr ecore.EString[1] cardNumber;
	attr ecore.EDate[1] expiryDate;
}

class Trip {
	attr ecore.EString[1] time;
	attr ecore.EDate[1] date;
	ref BusLine[1] line;
	ref MENSO_Card card;
}

class Invoice {
	attr ecore.EBigDecimal[1] amount;
	attr ecore.EDouble discount;
	attr ecore.EBoolean[1] isPaid;
	ref Trip[+] trips;
}


