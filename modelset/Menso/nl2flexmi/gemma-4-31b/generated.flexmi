<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="DeLijn" nsURI="http://www.delijn.be/emodel" nsPrefix="delijn">
  <eClassifiers>
    <eClass name="DeLijnSystem">
      <eStructuralFeatures>
        <eReference name="busLines" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="trajectories" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="buses" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="townAuthorities" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="trips" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="BusLine">
      <eStructuralFeatures>
        <eAttribute name="lineNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="category" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="trajectories" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trajectory">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eReference name="approvalRequests" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="assignedBuses" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Bus">
      <eStructuralFeatures>
        <eAttribute name="identifier" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ApprovalRequest">
      <eStructuralFeatures>
        <eAttribute name="requestDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="result" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="authority" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TownAuthority">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="homeAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="officeAddress" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="workingHours" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="mensoCards" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.7" />
        <eReference name="invoices" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="MENSO_Card">
      <eStructuralFeatures>
        <eAttribute name="cardNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="expiryDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Trip">
      <eStructuralFeatures>
        <eAttribute name="time" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="line" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="card" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Invoice">
      <eStructuralFeatures>
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="discount" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="isPaid" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="trips" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
