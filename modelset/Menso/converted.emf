@namespace(uri="http://www.example.org/busSystem", prefix="busSystem")
package busSystem;

datatype DateTime : java.time.LocalDateTime;

class BusLine {
	attr String destination;
	ref PriceCategory#busLines priceCategory;
	val Trajectory[*]#busLine trajectories;
}

class PriceCategory {
	attr double price;
	ref BusLine[*]#priceCategory busLines;
}

class Trajectory {
	attr String status;
	ref BusLine#trajectories busLine;
	val BusOnTrajectory[*]#trajectory busOnTrajectories;
}

class Bus {
	ref BusOnTrajectory[*]#bus busOnTrajectories;
}

class BusOnTrajectory {
	ref Trajectory#busOnTrajectories trajectory;
	ref Bus#busOnTrajectories bus;
	val Trip[*]#busOnTrajectory trips;
	ref MensoTrip[*]#busOnTrajectory mensoTrips;
}

class Trip {
	ref BusOnTrajectory#trips busOnTrajectory;
}

class MensoTicket {
	val MensoTrip[*]#mensoTicket mensoTrips;
	ref Customer#mensoTickets customer;
	ref Invoice[*]#mensoTicket invoices;
}

class MensoTrip {
	attr DateTime tripDateTime;
	ref MensoTicket#mensoTrips mensoTicket;
	ref BusOnTrajectory#mensoTrips busOnTrajectory;
	ref InvoiceLine#mensoTrip invoiceLine;
}

class InvoiceLine {
	ref MensoTrip#invoiceLine mensoTrip;
	ref Invoice#invoiceLines invoice;
}

class Invoice {
	attr double total;
	attr double discount;
	val InvoiceLine[*]#invoice invoiceLines;
	ref MensoTicket#invoices mensoTicket;
}

class Customer {
	attr String name;
	attr String homeAddress;
	attr String officeAddress;
	attr String workingHours;
	val MensoTicket[*]#customer mensoTickets;
}


