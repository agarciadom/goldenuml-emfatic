@namespace(uri="http://www.example.org/busSystem", prefix="busSystem")
package busSystem;

class BusLine {
	attr String Destination;
	ref PriceCategory#busLines priceCategory;
	ref Trajectory[*]#busLine trajectories;
}

class PriceCategory {
	attr double Price;
	ref BusLine[*]#priceCategory busLines;
}

class Trajectory {
	attr String Status;
	ref BusLine[1]#trajectories busLine;
	ref BusOnTrajectory[*]#trajectory busOnTrajectories;
}

class Bus {
	ref BusOnTrajectory[*]#bus busOnTrajectories;
}

class BusOnTrajectory {
	ref Trajectory[1]#busOnTrajectories trajectory;
	ref Bus[1]#busOnTrajectories bus;
	ref Trip[*]#busOnTrajectory trips;
	ref MensoTrip[*]#busOnTrajectory mensoTrips;
}

class Trip {
	ref BusOnTrajectory[1]#trips busOnTrajectory;
}

class MensoTicket {
	ref MensoTrip[*]#mensoTicket mensoTrips;
	ref Customer[1]#mensoTickets customer;
	ref Invoice[*]#mensoTicket invoices;
}

class MensoTrip {
	attr String TripDateTime;
	ref MensoTicket[1]#mensoTrips mensoTicket;
	ref BusOnTrajectory[1]#mensoTrips busOnTrajectory;
	ref InvoiceLine#mensoTrip invoiceLine;
}

class InvoiceLine {
	ref MensoTrip[1]#invoiceLine mensoTrip;
	ref Invoice[1]#invoiceLines invoice;
}

class Invoice {
	attr double Total;
	attr double Discount;
	ref InvoiceLine[*]#invoice invoiceLines;
	ref MensoTicket[1]#invoices mensoTicket;
}

class Customer {
	attr String Name;
	attr String HomeAddress;
	attr String OfficeAddress;
	attr String WorkingHours;
	ref MensoTicket[*]#customer mensoTickets;
}


