<model xmlns="http://www.eclipse.org/emf/2003/XMI"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       ecore:XMI.id="_root"
       ecore:XMI.version="2.0">

  <!-- Root container for the entire metamodel -->
  <ownedElement xsi:type="ecore:EClass" name="DeLijnModel">
    <eStructuralFeatures>
      <eFeature name="busCompanies"   type="BusCompany"  upperBound="-1" containment="true"/>
      <eFeature name="trajectories"   type="Trajectory"  upperBound="-1" containment="true"/>
      <eFeature name="lines"          type="Line"        upperBound="-1" containment="true"/>
      <eFeature name="busDrivers"     type="BusDriver"   upperBound="-1" containment="true"/>
      <eFeature name="buses"          type="Bus"         upperBound="-1" containment="true"/>
      <eFeature name="menoUsers"      type="MENSOUser"   upperBound="-1" containment="true"/>
      <eFeature name="monthlyInvoices"type="MonthlyInvoice"upperBound="-1" containment="true"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Core domain classes -->
  <ownedElement xsi:type="ecore:EClass" name="BusCompany">
    <eStructuralFeatures>
      <eFeature name="name"       type="String"/>
      <eFeature name="busLines"   type="Line" upperBound="-1" containment="true"/>
    </eStructuralFeatures>
  </ownedElement>

  <ownedElement xsi:type="ecore:EClass" name="Trajectory">
    <eStructuralFeatures>
      <eFeature name="id"          type="String"/>
      <eFeature name="description" type="String"/>
      <eFeature name="status"      type="TrajectoryStatus" default="PENDING"/>
      <eFeature name="approvalRequests"type="ApprovalRequest" upperBound="-1" containment="true"/>
      <eFeature name="operationalSince"  type="EDate"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Enumeration for trajectory approval status -->
  <ownedElement xsi:type="ecore:EEnum" name="TrajectoryStatus">
    <eLiterals>
      <eLiteral name="PENDING"/>
      <eLiteral name="APPROVED"/>
      <eLiteral name="SUSPENDED"/>
      <eLiteral name="CANCELLED"/>
    </eLiterals>
  </ownedElement>

  <!-- Approval process classes -->
  <ownedElement xsi:type="ecore:EClass" name="ApprovalRequest">
    <eStructuralFeatures>
      <eFeature name="submittedAt"   type="EDateTime"/>
      <eFeature name="authorityResponse"type="AuthorityResponse" containment="true"/>
    </eStructuralFeatures>
  </ownedElement>

  <ownedElement xsi:type="ecore:EClass" name="AuthorityResponse">
    <eStructuralFeatures>
      <eFeature name="decision"   type="DecisionOutcome"/>
      <eFeature name="reason"     type="String"/>
      <eFeature name="requestedChanges"  type="ChangeRequest" upperBound="-1" containment="true"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Enumeration for authority decision -->
  <ownedElement xsi:type="ecore:EEnum" name="DecisionOutcome">
    <eLiterals>
      <eLiteral name="APPROVE"/>
      <eLiteral name="REFUSE"/>
      <eLiteral name="MODIFY"/>
    </eLiterals>
  </ownedElement>

  <ownedElement xsi:type="ecore:EClass" name="ChangeRequest">
    <eStructuralFeatures>
      <eFeature name="description" type="String"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Line and its relation to trajectories -->
  <ownedElement xsi:type="ecore:EClass" name="Line">
    <eStructuralFeatures>
      <eFeature name="lineNumber"   type="Integer"/>
      <eFeature name="category"     type="String"/>          <!-- MENSO category -->
      <eFeature name="trajectories" type="Trajectory" upperBound="-1" changeable="false"/>
    </eStructuralFeatures>
    <eOperations>
      <eOperation name="isEligibleForMENSO" returnType="boolean">
        <eParameters name="user" type="MENSOUser"/>
      </eOperation>
    </eOperations>
  </ownedElement>

  <!-- Bus vehicle class -->
  <ownedElement xsi:type="ecore:EClass" name="Bus">
    <eStructuralFeatures>
      <eFeature name="id"           type="String"/>
      <eFeature name="busNumber"    type="Integer"/>
      <eFeature name="currentLineAssignment"type="Line" upperBound="1"/>
      <eFeature name="driverAssignments"   type="DriverAssignment" upperBound="-1" containment="true"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Driver assignment as association class -->
  <ownedElement xsi:type="ecore:EClass" name="DriverAssignment">
    <eStructuralFeatures>
      <eFeature name="bus"          type="Bus"     transient="true"/>
      <eFeature name="driver"       type="BusDriver" upperBound="1"/>
      <eFeature name="assignmentPeriod"type="GregorianCalendar"
                eType="_ecore:data_types:EDateTime"/>
    </eStructuralFeatures>
  </ownedElement>

  <ownedElement xsi:type="ecore:EClass" name="BusDriver">
    <eStructuralFeatures>
      <eFeature name="name"         type="String"/>
      <eFeature name="employeeId"   type="String"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- MENSO subscription and usage -->
  <ownedElement xsi:type="ecore:EClass" name="MENSOUser">
    <eStructuralFeatures>
      <eFeature name="userCardId"   type="String"/>
      <eFeature name="homeAddress"  type="Address"/>
      <eFeature name="officeAddress"type="Address"/>
      <eFeature name="workingHours" type="DailySchedule"/>
      <eFeature name="menoTrips"    type="TripRecord" upperBound="-1" containment="true"/>
    </eStructuralFeatures>
  </ownedElement>

  <ownedElement xsi:type="ecore:EClass" name="Address">
    <eStructuralFeatures>
      <eFeature name="street"       type="String"/>
      <eFeature name="city"         type="String"/>
      <eFeature name="postalCode"   type="String"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Custom datatype for time‑only values (using java.time.LocalTime) -->
  <ownedElement xsi:type="ecore:EDatatype" name="TimeOnly">
    <ePrimitiveType href="http://www.eclipse.org/emf/2003/XMLSchema/java.time.LocalTime"/>
  </ownedElement>

  <ownedElement xsi:type="ecore:EClass" name="DailySchedule">
    <eStructuralFeatures>
      <eFeature name="startTime"   type="TimeOnly"/>
      <eFeature name="endTime"     type="TimeOnly"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Trip recording -->
  <ownedElement xsi:type="ecore:EClass" name="TripRecord">
    <eStructuralFeatures>
      <eFeature name="timestamp"    type="EDateTime"/>
      <eFeature name="lineUsed"     type="Line"/>
      <eFeature name="fareAmount"   type="Double" defaultValue="0.0"/>
    </eStructuralFeatures>
  </ownedElement>

  <!-- Invoicing -->
  <ownedElement xsi:type="ecore:EClass" name="MonthlyInvoice">
    <eStructuralFeatures>
      <eFeature name="invoiceMonth"          type="EDate"/>
      <eFeature name="user"                  type="MENSOUser" upperBound="1"/>
      <eFeature name="totalAmountBeforeDiscount" type="Double"/>
      <eFeature name="appliedDiscountPercent"    type="Integer" defaultValue="0"/>
      <eFeature name="totalAmountAfterDiscount"  type="Double"/>
      <eFeature name="isPaid"                type="boolean" defaultValue="false"/>
    </eStructuralFeatures>
  </ownedElement>

</model>
