<xmi:XMI xmlns:xmi="http://schema.omg.org/spec/XMI/2.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
    <ecore:EPackage xmi:id="_0" name="ots" nsURI="ots" nsPrefix="ots">
        <!-- Root container class -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_1" name="OtsModel">
            <ecore:eStructuralFeatures>
                <ecore:EReference name="tutors" eType="_2" containment="true"/>
                <ecore:EReference name="students" eType="_3" containment="true"/>
                <ecore:EReference name="offers" eType="_4" containment="true"/>
                <ecore:EReference name="requests" eType="_5" containment="true"/>
                <ecore:EReference name="sessions" eType="_6" containment="true"/>
                <ecore:EReference name="awards" eType="_7" containment="true"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Person class (common attributes for Tutor and Student) -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_8" name="Person">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="name" eType="ecore:String"/>
                <ecore:EAttribute name="email" eType="ecore:String"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Tutor class -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_2" name="Tutor"
                             eSuperTypes="_8">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="bankAccount" eType="ecore:String"/>
                <ecore:EReference name="offers" eType="_4" containment="true"/>
                <ecore:EReference name="sessions" eType="_6" upper="-1"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Student class -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_3" name="Student"
                             eSuperTypes="_8">
            <ecore:eStructuralFeatures>
                <ecore:EReference name="requests" eType="_5" containment="true"/>
                <ecore:EReference name="sessions" eType="_6" upper="-1"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Offer class (association between Tutor and Subject) -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_4" name="Offer">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="expertiseLevel" eType="ecore:String"/>
                <ecore:EAttribute name="hourlyPrice" eType="ecore:Double"/>
                <ecore:EReference name="tutor" eType="_2"/>
                <ecore:EReference name="subject" eType="_11"/>
                <ecore:EReference name="availabilitySlots"
                                  eType="_12" containment="true"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Request class (association between Student and Offer) -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_5" name="Request">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="desiredLevel" eType="ecore:String"/>
                <ecore:EAttribute name="proposedDateTime"
                                  eType="ecore:LocalDateTime"/>
                <ecore:EReference name="student" eType="_3"/>
                <ecore:EReference name="offer" eType="_4"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Session class (association between Tutor and Student) -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_6" name="Session">
            <ecore:eOperations>
                <ecore:EOperation xmi:id="_14"
                                  name="cancel"
                                  eType="ecore:Boolean">
                    <ecore:eParameters>
                        <ecore:EParameter xmi:id="_16"
                                          name="canceller"
                                          eType="ecore:Reference" targetType="_8"/>
                        <ecore:EParameter xmi:id="_18"
                                          name="reason"
                                          eType="ecore:String"/>
                    </ecore:eParameters>
                </ecore:EOperation>
            </ecore:eOperations>
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="dateTime" eType="ecore:LocalDateTime"/>
                <ecore:EAttribute name="price" eType="ecore:Double"/>
                <ecore:EAttribute name="paid" eType="ecore:Boolean"/>
                <ecore:EReference name="tutor" eType="_2"/>
                <ecore:EReference name="student" eType="_3"/>
                <ecore:EReference name="followUpSession" eType="_6"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Award class -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_7" name="Award">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="subject" eType="ecore:String"/>
                <ecore:EReference name="tutor" eType="_2"/>
                <ecore:EAttribute name="month" eType="ecore:Int"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Subject class -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_11" name="Subject">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="name" eType="ecore:String"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- AvailabilitySlot class (association end for Offer) -->
        <ecore:eClassifiers xsi:type="ecore:EClass" xmi:id="_12" name="AvailabilitySlot">
            <ecore:eStructuralFeatures>
                <ecore:EAttribute name="dayOfWeek"
                                  eType="ecore:DayOfWeek"/>
                <ecore:EAttribute name="startTime"
                                  eType="ecore:LocalDateTime"/>
                <ecore:EAttribute name="endTime" eType="ecore:LocalTime"/>
                <ecore:EReference name="offer"
                                  eType="_4" containment="true"/>
            </ecore:eStructuralFeatures>
        </ecore:eClassifiers>

        <!-- Ecore datatypes -->
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_9"
                           instanceClassName="java.lang.String"
                           name="String">
            <ecore:eOperation xmi:id="_23" name="toString"
                              eType="ecore:String"/>
        </ecore:eDatatypes>
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_10"
                           instanceClassName="java.lang.Double"
                           name="Double">
            <ecore:eOperation xmi:id="_24" name="doubleValue"
                              eType="ecore:Double"/>
        </ecore:eDatatypes>
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_13"
                           instanceClassName="java.time.LocalDateTime"
                           name="LocalDateTime">
            <ecore:eOperation xmi:id="_25" name="toLocalDate"
                              eType="ecore:LocalDate"/>
        </ecore:eDatatypes>
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_15"
                           instanceClassName="java.lang.Boolean"
                           name="Boolean">
            <ecore:eOperation xmi:id="_26" name="booleanValue"
                              eType="ecore:Boolean"/>
        </ecore:eDatatypes>
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_19"
                           instanceClassName="java.lang.Integer"
                           name="Int">
            <ecore:eOperation xmi:id="_27" name="intValue"
                              eType="ecore:Int"/>
        </ecore:eDatatypes>
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_20"
                           instanceClassName="java.time.DayOfWeek"
                           name="DayOfWeek">
            <ecore:eOperation xmi:id="_28" name="ordinal"
                              eType="ecore:Int"/>
        </ecore:eDatatypes>
        <ecore:eDatatypes xsi:type="ecore:EDataType" xmi:id="_21"
                           instanceClassName="java.time.LocalTime"
                           name="LocalTime">
            <ecore:eOperation xmi:id="_29" name="toNanoOfDay"
                              eType="ecore:Int"/>
        </ecore:eDatatypes>
    </ecore:EPackage>
</xmi:XMI>
