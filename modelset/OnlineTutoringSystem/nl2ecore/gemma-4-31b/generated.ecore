<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/Ecore/">
  <ePackage name="OnlineTutoringSystem" nsURI="http://www.example.org/ots" xmi:id="package-0">
    
    <eClass name="OTSRoot" xmi:id="class-root">
      <eStructuralFeatures>
        <eStructuralFeature name="students" category="containment" xmi:id="feat-root-students">
          <eType xmi:idref="class-student"/>
        </eStructuralFeature>
        <eStructuralFeature name="tutors" category="containment" xmi:id="feat-root-tutors">
          <eType xmi:idref="class-tutor"/>
        </eStructuralFeature>
        <eStructuralFeature name="subjects" category="containment" xmi:id="feat-root-subjects">
          <eType xmi:idref="class-subject"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Person" abstract="true" xmi:id="class-person">
      <eStructuralFeatures>
        <eStructuralFeature name="name" xmi:id="feat-person-name">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="emailAddress" xmi:id="feat-person-email">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Student" xmi:id="class-student">
      <eSuperClass xmi:idref="class-person"/>
      <eStructuralFeatures>
        <eStructuralFeature name="requests" category="containment" xmi:id="feat-student-requests">
          <eType xmi:idref="class-request"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Tutor" xmi:id="class-tutor">
      <eSuperClass xmi:idref="class-person"/>
      <eStructuralFeatures>
        <eStructuralFeature name="bankAccount" xmi:id="feat-tutor-bank">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <!-- Tutors contain their offers -->
        <eStructuralFeature name="offers" category="containment" xmi:id="feat-tutor-offers">
          <eType xmi:idref="class-offer"/>
        </eStructuralFeature>
        <eStructuralFeature name="availability" category="containment" xmi:id="feat-tutor-avail">
          <eType xmi:idref="class-slot"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Subject" xmi:id="class-subject">
      <eStructuralFeatures>
        <eStructuralFeature name="subjectName" xmi:id="feat-sub-name">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <!-- Non-containment reference to the association class -->
        <eStructuralFeature name="offers" xmi:id="feat-sub-offers">
          <eType xmi:idref="class-offer"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <!-- Association Class between Tutor and Subject -->
    <eClass name="TutoringOffer" xmi:id="class-offer">
      <eStructuralFeatures>
        <eStructuralFeature name="expertiseLevel" xmi:id="feat-offer-level">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="hourlyPrice" xmi:id="feat-offer-price">
          <eType xmi:idref="type-double"/>
        </eStructuralFeature>
        <eStructuralFeature name="tutor" xmi:id="feat-offer-tutor">
          <eType xmi:idref="class-tutor"/>
        </eStructuralFeature>
        <eStructuralFeature name="subject" xmi:id="feat-offer-subject">
          <eType xmi:idref="class-subject"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="AvailabilitySlot" xmi:id="class-slot">
      <eStructuralFeatures>
        <eStructuralFeature name="dayOfWeek" xmi:id="feat-slot-day">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="startTime" xmi:id="feat-slot-start">
          <eType xmi:idref="type-localtime"/>
        </eStructuralFeature>
        <eStructuralFeature name="endTime" xmi:id="feat-slot-end">
          <eType xmi:idref="type-localtime"/>
        </eStructuralFeature>
        <eStructuralFeature name="tutor" xmi:id="feat-slot-tutor">
          <eType xmi:idref="class-tutor"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="TutoringRequest" xmi:id="class-request">
      <eStructuralFeatures>
        <eStructuralFeature name="requestedLevel" xmi:id="feat-req-level">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="suggestedStartTime" xmi:id="feat-req-time">
          <eType xmi:idref="type-edate"/>
        </eStructuralFeature>
        <eStructuralFeature name="status" xmi:id="feat-req-status">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="student" xmi:id="feat-req-student">
          <eType xmi:idref="class-student"/>
        </eStructuralFeature>
        <eStructuralFeature name="tutor" xmi:id="feat-req-tutor">
          <eType xmi:idref="class-tutor"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="TutoringSession" xmi:id="class-session">
      <eStructuralFeatures>
        <eStructuralFeature name="scheduledTime" xmi:id="feat-sess-time">
          <eType xmi:idref="type-edate"/>
        </eStructuralFeature>
        <eStructuralFeature name="actualPrice" xmi:id="feat-sess-price">
          <eType xmi:idref="type-double"/>
        </eStructuralFeature>
        <eStructuralFeature name="status" xmi:id="feat-sess-status">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="student" xmi:id="feat-sess-student">
          <eType xmi:idref="class-student"/>
        </eStructuralFeature>
        <eStructuralFeature name="tutor" xmi:id="feat-sess-tutor">
          <eType xmi:idref="class-tutor"/>
        </eStructuralFeature>
        <eStructuralFeature name="payment" category="containment" xmi:id="feat-sess-pay">
          <eType xmi:idref="class-payment"/>
        </eStructuralFeature>
      </eStructuralFeatures>
      <eOperations>
        <eOperation name="cancelSession" xmi:id="op-cancel">
          <eParameters>
            <eParameter name="cancelledBy" xmi:id="param-cancel-by">
              <eType xmi:idref="class-person"/>
            </eParameter>
          </eParameters>
        </eOperation>
      </eOperations>
    </eClass>

    <eClass name="Payment" xmi:id="class-payment">
      <eStructuralFeatures>
        <eStructuralFeature name="amount" xmi:id="feat-pay-amount">
          <eType xmi:idref="type-double"/>
        </eStructuralFeature>
        <eStructuralFeature name="paymentMethod" xmi:id="feat-pay-method">
          <eType xmi:idref="type-string"/>
        </eStructuralFeature>
        <eStructuralFeature name="session" xmi:id="feat-pay-sess">
          <eType xmi:idref="class-session"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <eClass name="Award" xmi:id="class-award">
      <eStructuralFeatures>
        <eStructuralFeature name="month" xmi:id="feat-aw-month">
          <eType xmi:idref="type-int"/>
        </eStructuralFeature>
        <eStructuralFeature name="year" xmi:id="feat-aw-year">
          <eType xmi:idref="type-int"/>
        </eStructuralFeature>
        <eStructuralFeature name="tutor" xmi:id="feat-aw-tutor">
          <eType xmi:idref="class-tutor"/>
        </eStructuralFeature>
        <eStructuralFeature name="subject" xmi:id="feat-aw-sub">
          <eType xmi:idref="class-subject"/>
        </eStructuralFeature>
      </eStructuralFeatures>
    </eClass>

    <!-- Custom Data Types and Built-in mapping -->
    <eDataType name="LocalTime" xmi:id="type-localtime">
      <eStructuralFeatures>
        <eStructuralFeature name="javaType" value="java.time.LocalTime" xmi:id="feat-lt-jt"/>
      </eStructuralFeatures>
    </eDataType>

    <!-- Standard Ecore Types references -->
    <eClass name="String" xmi:id="type-string" abstract="true"/>
    <eClass name="Double" xmi:id="type-double" abstract="true"/>
    <eClass name="Integer" xmi:id="type-int" abstract="true"/>
    <eClass name="EDate" xmi:id="type-edate" abstract="true"/>

  </ePackage>
</xmi:XMI>
