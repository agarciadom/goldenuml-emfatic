<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OTS" nsURI="http://www.example.org/ots" nsPrefix="ots">
  <eClassifiers>
    <eClass name="OTSSystem">
      <eStructuralFeatures>
        <eReference name="tutors" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="students" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Tutor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="bankAccount" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="offers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="availability" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures />
    </eClass>
    <eClass name="TutoringOffer">
      <eStructuralFeatures>
        <eAttribute name="subject" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="expertiseLevel" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="hourlyPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="offeredBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Availability">
      <eStructuralFeatures>
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TutoringRequest">
      <eStructuralFeatures>
        <eAttribute name="targetDateTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="requestedLevel" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="requestedBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="requestedTutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="basedOffer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TutoringSession">
      <eStructuralFeatures>
        <eAttribute name="sessionDateTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="isCancelled" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eAttribute name="actualPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="originRequest" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
        <eReference name="sessionTutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="sessionStudent" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Payment">
      <eStructuralFeatures>
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eAttribute name="paymentMethod" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="paymentDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="forSession" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="paidBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
