@namespace(uri="http://www.example.org/ots", prefix="ots")
package OTS;

import "http://www.eclipse.org/emf/2002/Ecore";

class OTSSystem {
	val Tutor[*] tutors;
	val Student[*] students;
}

class Person {
	attr ecore.EString[1] name;
	attr ecore.EString[1] emailAddress;
}

class Tutor extends Person {
	attr ecore.EString[1] bankAccount;
	val TutoringOffer[*] offers;
	val Availability[*] availability;
}

class Student extends Person {
}

class TutoringOffer {
	attr ecore.EString[1] subject;
	attr ecore.EString[1] expertiseLevel;
	attr ecore.EBigDecimal[1] hourlyPrice;
	ref Tutor[1] offeredBy;
}

class Availability {
	attr ecore.EString[1] startTime;
	attr ecore.EString[1] endTime;
}

class TutoringRequest {
	attr ecore.EDate[1] targetDateTime;
	attr ecore.EString[1] requestedLevel;
	ref Student[1] requestedBy;
	ref Tutor[1] requestedTutor;
	ref TutoringOffer[1] basedOffer;
}

class TutoringSession {
	attr ecore.EDate[1] sessionDateTime;
	attr ecore.EBoolean[1] isCancelled;
	attr ecore.EBigDecimal[1] actualPrice;
	ref TutoringRequest[1] originRequest;
	ref Tutor[1] sessionTutor;
	ref Student[1] sessionStudent;
}

class Payment {
	attr ecore.EBigDecimal[1] amount;
	attr ecore.EString[1] paymentMethod;
	attr ecore.EDate[1] paymentDate;
	ref TutoringSession[1] forSession;
	ref Student[1] paidBy;
}


