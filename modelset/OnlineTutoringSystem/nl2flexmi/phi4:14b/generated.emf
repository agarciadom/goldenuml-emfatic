@namespace(uri="http://www.example.org/OTS", prefix="ots")
package OTS;

import "http://www.eclipse.org/emf/2002/Ecore";

class User {
	attr ecore.EString[1] name;
	attr ecore.EString[1] emailAddress;
}

class Tutor extends User {
	attr ecore.EString[1] bankAccount;
}

class Student extends User {
}

class Offer {
	attr ecore.EString[1] subject;
	attr ecore.EString[1] levelOfExpertise;
	attr ecore.EBigDecimal[1] hourlyPrice;
	ref Tutor[1] tutor;
}

class Session {
	attr ecore.EDate[1] targetDateTime;
	ref Offer[1] offer;
	ref Student[1] student;
	ref Tutor[1] tutor;
}

class Award {
	attr ecore.EString[1] subject;
	ref Tutor[1] tutor;
}


