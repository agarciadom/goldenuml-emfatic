<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OTS" nsURI="http://www.example.org/OTS" nsPrefix="ots">
  <eClassifiers>
    <eClass name="User">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="emailAddress" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Tutor" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="bankAccount" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Offer">
      <eStructuralFeatures>
        <eAttribute name="subject" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="levelOfExpertise" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="hourlyPrice" lowerBound="1" upperBound="1" eType="//EBigDecimal" />
        <eReference name="tutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Session">
      <eStructuralFeatures>
        <eAttribute name="targetDateTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="offer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="student" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="tutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Award">
      <eStructuralFeatures>
        <eAttribute name="subject" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="tutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
