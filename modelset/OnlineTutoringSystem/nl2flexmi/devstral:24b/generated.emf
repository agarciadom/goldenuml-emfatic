@namespace(uri="http://www.example.org/OTS", prefix="ots")
package OTS;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] name;
	attr Email[1] email;
}

class Student extends Person {
}

class Tutor extends Person {
	attr ecore.EString[1] bankAccount;
	attr ecore.EString[*] weeklyAvailability;
}

class Subject {
	attr ecore.EString[1] name;
}

class TutoringSession {
	val Subject[1] subject;
	attr ecore.EString[1] level;
	attr ecore.EDouble[1] price;
	attr ecore.EDate[1] dateTime;
	val CancellationPolicy cancellationPolicy;
	attr ecore.EString[1] paymentMethod;
}

class TutoringRequest {
	ref Student[1] student;
	ref Tutor[1] tutor;
	val TutoringSession[1] session;
	attr ecore.EDate[1] targetDateTime;
}

datatype Email : java.lang.String;

class CancellationPolicy {
	attr ecore.EString[1] name;
}


