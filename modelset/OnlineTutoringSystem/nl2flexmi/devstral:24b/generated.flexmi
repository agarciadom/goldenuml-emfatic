<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OTS" nsURI="http://www.example.com/ots" nsPrefix="ots">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="tutoringRequests" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Tutor" eSuperTypes="//@eClassifiers.1">
      <eStructuralFeatures>
        <eAttribute name="bankAccount" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="subjectOffers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="availabilitySlots" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
        <eReference name="cancellationPolicy" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="awards" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SubjectOffer">
      <eStructuralFeatures>
        <eAttribute name="subjectName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="expertiseLevel" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="hourlyPrice" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="tutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="AvailabilitySlot">
      <eStructuralFeatures>
        <eAttribute name="dayOfWeek" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="startTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="endTime" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TutoringRequest">
      <eStructuralFeatures>
        <eAttribute name="requestedLevel" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="targetDate" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="targetTime" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="subjectOffer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="student" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TutoringSession">
      <eStructuralFeatures>
        <eAttribute name="sessionDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eAttribute name="sessionTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="tutoringRequest" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="tutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="student" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="paymentInfo" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PaymentInfo">
      <eStructuralFeatures>
        <eAttribute name="amount" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="paymentMethod" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CancellationPolicy">
      <eStructuralFeatures>
        <eAttribute name="cancellationFeePercentage" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="discountPercentage" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Award">
      <eStructuralFeatures>
        <eAttribute name="awardName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="month" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
