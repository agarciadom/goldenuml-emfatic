<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="OTS" nsURI="http://www.example.org/OTS" nsPrefix="ots">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="1" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Student" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Tutor" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="bankAccount" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="weeklyAvailability" lowerBound="0" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Subject">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TutoringSession">
      <eStructuralFeatures>
        <eReference name="subject" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eAttribute name="level" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="price" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eAttribute name="dateTime" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="cancellationPolicy" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
        <eAttribute name="paymentMethod" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="TutoringRequest">
      <eStructuralFeatures>
        <eReference name="student" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="tutor" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="session" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eAttribute name="targetDateTime" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Email" instanceClassName="java.lang.String" />
    <eClass name="CancellationPolicy">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
