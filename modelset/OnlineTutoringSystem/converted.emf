@namespace(uri="http://www.example.org/tutoring", prefix="tutoring")
package tutoring;

enum LevelOfTutoring {
	PrimarySchool = 0;
	HighSchool = 1;
	University = 2;
}

enum SessionStatus {
	Proposed = 0;
	Confirmed = 1;
	Completed = 2;
	Paid = 3;
	Cancelled = 4;
}

enum PaymentKind {
	CreditCard = 0;
	WireTransfer = 1;
}

abstract class TutoringRole {
}

abstract class TutoringElement {
	attr LevelOfTutoring tutoringLevel;
}

class User {
	attr String name;
	attr String email;
	val TutoringRole[0..2] roles;
}

class BestTutorAward {
	attr int year;
	attr int month;
}

class Tutor extends TutoringRole {
	attr String bankAccount;
	val TutoringOffer[*]#tutor tutoringOffers;
	val TutorAvailability[*] availabilities;
	val BestTutorAward[*] bestTutorAwards;
}

class Student extends TutoringRole {
	val TutoringRequest[*] tutoringRequests;
}

class TutorAvailability {
	attr String startTime;
	attr String endTime;
}

class Subject {
	attr String name;
	ref TutoringOffer[*]#subject tutoringOffers;
	ref TutoringRequest[*]#subject tutoringRequests;
}

class TutoringOffer extends TutoringElement {
	attr float hourlyPrice;
	ref Tutor[1]#tutoringOffers tutor;
	ref Subject[1]#tutoringOffers subject;
	ref TutoringRequest[*]#tutoringOffer tutoringRequests;
}

class TutoringRequest extends TutoringElement {
	ref Subject[1]#tutoringRequests subject;
	ref TutoringOffer#tutoringRequests tutoringOffer;
	val TutoringSession[*] allSessions;
	ref TutoringSession firstSession;
}

class TutoringSession {
	attr String sessionDate;
	attr float totalPrice;
	attr SessionStatus sessionStatus;
	val Payment payment;
	ref TutoringSession nextSession;
}

class Payment {
	attr PaymentKind paymentForm;
	attr String paymentDate;
}


