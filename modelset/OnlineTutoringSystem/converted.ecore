<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="tutoring" nsURI="http://www.example.org/tutoring" nsPrefix="tutoring">
  <eClassifiers xsi:type="ecore:EDataType" name="LocalTime" instanceClassName="java.time.LocalTime"/>
  <eClassifiers xsi:type="ecore:EEnum" name="LevelOfTutoring">
    <eLiterals name="PrimarySchool"/>
    <eLiterals name="HighSchool" value="1"/>
    <eLiterals name="University" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SessionStatus">
    <eLiterals name="Proposed"/>
    <eLiterals name="Confirmed" value="1"/>
    <eLiterals name="Completed" value="2"/>
    <eLiterals name="Paid" value="3"/>
    <eLiterals name="Cancelled" value="4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="PaymentKind">
    <eLiterals name="CreditCard"/>
    <eLiterals name="WireTransfer" value="1"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TutoringRole" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="TutoringElement" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tutoringLevel" eType="#//LevelOfTutoring"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="User">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="email" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roles" upperBound="2" eType="#//TutoringRole"
        containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BestTutorAward">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="year" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="month" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Tutor" eSuperTypes="#//TutoringRole">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bankAccount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tutoringOffers" upperBound="-1"
        eType="#//TutoringOffer" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="availabilities" upperBound="-1"
        eType="#//TutorAvailability" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="awards" upperBound="-1"
        eType="#//BestTutorAward" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Student" eSuperTypes="#//TutoringRole">
    <eStructuralFeatures xsi:type="ecore:EReference" name="tutoringRequests" upperBound="-1"
        eType="#//TutoringRequest" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Subject">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tutoringOffers" upperBound="-1"
        eType="#//TutoringOffer" eOpposite="#//TutoringOffer/subject"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tutoringRequests" upperBound="-1"
        eType="#//TutoringRequest" eOpposite="#//TutoringRequest/subject"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TutorAvailability">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="startTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endTime" eType="#//LocalTime"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TutoringOffer" eSuperTypes="#//TutoringElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hourlyPrice" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subject" eType="#//Subject"
        eOpposite="#//Subject/tutoringOffers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tutoringRequests" upperBound="-1"
        eType="#//TutoringRequest" eOpposite="#//TutoringRequest/tutoringOffer"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TutoringRequest" eSuperTypes="#//TutoringElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="subject" eType="#//Subject"
        eOpposite="#//Subject/tutoringRequests"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tutoringOffer" eType="#//TutoringOffer"
        eOpposite="#//TutoringOffer/tutoringRequests"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="allSessions" upperBound="-1"
        eType="#//TutoringSession" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="firstSession" eType="#//TutoringSession"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TutoringSession">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sessionDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="totalPrice" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sessionStatus" eType="#//SessionStatus"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="payment" eType="#//Payment"
        containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="nextSession" eType="#//TutoringSession"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Payment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentForm" eType="#//PaymentKind"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="paymentDate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TutoringSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="users" upperBound="-1"
        eType="#//User" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subjects" upperBound="-1"
        eType="#//Subject" containment="true"/>
  </eClassifiers>
</ecore:EPackage>
