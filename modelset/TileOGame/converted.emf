@namespace(uri="http://www.example.org/boardgame", prefix="boardgame")
package boardgame;

enum Mode {
	DESIGN = 0;
	GAME = 1;
}

enum Color {
	RED = 0;
	BLUE = 1;
	GREEN = 2;
	YELLOW = 3;
}

class TileO {
	val Game[*] games;
}

class Game {
	attr int currentConnectionPieces;
	attr Mode mode;
	readonly attr int SpareConnectionPieces = 32;
	readonly attr int NumberOfActionCards = 32;
	val Tile[*] tiles;
	val Connection[*] connections;
	val Die[1] die;
	val Deck[1] deck;
	ref Player currentPlayer;
	val Player[2..4] players;
	ref WinTile winTile;
}

class Connection {
	ref Tile[2] tiles;
}

class Die {
}

class Deck {
	val ActionCard[0..32] cards;
	ref ActionCard currentCard;
}

abstract class Tile {
	attr int x;
	attr int y;
	attr Boolean hasBeenVisited;
	ref Connection[0..4] connections;
}

class WinTile extends Tile {
}

class ActionTile extends Tile {
	attr int inactivityPeriod;
	attr int turnsUntilActive;
}

class NormalTile extends Tile {
}

abstract class ActionCard {
	attr String instructions;
}

class RollDieActionCard extends ActionCard {
}

class ConnectTilesActionCard extends ActionCard {
}

class RemoveConnectionActionCard extends ActionCard {
}

class TeleportActionCard extends ActionCard {
}

class LoseTurnActionCard extends ActionCard {
}

class Player {
	attr int number;
	attr int turnsUntilActive;
	attr Color color;
	ref Tile startingTile;
	ref Tile currentTile;
}


