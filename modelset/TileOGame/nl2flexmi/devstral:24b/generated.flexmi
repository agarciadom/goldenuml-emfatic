<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TileO" nsURI="http://tile-o/model" nsPrefix="tileo">
  <eClassifiers>
    <eClass name="Game">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="board" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="players" containment="True" lowerBound="2" upperBound="4" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Board">
      <eStructuralFeatures>
        <eAttribute name="width" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="height" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="tiles" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="connectionPieces" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Tile">
      <eStructuralFeatures>
        <eAttribute name="xPosition" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="yPosition" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="isHiddenTile" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isStartingPosition" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isActionTile" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eReference name="rightTile" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="leftTile" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="topTile" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="bottomTile" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ConnectionPiece">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="playingPiece" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PlayingPiece">
      <eStructuralFeatures>
        <eAttribute name="color" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="currentTile" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="previousTile" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActionCard">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActionCardDeck">
      <eStructuralFeatures>
        <eReference name="cards" containment="True" lowerBound="0" upperBound="32" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Die">
      <eStructuralFeatures>
        <eAttribute name="sides" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="currentValue" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
