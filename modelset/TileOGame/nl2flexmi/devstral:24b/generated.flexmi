<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TileO" nsURI="http://www.example.org/tileo" nsPrefix="tileo">
  <eClassifiers>
    <eClass name="Game">
      <eStructuralFeatures>
        <eReference name="board" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="players" containment="True" lowerBound="2" upperBound="4" eType="//@eClassifiers.4" />
        <eReference name="currentPlayer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="deck" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Board">
      <eStructuralFeatures>
        <eReference name="tiles" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
        <eReference name="hiddenTile" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="startPositions" containment="False" lowerBound="2" upperBound="4" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Tile">
      <eStructuralFeatures>
        <eReference name="rightConnection" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="leftConnection" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="topConnection" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="bottomConnection" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eAttribute name="isHidden" lowerBound="0" upperBound="1" eType="//EBoolean" />
        <eAttribute name="isActionTile" lowerBound="0" upperBound="1" eType="//EBoolean" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ConnectionPiece">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="playingPiece" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PlayingPiece">
      <eStructuralFeatures>
        <eAttribute name="color" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ActionCard">
      <eStructuralFeatures>
        <eAttribute name="type" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Deck">
      <eStructuralFeatures>
        <eReference name="cards" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Die">
      <eStructuralFeatures>
        <eAttribute name="faces" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
