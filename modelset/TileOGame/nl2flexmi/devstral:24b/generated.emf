@namespace(uri="http://tile-o/model", prefix="tileo")
package TileO;

import "http://www.eclipse.org/emf/2002/Ecore";

class Game {
	attr ecore.EString[1] name;
	val Board[1] board;
	val Player[2..4] players;
}

class Board {
	attr ecore.EInt[1] width;
	attr ecore.EInt[1] height;
	val Tile[+] tiles;
	val ConnectionPiece[*] connectionPieces;
}

class Tile {
	attr ecore.EInt[1] xPosition;
	attr ecore.EInt[1] yPosition;
	attr ecore.EBoolean isHiddenTile;
	attr ecore.EBoolean isStartingPosition;
	attr ecore.EBoolean isActionTile;
	ref Tile rightTile;
	ref Tile leftTile;
	ref Tile topTile;
	ref Tile bottomTile;
}

class ConnectionPiece {
}

class Player {
	attr ecore.EString[1] name;
	val PlayingPiece[1] playingPiece;
}

class PlayingPiece {
	attr ecore.EString[1] color;
	ref Tile currentTile;
	ref Tile previousTile;
}

class ActionCard {
	attr ecore.EString[1] description;
	attr ecore.EString[1] type;
}

class ActionCardDeck {
	val ActionCard[0..32] cards;
}

class Die {
	attr ecore.EInt[1] sides;
	attr ecore.EInt currentValue;
}


