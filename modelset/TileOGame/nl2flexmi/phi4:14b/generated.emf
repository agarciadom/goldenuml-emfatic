@namespace(uri="http://www.example.org/tile-o", prefix="to")
package TileO;

import "http://www.eclipse.org/emf/2002/Ecore";

class Game {
	val Board[1] board;
	ref Player[2..4] players;
}

class Board {
	val Tile[0..10000] tiles;
}

class Tile {
	ref ConnectionPiece rightConnectionPiece;
	ref ConnectionPiece leftConnectionPiece;
	ref ConnectionPiece topConnectionPiece;
	ref ConnectionPiece bottomConnectionPiece;
	ref Player[0..10000] visitedByPlayers;
}

class ConnectionPiece {
}

class ActionCard {
	attr ecore.EString[1] instruction;
}

class Designer {
	ref Game game;
}

class Player {
	attr ecore.EString[1] color;
}


