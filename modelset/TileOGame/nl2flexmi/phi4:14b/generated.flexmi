<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TileO" nsURI="http://www.example.org/tile-o" nsPrefix="to">
  <eClassifiers>
    <eClass name="Game">
      <eStructuralFeatures>
        <eReference name="board" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="players" containment="False" lowerBound="2" upperBound="4" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Board">
      <eStructuralFeatures>
        <eReference name="tiles" containment="True" lowerBound="0" upperBound="10000" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Tile">
      <eStructuralFeatures>
        <eReference name="rightConnectionPiece" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="leftConnectionPiece" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="topConnectionPiece" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="bottomConnectionPiece" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="visitedByPlayers" containment="False" lowerBound="0" upperBound="10000" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ConnectionPiece">
      <eStructuralFeatures />
    </eClass>
    <eClass name="ActionCard">
      <eStructuralFeatures>
        <eAttribute name="instruction" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Designer">
      <eStructuralFeatures>
        <eReference name="game" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="color" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
