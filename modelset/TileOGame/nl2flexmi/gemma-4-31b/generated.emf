@namespace(uri="http://www.example.org/tileo", prefix="tileo")
package TileO;

import "http://www.eclipse.org/emf/2002/Ecore";

class Game {
	val Board[1] board;
	val Player[2..4] players;
	val Deck[1] deck;
}

class Board {
	val Tile[*] tiles;
	val ConnectionPiece[*] connectionPieces;
}

class Tile {
	attr ecore.EBoolean isHidden;
	attr ecore.EBoolean isActionTile;
	attr ecore.EString color;
	attr ecore.EInt actionDuration;
	ref ConnectionPiece rightConnection;
	ref ConnectionPiece leftConnection;
	ref ConnectionPiece topConnection;
	ref ConnectionPiece bottomConnection;
}

class ConnectionPiece {
	ref Tile[1] tileA;
	ref Tile[1] tileB;
}

class Player {
	attr ecore.EString name;
	val PlayingPiece[1] playingPiece;
}

class PlayingPiece {
	attr ecore.EString color;
	ref Tile currentTile;
}

class Deck {
	val ActionCard[0..32] actionCards;
}

class ActionCard {
	attr ecore.EString actionType;
}


