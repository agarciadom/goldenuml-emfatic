<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="tileo" NSUri="http://www.example.org/tileo">
    
    <!-- Root container for the system -->
    <eClass name="TileOSystem">
      <eStructuralFeatures>
        <eReference name="game" eType="tileo.Game" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="Game">
      <eStructuralFeatures>
        <eReference name="board" eType="tileo.GameBoard" />
        <eReference name="deck" eType="tileo.Deck" />
        <eReference name="players" eType="tileo.Player" />
        <eReference name="currentPlayer" eType="tileo.Player" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="GameBoard">
      <eStructuralFeatures>
        <eReference name="tiles" eType="tileo.Tile" />
        <eReference name="hiddenTile" eType="tileo.Tile" />
        <eReference name="spareConnectionPieces" eType="tileo.ConnectionPiece" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="Tile">
      <eStructuralFeatures>
        <eAttribute name="color" eType="ecore.EString" />
        <eAttribute name="isActionTile" eType="ecore.EBoolean" />
        <eAttribute name="actionDurationTurns" eType="ecore.EInt" />
        <!-- Connections on each side -->
        <eReference name="topConnection" eType="tileo.ConnectionPiece" />
        <eReference name="bottomConnection" eType="tileo.ConnectionPiece" />
        <eReference name="leftConnection" eType="tileo.ConnectionPiece" />
        <eReference name="rightConnection" eType="tileo.ConnectionPiece" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="ConnectionPiece">
      <eStructuralFeatures>
        <eReference name="tileA" eType="tileo.Tile" />
        <eReference name="tileB" eType="tileo.Tile" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="pieceColor" eType="ecore.EString" />
        <eReference name="startingPosition" eType="tileo.Tile" />
        <eReference name="currentTile" eType="tileo.Tile" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="Deck">
      <eStructuralFeatures>
        <eReference name="actionCards" eType="tileo.ActionCard" />
      </eStructuralFeatures>
    </eClass>

    <eClass name="ActionCard">
      <eStructuralFeatures>
        <eReference name="type" eType="tileo.ActionType" />
      </eStructuralFeatures>
    </eClass>

    <eEnum name="ActionType">
      <eLiterals>
        <eLiteral name="EXTRA_TURN" />
        <eLiteral name="CONNECT_TWO_TILES" />
        <eLiteral name="REMOVE_CONNECTION" />
        <eLiteral name="MOVE_TO_ARBITRARY_TILE" />
        <eLiteral name="LOSE_NEXT_TURN" />
      </eLiterals>
    </eEnum>

  </ecore:EPackage>
</xmi:XMI>
