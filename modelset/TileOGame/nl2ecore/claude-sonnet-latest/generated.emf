@namespace(uri="http://www.example.org/tileO", prefix="tileO")
package tileO;

class TileOApp {
	val Game game;
	val Designer designer;
}

class Game {
	op void startGame();
	op void endGame(Player winner);
	op void nextTurn();
	val Board board;
	val Player[0..4] players;
	val Deck deck;
	val Die die;
	val SpareConnectionPile spareConnectionPile;
	attr boolean isActive;
	ref Player currentPlayer;
	ref Player winner;
}

class Designer {
	op void placeTile(Tile tile);
	op void connectTiles(ConnectionPiece connection);
	op void setHiddenTile(Tile tile);
	op void setStartingPosition(Player player, Tile tile);
	op void defineActionCard(ActionCard card);
	op void setActionTileDuration(ActionTile actionTile, int turns);
}

class Board {
	val Tile[*] tiles;
	val ConnectionPiece[*] connections;
	ref Tile hiddenTile;
}

abstract class Tile {
	op void markVisited();
	op boolean isHidden();
	attr TileColor color;
	ref ConnectionPiece rightConnection;
	ref ConnectionPiece leftConnection;
	ref ConnectionPiece topConnection;
	ref ConnectionPiece bottomConnection;
}

class RegularTile extends Tile {
}

class HiddenTile extends Tile {
}

class ActionTile extends Tile {
	op void deactivate();
	op void decrementDeactivation();
	attr int deactivationDuration;
	attr int remainingDeactivationTurns;
	attr boolean isActive;
}

enum TileColor {
	WHITE = 0;
	BLACK = 1;
}

class ConnectionPiece {
	ref Tile tileA;
	ref Tile tileB;
	attr TileSide side;
}

enum TileSide {
	RIGHT = 0;
	LEFT = 1;
	TOP = 2;
	BOTTOM = 3;
}

class SpareConnectionPile {
	op void addConnection(ConnectionPiece connection);
	op ConnectionPiece removeConnection();
	val ConnectionPiece[*] spareConnections;
	attr int capacity = 32;
}

class Player {
	op int rollDie();
	op void movePiece(int steps);
	op ActionCard drawActionCard();
	op void executeActionCard(ActionCard card);
	attr int playerNumber;
	attr boolean skipNextTurn;
	val PlayingPiece playingPiece;
	ref Tile currentTile;
	ref Tile startingTile;
}

class PlayingPiece {
	attr PieceColor color;
}

enum PieceColor {
	RED = 0;
	BLUE = 1;
	GREEN = 2;
	YELLOW = 3;
}

class Die {
	op int roll();
	attr int lastRoll;
}

class Deck {
	op ActionCard drawCard();
	op void addCard(ActionCard card);
	val ActionCard[0..32] actionCards;
	attr int maxSize = 32;
}

abstract class ActionCard {
	op void execute(Player player, Game game);
	attr String description;
}

class ExtraTurnCard extends ActionCard {
}

class AddConnectionCard extends ActionCard {
}

class RemoveConnectionCard extends ActionCard {
}

class MoveToArbitraryTileCard extends ActionCard {
}

class LoseNextTurnCard extends ActionCard {
}


