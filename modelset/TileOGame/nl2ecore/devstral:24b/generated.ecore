<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
  <ecore:EPackage name="tileo" nsURI="tileo" nsPrefix="tileo" xmi:version="2.0">

    <!-- Root Container Class -->
    <ecore:EClass name="TileOGameSystem">
      <ecore:EReference name="gameDesigns" eType="#//GameDesign" upperBound="-1"/>
      <ecore:EReference name="activeGames" eType="#//ActiveGame" upperBound="-1"/>
    </ecore:EClass>

    <!-- Game Design Classes -->
    <ecore:EClass name="GameDesign">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="boardLayout" eType="#//Tile" upperBound="-1" containment="true"/>
      <ecore:EReference name="hiddenTile" eType="#//HiddenTile"/>
      <ecore:EReference name="startingPositions" eType="#//StartingPosition" upperBound="-1" containment="true"/>
      <ecore:EReference name="actionTiles" eType="#//ActionTile" upperBound="-1" containment="true"/>
      <ecore:EReference name="actionCardDeck" eType="#//ActionCard" upperBound="-1" containment="true"/>
    </ecore:EClass>

    <!-- Active Game Classes -->
    <ecore:EClass name="ActiveGame">
      <ecore:EAttribute name="isPaused" eType="ecore:EBoolean" defaultValueLiteral="false"/>
      <ecore:EReference name="currentPlayerTurn" eType="#//Player"/>
      <ecore:EReference name="players" eType="#//Player" upperBound="-1"/>
    </ecore:EClass>

    <!-- Tile Classes -->
    <ecore:EClass name="Tile">
      <ecore:EAttribute name="id" eType="ecore:EString"/>
      <ecore:EReference name="rightConnection" eType="#//ConnectionPiece" upperBound="-1"/>
      <ecore:EReference name="leftConnection" eType="#//ConnectionPiece" upperBound="-1"/>
      <ecore:EReference name="topConnection" eType="#//ConnectionPiece" upperBound="-1"/>
      <ecore:EReference name="bottomConnection" eType="#//ConnectionPiece" upperBound="-1"/>
    </ecore:EClass>

    <!-- Special Tiles -->
    <ecore:EClass name="HiddenTile">
      <ecore:EAttribute name="location" eType="ecore:EString"/>
    </ecore:EClass>

    <ecore:EClass name="ActionTile">
      <ecore:EReference name="actionCardEffect" eType="#//ActionCard"/>
      <ecore:EReference name="turnsToRegular" eType="#//TimeWithoutDate"/>
    </ecore:EClass>

    <!-- Connection Classes -->
    <ecore:EClass name="ConnectionPiece">
      <ecore:EAttribute name="id" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Player and Movement Classes -->
    <ecore:EClass name="Player">
      <ecore:EAttribute name="playerId" eType="ecore:EInt"/>
      <ecore:EAttribute name="color" eType="#//Color"/>
      <ecore:EReference name="currentPosition" eType="#//Tile"/>
    </ecore:EClass>

    <!-- Custom Data Types -->
    <ecore:EDataType name="TimeWithoutDate" instanceClassName="java.time.Duration"/>

    <!-- Enumeration for Player Colors -->
    <ecore:EEnum name="Color">
      <ecore:ELiteral name="RED"/>
      <ecore:ELiteral name="GREEN"/>
      <ecore:ELiteral name="BLUE"/>
      <ecore:ELiteral name="YELLOW"/>
    </ecore:EEnum>

    <!-- Action Cards -->
    <ecore:EClass name="ActionCard">
      <ecore:EAttribute name="actionType" eType="#//ActionType"/>
    </ecore:EClass>

    <!-- Enumeration for Action Types -->
    <ecore:EEnum name="ActionType">
      <ecore:ELiteral name="EXTRA_TURN"/>
      <ecore:ELiteral name="CONNECT_TILES"/>
      <ecore:ELiteral name="REMOVE_CONNECTION"/>
      <ecore:ELiteral name="MOVE_TO_ANY_TILE"/>
      <ecore:ELiteral name="LOSE_NEXT_TURN"/>
    </ecore:EEnum>

    <!-- Starting Positions -->
    <ecore:EClass name="StartingPosition">
      <ecore:EReference name="tile" eType="#//Tile"/>
    </ecore:EClass>

  </ecore:EPackage>
</xmi:XMI>
