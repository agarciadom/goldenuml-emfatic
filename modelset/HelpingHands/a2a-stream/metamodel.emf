@namespace(uri="http://www.hhs.org/HHS/Core", prefix="p")
package Core;

class Location {
  attr String name;
  val ClientNeed[*] clientNeeds;
}
class ClientNeed {
  attr String clientName;
  attr String[*] neededCategories;
}

@namespace(uri="http://www.hhs.org/HHS/ResidentService", prefix="p")
package ResidentService;

class Resident {
  attr int ~id;
  attr String name;
  attr String streetAddress;
  attr String phoneNumber;
  attr String emailAddress;
}
class PickupRequest {
  attr String itemsDescription;
  attr Date pickupDate;
  attr String pickupTimeWindow;
  ref Resident resident;
  ref ClientNeed[*] clientNeeds;
}

@namespace(uri="http://www.hhs.org/HHS/PickupDelivery", prefix="p")
package PickupDelivery;

class Vehicle {
  attr int ~id;
  attr String licensePlate;
  attr Float storageSpace;
}
class Route {
  val PickupSchedule[*] scheduledPickups;
  ref Vehicle vehicle;
}
class PickupSchedule {
  attr Time pickupTime;
  ref Resident resident;
  ref PickupRequest pickupRequest;
}
class VolunteerDriver {
  attr int ~id;
  attr String name;
  attr String[*] availableDays;
  ref Vehicle vehicle;
}

@namespace(uri="http://www.hhs.org/HHS/DistributionCenter", prefix="p")
package DistributionCenter;

class Article {
  attr int ~id;
  attr String description;
  attr String category;
  attr String rfidTag;
}
class FoodItem {
  attr int ~id;
  attr String description;
}