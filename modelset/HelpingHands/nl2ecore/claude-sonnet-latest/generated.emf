@namespace(uri="http://www.example.org/h2s", prefix="h2s")
package h2s;

datatype LocalTime : java.time.LocalTime;

class H2SSystem {
	val Location[*] locations;
	val Resident[*] residents;
	val ArticleCategory[*] categories;
	val VolunteerDriver[*] volunteerDrivers;
	val Vehicle[*] vehicles;
}

class Location {
	attr String city;
	val DistributionCenter distributionCenter;
	val PickupRequest[*] pickupRequests;
	val PickupRoute[*] pickupRoutes;
	val FoodBank foodBank;
}

class Resident {
	attr String name;
	attr String streetAddress;
	attr String phoneNumber;
	attr String emailAddress;
	ref PickupRequest[*]#resident pickupRequests;
}

class PickupRequest {
	ref Resident#pickupRequests resident;
	attr String streetAddress;
	attr EDate requestedDate;
	val Item[*]#pickupRequest items;
}

abstract class Item {
	attr String description;
	attr double weight;
	attr double width;
	attr double height;
	attr double depth;
	ref PickupRequest#items pickupRequest;
}

class SecondHandArticle extends Item {
	attr String rfidTag;
	attr boolean usable;
	ref ArticleCategory category;
	attr String correctedDescription;
}

class NonPerishableFood extends Item {
}

class ArticleCategory {
	attr String name;
	attr int categoryId;
}

class Vehicle {
	attr String vehicleId;
	attr double storageCapacityVolume;
	attr double storageCapacityWeight;
}

class VolunteerDriver {
	op void indicateAvailability(String day);
	attr String name;
	attr String phoneNumber;
	attr String[*] availableDays;
}

class PickupRoute {
	op void determineRoute();
	op void dropOffAtDistributionCenter();
	op void dropOffAtFoodBank();
	attr EDate date;
	ref VolunteerDriver driver;
	ref Vehicle vehicle;
	val PickupStop[*] stops;
	val ArticleDelivery[*] deliveries;
}

class PickupStop {
	attr LocalTime scheduledTime;
	attr LocalTime actualTime;
	attr int stopOrder;
	ref PickupRequest pickupRequest;
}

class DistributionCenter {
	attr String streetAddress;
	val H2SEmployee[*] employees;
	val SecondHandArticle[*] articles;
	val Client[*] clients;
	attr boolean offersDeliveryService;
}

class H2SEmployee {
	op void examineArticle(SecondHandArticle article);
	op void tagArticle(SecondHandArticle article);
	op void correctDescription(SecondHandArticle article, String correctedDescription);
	op void assignCategory(SecondHandArticle article, ArticleCategory category);
	op void callClient(Client client);
	op void arrangeDelivery(SecondHandArticle article, Client client);
	attr String name;
	attr String phoneNumber;
}

class Client {
	attr String name;
	attr String homeAddress;
	attr String phoneNumber;
	attr boolean requiresDelivery;
	ref ArticleCategory[*] neededCategories;
}

class ArticleDelivery {
	ref SecondHandArticle article;
	ref Client client;
	attr EDate deliveryDate;
}

class FoodBank {
	attr String name;
	attr String streetAddress;
}


