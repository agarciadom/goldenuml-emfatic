<xmi:XMI xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:xmi="http://schema.omg.org/spec/XMI/20131001"
         xmlns:Ecore="http://www.eclipse.org/emf/2002/Ecore"
         xmi:version="2.0">
  <Ecore:EPackage xmi:id="_H2SOverview" name="helpinghandsstore"
                  nsURI="http://www.example.com/helpinghandsstore"
                  nsPrefix="hhs">
    <!-- Root container class -->
    <Ecore:EClass xmi:id="_RootContainer" name="H2SOverview">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="cities"
                      type="City" lowerBound="0" upperBound="-1"
                      containment="true"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="locations"
                      type="H2SLocation" lowerBound="0" upperBound="-1"
                      containment="true"/>
    </Ecore:EClass>

    <!-- Core domain classes -->
    <Ecore:EClass xmi:id="City" name="City">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="h2sLocations"
                      type="H2SLocation" lowerBound="0" upperBound="-1"/>
      <Ecore:EOperation xmi:id="_notifyClientsAboutArticles_City"
                        name="notifyClientsAboutArticles">
        <Ecore:EParameter xmi:id="_neededCategories_Set_Category"
                          name="neededCategories" type="Category"
                          lowerBound="0" upperBound="-1"/>
      </Ecore:EOperation>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="H2SLocation" name="H2SLocation">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="city"
                      type="City"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="distributionCenter"
                      type="DistributionCenter" containment="true"/>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="Resident" name="Resident">
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="name"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="streetAddress"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="phoneNumber"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="email"
                      type="String" upperBound="-1"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="pickupRequests"
                      type="PickupRequest" lowerBound="0" upperBound="-1"/>
    </Ecore:EClass>

    <!-- Volunteer drivers and routing -->
    <Ecore:EClass xmi:id="VolunteerDriver" name="VolunteerDriver">
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="name"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="availableDays"
                      type="DayOfWeek" lowerBound="0" upperBound="-1"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="routes"
                      type="Route" lowerBound="0" upperBound="-1"/>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="PickupRequest" name="PickupRequest">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="resident"
                      type="Resident"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="itemDescription"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="scheduledTime"
                      type="LocalDateTime"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="routeAssignment"
                      type="RouteAssignment" upperBound="-1"/>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="PickupVehicle" name="PickupVehicle">
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="vehicleId"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="storageCapacityCubicMeters"
                      type="Double"/>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="Route" name="Route">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="vehicle"
                      type="PickupVehicle"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="driver"
                      type="VolunteerDriver"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="routeAssignments"
                      type="RouteAssignment" containment="true"
                      lowerBound="0" upperBound="-1"/>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="RouteAssignment" name="RouteAssignment">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="route"
                      type="Route"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="pickupRequest"
                      type="PickupRequest"/>
    </Ecore:EClass>

    <!-- Item model -->
    <Ecore:EClass xmi:id="Item" name="Item">
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="description"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="pickupRequest"
                      type="PickupRequest"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="dimensions"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="weight"
                      type="Double"/>
    </Ecore:EClass>

    <!-- Distribution center processing -->
    <Ecore:EClass xmi:id="DistributionCenter" name="DistributionCenter">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="location"
                      type="H2SLocation" containment="true"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="secondHandArticles"
                      type="SecondHandArticle" lowerBound="0" upperBound="-1"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="employees"
                      type="Employee" lowerBound="0" upperBound="-1"/>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="SecondHandArticle" name="SecondHandArticle">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="item"
                      type="Item"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="rfidTagId"
                      type="String"/>
      <Ecore:EFeature xmi:type="Ecore:EReference" name="category"
                      type="Category"/>
      <Ecore:EOperation xmi:id="_tagWithRFID_SecondHandArticle"
                        name="tagWithRFID">
        <Ecore:EParameter xmi:id="_rfidTagId_String" name="rfidTagId"
                          type="String"/>
      </Ecore:EOperation>
    </Ecore:EClass>

    <Ecore:EClass xmi:id="Category" name="Category">
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="name"
                      type="String"/>
    </Ecore:EClass>

    <!-- Employees -->
    <Ecore:EClass xmi:id="Employee" name="Employee">
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="name"
                      type="String"/>
      <Ecore:EOperation xmi:id="_examineQuality_Employee"
                        name="examineQuality">
        <Ecore:EParameter xmi:id="_article_SecondHandArticle"
                          name="article" type="SecondHandArticle"/>
        <Ecore:EParameter xmi:id="_descriptionCorrections_String"
                          name="descriptionCorrections" type="String"
                          upperBound="-1"/>
      </Ecore:EOperation>
    </Ecore:EClass>

    <!-- Client delivery extension (optional per city) -->
    <Ecore:EClass xmi:id="Client" name="Client">
      <Ecore:EFeature xmi:type="Ecore:EReference" name="neededCategories"
                      type="Category" lowerBound="0" upperBound="-1"/>
      <Ecore:EFeature xmi:type="Ecore:EAttribute" name="homeAddress"
                      type="String"/>
    </Ecore:EClass>

    <Ecore:EOperation xmi:id="_notifyClient_Employee"
                      name="notifyClient">
      <Ecore:EParameter xmi:id="_client_Client" name="client"
                        type="Client"/>
      <Ecore:EParameter xmi:id="_availableArticles_Set_SecondHandArticle"
                        name="availableArticles" type="SecondHandArticle"
                        lowerBound="0" upperBound="-1"/>
    </Ecore:EOperation>

    <Ecore:EOperation xmi:id="_arrangeDelivery_Employee"
                      name="arrangeDelivery">
      <Ecore:EParameter xmi:id="_client_ClientPara" name="client"
                        type="Client"/>
      <Ecore:EParameter xmi:id="_article_SecondHandArticlePara"
                        name="article" type="SecondHandArticle"/>
      <Ecore:EParameter xmi:id="_deliveryDriver_VolunteerDriver"
                        name="deliveryDriver" type="VolunteerDriver"/>
    </Ecore:EOperation>
  </Ecore:EPackage>
</xmi:XMI>
