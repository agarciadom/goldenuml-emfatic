@namespace(uri="http://www.example.org/donation", prefix="donation")
package donation;

enum ItemCategory {
	BabyClothing = 0;
	Fridge = 1;
}

class Date {
}

abstract class Item {
	attr String description;
	attr String dimension;
	attr int weight;
	val Date requestedPickedDate;
}

class FoodItem extends Item {
}

class SecondHandArticle extends Item {
	attr String codeRFID;
	attr boolean discarded;
	attr ItemCategory category;
}

abstract class UserRole {
}

class Client extends UserRole {
	attr ItemCategory[*] neededCategories;
	ref SecondHandArticle[*] secondHandArticles;
}

class Volunteer extends UserRole {
	val Date[*] availableDates;
	val Route[*] routes;
}

class Resident extends UserRole {
	val Item[*] items;
}

class Person {
	attr String name;
	attr String address;
	attr String phoneNumber;
	attr String emailAddress;
	val UserRole[*] userRoles;
}

class Vehicle {
	attr String dimension;
	attr int weightRestriction;
}

class Route {
	val Date date;
	ref Vehicle[1] vehicle;
	ref Item[*] pickupRoute;
	ref SecondHandArticle[*] dropOffRoute;
}


