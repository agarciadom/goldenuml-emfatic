@namespace(uri="http://www.example.org/donationSystem", prefix="donationSystem")
package donationSystem;

class DonationSystem {
	val Person[*] persons;
	val Vehicle[*] vehicles;
	val Route[*] routes;
	val Item[*] items;
}

enum ItemCategory {
	BabyClothing = 0;
	Fridge = 1;
}

class Person {
	attr String name;
	attr String address;
	attr String phoneNumber;
	attr String emailAddress;
	val UserRole[*]#person userRoles;
}

abstract class UserRole {
	ref Person#userRoles person;
}

class Client extends UserRole {
	attr ItemCategory[*] neededCategories;
	ref SecondHandArticle[*] secondHandArticles;
}

class Volunteer extends UserRole {
	attr Date[*] availableDates;
	ref Route[*]#volunteer routes;
}

class Resident extends UserRole {
	ref Item[*] items;
}

abstract class Item {
	attr String description;
	attr String dimension;
	attr int weight;
	attr Date requestedPickedDate;
	ref Route#pickedUp pickupRoute;
}

class FoodItem extends Item {
}

class SecondHandArticle extends Item {
	attr String codeRFID;
	attr boolean discarded;
	attr ItemCategory category;
	ref Route#droppedOff dropOffRoute;
}

class Vehicle {
	attr String dimension;
	attr int weightRestriction;
	ref Route[*]#vehicle routes;
}

class Route {
	attr Date date;
	ref Vehicle#routes vehicle;
	ref Item[*]#pickupRoute pickedUp;
	ref SecondHandArticle[*]#dropOffRoute droppedOff;
	ref Volunteer#routes volunteer;
}


