@namespace(uri="http://www.example.org/secondhand", prefix="secondhand")
package secondhand;

enum ItemCategory {
	BabyClothing = 0;
	Fridge = 1;
}

class Person {
	attr String name;
	attr String address;
	attr String phoneNumber;
	attr String emailAddress;
	val UserRole[*]#person userRoles;
}

abstract class UserRole {
	ref Person[1]#userRoles person;
}

class Client extends UserRole {
	attr ItemCategory[*] neededCategories;
	ref SecondHandArticle[*]#client secondHandArticles;
}

class Volunteer extends UserRole {
	val Date[*] availableDates;
	ref Route[*]#volunteer routes;
}

class Resident extends UserRole {
	ref Item[*]#resident items;
}

class Date {
}

abstract class Item {
	attr String description;
	attr String dimension;
	attr int weight;
	ref Date requestedPickedDate;
	ref Resident[1]#items resident;
	ref Route#pickupItems pickupRoute;
}

class FoodItem extends Item {
}

class SecondHandArticle extends Item {
	attr String codeRFID;
	attr boolean discarded;
	attr ItemCategory category;
	ref Client#secondHandArticles client;
	ref Route[*]#dropOffArticles dropOffRoutes;
}

class Vehicle {
	attr String dimension;
	attr int weightRestriction;
	ref Route[*]#vehicle routes;
}

class Route {
	ref Date date;
	ref Vehicle[1]#routes vehicle;
	ref Volunteer[1]#routes volunteer;
	ref Item[*]#pickupRoute pickupItems;
	ref SecondHandArticle[*]#dropOffRoutes dropOffArticles;
}


