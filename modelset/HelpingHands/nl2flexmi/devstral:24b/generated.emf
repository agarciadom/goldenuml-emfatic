@namespace(uri="http://www.example.org/helpinghandstore", prefix="hhs")
package HelpingHandsStore;

import "http://www.eclipse.org/emf/2002/Ecore";

class Resident {
	attr ecore.EString[1] name;
	attr ecore.EString[1] streetAddress;
	attr ecore.EString[1] phoneNumber;
	attr ecore.EString email;
	attr ecore.EString[1] itemsDescription;
	ref Pickup pickup;
}

class Pickup {
	attr ecore.EString[1] pickupTime;
}

class Vehicle {
	attr ecore.EDouble[1] storageSpace;
	ref Route[*] routes;
}

class Driver {
	attr ecore.EString[+] availableDays;
}

class Route {
	val Pickup[+] pickups;
	ref Driver driver;
}

class Article {
	attr ecore.EString[1] quality;
	attr ecore.EString[1] category;
	attr ecore.EString rfidTag;
}

class FoodBank {
}

class DistributionCenter {
	val Article[*] articles;
}


