<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HelpingHandsStore" nsURI="http://www.example.org/helpinghandstore" nsPrefix="hhs">
  <eClassifiers>
    <eClass name="Resident">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="streetAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="itemsDescription" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="pickup" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Pickup">
      <eStructuralFeatures>
        <eAttribute name="pickupTime" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="storageSpace" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="routes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="availableDays" lowerBound="1" upperBound="-1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Route">
      <eStructuralFeatures>
        <eReference name="pickups" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Article">
      <eStructuralFeatures>
        <eAttribute name="quality" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="category" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="rfidTag" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FoodBank">
      <eStructuralFeatures />
    </eClass>
    <eClass name="DistributionCenter">
      <eStructuralFeatures>
        <eReference name="articles" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
