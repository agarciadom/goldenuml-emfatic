<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="H2S" nsURI="http://h2s.org" nsPrefix="h2s">
  <eClassifiers>
    <eClass name="Person">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="streetAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Resident" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Client" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eReference name="neededCategories" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="VolunteerDriver" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures>
        <eAttribute name="availableDays" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="H2SEmployee" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Item">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="dimensions" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="weight" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SecondHandArticle" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures>
        <eAttribute name="rfidTag" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="category" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="processedBy" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="NonPerishableFood" eSuperTypes="//@eClassifiers.5">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Category">
      <eStructuralFeatures>
        <eAttribute name="categoryName" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="storageSpace" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PickupRoute">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="assignedVehicle" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="assignedDriver" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScheduledPickup">
      <eStructuralFeatures>
        <eAttribute name="scheduledTime" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="basedOnRequest" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.12" />
        <eReference name="pickedUpItems" containment="True" lowerBound="1" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="partOfRoute" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.10" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PickupRequest">
      <eStructuralFeatures>
        <eAttribute name="descriptionOfItems" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="requestingResident" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
