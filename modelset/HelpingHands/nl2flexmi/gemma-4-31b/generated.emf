@namespace(uri="http://h2s.org", prefix="h2s")
package H2S;

import "http://www.eclipse.org/emf/2002/Ecore";

class Person {
	attr ecore.EString[1] name;
	attr ecore.EString[1] streetAddress;
	attr ecore.EString[1] phoneNumber;
}

class Resident extends Person {
	attr ecore.EString email;
}

class Client extends Person {
	ref Category[*] neededCategories;
}

class VolunteerDriver extends Person {
	attr ecore.EString availableDays;
}

class H2SEmployee extends Person {
}

class Item {
	attr ecore.EString[1] description;
	attr ecore.EString dimensions;
	attr ecore.EDouble weight;
}

class SecondHandArticle extends Item {
	attr ecore.EString rfidTag;
	ref Category[1] category;
	ref H2SEmployee processedBy;
}

class NonPerishableFood extends Item {
}

class Category {
	attr ecore.EString[1] categoryName;
}

class Vehicle {
	attr ecore.EDouble[1] storageSpace;
}

class PickupRoute {
	attr ecore.EDate[1] date;
	ref Vehicle[1] assignedVehicle;
	ref VolunteerDriver[1] assignedDriver;
}

class ScheduledPickup {
	attr ecore.EString[1] scheduledTime;
	ref PickupRequest[1] basedOnRequest;
	val Item[+] pickedUpItems;
	ref PickupRoute partOfRoute;
}

class PickupRequest {
	attr ecore.EString[1] descriptionOfItems;
	ref Resident[1] requestingResident;
}


