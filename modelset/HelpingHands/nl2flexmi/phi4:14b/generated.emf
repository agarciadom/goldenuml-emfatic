@namespace(uri="http://www.example.org/H2S", prefix="h2s")
package HelpingHandsStore;

import "http://www.eclipse.org/emf/2002/Ecore";

class Resident {
	attr ecore.EString[1] name;
	attr ecore.EString[1] streetAddress;
	attr ecore.EString[1] phoneNumber;
	attr ecore.EString email;
	ref PickupRoute[*] scheduledPickups;
}

class Vehicle {
	attr ecore.EInt[1] storageCapacity;
	attr ecore.EString[1] vehicleID;
	ref PickupRoute[*] routes;
}

class VolunteerDriver {
	ref PickupRoute[*] availability;
}

class PickupRoute {
}

class Item {
	ref Category assignedCategory;
}

class DistributionCenter {
	ref ServiceOffering[*] services;
}

class FoodBank {
}

class Employee {
	ref Item[*] examinedItems;
}

class Category {
}

class ServiceOffering {
	ref Resident[*] serviceClients;
}


