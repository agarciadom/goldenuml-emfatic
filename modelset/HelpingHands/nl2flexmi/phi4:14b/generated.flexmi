<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="HelpingHandsStore" nsURI="http://www.example.org/H2S" nsPrefix="h2s">
  <eClassifiers>
    <eClass name="Resident">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="streetAddress" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="phoneNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="scheduledPickups" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="storageCapacity" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="vehicleID" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="routes" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="VolunteerDriver">
      <eStructuralFeatures>
        <eReference name="availability" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PickupRoute">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Item">
      <eStructuralFeatures>
        <eReference name="assignedCategory" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DistributionCenter">
      <eStructuralFeatures>
        <eReference name="services" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="FoodBank">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eReference name="examinedItems" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.4" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Category">
      <eStructuralFeatures />
    </eClass>
    <eClass name="ServiceOffering">
      <eStructuralFeatures>
        <eReference name="serviceClients" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
