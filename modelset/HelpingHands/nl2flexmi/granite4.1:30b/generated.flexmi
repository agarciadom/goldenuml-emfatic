<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="H2S" nsURI="http://www.example.org/H2S" nsPrefix="h2s">
  <eClassifiers>
    <eClass name="Resident">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="address" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="phone" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="email" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PickupRequest" eSuperTypes="//@eClassifiers.11">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="requestedWeekday" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="scheduledTimeSlot" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="resident" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="item" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Item">
      <eStructuralFeatures>
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="dimensions" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="weightKg" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="type" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="category" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.8" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="licensePlate" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="maxWeightKg" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="maxVolumeCubicMeters" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="availableDays" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PickupRoute">
      <eStructuralFeatures>
        <eAttribute name="date" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="totalWeightCollectedKg" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="totalVolumeCollectedCubicMeters" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="vehicle" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="driver" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.4" />
        <eReference name="pickupRequests" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DistributionCenter">
      <eStructuralFeatures>
        <eAttribute name="locationName" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="employeeId" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="lastInspectionTimestamp" lowerBound="0" upperBound="1" eType="//EDate" />
        <eAttribute name="rfidTagAssigned" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Category">
      <eStructuralFeatures>
        <eAttribute name="code" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="description" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ClientRequest">
      <eStructuralFeatures>
        <eAttribute name="clientId" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="requestedCategories" lowerBound="0" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DeliveryAssignment" eSuperTypes="//@eClassifiers.11">
      <eStructuralFeatures>
        <eAttribute name="deliveryStatus" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="clientRequest" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
        <eReference name="itemDelivered" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HandlingOperation">
      <eStructuralFeatures>
        <eAttribute name="timestamp" lowerBound="0" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
