@namespace(uri="http://www.example.org/H2S", prefix="h2s")
package H2S;

import "http://www.eclipse.org/emf/2002/Ecore";

class Resident {
	attr ecore.EString name;
	attr ecore.EString address;
	attr ecore.EString phone;
	attr ecore.EString email;
}

class PickupRequest extends HandlingOperation {
	attr ecore.EString description;
	attr ecore.EInt requestedWeekday;
	attr ecore.EString scheduledTimeSlot;
	ref Resident[1] resident;
	val Item[1] item;
}

class Item {
	attr ecore.EString description;
	attr ecore.EString dimensions;
	attr ecore.EInt weightKg;
	attr ecore.EString type;
	ref Category category;
}

class Vehicle {
	attr ecore.EString licensePlate;
	attr ecore.EInt maxWeightKg;
	attr ecore.EDouble maxVolumeCubicMeters;
}

class Driver {
	attr ecore.EString name;
	attr ecore.EString availableDays;
}

class PickupRoute {
	attr ecore.EDate date;
	attr ecore.EInt totalWeightCollectedKg;
	attr ecore.EDouble totalVolumeCollectedCubicMeters;
	val Vehicle[1] vehicle;
	val Driver[1] driver;
	ref PickupRequest[*] pickupRequests;
}

class DistributionCenter {
	attr ecore.EString locationName;
}

class Employee {
	attr ecore.EString employeeId;
	attr ecore.EString name;
	attr ecore.EDate lastInspectionTimestamp;
	attr ecore.EString rfidTagAssigned;
}

class Category {
	attr ecore.EString code;
	attr ecore.EString description;
}

class ClientRequest {
	attr ecore.EString clientId;
	attr ecore.EString requestedCategories;
}

class DeliveryAssignment extends HandlingOperation {
	attr ecore.EString deliveryStatus;
	ref ClientRequest[1] clientRequest;
	ref Item[1] itemDelivered;
}

class HandlingOperation {
	attr ecore.EDate timestamp;
}


