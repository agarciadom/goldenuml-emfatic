<xmi:XMI xmlns:xmi="http://www.omg.org/spec/XMI/20131001"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:Ecore="http://www.eclipse.org/emf/2002/Ecore"
         xsi:schemaLocation="http://www.eclipse.org/emf/2002/Ecore http://www.eclipse.org/emf/2002/Ecore.ecore.xsd">
  <Ecore:EPackage xmi:type="Ecore:EPackage" name="bank" eClassifiers="
    @0 @1 @2 @3 @4 @5 @6 @7">
    <!-- Root container class -->
    <eClassifiers xsi:type="Ecore:EClass" name="BankRoot">
      <eStructuralFeatures xsi:type="Ecore:EReference"
                           name="banks"
                           eType="@3"
                           containment="true"/>
    </eClassifiers>

    <!-- Customer holds personal data and owns accounts -->
    <eClassifiers xsi:type="Ecore:EClass" name="Customer">
      <eStructuralFeatures xsi:type="Ecore:EAttribute"
                           name="firstName"
                           eType="Ecore:EString"/>
      <eStructuralFeatures xsi:type="Ecore:EAttribute"
                           name="lastName"
                           eType="Ecore:EString"/>
      <eStructuralFeatures xsi:type="Ecore:EReference"
                           name="accounts"
                           eType="@5"
                           lowerBound="1"
                           upperBound="5"
                           containment="true"/>
    </eClassifiers>

    <!-- Bank aggregates branches and customers -->
    <eClassifiers xsi:type="Ecore:EClass" name="Bank">
      <eStructuralFeatures xsi:type="Ecore:EReference"
                           name="branches"
                           eType="@4"
                           containment="true"/>
      <eStructuralFeatures xsi:type="Ecore:EReference"
                           name="customers"
                           eType="@2"
                           containment="true"/>
    </eClassifiers>

    <!-- Branch is a simple placeholder (no extra features needed) -->
    <eClassifiers xsi:type="Ecore:EClass" name="Branch"/>

    <!-- Base Account holds common data for all accounts -->
    <eClassifiers xsi:type="Ecore:EClass" name="Account">
      <eStructuralFeatures xsi:type="Ecore:EAttribute"
                           name="accountNumber"
                           eType="Ecore:EInt"/>
      <eStructuralFeatures xsi:type="Ecore:EAttribute"
                           name="balance"
                           eType="Ecore:EDouble"/>
    </eClassifiers>

    <!-- CurrentAccount extends Account and adds an overdraft limit -->
    <eClassifiers xsi:type="Ecore:EClass" name="CurrentAccount">
      <eSuperTypes xsi:type="Ecore:EClass" href="#/@5"/>
      <eStructuralFeatures xsi:type="Ecore:EAttribute"
                           name="overdraftLimit"
                           eType="Ecore:EDouble"/>
    </eClassifiers>

    <!-- SavingsAccount extends Account with no extra attributes -->
    <eClassifiers xsi:type="Ecore:EClass" name="SavingsAccount">
      <eSuperTypes xsi:type="Ecore:EClass" href="#/@5"/>
    </eClassifiers>
  </Ecore:EPackage>
</xmi:XMI>
