@namespace(uri="http://www.example.org/bank", prefix="bank")
package bank;

class Bank {
	val Customer[*]#bank customers;
	val Branch[*] branches;
	val Account[*] accounts;
}

class Branch {
}

class Customer {
	attr String firstName;
	attr String lastName;
	ref Bank#customers bank;
	ref Account[1..5]#owner accounts;
}

abstract class Account {
	attr int accountNumber;
	attr double balance;
	ref Customer[1]#accounts owner;
}

class CurrentAccount extends Account {
	attr double overdraftLimit;
}

class SavingsAccount extends Account {
}


