@namespace(uri="http://www.example.org/banking", prefix="banking")
package banking;

class Bank {
	val Branch[*] branches;
	ref Customer[*]#banks customers;
}

class Branch {
}

class Customer {
	attr String firstName;
	attr String lastName;
	val Account[1..5] accounts;
	ref Bank[*]#customers banks;
}

abstract class Account {
	attr int accountNumber;
	attr double balance;
}

class SavingsAccount extends Account {
}

class CheckingAccount extends Account {
	attr double overdraftLimit;
}


