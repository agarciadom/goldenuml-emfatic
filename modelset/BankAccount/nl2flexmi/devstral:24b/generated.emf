@namespace(uri="http://www.example.com/bank", prefix="bank")
package BankPackage;

import "http://www.eclipse.org/emf/2002/Ecore";

class Bank {
	attr ecore.EString name;
	val Customer[*] customers;
	ref Bank[*] branches;
}

class Customer {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	val Account[1..5] accounts;
}

class Account {
	attr ecore.EInt[1] accountNumber;
	attr ecore.EDouble[1] balance;
	ref Customer[1] owner;
}

class CurrentAccount extends Account {
	attr ecore.EDouble overdraftLimit;
}

class SavingsAccount extends Account {
}


