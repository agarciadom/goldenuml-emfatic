<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Bank" nsURI="http://example.com/bank" nsPrefix="bank">
  <eClassifiers>
    <eClass name="Customer">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="accounts" containment="True" lowerBound="1" upperBound="5" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Branch">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Account">
      <eStructuralFeatures>
        <eAttribute name="accountNumber" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="balance" lowerBound="1" upperBound="1" eType="//EDouble" />
        <eReference name="owner" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="CurrentAccount" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="overdraftLimit" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="SavingsAccount" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Bank">
      <eStructuralFeatures>
        <eReference name="customers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="branches" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
