@namespace(uri="http://www.example.org/BankSystem", prefix="bank")
package BankSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Bank {
	val Customer[*] customers;
	val Branch[*] branches;
}

class Branch {
}

class Customer {
	attr ecore.EString firstName;
	attr ecore.EString lastName;
	ref Account[1..5] accounts;
}

class Account {
	attr ecore.EInt accountNumber;
	attr ecore.EDouble balance;
	ref Customer[1] owner;
}

class CurrentAccount extends Account {
	attr ecore.EDouble overdraftLimit;
}

class SavingsAccount extends Account {
}


