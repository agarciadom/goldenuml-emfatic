@namespace(uri="http://bankingsystem", prefix="p")
package BankingSystem;

class Bank {
  val Customer[*] customers;
  val Branch[*] branches;
}
class Customer {
  attr String firstName;
  attr String lastName;
  val Account[*] accounts;
}
class Branch {
}
class Account {
  attr int accountNumber;
  attr double balance;
  ref Customer owner;
}
class CurrentAccount extends Account {
  attr double overdraftLimit;
}
class SavingsAccount extends Account {
}