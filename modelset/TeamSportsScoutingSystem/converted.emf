@namespace(uri="http://www.example.org/footballScouting", prefix="footballScouting")
package footballScouting;

enum Position {
	Goalkeeper = 0;
	LeftBack = 1;
}

enum Recommendation {
	KeyPlayer = 0;
	FirstTeamPlayer = 1;
	ReserveTeamPlayer = 2;
	ProspectivePlayer = 3;
	NotRecommended = 4;
}

enum ScoutingStatus {
	LongListed = 0;
	ShortListed = 1;
	RecommendedForSigning = 2;
	OfferMade = 3;
}

enum ScoutKind {
	RegularScout = 0;
	HeadScout = 1;
}

abstract class Person {
	attr String firstName;
	attr String lastName;
}

class Player extends Person {
	attr ScoutingStatus status;
	ref Offer[*]#player offers;
	ref PlayerProfile#player playerProfile;
	ref ScoutingAssignment[*]#player scoutingAssignments;
}

class HeadCoach extends Person {
	val PlayerProfile[*]#headCoach playerProfiles;
}

class Director extends Person {
	val Offer[*]#director offers;
}

class Scout extends Person {
	attr ScoutKind scoutKind;
	val ScoutingAssignment[*]#scout scoutingAssignments;
}

class Club {
	val Director director;
	val HeadCoach headCoach;
	val Player[*] players;
	val Scout[*] scouts;
}

class Offer {
	attr int value;
	ref Director#offers director;
	ref Player#offers player;
}

class ScoutingAssignment {
	val ScoutReport scoutReport;
	ref Scout#scoutingAssignments scout;
	ref Player#scoutingAssignments player;
}

class ScoutReport {
	attr String pro;
	attr String con;
	attr Recommendation recommendation;
	ref ScoutReport#previousReport nextReport;
	ref ScoutReport#nextReport previousReport;
}

class PlayerProfile {
	attr Position position;
	val PlayerAttribute[*] playerAttributes;
	ref Player#playerProfile player;
	ref HeadCoach#playerProfiles headCoach;
}

class PlayerAttribute {
	attr String name;
	attr int value;
}

class FootballScoutingModel {
	val Club[*] clubs;
}


