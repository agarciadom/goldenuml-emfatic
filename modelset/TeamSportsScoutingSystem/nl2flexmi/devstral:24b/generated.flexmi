<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TeamSportsScoutingSystem" nsURI="http://www.example.com/teamsportsscoutingsystem" nsPrefix="tsss">
  <eClassifiers>
    <eClass name="PlayerProfile">
      <eStructuralFeatures>
        <eAttribute name="targetPosition" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="playerAttributes" lowerBound="0" upperBound="-1" eType="//EString" />
        <eReference name="longListPlayers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="shortListPlayers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutAssignment">
      <eStructuralFeatures>
        <eAttribute name="assignmentId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="status" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="assignedTo" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="aboutPlayer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutingReport">
      <eStructuralFeatures>
        <eAttribute name="reportId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="pros" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="cons" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="recommendation" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="forAssignment" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.1" />
        <eReference name="createdBy" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="employeeId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="role" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="createdAssignments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="createdReports" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
