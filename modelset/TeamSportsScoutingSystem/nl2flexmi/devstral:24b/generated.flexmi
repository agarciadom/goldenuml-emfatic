<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TeamSportsScoutingSystem" nsURI="http://www.example.org/teamsportsscoutingsystem" nsPrefix="tsss">
  <eClassifiers>
    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="id" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="age" lowerBound="0" upperBound="1" eType="//EInt" />
        <eAttribute name="height" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eAttribute name="weight" lowerBound="0" upperBound="1" eType="//EDouble" />
        <eReference name="profiles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="assignments" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
        <eReference name="reports" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="DesignatedPlayerProfile">
      <eStructuralFeatures>
        <eAttribute name="profileId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="targetPosition" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="players" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
        <eReference name="shortListedPlayers" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Scout">
      <eStructuralFeatures>
        <eAttribute name="scoutId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="assignments" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HeadCoach" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Director">
      <eStructuralFeatures>
        <eAttribute name="directorId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="name" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="offersMade" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutingAssignment">
      <eStructuralFeatures>
        <eAttribute name="assignmentId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eReference name="player" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="scout" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutingReport">
      <eStructuralFeatures>
        <eAttribute name="reportId" lowerBound="1" upperBound="1" eType="//EInt" />
        <eAttribute name="pros" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="cons" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="recommendation" lowerBound="0" upperBound="1" eType="//EString" />
        <eReference name="assignment" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.5" />
        <eReference name="player" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
