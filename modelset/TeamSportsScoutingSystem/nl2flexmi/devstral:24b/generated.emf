@namespace(uri="http://www.example.org/teamsportsscoutingsystem", prefix="tsss")
package TeamSportsScoutingSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Player {
	attr ecore.EInt[1] ~id;
	attr ecore.EString name;
	attr ecore.EInt age;
	attr ecore.EDouble height;
	attr ecore.EDouble weight;
	ref DesignatedPlayerProfile[*] profiles;
	ref ScoutingAssignment[*] assignments;
	ref ScoutingReport[*] reports;
}

class DesignatedPlayerProfile {
	attr ecore.EInt[1] profileId;
	attr ecore.EString targetPosition;
	ref Player[*] players;
	ref Player[*] shortListedPlayers;
}

class Scout {
	attr ecore.EInt[1] scoutId;
	attr ecore.EString name;
	val ScoutingAssignment[*] assignments;
}

class HeadCoach extends Scout {
}

class Director {
	attr ecore.EInt[1] directorId;
	attr ecore.EString name;
	ref Player[*] offersMade;
}

class ScoutingAssignment {
	attr ecore.EInt[1] assignmentId;
	ref Player[1] player;
	ref Scout[1] scout;
}

class ScoutingReport {
	attr ecore.EInt[1] reportId;
	attr ecore.EString pros;
	attr ecore.EString cons;
	attr ecore.EString recommendation;
	ref ScoutingAssignment[1] assignment;
	ref Player[1] player;
}


