@namespace(uri="http://www.example.org/TeamSportsScoutingSystem", prefix="tss")
package TeamSportsScoutingSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Employee {
	attr ecore.EString[1] name;
}

class HeadCoach extends Employee {
}

class Director extends Employee {
}

class Scout extends Employee {
}

class HeadScout extends Scout {
}

class PlayerProfile {
	attr ecore.EString[1] targetPosition;
	val ProfileAttribute[*] attributes;
}

class ProfileAttribute {
	attr ecore.EString[1] attrName;
	attr ecore.EString[1] attrValue;
}

class Player {
	attr ecore.EString[1] name;
	attr ecore.EBoolean[1] isOnShortList;
	ref PlayerProfile[*] matchesProfile;
}

class ScoutingAssignment {
	ref Player[1] targetPlayer;
	ref Scout[1] assignedScout;
	val ScoutingReport resultReport;
}

class ScoutingReport {
	attr ecore.EString pros;
	attr ecore.EString cons;
	attr ecore.EString[1] recommendation;
	ref Player[1] reportedPlayer;
}


