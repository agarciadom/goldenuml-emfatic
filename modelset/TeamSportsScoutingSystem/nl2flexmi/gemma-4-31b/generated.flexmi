<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TeamSportsScoutingSystem" nsURI="http://www.example.org/TeamSportsScoutingSystem" nsPrefix="tss">
  <eClassifiers>
    <eClass name="Employee">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="HeadCoach" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Director" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Scout" eSuperTypes="//@eClassifiers.0">
      <eStructuralFeatures />
    </eClass>
    <eClass name="HeadScout" eSuperTypes="//@eClassifiers.3">
      <eStructuralFeatures />
    </eClass>
    <eClass name="PlayerProfile">
      <eStructuralFeatures>
        <eAttribute name="targetPosition" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="attributes" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ProfileAttribute">
      <eStructuralFeatures>
        <eAttribute name="attrName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="attrValue" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Player">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="isOnShortList" lowerBound="1" upperBound="1" eType="//EBoolean" />
        <eReference name="matchesProfile" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.5" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutingAssignment">
      <eStructuralFeatures>
        <eReference name="targetPlayer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
        <eReference name="assignedScout" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="resultReport" containment="True" lowerBound="0" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutingReport">
      <eStructuralFeatures>
        <eAttribute name="pros" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="cons" lowerBound="0" upperBound="1" eType="//EString" />
        <eAttribute name="recommendation" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="reportedPlayer" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
