<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TeamSportsScoutingSystem" nsURI="http://example.com/team_sports_scouting_system" nsPrefix="tsss">
  <eClassifiers>
    <eClass name="HeadCoach">
      <eStructuralFeatures>
        <eReference name="playerProfiles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="longLists" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="shortLists" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Director">
      <eStructuralFeatures>
        <eReference name="playerProfiles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="longLists" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
        <eReference name="shortLists" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Scout">
      <eStructuralFeatures>
        <eReference name="playerProfiles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
        <eReference name="longLists" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PlayerProfile" eSuperTypes="//@eClassifiers.6">
      <eStructuralFeatures />
    </eClass>
    <eClass name="TargetPosition">
      <eStructuralFeatures>
        <eAttribute name="positionType" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PlayerAttributes">
      <eStructuralFeatures>
        <eAttribute name="name" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="value" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="LongList" eSuperTypes="//@eClassifiers.9, //@eClassifiers.3">
      <eStructuralFeatures />
    </eClass>
    <eClass name="ScoutingAssignment" eSuperTypes="//@eClassifiers.9">
      <eStructuralFeatures>
        <eReference name="targetPlayer" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.3" />
        <eReference name="report" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.8" />
        <eReference name="shortList" containment="True" lowerBound="1" upperBound="1" eType="//@eClassifiers.9" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ScoutingReport">
      <eStructuralFeatures>
        <eAttribute name="pros" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="cons" lowerBound="0" upperBound="-1" eType="//EString" />
        <eAttribute name="recommendation" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="player" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="ShortList">
      <eStructuralFeatures>
        <eReference name="players" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.12" />
        <eReference name="playerProfiles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.3" />
      </eStructuralFeatures>
    </eClass>
    <eDataType name="Position" instanceClassName="String" />
    <eDataType name="Attribute" instanceClassName="String" />
    <eClass name="Player">
      <eStructuralFeatures />
    </eClass>
  </eClassifiers>
</ePackage>
