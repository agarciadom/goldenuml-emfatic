<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmi:version="2.0">
  <ecore:EPackage name="teamSportsScoutingSystem" nsURI="http://example.org/teamSportsScoutingSystem" nsPrefix="tsss" xmi:id="0">

    <!-- Root container class -->
    <ecore:EClass name="TeamSportsScoutingSystem" xmi:id="1">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="employees" eType="#2" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Employee class hierarchy -->
    <ecore:EClass name="Employee" xmi:id="2">
      <ecore:EAttribute name="employeeId" eType="ecore:EString"/>
      <ecore:EAttribute name="name" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Specific employee roles -->
    <ecore:EClass name="HeadCoach" xmi:id="3">
      <ecore:EReference name="designatedPlayerProfiles" eType="#8" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <ecore:EClass name="DirectorOfTheClub" xmi:id="4"/>

    <ecore:EClass name="Scout" xmi:id="5">
      <ecore:EReference name="scoutingReports" eType="#23" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Designated Player Profile -->
    <ecore:EClass name="DesignatedPlayerProfile" xmi:id="8">
      <ecore:EAttribute name="targetPosition" eType="ecore:EString"/>
      <ecore:EReference name="playerAttributes" eType="#9" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Player Attribute -->
    <ecore:EClass name="PlayerAttribute" xmi:id="9">
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EAttribute name="value" eType="ecore:EInt"/>
    </ecore:EClass>

    <!-- Player class -->
    <ecore:EClass name="Player" xmi:id="10">
      <ecore:EAttribute name="playerId" eType="ecore:EString"/>
      <ecore:EAttribute name="name" eType="ecore:EString"/>
      <ecore:EReference name="longListNotes" eType="#11" containment="true" upperBound="-1"/>
    </ecore:EClass>

    <!-- Player Long List Note -->
    <ecore:EClass name="LongListNote" xmi:id="11">
      <ecore:EAttribute name="noteId" eType="ecore:EString"/>
      <ecore:EReference name="designatedPlayerProfile" eType="#8"/>
    </ecore:EClass>

    <!-- Scouting Assignment -->
    <ecore:EClass name="ScoutingAssignment" xmi:id="12">
      <ecore:EAttribute name="assignmentId" eType="ecore:EString"/>
      <ecore:EReference name="player" eType="#10"/>
      <ecore:EReference name="scout" eType="#5"/>
    </ecore:EClass>

    <!-- Scouting Report -->
    <ecore:EClass name="ScoutingReport" xmi:id="23">
      <ecore:EAttribute name="reportId" eType="ecore:EString"/>
      <ecore:EReference name="player" eType="#10"/>
      <ecore:EReference name="prosCons" eType="#14" containment="true" upperBound="-1"/>
      <ecore:EAttribute name="recommendation" eType="ecore:EString"/>
    </ecore:EClass>

    <!-- Pros and Cons -->
    <ecore:EClass name="ProsAndCons" xmi:id="14">
      <ecore:EAttribute name="description" eType="ecore:EString"/>
    </ecore:EClass>

  </ecore:EPackage>
</xmi:XMI>
