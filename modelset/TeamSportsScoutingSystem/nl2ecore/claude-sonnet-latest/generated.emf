@namespace(uri="http://www.example.org/teamSportsScouting", prefix="teamSportsScouting")
package teamSportsScouting;

datatype LocalDate : java.time.LocalDate;

enum Recommendation {
	KEY_PLAYER = 0;
	FIRST_TEAM_PLAYER = 1;
	RESERVE_TEAM_PLAYER = 2;
	PROSPECTIVE_PLAYER = 3;
	NOT_A_GOOD_SIGNING = 4;
}

enum Position {
	GK = 0;
	LB = 1;
	RB = 2;
	CB = 3;
	LWB = 4;
	RWB = 5;
	CDM = 6;
	CM = 7;
	CAM = 8;
	LM = 9;
	RM = 10;
	LW = 11;
	RW = 12;
	CF = 13;
	ST = 14;
}

enum ListStatus {
	LONG_LIST = 0;
	SHORT_LIST = 1;
}

class ScoutingSystem {
	val Employee[*] employees;
	val Player[*] players;
	val PlayerProfile[*] playerProfiles;
	val ScoutingAssignment[*] scoutingAssignments;
	val Offer[*] offers;
	val LongListEntry[*] longListEntries;
	val ShortListEntry[*] shortListEntries;
}

abstract class Employee {
	attr String employeeId;
	attr String name;
}

class HeadCoach extends Employee {
	op void identifyPlayerProfile(PlayerProfile profile);
	op void moveToShortList(LongListEntry entry);
	ref PlayerProfile[*] playerProfiles;
}

class Director extends Employee {
	op void makeOffer(Player player, Offer offer);
}

class Scout extends Employee {
	op void addToLongList(Player player, PlayerProfile profile);
	op void submitScoutingReport(ScoutingAssignment assignment, ScoutingReport report);
}

class HeadScout extends Scout {
	op void evaluateLongList();
	op void createScoutingAssignment(Player player, Scout assignedScout);
	op void recommendForSigning(Player player);
	op void decideShortList(LongListEntry entry, HeadCoach headCoach);
}

class Player {
	attr String playerId;
	attr String name;
	attr LocalDate dateOfBirth;
	attr String nationality;
	attr String currentClub;
}

class PlayerProfile {
	attr String profileId;
	attr Position targetPosition;
	val PlayerAttribute[*] attributes;
}

class PlayerAttribute {
	attr String name;
	attr String value;
}

class LongListEntry {
	attr LocalDate dateAdded;
	ref Player player;
	ref PlayerProfile targetProfile;
	ref Scout addedBy;
	attr ListStatus status;
}

class ShortListEntry {
	attr LocalDate dateAdded;
	ref Player player;
	ref PlayerProfile targetProfile;
	ref ScoutingAssignment[*] scoutingAssignments;
	attr boolean finallyRecommended;
}

class ScoutingAssignment {
	attr String assignmentId;
	attr LocalDate dateCreated;
	attr boolean completed;
	ref Scout assignedTo;
	ref HeadScout createdBy;
	ref Player player;
	val ScoutingReport report;
}

class ScoutingReport {
	attr String reportId;
	attr LocalDate dateSubmitted;
	val ObservationItem[*] pros;
	val ObservationItem[*] cons;
	attr Recommendation recommendation;
	ref Scout submittedBy;
}

class ObservationItem {
	attr String description;
}

class Offer {
	attr String offerId;
	attr EDate dateIssued;
	attr double amount;
	attr String status;
	ref Player player;
	ref Director issuedBy;
}


