<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    name="teamSportsScouting"
    nsURI="http://www.example.org/teamSportsScouting"
    nsPrefix="teamSportsScouting">

  <!-- Custom datatypes -->
  <eClassifiers xsi:type="ecore:EDataType" name="LocalDate"
      instanceClassName="java.time.LocalDate"/>

  <!-- Enumerations -->
  <eClassifiers xsi:type="ecore:EEnum" name="Recommendation">
    <eLiterals name="KEY_PLAYER" value="0" literal="KEY_PLAYER"/>
    <eLiterals name="FIRST_TEAM_PLAYER" value="1" literal="FIRST_TEAM_PLAYER"/>
    <eLiterals name="RESERVE_TEAM_PLAYER" value="2" literal="RESERVE_TEAM_PLAYER"/>
    <eLiterals name="PROSPECTIVE_PLAYER" value="3" literal="PROSPECTIVE_PLAYER"/>
    <eLiterals name="NOT_A_GOOD_SIGNING" value="4" literal="NOT_A_GOOD_SIGNING"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="Position">
    <eLiterals name="GK" value="0" literal="GK"/>
    <eLiterals name="LB" value="1" literal="LB"/>
    <eLiterals name="RB" value="2" literal="RB"/>
    <eLiterals name="CB" value="3" literal="CB"/>
    <eLiterals name="LWB" value="4" literal="LWB"/>
    <eLiterals name="RWB" value="5" literal="RWB"/>
    <eLiterals name="CDM" value="6" literal="CDM"/>
    <eLiterals name="CM" value="7" literal="CM"/>
    <eLiterals name="CAM" value="8" literal="CAM"/>
    <eLiterals name="LM" value="9" literal="LM"/>
    <eLiterals name="RM" value="10" literal="RM"/>
    <eLiterals name="LW" value="11" literal="LW"/>
    <eLiterals name="RW" value="12" literal="RW"/>
    <eLiterals name="CF" value="13" literal="CF"/>
    <eLiterals name="ST" value="14" literal="ST"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EEnum" name="ListStatus">
    <eLiterals name="LONG_LIST" value="0" literal="LONG_LIST"/>
    <eLiterals name="SHORT_LIST" value="1" literal="SHORT_LIST"/>
  </eClassifiers>

  <!-- Root container -->
  <eClassifiers xsi:type="ecore:EClass" name="ScoutingSystem">
    <eStructuralFeatures xsi:type="ecore:EReference" name="employees"
        eType="#//Employee" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players"
        eType="#//Player" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="playerProfiles"
        eType="#//PlayerProfile" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="scoutingAssignments"
        eType="#//ScoutingAssignment" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="offers"
        eType="#//Offer" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="longListEntries"
        eType="#//LongListEntry" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="shortListEntries"
        eType="#//ShortListEntry" containment="true" upperBound="-1"/>
  </eClassifiers>

  <!-- Employee hierarchy -->
  <eClassifiers xsi:type="ecore:EClass" name="Employee" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="employeeId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="HeadCoach" eSuperTypes="#//Employee">
    <eOperations name="identifyPlayerProfile">
      <eParameters name="profile" eType="#//PlayerProfile"/>
    </eOperations>
    <eOperations name="moveToShortList">
      <eParameters name="entry" eType="#//LongListEntry"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="playerProfiles"
        eType="#//PlayerProfile" upperBound="-1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Director" eSuperTypes="#//Employee">
    <eOperations name="makeOffer">
      <eParameters name="player" eType="#//Player"/>
      <eParameters name="offer" eType="#//Offer"/>
    </eOperations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="Scout" eSuperTypes="#//Employee">
    <eOperations name="addToLongList">
      <eParameters name="player" eType="#//Player"/>
      <eParameters name="profile" eType="#//PlayerProfile"/>
    </eOperations>
    <eOperations name="submitScoutingReport">
      <eParameters name="assignment" eType="#//ScoutingAssignment"/>
      <eParameters name="report" eType="#//ScoutingReport"/>
    </eOperations>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="HeadScout" eSuperTypes="#//Scout">
    <eOperations name="evaluateLongList"/>
    <eOperations name="createScoutingAssignment">
      <eParameters name="player" eType="#//Player"/>
      <eParameters name="assignedScout" eType="#//Scout"/>
    </eOperations>
    <eOperations name="recommendForSigning">
      <eParameters name="player" eType="#//Player"/>
    </eOperations>
    <eOperations name="decideShortList">
      <eParameters name="entry" eType="#//LongListEntry"/>
      <eParameters name="headCoach" eType="#//HeadCoach"/>
    </eOperations>
  </eClassifiers>

  <!-- Player -->
  <eClassifiers xsi:type="ecore:EClass" name="Player">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="playerId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateOfBirth"
        eType="#//LocalDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nationality"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="currentClub"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Player Profile -->
  <eClassifiers xsi:type="ecore:EClass" name="PlayerProfile">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="profileId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targetPosition"
        eType="#//Position"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="attributes"
        eType="#//PlayerAttribute" containment="true" upperBound="-1"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PlayerAttribute">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Long List Entry (association class between Player and PlayerProfile) -->
  <eClassifiers xsi:type="ecore:EClass" name="LongListEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateAdded"
        eType="#//LocalDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="player"
        eType="#//Player"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetProfile"
        eType="#//PlayerProfile"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="addedBy"
        eType="#//Scout"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="#//ListStatus"/>
  </eClassifiers>

  <!-- Short List Entry -->
  <eClassifiers xsi:type="ecore:EClass" name="ShortListEntry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateAdded"
        eType="#//LocalDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="player"
        eType="#//Player"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="targetProfile"
        eType="#//PlayerProfile"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="scoutingAssignments"
        eType="#//ScoutingAssignment" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="finallyRecommended"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>

  <!-- Scouting Assignment -->
  <eClassifiers xsi:type="ecore:EClass" name="ScoutingAssignment">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="assignmentId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateCreated"
        eType="#//LocalDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="completed"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="assignedTo"
        eType="#//Scout"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="createdBy"
        eType="#//HeadScout"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="player"
        eType="#//Player"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="report"
        eType="#//ScoutingReport" containment="true"/>
  </eClassifiers>

  <!-- Scouting Report -->
  <eClassifiers xsi:type="ecore:EClass" name="ScoutingReport">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="reportId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateSubmitted"
        eType="#//LocalDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="pros"
        eType="#//ObservationItem" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="cons"
        eType="#//ObservationItem" containment="true" upperBound="-1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="recommendation"
        eType="#//Recommendation"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="submittedBy"
        eType="#//Scout"/>
  </eClassifiers>

  <!-- Observation Item (for pros and cons) -->
  <eClassifiers xsi:type="ecore:EClass" name="ObservationItem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Offer -->
  <eClassifiers xsi:type="ecore:EClass" name="Offer">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="offerId"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dateIssued"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="status"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="player"
        eType="#//Player"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="issuedBy"
        eType="#//Director"/>
  </eClassifiers>

</ecore:EPackage>
