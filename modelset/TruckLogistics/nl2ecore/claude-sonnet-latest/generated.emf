@namespace(uri="http://www.example.org/logistics", prefix="logistics")
package logistics;

class LogisticsSystem {
	val Location[*] locations;
	val Order[*] orders;
	val Vehicle[*] vehicles;
	val Driver[*] drivers;
}

class Location {
	attr String address;
}

class Driver {
	attr String firstName;
	attr String lastName;
	ref Order currentOrder;
	ref Vehicle#driver drivenVehicle;
}

abstract class Vehicle {
	attr String vehicleNumber;
	ref Driver#drivenVehicle driver;
}

class Truck extends Vehicle {
	attr double weight;
}

class Car extends Vehicle {
	attr int numberOfSeats;
}

class Van extends Vehicle {
}

class Order {
	attr EDate executionDate;
	ref Location origin;
	ref Location destination;
	ref Driver[+] drivers;
}


