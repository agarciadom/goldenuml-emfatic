@namespace(uri="http://www.example.org/transport", prefix="transport")
package transport;

class Assignment {
	attr EDate date;
	ref Driver[*] executes;
	ref Location[1] from;
	ref Location[1] to;
}

class Location {
	attr String address;
	val Vehicle[1] vehicle;
}

class Driver {
	attr String firstName;
	attr String lastName;
	ref Vehicle[*] drives;
}

class Vehicle {
	attr int vehicleNumber;
	ref Driver[*] driver;
	ref VehicleStatus[1] status;
}

class Truck extends Vehicle {
	attr double tonnage;
}

class PassengerCar extends Vehicle {
	attr int seats;
}

class Transporter extends Vehicle {
}

enum VehicleStatus {
	READY = 0;
	ASSIGNMENT = 1;
	MAINTENANCE = 2;
}


