@namespace(uri="http://www.example.org/transportPackage", prefix="transportPackage")
package transportPackage;

class TransportSystem {
	val Assignment[*] assignments;
	val Location[*] locations;
	val Driver[*] drivers;
	val Vehicle[*] vehicles;
}

class Assignment {
	attr EDate date;
	ref Driver[*] executes;
	ref Location[1] from;
	ref Location[1] to;
}

class Location {
	attr String address;
	val Vehicle[1] vehicle;
}

class Driver {
	attr String firstName;
	attr String lastName;
	ref Vehicle[*] driverVehicles;
}

class Vehicle {
	attr int vehicleNumber;
	ref Driver[*] driver;
	attr VehicleStatus[1] status;
}

class Truck extends Vehicle {
	attr double tonnage;
}

class PassengerCar extends Vehicle {
	attr int seats;
}

class Transporter extends Vehicle {
}

enum VehicleStatus {
	READY = 0;
	ASSIGNMENT = 1;
	MAINTENANCE = 2;
}


