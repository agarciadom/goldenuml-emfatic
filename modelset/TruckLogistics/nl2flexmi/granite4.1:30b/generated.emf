@namespace(uri="http://example.com/locationsystem", prefix="loc")
package LocationSystem;

import "http://www.eclipse.org/emf/2002/Ecore";

class Location {
	attr ecore.EString[1] address;
	val Driver[*] drivers;
	val Vehicle[*] vehicles;
}

class Vehicle {
	attr ecore.EString[1] vehicleNumber;
}

class Driver {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	ref Vehicle vehicle;
}

class Order {
	ref Location[1] originLocation;
	ref Location[1] destinationLocation;
	ref Driver[1] driver;
	attr ecore.EDate[1] executionDate;
}

class Truck extends Vehicle {
	attr ecore.EInt weight;
}

class Car extends Vehicle {
	attr ecore.EInt seats;
}

class Van extends Vehicle {
}


