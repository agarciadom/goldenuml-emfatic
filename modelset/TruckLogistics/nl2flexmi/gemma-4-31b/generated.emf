@namespace(uri="http://www.example.com/logistics", prefix="log")
package Logistics;

import "http://www.eclipse.org/emf/2002/Ecore";

class Location {
	attr ecore.EString[1] address;
	val Driver[*] drivers;
	val Vehicle[*] vehicles;
}

class Driver {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	ref Order currentOrder;
}

class Vehicle {
	attr ecore.EString[1] vehicleNumber;
	ref Driver assignedDriver;
}

class Truck extends Vehicle {
	attr ecore.EDouble[1] weight;
}

class PassengerVehicle extends Vehicle {
	attr ecore.EInt[1] seatCount;
}

class Car extends PassengerVehicle {
}

class Van extends PassengerVehicle {
}

class Order {
	attr ecore.EDate[1] executionDate;
	ref Location[1] origin;
	ref Location[1] destination;
	ref Driver[+] drivers;
}


