<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="Logistics" nsURI="http://www.example.com/logistics" nsPrefix="log">
  <eClassifiers>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="drivers" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.1" />
        <eReference name="vehicles" containment="True" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="currentOrder" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.7" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="vehicleNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="assignedDriver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Truck" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="weight" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="PassengerVehicle" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="seatCount" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Car" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Van" eSuperTypes="//@eClassifiers.4">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="executionDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="origin" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="destination" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="drivers" containment="False" lowerBound="1" upperBound="-1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
