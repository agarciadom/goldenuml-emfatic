<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportationSystem" nsURI="http://example.org/transportation" nsPrefix="ts">
  <eClassifiers>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="drivers" lowerBound="0" upperBound="9999" eType="Driver" />
        <eAttribute name="vehicles" lowerBound="0" upperBound="9999" eType="Vehicle" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="vehicles" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.2" />
        <eReference name="orders" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.6" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="vehicleNumber" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Truck" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="weight" lowerBound="0" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Car" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="seats" lowerBound="0" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Van" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eAttribute name="executionDate" lowerBound="1" upperBound="1" eType="//EDate" />
        <eReference name="origin" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="destination" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="drivers" containment="False" lowerBound="0" upperBound="9999" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
