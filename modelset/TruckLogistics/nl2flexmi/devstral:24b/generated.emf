@namespace(uri="http://www.example.com/transportationmanagement", prefix="tm")
package TransportationManagement;

import "http://www.eclipse.org/emf/2002/Ecore";

class Location {
	attr ecore.EString[1] address;
}

class Driver {
	attr ecore.EString[1] firstName;
	attr ecore.EString[1] lastName;
	ref Vehicle[*] drivenVehicles;
}

class Vehicle {
	attr ecore.EString[1] vehicleNumber;
	ref Driver driver;
}

class Truck extends Vehicle {
	attr ecore.EDouble[1] weight;
}

class Car extends Vehicle {
	attr ecore.EInt[1] numberOfSeats;
}

class Van extends Vehicle {
}

class Order {
	ref Location[1] originLocation;
	ref Location[1] destinationLocation;
	ref Driver driver;
	attr ecore.EDate[1] executionDate;
}


