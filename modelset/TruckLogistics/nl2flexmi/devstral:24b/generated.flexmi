<?nsuri http://www.eclipse.org/emf/2002/Ecore?>
<?import http://www.eclipse.org/emf/2002/Ecore?>
<ePackage name="TransportationManagement" nsURI="http://www.example.com/transportationmanagement" nsPrefix="tm">
  <eClassifiers>
    <eClass name="Location">
      <eStructuralFeatures>
        <eAttribute name="address" lowerBound="1" upperBound="1" eType="//EString" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Driver">
      <eStructuralFeatures>
        <eAttribute name="firstName" lowerBound="1" upperBound="1" eType="//EString" />
        <eAttribute name="lastName" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="drivenVehicles" containment="False" lowerBound="0" upperBound="-1" eType="//@eClassifiers.2" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Vehicle">
      <eStructuralFeatures>
        <eAttribute name="vehicleNumber" lowerBound="1" upperBound="1" eType="//EString" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Truck" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="weight" lowerBound="1" upperBound="1" eType="//EDouble" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Car" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures>
        <eAttribute name="numberOfSeats" lowerBound="1" upperBound="1" eType="//EInt" />
      </eStructuralFeatures>
    </eClass>
    <eClass name="Van" eSuperTypes="//@eClassifiers.2">
      <eStructuralFeatures />
    </eClass>
    <eClass name="Order">
      <eStructuralFeatures>
        <eReference name="originLocation" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="destinationLocation" containment="False" lowerBound="1" upperBound="1" eType="//@eClassifiers.0" />
        <eReference name="driver" containment="False" lowerBound="0" upperBound="1" eType="//@eClassifiers.1" />
        <eAttribute name="executionDate" lowerBound="1" upperBound="1" eType="//EDate" />
      </eStructuralFeatures>
    </eClass>
  </eClassifiers>
</ePackage>
